// ============================================================
// NovaLang Unified Model Registry & Swarm Controller v2.0
// ============================================================
// Architecture: Navier-Stokes flow optimization, Soroban dispatch,
//   ternary health states, crypto fingerprints, hive dispatch
// Security: SHA-256 registry hash + Merkle tree integrity +
//   autonomous command filter + voice lock + AES-256 at rest
// Math: Fluid dynamics wave scheduling + Soroban model counting
// From: NovaX Security Architecture + NovaLang Compiler v1.0
// ============================================================

// --- Ternary Health States ---
// P (+1) = model alive and responding
// Z ( 0) = model status unknown / untested
// N (-1) = model dead / 404 / rate-limited permanently
let ALIVE = Trit(1)
let UNKNOWN = Trit(0)
let DEAD = Trit(-1)

// --- Cloud Model Registry (ALL free OpenRouter -- verified 2026-03-01) ---
let cloud_models = [
    "deepseek/deepseek-chat",
    "deepseek/deepseek-r1",
    "deepseek/deepseek-r1-0528",
    "deepseek/deepseek-r1-distill-llama-70b",
    "google/gemma-3-27b-it:free",
    "google/gemma-3-12b-it:free",
    "google/gemma-3-4b-it:free",
    "google/gemma-3n-e4b-it:free",
    "google/gemma-3n-e2b-it:free",
    "meta-llama/llama-3.3-70b-instruct:free",
    "meta-llama/llama-3.2-3b-instruct:free",
    "mistralai/mistral-small-3.1-24b-instruct:free",
    "qwen/qwen3-4b:free",
    "qwen/qwen3-coder:free",
    "qwen/qwen3-next-80b-a3b-instruct:free",
    "qwen/qwen3-235b-a22b-thinking-2507",
    "qwen/qwen3-vl-235b-a22b-thinking",
    "qwen/qwen3-vl-30b-a3b-thinking",
    "nousresearch/hermes-3-llama-3.1-405b:free",
    "nvidia/nemotron-3-nano-30b-a3b:free",
    "nvidia/nemotron-nano-9b-v2:free",
    "nvidia/nemotron-nano-12b-v2-vl:free",
    // "openai/gpt-oss-120b:free" -- DEAD (404)
    // "openai/gpt-oss-20b:free" -- DEAD (404)
    "arcee-ai/trinity-large-preview:free",
    "arcee-ai/trinity-mini:free",
    "cognitivecomputations/dolphin-mistral-24b-venice-edition:free",
    "liquid/lfm-2.5-1.2b-instruct:free",
    "liquid/lfm-2.5-1.2b-thinking:free",
    "stepfun/step-3.5-flash:free",
    "upstage/solar-pro-3:free",
    "z-ai/glm-4.5-air:free",
    "openrouter/free"
