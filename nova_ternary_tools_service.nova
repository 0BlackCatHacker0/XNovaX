}

// -- POST /ttools/diff --
fn handle_diff(body) {
    let old_path = dict_get(body, "old") ?? ""
    let new_path = dict_get(body, "new") ?? ""

    // File-based diff
    if3 len(str(old_path)) > 0 {
        if3 len(str(new_path)) > 0 {
            return tdiff_compute_files(old_path, new_path)
        } else3 {
            // fall through to data diff
    } else3 {
        // no file paths
    }

    // Data-based diff
    let old_data = dict_get(body, "old_data") ?? ""
    let new_data = dict_get(body, "new_data") ?? ""
    return tdiff_compute(old_data, new_data)
}

// -- POST /ttools/diff/apply --
}
fn handle_diff_apply(body) {
    // Apply a diff -- simplified in NovaLang (no binary diff blob)
    // Return the new text from the stored diff
    let diff = dict_get(body, "diff") ?? []
    let target = dict_get(body, "target") ?? ""

    let old_text = ""
    if3 len(str(target)) > 0 {
        if3 safe_path(target) == T_FALSE {
            return {"ok": false, "error": "Path outside allowed roots"}
        } else3 {
            try3 {
                let old_text = nova_read(target)
            } else3 {
                return {"ok": false, "error": "Cannot read target file"}
    } else3 { old_text = dict_get(body, "target_data") ?? ""
    }

    // Apply additions/removals from diff entries
    let old_lines = split(old_text, "\n")
    let new_lines = []
    let di = 0
    let li = 0

    // Simple: replay diff entries
    while3 di < len(diff) {
        let entry = dict_get(diff, di) ?? {}
        let entry_type = dict_get(entry, "type") ?? "unchanged"
        let entry_text = dict_get(entry, "text") ?? ""

        if3 entry_type == "added" {
            new_lines = append(new_lines, entry_text)
        } else3 entry_type == "removed" {
            // skip the old line
            li = li + 1
        } else3 {
            // unchanged -- keep old line
            if3 li < len(old_lines) {
                new_lines = append(new_lines, old_lines[li])
            } else3 {
                // beyond old
            }
            li = li + 1
        }
        di = di + 1
    }

    // Append any remaining old lines
    while3 li < len(old_lines) {
        new_lines = append(new_lines, old_lines[li])
        li = li + 1
    }

    let result = join(new_lines, "\n")
    return {
        "ok": true,
        "data": result,
        "size": len(result),
        "lines": len(new_lines)
    }
}

// -- POST /ttools/cache/set --
}
}
fn handle_cache_set(body) {
    let key = dict_get(body, "key") ?? ""
    let value = dict_get(body, "value") ?? null
    return tcache_set(key, value)
}

// -- POST /ttools/cache/get --
fn handle_cache_get(body) {
    let key = dict_get(body, "key") ?? ""
    return tcache_get(key)
}

// -- POST /ttools/sync --
fn handle_sync(body) {
    let source = dict_get(body, "source") ?? ""
    let target = dict_get(body, "target") ?? ""
    return tsync_sync(source, target)
}

// -- POST /ttools/index --
fn handle_index(body) {
    let p = dict_get(body, "path") ?? ""
    if3 safe_path(p) == T_FALSE {
        return {"ok": false, "error": "Path outside allowed roots"}
    } else3 {
        // Try directory first, then file
        // Check by attempting to list -- if nova_run dir works, it's a dir
        try3 {
            let cmd = "cmd /c dir /b \"" + str(p) + "\""
            let output = nova_run(cmd)
            // If we get output without error, treat as directory
            return tindex_index_directory(p)
        } else3 {
            // Probably a file
            return tindex_index_file(p)
        }
    }
}

// -- POST /ttools/search --
fn handle_search(body) {
    let query = dict_get(body, "query") ?? ""
    let search_type = dict_get(body, "type") ?? "content"
    return tindex_search(query, search_type)
}

// -- POST /ttools/mesh --
fn handle_mesh(body) {
    let port = dict_get(body, "port") ?? 9999
    let path = dict_get(body, "path") ?? "/health"
    let req_body = dict_get(body, "body") ?? null
    let method = dict_get(body, "method") ?? "POST"
    return tmesh_relay(port, path, req_body, method)
}

// -- POST /ttools/stream/start --
fn handle_stream_start(body) {
    let name = dict_get(body, "name") ?? ""
    let buffer = dict_get(body, "buffer") ?? 455  // H13 * H7 * H5 = 455
    return tstream_start(name, buffer)
}

// -- POST /ttools/stream/write --
fn handle_stream_write(body) {
    let stream = dict_get(body, "stream") ?? ""
    let data = dict_get(body, "data") ?? ""
    return tstream_write(stream, data)
}

// -- POST /ttools/forge --
fn handle_forge(body) {
    let path = dict_get(body, "path") ?? ""
    return tforge_analyze(path)
}

// -- POST /ttools/filter --
fn handle_filter(body) {
    let text = dict_get(body, "text") ?? ""
    let texts = dict_get(body, "texts") ?? []
    let elements = dict_get(body, "elements") ?? []
    return tfilter_classify(text, texts, elements)
}

// -- POST /ttools/flow/message --
fn handle_flow_message(body) {
    let target = dict_get(body, "target") ?? "claude"
    let session = dict_get(body, "session") ?? "default"
    let role = dict_get(body, "role") ?? "user"
    let text = dict_get(body, "text") ?? ""
    return tflow_route_message(target, session, role, text)
}

// -- POST /ttools/flow/recall --
fn handle_flow_recall(body) {
    let target = dict_get(body, "target") ?? "claude"
    let session = dict_get(body, "session") ?? "default"
    let limit = dict_get(body, "limit") ?? 50
    return tflow_recall_session(target, session, limit)
}

// -- POST /ttools/flow/download --
fn handle_flow_download(body) {
    let url = dict_get(body, "url") ?? ""
    let filename = dict_get(body, "filename") ?? ""
    let size_bytes = dict_get(body, "size_bytes") ?? 0
    return tflow_route_download(url, filename, size_bytes)
}

// -- POST /ttools/weave/channel --
fn handle_weave_channel(body) {
    let source = dict_get(body, "source") ?? 0
    let dest = dict_get(body, "dest") ?? 0
    let cid = tweave_create_channel(source, dest)
    return {"ok": true, "channel_id": cid}
}

// -- POST /ttools/weave/send --
fn handle_weave_send(body) {
    let channel_id = dict_get(body, "channel_id") ?? ""
    let data = dict_get(body, "data") ?? {}
    return tweave_send(channel_id, data)
}

// -- POST /ttools/shield/record --
fn handle_shield_record(body) {
    let source = dict_get(body, "source") ?? ""
    let method = dict_get(body, "method") ?? "GET"
    let path = dict_get(body, "path") ?? "/"
    let size = dict_get(body, "size") ?? 0
    tshield_record(source, method, path, size)
    return {"ok": true}
}

// -- POST /ttools/shield/analyze --
fn handle_shield_analyze(body) {
    let source = dict_get(body, "source") ?? null
    return tshield_analyze(source)
}

