fn handle_reynolds(req) {
  let prompt = dict_get(req, "prompt", "")
  let sys_re = {"Re": hive_reynolds(), "regime": flow_regime(hive_reynolds())}
  let query_re = {}
  if3 (len(prompt) > 0) {
    let re_result = calculate_reynolds(prompt)
    let q_channel = dict_get(req, "channel", "")
    if3 (len(q_channel) == 0) { let q_channel = cluster_get_channel_for_query(prompt) }
    let query_re = {
      "Re": round(dict_get(re_result, "re", 0), 1),
      "regime": dict_get(re_result, "regime", "laminar"),
      "channel": q_channel
    }
