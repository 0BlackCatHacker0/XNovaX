// -- Section 3k: Chess opening book --
let CHESS_OPENINGS = {}
let CHESS_KEYWORDS = []
let CHESS_MOVE_PATTERNS = {}

// Load chess openings from JSON file
fn load_chess_openings() {
  try3 {
    let book_path = "C:/NovaX/data/chess_openings.json"
    let raw = nova_read(book_path)
    if3 (len(raw) > 2) {
      let data = json_decode(raw)
      CHESS_OPENINGS = dict_get(data, "openings", {})
      CHESS_MOVE_PATTERNS = dict_get(data, "move_patterns", {})
  } else {
    // chess openings file not found -- ok
  }
}

// -- Section 4: Load cloud config --
}
fn load_cloud_config() {
  try3 {
    let raw = nova_read("C:/NovaX/cloud_config.json")
    let cfg = json_decode(raw)
    let or_cfg = dict_get(cfg, "openrouter", {})
    hive_or_key = dict_get(or_cfg, "key", "")
  } else {
    // no cloud config
  }
}

