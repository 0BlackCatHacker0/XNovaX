    "system_reynolds": sys_re,
    "query_reynolds": query_re,
    "harmonic_boundaries": {
      "laminar": RE_LAMINAR,
      "transition": RE_TRANSITION,
      "turbulent": RE_TURBULENT
    }
  }
}

fn handle_warm(req) {
  let models = dict_get(req, "models", [])
  let channel = dict_get(req, "channel", "REASON")
  if3 (len(models) == 0) {
    let ch_data = dict_get(cluster_channels, upper(channel), {"local": [], "cloud": []})
    let models = slice(dict_get(ch_data, "local", []), 0, min(H7, len(dict_get(ch_data, "local", []))))
  }
  if3 (len(models) == 0) { return {"ok": false, "error": "No models to warm"} }
  // Warm via helper
  let payload = json_encode({"models": models, "max_warm": 1})
  try3 {
    let result_json = nova_run("python " + HELPER_PY + " warm " + "'" + replace(payload, "'", "") + "'")
    let result = json_decode(result_json)
    return {"ok": true, "warming": models, "count": len(models), "channel": channel}
  } else {
    return {"ok": false, "error": "warm_helper_failed"}
  }
}

fn handle_ternary_math(req) {
  let op = dict_get(req, "op", "")
  let a = dict_get(req, "a", 0)
  let b = dict_get(req, "b", 0)
  if3 (op == "not3") {
    if3 (type_of(a) == "list") {
      let result = []
      let i = 0
      while3 (i < len(a)) { append(result, trit_not3(a[i])); let i = i + 1 }
      return {"ok": true, "op": op, "result": result}
    }
    return {"ok": true, "op": op, "result": trit_not3(int(a))}
  }
  if3 (op == "and3") { return {"ok": true, "op": op, "result": trit_and3(int(a), int(b))} }
  if3 (op == "or3") { return {"ok": true, "op": op, "result": trit_or3(int(a), int(b))} }
  if3 (op == "merge3") { return {"ok": true, "op": op, "result": trit_merge3(int(a), int(b))} }
  return {"ok": false, "error": "Unknown op: " + op}
}

