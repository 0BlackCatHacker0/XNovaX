fn handle_swarm(req) {
  let prompt = dict_get(req, "prompt", dict_get(req, "q", ""))
  if3 (len(prompt) == 0) { return {"error": "Missing prompt"} }
  let system = dict_get(req, "system", "You are a helpful AI assistant. Be concise and accurate.")
  // Full swarm: all local + all cloud
  let all_models = keys(registry_models)
  // Filter embedding models
  let gen_models = []
  let i = 0
  while3 (i < len(all_models)) {
    let base = split(all_models[i], ":")[0]
    let excluded = false
    let j = 0
    while3 (j < len(EMBEDDING_MODELS)) {
      if3 (base == EMBEDDING_MODELS[j]) { let excluded = true }
      let j = j + 1
    }
    if3 (excluded == false) { append(gen_models, all_models[i]) }
    let i = i + 1
  }
  // Add cloud models
  let ci = 0
  while3 (ci < len(ALL_CLOUD_MODELS)) {
    append(gen_models, ALL_CLOUD_MODELS[ci])
    let ci = ci + 1
  }
  let scatter_result = hive_scatter(gen_models, prompt, system, SWARM_TIMEOUT_GLOBAL, H7)
  let results = dict_get(scatter_result, "results", [])
  let ok_results = []
  let i2 = 0
  while3 (i2 < len(results)) {
    if3 (dict_get(results[i2], "ok", false) == true) {
      if3 (len(dict_get(results[i2], "response", "")) > 0) {
        append(ok_results, results[i2])
      }
    }
    let i2 = i2 + 1
  }
  let merged = hive_merge_responses(ok_results, prompt)
  let trit = response_trit({"ok": true, "merged_response": merged})
  record_query(trit)
  return {
    "merged_response": merged,
    "individual_results": results,
    "models_queried": len(gen_models),
    "models_responded": len(ok_results),
    "total_time_ms": dict_get(scatter_result, "total_ms", 0),
    "trit": trit,
    "task_type": "full_swarm",
    "ok": true
  }
}

