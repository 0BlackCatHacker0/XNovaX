fn handle_health(req) {
  let re_num = hive_reynolds()
  let regime = flow_regime(re_num)
  let uptime = time() - dict_get(hive_stats, "t0", time())
  let model_count = len(registry_models)
  let self_trit = T_TRUE
  if3 (model_count == 0) { let self_trit = T_FALSE }
  if3 (uptime < 10) { let self_trit = T_MAYBE }
  return {
    "ok": true, "service": "nova-hivemind", "port": PORT,
    "version": "2.0", "ternary": true,
    "models": model_count,
    "harmonics": {"H3": H3, "H5": H5, "H7": H7, "H13": H13},
    "self_trit": self_trit,
    "reynolds": re_num, "flow_regime": regime,
    "uptime": int(uptime),
    "quality": {
      "strong": dict_get(hive_stats, "trits_pos", 0),
      "partial": dict_get(hive_stats, "trits_zero", 0),
      "failed": dict_get(hive_stats, "trits_neg", 0)
    },
    "total_queries": dict_get(hive_stats, "queries", 0)
  }
}

