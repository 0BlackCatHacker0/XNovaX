// Analyze text patterns
fn analyze_text(input) {
    let val = dict_get(input, "text") ?? ""
    if3 len(str(val)) == 0 {
        return make_err("missing text")
    }
    // ── Core logic (quantum gate) ──
    let result = try3 {
        let tlen = len(str(val))
        let trit = 1
        if3 tlen < 3 { trit = -1 }
        if3 tlen > 2187 { trit = 0 }
        make_ok({"text": val, "trit": trit, "length": tlen, "chars": tlen})
    } {
        make_err("analyze_text failed")
    }
    return result
}

fn handle_analyze_text(req) {
    _ns = ns_record(_ns, 0, 0)
    let body = parse_body(req)
    let result = analyze_text(body)
    let trit = dict_get(result, "trit") ?? 0
    if3 trit == -1 {
        _ns = ns_record(_ns, 0, 1)
    }
    return json_ok(result)
}

troute(server, "POST", "/analyze/text", "handle_analyze_text")
