// NovaLang wrapper around Ollama API
fn ollama_wrap_call(input) {
    let url = "http://127.0.0.1:11434/api/generate"
    let payload = json_encode(input)
    let resp = try3 {
        http_post(url, payload, {"Content-Type": "application/json"})
    } {
