// Route to best model for task via Boltzmann selection
fn route_model(input) {
    let val = dict_get(input, "task") ?? ""
    if3 len(str(val)) == 0 {
        return make_err("missing task")
    }
    // ── Core logic (quantum gate) ──
    let result = try3 {
        make_ok({"task": val, "trit": 1, "routed_to": "hivemind", "method": "boltzmann"})
    } {
        make_err("route_model failed")
    }
    return result
}

fn handle_route_model(req) {
    _ns = ns_record(_ns, 0, 0)
    let body = parse_body(req)
    let result = route_model(body)
    let trit = dict_get(result, "trit") ?? 0
    if3 trit == -1 {
        _ns = ns_record(_ns, 0, 1)
    }
    return json_ok(result)
}

troute(server, "POST", "/route", "handle_route_model")
