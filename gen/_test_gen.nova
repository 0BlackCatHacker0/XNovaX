let TPL_IMPORTS = "// imports\nimport3(\"lib\")\n\n"

fn tpl_microtool_fn(fn_name, description, input_field) {
    let code = "// " + description + "\n"
    code = code + "fn " + fn_name + "(input) {\n"
    code = code + "    let val = dict_get(input, \"" + input_field + "\", \"\")\n"
    code = code + "    return val\n"
    code = code + "}\n"
    return code
}

fn gen_microtool(name, description, input_field) {
    let code = "// header\n"
    code = code + TPL_IMPORTS
    code = code + tpl_microtool_fn(name, description, input_field)
    return code
}

let result = gen_microtool("test_tool", "A test tool", "data")
print("len: " + str(len(result)))
write_file("C:/NovaX/gen/_test_gen_out.nova", result)
print("done")
