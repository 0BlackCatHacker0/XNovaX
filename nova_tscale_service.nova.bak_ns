// ============================================================================
// TScale -- The Port Scale
// NovaX Port Balancer + Conflict Resolver + Continuity Monitor
// Port 9986 | Ternary Micro-Tool | 3-5-7-13 Harmonics | NovaLang
// ============================================================================
// A scale weighs things to find balance.
// TScale continuously weighs every NovaX port:
//   +1 = BALANCED (all ports healthy, no conflicts)
//    0 = TILTING  (some ports down or conflicting, correcting)
//   -1 = TIPPED   (critical services unreachable, emergency)
//
// TScale boots right after TSpin and stays live forever.
// Together with TShield and THunter, they form the startup QUAD-GUARDIAN:
//   TSpin spins, TScale balances, TShield cloaks, THunter hunts.
//
// GET:
//   /health              -- standard ternary health
//   /scale/status        -- balance state + stats
//   /scale/weigh         -- trigger full weigh of all ports
//   /scale/conflicts     -- detect active conflicts + resolution log
//   /scale/continuity    -- rolling balance window + uptime %
//   /scale/registry      -- full port registry dump
//   /scale/reservations  -- active port reservations
//   /triad               -- triad peer status + event logs
//
// POST:
//   /scale/reserve       -- reserve a port for a service
//   /scale/free          -- free a port reservation
//   /scale/resolve       -- resolve conflict on a specific port
//   /scale/rebalance     -- resolve ALL detected conflicts
//   /scale/check         -- check if a specific port is available
//   /scale/kill_port     -- kill everything on a port
//   /triad/event         -- receive inbound triad event
// ============================================================================

let VERSION = "2.0"
let PORT = 9986
let SERVICE = "nova-tscale"

// ============================================================================
// 3-5-7-13 Harmonic Constants
// ============================================================================
let H3 = 3
let H5 = 5
let H7 = 7
let H13 = 13
let BLOCK_SIZE = 2187

// ============================================================================
// Ternary States
// ============================================================================
let T_TRUE = 1
let T_MAYBE = 0
let T_FALSE = -1

// Scale States
let BALANCED = 1
let TILTING = 0
let TIPPED = -1

// ============================================================================
// Reynolds boundaries
// ============================================================================
let RE_LAMINAR = 27
let RE_TRANSITION = 125
let RE_TURBULENT = 343

// ============================================================================
// Triad + Quad-Guardian peers
// ============================================================================
let TRIAD_PEERS = {
    "tspin": "http://127.0.0.1:9970",
    "tshield": "http://127.0.0.1:9987",
    "thunter": "http://127.0.0.1:9988"
}

// ============================================================================
// Thresholds (3-5-7-13 aligned)
// ============================================================================
let WEIGH_INTERVAL = 5
let HEALTH_TIMEOUT = 3
let CONFLICT_THRESHOLD = 3
let CONTINUITY_WINDOW = 130

