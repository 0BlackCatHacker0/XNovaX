    {
        "name": "nova_tbuffer",
        "description": "NovaX TBuffer - Ternary Response Membrane. Compressed ternary cache between hivemind and world. Actions: query, store, write, lookup, status, invalidate.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "action": {"type": "string", "description": "TBuffer action (query, store, write, lookup, status, invalidate)"},
                "prompt": {"type": "string", "description": "Prompt text (for query/store)"},
                "response": {"type": "string", "description": "Response text (for store)"},
                "channel": {"type": "string", "description": "Flow channel (for query/store)"},
                "entry_id": {"type": "string", "description": "Entry ID (for lookup/invalidate/write)"},
