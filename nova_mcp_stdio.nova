        "inputSchema": {
            "type": "object",
            "properties": {
                "action": {"type": "string", "description": "Cortex action (status, claude, gpt, both, chain, fuse, arrange)"},
                "prompt": {"type": "string", "description": "Prompt for claude/gpt/both/chain/fuse"},
                "rounds": {"type": "number", "description": "Debate rounds for chain (default 1)"}
            },
            "required": ["action"]
        }
    },
    {
        "name": "nova_cloud",
        "description": "NovaX Cloud Router - Query specific cloud AI providers (OpenAI, Anthropic, Google, Mistral, Groq, DeepSeek, Cohere, Together, OpenRouter). Can target specific models or let the router choose.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "prompt": {"type": "string", "description": "The query to send"},
                "provider": {"type": "string", "description": "Cloud provider (openai, anthropic, google, mistral, groq, deepseek, cohere, together, openrouter). Auto-routed if omitted."},
