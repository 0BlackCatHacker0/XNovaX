// Nova MCP Server v1.0 — NovaLang Native
// Stdio-based MCP server for Claude Code
// JSON-RPC 2.0 over stdin/stdout
// Exposes full NovaX fleet to Claude's reasoning

let MCP_VERSION = "2024-11-05"
let SERVER_NAME = "novax"
let SERVER_VERSION = "1.0.0"

// ── Fleet endpoints ──
let ORCH = "http://127.0.0.1:9999"
let HIVE = "http://127.0.0.1:9881"
let TOOLS = "http://127.0.0.1:9891"
let TTOOLS = "http://127.0.0.1:9894"
let DEEP = "http://127.0.0.1:9893"
let VAULT = "http://127.0.0.1:9892"
let CORTEX = "http://127.0.0.1:9896"
let CLOUD = "http://127.0.0.1:9878"
let TBUF = "http://127.0.0.1:9886"

