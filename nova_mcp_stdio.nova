]

// ── HTTP helper: call fleet service, return parsed body ──
fn fleet_get(url) {
    let raw = try3 { http_get(url) } fail { null }
    if3 raw == null {
        return {"error": "connection failed"}
    }
    let body_str = dict_get(raw, "body") ?? ""
    let parsed = try3 { json_decode(body_str) } fail { null }
    if3 parsed != null {
        return parsed
    }
    return {"raw": body_str}
}

fn fleet_post(url, data) {
    let raw = try3 { http_post(url, data) } fail { null }
    if3 raw == null {
        return {"error": "connection failed"}
    }
    let body_str = dict_get(raw, "body") ?? ""
    let parsed = try3 { json_decode(body_str) } fail { null }
    if3 parsed != null {
        return parsed
    }
    return {"raw": body_str}
}

// ── Tool call dispatcher ──
fn handle_tool(name, args) {
    if3 name == "nova_query" { prompt = dict_get(args, "prompt") ?? ""
        let data = {"prompt": prompt}
        let channel = dict_get(args, "channel") ?? ""
        if3 channel != "" {
            data = dict_set(data, "channel", channel)
        }
        let result = fleet_post(HIVE + "/hive/cluster/query", data)
        let err = dict_get(result, "error") ?? ""
        if3 err != "" {
            return "Error: " + err
        }
        let resp = dict_get(result, "response") ?? ""
        let ch = dict_get(result, "channel") ?? "?"
        let regime = dict_get(result, "regime") ?? "?"
        let models = dict_get(result, "models_used") ?? "?"
        let ms = dict_get(result, "total_ms") ?? "?"
        return resp + "\n\n[Channel: " + str(ch) + " | Regime: " + str(regime) + " | Models: " + str(models) + " | Time: " + str(ms) + "ms]"

    } else3 name == "nova_status" {
        let health = fleet_get(ORCH + "/health")
        // Quick port scan for service count (faster than /api/services/status which scans 93 ports)
        let svc_health = fleet_get(ORCH + "/api/services/health")
        // Also get boot_complete and fleet_state from orchestrator
        let boot_complete = dict_get(health, "self_trit") ?? 0
        let uptime = dict_get(health, "uptime") ?? 0
        // Count services from health response
        let svc_list = dict_get(svc_health, "services") ?? []
        let total = len(svc_list)
        let up = 0
        let down = 0
        let si = 0
        while3 si < total {
            let s = svc_list[si]
            let trit = dict_get(s, "trit") ?? 0
            if3 trit >= 0 {
                up = up + 1
            } else3 {
                down = down + 1
            }
            si = si + 1
        }
        let svc_summary = {"total": total, "up": up, "down": down, "services": svc_list, "state": 1}
        return json_encode({"orchestrator": health, "services": svc_summary})

    } else3 name == "nova_tools" {
        let tool = dict_get(args, "tool") ?? ""
        // Forward all args directly to the service endpoint
        let result = fleet_post(TOOLS + "/tools/" + tool, args)
        let r = dict_get(result, "result") ?? ""
        if3 r != "" {
            return str(r)
        }
        return json_encode(result)

    } else3 name == "nova_multi" {
        let tool = dict_get(args, "tool") ?? ""
        let mode = dict_get(args, "mode") ?? "default"
        let data = {"tool": tool, "mode": mode, "args": args}
        let result = fleet_post(TOOLS + "/multi", data)
        return json_encode(result)

    } else3 name == "nova_hive" {
        let prompt = dict_get(args, "prompt") ?? ""
        let model = dict_get(args, "model") ?? ""
        if3 model != "" { let result = fleet_post(HIVE + "/hive/query", {"prompt": prompt, "model": model})
            let err = dict_get(result, "error") ?? ""
            if3 err != "" { return "Error: " + err }
            return dict_get(result, "response") ?? json_encode(result)
        } else3 {
            let result = fleet_post(HIVE + "/hive/swarm", {"prompt": prompt})
            let err = dict_get(result, "error") ?? ""
            if3 err != "" { return "Error: " + err }
            let resp = dict_get(result, "response") ?? ""
            if3 resp != "" { return resp }
            return dict_get(result, "merged") ?? json_encode(result)
        }

    } else3 name == "nova_ttools" {
        let tool = dict_get(args, "tool") ?? ""
        if3 tool == "status" {
            return json_encode(fleet_get(TTOOLS + "/health"))
        }
        // zombie tools
        if3 tool == "tzombie_scan" {
            return json_encode(fleet_get(TTOOLS + "/ttools/zombie/scan"))
        } else3 tool == "tzombie_kill" {
            let port = dict_get(args, "port") ?? 0
            return json_encode(fleet_post(TTOOLS + "/ttools/zombie/kill", {"port": port}))
        } else3 tool == "tzombie_sweep" {
            return json_encode(fleet_post(TTOOLS + "/ttools/zombie/sweep", {"_": 1}))
        }
        // generic ttools endpoint
        let data = {}
        let p = dict_get(args, "path") ?? ""
        if3 p != "" { data = dict_set(data, "path", p) }
        let pa = dict_get(args, "path_a") ?? ""
        if3 pa != "" { data = dict_set(data, "path_a", pa) }
        let pb = dict_get(args, "path_b") ?? ""
        if3 pb != "" { data = dict_set(data, "path_b", pb) }
        let k = dict_get(args, "key") ?? ""
        if3 k != "" { data = dict_set(data, "key", k) }
        let v = dict_get(args, "value") ?? ""
        if3 v != "" { data = dict_set(data, "value", v) }
        let q = dict_get(args, "query") ?? ""
        if3 q != "" { data = dict_set(data, "query", q) }
        let src = dict_get(args, "source") ?? ""
        if3 src != "" { data = dict_set(data, "source", src) }
        let dst = dict_get(args, "dest") ?? ""
        if3 dst != "" { data = dict_set(data, "dest", dst) }
        let result = fleet_post(TTOOLS + "/ttools/" + tool, data)
        let r = dict_get(result, "result") ?? ""
        if3 r != "" { return str(r) }
        return json_encode(result)

    } else3 name == "nova_deep" {
        let action = dict_get(args, "action") ?? ""
        if3 action == "status" {
            return json_encode(fleet_get(DEEP + "/deep/status"))
        }
        let data = {}
        let p = dict_get(args, "path") ?? ""
        if3 p != "" { data = dict_set(data, "path", p) }
        let o = dict_get(args, "output") ?? ""
        if3 o != "" { data = dict_set(data, "output", o) }
        let result = fleet_post(DEEP + "/deep/" + action, data)
        let r = dict_get(result, "result") ?? ""
        if3 r != "" { return str(r) }
        return json_encode(result)

    } else3 name == "nova_vault" {
        let action = dict_get(args, "action") ?? ""
        if3 action == "status" {
            return json_encode(fleet_get(VAULT + "/vault/status"))
        }
        let data = {}
        let p = dict_get(args, "path") ?? ""
        if3 p != "" { data = dict_set(data, "path", p) }
        let pw = dict_get(args, "password") ?? ""
        if3 pw != "" { data = dict_set(data, "password", pw) }
        let result = fleet_post(VAULT + "/vault/" + action, data)
        let r = dict_get(result, "result") ?? ""
        if3 r != "" { return str(r) }
        return json_encode(result)

    } else3 name == "nova_cortex" {
        let action = dict_get(args, "action") ?? ""
        if3 action == "status" {
            return json_encode(fleet_get(CORTEX + "/cortex/status"))
        } else3 action == "arrange" {
            return json_encode(fleet_post(CORTEX + "/cortex/arrange", {}))
        } else3 {
            let prompt = dict_get(args, "prompt") ?? ""
            if3 prompt == "" { return "Error: prompt required for cortex query" }
            let data = {"prompt": prompt}
            if3 action == "chain" { rounds = dict_get(args, "rounds") ?? 1
                data = dict_set(data, "rounds", rounds)
            }
            let result = fleet_post(CORTEX + "/cortex/" + action, data)
            let err = dict_get(result, "error") ?? ""
            if3 err != "" { return "Error: " + err }
            let resp = dict_get(result, "response") ?? ""
            if3 resp == "" { resp = dict_get(result, "final_response") ?? "" }
            if3 resp != "" { return resp }
            return json_encode(result)
        }

    } else3 name == "nova_cloud" {
        let prompt = dict_get(args, "prompt") ?? ""
        let data = {"prompt": prompt}
        let prov = dict_get(args, "provider") ?? ""
        if3 prov != "" { data = dict_set(data, "provider", prov) }
        let model = dict_get(args, "model") ?? ""
        if3 model != "" { data = dict_set(data, "model", model) }
        let result = fleet_post(CLOUD + "/cloud/query", data)
        let err = dict_get(result, "error") ?? ""
        if3 err != "" { return "Error: " + err }
        let resp = dict_get(result, "response") ?? ""
        if3 resp != "" { return resp }
        return json_encode(result)

    } else3 name == "nova_tbuffer" {
        let action = dict_get(args, "action") ?? "status"
        if3 action == "status" {
            return json_encode(fleet_get(TBUF + "/tbuffer/status"))
        } else3 action == "query" {
            let data = {"prompt": dict_get(args, "prompt") ?? "", "channel": dict_get(args, "channel") ?? ""}
            return json_encode(fleet_post(TBUF + "/tbuffer/query", data))
        } else3 action == "store" {
            let data = {"prompt": dict_get(args, "prompt") ?? "", "response": dict_get(args, "response") ?? "", "channel": dict_get(args, "channel") ?? ""}
            return json_encode(fleet_post(TBUF + "/tbuffer/store", data))
        } else3 action == "write" {
            let data = {"entry_id": dict_get(args, "entry_id") ?? "", "data": dict_get(args, "data") ?? "", "channel": dict_get(args, "channel") ?? ""}
            return json_encode(fleet_post(TBUF + "/tbuffer/write", data))
        } else3 action == "lookup" {
            return json_encode(fleet_post(TBUF + "/tbuffer/lookup", {"entry_id": dict_get(args, "entry_id") ?? ""}))
        } else3 action == "invalidate" {
            let data = {"entry_id": dict_get(args, "entry_id") ?? "", "channel": dict_get(args, "channel") ?? ""}
            return json_encode(fleet_post(TBUF + "/tbuffer/invalidate", data))
        } else3 {
            return "Unknown TBuffer action: " + action
        }

    } else3 {
        return "Unknown tool: " + name
    }
}

// ── Send JSON-RPC response to stdout ──
fn send(response) {
    print(json_encode(response))
}

// ── Handle a single JSON-RPC message ──
fn handle_message(msg) {
    let method = dict_get(msg, "method") ?? ""
    let msg_id = dict_get(msg, "id") ?? null
    let params = dict_get(msg, "params") ?? {}

    if3 method == "initialize" {
        send({
            "jsonrpc": "2.0",
            "id": msg_id,
            "result": {
                "protocolVersion": MCP_VERSION,
                "capabilities": {
                    "tools": {}
                },
                "serverInfo": {
                    "name": SERVER_NAME,
                    "version": SERVER_VERSION
                }
            }
        })

    } else3 method == "notifications/initialized" {
        // no response needed for notifications

    } else3 method == "tools/list" {
        send({
            "jsonrpc": "2.0",
            "id": msg_id,
            "result": {
                "tools": TOOL_DEFS
            }
        })

    } else3 method == "tools/call" {
        let tool_name = dict_get(params, "name") ?? ""
        let tool_args = dict_get(params, "arguments") ?? {}
        let result_text = try3 { handle_tool(tool_name, tool_args) } fail { "Tool error" }
        send({
            "jsonrpc": "2.0",
            "id": msg_id,
            "result": {
                "content": [
                    {"type": "text", "text": result_text}
                ]
            }
        })

    } else3 msg_id != null {
        send({
            "jsonrpc": "2.0",
            "id": msg_id,
            "error": {
                "code": -32601,
                "message": "Method not found: " + method
            }
        })
    }
}

// ── Main: stdio JSON-RPC loop ──
while3 true {
    let line = try3 { input() } fail { "__EOF__" }
    if3 line == "__EOF__" {
        break3
    }
    let trimmed = trim(line)
    if3 trimmed == "" || trimmed == "null" {
        continue3
    }
    let msg = try3 { json_decode(trimmed) } fail { null }
    if3 msg == null {
        send({
            "jsonrpc": "2.0",
            "id": null,
            "error": {"code": -32700, "message": "Parse error"}
        })
    } else3 {
        let ok = try3 {
            handle_message(msg)
            1
        } fail {
            send({
                "jsonrpc": "2.0",
                "id": dict_get(msg, "id") ?? null,
                "error": {"code": -32603, "message": "Internal error"}
            })
            0
        }
    }
}
