        "description": "NovaX DeepStorage - N-S flow-routed compression, dedup, and tiered storage. Actions: scan (analyze directory), quantize (compress+store), restore (decompress), status (storage stats), watch/unwatch (auto-monitor directory).",
        "inputSchema": {
            "type": "object",
            "properties": {
                "action": {"type": "string", "description": "DeepStorage action (scan, quantize, restore, status, watch, unwatch)"},
                "path": {"type": "string", "description": "File or directory path"},
                "output": {"type": "string", "description": "Output path (for restore)"}
            },
            "required": ["action"]
        }
    },
    {
