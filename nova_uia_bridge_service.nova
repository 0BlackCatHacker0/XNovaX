// Route: POST /uia/focus
// ============================================================

fn uia_focus(body) {
    let target = dict_get(body, "target") ?? "claude"
    let hwnd = dict_get(hwnds, target) ?? 0
    if3 hwnd == 0 {
        return {"ok": false, "error": "No window: " + target}
    }
    let result = uia_focus_window(hwnd)
    return {"ok": dict_get(result, "ok") ?? false, "action": "focus", "target": target}
}


