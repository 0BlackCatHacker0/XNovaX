// Nova UIA Bridge Service v1.0 - Session-1 UIA Bridge (NovaLang)
// Port 9902: Captures UIA element trees from Claude/GPT Desktop
// Relays commands from Cortex, executes via UIA delegation
//
// Architecture:
//   Bridge (session-1) -> captures UIA trees -> POSTs to Cortex (nowindow)
//   Cortex -> queues commands -> Bridge polls -> executes via UIA
//   Result: NovaX panels mirror and control real desktop apps
//
// ALL UIA automation delegated via nova_run() to uia_helper.py
// No ctypes, no comtypes, no threading, no for loops
//
// N-S Mapping:
//   element_flow   = velocity_field
//   noise_text     = turbulent particle
//   signal_text    = laminar flow
//   tfilter_trit   = Reynolds classification (+1 signal, 0 transitional, -1 noise)
//
// Endpoints:
//   GET  /health              -- standard tlight health
//   GET  /uia/status          -- bridge status with stats
//   POST /uia/tick            -- one capture+poll+execute cycle
//   POST /uia/capture         -- capture UIA tree for a target
//   POST /uia/execute         -- execute a command
//   GET  /uia/conversation    -- get conversation from cached tree
//   GET  /uia/app-state       -- get app state from cached tree
//   GET  /uia/windows         -- list discovered windows
//   POST /uia/focus           -- focus a target window
//   POST /uia/type            -- type text into target
//   POST /uia/submit          -- press enter in target
//   POST /uia/click           -- click element by name
//   POST /uia/key             -- press key combo
//   POST /uia/new-chat        -- start new chat
//   POST /uia/select-model    -- select model in dropdown
//   POST /uia/select-session  -- select sidebar session
//   POST /uia/copy-response   -- copy last response text

// -- Shared Libraries (N-S Flow) --
import3("C:/NovaX/lib/nova_ns_core.nova")
