// GET routes
troute(server, "GET", "/health", "tfetch_health")
troute(server, "GET", "/tfetch/status", "tfetch_status")
troute(server, "GET", "/tfetch/session/*", "tfetch_session_detail")
troute(server, "GET", "/tfetch/proxy/status", "tfetch_proxy_status")
troute(server, "GET", "/tfetch/speedtest", "tfetch_speedtest")

// POST routes
troute(server, "POST", "/tfetch/download", "tfetch_download")
troute(server, "POST", "/tfetch/pause", "tfetch_pause")
troute(server, "POST", "/tfetch/resume", "tfetch_resume")
troute(server, "POST", "/tfetch/cancel", "tfetch_cancel")
troute(server, "POST", "/tfetch/git", "tfetch_git")
troute(server, "POST", "/tfetch/proxy/enable", "tfetch_proxy_enable")
troute(server, "POST", "/tfetch/proxy/disable", "tfetch_proxy_disable")

