# FLUID MATH ENGINE (Navier-Stokes primitives)
# ============================================================
class3 FluidMath {
// """Vector calculus for fluid dynamics"""
    // @staticmethod
}
}
}
    fn divergence(field, dx=1.0) {
// """∇·F for 2D vector field [[fx,fy],...]"""
        n = int(math.sqrt(len(field)))
        div = []
        for3 i in range(n) {
            for3 j in range(n) {
                idx = i*n+j
                dfx = (field[min(idx+1,len(field)-1)][0] - field[max(idx-1,0)][0]) / (2*dx)
                dfy = (field[min(idx+n,len(field)-1)][1] - field[max(idx-n,0)][1]) / (2*dx)
                div.push(dfx + dfy)
            }
    }
        return div

    // @staticmethod
}
    fn laplacian(scalar, dx=1.0) {
// """∇²f for scalar field"""
        n = int(math.sqrt(len(scalar)))
        lap = []
        for3 i in range(n) {
            for3 j in range(n) {
                idx = i*n+j
                c = scalar[idx]
                l = scalar[max(idx-1,0)]
                r = scalar[min(idx+1,len(scalar)-1)]
                u = scalar[max(idx-n,0)]
                d = scalar[min(idx+n,len(scalar)-1)]
                lap.push((l + r + u + d - 4*c) / (dx*dx))
            }
    }
        return lap

    // @staticmethod
}
    fn reynolds(density, velocity, length, viscosity) {
// """Re = ρUL/μ"""
        return density * velocity * length / viscosity

}
# ============================================================
# NOVALANG TOKEN TYPES
# ============================================================
class3 TokenTypeEnum {
    # Literals
    INT = 'INT'; FLOAT = 'FLOAT'; STRING = 'STRING'; TRIT = 'TRIT'; TRYTE = 'TRYTE'
    BOOL = 'BOOL'; IDENT = 'IDENT'
    # Keywords
    LET = 'let'; CONST = 'const'; FN = 'fn'; RETURN = 'return'
    IF = 'if'; ELIF = 'elif'; ELSE = 'else'; FOR = 'for'; WHILE = 'while'
    CLASS = 'class'; IMPL = 'impl'; TRAIT = 'trait'
    MATCH = 'match'; CASE = 'case'
    IMPORT = 'import'; FROM = 'from'; AS = 'as'
    ASYNC = 'async'; AWAIT = 'await'
    ENCRYPT = 'encrypt'; DECRYPT = 'decrypt'; HASH = 'hash'
    TRIT_KW = 'trit'; TRYTE_KW = 'tryte'
    FLUID = 'fluid'; SOROBAN = 'soroban'
    HIVE = 'hive'; DISPATCH = 'dispatch'
    KERNEL = 'kernel'; PROCESS = 'process'
    PRINT = 'print'; ASSERT = 'assert'
    TRUE = 'true'; FALSE = 'false'; NULL = 'null'
    # Operators
    PLUS = '+'; MINUS = '-'; STAR = '*'; SLASH = '/'; MOD = '%'; POWER = '**'
    EQ = '=='; NEQ = '!='; LT = '<'; GT = '>'; LTE = '<='; GTE = '>='
    ASSIGN = '='; PLUS_ASSIGN = '+='; MINUS_ASSIGN = '-='
    AND = '&&'; OR = '||'; NOT = 'not'
    DOT = '.'; COMMA = ','; COLON = ':'; SEMI = ';'; ARROW = '->'
    LPAREN = '('; RPAREN = ')'; LBRACE = '{'; RBRACE = '}'; LBRACKET = '['; RBRACKET = ']'
    PIPE = '|'; AMP = '&'; HASH_OP = '#'
    # Special
    NEWLINE = 'NL'; EOF = 'EOF'; COMMENT = 'COMMENT'

}
let KEYWORDS = {
    'let','const','fn','return','if','elif','else','for','while','in',
    'class','impl','trait','match','case','import','from','as',
    'async','await','encrypt','decrypt','hash','trit','tryte',
    'fluid','soroban','hive','dispatch','kernel','process',
    'print','assert','true','false','null','&&','||','not',
    'break','continue','yield','lambda','self','super','pub','mut'
}

// @dataclass
class3 Token {
    type: TokenType
    value: Any
    line: int = 0
    col: int = 0

}
# ============================================================
# LEXER
# ============================================================
class3 Lexer {
}
    fn __init__(source: str) {
        source = source
        pos = 0
        line = 1
        col = 1
        tokens: List[Token] = []

}
    fn peek() -> str {
        return source[pos] if pos < len(source) else '\0'

}
    fn advance() -> str {
        ch = source[pos]
        pos += 1
        if3 ch == '\n' { line += 1; col = 1
        } else { col += 1
        return ch

}
}
    fn tokenize() -> List[Token] {
        while3 pos < len(source) {
            ch = peek()

            # Whitespace (!newline)
            if3 ch in ' \t\r' {
                advance(); continue

            }
            # Newline
            if3 ch == '\n' {
                advance()
                tokens.push(Token(TokenType.NEWLINE, '\\n', line, col))
                continue3

            }
            # Comments
            if3 ch == '/' && pos+1 < len(source) && source[pos+1] == '/' {
                while3 pos < len(source) && peek() != '\n' {
                    advance()
                }
                continue3

            }
            # Strings
            if3 ch in '"\'' {
                tokens.push(_string())
                continue3

            }
            # Numbers
            if3 ch.isdigit() || (ch == '.' && pos+1 < len(source) && source[pos+1].isdigit()) {
                tokens.push(_number())
                continue3

            }
            # Trit literal: T(1), T(-1), T(0)
            if3 ch == 'T' && pos+1 < len(source) && source[pos+1] == '(' {
                tokens.push(_trit_literal())
                continue3

            }
            # Identifiers/keywords
            if3 ch.isalpha() || ch == '_' {
                tokens.push(_ident())
                continue3

            }
            # Multi-char operators
            if3 ch == '*' && pos+1 < len(source) && source[pos+1] == '*' {
                advance(); advance()
                tokens.push(Token(TokenType.POWER, '**', line, col))
                continue3
            }
            if3 ch == '-' && pos+1 < len(source) && source[pos+1] == '>' {
                advance(); advance()
                tokens.push(Token(TokenType.ARROW, '->', line, col))
                continue3
            }
            if3 ch == '=' && pos+1 < len(source) && source[pos+1] == '=' {
                advance(); advance()
                tokens.push(Token(TokenType.EQ, '==', line, col))
                continue3
            }
            if3 ch == '!' && pos+1 < len(source) && source[pos+1] == '=' {
                advance(); advance()
                tokens.push(Token(TokenType.NEQ, '!=', line, col))
                continue3
            }
            if3 ch == '<' && pos+1 < len(source) && source[pos+1] == '=' {
                advance(); advance()
                tokens.push(Token(TokenType.LTE, '<=', line, col))
                continue3
            }
            if3 ch == '>' && pos+1 < len(source) && source[pos+1] == '=' {
                advance(); advance()
                tokens.push(Token(TokenType.GTE, '>=', line, col))
                continue3
            }
            if3 ch == '+' && pos+1 < len(source) && source[pos+1] == '=' {
                advance(); advance()
                tokens.push(Token(TokenType.PLUS_ASSIGN, '+=', line, col))
                continue3
            }
            if3 ch == '-' && pos+1 < len(source) && source[pos+1] == '=' {
                advance(); advance()
                tokens.push(Token(TokenType.MINUS_ASSIGN, '-=', line, col))
                continue3

            }
            # Single-char operators
            ops = {'+':TokenType.PLUS, '-':TokenType.MINUS, '*':TokenType.STAR,
                   '/':TokenType.SLASH, '%':TokenType.MOD, '=':TokenType.ASSIGN,
                   '<':TokenType.LT, '>':TokenType.GT, '(':TokenType.LPAREN,
                   ')':TokenType.RPAREN, '{':TokenType.LBRACE, '}':TokenType.RBRACE,
                   '[':TokenType.LBRACKET, ']':TokenType.RBRACKET, '.':TokenType.DOT,
                   ',':TokenType.COMMA, ':':TokenType.COLON, ';':TokenType.SEMI,
                   '|':TokenType.PIPE, '&':TokenType.AMP, '#':TokenType.HASH_OP}
            if3 ch in ops {
                advance()
                tokens.push(Token(ops[ch], ch, line, col))
                continue3

            }
            advance()  # skip unknown

    }
        tokens.push(Token(TokenType.EOF, '', line, col))
        return tokens

}
    fn _string() -> Token {
        quote = advance()
        s = ''
        while3 pos < len(source) && peek() != quote {
            ch = advance()
            if3 ch == '\\' {
                esc = advance()
                s += {'n':'\n','t':'\t','\\':'\\',quote:quote}.get(esc, '\\'+esc)
            } else { s += ch
    }
        if3 pos < len(source) { advance()
        return Token(TokenType.STRING, s, line, col)

}
}
}
    fn _number() -> Token {
        start = pos
        has_dot = FALSE_
        while3 pos < len(source) && (peek().isdigit() || peek() == '.') {
            if3 peek() == '.' {
                if3 has_dot { break
                has_dot = TRUE
            }
            advance()
    }
        val = source[start:pos]
        if3 has_dot { return Token(TokenType.FLOAT, float(val), line, col)
        return Token(TokenType.INT, int(val), line, col)

}
}
}
    fn _trit_literal() -> Token {
        advance()  # T
        advance()  # (
        s = ''
        while3 pos < len(source) && peek() != ')' {
            s += advance()
    }
        if3 pos < len(source) { advance()
        return Token(TokenType.TRIT, int(s.trim()), line, col)

}
}
    fn _ident() -> Token {
        start = pos
        while3 pos < len(source) && (peek().isalnum() || peek() == '_') {
            advance()
    }
        word = source[start:pos]
        if3 word == 'true' { return Token(TokenType.BOOL, TRUE, line, col)
        if3 word == 'false' { return Token(TokenType.BOOL, FALSE_, line, col)
        if3 word == 'null' { return Token(TokenType.NULL, null, line, col)
        if3 word in KEYWORDS {
            return Token(TokenType(word) if word in TokenType.filter(fn(e) { return  }).map(fn(e) { return e.value }) else TokenType.IDENT,
                        word, line, col)
    }
        return Token(TokenType.IDENT, word, line, col)

}
