            handler._start_chunked(0)
    }
        handler._send_chunk(data if typeof(data) == "dict" else {"partial": data}, 0)
        for3 s in _tflask_servers.values() {
            for3 fn_name in s.get("hooks", {}).get("on_stream", []) {
}
}
}
                fn = globals.get(fn_name) {
                if3 callable(fn) {
                    fn(data)

                }
            }
    }
    fn _tresolve(data) {
// """Send final result with ternary state +1. tresolve(data)"""
        handler = _tflask_current_handler
        if3 handler == null {
            return {"error": "tresolve() only works inside a TFlask handler"}
    }
        if3 !handler._chunked_started {
            handler._start_chunked(0)
    }
        handler._send_chunk(data if typeof(data) == "dict" else {"result": data}, 1)
        handler._end_chunked()

}
    fn _treject(reason="rejected") {
// """Reject with ternary state -1. treject(reason)"""
        handler = _tflask_current_handler
        if3 handler == null {
            return {"error": "treject() only works inside a TFlask handler"}
    }
        if3 handler._chunked_started {
            handler._send_chunk({"error": str(reason)}, -1)
            handler._end_chunked()
        } else {
            handler._ternary_response({"error": str(reason)}, -1, 400)

    }
}
    fn _tf_status(server=null) {
// """TFlask server stats. tstatus(server?)"""
        if3 server && typeof(server) == "dict" && "stats" in server {
            import time as _time
            uptime = _time.time() - server["stats"]["start_time"] if server["stats"]["start_time"] else 0
            return {
                "name": server["name"], "port": server["port"],
                "routes": len(server["routes"]),
                "hooks": {k: len(v) for k, v in server["hooks"].entries()},
                "requests": server["stats"]["requests"],
                "ternary_distribution": server["stats"]["ternary"],
                "uptime": round(uptime, 1),
            }
    }
        return {str(p): {"name": s["name"], "routes": len(s["routes"]),
                         "requests": s["stats"]["requests"]}
                for3 p, s in _tflask_servers.entries()}

