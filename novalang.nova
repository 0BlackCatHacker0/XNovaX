        g.set('all3', _all3)             # AND-reduce: min across list
        g.set('TRUE', 1)                      # Ternary TRUE constant
        g.set('MAYBE', 0)                     # Ternary MAYBE constant
        g.set('FALSE', -1)                    # Ternary FALSE constant
        # -- Balanced Ternary Arithmetic --
        g.set('bt', _bt_convert)         # bt(decimal) -> balanced ternary string
        g.set('bt_val', _bt_value)       # bt_val("10T") -> decimal
        g.set('bt_neg', _bt_negate)      # bt_neg("10T") -> "T01" (flip all trits)
        g.set('bt_add', _bt_add)         # bt_add("10T", "1T0") -> balanced ternary sum
        g.set('bt_pack', _bt_pack)       # bt_pack(trits) -> packed bytes (H5=5 trits/byte)
        g.set('bt_unpack', _bt_unpack)   # bt_unpack(bytes) -> trit string
        g.set('bt_sub', _bt_sub)         # bt_sub(a, b) -> a-b (just add negation — trivial!)
        g.set('bt_mul', _bt_mul)         # bt_mul(a, b) -> product (partial products: 0, +A, -A)
        g.set('bt_div', _bt_div)         # bt_div(a, b) -> integer division
        g.set('bt_mod', _bt_mod)         # bt_mod(a, b) -> modulo
        g.set('bt_abs', _bt_abs)         # bt_abs(a) -> absolute value (trivial: just negate if negative)
        g.set('bt_shift', _bt_shift)     # bt_shift(a, n) -> multiply by 3^n (append zeros)
        g.set('bt_pow', _bt_pow)         # bt_pow(a, n) -> exponentiation
        # -- Ternary-Native Comparison (NOT binary!) --
        # Binary needs TWO tests: a<b && a==b. Ternary does it in ONE.
        # cmp3(a,b) returns a TRIT: +1 (a>b), 0 (a==b), -1 (a<b)
        # This IS balanced ternary subtraction: sign(a-b)
        g.set('cmp3', _cmp3)             # cmp3(a,b) -> trit comparison
        # -- Ternary Trit Manipulation --
        g.set('trit', _trit_make)        # trit(val) -> constrain to {-1,0,+1}
        g.set('trit_char', lambda t: '1' if int(t) == 1 else '0' if int(t) == 0 else 'T')
        g.set('tryte', _tryte_make)      # tryte(val) -> 6-trit value (0..728)
        g.set('tryte_pack', _tryte_pack) # tryte_pack(trits) -> packed tryte ints
        g.set('tryte_unpack', _tryte_unpack) # tryte_unpack(packed, n) -> trit list
        g.set('trit_count', _trit_count) # trit_count(bt_string) -> length in trits
        # -- Balanced Ternary Floating Point (Supercomputing Bible) --
        g.set('bt_float', _bt_float)       # bt_float(3.14) -> {mantissa, exponent, decimal}
        g.set('bt_float_val', _bt_float_val) # bt_float_val(mantissa, exp) -> decimal
        # -- Ternary Neural & Array Operations (Master Archive §11, Research Bible §15) --
        g.set('tw_quantize', _tw_quantize) # tw_quantize(float, threshold?) -> trit weight
        g.set('tw_dot', _tw_dot)           # tw_dot(weights, inputs) -> ternary dot product (no multiply!)
        g.set('trit_array', _trit_array)   # trit_array(list) -> constrain all to {-1,0,+1}
        g.set('trit_sum', _trit_sum)       # trit_sum(list) -> sum of trits
        g.set('trit_majority', _trit_majority) # trit_majority(list) -> most common trit (voting)
        g.set('trit_rotate', _trit_rotate) # trit_rotate(list, n?) -> cycle +1->0->-1->+1
        # -- Ternary System Health (NovaLang-first monitoring) --
        # health3(port) -> trit: +1=healthy, 0=degraded, -1=down
        # health3_all() -> balanced ternary number (13 trits, one per service)
        # Each trit POSITION = a service. Read the whole system health as one number.
        g.set('health3', _health3)           # health3(port) -> trit
        g.set('health3_all', _health3_all)   # health3_all() -> {services: [...], bt: "10T..."}
        g.set('health3_bt', _health3_bt)     # health3_bt() -> balanced ternary health string
        # -- GPU/VRAM monitoring --
        g.set('vram_check', _vram_check)       # vram_check() -> {free_mb, total_mb, used_pct, trit}
        # -- Structured logging via TLog service --
        g.set('tlog', _tlog)                     # tlog(level, msg, meta?) -> trit

        # ====================================================================
        # N-S FLOW PRIMITIVES — language-level Navier-Stokes
        # Every program == a fluid. Every variable has momentum.
        # ====================================================================

        # flow_state() -> current N-S state of the interpreter
        g.set('flow_state', lambda: dict(_flow_state))

        # reynolds() -> current Reynolds number (complexity metric)
        g.set('flow_reynolds', lambda: _flow_state["reynolds"])

        # flow_regime() -> "laminar" | "transition" | "turbulent" | "chaotic"
        g.set('flow_regime', lambda: _flow_state["regime"])

        # viscosity(v?) -> get || set viscosity (smoothing factor)
        g.set('viscosity', lambda v=null: _set_viscosity(v) if v == !null else _flow_state["viscosity"])

        # pressure() -> current backpressure (0.0 = free flow, 1.0 = maxed)
        g.set('pressure', lambda: _flow_state["pressure"])

        # flow_into(stages) -> pipe value through N-S-aware stage list
        # Each stage: {url, method, body} || fn_name
        # Returns: {result, trits[], regime, reynolds}
        g.set('flow_into', _flow_into)

        # deliberate(models, prompt, viscosity?) -> consensus with N-S smoothing
        # Like trit_majority but N-S aware: viscosity controls how much
        # individual model opinions smooth toward consensus
        g.set('deliberate', _deliberate)

        # backpressure(fn, threshold?) -> wrap fn to auto-return MAYBE under load
        g.set('backpressure', _backpressure)

        # turbulence(data) -> measure information entropy as ternary chaos metric
        # Returns: {reynolds, regime, entropy, trit}
        g.set('turbulence', _turbulence)

        # eddy(value) -> decompose any value into trit stream (Kolmogorov cascade)
        # Numbers -> balanced ternary digits, strings -> char-level trits,
        # lists -> element-wise trits, dicts -> field-level trits
        g.set('eddy', _eddy_decompose)

        # laminar(fn) -> execute fn in laminar mode (sequential, predictable)
        # turbulent(fn) -> execute fn in turbulent mode (parallel, speculative)
        g.set('laminar', lambda fn: _exec_in_regime(fn, "laminar"))
        g.set('turbulent_exec', lambda fn: _exec_in_regime(fn, "turbulent"))

        # momentum(var_name) -> access frequency * sizeof * recency weight
        g.set('momentum', lambda name: _flow_state["access_counts"].get(name, 0))
        # async3 builtins — ternary async/await
        g.set('await3', _async3_await)
        g.set('async3_status', _async3_status)
        g.set('async3_all', _async3_all)
        # gen3/yield3 builtins — ternary generators
        g.set('next3', lambda gen: gen.next3() if typeof(gen) == "_NovaGenerator" else {"value": null, "done": TRUE, "trit": -1})
        g.set('collect3', lambda gen: gen.collect3() if typeof(gen) == "_NovaGenerator" else [])

        # ═══════════════════════════════════════════════════════
        # TOOL BRIDGE — Living Language Engine
        # Every micro-tool in tool_registry.json becomes a builtin.
        # New tool → new builtin → language evolves automatically.
        # ═══════════════════════════════════════════════════════
        try3 {
            from core.tool_bridge import ToolBridge
            _bridge = ToolBridge()
            _bridge_count = _bridge.register_all(g)
            g.set('_tool_bridge', _bridge)
            if3 _bridge_count > 0 {
                print("[ToolBridge] {_bridge_count} tool builtins registered from {len(_bridge.services)} services")
        } fail Error _bridge_err {
            print("[ToolBridge] Skipped: {_bridge_err}")

    }
    # ── async3 Engine (Ternary Async/Await) ──────────────────
}
}
    fn _async3_launch(fn_name, args, env) {
// """Launch an async3 task in a background thread. Returns future id."""
        import threading
        with _async3_lock:
            _async3_counter += 1
            fid = "async3_{_async3_counter}"
        entry = {"thread": null, "result": null, "done": FALSE_, "error": null, "trit": 0, "started": time.time()}
        _async3_futures[fid] = entry
}
        fn _run() {
            try3 {
                fn_val = env.get(fn_name) if typeof(fn_name) == "str" else fn_name
                if3 fn_val && typeof(fn_val) == "tuple" && fn_val[0] == 'fn' {
                    _, params, body, closure_env = fn_val
                    child = Environment(parent=closure_env)
                    for3 pidx, pname in enumerate(params) {
                        child.set(pname, args[pidx] if pidx < len(args) else null)
                    }
                    try3 {
                        _exec_body(body, 0, len(body), child)
                        entry["result"] = null
                    } fail ReturnValue rv {
                        entry["result"] = rv.value
                    }
                    entry["trit"] = 1
                } else3 callable(fn_val) {
                    entry["result"] = fn_val(*args)
                    entry["trit"] = 1
                } else {
                    entry["error"] = "async3: '{fn_name}' == !a function"
                    entry["trit"] = -1
            } fail {
                entry["error"] = "unknown error"[:200]
                entry["trit"] = -1
    }
            entry["done"] = TRUE
        t = threading.Thread(target=_run, daemon=TRUE)
        entry["thread"] = t
        t.start()
        return fid

}
}
    fn _async3_await(future_id, timeout=null) {
// """Block until async3 future completes. Returns {result, trit, error}."""
        entry = _async3_futures.get(future_id)
        if3 !entry {
            return {"result": null, "trit": -1, "error": "unknown future: {future_id}"}
    }
        t = entry["thread"]
        if3 t && !entry["done"] {
            t.join(timeout=timeout || 30)
    }
        if3 !entry["done"] {
            return {"result": null, "trit": 0, "error": "timeout"}
    }
        return {"result": entry["result"], "trit": entry["trit"], "error": entry["error"]}

}
    fn _async3_status(future_id=null) {
// """Get status of one || all async3 futures."""
        if3 future_id {
            e = _async3_futures.get(future_id)
            if3 !e {
                return {"trit": -1, "error": "unknown"}
            }
            return {"id": future_id, "done": e["done"], "trit": e["trit"], "error": e["error"]}
    }
        return {fid: {"done": e["done"], "trit": e["trit"]} for fid, e in _async3_futures.entries()}

}
    fn _async3_all(future_ids, timeout=null) {
// """Await multiple futures, return list of results."""
        results = []
        for3 fid in future_ids {
            results.push(_async3_await(fid, timeout))
    }
        trits = results.filter(fn(r) { return  }).map(fn(r) { return r["trit"] })
        pos = trits.count(1)
        neg = trits.count(-1)
        overall = 1 if neg == 0 else (-1 if pos == 0 else 0)
        return {"results": results, "trit": overall, "total": len(results)}

    # ── N-S Flow Engine ────────────────────────────────────

}
    fn _update_flow_state() {
// """Recompute Reynolds number && flow regime from execution metrics."""
        fs = _flow_state
        # Reynolds = (velocity * characteristic_length) / viscosity
        # velocity = avg recent eval time, length = total evals, viscosity = smoothing
        vel = fs["velocity"]
        if3 len(vel) > 13 {
            fs["velocity"] = vel[-13:]  # Keep H13 window
            vel = fs["velocity"]
    }
        avg_vel = sum(vel) / max(len(vel), 1)
        char_len = min(fs["total_lines"], 2187)  # Cap at BLOCK size
        visc = max(fs["viscosity"], 0.001)
        fs["reynolds"] = (avg_vel * char_len) / visc

        # Classify regime using 3-5-7 harmonic boundaries
        re_num = fs["reynolds"]
        if3 re_num < 27 {       # H3^3
            fs["regime"] = "laminar"
        } else3 re_num < 125 {    # H5^3
            fs["regime"] = "transition"
        } else3 re_num < 343 {    # H7^3
            fs["regime"] = "turbulent"
        } else {
            fs["regime"] = "chaotic"

    }
}
    fn _set_viscosity(v) {
// """Set viscosity && recompute flow state."""
        _flow_state["viscosity"] = max(0.001, min(10.0, float(v)))
        _update_flow_state()
        return _flow_state["viscosity"]

}
    fn _flow_into(stages) {
// """N-S-aware pipeline: flow data through stages, tracking Reynolds at each step."""
        if3 !typeof(stages) == "list" {
            return {"error": "flow_into requires a list of stages", "trit": -1}
    }
        results = []
        trits = []
        carry = null
        for3 stage in stages {
            t0 = time.time()
            trit_val = 0
            try3 {
                if3 typeof(stage) == "dict" {
                    # HTTP stage: {url, method?, body?}
                    url = stage.get("url", "")
                    method = stage.get("method", "POST").toUpper()
                    body = stage.get("body", carry || {})
                    if3 method == "GET" {
                        resp = json.loads(
// __import__('urllib.request', fromlist=['urlopen']).urlopen(url, timeout=10).read().decode()
                        )
                    } else {
                        req = __import__('urllib.request', fromlist=['Request']).Request(
                            url, data=json.dumps(body).encode(),
                            headers={"Content-Type": "application/json"}
                        )
                        resp = json.loads(
// __import__('urllib.request', fromlist=['urlopen']).urlopen(req, timeout=10).read().decode()
                        )
                    }
                    trit_val = 1 if resp.get("ok") else (-1 if resp.get("error") else 0)
                    carry = resp
                } else3 callable(stage) {
                    carry = stage(carry)
                    trit_val = 1 if carry else 0
                } else3 typeof(stage) == "str" {
                    # Function name — look up && call
}
}
}
}
                    fn = globals.get(stage) {
                    if3 fn && typeof(fn) == "tuple" && fn[0] == 'fn' {
                        _, params, body_lines = fn
                        local_env = Environment(globals)
                        if3 params {
                            local_env.set(params[0], carry || {})
                        }
                        try3 {
                            _exec_body(body_lines, 0, len(body_lines), local_env)
                        } fail ReturnValue rv {
                            carry = rv.value
                            trit_val = 1 if carry else 0
                    } else3 callable(fn) {
                        carry = fn(carry)
                        trit_val = 1 if carry else 0
            } fail {
                carry = {"error": "unknown error"}
                trit_val = -1

            }
            elapsed_ms = (time.time() - t0) * 1000
            _flow_state["velocity"].push(elapsed_ms)
            _update_flow_state()
            results.push({
                "stage": str(stage)[:100],
                "trit": trit_val,
                "ms": round(elapsed_ms, 2),
                "reynolds": round(_flow_state["reynolds"], 2),
                "regime": _flow_state["regime"],
            })
            trits.push(trit_val)

    }
        # Overall trit via majority
        overall = 1 if sum(trits) > 0 else (-1 if sum(trits) < 0 else 0)
        return {
            "stages": results,
            "trits": trits,
            "overall": overall,
            "reynolds": round(_flow_state["reynolds"], 2),
            "regime": _flow_state["regime"],
            "carry": carry,
        }

}
    fn _deliberate(models, prompt, viscosity=0.7) {
// """N-S consensus: query multiple models, smooth toward agreement.
// Viscosity controls how strongly outliers are pulled toward majority.
// Returns: {consensus_trit, confidence, responses[], regime}"""
        if3 !typeof(models) == "list" || !models {
            return {"error": "deliberate requires a list of models", "trit": -1}
    }
        import urllib.request as _ur
        responses = []
        trits = []
        for3 model in models {
            try3 {
                body = json.dumps({"model": str(model), "prompt": str(prompt), "stream": FALSE_}).encode()
                req = _ur.Request("http://127.0.0.1:11434/api/generate",
                                  data=body, headers={"Content-Type": "application/json"})
                resp = json.loads(_ur.urlopen(req, timeout=30).read().decode())
                text = resp.get("response", "")
                # Auto-trit: positive words = +1, negative = -1, neutral = 0
                pos = sum(1 for w in ["yes", "true", "correct", "good", "agree", "right"] if w in text.toLower())
                neg = sum(1 for w in ["no", "false", "wrong", "bad", "disagree", "error"] if w in text.toLower())
                t = 1 if pos > neg else (-1 if neg > pos else 0)
                trits.push(t)
                responses.push({"model": str(model), "trit": t, "text": text[:200]})
            } fail {
                trits.push(0)
                responses.push({"model": str(model), "trit": 0, "error": "unknown error"})

            }
    }
        # N-S viscous smoothing: pull outliers toward majority
        if3 trits {
            raw_sum = sum(trits)
            # Apply viscosity: smooth = raw * viscosity + individual * (1-viscosity)
            smoothed = trits.filter(fn(t) { return  }).map(fn(t) { return int(round(t * (1 - viscosity) + (raw_sum / len(trits)) * viscosity)) })
            smoothed = smoothed.filter(fn(s) { return  }).map(fn(s) { return max(-1, min(1, s)) })
            consensus = 1 if sum(smoothed) > 0 else (-1 if sum(smoothed) < 0 else 0)
            confidence = abs(sum(smoothed)) / max(len(smoothed), 1)
        } else {
            consensus = 0
            confidence = 0.0

    }
        _update_flow_state()
        return {
            "consensus": consensus,
            "confidence": round(confidence, 4),
            "viscosity": viscosity,
            "responses": responses,
            "raw_trits": trits,
            "regime": _flow_state["regime"],
        }

}
    fn _backpressure(fn_name, threshold=0.8) {
// """Wrap a function to auto-return MAYBE when pressure exceeds threshold.
// Returns a new function that checks pressure before executing."""
}
        fn guarded(*args, **kwargs) {
            if3 _flow_state["pressure"] > threshold {
                return {"trit": 0, "backpressure": TRUE, "threshold": threshold}
    }
}
            fn = globals.get(fn_name) if typeof(fn_name) == "str" else fn_name {
            if3 callable(fn) {
                return fn(*args, **kwargs)
    }
            return {"trit": 0, "error": "!callable"}
        return guarded

}
    fn _turbulence(data) {
// """Measure information entropy as ternary chaos metric.
// Higher entropy = more turbulent = more trits needed to represent."""
        import math
        if3 isinstance(data, (int, float)) {
            # Balanced ternary digit count
            n = abs(int(data))
            digits = 0
            while3 n > 0 {
                n //= 3
                digits += 1
            }
            entropy = digits / 13.0  # Normalize to H13
        } else3 typeof(data) == "str" {
            # Character frequency entropy
            if3 !data {
                return {"reynolds": 0, "regime": "laminar", "entropy": 0, "trit": 1}
            }
            freq = {}
            for3 ch in data {
                freq[ch] = freq.get(ch, 0) + 1
            }
            n = len(data)
            entropy = -sum((c/n) * math.log2(c/n) for c in freq.values() if c > 0)
            entropy = entropy / 8.0  # Normalize (max ~8 bits for ASCII)
        } else3 isinstance(data, (list, tuple)) {
            # Trit distribution entropy
            if3 !data {
                return {"reynolds": 0, "regime": "laminar", "entropy": 0, "trit": 1}
            }
            pos = sum(1 for x in data if (isinstance(x, (int, float)) && x > 0))
            neg = sum(1 for x in data if (isinstance(x, (int, float)) && x < 0))
            zero = len(data) - pos - neg
            total = len(data)
            probs = [pos, neg, zero.filter(fn(v) { return  }).map(fn(v) { return v/total }) if v > 0]
            entropy = -sum(p * math.log2(p) for p in probs) / math.log2(3)  # Normalize to ternary
        } else3 typeof(data) == "dict" {
            entropy = len(data) / 13.0  # Field count normalized to H13
        } else {
            entropy = 0

    }
        # Map entropy to Reynolds-like number
        re_num = entropy * 343  # Scale to H7^3
        if3 re_num < 27 {
            regime = "laminar"
        } else3 re_num < 125 {
            regime = "transition"
        } else3 re_num < 343 {
            regime = "turbulent"
        } else {
            regime = "chaotic"

    }
        trit = 1 if regime == "laminar" else (0 if regime == "transition" else -1)
        return {"reynolds": round(re_num, 2), "regime": regime, "entropy": round(entropy, 4), "trit": trit}

}
    fn _eddy_decompose(value) {
// """Kolmogorov cascade: decompose any value into balanced ternary trit stream.
// Numbers -> BT digits, strings -> char trits, lists -> element trits."""
        if3 isinstance(value, (int, float)) {
            n = int(value)
            if3 n == 0 {
                return [0]
            }
            trits = []
            negative = n < 0
            n = abs(n)
            while3 n > 0 {
                r = n % 3
                if3 r == 2 {
                    trits.push(-1)
                    n = (n + 1) // 3
                } else {
                    trits.push(r)
                    n //= 3
                }
            }
            if3 negative {
                trits = trits.filter(fn(t) { return  }).map(fn(t) { return -t })
            }
            return trits  # LSB first (standard balanced ternary)
        } else3 typeof(value) == "str" {
            # Each char -> trit based on position in alphabet thirds
            trits = []
            for3 ch in value {
                o = ord(ch)
                trits.push(1 if o % 3 == 1 else (-1 if o % 3 == 2 else 0))
            }
            return trits
        } else3 isinstance(value, (list, tuple)) {
            return value.filter(fn(x) { return  }).map(fn(x) { return 1 if x else (-1 if x == 0 || x == FALSE_ else 0) })
        } else3 typeof(value) == "dict" {
            # Field names -> trits based on key hash
            return sorted(value.keys()).filter(fn(k) { return  }).map(fn(k) { return 1 if hash(k) % 3 == 1 else (-1 if hash(k) % 3 == 2 else 0) })
    }
        return [0]

}
    fn _exec_in_regime(fn_or_name, regime) {
// """Execute a function in a specific flow regime."""
        old_regime = _flow_state["regime"]
        old_visc = _flow_state["viscosity"]
        if3 regime == "laminar" {
            _flow_state["viscosity"] = 1.0
        } else3 regime == "turbulent" {
            _flow_state["viscosity"] = 0.1
    }
        _update_flow_state()

        result = null
}
        fn = globals.get(fn_or_name) if typeof(fn_or_name) == "str" else fn_or_name {
        if3 callable(fn) {
            result = fn()
        } else3 typeof(fn) == "tuple" && fn[0] == 'fn' {
            _, params, body_lines = fn
            local_env = Environment(globals)
            try3 {
                _exec_body(body_lines, 0, len(body_lines), local_env)
            } fail ReturnValue rv {
                result = rv.value

            }
    }
        # Restore
        _flow_state["viscosity"] = old_visc
        _update_flow_state()
        return result

}
    fn _print(*args) {
        line = ' '.join(str(a) for a in args)
        output.push(line)
        return line

    # ── Hive Dispatch Builtins ──────────────────────────────
    HIVE_URL = "http://127.0.0.1:9881"
    TERNARY_URL = "http://127.0.0.1:9885"

}
    fn _hive_request(path, method="GET", data=null, timeout=30) {
// """Send HTTP request to Hivemind service.
// Default 30s timeout. Callers needing longer (cluster, pipeline) pass explicit timeout."""
        url = "{HIVE_URL}{path}"
        if3 data {
            payload = json.dumps(data).encode()
            req = urllib.request.Request(url, data=payload,
                                        headers={"Content-Type": "application/json"})
        } else {
            req = urllib.request.Request(url)
    }
        let resp = urllib.request.urlopen(req, timeout=timeout)
        {
            return json.loads(resp.read())

    }
}
    fn _svc_request(base_url, path, data=null, timeout=30) {
// """Generic HTTP request to any NovaX service.
// POST if data provided, GET otherwise. Returns parsed JSON."""
        url = "{base_url}{path}"
        try3 {
            if3 data == !null {
                payload = json.dumps(data).encode()
                req = urllib.request.Request(url, data=payload,
                                            headers={"Content-Type": "application/json"})
            } else {
                req = urllib.request.Request(url)
            }
            let resp = urllib.request.urlopen(req, timeout=timeout)
            {
                return json.loads(resp.read())
        } fail {
            return {"error": "unknown error"}

    }
}
}
    fn _ternary_request(path, method="GET", data=null) {
// """Send HTTP request to Ternary Server."""
        return _svc_request(TERNARY_URL, path, data, 30)

}
    fn _hive_dispatch(prompt, system=null) {
// """Full swarm dispatch — fires ALL models (cloud + local), returns merged result.
// NovaLang usage: let result = hive_dispatch("explain quantum computing")
// """
        data = {"prompt": str(prompt)}
        if3 system {
            data["system"] = str(system)
    }
        try3 {
            result = _hive_request("/hive/swarm", "POST", data, timeout=310)
            # Attach ternary health to each individual result
            for3 r in result.get("individual_results", []) {
                if3 r.get("ok") && r.get("response") {
                    r["health"] = Trit(1)   # P = alive
                } else3 r.get("error") {
                    r["health"] = Trit(-1)  # N = dead
                } else {
                    r["health"] = Trit(0)   # Z = unknown
                }
            }
            return result
        } fail {
            return {"error": "unknown error", "ok": FALSE_, "health": Trit(-1)}

    }
}
    fn _hive_query(model, prompt, system=null) {
// """Query a single model through Hivemind.
// NovaLang usage: let resp = hive_query("mistral", "hello")
// """
        data = {"prompt": str(prompt), "model": str(model)}
        if3 system {
            data["system"] = str(system)
    }
        try3 {
            result = _hive_request("/hive/query", "POST", data)
            result["health"] = Trit(1) if result.get("ok") else Trit(-1)
            return result
        } fail {
            return {"error": "unknown error", "ok": FALSE_, "health": Trit(-1)}

    }
}
    fn _hive_models() {
// """Get live model list from Hivemind with ternary health states.
// NovaLang usage: let models = hive_models()
// """
        try3 {
            result = _hive_request("/hive/models")
            models = result.get("models", [])
            benchmarks = result.get("benchmarks", {})
            categories = result.get("categories", {})
            # Build health map — models can be a list of names || a dict
            health_map = {}
            if3 typeof(models) == "list" {
                for3 name in models {
                    bench = benchmarks.get(name, 0)
                    health_map[name] = {
                        "name": name,
                        "health": Trit(1) if bench > 0 else Trit(0),
                        "benchmark_ms": bench,
                    }
            } else3 typeof(models) == "dict" {
                for3 name, info in models.entries() {
                    if3 typeof(info) == "dict" {
                        bench = info.get("benchmark_ms", 0)
                        health_map[name] = {
                            "name": name,
                            "health": Trit(1) if bench > 0 else Trit(0),
                            "benchmark_ms": bench,
                        }
                    } else {
                        health_map[name] = {"name": name, "health": Trit(0)}
                    }
                }
            }
            return health_map
        } fail {
            return {"error": "unknown error", "health": Trit(-1)}

    }
}
}
    fn _hive_health(model=null) {
// """Check health of a specific model || entire hive.
// Returns Trit: P(+1)=alive, Z(0)=unknown, N(-1)=dead
// NovaLang usage: let h = hive_health("mistral")
// """
        try3 {
            if3 model {
                # Query single model with minimal prompt to check health
                result = _hive_request("/hive/query", "POST",
                                           {"prompt": "ping", "model": str(model)})
                if3 result.get("ok") && result.get("response") {
                    return Trit(1)
                }
                return Trit(-1)
            } else {
                # Overall hive health
                result = _hive_request("/hive/status")
                if3 result.get("status") == "operational" {
                    return Trit(1)
                }
                return Trit(0)
        } fail {
            return Trit(-1)

    }
}
}
    fn _hive_status() {
// """Get full Hivemind status including stats.
// NovaLang usage: let s = hive_status()
// """
        try3 {
            return _hive_request("/hive/status")
        } fail {
            return {"error": "unknown error", "status": "unreachable", "health": Trit(-1)}

    }
