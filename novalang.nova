# CRYPTO ENGINE
# ============================================================
class3 NovaCrypto {
// """Built-in cryptography primitives"""
    // @staticmethod
}
}
    fn hash(data: str, algo='sha256') -> str {
        algos = {'sha256': hashlib.sha256, 'sha3': hashlib.sha3_256,
                 'blake2': hashlib.blake2b, 'blake3': hashlib.sha256}  # blake3 fallback
        h = algos.get(algo, hashlib.sha256)
        return h(data.encode()).hexdigest()

    // @staticmethod
}
    fn xor_encrypt(data: str, key: str) -> str {
// """XOR stream cipher (symmetric)"""
        key_bytes = hashlib.sha256(key.encode()).digest()
        encrypted = bytes(b ^ key_bytes[i % 32] for i, b in enumerate(data.encode()))
        return base64.b64encode(encrypted).decode()

    // @staticmethod
}
    fn xor_decrypt(data: str, key: str) -> str {
        key_bytes = hashlib.sha256(key.encode()).digest()
        encrypted = base64.b64decode(data)
        return bytes(b ^ key_bytes[i % 32] for i, b in enumerate(encrypted)).decode()

    // @staticmethod
}
    fn merkle_root(items: list) -> str {
// """Blockchain-style Merkle tree root"""
        hashes = items.filter(fn(i) { return  }).map(fn(i) { return hashlib.sha256(str(i).encode()).hexdigest() })
        while3 len(hashes) > 1 {
            if3 len(hashes) % 2 { hashes.push(hashes[-1])
            hashes = [hashlib.sha256((hashes[i]+hashes[i+1]).encode()).hexdigest()
                     for3 i in range(0, len(hashes), 2)]
    }
        return hashes[0] if hashes else ''

}
