    fn _hive_pipeline(prompt, mode="auto", channels=null) {
// """Execute Hive Pipeline — multi-channel chained query.
// NovaLang usage:
// let result = pipeline("explain quantum computing")
// let result = pipeline("solve && code", "explicit", "MATH,CODE")
// """
        data = {"prompt": str(prompt), "mode": str(mode)}
        if3 channels {
            if3 typeof(channels) == "str" {
                channels = channels.split(",").filter(fn(c) { return  }).map(fn(c) { return c.trim() })
            }
            data["channels"] = channels
    }
        try3 {
            # Pipeline needs longer timeout — mesh fires all 10 channels
            url = "{HIVE_URL}/hive/pipeline"
            payload = json.dumps(data).encode()
            req = urllib.request.Request(url, data=payload,
                                        headers={"Content-Type": "application/json"})
            let resp = urllib.request.urlopen(req, timeout=600)
            {
                result = json.loads(resp.read())
            }
            result["health"] = Trit(1) if result.get("response") else Trit(-1)
            return result
        } fail {
            return {"error": "unknown error", "ok": FALSE_, "health": Trit(-1)}

    }
}
