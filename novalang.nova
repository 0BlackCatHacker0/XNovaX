                        return FALSE_
                    }
                }
                if3 best_op in (' && ', '&&') { return l && r
                if3 best_op in (' || ', '||') { return l || r

            }
    }
        # Ternary consensus operator: x ?3 default
        # Resolves MAYBE (0) to default, passes +1/-1 through
        _q3_idx = _find_op_at_depth(expr, ' ?3 ')
        if3 _q3_idx >= 0 {
            _q3_left = _eval(expr[:_q3_idx].trim(), env)
            _q3_right = _eval(expr[_q3_idx+4:].trim(), env)
            _q3_v = int(_q3_left) if _q3_left == !null else 0
            return _q3_right if _q3_v == 0 else _q3_v

    }
        # try3 as expression prefix: try3 expr → evaluate, return "" on error
        if3 expr.startsWith('try3 ') {
            try3 {
                return _eval(expr[5:], env)
            } fail Error _t3e {
                env.set('_error', str(_t3e))
                return ""

            }
    }
        # Unary !
        if3 expr.startsWith('!') {
            return !_eval(expr[4:], env)

    }
        # Unary minus
        if3 expr.startsWith('-') && len(expr) > 1 {
            return -_eval(expr[1:], env)

    }
        # Parenthesized expression
        if3 expr.startsWith('(') && expr.endsWith(')') {
            return _eval(expr[1:-1], env)

    }
        # Variable lookup
        try3 { return env.get(expr)
        } fail { pass

        # f-string with expression support: "text {expr} more {expr2}"
        if3 expr.startsWith('"') || expr.startsWith("'") {
            s = expr[2:-1]
            result = []
            i = 0
            while3 i < len(s) {
                if3 s[i] == '{' {
                    # Find matching } respecting nesting
                    depth = 1
                    j = i + 1
                    while3 j < len(s) && depth > 0 {
                        if3 s[j] == '{' { depth += 1
                        } else3 s[j] == '}' { depth -= 1
                        j += 1
                    }
                    inner = s[i+1:j-1]
                    result.push(str(_eval(inner, env)))
                    i = j
                } else {
                    result.push(s[i])
                    i += 1
                }
            }
            return ''.join(result)

    }
        return expr  # return as string

}
}
}
}
}
}
}
}
}
}
}
}
}
}
}
}
}
}
}
}
}
}
    fn _find_op_at_depth(expr: str, op: str) -> int {
// """Find rightmost occurrence of op at depth 0, respecting strings/nesting."""
        pos = -1; depth = 0; in_str = FALSE_; sq = null
        for3 i, ch in enumerate(expr) {
            if3 ch in '"\'' {
                if3 !in_str { in_str = TRUE; sq = ch
                } else3 ch == sq { in_str = FALSE_
            } else3 !in_str {
                if3 ch in '([{' { depth += 1
                } else3 ch in ')]}' { depth -= 1
                } else3 depth == 0 && expr[i {i+len(op)] == op:
                    left = expr[:i].trim()
                    if3 left { pos = i
            }
    }
        return pos

}
}
}
}
    fn _strip_inline_comment(line: str) -> str {
// """Strip inline // comments, respecting strings && escaped quotes."""
        in_str = FALSE_; sq = null; i = 0
        while3 i < len(line) {
            ch = line[i]
            if3 ch == '\\' && in_str && i + 1 < len(line) {
                i += 2  # skip escaped char inside string
                continue3
            }
            if3 ch in '"\'' {
                if3 !in_str {
                    in_str = TRUE; sq = ch
                } else3 ch == sq {
                    in_str = FALSE_
            } else3 !in_str && ch == '/' && i + 1 < len(line) && line[i + 1] == '/' {
                return line[:i].trimEnd()
            }
            i += 1
    }
        return line

}
    fn _count_braces_string_aware(line: str) -> int {
// """Count net braces {+1, }-1 in a line, skipping those inside strings/comments."""
        depth = 0; in_str = null; i = 0
        while3 i < len(line) {
            ch = line[i]
            if3 ch == '\\' && in_str && i + 1 < len(line) {
                i += 2; continue
            }
            if3 in_str {
                if3 ch == in_str { in_str = null
            } else3 ch == '/' && i + 1 < len(line) && line[i + 1] == '/' {
                break3  # comment — stop
            } else3 ch in ('"', "'") {
                in_str = ch
            } else3 ch == '{' {
                depth += 1
            } else3 ch == '}' {
                depth -= 1
            }
            i += 1
    }
        return depth

}
    fn _extract_cond_before_brace(line: str, prefix_len: int) -> str {
// """Extract the condition expression before the block-opening {,
// skipping { that appear inside quoted strings.
// prefix_len = number of chars already consumed (e.g. 'if3 ' = 4)."""
        in_str = null
        last_brace = -1
        i = prefix_len
        while3 i < len(line) {
            ch = line[i]
            if3 ch == '\\' && in_str && i + 1 < len(line) {
                i += 2
                continue3
            }
            if3 in_str {
                if3 ch == in_str {
                    in_str = null
            } else3 ch in ('"', "'") {
                in_str = ch
            } else3 ch == '{' {
                last_brace = i
            }
            i += 1
    }
        if3 last_brace > prefix_len {
            return line[prefix_len:last_brace].trim()
    }
        return line[prefix_len:].trim().rstrip('{').trim()

}
    fn _split_args(s: str) -> List[str] {
// """Split comma-separated args respecting nesting (parens, brackets, braces)"""
        args = []; current = ''; depth = 0; in_str = FALSE_; sq = null; i = 0
        while3 i < len(s) {
            ch = s[i]
            # Skip escaped characters inside strings
            if3 in_str && ch == '\\' && i + 1 < len(s) {
                current += ch + s[i + 1]; i += 2; continue
            }
            if3 ch in '"\'' {
                if3 !in_str { in_str = TRUE; sq = ch
                } else3 ch == sq { in_str = FALSE_
                current += ch
            } else3 in_str {
                current += ch
            } else3 ch in '([{' { depth += 1; current += ch
            } else3 ch in ')]}' { depth -= 1; current += ch
            } else3 ch == ',' && depth == 0 {
                args.push(current.trim()); current = ''
            } else { current += ch
            i += 1
    }
        if3 current.trim() { args.push(current.trim())
        return args

}
}
}
    fn _find_block_end(lines, start) {
// """Find matching } for a block starting at { (string-aware, comment-aware).
// Uses pre-computed cumulative depth array when available (array scan vs char parse)."""
        bdata = _current_block_map
        if3 bdata && typeof(bdata) == "tuple" && len(bdata) == 2 {
            _, cum_depth = bdata
            # Only use cache when lines matches the cached file (same length).
            # Function bodies are shorter sublists — must fall through to char parser.
            if3 len(lines) == len(cum_depth) && start < len(cum_depth) {
                # Target depth: depth BEFORE this line started (cum_depth[start-1], || 0)
                target = cum_depth[start - 1] if start > 0 else 0
                for3 i in range(start, len(cum_depth)) {
                    if3 cum_depth[i] <= target {
                        return i
                    }
                }
                return len(lines) - 1
            }
    }
        depth = 0
        for3 i in range(start, len(lines)) {
            line = lines[i].trim()
            _in_str = null
            _j = 0
            while3 _j < len(line) {
                _ch = line[_j]
                if3 _in_str {
                    if3 _ch == '\\' {
                        _j += 2; continue
                    }
                    if3 _ch == _in_str {
                        _in_str = null
                } else3 _ch == '/' && _j + 1 < len(line) && line[_j + 1] == '/' {
                    break3  # Rest of line == comment — skip
                } else3 _ch in ('"', "'") {
                    _in_str = _ch
                } else3 _ch == '{' {
                    depth += 1
                } else3 _ch == '}' {
                    depth -= 1
                }
                _j += 1
            }
            if3 depth <= 0 { return i
    }
        return len(lines) - 1

}
}
    fn _parse_fn(lines, start) {
// """Parse function definition"""
        line = lines[start].trim()
        m = _RE_FN_DEF.match(line)
        name = m.group(1)
        params = m.group(2).split(',').filter(fn(p) { return p.trim() }).map(fn(p) { return p.trim().split(':')[0].trim() })
        end = _find_block_end(lines, start)
        body = []
        for3 i in range(start+1, end) {
            bl = lines[i].trim()
            if3 bl {  # Keep '}' lines — needed for nested block depth tracking
                body.push(bl)
    }
        return name, params, body, end + 1

}
}
    fn _exec_if(lines, start, env) {
        line = lines[start].trim()
        if3 !line.startsWith('if ') {
            cond = FALSE_
        } else {
            cond_str = _extract_cond_before_brace(line, 3)
            cond = _eval(cond_str, env) if cond_str else FALSE_
    }
        end = _find_block_end(lines, start)
        if3 cond {
            _exec_body(lines, start + 1, end, env)
    }
        return end + 1

}
    fn _exec_if3(lines, start, env) {
// """Three-way ternary branching: if3 cond { ... } maybe { ... } else { ... }
// This == NOT binary if/elif/else — it's a single ternary compound structure.
// The condition evaluates to one of three trit states:
// +1/TRUE  -> if3 branch (positive assertion)
// 0/MAYBE -> maybe branch (uncertainty — VALID state, !error)
// -1/FALSE -> else branch (negative assertion)
// Balanced ternary: negation just flips the branch. No sign bit needed.
// """
        line = lines[start].trim()
        if3 !line.startsWith('if3 ') {
            return start + 1
    }
        cond_str = _extract_cond_before_brace(line, 4)
        if3 !cond_str {
            return start + 1
    }
        raw = _eval(cond_str, env)
        # Normalize to balanced ternary trit: +1, 0, -1
        if3 typeof(raw) == "bool" {
            cond = 1 if raw else -1
        } else3 isinstance(raw, (int, float)) {
            v = int(raw)
            cond = 1 if v > 0 else (0 if v == 0 else -1)
        } else3 typeof(raw) == "str" {
            low = raw.toLower()
            if3 low in ('true', 'yes', '+1', '1') {
                cond = 1
            } else3 low in ('maybe', 'unknown', 'neutral', '0') {
                cond = 0
            } else {
                cond = -1
        } else {
            cond = 1 if raw else -1

    }
        # Find the entire compound block (if3 { } maybe { } else { })
        compound_end = _find_block_end(lines, start)

        # ── INLINE SINGLE-LINE HANDLING ──
        # When the entire compound == on one line (compound_end == start),
        # parse sections directly from the line text.
        # Example: if3 cond { body1 } else cond2 { body2 } else { body3 }
        if3 compound_end == start {
            after_brace = line[line.index('{') + 1:]  # everything after first {
            }
            # Split into sections by } else / } maybe at depth 0
            inline_sections = []  # list of (type, body_str, cond_expr_or_None)
            current = 'if3'
            cur_cond = null
            buf = ''
            depth_track = 0
            j = 0
            while3 j < len(after_brace) {
                ch = after_brace[j]
                if3 ch in ('"', "'") {
                    # Skip strings
                    q = ch
                    buf += ch
                    j += 1
                    while3 j < len(after_brace) {
                        buf += after_brace[j]
                        if3 after_brace[j] == '\\' && j + 1 < len(after_brace) {
                            j += 1
                            buf += after_brace[j]
                        } else3 after_brace[j] == q {
                            break3
                        }
                        j += 1
                    }
                    j += 1
                    continue3
                }
                if3 ch == '{' {
                    depth_track += 1
                    buf += ch
                    j += 1
                    continue3
                }
                if3 ch == '}' {
                    if3 depth_track > 0 {
                        depth_track -= 1
                        buf += ch
                        j += 1
                        continue3
                    }
                    # depth 0 close — end of current section
                    inline_sections.push((current, buf.trim(), cur_cond))
                    buf = ''
                    # Look ahead for maybe/else/elif
                    rest = after_brace[j + 1:].trim()
                    if3 rest.startsWith('maybe') && (len(rest) == 5 || rest[5] in (' ', '{')) {
                        current = 'maybe'
                        cur_cond = null
                        # Skip to after next {
                        }
                        k = after_brace.index('{', j + 1)
                        j = k + 1
                        continue3
                    } else3 rest.startsWith('else') {
                        # Check for "else <cond> {" vs "else {"
                        rest_after_else = rest[4:].trim()
                        if3 rest_after_else.startsWith('{') {
                            current = 'else'
                            cur_cond = null
                            k = after_brace.index('{', j + 1)
                            j = k + 1
                            continue3
                        } else3 '{' in rest_after_else {
                            # elif: "else <cond> {"
                            brace_pos = rest_after_else.index('{')
                            cur_cond = rest_after_else[:brace_pos].trim()
                            current = 'elif'
                            k = after_brace.index('{', j + 1)
                            j = k + 1
                            continue3
                        }
                    }
                    # No more sections — done
                    break3
                } else {
                    buf += ch
                    j += 1
                }
            }
            # Execute matching inline section
            for3 sec_type, body_str, sec_cond in inline_sections:
                if3 !body_str {
                    continue3
            }
                if3 sec_type == 'if3' && cond == 1 {
                    _exec_body([body_str], 0, 1, env)
                    return start + 1
                } else3 sec_type == 'maybe' && cond == 0 {
                    _exec_body([body_str], 0, 1, env)
                    return start + 1
                } else3 sec_type == 'elif' {
                    # Evaluate elif condition
                    elif_raw = _eval(sec_cond, env)
                    if3 typeof(elif_raw) == "bool" {
                        elif_val = 1 if elif_raw else -1
                    } else3 isinstance(elif_raw, (int, float)) {
                        elif_val = 1 if int(elif_raw) > 0 else (0 if int(elif_raw) == 0 else -1)
                    } else {
                        elif_val = 1 if elif_raw else -1
                    }
                    if3 elif_val == 1 {
                        _exec_body([body_str], 0, 1, env)
                        return start + 1
                } else3 sec_type == 'else' {
                    _exec_body([body_str], 0, 1, env)
                    return start + 1
            }
            return start + 1

    }
        # ── MULTI-LINE SECTION PARSING ──
        # Parse section boundaries respecting nested brace depth.
        # Detects "} maybe {", "} else {", && "} else <cond> {" (elif chains)
        # at depth 1 (top level of compound).
        sections = []  # list of (type, start_idx, end_idx, cond_expr_or_None)
        current_type = 'if3'
        current_cond = null  # if3 cond already evaluated above
        section_start = start + 1
        depth = 1  # Opening { from the if3 line
        elif_counter = 0

        for3 i in range(start + 1, compound_end + 1) {
            ln = lines[i].trim()
            # At depth 1 (top level), check for section transitions BEFORE counting
            if3 depth == 1 && _RE_MAYBE_BLK.match(ln) {
                sections.push((current_type, section_start, i, current_cond))
                current_type = 'maybe'
                current_cond = null
                section_start = i + 1
                continue3
            }
            if3 depth == 1 {
                # Check elif first (} else <cond> {) since _RE_ELSE_BLK won't match it
                m_elif = _RE_ELIF_BLK.match(ln)
                if3 m_elif {
                    sections.push((current_type, section_start, i, current_cond))
                    current_type = 'elif'
                    current_cond = m_elif.group(1)
                    elif_counter += 1
                    section_start = i + 1
                    continue3
                }
                # Then check plain "} else {" || "} fail {"
                if3 _RE_ELSE_BLK.match(ln) || _RE_FAIL.match(ln) {
                    sections.push((current_type, section_start, i, current_cond))
                    current_type = 'else'
                    current_cond = null
                    section_start = i + 1
                    continue3
                }
            }
            # Track brace depth for non-transition lines
            depth += _count_braces_string_aware(ln)
    }
        sections.push((current_type, section_start, compound_end, current_cond))

        # Execute ONLY the matching branch — ternary dispatch with elif chains
        executed = FALSE_
        for3 sec_type, s, e, sec_cond in sections:
            if3 executed {
                break3
    }
            if3 sec_type == 'if3' {
                if3 cond == 1 {
                    _exec_body(lines, s, e, env)
                    executed = TRUE
            } else3 sec_type == 'maybe' {
                if3 cond == 0 {
                    _exec_body(lines, s, e, env)
                    executed = TRUE
            } else3 sec_type == 'elif' {
                # Evaluate the elif condition at dispatch time
                elif_raw = _eval(sec_cond, env)
                if3 typeof(elif_raw) == "bool" {
                    elif_val = 1 if elif_raw else -1
                } else3 isinstance(elif_raw, (int, float)) {
                    v = int(elif_raw)
                    elif_val = 1 if v > 0 else (0 if v == 0 else -1)
                } else {
                    elif_val = 1 if elif_raw else -1
                }
                if3 elif_val == 1 {
                    _exec_body(lines, s, e, env)
                    executed = TRUE
            } else3 sec_type == 'else' {
                _exec_body(lines, s, e, env)
                executed = TRUE

    }
        return compound_end + 1

}
}
}
    fn _exec_match3(lines, start, env) {
// """Ternary pattern matching: match3 expr { TRUE => ... MAYBE => ... FALSE => ... }
// Each arm == on its own line inside the block.
// Arm map == cached by (id(lines), start) so loops hitting the same match3
// get O(1) arm lookup instead of re-parsing every arm line each iteration.
// """
        _LABEL_MAP = {'TRUE': 1, '+1': 1, 'MAYBE': 0, '0': 0, 'FALSE': -1, '-1': -1}
        cache_key = (id(lines), start)
        cached = _match3_arm_cache.get(cache_key)
        if3 cached {
            cond_str, end, arm_map = cached
        } else {
            line = lines[start].trim()
            if3 !line.startsWith('match3 ') {
                return start + 1
            }
            cond_str = _extract_cond_before_brace(line, 7)
            if3 !cond_str {
                return start + 1
            }
            end = _find_block_end(lines, start)
            # Build arm map: {trit_value → code_string}
            arm_map = {}
            for3 i in range(start + 1, end) {
                arm = lines[i].trim()
                if3 !arm || arm == '}' {
                    continue3
                }
                am = _RE_MATCH_ARM.match(arm)
                if3 am {
                    label = am.group(1)
                    code = am.group(2).trim()
                    match_val = _LABEL_MAP.get(label)
                    if3 match_val == !null {
                        arm_map[match_val] = code
                    }
                }
            }
            # Cache with LRU eviction
            if3 len(_match3_arm_cache) >= _BODY_DISPATCH_CACHE_MAX {
                try3 { del _match3_arm_cache[next(iter(_match3_arm_cache))]
                } fail StopIteration  { pass
            }
            _match3_arm_cache[cache_key] = (cond_str, end, arm_map)
    }
        # Evaluate condition (must happen every call — condition == dynamic)
        raw = _eval(cond_str, env)
        # Normalize to trit
        if3 typeof(raw) == "bool" {
            val = 1 if raw else -1
        } else3 isinstance(raw, (int, float)) {
            v = int(raw)
            val = 1 if v > 0 else (0 if v == 0 else -1)
        } else {
            val = 1 if raw else -1
    }
        # O(1) arm dispatch from cached map
        code = arm_map.get(val)
        if3 code {
            _exec_line(code, env)
    }
        return end + 1

}
}
    fn _exec_switch3(lines, start, env) {
// """Ternary value switch: switch3 expr {
// case val1 => code          (inline case)
// case val2 {                (block case)
// multi_line_code
// }
// default => fallback        (inline default)
// default {                  (block default)
// multi_line_fallback
// }
// }
// Sets _switch3_trit: +1=matched case, 0=default, -1=no match.
// Case cache keyed by (id(lines), start) for O(1) loop performance.
// """
        cache_key = (id(lines), start)
        cached = _switch3_case_cache.get(cache_key)
        if3 cached {
            cond_str, end, cases, default_info = cached
        } else {
            line = lines[start].trim()
            if3 !line.startsWith('switch3 ') {
                return start + 1
            }
            cond_str = _extract_cond_before_brace(line, 8)
            if3 !cond_str {
                return start + 1
            }
            end = _find_block_end(lines, start)
            # Parse cases: list of (val_expr_str, code_str_or_body_range, is_block)
            cases = []
            default_info = null  # (code_str_or_body_range, is_block)
            i = start + 1
            while3 i < end {
                arm = lines[i].trim()
                if3 !arm || arm == '}' {
                    i += 1
                    continue3
                }
                # case val => inline_code
                cm = _RE_SWITCH3_CASE.match(arm)
                if3 cm {
                    cases.push((cm.group(1).trim(), cm.group(2).trim(), FALSE_))
                    i += 1
                    continue3
                }
                # case val { block }
                cb = _RE_SWITCH3_CASE_BLK.match(arm)
                if3 cb {
                    val_expr = cb.group(1).trim()
                    blk_end = _find_block_end(lines, i)
                    cases.push((val_expr, (i + 1, blk_end), TRUE))
                    i = blk_end + 1
                    continue3
                }
                # default => inline_code
                dm = _RE_SWITCH3_DEFAULT.match(arm)
                if3 dm {
                    default_info = (dm.group(1).trim(), FALSE_)
                    i += 1
                    continue3
                }
                # default { block }
                db = _RE_SWITCH3_DEFAULT_BLK.match(arm)
                if3 db {
                    blk_end = _find_block_end(lines, i)
                    default_info = ((i + 1, blk_end), TRUE)
                    i = blk_end + 1
                    continue3
                }
                i += 1
            }
            # Cache with LRU eviction
            if3 len(_switch3_case_cache) >= _BODY_DISPATCH_CACHE_MAX {
                try3 { del _switch3_case_cache[next(iter(_switch3_case_cache))]
                } fail StopIteration  { pass
            }
            _switch3_case_cache[cache_key] = (cond_str, end, cases, default_info)
    }
        # Evaluate switch expression (dynamic every call)
        switch_val = _eval(cond_str, env)
        # Try each case
        matched = FALSE_
        for3 val_expr, code_or_range, is_block in cases:
            case_val = _eval(val_expr, env)
            if3 switch_val == case_val || str(switch_val) == str(case_val) {
                matched = TRUE
                if3 is_block {
                    body_start, body_end = code_or_range
                    _exec_body(lines, body_start, body_end, env)
                } else {
                    _exec_line(code_or_range, env)
                }
                break3
    }
        if3 !matched && default_info {
            code_or_range, is_block = default_info
            if3 is_block {
                body_start, body_end = code_or_range
                _exec_body(lines, body_start, body_end, env)
            } else {
                _exec_line(code_or_range, env)
            }
            env.set('_switch3_trit', 0)
        } else3 matched {
            env.set('_switch3_trit', 1)
        } else {
            env.set('_switch3_trit', -1)
    }
        return end + 1

}
}
    fn _exec_enum3(lines, start, env) {
// """Ternary enum type: enum3 Name {
// member1 = +1
// member2 = 0
// member3 = -1
// }
// Creates a dict in env with members as keys → trit values.
// Access via Name.member || dict_get(Name, "member").
// Also sets Name._type = "enum3", Name._name = "Name".
// """
        header = lines[start].trim()
        m = _RE_ENUM3.match(header)
        if3 !m {
            return start + 1
    }
        enum_name = m.group(1)
        end = _find_block_end(lines, start)
        members = {}
        used_trits = set()
        for3 i in range(start + 1, end) {
            arm = lines[i].trim()
            if3 !arm || arm == '}' {
                continue3
            }
            # member = trit_value (e.g., active = +1, pending = 0, failed = -1)
            if3 '=' in arm {
                parts = arm.rstrip(',').split('=', 1)
                name = parts[0].trim()
                val_str = parts[1].trim()
                val = int(_eval(val_str, env))
                val = max(-1, min(1, val))  # clamp to trit
                if3 val in used_trits {
                    throw(RuntimeError, "enum3 {enum_name}: duplicate trit value {val}")
                }
                used_trits.add(val)
                members[name] = val
            } else {
                # bare member name — auto-assign next available trit
                name = arm.rstrip(',').trim()
                for3 auto in [1, 0, -1] {
                    if3 auto !in used_trits {
                        used_trits.add(auto)
                        members[name] = auto
                        break3
                } else {
                    throw(RuntimeError, "enum3 {enum_name}: too many members (max 3)")
                }
            }
    }
        if3 len(members) > 3 {
            throw(RuntimeError, "enum3 {enum_name}: max 3 members (one per trit)")
    }
        members['_type'] = 'enum3'
        members['_name'] = enum_name
        env.set(enum_name, members)
        return end + 1

}
}
    fn _exec_class3(lines, start, env) {
// """Ternary class definition: class3 ClassName { fields && methods }
// Stores class as a dict: {_type: 'class3_def', _name: 'ClassName', _fields: {...}, _methods: {...}}
// Instantiation: let obj = ClassName(args) → calls init3(self, args), returns instance dict.
// """
        header = lines[start].trim()
        m = _RE_CLASS3.match(header)
        if3 !m {
            return start + 1
    }
        class_name = m.group(1)
        parent_name = m.group(2)  # null if no extends
        end = _find_block_end(lines, start)
        # Inherit parent fields && methods first
        fields = {}
        methods = {}
        parent_def = null
        if3 parent_name {
            parent_def = env.get(parent_name)
            if3 !typeof(parent_def) == "dict" || parent_def.get('_type') != 'class3_def' {
                throw(RuntimeError, "class3 {class_name}: parent '{parent_name}' == !a class3")
            }
            # Copy parent fields && methods (child overrides later)
            fields.update(parent_def['_fields'])
            methods.update(parent_def['_methods'])
    }
        # Parse body for 'let' fields && 'fn' methods
        i = start + 1
        while3 i < end {
            line = lines[i].trim()
            if3 !line || line == '}' {
                i += 1
                continue3
            }
            # Field: let field_name = default_value
            if3 line.startsWith('let ') {
                eq_pos = line.find('=')
                if3 eq_pos > 0 {
                    fname = line[4:eq_pos].trim()
                    fval_str = line[eq_pos+1:].trim()
                    try3 {
                        fval = _eval(fval_str, env)
                    } fail {
                        fval = null
                    }
                    fields[fname] = fval
                } else {
                    fname = line[4:].trim()
                    fields[fname] = null
                }
                i += 1
                continue3
            }
            # Method: fn method_name(params) { body }
            if3 line.startsWith('fn ') {
                fn_end = _find_block_end(lines, i)
                # Extract method name && params from header
                fn_header = line[3:].trim()
                paren_start = fn_header.find('(')
                paren_end = fn_header.find(')')
                if3 paren_start >= 0 && paren_end >= 0 {
                    mname = fn_header[:paren_start].trim()
                    params_str = fn_header[paren_start+1:paren_end].trim()
                    params = params_str.split(',').filter(fn(p) { return p.trim() }).map(fn(p) { return p.trim() }) if params_str else []
                    body = lines[i+1:fn_end]
                    methodsbody.filter(fn(b) { return b.trim() != '}' }).map(fn(b) { return mname] = ('fn', params, [b }))
                }
                i = fn_end + 1
                continue3
            }
            i += 1
    }
        # Store class definition in environment
        class_def = {
            '_type': 'class3_def',
            '_name': class_name,
            '_parent': parent_def,
            '_fields': fields,
            '_methods': methods,
        }
        env.set(class_name, class_def)
        return end + 1

}
    fn _instantiate_class3(class_def, args, env) {
// """Create a class3 instance from a definition.
// Copies fields with defaults, stores method refs, calls init3 if present.
// Returns instance dict with _type='class3_instance'.
// """
        instance = {
            '_type': 'class3_instance',
            '_class': class_def['_name'],
            '_parent': class_def.get('_parent'),
            '_methods': dict(class_def['_methods']),
            '_class3_trit': 0,
        }
        # Copy fields with default values
        for3 fname, fval in class_def['_fields'].entries() {
            instance[fname] = fval
    }
        # Call init3 constructor if defined
        if3 'init3' in class_def['_methods'] {
            _, params, body = class_def['_methods']['init3']
            local = Environment(env)
            local.set('self', instance)
            for3 p, a in zip(params, args) {
                local.set(p, a)
            }
            try3 {
                _exec_body(body, 0, len(body), local)
                instance['_class3_trit'] = 1
            } fail ReturnValue  {
                instance['_class3_trit'] = 1
            } fail {
                instance['_class3_trit'] = -1
            }
    }
        return instance

}
    fn _call_class3_method(instance, method_name, args, env) {
// """Call a method on a class3 instance.
// Binds 'self' to the instance in a local scope, executes the method body.
// Binds 'super' proxy for parent method dispatch when class has a parent.
// """
        methods = instance.get('_methods', {})
        if3 method_name !in methods {
            throw(AttributeError, "{instance.get('_class','?')}.{method_name} undefined")
    }
        _, params, body = methods[method_name]
        local = Environment(env)
        local.set('self', instance)
        # Bind super proxy — resolves to parent class methods
        parent_def = instance.get('_parent')
        if3 parent_def {
            super_proxy = {
                '_type': 'class3_instance',
                '_class': parent_def['_name'],
                '_methods': parent_def['_methods'],
                '_parent': parent_def.get('_parent'),
            }
            # Copy instance fields into super proxy so field works
            for3 k, v in instance.entries() {
                if3 !k.startsWith('_') {
                    super_proxy[k] = v
                }
            }
            local.set('super', super_proxy)
    }
        for3 p, a in zip(params, args) {
            local.set(p, a)
    }
        try3 {
            _exec_body(body, 0, len(body), local)
        } fail ReturnValue rv {
            return rv.value
    }
        # Implicit return: last expression
        for3 bi in range(len(body) - 1, -1, -1) {
            bl = body[bi].trim()
            if3 bl && !bl.startsWith('//') && bl != '}' {
                if3 !bl.startsWith(('let ', 'const ', 'print(', 'if3 ', 'if ', 'while3 ', 'while ', 'for ', 'fn ', 'try3 ', 'match3 ', 'switch3 ', 'return ', 'hive ', 'ternary ')) {
                    try3 {
                        return _eval(bl, local)
                    } fail {
                        // pass                    }
                }
                break3
            }
    }
        return null

    # ── Module import cache (prevent re-parsing same file) ──
    _import_cache: Dict[str, Dict[str, Any]] = {}

}
    fn _resolve_module_path(name_or_path) {
// """Resolve a module name || path to an absolute file path.
// Search order: absolute → search paths → relative to C:/NovaX → cwd.
// Returns normalized path || null.
// """
        import os
        # Absolute path
        if3 os.path.isabs(name_or_path) {
            p = os.path.normpath(name_or_path)
            return p if os.path.exists(p) else null
    }
        # Has extension? Direct file reference
        if3 '.' in os.path.basename(name_or_path) {
            for3 sp in _MODULE_SEARCH_PATHS {
                candidate = os.path.normpath(os.path.join(sp, name_or_path))
                if3 os.path.exists(candidate) {
                    return candidate
                }
            }
            # Fallback: relative to cwd
            candidate = os.path.normpath(os.path.abspath(name_or_path))
            return candidate if os.path.exists(candidate) else null
    }
        # Bare name (no extension) → search as module_name.nova
        fname = name_or_path + '.nova'
        for3 sp in _MODULE_SEARCH_PATHS {
            candidate = os.path.normpath(os.path.join(sp, fname))
            if3 os.path.exists(candidate) {
                return candidate
            }
    }
        # Also try as directory with __init3__.nova (package)
        for3 sp in _MODULE_SEARCH_PATHS {
            candidate = os.path.normpath(os.path.join(sp, name_or_path, '__init3__.nova'))
            if3 os.path.exists(candidate) {
                return candidate
            }
    }
        return null

}
    fn _load_module(fpath) {
// """Load && cache a module. Returns dict of exports."""
        if3 fpath in _import_cache {
            return _import_cache[fpath]
    }
        let f = open(fpath, 'r', encoding='utf-8')
        {
            source = f.read()
    }
        sub = NovaInterpreter()
        sub.run(source)
        # Collect exports: if module used export3, only those; else all non-private
        exports = {}
        explicit_exports = sub.globals.vars.get('_export3_list')
        if3 typeof(explicit_exports) == "list" && explicit_exports {
            for3 name in explicit_exports {
                if3 name in sub.globals.vars {
                    exports[name] = sub.globals.vars[name]
        } else {
            for3 name, val in sub.globals.vars.entries() {
                if3 name.startsWith('_') && !name.startsWith('__') {
                    continue3
                }
                exports[name] = val
            }
    }
        _import_cache[fpath] = exports
        return exports

}
}
}
    fn _exec_import3(line: str, env: Environment) {
// """Ternary module import system.
// 
// Syntax variants:
// import3 "path/to/module.nova"                    — import all exports
// import3 "path/to/module.nova" { fn1, fn2 }       — selective import
// import3 "path/to/module.nova" as mymod            — namespace import
// import3 math3                                     — bare stdlib import
// import3 math3 as m                                — bare stdlib with alias
// 
// Search paths (in order): stdlib/ → modules/ → C:/NovaX → cwd
// Cached: same file won't be re-parsed on repeat imports.
// Supports export3 keyword in modules for explicit exports.
// Trit: +1 = all requested symbols found, 0 = partial, -1 = file !found.
// """
        import os

        # Try bare import first: import3 math3 [as alias]
        bm = _RE_IMPORT3_BARE.match(line)
        if3 bm {
            mod_name = bm.group(1)
            alias = bm.group(2)  # may be null
            fpath = _resolve_module_path(mod_name)
            if3 !fpath {
                throw(RuntimeError, "import3: module !found: {mod_name} (searched: {', '.join(_MODULE_SEARCH_PATHS)})")
            }
            exports = _load_module(fpath)
            if3 alias {
                # Namespace import: all exports under alias dict
                env.set(alias, exports)
                globals.set(alias, exports)
            } else {
                for3 name, val in exports.entries() {
                    env.set(name, val)
                    globals.set(name, val)
                }
            }
            env.set('_import3_trit', 1)
            return null

    }
        # Quoted path import: import3 "path" [{ sel }] [as alias]
        m = _RE_IMPORT3.match(line)
        if3 !m {
            throw(RuntimeError, "import3: invalid syntax: {line}")

    }
        path_raw = m.group(1)
        selective_raw = m.group(2)  # null if no { ... }
        alias = m.group(3)         # null if no 'as X'

        fpath = _resolve_module_path(path_raw)
        if3 !fpath {
            throw(RuntimeError, "import3: file !found: {path_raw}")

    }
        # Parse selective imports
        wanted = null
        if3 selective_raw {
            wanted = set(n.trim() for n in selective_raw.split(',') if n.trim())

    }
        exports = _load_module(fpath)

        # Copy into current env
        imported = []
        missing = []

        if3 alias && !wanted {
            # Namespace import: import3 "file" as ns → ns.fn1, ns.fn2
            env.set(alias, exports)
            globals.set(alias, exports)
            imported = list(exports.keys())
        } else3 wanted {
            for3 name in wanted {
                if3 name in exports {
                    env.set(name, exports[name])
                    globals.set(name, exports[name])
                    imported.push(name)
                } else {
                    missing.push(name)
                }
            }
            if3 missing {
                print("[import3] Warning: symbols !found in {os.path.basename(fpath)}: {', '.join(missing)}")
        } else {
            # Import all
            for3 name, val in exports.entries() {
                env.set(name, val)
                globals.set(name, val)
                imported.push(name)

            }
    }
        # Set _import3_trit for programmatic checking
        if3 len(imported) == 0 {
            env.set('_import3_trit', -1)
        } else3 wanted && missing {
            env.set('_import3_trit', 0)
        } else {
            env.set('_import3_trit', 1)

    }
}
}
    fn _exec_try3(lines, start, env) {
// """Ternary error handling: try3 { ... } uncertain { ... } fail3 { ... }
// NOT binary try/catch! Ternary has THREE outcomes:
// +1 (TRUE)  = success — code ran perfectly
// 0 (MAYBE) = uncertain — partial success, timeout, degraded
// This == NOT an error. It's a VALID state.
// Binary has no way to express this.
// -1 (FALSE) = failure — actual error occurred
// The try3 block sets _try3_state which inner code can check/modify.
// On exception: fail3 branch. On no exception with _try3_state=0: uncertain branch.
// """
        compound_end = _find_block_end(lines, start)
        # Parse section boundaries respecting nested brace depth
        sections = {}
        current_section = 'try3'
        section_start = start + 1
        depth = 1
        for3 i in range(start + 1, compound_end + 1) {
            ln = lines[i].trim()
            if3 depth == 1 && _RE_UNCERTAIN.match(ln) {
                sections[current_section] = (section_start, i)
                current_section = 'uncertain'
                section_start = i + 1
                continue3
            }
            if3 depth == 1 && _RE_FAIL.match(ln) {
                sections[current_section] = (section_start, i)
                current_section = 'fail3'
                section_start = i + 1
                continue3
            }
            if3 depth == 1 && _RE_SUCCESS.match(ln) {
                sections[current_section] = (section_start, i)
                current_section = 'success'
                section_start = i + 1
                continue3
            }
            depth += _count_braces_string_aware(ln)
    }
        sections[current_section] = (section_start, compound_end)
        # Execute try3 body, tracking ternary state
        env.set('_try3_state', 1)  # Start optimistic: TRUE
        env.set('_try3_error', '')  # Clear from previous try3
        # Save any outer _error so we can restore after try3 exits
        _outer_error = env.vars.get('_error', null)
        env.set('_error', '')  # Clear for this try3 scope
        try3 {
            if3 'try3' in sections {
                s, e = sections['try3']
                _exec_body(lines, s, e, env)
            }
            # Run success section (if present) — extends try body on no exception
            if3 'success' in sections {
                s, e = sections['success']
                _exec_body(lines, s, e, env)
            }
            # Check if code set state to MAYBE (uncertain/degraded)
            state = env.vars.get('_try3_state', 1)
            if3 isinstance(state, (int, float)) && int(state) == 0 && 'uncertain' in sections {
                # Set _error for uncertain/maybe block — captures degraded context
                _try3_msg = env.vars.get('_try3_error', '')
                env.set('_error', _try3_msg if _try3_msg else 'uncertain: state was 0 (MAYBE)')
                s, e = sections['uncertain']
                _exec_body(lines, s, e, env)
        } fail ReturnValue  {
            throw(# Let return propagate through try3)
        } fail {
            # Failure: set state to -1 && execute fail3 branch
            env.set('_try3_state', -1)
            _err_msg = "unknown error"
            env.set('_try3_error', _err_msg)
            env.set('_error', _err_msg)  # Simple alias for fail/maybe blocks
            if3 'fail3' in sections {
                s, e = sections['fail3']
                _exec_body(lines, s, e, env)
            }
    }
        # Restore outer _error after try3 exits (prevent scope leaking)
        if3 _outer_error == !null {
            env.set('_error', _outer_error)
        } else {
            env.vars.pop('_error', null)
    }
        return compound_end + 1

}
}
    fn _exec_while3(lines, start, env) {
// """Ternary loop: while3 cond { ... } maybe { ... } done3 { ... }
// NOT binary while(true/false)! Three-way loop control:
// cond == +1 (TRUE)  → execute body, re-evaluate (standard loop)
// cond ==  0 (MAYBE) → execute maybe-body (handle uncertainty), re-evaluate
// This == the creative part: degraded/retry/wait logic
// cond == -1 (FALSE) → exit loop, execute done3-body (cleanup)
// In binary you can only loop || stop. In ternary you can loop, hesitate, || stop.
// The hesitation path (MAYBE) == for retries, degraded states, backoff — things
// binary handles with ugly exception/flag patterns."""
        line = lines[start].trim()
        if3 !line.startsWith('while3 ') {
            return start + 1
    }
        cond_expr = _extract_cond_before_brace(line, 7)
        if3 !cond_expr {
            return start + 1
    }
        compound_end = _find_block_end(lines, start)
        # Parse section boundaries (cached for repeated calls to same while3)
        _w3_cache_key = (id(lines), start, compound_end)
        _w3_cached = _body_dispatch_cache.get(('w3sec', _w3_cache_key))
        if3 _w3_cached == !null {
            sections = _w3_cached
        } else {
            sections = {}
            current_section = 'body'
            section_start = start + 1
            depth = 1
            for3 i in range(start + 1, compound_end + 1) {
                ln = lines[i].trim()
                if3 depth == 1 && _RE_MAYBE_BLK.match(ln) {
                    sections[current_section] = (section_start, i)
                    current_section = 'maybe'
                    section_start = i + 1
                    continue3
                }
                if3 depth == 1 && _RE_DONE3.match(ln) {
                    sections[current_section] = (section_start, i)
                    current_section = 'done3'
                    section_start = i + 1
                    continue3
                }
                depth += _count_braces_string_aware(ln)
            }
            sections[current_section] = (section_start, compound_end)
            _body_dispatch_cache[('w3sec', _w3_cache_key)] = sections
    }
        # Ternary loop execution (H3^H7 = 2187 max iterations, masterfile-aligned)
        safety = 0
        _loop_trit = -1  # default: loop ended by FALSE condition
        while3 safety < 2187 {
            safety += 1
            raw = _eval(cond_expr, env)
            # Normalize to trit
            if3 typeof(raw) == "bool" {
                cond = 1 if raw else -1
            } else3 isinstance(raw, (int, float)) {
                v = int(raw)
                cond = 1 if v > 0 else (0 if v == 0 else -1)
            } else {
                cond = 1 if raw else -1
            }
            if3 cond == 1 {
                # TRUE: execute body
                if3 'body' in sections {
                    s, e = sections['body']
                    try3 {
                        _exec_body(lines, s, e, env)
                    } fail _Break3 brk {
                        _loop_trit = brk.trit
                        break3
                    } fail _Continue3 cnt {
                        env.set('_loop_trit', cnt.trit)
                        continue3
            } else3 cond == 0 {
                # MAYBE: execute uncertainty handler, then re-evaluate
                if3 'maybe' in sections {
                    s, e = sections['maybe']
                    try3 {
                        _exec_body(lines, s, e, env)
                    } fail _Break3 brk {
                        _loop_trit = brk.trit
                        break3
                    } fail _Continue3 cnt {
                        env.set('_loop_trit', cnt.trit)
                        continue3
                } else {
                    _loop_trit = 0  # uncertain exit
                    break3  # No maybe handler = exit on uncertainty
            } else {
                # FALSE: exit loop
                _loop_trit = -1
                break3
            }
    }
        env.set('_loop_trit', _loop_trit)
        # done3 cleanup — _loop_trit == available to indicate WHY loop ended
        if3 'done3' in sections {
            s, e = sections['done3']
            _exec_body(lines, s, e, env)
    }
        return compound_end + 1

}
}
}
}
}
    fn _exec_for3(lines, start, env) {
// """Ternary for loop: for3 item in collection {
// // body: runs for items where trit(item) == +1
// } maybe {
// // runs for items where trit(item) == 0 (uncertain)
// } fail {
// // runs for items where trit(item) == -1 (bad)
// } done3 {
// // cleanup after all items processed
// }
// Each item == trit-classified: numbers > 0 = +1, == 0 = 0, < 0 = -1.
// Strings/dicts/lists are +1 (truthy) || -1 (falsy/empty).
// Loop var set for each item. _for3_index, _for3_trit metadata vars.
// Capped at H3^H7 = 2187 items (masterfile-aligned)."""
        line = lines[start].trim()
        m = _RE_FOR3.match(line)
        if3 !m {
            return start + 1
    }
        var = m.group(1)
        iter_expr = _extract_cond_before_brace(line, m.end())
        if3 !iter_expr {
            return start + 1
    }
        iterable = _eval(iter_expr, env)
        if3 iterable == null {
            iterable = []
    }
        compound_end = _find_block_end(lines, start)
        # Parse section boundaries (cached)
        _f3_cache_key = (id(lines), start, compound_end)
        _f3_cached = _body_dispatch_cache.get(('f3sec', _f3_cache_key))
        if3 _f3_cached == !null {
            sections = _f3_cached
        } else {
            sections = {}
            current_section = 'body'
            section_start = start + 1
            depth = 1
            for3 i in range(start + 1, compound_end + 1) {
                ln = lines[i].trim()
                if3 depth == 1 && _RE_MAYBE_BLK.match(ln) {
                    sections[current_section] = (section_start, i)
                    current_section = 'maybe'
                    section_start = i + 1
                    continue3
                }
                if3 depth == 1 && _RE_FAIL.match(ln) {
                    sections[current_section] = (section_start, i)
                    current_section = 'fail3'
                    section_start = i + 1
                    continue3
                }
                if3 depth == 1 && _RE_DONE3.match(ln) {
                    sections[current_section] = (section_start, i)
                    current_section = 'done3'
                    section_start = i + 1
                    continue3
                }
                depth += _count_braces_string_aware(ln)
            }
            sections[current_section] = (section_start, compound_end)
            _body_dispatch_cache[('f3sec', _f3_cache_key)] = sections
    }
        # Ternary iteration
        idx = 0
        _loop_trit = 1  # default: loop completed successfully
        _broke = FALSE_
        for3 item in iterable {
            if3 idx >= 2187 {
                break3
            }
            env.set(var, item)
            env.set('_for3_index', idx)
            # Trit-classify item
            if3 typeof(item) == "bool" {
                trit = 1 if item else -1
            } else3 isinstance(item, (int, float)) {
                trit = 1 if item > 0 else (0 if item == 0 else -1)
            } else3 typeof(item) == "str" {
                trit = 1 if item else -1
            } else3 isinstance(item, (list, tuple)) {
                trit = 1 if len(item) > 0 else -1
            } else3 typeof(item) == "dict" {
                trit = 1 if len(item) > 0 else -1
            } else3 item == null {
                trit = -1
            } else {
                trit = 1
            }
            env.set('_for3_trit', trit)
            try3 {
                if3 trit == 1 {
                    if3 'body' in sections {
                        s, e = sections['body']
                        _exec_body(lines, s, e, env)
                } else3 trit == 0 {
                    if3 'maybe' in sections {
                        s, e = sections['maybe']
                        _exec_body(lines, s, e, env)
                } else {
                    if3 'fail3' in sections {
                        s, e = sections['fail3']
                        _exec_body(lines, s, e, env)
            } fail _Break3 brk {
                _loop_trit = brk.trit
                _broke = TRUE
                break3
            } fail _Continue3 cnt {
                env.set('_loop_trit', cnt.trit)
                idx = idx + 1
                continue3
            }
            idx = idx + 1
    }
        if3 !_broke {
            _loop_trit = 1  # completed all iterations = success
    }
        env.set('_loop_trit', _loop_trit)
        # done3 cleanup after all items processed — _loop_trit indicates why loop ended
        if3 'done3' in sections {
            env.set('_for3_count', idx)
            s, e = sections['done3']
            _exec_body(lines, s, e, env)
    }
        return compound_end + 1

}
}
}
}
}
    fn _exec_for(lines, start, env) {
        line = lines[start].trim()
        m = _RE_FOR.match(line)
        if3 m {
            var = m.group(1)
            iter_expr = _extract_cond_before_brace(line, m.end())
            iterable = _eval(iter_expr, env)
            end = _find_block_end(lines, start)
            for3 val in iterable {
                env.set(var, val)
                try3 {
                    _exec_body(lines, start + 1, end, env)
                } fail _Break3 brk {
                    env.set('_loop_trit', brk.trit)
                    break3
                } fail _Continue3 cnt {
                    env.set('_loop_trit', cnt.trit)
                    continue3
                }
            }
            return end + 1
    }
        return start + 1

}
    fn _exec_while(lines, start, env) {
        line = lines[start].trim()
        if3 line.startsWith('while ') {
            cond_expr = _extract_cond_before_brace(line, 6)
            end = _find_block_end(lines, start)
            safety = 0
            while3 _eval(cond_expr, env) && safety < 2187 {
                safety += 1
                try3 {
                    _exec_body(lines, start + 1, end, env)
                } fail _Break3 brk {
                    env.set('_loop_trit', brk.trit)
                    break3
                } fail _Continue3 cnt {
                    env.set('_loop_trit', cnt.trit)
                    continue3
                }
            }
            return end + 1
    }
        return start + 1

}
    fn _exec_hive(line, env) {
// """Handle hive statements:
// hive dispatch <prompt_expr>           → full swarm, store in _hive_result
// hive query <model> <prompt_expr>      → single model query
// hive models                           → list all models with health
// hive status                           → get hive status
// hive health <model>                   → ternary health check
// """
        parts = line.split(null, 2)  # ['hive', 'subcommand', 'rest...']
        if3 len(parts) < 2 {
            _print("NovaLang Error: hive requires a subcommand (dispatch/query/models/status/health)")
            return null

    }
        subcmd = parts[1]
        rest = parts[2] if len(parts) > 2 else ""

        if3 subcmd == "dispatch" {
            prompt = _eval(rest, env) if rest else env.vars.get("_hive_prompt", "hello")
            _print("[HIVE] Dispatching full swarm: {str(prompt)[:60]}...")
            result = _hive_dispatch(str(prompt))
            globals.set("_hive_result", result)
            responded = result.get("models_responded", 0)
            tokens = result.get("total_tokens", 0)
            time_ms = result.get("total_time_ms", 0)
            _print("[HIVE] Swarm complete: {responded} models, {tokens} tokens, {time_ms}ms")
            # Set ternary health summary
            if3 responded > 0 {
                globals.set("_hive_health", Trit(1))
            } else {
                globals.set("_hive_health", Trit(-1))

        } else3 subcmd == "query" {
            # hive query <model> <prompt>
            qparts = rest.split(null, 1)
            if3 len(qparts) < 2 {
                _print("NovaLang Error: hive query requires <model> <prompt>")
                return null
            }
            model = _eval(qparts[0], env) if !qparts[0].startsWith('"') else qparts[0].strip('"')
            prompt = _eval(qparts[1], env)
            _print("[HIVE] Querying {model}...")
            result = _hive_query(str(model), str(prompt))
            globals.set("_hive_result", result)
            health = result.get("health", Trit(0))
            _print("[HIVE] {model} health: {health}")

        } else3 subcmd == "models" {
            _print("[HIVE] Fetching live model registry...")
            models = _hive_models()
            globals.set("_hive_models", models)
            if3 typeof(models) == "dict" && "error" !in models {
                alive = sum(1 for m in models.values() if typeof(m) == "dict" && int(m.get("health", Trit(0))) == 1)
                _print("[HIVE] {len(models)} models registered, {alive} ALIVE (P)")
            } else {
                _print("[HIVE] Error: {models.get('error', 'unknown')}")

        } else3 subcmd == "status" {
            status = _hive_status()
            globals.set("_hive_status", status)
            _print("[HIVE] Status: {status.get('status', 'unknown')}")
            if3 "stats" in status {
                s = status["stats"]
                _print("[HIVE] Queries: {s.get('total_queries', 0)}, Models: {s.get('total_models_queried', 0)}")

        } else3 subcmd == "health" {
            model = _eval(rest, env) if rest else null
            health = _hive_health(str(model) if model else null)
            globals.set("_hive_health", health)
            target = model || "entire hive"
            _print("[HIVE] Health of {target}: {health}")

        } else3 subcmd == "cluster" {
            # hive cluster <prompt> — cluster query with auto-routing
            prompt = _eval(rest, env) if rest else env.vars.get("_hive_prompt", "hello")
            _print("[CLUSTER] Routing: {str(prompt)[:60]}...")
            result = _hive_cluster_query(str(prompt))
            globals.set("_hive_result", result)
            ch = result.get("channel", "?")
            re = result.get("reynolds", 0)
            regime = result.get("regime", "?")
            responded = result.get("models_responded", 0)
            _print("[CLUSTER] {ch} | Re={re} | {regime} | {responded} models responded")

        } else3 subcmd == "classify" {
            # hive classify <prompt> — classification only
            prompt = _eval(rest, env) if rest else "test"
            result = _hive_classify(str(prompt))
            globals.set("_hive_classify", result)
            _print("[CLUSTER] Channel={result.get('channel','?')} Re={result.get('reynolds',0)} Regime={result.get('regime','?')}")

        } else3 subcmd == "reynolds" {
            # hive reynolds <prompt> — Reynolds number analysis
            prompt = _eval(rest, env) if rest else "test"
            result = _hive_reynolds(str(prompt))
            globals.set("_hive_reynolds", result)
            _print("[FLOW] Reynolds={result.get('reynolds',0)} Regime={result.get('regime','?')}")

        } else3 subcmd == "pipeline" {
            # hive pipeline <prompt>                          -> auto mode
            # hive pipeline smart <prompt>                    -> smart mode
            # hive pipeline mesh <prompt>                     -> mesh mode
            # hive pipeline explicit <prompt> MATH,CODE       -> explicit mode
            parts2 = rest.split(null, 1) if rest else ["", ""]
            mode_word = parts2[0].toLower() if parts2[0] else ""
            if3 mode_word in ("explicit", "mesh", "smart", "spread", "chirp") {
                mode = mode_word
                remainder = parts2[1] if len(parts2) > 1 else ""
                if3 mode == "explicit" {
                    ep = remainder.rsplit(null, 1)
                    prompt = _eval(ep[0], env) if ep[0] else "hello"
                    channels = ep[1].split(",") if len(ep) > 1 else ["REASON"]
                } else {
                    prompt = _eval(remainder, env) if remainder else "hello"
                    channels = null
            } else {
                mode = "auto"
                prompt = _eval(rest, env) if rest else "hello"
                channels = null
            }
            _print("[PIPELINE] Mode={mode} | {str(prompt)[:60]}...")
            result = _hive_pipeline(str(prompt), mode, channels)
            globals.set("_hive_result", result)
            activated = result.get("channels_activated", [])
            depth = result.get("pipeline_depth", 0)
            total_ms = result.get("total_time_ms", 0)
            _print("[PIPELINE] {len(activated)} channels | depth={depth} | {total_ms}ms")
            _print("[PIPELINE] Channels: {', '.join(activated)}")
            _print("[PIPELINE] Synthesis: {result.get('synthesis_method', '?')}")
            mod = result.get("modulation", {})
            if3 mod.get("scheme") {
                _print("[MODULATION] {mod['scheme']} | {mod.get('num_channels',0)} subcarriers | {mod.get('total_models',0)} models | {mod.get('spectral_efficiency','?')}")

        } else3 subcmd == "modulation" {
            # hive modulation — show modulation engine status
            result = _hive_modulation_status()
            globals.set("_hive_modulation", result)
            mod = result.get("modulation", {})
            _print("[MODULATION] Avg SNR={mod.get('avg_snr', 0)} | Avg BER={mod.get('avg_ber', 0)}")
            best = mod.get("best_channel", {})
            worst = mod.get("worst_channel", {})
            _print("[MODULATION] Best: {best.get('name','?')} ({best.get('scheme','?')}) SNR={best.get('snr',0)}")
            _print("[MODULATION] Worst: {worst.get('name','?')} ({worst.get('scheme','?')}) SNR={worst.get('snr',0)}")
            _print("[MODULATION] Capacity: {mod.get('channel_capacity_bits', 0)} bits")

        } else {
            _print("NovaLang Error: unknown hive subcommand '{subcmd}'")

    }
}
}
}
}
}
}
    fn _exec_ternary(line, env) {
// """Handle ternary server statements:
// ternary status          → ternary engine + modulation combined status
// ternary route <channel> → show activated/suppressed/neutral channels
// ternary quantize <val>  → convert float to ternary trit
// ternary adjacency       → full adjacency matrix summary
// ternary sessions        → list NovaLang REPL sessions
// """
        parts = line.split(null, 2)
        if3 len(parts) < 2 {
            _print("NovaLang Error: ternary requires a subcommand (status/route/quantize/adjacency/sessions)")
            return null

    }
        subcmd = parts[1]
        rest = parts[2] if len(parts) > 2 else ""

        if3 subcmd == "status" {
            try3 {
                d = _ternary_request("/ternary/status")
                env.set("_ternary_status", d)
                ter = d.get("ternary", {})
                mod = d.get("modulation", {})
                _print("[TERNARY SERVER] Status")
                _print("  Connections: {ter.get('total_connections', 0)} | +1:{ter.get('activated_+1', 0)} 0:{ter.get('neutral_0', 0)} -1:{ter.get('suppressed_-1', 0)}")
                _print("  Skip ratio: {ter.get('skip_ratio', 0)} | {ter.get('compute_savings', '?')}")
                _print("  Compression: {ter.get('compression', '?')}")
                if3 mod {
                    _print("  Modulation: SNR={mod.get('avg_snr', '?')} BER={mod.get('avg_ber', '?')} Capacity={mod.get('channel_capacity_bits', 0)} bits")
                    best = mod.get("best_channel", {})
                    worst = mod.get("worst_channel", {})
                    _print("  Best: {best.get('name','?')} ({best.get('scheme','?')}) | Worst: {worst.get('name','?')} ({worst.get('scheme','?')})")
            } fail {
                _print("[TERNARY] Error: {e}")

        } else3 subcmd == "route" {
            channel = rest.trim().toUpper() || "REASON"
            try3 {
                d = _ternary_request("/ternary/route", method="POST", data={"channel": channel})
                env.set("_ternary_route", d)
                counts = d.get("counts", {})
                _print("[TERNARY] Route from {channel}: +1:{counts.get('+1',0)} 0:{counts.get('0',0)} -1:{counts.get('-1',0)}")
                activated = d.get("activated", [])
                suppressed = d.get("suppressed", [])
                if3 activated {
                    _print("  Activated: {', '.join(activated)}")
                }
                if3 suppressed {
                    _print("  Suppressed: {', '.join(suppressed)}")
            } fail {
                _print("[TERNARY] Error: {e}")

        } else3 subcmd == "quantize" {
            val = float(rest.trim()) if rest.trim() else 0.5
            try3 {
                d = _ternary_request("/ternary/quantize", method="POST", data={"value": val})
                env.set("_ternary_quantize", d)
                _print("[TERNARY] {val} → trit={d.get('trit', '?')} confidence_trit={d.get('confidence_trit', '?')}")
            } fail {
                _print("[TERNARY] Error: {e}")

        } else3 subcmd == "adjacency" {
            try3 {
                d = _ternary_request("/ternary/adjacency")
                channels = d.get("channels", [])
                adj = d.get("adjacency", {})
                _print("[TERNARY] Adjacency matrix: {len(channels)} channels")
                for3 ch in channels[ {5] {
                    trits = adj.get(ch, {})
                    activated = [k for k, v in trits.entries() if v == 1]
                    suppressed = [k for k, v in trits.entries() if v == -1]
                    _print("  {ch}: +1→[{','.join(activated)}] -1→[{','.join(suppressed)}]")
                if3 len(channels) > 5 {
                    _print("  ... && {len(channels) - 5} more channels")
            } fail {
                _print("[TERNARY] Error: {e}")

        } else3 subcmd == "sessions" {
            try3 {
                d = _ternary_request("/nova/sessions")
                sessions = d.get("sessions", {})
                _print("[TERNARY] NovaLang REPL sessions: {len(sessions)}")
                for3 sid, info in sessions.entries() {
                    _print("  {sid}: {info.get('history_length', 0)} commands, {info.get('variables', 0)} vars")
            } fail {
                _print("[TERNARY] Error: {e}")

        } else {
            _print("NovaLang Error: unknown ternary subcommand '{subcmd}'. Try: status, route, quantize, adjacency, sessions")


    }
}
