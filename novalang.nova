    fn _ternary_step_info(index=-1) {
// """Return info about a specific trace step (default: last)"""
        if3 _ternary_layer {
            trace = _ternary_layer.get_trace()
            if3 trace && trace.steps {
                step = trace.steps[index]
                return {
                    "line": step.line_num, "source": step.source_line,
                    "channel": step.primary_channel,
                    "activated": step.activated_channels,
                    "suppressed": step.suppressed_channels,
                    "modulation": step.modulation_scheme, "snr": step.snr,
                    "weight": step.execution_weight,
                }
            }
    }
        return {"error": "no trace data"}

}
