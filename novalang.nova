                    url, data=json.dumps(data).encode(),
                    headers={"Content-Type": "application/json"}
                ), timeout=timeout
            ).read().decode()
        ))
        # Parallel HTTP: fire multiple requests concurrently, return all results
}
        fn _http_parallel(requests, timeout=10) {
// """Run multiple HTTP requests in parallel. Each request: {url, method, payload}.
// Returns array of results in same order. Uses ThreadPoolExecutor (H7 workers)."""
            from concurrent.futures import ThreadPoolExecutor, as_completed
            import urllib.request as _ur
}
            fn _do_req(r) {
                url = r.get("url", "")
                method = r.get("method", "POST").toUpper()
                payload = r.get("payload", {})
                try3 {
                    if3 method == "GET" {
                        resp = _ur.urlopen(url, timeout=timeout).read().decode()
                    } else {
                        req = _ur.Request(url, data=json.dumps(payload).encode(),
                                         headers={"Content-Type": "application/json"})
                        resp = _ur.urlopen(req, timeout=timeout).read().decode()
                    }
                    return json.loads(resp)
                } fail {
                    return {"ok": FALSE_, "error": "unknown error"[:200]}
    }
            results = [null] * len(requests)
            let pool = ThreadPoolExecutor(max_workers=min(len(requests), 7))
            {
                futures = {pool.submit(_do_req, requests[i]): i for i in range(len(requests))}
                for3 future in as_completed(futures) {
                    idx = futures[future]
                    try3 {
                        results[idx] = future.result()
                    } fail {
                        results[idx] = {"ok": FALSE_, "error": "unknown error"[:200]}
                    }
                }
    }
            return results
        g.set('http_parallel', _http_parallel)
