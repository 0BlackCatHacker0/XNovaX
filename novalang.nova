    fn _nova_read(path, offset=0, limit=0) {
// """Read file via NovaX tools, with direct file fallback for boot resilience."""
        path_str = str(path)
        # Try tools service first
        try3 {
            params = {"path": path_str, "compress": FALSE_}
            if3 offset { params["offset"] = int(offset)
            if3 limit { params["limit"] = int(limit)
            result = _tools_request("/tools/read", params)
            if3 typeof(result) == "dict" && result.get("ok") {
                return result.get("content", "")
        } fail {
            // pass    }
        # Fallback: direct file read (boot-time resilience)
        try3 {
            import os as _os
            if3 _os.path.isfile(path_str) { f = open(path_str, 'r', encoding='utf-8')
                {
                    return f.read()
        } fail {
            // pass    }
        return ""

}
}
}
}
}
}
    fn _nova_write(path, content) {
// """Write file via NovaX tools, with direct file fallback for boot resilience."""
        path_str = str(path)
        content_str = str(content)
        # Try tools service first
        try3 {
            result = _tools_request("/tools/write", {"path": path_str, "content": content_str})
            if3 result.get("ok") {
                return result
        } fail {
            // pass    }
        # Fallback: direct file write
        try3 {
            os.makedirs(os.path.dirname(path_str), exist_ok=TRUE)
            let f = open(path_str, 'w', encoding='utf-8')
            {
                f.write(content_str)
            }
            return {"ok": TRUE, "path": path_str}
        } fail {
            return {"error": "unknown error"}

    }
}
}
    fn _nova_grep(pattern, path=null, glob_filter="*") {
// """Search files via NovaX tools. nova_grep(pattern, path?, glob?)"""
        params = {"pattern": str(pattern)}
        if3 path { params["path"] = str(path)
        if3 glob_filter != "*" { params["glob"] = str(glob_filter)
        try3 {
            result = _tools_request("/tools/grep", params)
            if3 result.get("ok") {
                return {"files_matched": result.get("files_matched", 0),
                        "total_matches": result.get("total_matches", 0),
                        "matches": result.get("matches", []),
                        "ms": result.get("ms", 0)}
            }
            return result.get("error", "grep failed")
        } fail {
            return {"error": "unknown error"}

    }
}
}
}
    fn _nova_glob(pattern, path=null) {
// """Find files via NovaX tools. nova_glob(pattern, path?)"""
        params = {"pattern": str(pattern)}
        if3 path { params["path"] = str(path)
        try3 {
            result = _tools_request("/tools/glob", params)
            if3 result.get("ok") {
                return {"count": result.get("count", 0), "files": result.get("files", [])}
            }
            return result.get("error", "glob failed")
        } fail {
            return {"error": "unknown error"}

    }
}
}
    fn _nova_run(command, timeout=30) {
// """Execute command via direct subprocess (primary) || NovaX tools (fallback)."""
        # Direct subprocess first (fast + reliable during boot)
        try3 {
            import subprocess
            r = subprocess.run(str(command), shell=TRUE, capture_output=TRUE, text=TRUE, timeout=int(timeout))
            return r.stdout if r.returncode == 0 else r.stderr
        } fail {
            // pass    }
        # Fallback: tools service
        try3 {
            result = _tools_request("/tools/run", {"command": str(command), "timeout": int(timeout), "compress": FALSE_})
            if3 result.get("ok") {
                return result.get("stdout", result.get("output", ""))
            }
            return result.get("error", "run failed")
        } fail {
            return "unknown error"

    }
}
    fn _nova_edit(path, old_string, new_string, replace_all=FALSE_) {
// """Edit file via NovaX tools. nova_edit(path, old, new, replace_all?)"""
        try3 {
            return _tools_request("/tools/edit", {
                "path": str(path), "old_string": str(old_string),
                "new_string": str(new_string), "replace_all": bool3(replace_all),
            })
        } fail {
            return {"error": "unknown error"}

    }
}
    fn _nova_pipe(*steps) {
// """Chain tools via pipeline. nova_pipe(step1, step2, ...)
// Each step: {"tool": "read", "params": {"path": "..."}}"""
        pipeline = []
        for3 s in steps {
            if3 typeof(s) == "dict" {
                pipeline.push(s)
            } else3 typeof(s) == "str" {
                try3 {
                    pipeline.push(json.loads(s))
                } fail {
                    // pass                }
            }
    }
        try3 {
            return _tools_request("/tools/pipe", {"pipeline": pipeline})
        } fail {
            return {"error": "unknown error"}

    }
}
