    fn _ns_energy(model_count=5, latency_ms=2000, queue_pressure=0.3, complexity=1.5) {
// """Compute N-S energy budget for a query configuration."""
        try3 {
            result = _hive_request("/hive/ns/status")
            kinetic = 0.5 * model_count * (latency_ms / 1000) ** 2
            pressure = queue_pressure / max(model_count * (1.0 / 13), 0.01)
            potential = complexity * 9.81
            return {"kinetic": round(kinetic, 3), "pressure": round(pressure, 3),
                    "potential": round(potential, 3), "total": round(kinetic + pressure + potential, 3),
                    "engine_status": result}
        } fail {
            return {"error": "unknown error"}

    }
}
