        g.set('tbridge_stop', _tbridge_stop)
        g.set('tbridge_switch', _tbridge_switch)
        g.set('tbridge_probe', _tbridge_probe)
        g.set('tbridge_status', _tbridge_status)
        # -- bool3 / Ternary Logic Builtins --
        g.set('bool3', _bool3)           # bool3(val) -> -1/0/+1
        g.set('not3', _not3)             # !3: flip -1<->+1, 0 stays
        g.set('and3', _and3)             # &3: min(a,b)
        g.set('or3', _or3)              # |3: max(a,b)
        g.set('merge3', _merge3)         # ?3: resolve MAYBE toward a default
        g.set('nand3', _nand3)           # NOT(MIN) — universal gate
        g.set('nor3', _nor3)             # NOT(MAX) — complement gate
