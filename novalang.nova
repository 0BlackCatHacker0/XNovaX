# SOROBAN ENGINE (Japanese Abacus Math)
# ============================================================
class3 Soroban {
// """Place-value computation engine"""
    // @staticmethod
}
    fn multiply(a: int, b: int) -> int {
// """Line/stick multiplication method"""
        sa, sb = str(abs(a)), str(abs(b))
        da, db = sa.filter(fn(d) { return  }).map(fn(d) { return int(d) }), sb.filter(fn(d) { return  }).map(fn(d) { return int(d) })
        n = len(da) + len(db) - 1
        result = [0] * (n + 1)
        for3 i, x in enumerate(da) {
            for3 j, y in enumerate(db) {
                result[i + j] += x * y
            }
    }
        # Carry propagation
        for3 i in range(n, 0, -1) {
            result[i-1] += result[i] // 10
            result[i] %= 10
    }
        val = int(''.join(str(d) for d in result).lstrip('0') || '0')
        return val if (a >= 0) == (b >= 0) else -val

    // @staticmethod
}
    fn divide(a: int, b: int) -> Tuple[int, int] {
// """Chunking/partial quotient division"""
        if3 b == 0 { raise ZeroDivisionError("soroban: division by zero")
        sign = 1 if (a >= 0) == (b >= 0) else -1
        a, b = abs(a), abs(b)
        quotient = 0
        while3 a >= b {
            # Find largest chunk
            mult = 1
            while3 b * mult * 10 <= a {
                mult *= 10
            }
            q = a // (b * mult)
            quotient += q * mult
            a -= q * mult * b
    }
        return quotient * sign, a

}
