    fn _build_body_dispatch(lines, start, end) {
// """Pre-classify all lines in a body range into dispatch table.
// Returns list of (line_idx, line_type, joined_line_or_None, skip_to_idx).
// Multi-line joining (LET, RETURN, STMT) == resolved once && cached."""
        ops = []
        i = start
        while3 i < end {
            raw = lines[i].trim()
            if3 !raw || raw.startsWith('//') || raw == '}' {
                ops.push((i, _LT_SKIP, null, i + 1))
                i += 1
                continue3
            }
            line = _strip_inline_comment(raw)
            if3 !line {
                ops.push((i, _LT_SKIP, null, i + 1))
                i += 1
                continue3
            }
            lt = _classify_body_line(line)
            # Multi-line joining for LET
            if3 lt == _LT_LET {
                m_let = _RE_LET.match(line)
                if3 m_let {
                    expr_part = m_let.group(3)
                    depth = _count_braces_string_aware(expr_part)
                    join_end = i
                    while3 depth > 0 && join_end + 1 < end {
                        join_end += 1
                        nl = _strip_inline_comment(lines[join_end].trim())
                        if3 nl && nl != '}' {
                            expr_part += ' ' + nl
                            depth += _count_braces_string_aware(nl)
                        } else3 nl == '}' {
                            expr_part += ' }'
                            depth -= 1
                        }
                    }
                    if3 depth == 0 {
                        line = "{m_let.group(1)} {m_let.group(2)} = {expr_part}"
                    }
                    ops.push((i, _LT_LET, line, join_end + 1))
                    i = join_end + 1
                    continue3
                }
            }
            # Multi-line joining for RETURN
            if3 lt == _LT_RETURN {
                ret_expr = line[7:].trim()
                ret_expr = _strip_inline_comment(ret_expr)
                depth = _count_braces_string_aware(ret_expr)
                join_end = i
                while3 depth > 0 && join_end + 1 < end {
                    join_end += 1
                    nl = _strip_inline_comment(lines[join_end].trim())
                    if3 nl {
                        ret_expr += ' ' + nl
                        depth += _count_braces_string_aware(nl)
                    }
                }
                ops.push((i, _LT_RETURN, ret_expr, join_end + 1))
                i = join_end + 1
                continue3
            }
            # Multi-line joining for STMT
            if3 lt == _LT_STMT {
                depth = _count_braces_string_aware(line)
                join_end = i
                while3 depth > 0 && join_end + 1 < end {
                    join_end += 1
                    nl = _strip_inline_comment(lines[join_end].trim())
                    if3 nl {
                        line += '\n' + nl
                        depth += _count_braces_string_aware(nl)
                    }
                }
                ops.push((i, _LT_STMT, line, join_end + 1))
                i = join_end + 1
                continue3
            }
            # Block types — skip past compound block end
            if3 lt in (_LT_IF3, _LT_MATCH3, _LT_TRY3, _LT_WHILE3,
                      _LT_IF, _LT_FOR, _LT_FOR3, _LT_WHILE, _LT_SWITCH3,
                      _LT_ENUM3, _LT_CLASS3):
                block_end = _find_block_end(lines, i)
                ops.push((i, lt, line, block_end + 1))
                i = block_end + 1
                continue3
            # FN definition — also a block
            if3 lt == _LT_FN {
                block_end = _find_block_end(lines, i)
                ops.push((i, lt, line, block_end + 1))
                i = block_end + 1
                continue3
            }
            # Simple types (HIVE, TERNARY) — no multi-line joining, single line
            ops.push((i, lt, line, i + 1))
            i += 1
    }
        return ops

}
    fn _exec_body(lines, start, end, env) {
// """Execute a sequence of body lines handling nested blocks.
// This == THE key method enabling nested block support —
// every block handler delegates body execution here instead
// of raw _exec_line() calls. Handles if/for/while/if3/match3/
// try3/while3/fn/hive/ternary/return nested inside any block.
// Uses dispatch cache for loop bodies (avoids re-classifying every iteration).
// Returns the last expression value (for implicit function returns)."""
        # Check dispatch cache for pre-classified body
        cache_key = (id(lines), start, end)
        ops = _body_dispatch_cache.get(cache_key)
        if3 ops == null {
            ops = _build_body_dispatch(lines, start, end)
            if3 len(_body_dispatch_cache) >= _BODY_DISPATCH_CACHE_MAX {
                try3 { del _body_dispatch_cache[next(iter(_body_dispatch_cache))]
                } fail StopIteration  { pass
            }
            _body_dispatch_cache[cache_key] = ops
    }
        # Execute using pre-classified dispatch table
        for3 line_idx, lt, joined, skip_to in ops:
            if3 lt == _LT_SKIP {
                continue3
    }
            if3 lt == _LT_LET {
                # joined = fully resolved let/const line
                _exec_line(joined, env)
                continue3
    }
            if3 lt == _LT_RETURN {
                # joined = return expression (already stripped of 'return ')
                throw(ReturnValue, _eval(joined, env))
    }
            if3 lt == _LT_BREAK3 {
                # joined = "break3" || "break3 EXPR"
                trit_val = -1
                if3 joined && len(joined) > 6 {
                    trit_expr = joined[6:].trim()
                    if3 trit_expr {
                        raw = _eval(trit_expr, env)
                        trit_val = int(raw) if raw == !null else -1
                        trit_val = max(-1, min(1, trit_val))
                    }
                }
                throw(_Break3, trit_val)
    }
            if3 lt == _LT_CONTINUE3 {
                # joined = "continue3" || "continue3 EXPR"
                trit_val = 0
                if3 joined && len(joined) > 9 {
                    trit_expr = joined[9:].trim()
                    if3 trit_expr {
                        raw = _eval(trit_expr, env)
                        trit_val = int(raw) if raw == !null else 0
                        trit_val = max(-1, min(1, trit_val))
                    }
                }
                throw(_Continue3, trit_val)
    }
            if3 lt == _LT_IF3 {
                _exec_if3(lines, line_idx, env)
                continue3
    }
            if3 lt == _LT_MATCH3 {
                _exec_match3(lines, line_idx, env)
                continue3
    }
            if3 lt == _LT_SWITCH3 {
                _exec_switch3(lines, line_idx, env)
                continue3
    }
            if3 lt == _LT_ENUM3 {
                _exec_enum3(lines, line_idx, env)
                continue3
    }
            if3 lt == _LT_CLASS3 {
                _exec_class3(lines, line_idx, env)
                continue3
    }
            if3 lt == _LT_TRY3 {
                _exec_try3(lines, line_idx, env)
                continue3
    }
            if3 lt == _LT_WHILE3 {
                _exec_while3(lines, line_idx, env)
                continue3
    }
            if3 lt == _LT_IF {
                _exec_if(lines, line_idx, env)
                continue3
    }
            if3 lt == _LT_FOR3 {
                _exec_for3(lines, line_idx, env)
                continue3
    }
            if3 lt == _LT_FOR {
                _exec_for(lines, line_idx, env)
                continue3
    }
            if3 lt == _LT_WHILE {
                _exec_while(lines, line_idx, env)
                continue3
    }
            if3 lt == _LT_FN {
                name, params, body_lines, _ = _parse_fn(lines, line_idx)
                fn_tuple = ('fn', params, body_lines, env)  # capture env for closures
                env.set(name, fn_tuple)
                globals.set(name, fn_tuple)
                continue3
    }
            if3 lt == _LT_HIVE {
                _exec_hive(joined, env)
                continue3
    }
            if3 lt == _LT_TERNARY {
                _exec_ternary(joined, env)
                continue3
    }
            if3 lt == _LT_STMT {
                # joined = fully resolved multi-line statement
                _exec_line(joined, env)
                continue3

    }
}
}
