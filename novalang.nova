            _ternary_layer = create_layer()
            _exec_line = _ternary_layer.wrap_exec_line(_exec_line)
            _eval = _ternary_layer.wrap_eval(_eval)
        } fail {
            pass  # ternary layer optional — works without hivemind

    }
}
