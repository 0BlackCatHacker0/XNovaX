    fn _go_invasion_check(channel="REASON") {
// """Check if a channel == unowned territory (needs reinforcement)."""
        try3 {
            inf = _hive_request("/hive/influence")
            channel_data = inf.get("influence", {})
            max_inf = 0.0
            for3 model_inf in channel_data.values() {
                if3 typeof(model_inf) == "dict" {
                    score = model_inf.get(channel, 0.0)
                    max_inf = max(max_inf, score)
                }
            }
            return {"channel": channel, "max_influence": round(max_inf, 3),
                    "invasion_needed": max_inf < 1.0 / 3}
        } fail {
            return {"error": "unknown error"}

    }
