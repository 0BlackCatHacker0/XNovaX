            'consensus3': '(if {0} == {1} {{ {0} }} else {{ 0 }})',
            'any3': '(if {0}.iter().any(|v| *v != 0) {{ 1 }} else {{ 0 }})',
            'all3': '(if {0}.iter().all(|v| *v == 1) {{ 1 }} else if {0}.iter().all(|v| *v == -1) {{ -1 }} else {{ 0 }})',
            # --- BT arithmetic (11) ---
            'bt': '({0}).clamp(-1, 1)',
            'bt_val': '({0}) as i64',
            'bt_neg': '(-({0}))',
            'bt_add': '(({0} + {1}).clamp(-1, 1))',
            'bt_sub': '(({0} - {1}).clamp(-1, 1))',
            'bt_mul': '({0} * {1})',
            'bt_div': '(if {1} == 0 {{ 0 }} else {{ {0} / {1} }})',
            'bt_mod': '(if {1} == 0 {{ 0 }} else {{ {0} % {1} }})',
            'bt_abs': '({0}).abs()',
            'bt_shift': '({0} * 3i64.pow({1} as u32))',
            'bt_pow': '({0}).pow({1} as u32)',
            # --- BT float (2) ---
            'bt_float': '({0} as f64).clamp(-1.0, 1.0)',
            'bt_float_val': '({0} as f64)',
            # --- Comparison (1) ---
            'cmp3': '(if {0} > {1} {{ 1 }} else if {0} < {1} {{ -1 }} else {{ 0 }})',
            # --- Trit/Tryte (6) ---
            'trit': '({0}).clamp(-1, 1)',
            'trit_char': '(match ({0}).signum() {{ 1 => "+", -1 => "-", _ => "0" }})',
            'tryte': '({0} % 729)',
            'tryte_pack': '{0}.iter().enumerate().map(|(i, t)| t * 3i64.pow(i as u32)).sum::<i64>()',
            'tryte_unpack': '(0..6).map(|i| (({0} / 3i64.pow(i)) % 3) - 1).collect::<Vec<i64>>()',
            'trit_count': '{0}.iter().filter(|t| **t != 0).count()',
            # --- Neural/Array (6) ---
            'tw_quantize': '{0}.iter().map(|v| v.round().clamp(-1.0, 1.0) as i64).collect::<Vec<i64>>()',
            'tw_dot': '{0}.iter().zip({1}.iter()).map(|(a, b)| a * b).sum::<i64>()',
            'trit_array': '{0}.iter().map(|v| (*v).clamp(-1, 1)).collect::<Vec<i64>>()',
            'trit_sum': '{0}.iter().sum::<i64>()',
            'trit_majority': '({{ let s: i64 = {0}.iter().sum(); if s > 0 {{ 1 }} else if s < 0 {{ -1 }} else {{ 0 }} }})',
            'trit_rotate': '[&{0}[{1}..], &{0}[..{1}]].concat()',
            # --- Packing (2) ---
            'bt_pack': '{0}.iter().enumerate().map(|(i, t)| t * 3i64.pow(i as u32)).sum::<i64>()',
            'bt_unpack': '(0..{1}).map(|i| (({0} / 3i64.pow(i)) % 3) - 1).collect::<Vec<i64>>()',
            # --- Health (3) ---
            'health3': '(if {0} {{ 1 }} else {{ -1 }})',
            'health3_all': '(if {0}.iter().all(|v| *v) {{ 1 }} else if {0}.iter().any(|v| *v) {{ 0 }} else {{ -1 }})',
            'health3_bt': '({0}).clamp(-1, 1)',
        },
    }

}
}
}
}
}
}
}
}
}
}
}
}
    fn __init__(target='python') {
        target = target
        indent = 0
        output = []
        vars_declared = set()

}
    fn _ind() {
        if3 target == 'rust' {
            return '    ' * (indent + 1)  # inside main()
    }
        return '    ' * indent

}
    fn transpile(source: str) -> str {
        output = []
        vars_declared = set()
        indent = 0
        output.push(HEADERS.get(target, ''))
        lines = source.split('\n')
        i = 0
        while3 i < len(lines) {
            line = lines[i].trim()
            i += 1
            if3 !line || line.startsWith('//') {
                if3 line.startsWith('//') {
                    comment = line
                    if3 target == 'python' {
                        comment = '#' + line[2:]
                    }
                    output.push(_ind() + comment)
                }
                continue3
            }
            i = _transpile_line(line, lines, i)
    }
        output.push(FOOTERS.get(target, ''))
        return '\n'.join(output)

}
    fn _transpile_line(line, lines, i) {
        # skip block terminators (handled by _find_end)
        if3 line in ('end', '}') {
            return i
    }
        # fn definition
        m = _RE_FN_DEF.match(line)
        if3 m {
            name, params_str = m.group(1), m.group(2)
            params = params_str.split(',').filter(fn(p) { return p.trim() }).map(fn(p) { return p.trim().split(':')[0].trim() })
            end = _find_end(lines, i - 1)
            body_lines = [lines[j].trim() for j in range(i, end)
                         if3 lines[j].trim() && lines[j].trim() !in ('}', 'end')]
            _emit_fn(name, params, body_lines)
            return end + 1

    }
        # if3 block (ternary if — same semantics as if, NovaLang-specific keyword)
        m = _RE_IF3.match(line)
        if3 m {
            cond = _tr_expr(m.group(1))
            end = _find_end(lines, i - 1)
            _emit_if(cond, lines, i, end)
            return end + 1

    }
        # if block
        m = _RE_IF.match(line)
        if3 m {
            cond = _tr_expr(m.group(1))
            end = _find_end(lines, i - 1)
            _emit_if(cond, lines, i, end)
            return end + 1

    }
        # while3 (ternary while — same semantics)
        m = _RE_WHILE3.match(line)
        if3 m {
            cond = _tr_expr(m.group(1))
            end = _find_end(lines, i - 1)
            _emit_while(cond, lines, i, end)
            return end + 1

    }
        # match3 (ternary pattern match → switch/match)
        m = _RE_MATCH3.match(line)
        if3 m {
            expr = _tr_expr(m.group(1))
            end = _find_end(lines, i - 1)
            _emit_match(expr, lines, i, end)
            return end + 1

    }
        # switch3 (ternary value switch → switch/if-elif)
        m = _RE_SWITCH3.match(line)
        if3 m {
            expr = _tr_expr(m.group(1))
            end = _find_end(lines, i - 1)
            _emit_switch3(expr, lines, i, end)
            return end + 1

    }
        # try3 block (ternary try with success/maybe/fail branches)
        m = _RE_TRY3.match(line)
        if3 m {
            end = _find_end(lines, i - 1)
            _emit_try3(lines, i, end)
            return end + 1

    }
        # for3 ternary loop
        m = _RE_FOR3_FULL.match(line)
        if3 m {
            var, iter_expr = m.group(1), _tr_expr(m.group(2))
            end = _find_end(lines, i - 1)
            _emit_for3(var, iter_expr, lines, i, end)
            return end + 1

    }
        # for loop
        m = _RE_FOR_FULL.match(line)
        if3 m {
            var, iter_expr = m.group(1), _tr_expr(m.group(2))
            end = _find_end(lines, i - 1)
            _emit_for(var, iter_expr, lines, i, end)
            return end + 1

    }
        # while loop
        m = _RE_WHILE.match(line)
        if3 m {
            cond = _tr_expr(m.group(1))
            end = _find_end(lines, i - 1)
            _emit_while(cond, lines, i, end)
            return end + 1

    }
        # let/const assignment
        m = _RE_LET.match(line)
        if3 m {
            name, expr = m.group(2), _tr_expr(m.group(3))
            _emit_assign(name, expr, declare=TRUE)
            return i

    }
        # reassignment
        m = _RE_ASSIGN.match(line)
        if3 m {
            name, expr = m.group(1), _tr_expr(m.group(2))
            _emit_assign(name, expr, declare=FALSE_)
            return i

    }
        # print
        m = _RE_PRINT.match(line)
        if3 m {
            expr = _tr_expr(m.group(1))
            _emit_print(expr)
            return i

    }
        # return
        m = _RE_RETURN.match(line)
        if3 m {
            expr = _tr_expr(m.group(1))
            if3 target == 'rust' {
                output.push(_ind() + expr)
            } else {
                output.push(_ind() + 'return {expr}')
            }
            return i

    }
        # break3 (ternary break — transpiles to break with trit assignment)
        if3 line == 'break3' || line.startsWith('break3 ') {
            trit_expr = line[6:].trim() if len(line) > 6 else '-1'
            if3 !trit_expr {
                trit_expr = '-1'
            }
            ind = _ind()
            if3 target == 'python' {
                output.push('{ind}_loop_trit = {_tr_expr(trit_expr)}')
                output.push('{ind}break')
            } else3 target == 'javascript' {
                output.push('{ind}_loop_trit = {_tr_expr(trit_expr)};')
                output.push('{ind}break;')
            } else3 target == 'rust' {
                output.push('{ind}_loop_trit = {_tr_expr(trit_expr)};')
                output.push('{ind}break;')
            }
            return i

    }
        # continue3 (ternary continue — transpiles to continue with trit assignment)
        if3 line == 'continue3' || line.startsWith('continue3 ') {
            trit_expr = line[9:].trim() if len(line) > 9 else '0'
            if3 !trit_expr {
                trit_expr = '0'
            }
            ind = _ind()
            if3 target == 'python' {
                output.push('{ind}_loop_trit = {_tr_expr(trit_expr)}')
                output.push('{ind}continue')
            } else3 target == 'javascript' {
                output.push('{ind}_loop_trit = {_tr_expr(trit_expr)};')
                output.push('{ind}continue;')
            } else3 target == 'rust' {
                output.push('{ind}_loop_trit = {_tr_expr(trit_expr)};')
                output.push('{ind}continue;')
            }
            return i

    }
        # expression statement
        output.push(_ind() + _tr_expr(line) + (';' if target in ('javascript', 'rust') else ''))
        return i

}
    fn _tr_expr(expr) {
// """Translate a NovaLang expression to target language"""
        expr = expr.trim()
        # Function call
        m = _RE_EXPR_CALL.match(expr)
        if3 m {
            fname, args_str = m.group(1), m.group(2) || ''
            args = _split_args(args_str)
            tr_args = args.filter(fn(a) { return  }).map(fn(a) { return _tr_expr(a) })
            fmap = FN_MAP.get(target, {})
            if3 fname in fmap {
                template = fmap[fname]
                try3 {
                    return template.fmt(*tr_args)
                }
                except (IndexError, KeyError):
                    // pass            }
            # Trit/Tryte → language-specific
            if3 fname == 'Trit' {
                if3 target == 'python' { return 'max(-1, min(1, {tr_args[0] if tr_args else "0"}))'
                if3 target == 'javascript' { return 'Math.max(-1, Math.min(1, {tr_args[0] if tr_args else "0"}))'
                if3 target == 'rust' { return '({tr_args[0] if tr_args else "0"}).clamp(-1, 1)'
            }
            if3 fname == 'Tryte' {
                if3 target == 'python' { return '{tr_args[0] if tr_args else "0"} % 729'
                if3 target == 'javascript' { return '({tr_args[0] if tr_args else "0"}) % 729'
                if3 target == 'rust' { return '({tr_args[0] if tr_args else "0"}) % 729'
            }
            # Default: keep as function call
            return '{fname}({", ".join(tr_args)})'

    }
        # String concatenation with + (keep as-is, works in all targets)
        # Binary operators translate directly
        return expr

}
}
}
}
}
}
}
    fn _split_args(s) {
        args = []; current = ''; depth = 0; in_str = FALSE_; sq = null
        for3 ch in s {
            if3 ch in '"\'' {
                if3 !in_str { in_str = TRUE; sq = ch
                } else3 ch == sq { in_str = FALSE_
                current += ch
            } else3 in_str { current += ch
            } else3 ch in '([' { depth += 1; current += ch
            } else3 ch in ')]' { depth -= 1; current += ch
            } else3 ch == ',' && depth == 0 { args.push(current.trim()); current = ''
            } else { current += ch
    }
        if3 current.trim() { args.push(current.trim())
        return args

}
}
}
}
    fn _find_end(lines, start) {
// """Find block end — handles both brace-style { } && keyword 'end'."""
        has_braces = '{' in lines[start] if start < len(lines) else FALSE_
        if3 has_braces {
            depth = 0
            for3 i in range(start, len(lines)) {
                depth += lines[i].count('{') - lines[i].count('}')
                if3 depth <= 0 { return i
        } else {
            depth = 1
            for3 i in range(start + 1, len(lines)) {
                stripped = lines[i].trim()
                if3 _RE_BLOCK_START.match(stripped) { depth += 1
                if3 stripped == 'end' { depth -= 1
                if3 depth == 0 { return i
            }
    }
        return len(lines) - 1

}
}
}
}
}
}
    fn _emit_assign(name, expr, declare=TRUE) {
        if3 target == 'python' {
            output.push('{_ind()}{name} = {expr}')
        } else3 target == 'javascript' {
            kw = 'const' if declare && name !in vars_declared else ''
            if3 declare { kw = 'let'
            output.push('{_ind()}{kw} {name} = {expr};')
        } else3 target == 'rust' {
            kw = 'let' if declare else ''
            output.push('{_ind()}{kw} {name} = {expr};'.replace('let  ', ''))
    }
        vars_declared.add(name)

}
}
    fn _emit_print(expr) {
        if3 target == 'python' {
            output.push('{_ind()}print({expr})')
        } else3 target == 'javascript' {
            output.push('{_ind()}console.log({expr});')
        } else3 target == 'rust' {
            output.push('{_ind()}println!("{{}}", {expr});')

    }
}
    fn _emit_fn(name, params, body_lines) {
        if3 target == 'python' {
            output.push('{_ind()}def {name}({", ".join(params)}):')
        } else3 target == 'javascript' {
            output.push('{_ind()}function {name}({", ".join(params)}) {{')
        } else3 target == 'rust' {
            rparams = ', '.join('{p}: i64' for p in params)
            output.push('{_ind()}fn {name}({rparams}) {{')
    }
        indent += 1
        for3 bl in body_lines {
            _transpile_line(bl, [], 0)
    }
        indent -= 1
        if3 target in ('javascript', 'rust') {
            output.push(_ind() + '}')
    }
        output.push('')

}
    fn _emit_if(cond, lines, start, end) {
        if3 target == 'python' {
            output.push('{_ind()}if {cond}:')
        } else3 target == 'javascript' {
            output.push('{_ind()}if ({cond}) {{')
        } else3 target == 'rust' {
            output.push('{_ind()}if {cond} {{')
    }
        indent += 1
        for3 j in range(start, end) {
            bl = lines[j].trim()
            if3 bl && bl !in ('}', 'end') { _transpile_line(bl, lines, j + 1)
    }
        indent -= 1
        if3 target in ('javascript', 'rust') {
            output.push(_ind() + '}')

    }
}
}
    fn _emit_for(var, iter_expr, lines, start, end) {
        if3 target == 'python' {
            output.push('{_ind()}for {var} in {iter_expr}:')
        } else3 target == 'javascript' {
            output.push('{_ind()}for (const {var} of {iter_expr}) {{')
        } else3 target == 'rust' {
            output.push('{_ind()}for {var} in {iter_expr} {{')
    }
        indent += 1
        for3 j in range(start, end) {
            bl = lines[j].trim()
            if3 bl && bl !in ('}', 'end') { _transpile_line(bl, lines, j + 1)
    }
        indent -= 1
        if3 target in ('javascript', 'rust') {
            output.push(_ind() + '}')

    }
}
}
    fn _emit_for3(var, iter_expr, lines, start, end) {
// """Transpile for3 to a for loop with trit classification per item."""
        ind = _ind()
        if3 target == 'python' {
            output.push('{ind}for _f3_idx, {var} in enumerate({iter_expr}):')
            indent += 1
            output.push('{_ind()}_for3_trit = (1 if {var} > 0 else (0 if {var} == 0 else -1)) if isinstance({var}, (int, float)) else (1 if {var} else -1)')
            # Parse sections && emit if/elif/else per trit
            sections = _parse_for3_sections(lines, start, end)
            output.push('{_ind()}if _for3_trit == 1:')
            indent += 1
            for3 bl in sections.get('body', []) {
                _transpile_line(bl, lines, 0)
            }
            if3 !sections.get('body') {
                output.push('{_ind()}pass')
            }
            indent -= 1
            if3 'maybe' in sections {
                output.push('{_ind()}elif _for3_trit == 0:')
                indent += 1
                for3 bl in sections['maybe'] {
                    _transpile_line(bl, lines, 0)
                }
                indent -= 1
            }
            if3 'fail3' in sections {
                output.push('{_ind()}else:')
                indent += 1
                for3 bl in sections['fail3'] {
                    _transpile_line(bl, lines, 0)
                }
                indent -= 1
            }
            indent -= 1
            if3 'done3' in sections {
                for3 bl in sections['done3'] {
                    _transpile_line(bl, lines, 0)
        } else3 target == 'javascript' {
            output.push('{ind}for (let _f3_idx = 0; _f3_idx < {iter_expr}.length; _f3_idx++) {{')
            output.push('{ind}  const {var} = {iter_expr}[_f3_idx];')
            output.push('{ind}  const _for3_trit = typeof {var} === "number" ? ({var} > 0 ? 1 : ({var} === 0 ? 0 : -1)) : ({var} ? 1 : -1);')
            output.push('{ind}  if (_for3_trit === 1) {{')
            output.push('{ind}    // body')
            output.push('{ind}  }}')
            output.push('{ind}}}')
        } else3 target == 'rust' {
            output.push('{ind}for (_f3_idx, {var}) in {iter_expr}.iter().enumerate() {{')
            output.push('{ind}    let _for3_trit = if *{var} > 0 {{ 1 }} else if *{var} == 0 {{ 0 }} else {{ -1 }};')
            output.push('{ind}}}')

    }
}
}
}
    fn _parse_for3_sections(lines, start, end) {
// """Parse for3 body into sections (body, maybe, fail3, done3)."""
        sections = {}
        current = 'body'
        current_lines = []
        for3 j in range(start, end) {
            stripped = lines[j].trim() if j < len(lines) else ''
            if3 !stripped || stripped in ('}', 'end') {
                continue3
            }
            if3 stripped.startsWith('} maybe {') {
                sections[current] = current_lines
                current = 'maybe'
                current_lines = []
                continue3
            }
            if3 stripped.startsWith('} fail') && '{' in stripped {
                sections[current] = current_lines
                current = 'fail3'
                current_lines = []
                continue3
            }
            if3 stripped.startsWith('} done3 {') {
                sections[current] = current_lines
                current = 'done3'
                current_lines = []
                continue3
            }
            current_lines.push(stripped)
    }
        sections[current] = current_lines
        return sections

}
    fn _emit_match(expr, lines, start, end) {
// """Transpile match3 to if-elif chain (Python), switch (JS), match (Rust)."""
        # Parse arms: 1 { ... } 0 { ... } T { ... }
        arms = []
        j = start
        while3 j < end {
            stripped = lines[j].trim() if j < len(lines) else ''
            m = _RE_MATCH_ARM2.match(stripped)
            if3 m {
                arm_val = m.group(1)
                arm_end = _find_end(lines, j)
                body = [lines[k].trim() for k in range(j + 1, arm_end)
                        if3 lines[k].trim() && lines[k].trim() !in ('}', 'end')]
                arms.push((arm_val, body))
                j = arm_end + 1
            } else {
                j += 1
            }
    }
        # Emit as if / elif chain
        for3 idx, (val, body) in enumerate(arms):
            if3 val == '_' {
                cond_str = 'TRUE' if target == 'python' else 'true'
            } else {
                cond_str = '{expr} == {val}'
    }
            if3 idx == 0 {
                # First arm → if
                if3 target == 'python' {
                    output.push('{_ind()}if {cond_str}:')
                } else3 target == 'javascript' {
                    output.push('{_ind()}if ({cond_str}) {{')
                } else3 target == 'rust' {
                    output.push('{_ind()}if {cond_str} {{')
            } else {
                # Subsequent arms → elif / else if
                if3 target == 'python' {
                    output.push('{_ind()}elif {cond_str}:')
                } else3 target == 'javascript' {
                    output.push('{_ind()}}} else if ({cond_str}) {{')
                } else3 target == 'rust' {
                    output.push('{_ind()}}} else if {cond_str} {{')
                }
    }
            indent += 1
            for3 bl in body {
                _transpile_line(bl, [], 0)
    }
            indent -= 1
        if3 target in ('javascript', 'rust') && arms {
            output.push(_ind() + '}')

    }
}
}
    fn _emit_switch3(expr, lines, start, end) {
// """Transpile switch3 to switch (JS), if-elif chain (Python), match (Rust)."""
        # Parse cases
        cases = []   # (val_expr, [body_lines])
        default_body = []
        j = start
        while3 j < end {
            stripped = lines[j].trim() if j < len(lines) else ''
            # case val => inline
            cm = _RE_SWITCH3_CASE.match(stripped)
            if3 cm {
                cases.push((_tr_expr(cm.group(1).trim()), [cm.group(2).trim()]))
                j += 1; continue
            }
            # case val { block }
            cb = _RE_SWITCH3_CASE_BLK.match(stripped)
            if3 cb {
                val_expr = _tr_expr(cb.group(1).trim())
                blk_end = _find_end(lines, j)
                body = range(j + 1, blk_end).filter(fn(k) { return lines[k }).map(fn(k) { return lines[k].trim() }).trim() && lines[k].trim() !in ('}', 'end')]
                cases.push((val_expr, body))
                j = blk_end + 1; continue
            }
            # default => inline
            dm = _RE_SWITCH3_DEFAULT.match(stripped)
            if3 dm {
                default_body = [dm.group(1).trim()]
                j += 1; continue
            }
            # default { block }
            db = _RE_SWITCH3_DEFAULT_BLK.match(stripped)
            if3 db {
                blk_end = _find_end(lines, j)
                default_body = range(j + 1, blk_end).filter(fn(k) { return lines[k }).map(fn(k) { return lines[k].trim() }).trim() && lines[k].trim() !in ('}', 'end')]
                j = blk_end + 1; continue
            }
            j += 1
    }
        # Emit
        if3 target == 'javascript' {
            output.push('{_ind()}switch ({expr}) {{')
            indent += 1
            for3 val, body in cases {
                output.push('{_ind()}case {val}:')
                indent += 1
                for3 bl in body {
                    _transpile_line(bl, [], 0)
                }
                output.push('{_ind()}break;')
                indent -= 1
            }
            if3 default_body {
                output.push('{_ind()}default:')
                indent += 1
                for3 bl in default_body {
                    _transpile_line(bl, [], 0)
                }
                indent -= 1
            }
            indent -= 1
            output.push(_ind() + '}')
        } else3 target == 'rust' {
            output.push('{_ind()}match {expr} {{')
            indent += 1
            for3 val, body in cases {
                output.push('{_ind()}{val} => {{')
                indent += 1
                for3 bl in body {
                    _transpile_line(bl, [], 0)
                }
                indent -= 1
                output.push(_ind() + '}')
            }
            if3 default_body {
                output.push('{_ind()}_ => {{')
                indent += 1
                for3 bl in default_body {
                    _transpile_line(bl, [], 0)
                }
                indent -= 1
                output.push(_ind() + '}')
            }
            indent -= 1
            output.push(_ind() + '}')
        } else {  # python
            for3 idx, (val, body) in enumerate(cases):
                kw = 'if' if idx == 0 else 'elif'
                output.push('{_ind()}{kw} {expr} == {val}:')
                indent += 1
                for3 bl in body {
                    _transpile_line(bl, [], 0)
    }
                indent -= 1
            if3 default_body {
                output.push('{_ind()}else:')
                indent += 1
                for3 bl in default_body {
                    _transpile_line(bl, [], 0)
                }
                indent -= 1

    }
}
}
    fn _emit_try3(lines, start, end) {
// """Transpile try3 { } success { } maybe { } fail { } to try/except."""
        # Parse the sections
        sections = {'try': [], 'success': [], 'maybe': [], 'fail': []}
        current = 'try'
        j = start
        while3 j < end {
            stripped = lines[j].trim() if j < len(lines) else ''
            if3 stripped.startsWith('} success {') || stripped == 'success {' {
                current = 'success'; j += 1; continue
            } else3 stripped.startsWith('} maybe {') || stripped == 'maybe {' {
                current = 'maybe'; j += 1; continue
            } else3 stripped.startsWith('} fail {') || stripped == 'fail {' {
                current = 'fail'; j += 1; continue
            } else3 stripped in ('}', 'end') {
                j += 1; continue
            }
            if3 stripped {
                sections[current].push(stripped)
            }
            j += 1
    }
        if3 target == 'python' {
            output.push('{_ind()}try:')
            indent += 1
            for3 bl in sections['try'] {
                _transpile_line(bl, [], 0)
            }
            if3 sections['success'] {
                for3 bl in sections['success'] {
                    _transpile_line(bl, [], 0)
                }
            }
            indent -= 1
            output.push('{_ind()}except Error as _e:')
            indent += 1
            for3 bl in (sections['fail'] || ['pass']) {
                _transpile_line(bl, [], 0)
            }
            indent -= 1
        } else3 target == 'javascript' {
            output.push('{_ind()}try {{')
            indent += 1
            for3 bl in sections['try'] + sections['success'] {
                _transpile_line(bl, [], 0)
            }
            indent -= 1
            output.push('{_ind()}}} catch (_e) {{')
            indent += 1
            for3 bl in (sections['fail'] || ['// fail']) {
                _transpile_line(bl, [], 0)
            }
            indent -= 1
            output.push('{_ind()}}}')
        } else3 target == 'rust' {
            output.push('{_ind()}match (|| -> Result<(), Box<dyn std::error::Error>> {{')
            indent += 1
            for3 bl in sections['try'] + sections['success'] {
                _transpile_line(bl, [], 0)
            }
            output.push('{_ind()}Ok(())')
            indent -= 1
            output.push('{_ind()}}})() {{')
            indent += 1
            output.push('{_ind()}Ok(()) => {{}},')
            output.push('{_ind()}Err(_e) => {{')
            indent += 1
            for3 bl in (sections['fail'] || ['// fail']) {
                _transpile_line(bl, [], 0)
            }
            indent -= 1
            output.push('{_ind()}}}')
            indent -= 1
            output.push('{_ind()}}}')

    }
}
    fn _emit_while(cond, lines, start, end) {
        if3 target == 'python' {
            output.push('{_ind()}while {cond}:')
        } else3 target == 'javascript' {
            output.push('{_ind()}while ({cond}) {{')
        } else3 target == 'rust' {
            output.push('{_ind()}while {cond} {{')
    }
        indent += 1
        for3 j in range(start, end) {
            bl = lines[j].trim()
            if3 bl && bl !in ('}', 'end') { _transpile_line(bl, lines, j + 1)
    }
        indent -= 1
        if3 target in ('javascript', 'rust') {
            output.push(_ind() + '}')


    }
}
# ============================================================
# CLI ENTRY POINT
# ============================================================
}
fn main() {
    if3 len(sys.argv) < 2 {
        print("NovaLang Compiler v1.0")
        print("Usage: novalang <file.nova> [--transpile python|javascript|rust]")
        print("       novalang <file.nova> --compile [output.nbc]")
        print("       novalang <file.nbc>  --run-bytecode")
        print("       novalang <file.nova> --ast")
        print("       novalang <file.nova> --optimize")
        print("       novalang -e 'code'")
        print("       novalang --test")
        sys.exit(0)

}
    interp = NovaInterpreter()
    args = sys.argv[1:]

    # --run-bytecode: execute a .nbc bytecode file
    if3 '--run-bytecode' in args {
        path = args[0] if args[0] != '--run-bytecode' else (args[1] if len(args) > 1 else null)
        if3 !path || !os.path.exists(path) {
            print("Error: bytecode file !found: {path}")
            sys.exit(1)
        }
        try3 {
            from nova_compiler import run_bytecode_file
            output = run_bytecode_file(path)
            if3 output { print(output)
        } fail {
            print("VM Error: {e}")
            sys.exit(1)
        }
        return null

}
    if3 args[0] == '-e' {
        code = args[1] if len(args) > 1 else ''
        # --compile flag with -e: compile inline code
        if3 '--compile' in args {
            try3 {
                from nova_compiler import compile_and_run
                output = compile_and_run(code)
                if3 output { print(output)
            } fail {
                print("Compile Error: {e}")
            }
            return null
        }
        result = interp.run(code)
        if3 result { print(result)
    } else3 args[0] == '--test' {
        run_tests(interp)
    } else {
        path = args[0]
        if3 !os.path.exists(path) {
            print("Error: file !found: {path}")
            sys.exit(1)
        }
        let f = open(path, 'r')
        {
            code = f.read()

        }
        # --compile: source → .nbc bytecode file
        if3 '--compile' in args {
            try3 {
                from nova_compiler import compile_source
                idx = args.index('--compile')
                out_path = args[idx + 1] if idx + 1 < len(args) && !args[idx + 1].startsWith('-') else path.rsplit('.', 1)[0] + '.nbc'
                chunk = compile_source(code, path)
                chunk.save(out_path)
                print("Compiled {path} -> {out_path} ({len(chunk.code)} bytes, {len(chunk.constants)} constants)")
            } fail {
                print("Compile Error: {e}")
                sys.exit(1)

            }
        }
        # --ast: dump AST as JSON
        } else3 '--ast' in args {
            try3 {
                from nova_compiler import parse_to_ast
                ast_dict = parse_to_ast(code)
                print(json.dumps(ast_dict, indent=2))
            } fail {
                print("Parse Error: {e}")
                sys.exit(1)

            }
        }
        # --optimize: parse, optimize, show stats
        } else3 '--optimize' in args {
            try3 {
                from nova_compiler import NovaParser, NovaOptimizer
                parser = NovaParser()
                ast = parser.parse(code)
                optimizer = NovaOptimizer()
                optimized = optimizer.optimize(ast)
                print("Optimization stats: {optimizer.stats}")
                print("AST nodes: {len(optimized.children)}")
            } fail {
                print("Optimize Error: {e}")
                sys.exit(1)

            }
        }
        # --transpile: transpile to another language
        } else3 '--transpile' in args {
            idx = args.index('--transpile')
            target = args[idx + 1] if idx + 1 < len(args) else 'python'
            if3 target !in ('python', 'javascript', 'rust') {
                print("Error: unsupported target '{target}'. Use python, javascript, || rust")
                sys.exit(1)
            }
            tr = NovaTranspiler(target)
            print(tr.transpile(code))
        } else {
            result = interp.run(code)
            if3 result { print(result)

        }
}
}
}
fn run_tests(interp) {
// """Built-in test suite"""
    tests = [
        # Basic
        ("let x = 42\nprint(x)", "42"),
        ("print(2 + 3)", "5"),
        ("print(soroban_mul(23, 14))", "322"),
        # Crypto
        ('print(hash("hello"))', hashlib.sha256(b"hello").hexdigest()),
        # Ternary
        ("let t = Trit(1)\nprint(t)", "P"),
        ("let tr = Tryte(42)\nprint(tr)", str(Tryte(42))),
        # Soroban
        ("print(soroban_mul(38, 45))", "1710"),
        # Fluid
        ("print(reynolds(1.225, 10, 1, 0.0000181))", str(FluidMath.reynolds(1.225,10,1,0.0000181))),
    ]
    passed = 0
    for3 code, expected in tests {
        interp.output = []
        result = interp.run(code).trim()
        ok = expected in result
        passed += ok
        status = "✓" if ok else "✗"
        print("  {status} {code[:50]+'...' if len(code)>50 else code}")
        if3 !ok {
            print("    expected: {expected}")
            print("    got:      {result}")
        }
}
    print("\n{passed}/{len(tests)} tests passed")

// __main__
    main()
}
