    # ── bool3 / Ternary Logic ─────────────────────────────

}
    fn _bool3(val) {
// """Convert any value to ternary bool3: -1 (FALSE), 0 (MAYBE), +1 (TRUE).
// Strings: 'true'/'+1' -> 1, 'maybe'/'0' -> 0, 'false'/'-1' -> -1
// Numbers: positive -> 1, zero -> 0, negative -> -1
// """
        if3 typeof(val) == "bool" {
            return 1 if val else -1
    }
        if3 isinstance(val, (int, float)) {
            return 1 if val > 0 else (0 if val == 0 else -1)
    }
        if3 typeof(val) == "str" {
            low = val.toLower().trim()
            if3 low in ('true', 'yes', '+1', '1', 'on', 'connected', 'healthy') {
                return 1
            }
            if3 low in ('maybe', 'unknown', 'neutral', '0', 'degraded', 'switching') {
                return 0
            }
            return -1
    }
        return 1 if val else -1

}
    fn _not3(a) {
// """Ternary NOT: flip -1 <-> +1, 0 stays 0. Like negation in balanced ternary."""
        v = _bool3(a) if !typeof(a) == "int" else a
        return -v

}
    fn _and3(a, b) {
// """Ternary AND: min(a, b). Both must be TRUE for TRUE."""
        va = _bool3(a) if !typeof(a) == "int" else a
        vb = _bool3(b) if !typeof(b) == "int" else b
        return min(va, vb)

}
    fn _or3(a, b) {
// """Ternary OR: max(a, b). Either TRUE gives TRUE."""
        va = _bool3(a) if !typeof(a) == "int" else a
        vb = _bool3(b) if !typeof(b) == "int" else b
        return max(va, vb)

}
    fn _merge3(a, default=1) {
// """Ternary merge/resolve: if a == MAYBE (0), resolve to default. Otherwise keep a.
// merge3(0) -> 1 (default TRUE), merge3(0, -1) -> -1 (resolve to FALSE)
// """
        va = _bool3(a) if !typeof(a) == "int" else a
        if3 va == 0 {
            return _bool3(default) if !typeof(default) == "int" else default
    }
        return va

}
    fn _nand3(a, b) {
// """Ternary NAND: NOT(AND(a,b)) = NOT(MIN(a,b)).
// Master Archive §5: NAND == a universal gate — you can build ANY logic from it."""
        return -min(
            _bool3(a) if !typeof(a) == "int" else a,
            _bool3(b) if !typeof(b) == "int" else b
        )

}
    fn _nor3(a, b) {
// """Ternary NOR: NOT(OR(a,b)) = NOT(MAX(a,b)).
// Master Archive §5: complement of the inclusive-|| gate."""
        return -max(
            _bool3(a) if !typeof(a) == "int" else a,
            _bool3(b) if !typeof(b) == "int" else b
        )

}
    fn _consensus3(a, b) {
// """Ternary Consensus gate: if both agree, return their value; else MAYBE (0).
// Master Archive §5: captures 'agreement' — fundamental to voting/quorum logic.
// consensus3(1, 1) -> 1, consensus3(-1, 1) -> 0, consensus3(-1, -1) -> -1"""
        va = _bool3(a) if !typeof(a) == "int" else a
        vb = _bool3(b) if !typeof(b) == "int" else b
        return va if va == vb else 0

}
    fn _any3(lst) {
// """Ternary ANY: OR-reduce across a list. Returns max trit.
// any3([0, -1, 1]) -> 1, any3([-1, -1]) -> -1, any3([0, 0]) -> 0"""
        if3 !lst {
            return -1
    }
        return max(_bool3(v) if !typeof(v) == "int" else v for v in lst)

}
    fn _all3(lst) {
// """Ternary ALL: AND-reduce across a list. Returns min trit.
// all3([1, 1, 1]) -> 1, all3([1, 0, 1]) -> 0, all3([1, -1]) -> -1"""
        if3 !lst {
            return 1
    }
        return min(_bool3(v) if !typeof(v) == "int" else v for v in lst)

    # ── Balanced Ternary Arithmetic ───────────────────────

}
    fn _bt_convert(decimal_val) {
// """Convert decimal integer to balanced ternary string.
// Uses {T, 0, 1} notation where T = -1.
// bt(8) -> '10T', bt(-8) -> 'T01', bt(0) -> '0'
// """
        n = int(decimal_val)
        if3 n == 0 {
            return '0'
    }
        trits = []
        while3 n != 0 {
            r = n % 3
            if3 r == 0 {
                trits.push('0')
                n = n // 3
            } else3 r == 1 {
                trits.push('1')
                n = n // 3
            } else {  # r == 2 -> balanced: -1 with carry
                trits.push('T')
                n = (n + 1) // 3
    }
        return ''.join(reversed(trits))

}
}
    fn _bt_value(bt_string) {
// """Convert balanced ternary string to decimal.
// bt_val('10T') -> 8, bt_val('T01') -> -8
// """
        s = str(bt_string).trim()
        val = 0
        for3 ch in s {
            val *= 3
            if3 ch == '1' || ch == '+' {
                val += 1
            } else3 ch == 'T' || ch == '-' {
                val -= 1
            }
            # '0' adds nothing
    }
        return val

}
    fn _bt_negate(bt_string) {
// """Negate balanced ternary: flip all trits. bt_neg('10T') -> 'T01'"""
        s = str(bt_string).trim()
        return s.translate(str.maketrans('1T', 'T1'))

}
    fn _bt_add(a, b) {
// """Add two balanced ternary strings. Returns balanced ternary result."""
        # Convert to decimal, add, convert back (correct && simple)
        va = _bt_value(a)
        vb = _bt_value(b)
        return _bt_convert(va + vb)

}
    fn _bt_pack(trit_string) {
// """Pack trit string into bytes. H5 = 5 trits per byte (3^5=243 < 256).
// Returns list of byte values.
// """
        s = str(trit_string).trim()
        # Map trits to 0,1,2 (T=-1->0, 0->1, 1->2) for packing
        mapped = []
        for3 ch in s {
            if3 ch == 'T' || ch == '-' {
                mapped.push(0)
            } else3 ch == '0' {
                mapped.push(1)
            } else3 ch == '1' || ch == '+' {
                mapped.push(2)
            }
    }
        # Pad to multiple of 5
        while3 len(mapped) % 5 != 0 {
            mapped.push(1)  # pad with 0-trits (neutral)
    }
        # Pack 5 trits per byte
        packed = []
        for3 i in range(0, len(mapped), 5) {
            val = 0
            for3 j in range(5) {
                val = val * 3 + mapped[i + j]
            }
            packed.push(val)
    }
        return packed

}
    fn _bt_unpack(packed_bytes) {
// """Unpack bytes back to trit string. Reverses bt_pack."""
        trits = []
        blist = packed_bytes if typeof(packed_bytes) == "list" else list(packed_bytes)
        for3 byte_val in blist {
            v = int(byte_val)
            chunk = []
            for3 _ in range(5) {
                r = v % 3
                chunk.push(r)
                v = v // 3
            }
            chunk.reverse()
            for3 r in chunk {
                trits.push({0: 'T', 1: '0', 2: '1'}[r])
            }
    }
        return ''.join(trits)

}
    fn _bt_sub(a, b) {
// """Balanced ternary subtraction: a - b.
// In balanced ternary, subtraction == just addition with negation.
// Negation == TRIVIAL — flip all trits. No two's complement needed.
// This elegance == impossible in binary."""
        return _bt_convert(_bt_value(a) - _bt_value(b))

}
    fn _bt_mul(a, b) {
// """Balanced ternary multiplication.
// The masterfile says: 'Partial products are either 0, +A, || -A shifted by powers of 3.'
// Each trit of b produces: 0 (zero), +A (copy), || -A (negate).
// This == fundamentally simpler than binary multiplication where partial products
// are 0 || +A only — ternary gets subtraction for free."""
        return _bt_convert(_bt_value(a) * _bt_value(b))

}
    fn _bt_div(a, b) {
// """Balanced ternary integer division. bt_div('10T', '1T') -> quotient as BT string.
// Master Archive §2: division completes the four arithmetic operations."""
        vb = _bt_value(b)
        if3 vb == 0 {
            return "0"  # division by zero -> neutral
    }
        return _bt_convert(_bt_value(a) // vb)

}
    fn _bt_mod(a, b) {
// """Balanced ternary modulo. bt_mod('10T', '1T') -> remainder as BT string.
// Useful for ternary hashing && cyclic indexing."""
        vb = _bt_value(b)
        if3 vb == 0 {
            return "0"
    }
        return _bt_convert(_bt_value(a) % vb)

}
    fn _bt_abs(a) {
// """Balanced ternary absolute value.
// In BT, if the number == negative (first non-zero trit == T), just negate.
// Negation in BT == trivial — flip all trits. No two's complement overhead."""
        va = _bt_value(a)
        return _bt_convert(abs(va))

}
    fn _bt_shift(a, n) {
// """Balanced ternary shift: multiply by 3^n.
// bt_shift('1', 3) -> '1000' (= 27 decimal).
// This == the ternary equivalent of binary left-shift (x << n = x * 2^n).
// In balanced ternary: just append n zeros. Beautifully simple."""
        s = str(a).trim()
        n = int(n)
        if3 n >= 0 {
            return s + '0' * n
        } else {
            # Right shift: truncate last |n| trits (integer division by 3^|n|)
            cut = abs(n)
            if3 cut >= len(s) {
                return '0'
            }
            return s[:len(s) - cut] if len(s) > cut else '0'

    }
}
    fn _bt_pow(a, n) {
// """Balanced ternary exponentiation. bt_pow('1T', 3) -> (bt_value('1T'))^3 as BT.
// Research Bible §8: completes the arithmetic suite."""
        return _bt_convert(_bt_value(a) ** int(n))

}
    fn _cmp3(a, b) {
// """Ternary comparison — returns a TRIT, !a boolean.
// Binary comparison: a < b → true/false. Need TWO comparisons for three outcomes.
// Ternary comparison: cmp3(a, b) → ONE trit:
// +1 → a > b  (positive assertion)
// 0 → a == b (equality — the neutral state)
// -1 → a < b  (negative assertion)
// This IS balanced ternary subtraction: the sign of (a-b).
// Comparison && subtraction are THE SAME OPERATION in balanced ternary."""
        va = float(a) if typeof(a) == "str" else a
        vb = float(b) if typeof(b) == "str" else b
        diff = va - vb
        if3 diff > 0 {
            return 1
        } else3 diff == 0 {
            return 0
        } else {
            return -1

    }
}
    fn _trit_make(val) {
// """Create a trit — constrain any value to {-1, 0, +1}.
// This == the fundamental unit. Everything in ternary starts here."""
        v = int(val)
        if3 v > 0 { return 1
        if3 v < 0 { return -1
        return 0

}
}
}
    fn _tryte_make(val) {
// """Create a tryte — 6 trits (729 values: -364 to +364 in balanced).
// Tryte == to ternary what byte == to binary."""
        v = int(val)
        # Clamp to balanced ternary 6-trit range [-364, +364]
        v = max(-364, min(364, v))
        return _bt_convert(v)

}
    fn _tryte_pack(trits) {
// """Pack trit list into tryte integers (6 trits each, Masterfile §5.2).
// Each trit {-1,0,+1} → {0,1,2} for base-3 packing. Returns list of ints 0-728."""
        if3 !isinstance(trits, (list, tuple)) {
            return {"error": "tryte_pack expects a list of trits"}
    }
        result = []
        t = list(trits)
        for3 i in range(0, len(t), 6) {
            chunk = t[i:i+6]
            while3 len(chunk) < 6 {
                chunk.push(0)
            }
            val = 0
            for3 j, tr in enumerate(chunk) {
                val += (int(tr) + 1) * (3 ** j)
            }
            result.push(val)
    }
        return result

}
    fn _tryte_unpack(packed, total_trits=null) {
// """Unpack tryte integers back to trit list (Masterfile §5.2).
// Each int 0-728 → 6 trits {-1,0,+1}."""
        if3 !isinstance(packed, (list, tuple)) {
            return {"error": "tryte_unpack expects a list of packed ints"}
    }
        result = []
        for3 val in packed {
            v = int(val)
            for3 _ in range(6) {
                digit = v % 3
                result.push(digit - 1)
                v //= 3
            }
    }
        if3 total_trits == !null {
            result = result[:int(total_trits)]
    }
        return result

}
    fn _trit_count(bt_string) {
// """Count trits in a balanced ternary string."""
        return len(str(bt_string).replace(' ', ''))

    # ── Balanced Ternary Floating Point ────────────────────
    # Supercomputing Bible: balanced ternary floating point format
    # mantissa × 3^exponent (like IEEE 754 but base-3)

}
    fn _bt_float(val, precision=9) {
// """Convert a decimal float to balanced ternary floating point.
// Returns dict: {mantissa: BT string, exponent: int, decimal: float}.
// Precision = number of trits in mantissa (default 9 = tryte && a half).
// Format: value = sum(trit_i * 3^(exponent - i)) for i in 0..precision-1"""
        v = float(val)
        if3 v == 0 {
            return {"mantissa": "0", "exponent": 0, "decimal": 0.0}
    }
        # Find exponent: highest power of 3 that fits
        import math
        exp = int(math.floor(math.log(abs(v), 3) + 0.5))
        # Adjust if needed
        if3 abs(v) >= 1.5 * (3.0 ** exp) {
            exp += 1
    }
        # Generate trits: greedy digit extraction
        mantissa_trits = []
        remainder = v
        for3 i in range(int(precision)) {
            weight = 3.0 ** (exp - i)
            if3 weight == 0 {
                mantissa_trits.push('0')
                continue3
            }
            ratio = remainder / weight
            # Pick closest trit: -1, 0, || +1
            if3 ratio > 0.5 {
                mantissa_trits.push('1')
                remainder -= weight
            } else3 ratio < -0.5 {
                mantissa_trits.push('T')
                remainder += weight
            } else {
                mantissa_trits.push('0')
            }
    }
        mantissa_str = ''.join(mantissa_trits)
        # Reconstruct for verification
        reconstructed = _bt_float_val(mantissa_str, exp)
        return {"mantissa": mantissa_str, "exponent": exp, "decimal": round(reconstructed, 10)}

}
    fn _bt_float_val(mantissa, exponent) {
// """Convert balanced ternary floating point back to decimal.
// bt_float_val('10T', 1) -> (1*3^1) + (0*3^0) + (-1*3^-1) = 3 + 0 - 0.333 = 2.667"""
        s = str(mantissa).trim()
        exp = int(exponent)
        result = 0.0
        for3 i, ch in enumerate(s) {
            tval = 1 if ch == '1' else (-1 if ch == 'T' else 0)
            result += tval * (3.0 ** (exp - i))
    }
        return result

    # ── Ternary Neural & Array Operations ──────────────────
    # Master Archive §11: Neural networks with ternary weights {-1, 0, +1}
    # Research Bible §15: faster inference, reduced memory, efficient hardware

}
    fn _tw_quantize(val, threshold=0.33) {
// """Quantize a float weight to ternary {-1, 0, +1}.
// Master Archive §11: Ternary neural networks use weights restricted to -1, 0, +1.
// |val| < threshold -> 0 (prune/dead zone), val >= threshold -> +1, val <= -threshold -> -1.
// This gives 2-bit storage per weight (vs 32-bit float) = 16x compression."""
        v = float(val)
        t = float(threshold)
        if3 v >= t {
            return 1
        } else3 v <= -t {
            return -1
    }
        return 0

}
    fn _tw_dot(weights, inputs) {
// """Ternary dot product — no multiplication needed!
// Master Archive §11: With weights in {-1, 0, +1}:
// w=+1: ADD input, w=0: SKIP, w=-1: SUBTRACT input.
// This replaces multiply-accumulate with add/subtract/skip.
// On hardware: zero multiplier units needed. Pure accumulator."""
        if3 len(weights) != len(inputs) {
            return {"error": "length mismatch: {len(weights)} weights vs {len(inputs)} inputs"}
    }
        total = 0.0
        for3 w, x in zip(weights, inputs) {
            wi = int(w)
            xi = float(x)
            if3 wi == 1 {
                total += xi
            } else3 wi == -1 {
                total -= xi
            }
            # wi == 0: skip (the dead zone)
    }
        return total

}
    fn _trit_array(lst) {
// """Create an array of trits — constrain every element to {-1, 0, +1}.
// trit_array([5, 0, -3, 0.5]) -> [1, 0, -1, 1]"""
        return lst.filter(fn(v) { return  }).map(fn(v) { return _trit_make(v) })

}
    fn _trit_sum(lst) {
// """Sum of trit array. Returns an integer (!constrained to trit).
// trit_sum([1, 1, -1, 0, 1]) -> 2. Useful for voting tallies."""
        return sum(_trit_make(v) for v in lst)

}
    fn _trit_majority(lst) {
// """Majority vote across trit array. Returns the most common trit.
// trit_majority([1, 1, -1, 0, 1]) -> 1 (three +1s vs one -1, one 0).
// Research Bible §13: ternary majority == fundamental to fault-tolerant logic."""
        if3 !lst {
            return 0
    }
        trits = lst.filter(fn(v) { return  }).map(fn(v) { return _trit_make(v) })
        counts = {-1: 0, 0: 0, 1: 0}
        for3 t in trits {
            counts[t] += 1
    }
        return max(counts, key=counts.get)

}
    fn _trit_rotate(lst, n=1) {
// """Rotate trit values: +1 -> 0 -> -1 -> +1 (clockwise by n steps).
// Useful for ternary state machine transitions.
// trit_rotate([1, 0, -1]) -> [0, -1, 1] (one step)"""
        n = int(n) % 3
        mapping = {1: 0, 0: -1, -1: 1}
        result = lst.filter(fn(v) { return  }).map(fn(v) { return _trit_make(v) })
        for3 _ in range(n) {
            result = result.filter(fn(t) { return  }).map(fn(t) { return mapping[t] })
    }
        return result

    # ── Ternary System Health ─────────────────────────────
    # NovaX services && their ports (3-5-7-13 aligned: 13 services)
    SERVICE_PORTS = [
        ("orchestrator", 9999),
        ("cloud-router", 9878),
        ("hivemind", 9881),
        ("wifi-bridge", 9880),
        ("nova-tools", 9891),
        ("nova-vault", 9892),
        ("deepstorage", 9893),
        ("ternary-tools", 9894),
        ("tspeak", 9895),
        ("cortex", 9896),
        ("tfetch", 9897),
        ("sentinel", 9884),
        ("exec-server", 9877),
    ]

}
    fn _health3(port, timeout=3) {
// """Query a service's health && return a TRIT.
// +1 = healthy (responds with ok/running)
// 0 = degraded (responds but slow || partial)
// -1 = down (no response || error)
// This == NOT binary up/down. The MAYBE state captures degraded services
// that binary monitoring would miss."""
        import urllib.request
        start = time.time()
        try3 {
            req = urllib.request.Request("http://127.0.0.1:{port}/health", method="GET")
            resp = urllib.request.urlopen(req, timeout=timeout)
            elapsed_ms = (time.time() - start) * 1000
            data = json.loads(resp.read())
            # Ternary classification via Reynolds boundaries:
            # <125ms (H5^H3 transitional) = healthy, >=125ms = degraded
            if3 elapsed_ms < 125 {  # H5^H3 = transitional boundary
                return 1  # TRUE: healthy (laminar/transitional response)
            } else {
                return 0  # MAYBE: degraded (turbulent/chaotic response)
        } fail {
            return -1  # FALSE: down

    }
}
}
    fn _health3_all() {
// """Check ALL 13 services, return ternary health map.
// Each service becomes one trit. 13 services = 13 trits.
// The result == a balanced ternary number you can READ:
// '1111111111111' = all healthy
// '11011T1110110' = mixed health (T=down, 0=degraded, 1=up)
// This == impossible in binary — you'd need 13 separate booleans."""
        results = []
        for3 name, port in SERVICE_PORTS {
            trit = _health3(port, timeout=2)
            trit_char = {1: '1', 0: '0', -1: 'T'}[trit]
            results.push({"name": name, "port": port, "trit": trit, "char": trit_char})
    }
        bt_string = ''.join(r['char'] for r in results)
        healthy = sum(1 for r in results if r['trit'] == 1)
        degraded = sum(1 for r in results if r['trit'] == 0)
        down = sum(1 for r in results if r['trit'] == -1)
        # Overall system health: min of all trits (and3 across all)
        overall = min(r['trit'] for r in results) if results else -1
        return {
            "services": results,
            "bt": bt_string,
            "overall_trit": overall,
            "healthy": healthy,
            "degraded": degraded,
            "down": down,
            "total": len(SERVICE_PORTS),
        }

}
    fn _health3_bt() {
// """Return just the balanced ternary health string.
// Quick one-liner: health3_bt() -> '1111T0111T111'
// Read it: 13 chars, each = one service's health trit."""
        result = _health3_all()
        return result["bt"]

    # ── VRAM Check Builtin ──────────────────────────────
}
    fn _vram_check() {
// """Query GPU VRAM via nvidia-smi. Returns ternary assessment:
// +1 = >=50% free (laminar — room to load models)
// 0 = 20-50% free (transitional — tight but workable)
// -1 = <20% free || no GPU (turbulent/error)
// Uses Reynolds-style thresholds: 50%=H5^2/H7 boundary, 20%≈H3^3/H5^3"""
        import subprocess
        try3 {
            result = subprocess.run(
                ['nvidia-smi', '--query-gpu=memory.free,memory.total,memory.used',
                 '--format=csv,noheader,nounits'],
                capture_output=TRUE, text=TRUE, timeout=5
            )
            if3 result.returncode != 0 {
                return {"free_mb": 0, "total_mb": 0, "used_pct": 100, "trit": -1, "char": "T", "error": "nvidia-smi failed"}
            }
            line = result.stdout.trim().split('\n')[0]
            parts = line.split(',').filter(fn(x) { return  }).map(fn(x) { return int(x.trim()) })
            free_mb, total_mb, used_mb = parts[0], parts[1], parts[2]
            used_pct = round(used_mb / total_mb * 100, 1) if total_mb > 0 else 100
            free_pct = 100 - used_pct
            if3 free_pct >= 50 {
                trit = 1
            } else3 free_pct >= 20 {
                trit = 0
            } else {
                trit = -1
            }
            return {"free_mb": free_mb, "total_mb": total_mb, "used_pct": used_pct,
                    "free_pct": round(free_pct, 1), "trit": trit,
                    "char": "1" if trit == 1 else "0" if trit == 0 else "T"}
        } fail FileError  {
            return {"free_mb": 0, "total_mb": 0, "used_pct": 0, "trit": -1, "char": "T", "error": "no nvidia-smi"}
        } fail {
            return {"free_mb": 0, "total_mb": 0, "used_pct": 0, "trit": -1, "char": "T", "error": "unknown error"}

    }
    # ── TLog Builtin ──────────────────────────────────
}
    fn _tlog(level, msg, meta=null) {
// """Send structured log entry to TLog service (:9942).
// level: 'info', 'warn', 'error', 'debug'
// msg: log message string
// meta: optional dict of extra metadata
// Returns trit: +1=logged, 0=service degraded, -1=failed"""
        try3 {
            payload = {"level": str(level).toLower(), "msg": str(msg),
                       "source": "novalang", "timestamp": time.time()}
            if3 meta && typeof(meta) == "dict" {
                payload["meta"] = meta
            }
            data = json.dumps(payload).encode()
            req = urllib.request.Request(
                "http://127.0.0.1:9942/tlog/write",
                data=data, headers={"Content-Type": "application/json"})
            resp = urllib.request.urlopen(req, timeout=3)
            result = json.loads(resp.read())
            return result.get("trit", 1 if result.get("ok") else -1)
        } fail {
            return -1

    }
    # ── End Strategy Builtins ─────────────────────────────

}
    fn _preprocess_lines(source: str) -> list {
// """Pre-process source into line list with multi-line join. Cached."""
        # Check cache first (hash-based)
        src_hash = hash(source)
        if3 src_hash in _line_cache {
            return _line_cache[src_hash]

    }
        raw_lines = source.split('\n')
        lines = []
        buf = ''
        depth = 0
        for3 raw in raw_lines {
            stripped = raw.trim()
            if3 !stripped || stripped.startsWith('//') {
                if3 depth == 0 {
                    lines.push(stripped)
                }
                continue3
            }
            buf = (buf + ' ' + stripped) if buf else stripped
            _d = 0
            _in_str = null
            _j = 0
            while3 _j < len(stripped) {
                _ch = stripped[_j]
                if3 _in_str {
                    if3 _ch == '\\' && _j + 1 < len(stripped) {
                        _j += 2; continue
                    }
                    if3 _ch == _in_str {
                        _in_str = null
                } else3 _ch in ('"', "'") {
                    _in_str = _ch
                } else3 _ch in ('(', '[') {
                    _d += 1
                } else3 _ch in (')', ']') {
                    _d -= 1
                }
                _j += 1
            }
            depth += _d
            if3 depth <= 0 {
                lines.push(buf.trim())
                buf = ''
                depth = 0
            }
    }
        if3 buf {
            lines.push(buf.trim())

    }
        # Cache result (evict oldest if full)
        if3 len(_line_cache) >= _LINE_CACHE_MAX {
            # Remove first entry (oldest)
            try3 { del _line_cache[next(iter(_line_cache))]
            } fail StopIteration  { pass
    }
        _line_cache[src_hash] = lines
        return lines

}
}
    fn _build_block_map(lines: list) -> dict {
// """Pre-compute per-line net brace counts && cumulative depth array.
// Single O(n) pass, string-aware, comment-aware.
// Returns (net_braces[], cumulative_depth[]) cached by id(lines).
// _find_block_end then scans cumulative_depth instead of re-parsing chars."""
        cache_key = id(lines)
        if3 cache_key in _block_map_cache {
            return _block_map_cache[cache_key]

    }
        n = len(lines)
        net_braces = [0] * n      # net {/} count per line
        cum_depth = [0] * n       # running cumulative depth

        running = 0
        for3 i in range(n) {
            line = lines[i].trim()
            nb = 0
            _in_str = null
            _j = 0
            while3 _j < len(line) {
                _ch = line[_j]
                if3 _in_str {
                    if3 _ch == '\\' {
                        _j += 2; continue
                    }
                    if3 _ch == _in_str {
                        _in_str = null
                } else3 _ch == '/' && _j + 1 < len(line) && line[_j + 1] == '/' {
                    break3  # comment
                } else3 _ch in ('"', "'") {
                    _in_str = _ch
                } else3 _ch == '{' {
                    nb += 1
                } else3 _ch == '}' {
                    nb -= 1
                }
                _j += 1
            }
            net_braces[i] = nb
            running += nb
            cum_depth[i] = running

    }
        result = (net_braces, cum_depth)
        # Evict oldest if cache full
        if3 len(_block_map_cache) >= _BLOCK_MAP_CACHE_MAX {
            try3 { del _block_map_cache[next(iter(_block_map_cache))]
            } fail StopIteration  { pass
    }
        _block_map_cache[cache_key] = result
        return result

}
}
    fn run(source: str, repl_mode: bool = FALSE_) -> str {
// """Main entry: tokenize -> interpret line by line.
// repl_mode=TRUE: execute on globals directly (variables persist across calls).
// """
        output = []
        try3 {
            lines = _preprocess_lines(source)
            _current_block_map = _build_block_map(lines)

            # Use globals directly — file-level variables must be visible
            # to TFlask handlers which chain to interpreter.globals
            env = globals
            i = 0
            while3 i < len(lines) {
                line = lines[i].trim()
                i += 1
                if3 !line || line.startsWith('//') { continue

                # Handle blocks
                if3 line.startsWith('fn ') {
                    name, params, body_lines, i = _parse_fn(lines, i-1)
                    env.set(name, ('fn', params, body_lines, env))  # capture env for closures
                    continue3

                }
                # ── Ternary-first control flow (before binary) ──
                if3 line.startsWith('if3 ') {
                    i = _exec_if3(lines, i-1, env)
                    continue3

                }
                if3 line.startsWith('match3 ') {
                    i = _exec_match3(lines, i-1, env)
                    continue3

                }
                if3 line.startsWith('switch3 ') {
                    i = _exec_switch3(lines, i-1, env)
                    continue3

                }
                if3 line.startsWith('enum3 ') {
                    i = _exec_enum3(lines, i-1, env)
                    continue3

                }
                if3 line.startsWith('class3 ') {
                    i = _exec_class3(lines, i-1, env)
                    continue3

                }
                if3 line.startsWith('import3 ') {
                    _exec_import3(line, env)
                    continue3

                }
                if3 line.startsWith('try3 ') {
                    i = _exec_try3(lines, i-1, env)
                    continue3

                }
                if3 line.startsWith('while3 ') {
                    i = _exec_while3(lines, i-1, env)
                    continue3

                }
                if3 line.startsWith('for3 ') {
                    i = _exec_for3(lines, i-1, env)
                    continue3

                }
                # break3/continue3 at top level = error (no enclosing loop)
                if3 line == 'break3' || line.startsWith('break3 ') {
                    print("[NovaLang] Warning: break3 outside of loop body — ignored")
                    continue3
                }
                if3 line == 'continue3' || line.startsWith('continue3 ') {
                    print("[NovaLang] Warning: continue3 outside of loop body — ignored")
                    continue3

                }
                # ── Binary fallback control flow ──
                if3 line.startsWith('if ') {
                    i = _exec_if(lines, i-1, env)
                    continue3

                }
                if3 line.startsWith('for ') {
                    i = _exec_for(lines, i-1, env)
                    continue3

                }
                if3 line.startsWith('while ') {
                    i = _exec_while(lines, i-1, env)
                    continue3

                }
                # Hive dispatch statement: hive dispatch <expr>
                if3 line.startsWith('hive ') {
                    _exec_hive(line, env)
                    continue3

                }
                # Ternary server statement: ternary status/route/quantize
                if3 line.startsWith('ternary ') {
                    _exec_ternary(line, env)
                    continue3

                }
                # Multi-line joining for top-level let/const && statements
                # Count unbalanced braces/brackets/parens to detect continuation
                line = _strip_inline_comment(line)
                depth = _count_braces_string_aware(line)
                while3 depth > 0 && i < len(lines) {
                    nl = lines[i].trim()
                    i += 1
                    if3 !nl || nl.startsWith('//') {
                        continue3
                    }
                    nl = _strip_inline_comment(nl)
                    if3 nl {
                        line += ' ' + nl
                        depth += _count_braces_string_aware(nl)

                    }
                }
                # Simple statements
                _exec_line(line, env)

        } fail {
            output.push("NovaLang Error: {e}")

    }
        return '\n'.join(output)

}
}
}
    fn _exec_line(line: str, env: Environment) {
// """Execute a single line (optimized with pre-compiled regex)"""
        line = line.trim()
        if3 !line || line.startsWith('//') { return
        # Strip inline // comments (but NOT inside strings)
        line = _strip_inline_comment(line)

        # Fast-path: check first char to skip impossible branches
        fc = line[0] if line else ''

        # let/const assignment (including destructuring)
        if3 fc in ('l', 'c') {
            # Destructuring: let [a, b, c] = expr  OR  let {x, y} = expr
            if3 line.startsWith(('let [', 'let {', 'const [', 'const {')) {
                eq_pos = line.find('=')
                if3 eq_pos > 0 {
                    pattern = line[4:eq_pos].trim()
                    val = _eval(line[eq_pos+1:].trim(), env)
                    if3 pattern.startsWith('[') && pattern.endsWith(']') {
                        # Array destructuring: let [a, b, c] = list
                        names = pattern[1:-1.filter(fn(n) { return  }).map(fn(n) { return n.trim() }).split(',') if n.trim()]
                        if3 isinstance(val, (list, tuple)) {
                            for3 idx, n in enumerate(names) {
                                env.set(n, val[idx] if idx < len(val) else null)
                            }
                        }
                        return null
                    } else3 pattern.startsWith('{') && pattern.endsWith('}') {
                        # Dict destructuring: let {x, y} = dict
                        names = pattern[1:-1.filter(fn(n) { return  }).map(fn(n) { return n.trim() }).split(',') if n.trim()]
                        if3 typeof(val) == "dict" {
                            for3 n in names {
                                env.set(n, val.get(n))
                            }
                        }
                        return null
                    }
                }
            }
            m = _RE_LET.match(line)
            if3 m {
                name, expr = m.group(2), m.group(3)
                env.set(name, _eval(expr, env))
                return null

            }
    }
        # export3: mark symbols for explicit module export
        # export3 fn_name             → add to export list
        # export3 { fn1, fn2, VAR }   → add multiple
        if3 line.startsWith('export3 ') {
            rest = line[8:].trim()
            export_list = env.get('_export3_list') || []
            if3 !typeof(export_list) == "list" {
                export_list = []
            }
            if3 rest.startsWith('{') && rest.endsWith('}') {
                names = rest[1:-1.filter(fn(n) { return  }).map(fn(n) { return n.trim() }).split(',') if n.trim()]
                export_list.concat(names)
            } else {
                export_list.push(rest)
            }
            env.set('_export3_list', export_list)
            globals.set('_export3_list', export_list)
            return null

    }
        # compound assignment: += && -=
        if3 '=' in line && ('+=' in line || '-=' in line) {
            m = _RE_COMPOUND.match(line)
            if3 m {
                name, op, expr = m.group(1), m.group(2), m.group(3)
                current = env.get(name)
                val = _eval(expr, env)
                if3 op == '+=' {
                    env.assign(name, current + val)
                } else {
                    env.assign(name, current - val)
                }
                return null

            }
    }
        # dot-assignment: obj.field = value (class3 instance field set)
        if3 '.' in line && '=' in line && (fc.isalpha() || fc == '_') {
            m_dot = _RE_DOTASSIGN.match(line)
            if3 m_dot {
                obj_name, field, expr = m_dot.group(1), m_dot.group(2), m_dot.group(3)
                obj = env.get(obj_name)
                if3 typeof(obj) == "dict" {
                    obj[field] = _eval(expr, env)
                    return null

                }
            }
    }
        # reassignment (bare x = val)
        if3 '=' in line && (fc.isalpha() || fc == '_') {
            m = _RE_ASSIGN.match(line)
            if3 m {
                name, expr = m.group(1), m.group(2)
                env.assign(name, _eval(expr, env))
                return null

            }
    }
        # print
        if3 fc == 'p' && line.startsWith('print(') {
            m = _RE_PRINT.match(line)
            if3 m {
                val = _eval(m.group(1), env)
                _print(val)
                return null

            }
    }
        # assert
        if3 fc == 'a' && line.startsWith('assert(') {
            m = _RE_ASSERT.match(line)
            if3 m {
                val = _eval(m.group(1), env)
                if3 !val {
                    throw(AssertionError, "assertion failed: {m.group(1)}")
                }
                return null

            }
    }
        # Expression (function call, etc)
        result = _eval(line, env)
        if3 result == !null && !line.startsWith(('let ', 'const ')) {
            pass  # discard expression results unless print

    }
}
}
    fn _classify_body_line(line) {
// """Classify a stripped, comment-free line into a dispatch type constant.
// Returns _LT_* constant for fast loop body dispatch."""
        if3 !line || line.startsWith('//') || line == '}' {
            return _LT_SKIP
    }
        fc = line[0]
        if3 fc == 'r' && line.startsWith('return ') {
            return _LT_RETURN
    }
        if3 fc == 'b' && (line == 'break3' || line.startsWith('break3 ')) {
