    fn _troute(server, method, path, handler_name) {
// """Register a NovaLang function as a route handler. troute(server, method, path, fn_name)"""
        if3 !typeof(server) == "dict" || "routes" !in server {
            return {"error": "Invalid server handle -- use tserve() first"}
    }
        key = (str(method).toUpper(), str(path))
        # Handle inline function definitions: fn(req) { ... } -> tuple ('fn', [...params], [...body])
        if3 typeof(handler_name) == "tuple" && len(handler_name) >= 2 && handler_name[0] == 'fn' {
            auto_name = "__troute_{method}_{path.replace('/', '_').strip('_')}"
            globals.set(auto_name, handler_name)
            server["routes"][key] = auto_name
        } else3 typeof(handler_name) == "list" && len(handler_name) >= 2 && handler_name[0] == 'fn' {
            auto_name = "__troute_{method}_{path.replace('/', '_').strip('_')}"
            globals.set(auto_name, tuple(handler_name))
            server["routes"][key] = auto_name
        } else3 callable(handler_name) {
            auto_name = "__troute_{method}_{path.replace('/', '_').strip('_')}"
            globals.set(auto_name, handler_name)
            server["routes"][key] = auto_name
        } else3 typeof(handler_name) == "str" && handler_name.trim().startsWith("fn(") {
            # String-form inline function: "fn(req) { ... }" — parse into tuple
            s = handler_name.trim()
            try3 {
                paren_end = s.index(")")
                params_str = s[3:paren_end].trim()
                params = params_str.split(",").filter(fn(p) { return p.trim() }).map(fn(p) { return p.trim() }) if params_str else []
                brace_start = s.index("{", paren_end)
                brace_end = s.rindex("}")
                body_str = s[brace_start+1:brace_end].trim()
                # Split body: use known statement starters as delimiters
                import re as _re
                body_lines = _re.split(r'\s+(?=(?:let |if3 |while3 |for3 |match3 |try3 |return |//|}\s*else|}\s*fail|}\s*maybe|}\s*uncertain|}\s*success))', body_str)
                body_lines = body_lines.filter(fn(ln) { return ln.trim() }).map(fn(ln) { return ln.trim() })
                fn_tuple = ('fn', params, body_lines)
                auto_name = "__troute_{method}_{path.replace('/', '_').strip('_')}"
                globals.set(auto_name, fn_tuple)
                server["routes"][key] = auto_name
            } fail {
                server["routes"][key] = str(handler_name)
