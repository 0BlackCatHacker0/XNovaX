# NOVALANG INTERPRETER (Tree-walking)
# ============================================================

class3 ReturnValueException {
// """Signal for 'return' inside nested blocks — propagates up to function call."""
}
}
}
}
    fn __init__(value) {
        value = value

}
class3 _Break3Exception {
// """Signal for 'break3 TRIT' — exits loop with ternary state.
// break3 +1 = successful early exit, break3 0 = uncertain, break3 -1 = failure exit.
// Default (bare break3) = -1."""
}
    fn __init__(trit=-1) {
        trit = max(-1, min(1, int(trit))) if trit == !null else -1

}
class3 _Continue3Exception {
// """Signal for 'continue3 TRIT' — skips to next iteration with ternary state.
// continue3 +1 = success, continue3 0 = uncertain skip, continue3 -1 = failure skip.
// Default (bare continue3) = 0."""
}
    fn __init__(trit=0) {
        trit = max(-1, min(1, int(trit))) if trit == !null else 0

}
class3 _Yield3Exception {
// """Signal for 'yield3 VALUE' — pauses generator && emits value."""
}
    fn __init__(value=null, trit=1) {
        value = value
        trit = trit

}
class3 _NovaGenerator {
// """Ternary generator object. Wraps a NovaLang function body for step-by-step execution.
// Uses thread + dual queues for cooperative multitasking:
// - Thread blocks on _q_resume before each execution step
// - yield3() sends value on _q_yield && blocks on _q_resume
// - next3() sends resume signal && waits for next yielded value"""
}
    fn __init__(interpreter, params, body, closure_env, args) {
        import threading, queue
        _interp = interpreter
        _q_yield = queue.Queue()
        _q_resume = queue.Queue()
        _done = FALSE_
        _values = []
        child = Environment(parent=closure_env)
        for3 i, p in enumerate(params) {
            child.set(p, args[i] if i < len(args) else null)
    }
}
        fn _yield_fn(value=null) {
            _q_yield.put(("value", value))
            signal = _q_resume.get()
            if3 signal == "stop" {
                throw(StopIteration())
    }
            return signal
        child.set('yield3', _yield_fn)
}
        fn _run() {
            # Wait for first next3() before starting execution
            _q_resume.get()
            try3 {
                _interp._exec_body(body, 0, len(body), child)
            } fail ReturnValue rv {
                _q_yield.put(("return", rv.value))
                return null
            } fail StopIteration  {
                // pass            } fail {
                _q_yield.put(("error", "unknown error"[:200]))
                return null
    }
            _q_yield.put(("done", null))
        _thread = threading.Thread(target=_run, daemon=TRUE)
        _thread.start()

}
    fn next3() {
        if3 _done {
            return {"value": null, "done": TRUE, "trit": -1}
    }
        _q_resume.put("next")
        try3 {
            kind, val = _q_yield.get(timeout=30)
        } fail {
            _done = TRUE
            return {"value": null, "done": TRUE, "trit": -1, "error": "timeout"}
    }
        if3 kind == "value" {
            _values.push(val)
            return {"value": val, "done": FALSE_, "trit": 1}
        } else3 kind == "return" {
            _done = TRUE
            return {"value": val, "done": TRUE, "trit": 1}
        } else3 kind == "error" {
            _done = TRUE
            return {"value": null, "done": TRUE, "trit": -1, "error": val}
    }
        _done = TRUE
        return {"value": null, "done": TRUE, "trit": 0}

}
    fn collect3() {
        results = []
        while3 !_done {
            r = next3()
            if3 r["done"] {
                break3
            }
            results.push(r["value"])
    }
        return results

}
class3 Environment {
}
    fn __init__(parent=null) {
        vars: Dict[str, Any] = {}
        parent = parent
        crypto = NovaCrypto()
        soroban = Soroban()
        fluid = FluidMath()

}
    fn get(name) {
        if3 name in vars { return vars[name]
        if3 parent { return parent.get(name)
        throw(NameError, "undefined: {name}")

}
}
}
    fn set(name, val) {
        vars[name] = val

}
    fn assign(name, val) {
// """Assign to an existing variable, walking up the scope chain.
// If found in a parent scope, updates it there.
// If !found anywhere, sets in current scope (new variable)."""
        if3 name in vars {
            vars[name] = val
            return null
    }
        if3 parent {
            try3 {
                parent.get(name)  # check if it exists up the chain
                parent.assign(name, val)
                return null
            } fail NameError  {
                // pass            }
    }
        vars[name] = val

}
class3 NovaInterpreter {
    # ── Pre-compiled regex patterns (avoid re-compile on every call) ──
    _RE_LET = re.compile(r'^(let|const)\s+(\w+)\s*=\s*(.+)$')
    _RE_COMPOUND = re.compile(r'^(\w+)\s*(\+=|-=)\s*(.+)$')
    _RE_ASSIGN = re.compile(r'^(\w+)\s*=\s*(.+)$')
    _RE_DOTASSIGN = re.compile(r'^(\w+)\.(\w+)\s*=\s*(.+)$')
    _RE_PRINT = re.compile(r'^print\((.+)\)$')
    _RE_ASSERT = re.compile(r'^assert\((.+)\)$')
    _RE_TRIT = re.compile(r'^T\((-?\d+)\)$')
    _RE_TRYTE = re.compile(r'^Tryte\((-?\d+)\)$')
    _RE_BT_LIT = re.compile(r'^bt"([10T]+)"$')
    _RE_INDEX = re.compile(r'^(\w+)\[(.+)\]$')
    _RE_FNCALL = re.compile(r'^(\w+)\(')
    _RE_DOTCALL = re.compile(r'^(\w+)\.(\w+)\((.*)?\)$')
    _RE_DOTATTR = re.compile(r'^(\w+)\.(\w+)$')
    _RE_FN_DEF = re.compile(r'^fn\s+(\w+)\(([^)]*)\)\s*\{?')
    _RE_FOR = re.compile(r'^for\s+(\w+)\s+in\s+')
    _RE_FOR_FULL = re.compile(r'^for\s+(\w+)\s+in\s+(.+?)\s*\{')
    _RE_IMPORT3 = re.compile(r'^import3\s+"([^"]+)"(?:\s*\{([^}]+)\})?(?:\s+as\s+(\w+))?')
    _RE_IMPORT3_BARE = re.compile(r'^import3\s+(\w+)(?:\s+as\s+(\w+))?$')  # import3 math3 [as m]
    _MODULE_SEARCH_PATHS = [
        'C:/NovaX/stdlib',      # Standard library first
        'C:/NovaX/modules',     # User modules
        'C:/NovaX',             # Project root
    ]
    _RE_FOR3 = re.compile(r'^for3\s+(\w+)\s+in\s+')
    _RE_FOR3_FULL = re.compile(r'^for3\s+(\w+)\s+in\s+(.+?)\s*\{')
    _RE_IF3 = re.compile(r'^if3\s+(.+?)\s*\{')
    _RE_IF = re.compile(r'^if\s+(.+?)\s*\{')
    _RE_WHILE3 = re.compile(r'^while3\s+(.+?)\s*\{')
    _RE_WHILE = re.compile(r'^while\s+(.+?)\s*\{')
    _RE_MATCH3 = re.compile(r'^match3\s+(.+?)\s*\{')
    _RE_SWITCH3 = re.compile(r'^switch3\s+(.+?)\s*\{')
    _RE_SWITCH3_CASE = re.compile(r'^case\s+(.+?)\s*=>\s*(.+)')
    _RE_SWITCH3_CASE_BLK = re.compile(r'^case\s+(.+?)\s*\{')
    _RE_SWITCH3_DEFAULT = re.compile(r'^default\s*=>\s*(.+)')
    _RE_SWITCH3_DEFAULT_BLK = re.compile(r'^default\s*\{')
    _RE_ENUM3 = re.compile(r'^enum3\s+([A-Za-z_]\w*)\s*\{')
    _RE_CLASS3 = re.compile(r'^class3\s+([A-Za-z_]\w*)\s*(?:extends\s+([A-Za-z_]\w*)\s*)?\{')
    _RE_TRY3 = re.compile(r'^try3\s*\{')
    _RE_RETURN = re.compile(r'^return\s+(.+)$')
    _RE_EXPR_CALL = re.compile(r'^(\w+)\((.*)?\)$', re.DOTALL)
    _RE_BLOCK_START = re.compile(r'^(fn|if|for|while)\s')
    _RE_MAYBE_BLK = re.compile(r'^\}\s*maybe\s*\{')
    _RE_ELSE_BLK = re.compile(r'^\}\s*(else3?)\s*\{')
    _RE_ELIF_BLK = re.compile(r'^\}\s*else\s+(.+?)\s*\{')
    _RE_UNCERTAIN = re.compile(r'^\}\s*(uncertain|maybe)\s*\{')
    _RE_FAIL = re.compile(r'^\}\s*(fail3|fail|else)\s*\{')
    _RE_SUCCESS = re.compile(r'^\}\s*success\s*\{')
    _RE_DONE3 = re.compile(r'^\}\s*done3\s*\{')
    _RE_MATCH_ARM = re.compile(r'^(TRUE|MAYBE|FALSE|\+1|0|-1)\s*=>\s*(.+)')
    _RE_MATCH_ARM2 = re.compile(r'^(-?1|0|T|_)\s*\{')

    # ── Parsed-line cache (source hash → preprocessed lines) ──
    _line_cache = {}
    _LINE_CACHE_MAX = 128

    # ── AST block map cache (source hash → {line_idx: block_end_idx}) ──
    _block_map_cache = {}
    _BLOCK_MAP_CACHE_MAX = 64

    # ── Loop body dispatch cache (avoids re-classifying lines every iteration) ──
    # Key: (id(lines), start, end) → list of (line_type, stripped_line) per index
    _body_dispatch_cache = {}
    _BODY_DISPATCH_CACHE_MAX = 128
    # ── match3 arm cache (avoids re-parsing arms every iteration in loops) ──
    # Key: (id(lines), start) → (cond_str, block_end, {trit_value: code_string})
    _match3_arm_cache = {}
    # ── switch3 case cache (avoids re-parsing cases every iteration in loops) ──
    # Key: (id(lines), start) → (cond_str, block_end, [(val_expr, code_or_lines, is_block), ...], default_code_or_lines, default_is_block)
    _switch3_case_cache = {}
    # ── async3 futures registry (background tasks) ──
    _async3_futures = {}      # id -> {thread, result, done, error, trit}
    _async3_counter = 0
    _async3_lock = null       # initialized in __init__

    # Line type constants for dispatch table
    _LT_SKIP = 0      # empty, comment, bare }
    _LT_LET = 1       # let/const assignment
    _LT_RETURN = 2    # return statement
    _LT_IF3 = 3       # if3 block
    _LT_MATCH3 = 4    # match3 block
    _LT_TRY3 = 5      # try3 block
    _LT_WHILE3 = 6    # while3 block
    _LT_IF = 7        # binary if block
    _LT_FOR = 8       # for block
    _LT_WHILE = 9     # binary while block
    _LT_FN = 10       # fn definition
    _LT_HIVE = 11     # hive statement
    _LT_TERNARY = 12  # ternary statement
    _LT_FOR3 = 14     # for3 ternary loop
    _LT_BREAK3 = 16   # break3 statement (ternary loop break)
    _LT_CONTINUE3 = 17 # continue3 statement (ternary loop continue)
    _LT_SWITCH3 = 18   # switch3 block (ternary value switch)
    _LT_ENUM3 = 19     # enum3 block (ternary enum type)
    _LT_CLASS3 = 20    # class3 block (ternary class definition)
    _LT_ASYNC3 = 21    # async3 statement (ternary async execution)
    _LT_STMT = 15     # simple statement (fallthrough to _exec_line)

}
    fn __init__() {
        globals = Environment()
        output = []
        # N-S Flow State — every interpreter has its own fluid dynamics
        _flow_state = {
            "reynolds": 0.0,          # Current Reynolds number (complexity measure)
            "viscosity": 1.0,         # Execution smoothing factor (0=turbulent, 1=laminar)
            "pressure": 0.0,          # Backpressure accumulator
            "velocity": [],           # Recent execution times (sliding window)
            "regime": "laminar",      # Current flow regime
            "access_counts": {},      # Variable access frequency tracking
            "total_evals": 0,         # Total _eval calls
            "total_lines": 0,         # Total lines executed
        }
        _setup_builtins()
        # async3 lock for thread-safe futures registry
