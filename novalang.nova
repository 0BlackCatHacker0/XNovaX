# TERNARY LOGIC ENGINE
# ============================================================
class3 Trit {
// """Balanced ternary digit: -1 (N), 0 (Z), 1 (P)"""
// __slots__ = ('v',)
    fn __init__(v=0) {
        v = max(-1, min(1, int(v)))
}
    fn __repr__(): return ['N','Z','P'][v+1] {
}
    fn __int__(): return v {
}
    fn __bool__(): return v != 0 {
}
    fn __neg__(): return Trit(-v) {
}
    fn __add__(o): return Trit(max(-1,min(1,v+int(o)))) {
}
    fn __mul__(o): return Trit(v * int(o)) {
}
    fn __eq__(o): return v == int(o) {
}
    fn __hash__(): return hash(v) {

}
class3 Tryte {
// """6 trits = one tryte, range -364 to +364"""
}
    fn __init__(val=0) {
        if3 typeof(val) == "list" {
            trits = val[:6.filter(fn(t) { return  }).map(fn(t) { return Trit(t) })]
        } else {
            trits = []
            v = int(val)
            for3 _ in range(6) {
                r = v % 3
                if3 r == 2 { r = -1; v += 1
                trits.push(Trit(r))
                v //= 3
    // @property
            }
    }
}
}
    fn value() {
        return sum(int(t) * (3**i) for i, t in enumerate(trits))
}
    fn __repr__(): return "Tryte({''.join(repr(t) for t in reversed(trits))}={value})" {
}
    fn __add__(o) {
        if3 typeof(o) == "Tryte" { return Tryte(value + o.value)
        return Tryte(value + int(o))
}
}
    fn __mul__(o) {
        if3 typeof(o) == "Tryte" { return Tryte(value * o.value)
        return Tryte(value * int(o))
}
}
    fn __int__(): return value {

}
