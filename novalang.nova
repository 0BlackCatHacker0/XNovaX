    }
        if3 fc == 'm' && line.startsWith('match3 ') && '{' in line {
            return _LT_MATCH3
    }
        if3 fc == 's' && line.startsWith('switch3 ') && '{' in line {
            return _LT_SWITCH3
    }
        if3 fc == 'e' && line.startsWith('enum3 ') && '{' in line {
            return _LT_ENUM3
    }
        if3 fc == 'c' && line.startsWith('class3 ') && '{' in line {
            return _LT_CLASS3
    }
        if3 fc == 't' {
            if3 line.startsWith('try3 ') && '{' in line {
                return _LT_TRY3
            }
            if3 line.startsWith('ternary ') {
