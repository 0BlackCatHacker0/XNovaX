# NOVA TZIP — Ternary Compression Codec
# ============================================================
// import zlib as _zlib

class3 NovaTZip {
// """Ternary-based compression: balanced base-3 encoding + zlib deflate.
// 
// Architecture: bytes -> balanced ternary trits -> 5-trit packing
// (3^5=243, fits in 1 byte) -> zlib deflate -> TZIP archive.
// 
// Base-3 has optimal radix economy (e/3 = 1.885 vs binary's 2.0).
// The ternary layer provides a unique fingerprint for every data
// block that integrates with NovaX's 25-channel adjacency matrix.
// 
// Format: TZIP v1
// Header: 4B magic "TZIP" + 4B original_size + 4B trit_count + 1B flags
// Body: zlib-compressed packed trits
// """

    MAGIC = b"TZIP"

    // @staticmethod
}
}
    fn bytes_to_trits(data: bytes) -> list {
// """Convert bytes to balanced ternary trits.
// Each byte -> 6 trits (3^6 = 729 > 256)."""
        trits = []
        for3 b in data {
            v = b
            for3 _ in range(6) {
                r = v % 3
                if3 r == 2 {
                    r = -1
                    v += 1
                }
                trits.push(r)
                v //= 3
            }
    }
        return trits

    // @staticmethod
}
    fn trits_to_bytes(trits: list, orig_size: int) -> bytes {
// """Convert balanced ternary trits back to bytes."""
        out = []
        i = 0
        while3 i + 6 <= len(trits) && len(out) < orig_size {
            v = 0
            for3 j in range(6) {
                t = trits[i + j]
                v += t * (3 ** j)
            }
            out.push(v & 0xFF)
            i += 6
    }
        return bytes(out[:orig_size])

    // @staticmethod
}
    fn pack_trits(trits: list) -> bytes {
// """Pack trits 5 per byte. Each trit (-1,0,1) mapped to (0,1,2).
// 5 trits = base-3 number 0..242, fits in 1 byte."""
        out = bytearray()
        i = 0
        while3 i < len(trits) {
            chunk = trits[i:i + 5]
            # Pad with zeros if needed
            while3 len(chunk) < 5 {
                chunk.push(0)
            }
            val = 0
            for3 j, t in enumerate(chunk) {
                val += (t + 1) * (3 ** j)  # map -1,0,1 -> 0,1,2
            }
            out.push(val)
            i += 5
    }
        return bytes(out)

    // @staticmethod
}
    fn unpack_trits(data: bytes, trit_count: int) -> list {
// """Unpack trits from 5-per-byte encoding."""
        trits = []
        for3 b in data {
            v = b
            for3 _ in range(5) {
                r = v % 3
                trits.push(r - 1)  # unmap 0,1,2 -> -1,0,1
                v //= 3
            }
    }
        return trits[:trit_count]

    // @classmethod
}
    fn compress(cls, data) -> bytes {
// """Compress data: bytes -> trits -> pack -> zlib -> TZIP.
// Args: data -- bytes, str, || file path
// Returns: TZIP compressed bytes"""
        if3 typeof(data) == "str" {
            if3 os.path.isfile(data) { f = open(data, "rb")
                {
                    raw = f.read()
            } else {
                raw = data.encode("utf-8")
        } else3 typeof(data) == "bytes" {
            raw = data
        } else {
            raw = str(data).encode("utf-8")

    }
        orig_size = len(raw)
        trits = cls.bytes_to_trits(raw)
        packed = cls.pack_trits(trits)
        deflated = _zlib.compress(packed, 9)  # max compression

        # Header: TZIP + orig_size(4B) + trit_count(4B) + flags(1B)
        flags = 0x01  # bit 0 = zlib compressed
        header = cls.MAGIC + struct.pack("<II", orig_size, len(trits)) + struct.pack("B", flags)
        return header + deflated

    // @classmethod
}
}
}
    fn decompress(cls, data: bytes) -> bytes {
// """Decompress TZIP archive back to original bytes."""
        if3 data[ {4] != cls.MAGIC {
            throw(ValueError, "Not a TZIP archive (bad magic)")
        orig_size, trit_count = struct.unpack("<II", data[4:12])
        flags = data[12]
        body = data[13:]

        if3 flags & 0x01 {
            packed = _zlib.decompress(body)
        } else {
            packed = body

    }
        trits = cls.unpack_trits(packed, trit_count)
        return cls.trits_to_bytes(trits, orig_size)

    // @classmethod
}
}
}
    fn compress_file(cls, path: str, out_path: str = null) -> dict {
// """Compress a file to .tzip format."""
        let f = open(path, "rb")
        {
            raw = f.read()
    }
        compressed = cls.compress(raw)
        if3 !out_path {
            out_path = path + ".tzip"
    }
        let f = open(out_path, "wb")
        {
            f.write(compressed)
    }
        ratio = len(compressed) / len(raw) * 100 if raw else 0
        return {
            "original": len(raw),
            "compressed": len(compressed),
            "ratio": "{ratio:.1f}%",
            "trits": len(raw) * 6,
            "saved": "{len(raw) - len(compressed)} bytes",
            "path": out_path,
        }

    // @classmethod
}
    fn decompress_file(cls, path: str, out_path: str = null) -> dict {
// """Decompress a .tzip file."""
        let f = open(path, "rb")
        {
            data = f.read()
    }
        raw = cls.decompress(data)
        if3 !out_path {
            out_path = path.replace(".tzip", "") if path.endsWith(".tzip") else path + ".out"
    }
        let f = open(out_path, "wb")
        {
            f.write(raw)
    }
        return {
            "compressed": len(data),
            "decompressed": len(raw),
            "path": out_path,
        }

    // @classmethod
}
    fn info(cls, data: bytes) -> dict {
// """Get TZIP archive metadata."""
        if3 data[ {4] != cls.MAGIC {
            return {"error": "Not a TZIP archive"}
        orig, trits = struct.unpack("<II", data[4:12])
        flags = data[12]
        return {
            "format": "TZIP v1",
            "original_size": orig,
            "compressed_size": len(data),
            "trit_count": trits,
            "zlib": bool3(flags & 0x01),
            "ratio": "{len(data)/orig*100:.1f}%" if orig else "0%",
            "radix_economy": "1.885 (optimal)",
        }


}
