let PORT = 9999
let server = tserve(PORT, "Nova MCP")

// ── Constants ──
let ORCHESTRATOR = "http://127.0.0.1:9999"
let HIVEMIND = "http://127.0.0.1:9881"
let TOOLS_PORT = "http://127.0.0.1:9891"
let TTOOLS_PORT = "http://127.0.0.1:9894"
let DEEP_PORT = "http://127.0.0.1:9893"
let VAULT_PORT = "http://127.0.0.1:9892"
let CORTEX_PORT = "http://127.0.0.1:9896"
let CLOUD_PORT = "http://127.0.0.1:9878"
let TBUFFER_PORT = "http://127.0.0.1:9886"
let MCP_VERSION = "2024-11-05"

fn handle_health(req) {
    let uptime = now() - _start_time
    return {
        "ok": 1,
        "trit": 1,
        "service": "Nova MCP",
        "port": 9999,
        "uptime": uptime
    }
}

// ── Routes ──
troute(server, "GET", "/health", "handle_health")

print("[Nova MCP] Starting on port " + str(PORT))
tstart(server)