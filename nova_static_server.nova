// NovaX Static File Server — Pure NovaLang, ZERO Python
// Serves C:\NovaX\web\ on port 8888

let PORT = 8888
let WEB_DIR = "C:/NovaX/web/"

fn handle_file(req) {
    let path = dict_get(req, "path") ?? "/"
    if3 path == "/" { path = "/nova_desktop.html" }

    // Security: no directory traversal
    if3 contains(path, "..") == 1 { return "404 Not Found" }

    let file_path = WEB_DIR + slice(path, 1, len(path))
    let content = try3 { read_file(file_path) } fail { "" }

    if3 len(content) == 0 { return "{\"error\":\"not found\",\"path\":\"" + path + "\"}" }
    return content
}

let server = tserve(PORT, "nova-static")
troute(server, "GET", "/*", "handle_file")

print("[NovaX Static] Serving C:/NovaX/web/ on port " + str(PORT))
print("[NovaX Static] Pure NovaLang — ZERO Python")

tstart(server)
