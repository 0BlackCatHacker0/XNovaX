// Cpu Monitor v1.0 - HTTP Monitor Service (NovaLang)
// Port 9940: Monitor CPU temperature and alert when above 80C
// Generated by NovaX Service Creator
//
// N-S Mapping:
//   monitor_flow   = velocity_field (data flowing through check cycles)
//   error_pressure = turbulent_energy (check failures)
//
// 3-5-7-13 Harmonic Design:
//   H3=3  -- ternary states, retry count
//   H5=5  -- check interval base
//   H7=7  -- tools count
//   H13=13 -- carrier frame

import3("C:/NovaX/lib/nova_ns_core.nova")
import3("C:/NovaX/lib/nova_stdlib.nova")

let PORT = 9940
let server = tserve(PORT, "cpu-monitor v1.0")

let H3 = 3
let H5 = 5
let H7 = 7
let H13 = 13

let T_TRUE = 1
let T_MAYBE = 0
let T_FALSE = -1

let BLOCK_SIZE = 2187
let RE_LAMINAR = 27
let RE_TRANSITION = 125
let RE_TURBULENT = 343

let VERSION = "1.0.0"
let SERVICE_NAME = "cpu-monitor"

let stat_checks = 0
let stat_ok = 0
let stat_fail = 0
let stat_t0 = time()

\ Health endpoint
fn handle_health(req) {
    let up = time() - stat_t0
    let r = {"status": "ok", "trit": 1, "service": SERVICE_NAME}
    let r = dict_set(r, "version", VERSION)
    let r = dict_set(r, "port", PORT)
    let r = dict_set(r, "uptime", up)
    let r = dict_set(r, "checks", stat_checks)
    return r
}

\ Service status endpoint
fn handle_status(req) {
    let up = time() - stat_t0
    let r = {"status": "ok", "trit": 1, "service": SERVICE_NAME}
    let r = dict_set(r, "version", VERSION)
    let r = dict_set(r, "checks", stat_checks)
    let r = dict_set(r, "ok_count", stat_ok)
    let r = dict_set(r, "fail_count", stat_fail)
    let r = dict_set(r, "uptime", up)
    return r
}



\ Routes
troute(server, "GET", "/health", "handle_health")
troute(server, "GET", "/cpu-monitor/service-status", "handle_status")


\ Start server
tstart(server)
