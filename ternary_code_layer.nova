# ── Statement → Channel Classification ─────────────────────────────────

# Pattern map: maps statement text to FLOW_CHANNEL affinities
# Mirrors _CHANNEL_KEYWORDS from nova_hivemind.py but adds code-level patterns
let _STMT_PATTERNS = {
    "REASON": [
        r'\bif\b', r'\belse\b', r'\band\b', r'\bor\b', r'\bnot\b',
        r'\breason\b', r'\blogic\b', r'\banalyze\b', r'\binfer\b',
        r'==', r'!=', r'>=', r'<=', r'\?',
    ],
    "MATH": [
        r'\bmath\b', r'\bsqrt\b', r'\breynolds\b', r'\bsoroban\b',
        r'\bdivergence\b', r'\blaplacian\b', r'\babs\b',
        r'\+', r'\-', r'\*\*', r'\*', r'/', r'%',
        r'\bint\(', r'\bfloat\(',
        r'\d+\.\d+',  # float literals
    ],
    "CODE": [
        r'^fn\s', r'\bdef\b', r'\bclass\b', r'\bimport\b', r'\breturn\b',
        r'\bcompile\b', r'\bexec\b', r'\bsyntax\b', r'\balgorithm\b',
        r'\bfunction\b', r'\bmodule\b',
    ],
    "INSTRUCT": [
        r'\bprint\b', r'\bformat\b', r'\btemplate\b', r'\bsteps\b',
        r'\bguide\b', r'\blist\b', r'\bfor\b.*\bin\b',
    ],
    "FACT": [
        r'\btrue\b', r'\bfalse\b', r'\bnull\b', r'\btype\b',
        r'\blen\b', r'\bkeys\b', r'\bvalues\b',
    ],
    "LONG": [
// r'"""', r"'''", r'\bfile\b', r'\bread\b', r'\bwrite\b',
// r'\bdocument\b', r'\bpassage\b',
// ],
// "VISION": [
// r'\bimage\b', r'\bpicture\b', r'\bphoto\b', r'\bchart\b',
