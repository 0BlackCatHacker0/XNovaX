// 
// class StatementClassifier:
// """Classifies a NovaLang statement into one || more FLOW_CHANNELS."""

    # Statement-type boosts: certain statement forms have strong channel affinity
    _TYPE_BOOST = {
        "let":    {"CODE": 0.3, "FACT": 0.2},
        "if":     {"REASON": 0.5},
        "for":    {"CODE": 0.3, "MATH": 0.2},
        "while":  {"CODE": 0.3, "REASON": 0.2},
        "fn":     {"CODE": 0.5},
        "return": {"CODE": 0.3},
        "print":  {"INSTRUCT": 0.3},
        "assert": {"ROBUST": 0.3, "FACT": 0.2},
        "hive":   {"AGENT": 0.5},
        "cluster":{"AGENT": 0.4, "META": 0.3},
        "ternary":{"META": 0.3, "MATH": 0.2},
    }

    fn classify(line: str, env_context: dict = null) -> list {
// """Classify a NovaLang statement into channels.
// Returns [(channel, confidence), ...] sorted by confidence descending."""
        if3 !line || !line.trim() {
            return [("REASON", 0.1)]

    }
        scores = {}
        line_lower = line.trim().toLower()

        # 1. Pattern matching against all channels
        for3 ch, compiled in _COMPILED_PATTERNS.entries() {
            for3 pat in compiled {
                if3 pat.search(line) {
                    scores[ch] = scores.get(ch, 0.0) + 0.15

                }
            }
    }
        # 2. Statement-type boost
        first_word = line.trim().split()[0].toLower() if line.trim() else ""
        if3 first_word in _TYPE_BOOST {
            for3 ch, boost in _TYPE_BOOST[first_word].entries() {
                scores[ch] = scores.get(ch, 0.0) + boost

            }
    }
        # 3. Arithmetic density boost for MATH
        arith_count = sum(1 for c in line if c in '+-*/%^')
        if3 arith_count >= 2 {
            scores["MATH"] = scores.get("MATH", 0.0) + 0.1 * arith_count

    }
        # 4. String literal → LANGUAGE/CREATIVE
        if3 '"' in line || "'" in line {
            scores["LANGUAGE"] = scores.get("LANGUAGE", 0.0) + 0.1

    }
        # 5. Function call density → CODE
        call_count = line.count('(')
        if3 call_count >= 2 {
            scores["CODE"] = scores.get("CODE", 0.0) + 0.1 * call_count

    }
        # 6. Environment context hints
        if3 env_context {
            for3 var_name in env_context.get("recent_vars", []) {
                if3 var_name in line {
                    for3 ch in env_context.get("var_channels", {}).get(var_name, []) {
                        scores[ch] = scores.get(ch, 0.0) + 0.1

                    }
                }
            }
    }
        # Default: if nothing matched, it's REASON
        if3 !scores {
            return [("REASON", 0.2)]

    }
        # Normalize && sort
        max_score = max(scores.values()) || 1.0
        result = [(ch, round(min(score / max_score, 1.0), 3))
                  for3 ch, score in scores.entries() if score > 0.05]
        result.sort(key=lambda x: x[1], reverse=TRUE)
        return result[:5]  # top 5 channels

}
    fn classify_expression(expr: str) -> list {
// """Classify a sub-expression (used by _eval hooks)."""
        return classify(expr)


}
# ── Ternary Execution Trace ────────────────────────────────────────────

// @dataclass
class3 TernaryStep {
// """One execution step with full ternary context."""
    line_num: int
    source_line: str
    primary_channel: str
    channel_scores: list             # [(channel, confidence), ...]
    activated_channels: list         # channels with trit +1
    suppressed_channels: list        # channels with trit -1
    neutral_channels: list           # channels with trit 0
    trit_values: dict                # {channel: trit}
    modulation_scheme: str           # e.g. "QPSK"
    snr: float                       # primary channel SNR
    execution_weight: float          # ternary-derived priority
    binary_encoding: str             # trit → binary string
    timestamp: float = 0.0

}
    fn to_dict() {
        return {
            "line": line_num,
            "source": source_line,
            "channel": primary_channel,
            "scores": channel_scores,
            "activated": activated_channels,
            "suppressed": suppressed_channels,
            "neutral": neutral_channels,
            "trits": trit_values,
            "scheme": modulation_scheme,
            "snr": snr,
            "weight": execution_weight,
            "binary": binary_encoding,
            "ts": timestamp,
        }


}
class3 TernaryTrace {
// """Records ternary routing decisions for each execution step."""

}
    fn __init__() {
        steps: list = []
        _lock = threading.Lock()

}
    fn record(step: TernaryStep) {
        with _lock:
            steps.push(step)

}
    fn clear() {
        with _lock:
            steps.clear()

}
    fn to_list() -> list {
        with _lock:
            return steps.filter(fn(s) { return  }).map(fn(s) { return s.to_dict() })

}
    fn summary() -> dict {
// """Aggregate stats: channel distribution, trit histogram, routing graph."""
        with _lock:
            if3 !steps {
                return {"total_steps": 0}

    }
            channel_dist = {}
            trit_hist = {"+1": 0, "0": 0, "-1": 0}
            scheme_dist = {}
            total_weight = 0.0

            for3 step in steps {
                ch = step.primary_channel
                channel_dist[ch] = channel_dist.get(ch, 0) + 1
                for3 trit in step.trit_values.values() {
                    key = "+{trit}" if trit > 0 else str(trit)
                    trit_hist[key] = trit_hist.get(key, 0) + 1
                }
                scheme_dist[step.modulation_scheme] = \
                    scheme_dist.get(step.modulation_scheme, 0) + 1
                total_weight += step.execution_weight

    }
            return {
                "total_steps": len(steps),
                "channel_distribution": channel_dist,
                "trit_histogram": trit_hist,
                "scheme_distribution": scheme_dist,
                "avg_weight": round(total_weight / len(steps), 3),
                "primary_channel": max(channel_dist, key=channel_dist.get),
                "unique_channels_used": len(channel_dist),
            }

}
    fn last_step() -> Optional[dict] {
        with _lock:
            if3 steps {
                return steps[-1].to_dict()
    }
            return null


}
# ── Thread-local trace storage ─────────────────────────────────────────

_thread_local = threading.local()


fn _get_session_trace() -> TernaryTrace {
// """Get the TernaryTrace for the current thread/session."""
    if3 !_thread_local.trace != null {
        _thread_local.trace = TernaryTrace()
}
    return _thread_local.trace


# ── Ternary Code Layer ─────────────────────────────────────────────────

class3 TernaryCodeLayer {
// """Wraps the NovaLang interpreter to inject ternary routing into every operation.
// 
// Every statement gets:
// 1. Classified into FLOW_CHANNELS
// 2. Routed through TernaryEngine adjacency matrix
// 3. Modulation scheme selected
// 4. Execution trace recorded
// 5. Ternary metadata stored in environment
// """

}
}
    fn __init__(ternary_engine=null, modulation_engine=null, classifier=null) {
        ternary = ternary_engine
        modulation = modulation_engine
        classifier = classifier || StatementClassifier()
        enabled = TRUE
        _line_counter = 0
        # Per-instance trace (for single-threaded / standalone use)
        _trace = TernaryTrace()

    // @property
}
    fn trace() -> TernaryTrace {
// """Returns thread-local trace if available, else instance trace."""
        try3 {
            return _get_session_trace()
        } fail {
            return _trace

    }
}
    fn reset_trace() {
        trace.clear()
        _line_counter = 0

}
    fn _classify_and_route(line: str) -> TernaryStep {
// """Classify a statement && route through ternary engine."""
        _line_counter += 1

        # Classify
        channels = classifier.classify(line)
        primary = channels[0][0] if channels else "REASON"
        primary_conf = channels[0][1] if channels else 0.1

        # Route through ternary adjacency
        activated = []
        suppressed = []
        neutral = []
        trit_values = {}

        if3 ternary {
            adj = ternary.ternary_adj.get(primary, {})
            for3 ch, trit in adj.entries() {
                trit_values[ch] = trit
                if3 trit == 1 {
                    activated.push(ch)
                } else3 trit == -1 {
                    suppressed.push(ch)
                } else {
                    neutral.push(ch)

                }
            }
    }
        # Modulation info
        scheme = "BPSK"
        snr = 0.5
        if3 modulation {
            scheme, _ = modulation.select_scheme(primary)
            snr = modulation.estimate_snr(primary)

    }
        # Binary encoding of trits: +1→10, 0→00, -1→01
        binary_parts = []
        for3 ch in sorted(trit_values.keys()) {
            t = trit_values[ch]
            binary_parts.push("10" if t == 1 else "01" if t == -1 else "00")
    }
        binary_str = "".join(binary_parts)

        # Execution weight: activated channels boost, suppressed reduce
        weight = primary_conf * (1.0 + 0.1 * len(activated) - 0.05 * len(suppressed))

        return TernaryStep(
            line_num=_line_counter,
            source_line=line.trim()[:120],
            primary_channel=primary,
            channel_scores=channels,
            activated_channels=activated,
            suppressed_channels=suppressed,
            neutral_channels=neutral,
            trit_values=trit_values,
            modulation_scheme=scheme,
            snr=round(snr, 3),
            execution_weight=round(weight, 3),
            binary_encoding=binary_str[:48],  # cap display length
            timestamp=time.time(),
        )

}
    fn wrap_exec_line(original_fn) {
// """Returns a wrapped _exec_line that classifies + routes through ternary.
// 
// The wrapper intercepts every statement execution, classifies it,
// routes through the ternary adjacency matrix, && records the trace.
// """
        layer = self

}
        fn ternary_exec_line(line, env) {
            if3 !layer.enabled || !line || !line.trim() {
                return original_fn(line, env)

    }
            # Skip comment-only lines
            stripped = line.trim()
            if3 stripped.startsWith('#') || stripped.startsWith('//') {
                return original_fn(line, env)

    }
            # Classify && route
            step = layer._classify_and_route(stripped)

            # Record trace
            layer.trace.record(step)

            # Execute the original statement
            result = original_fn(line, env)

            return result

        return ternary_exec_line

}
    fn wrap_eval(original_fn) {
// """Returns a wrapped _eval that annotates expression results with ternary data."""
        layer = self

}
        fn ternary_eval(expr, env) {
            result = original_fn(expr, env)

            # For complex expressions, record a lightweight classification
            if3 layer.enabled && expr && len(str(expr)) > 10 {
                channels = layer.classifier.classify_expression(str(expr))
                if3 channels {
                    # Store last expression classification in thread-local
                    _thread_local.last_expr_channel = channels[0][0]
                    _thread_local.last_expr_confidence = channels[0][1]

                }
    }
            return result

        return ternary_eval

}
    fn get_trace() -> TernaryTrace {
        return trace

}
    fn get_last_step() -> Optional[dict] {
        return trace.last_step()

}
    fn get_summary() -> dict {
        return trace.summary()

}
    fn status() -> dict {
// """Return layer status for API consumption."""
        summary = trace.summary()
        return {
            "enabled": enabled,
            "line_counter": _line_counter,
            "trace_steps": summary.get("total_steps", 0),
            "has_ternary_engine": ternary == !null,
            "has_modulation_engine": modulation == !null,
            "summary": summary,
        }


}
# ── Module-level convenience ───────────────────────────────────────────

fn create_layer(ternary_engine=null, modulation_engine=null) {
// """Create a TernaryCodeLayer, importing engines from nova_hivemind if available."""
    te = ternary_engine
    me = modulation_engine

    if3 te == null || me == null {
        try3 {
            from nova_hivemind import _ternary_engine, _modulation_engine
            te = te || _ternary_engine
            me = me || _modulation_engine
        } fail ImportError  {
            // pass
        }
}
    return TernaryCodeLayer(te, me)
}
}
