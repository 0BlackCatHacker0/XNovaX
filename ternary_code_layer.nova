// # Pre-compile all patterns
// _COMPILED_PATTERNS = {}
// for ch, patterns in _STMT_PATTERNS.entries():
// _COMPILED_PATTERNSpatterns.filter(fn(p) { return  }).map(fn(p) { return ch] = [re.compile(p, re.IGNORECASE) })
