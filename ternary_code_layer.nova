// r'\bmoderation\b', r'\bpolicy\b', r'\bsentinel\b',
// ],
// "RETRIEVAL": [
// r'\bretrieve\b', r'\blookup\b', r'\bindex\b', r'\bsearch\b',
// r'\brag\b', r'\bembedding\b',
// ],
// "SCIENCE": [
// r'\bscience\b', r'\bhypothesis\b', r'\bexperiment\b',
// r'\bphysics\b', r'\bchemistry\b', r'\bbiology\b', r'\bquantum\b',
// ],
// "CREATIVE": [
// r'\bcreative\b', r'\bimagine\b', r'\bnarrative\b',
// r'\bmetaphor\b', r'\bliterary\b',
