// GET /health
fn handle_health() {
    let uptime = round(time() - _t0, 0)

    let resp = ns_health_dict(SERVICE, VERSION, PORT, {})
    resp = dict_set(resp, "tools", ["read", "write", "grep", "glob", "run", "edit", "pipe"])
    resp = dict_set(resp, "self_trit", dict_get(resp, "trit") ?? 0)
    resp = dict_set(resp, "char", trit_char(dict_get(resp, "trit") ?? 0))
    resp = dict_set(resp, "flow_regime", dict_get(resp, "regime") ?? "laminar")
    resp = dict_set(resp, "uptime", int(uptime))
    resp = dict_set(resp, "total_ops", _ops_total)
    resp = dict_set(resp, "quality", {
        "strong": _ops_success,
        "partial": _ops_maybe,
        "failed": _ops_fail
    })
    resp = dict_set(resp, "tzip", {"enabled": _tzip_enabled, "files_quantized": _tzip_quantized, "bytes_saved": _tzip_bytes_saved})
    return resp
}

// GET /tools/status
fn handle_tools_status() {
    let uptime = round(time() - _t0, 0)
    let avg_lat = 0
    if3 _ops_total > 0 {
        let avg_lat = round(_total_time_ms / _ops_total, 2)
    }
    let recent = _recent_ops
    if3 len(recent) > 10 {
        let recent = slice(recent, len(recent) - 10, len(recent))
    }

    return {
        "uptime_s": int(uptime),
        "total_ops": _ops_total,
        "calls_by_tool": _calls_by_tool,
        "bytes_read": _bytes_read,
        "bytes_written": _bytes_written,
        "bytes_compressed": _bytes_compressed,
        "bytes_saved": _bytes_saved,
        "avg_latency_ms": avg_lat,
        "errors": _errors,
        "pipe_chains": _pipe_chains,
        "channel_distribution": _channel_hits,
        "recent": recent,
        "prediction": predict_next_tool(),
        "tool_chain_depth": len(_tool_history)
    }
}

// GET /tools/predict
fn handle_tools_predict() {
    let recent = _tool_history
    if3 len(recent) > 10 {
        let recent = slice(recent, len(recent) - 10, len(recent))
    }
    return {
        "ok": true,
        "prediction": predict_next_tool(),
        "history": recent
    }
}

// GET /multi/modes
fn handle_multi_modes() {
    // Count total modes (exclude 'default' from each tool)
    let tool_keys = keys(MULTI_MODES)
    let mode_count = 0
    let ti = 0
    while3 ti < len(tool_keys) {
        let tk = tool_keys[ti]
        let modes = dict_get(MULTI_MODES, tk) ?? {}
        let mk = keys(modes)
        mode_count = mode_count + len(mk) - 1
        ti = ti + 1
    }

    return {
        "ok": true, "modes": MULTI_MODES,
        "tools": tool_keys,
        "total_modes": mode_count,
        "harmonics": {"H3": H3, "H5": H5, "H7": H7, "H13": H13}
    }
}

