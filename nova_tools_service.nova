// GET /tzip/stats -- compression metrics
fn handle_tzip_stats() {
    return tzip_stats()
}

// POST /tzip/toggle -- enable/disable TZip, or set per-path
fn handle_tzip_toggle(body) {
    let enabled = dict_get(body, "enabled") ?? "toggle"
    if3 enabled == "toggle" {
        // Toggle current state
        if3 _tzip_enabled == true {
            _tzip_enabled = false
        } else3 { _tzip_enabled = true
    } else3 {
        if3 enabled == true {
            _tzip_enabled = true
        } else3 { _tzip_enabled = false
        }
    }
    return {"ok": true, "tzip_enabled": _tzip_enabled}
}

// POST /tzip/status -- check shadow status for a specific path
}
fn handle_tzip_path_status(body) {
    let path = dict_get(body, "path") ?? ""
    if3 len(path) == 0 {
        return {"ok": false, "error": "missing 'path'"}
    }
    let info = tzip_check_status(path)
    return {"ok": true, "path": path, "tzip": info}
}

