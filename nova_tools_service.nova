// grep/analyze: Grep + frequency analysis, hotspot detection
fn multi_grep_analyze(args) {
    let t0 = time()
    let pattern_str = dict_get(args, "pattern") ?? ""
    let path_val = dict_get(args, "path") ?? NOVAX_ROOT
    let glob_filter = dict_get(args, "glob") ?? "*.py"
    let top_n = dict_get(args, "top_n") ?? H7

    if3 len(pattern_str) == 0 {
        return {"ok": false, "error": "missing 'pattern'", "trit": T_FALSE}
    }

    // Delegate analysis to python
    let esc_pat = replace(replace(pattern_str, "\\", "\\\\"), "'", "\\'")
    // Use forward slashes for paths -- Python handles them on Windows
    // Avoids NovaLang string parser crash with nested backslash escapes
    let esc_path = replace(path_val, "\\", "/")
    let esc_glob = replace(glob_filter, "\\", "/")

    // Pure NovaLang grep analyze via tgrep micro-tool
    let analyze_cmd = "C:/NovaX/novalang.exe C:/NovaX/tools/tgrep.nova search \"" + esc_path + "\" \"" + esc_pat + "\" \"" + esc_glob + "\" " + str(top_n) + " true"
    let raw = nova_run(analyze_cmd)
    let grep_r = try3 { json_decode(trim(raw)) } fail { {} }
    let matches_a = dict_get(grep_r, "matches") ?? []
    let total_m = 0
    let ai = 0
    while3 ai < len(matches_a) {
        total_m = total_m + (dict_get(matches_a[ai], "hits") ?? 0)
        ai = ai + 1
    }
    let result = {}
    result = dict_set(result, "total", total_m)
    result = dict_set(result, "files_with", len(matches_a))
    result = dict_set(result, "files_searched", 0)
    result = dict_set(result, "hotspots", matches_a)
    result = dict_set(result, "top_patterns", [])
    result = dict_set(result, "avg_density", 0)
    let total_matches = dict_get(result, "total") ?? 0
    let elapsed = round((time() - t0) * 1000, 2)

    let atrit = T_MAYBE
    if3 total_matches > 0 {
        let atrit = T_TRUE
    }

    return {
        "ok": true, "pattern": pattern_str,
        "analysis": result,
        "ms": elapsed, "trit": atrit
    }
}

// grep/replace: Find and replace across files
fn multi_grep_replace(args) {
    let pattern_str = dict_get(args, "pattern") ?? ""
    let replacement = dict_get(args, "replacement") ?? (dict_get(args, "new_string") ?? "")
    let path_val = dict_get(args, "path") ?? NOVAX_ROOT
    let glob_filter = dict_get(args, "glob") ?? "*.py"
    let dry_run = dict_get(args, "dry_run") ?? true

    if3 len(pattern_str) == 0 {
        return {"ok": false, "error": "missing 'pattern'", "trit": T_FALSE}
    }

    let esc_pat = replace(replace(pattern_str, "\\", "\\\\"), "'", "\\'")
    let esc_rep = replace(replace(str(replacement), "\\", "\\\\"), "'", "\\'")
    let esc_path = replace(path_val, "\\", "/")
    let esc_glob = replace(glob_filter, "\\", "\\\\")
    let dr_str = "True"
    if3 dry_run == false {
        let dr_str = "False"
    }

    // Pure NovaLang grep-replace: find files, then replace in each
    let find_cmd2 = "dir /s /b \"" + replace(esc_path, "/", "\\") + "\\" + esc_glob + "\" 2>NUL"
    let find_r2 = shell(find_cmd2)
    let find_out2 = try3 { dict_get(find_r2, "stdout") } fail { "" }
    let find_lines2 = split(find_out2, "\n")
    let af = []
    let tr = 0
    for3 fline in find_lines2 {
        let fpath = trim(fline)
        if3 len(fpath) > 2 {
            if3 contains(fpath, ".git\\") == false {
                let fc = try3 { read_file(fpath) } fail { "" }
                if3 contains(fc, pattern_str) {
                    let nc = replace(fc, pattern_str, str(replacement))
                    let cnt = 0
                    // Count replacements
                    let tmp2 = fc
                    while3 contains(tmp2, pattern_str) {
                        cnt = cnt + 1
                        let ti = 0
                        let tfound = -1
                        while3 ti < len(tmp2) - len(pattern_str) + 1 {
                            if3 slice(tmp2, ti, ti + len(pattern_str)) == pattern_str {
                                tfound = ti
                                ti = len(tmp2)
                            }
                            ti = ti + 1
                        }
                        if3 tfound >= 0 {
                            tmp2 = slice(tmp2, tfound + len(pattern_str), len(tmp2))
                        } else3 { tmp2 = "" }
                    }
                    if3 cnt > 0 {
                        if3 dry_run == false { nova_write(fpath, nc) }
                        let ae = {}
                        ae = dict_set(ae, "path", replace(fpath, "\\", "/"))
                        ae = dict_set(ae, "replacements", cnt)
                        af = append(af, ae)
                        tr = tr + cnt
                    }
                }
            }
        }
    }
    let result = {}
    result = dict_set(result, "affected", af)
    result = dict_set(result, "total", tr)
    result = dict_set(result, "files", len(af))
    result = dict_set(result, "dry_run", dry_run)
    let total_rep = dict_get(result, "total") ?? 0

    let rtrit = T_MAYBE
    if3 total_rep > 0 {
        let rtrit = T_TRUE
    }

    return {
        "ok": true, "pattern": pattern_str, "replacement": str(replacement),
        "dry_run": dry_run,
        "affected_files": dict_get(result, "affected") ?? [],
        "total_replacements": total_rep,
        "files_affected": dict_get(result, "files") ?? 0,
        "trit": rtrit
    }
}

// grep/todo: Search for TODO/FIXME/HACK/XXX patterns, scored by urgency
fn multi_grep_todo(args) {
    let t0 = time()
    let path_val = dict_get(args, "path") ?? NOVAX_ROOT
    let glob_filter = dict_get(args, "glob") ?? "*.py"

    let esc_path = replace(path_val, "\\", "/")
    let esc_glob = replace(glob_filter, "\\", "\\\\")

    // Pure NovaLang: use tgrep.nova todo micro-tool (zero Python)
    let todo_cmd = "C:/NovaX/novalang.exe C:/NovaX/tools/tgrep.nova todo \"" + esc_path + "\" \"" + esc_glob + "\" 100"
    let raw = nova_run(todo_cmd)
    let tgrep_result = json_decode(trim(raw))
    let raw_todos = dict_get(tgrep_result, "todos") ?? []

    // Build by_tag counts and total urgency from raw results
    let by_tag = {}
    let total_urg = 0
    for3 td in raw_todos {
        let tg = dict_get(td, "tag") ?? "NOTE"
        let sc = dict_get(td, "score") ?? 0
        total_urg = total_urg + sc
        let prev = try3 { dict_get(by_tag, tg) } fail { 0 }
        by_tag = dict_set(by_tag, tg, prev + 1)
    }

    let result = {}
    result = dict_set(result, "todos", raw_todos)
    result = dict_set(result, "total", dict_get(tgrep_result, "count") ?? len(raw_todos))
    result = dict_set(result, "by_tag", by_tag)
    result = dict_set(result, "urgency", total_urg)
    result = dict_set(result, "files_scanned", 0)
    let total_urgency = dict_get(result, "urgency") ?? 0
    let elapsed = round((time() - t0) * 1000, 2)

    // Trit: +1=clean, 0=some debt, -1=heavy debt (urgency > H13*H7=91)
    let ttrit = T_TRUE
    if3 total_urgency > 0 {
        let ttrit = T_MAYBE
    }
    if3 total_urgency >= 91 {
        let ttrit = T_FALSE
    }

    return {
        "ok": true, "path": path_val,
        "todos": dict_get(result, "todos") ?? [],
        "summary": {
            "total": dict_get(result, "total") ?? 0,
            "by_tag": dict_get(result, "by_tag") ?? {},
            "total_urgency_score": total_urgency,
            "files_scanned": dict_get(result, "files_scanned") ?? 0,
            "debt_trit": ttrit,
            "debt_char": trit_char(ttrit)
        },
        "ms": elapsed, "trit": ttrit
    }
}

