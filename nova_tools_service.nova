// glob/tree: Build directory tree structure
fn multi_glob_tree(args) {
    let path_val = dict_get(args, "path") ?? NOVAX_ROOT
    let max_depth = dict_get(args, "max_depth") ?? H7
    let show_files = dict_get(args, "show_files") ?? true

    let esc_path = replace(path_val, "\\", "/")
    let sf_str = "True"
    if3 show_files == false {
        let sf_str = "False"
    }

    // Pure NovaLang tree via micro-tool
    let tree_cmd = "C:/NovaX/novalang.exe C:/NovaX/tools/tfileops.nova tree \"" + esc_path + "\" " + str(max_depth) + " " + sf_str
    let raw = nova_run(tree_cmd)
    let result = try3 { json_decode(trim(raw)) } fail { {} }

    return {
        "ok": true, "path": path_val,
        "tree": dict_get(result, "tree") ?? "",
        "summary": {
            "directories": dict_get(result, "dirs") ?? 0,
            "files": dict_get(result, "files") ?? 0,
            "depth": max_depth
        },
        "trit": T_TRUE
    }
}

// glob/size: Find files by pattern, sort by size
fn multi_glob_size(args) {
    let pattern = dict_get(args, "pattern") ?? "**/*"
    let path_val = dict_get(args, "path") ?? NOVAX_ROOT
    let top_n = dict_get(args, "top_n") ?? H13

    let esc_pat = replace(pattern, "\\", "\\\\")
    let esc_path = replace(path_val, "\\", "/")

    // Pure NovaLang glob_size via forfiles
    let fp = pattern
    if3 starts_with(pattern, "/") == false {
        if3 starts_with(pattern, "C:") == false {
            fp = esc_path + "/" + pattern
        }
    }
    let sz_cmd = "forfiles /p \"" + replace(fp, "/", "\\") + "\" /s /c \"cmd /c echo @path:::@fsize\" 2>NUL"
    let sz_r = shell(sz_cmd)
    let sz_out = try3 { dict_get(sz_r, "stdout") } fail { "" }
    let sz_lines = split(sz_out, "\n")
    let fz = []
    let ts = 0
    for3 szl in sz_lines {
        let szl2 = trim(szl)
        if3 len(szl2) > 3 {
            let szp = split(szl2, ":::")
            if3 len(szp) >= 2 {
                let szfp = replace(trim(replace(szp[0], "\"", "")), "\\", "/")
                let szv = try3 { to_int(trim(szp[1])) } fail { 0 }
                let sze = {}
                sze = dict_set(sze, "path", szfp)
                sze = dict_set(sze, "size", szv)
                fz = append(fz, sze)
                ts = ts + szv
            }
        }
    }
    let result = {}
    result = dict_set(result, "files", fz)
    result = dict_set(result, "total_files", len(fz))
    result = dict_set(result, "total_size", ts)
    let total_size = dict_get(result, "total_size") ?? 0
    let total_files = dict_get(result, "total_files") ?? 0
    let files_list = dict_get(result, "files") ?? []

    // Add human-readable sizes
    let si = 0
    while3 si < len(files_list) {
        let sz = dict_get(files_list[si], "size") ?? 0
        let updated = dict_set(files_list[si], "human", human_size(sz))
        files_list = list_set(files_list, si, updated)
        si = si + 1
    }

    let strit = T_MAYBE
    if3 len(files_list) > 0 {
        let strit = T_TRUE
    }

    return {
        "ok": true, "pattern": pattern,
        "files": files_list,
        "total_files": total_files,
        "total_size": total_size,
        "total_human": human_size(total_size),
        "avg_size": round(total_size / max(total_files, 1), 0),
        "trit": strit
    }
}

// glob/recent: Find files sorted by modification time
fn multi_glob_recent(args) {
    let pattern = dict_get(args, "pattern") ?? "**/*.py"
    let path_val = dict_get(args, "path") ?? NOVAX_ROOT
    let top_n = dict_get(args, "top_n") ?? H13

    let esc_pat = replace(pattern, "\\", "\\\\")
    let esc_path = replace(path_val, "\\", "/")

    // Pure NovaLang glob_recent via dir /o-d (sorted by date descending)
    let fp = pattern
    if3 starts_with(pattern, "/") == false {
        if3 starts_with(pattern, "C:") == false {
            fp = esc_path + "/" + pattern
        }
    }
    let rec_cmd = "dir /s /b /o-d \"" + replace(fp, "/", "\\") + "\" 2>NUL"
    let rec_r = shell(rec_cmd)
    let rec_out = try3 { dict_get(rec_r, "stdout") } fail { "" }
    let rec_lines = split(rec_out, "\n")
    let ft = []
    for3 rl in rec_lines {
        let rf = trim(rl)
        if3 len(rf) > 2 {
            if3 len(ft) < top_n {
                let re = {}
                re = dict_set(re, "path", replace(rf, "\\", "/"))
                re = dict_set(re, "modified", 0)
                re = dict_set(re, "age_seconds", 0)
                re = dict_set(re, "size", 0)
                ft = append(ft, re)
            }
        }
    }
    let result = {}
    result = dict_set(result, "files", ft)
    result = dict_set(result, "total_files", len(ft))
    let files_list = dict_get(result, "files") ?? []
    let total_files = dict_get(result, "total_files") ?? 0

    // Add human age strings
    let ri = 0
    while3 ri < len(files_list) {
        let age_s = dict_get(files_list[ri], "age_seconds") ?? 0
        let updated = dict_set(files_list[ri], "age", human_age(age_s))
        files_list = list_set(files_list, ri, updated)
        ri = ri + 1
    }

    let newest = "none"
    if3 len(files_list) > 0 {
        let newest = dict_get(files_list[0], "age") ?? "none"
    }

    let rtrit = T_MAYBE
    if3 len(files_list) > 0 {
        let rtrit = T_TRUE
    }

    return {
        "ok": true, "pattern": pattern,
        "files": files_list,
        "total_files": total_files,
        "newest": newest,
        "trit": rtrit
    }
}

// ============================================================================
// TMULTI: RUN MODES
// ============================================================================

// run/safe: Ternary safety gate for commands
fn multi_run_safe(args) {
    let command = dict_get(args, "command") ?? ""
    if3 len(command) == 0 {
        return {"ok": false, "error": "missing 'command'", "trit": T_FALSE}
    }
    let cmd_lower = lower(command)

    // Check dangerous patterns
    let danger_list = split(DANGEROUS_CMDS, ",")
    let di = 0
    while3 di < len(danger_list) {
        if3 contains(cmd_lower, danger_list[di]) {
            return {
                "ok": true, "command": command,
                "safety": {"trit": T_FALSE, "char": "T", "verdict": "BLOCKED",
                           "reason": "matches dangerous pattern: " + danger_list[di]},
                "executed": false, "trit": T_FALSE
            }
        }
        di = di + 1
    }

    // Check uncertain patterns
    let uncertain_list = split(UNCERTAIN_CMDS, ",")
    let ui = 0
    while3 ui < len(uncertain_list) {
        if3 contains(cmd_lower, uncertain_list[ui]) {
            return {
                "ok": true, "command": command,
                "safety": {"trit": T_MAYBE, "char": "0", "verdict": "UNCERTAIN",
                           "reason": "matches uncertain pattern: " + uncertain_list[ui]},
                "executed": false, "trit": T_MAYBE
            }
        }
        ui = ui + 1
    }

    // Safe: execute the command
    let result = do_tool_run({"command": command, "timeout": dict_get(args, "timeout") ?? 30})
    result = dict_set(result, "safety", {"trit": T_TRUE, "char": "1", "verdict": "SAFE"})
    return result
}

// run/timed: Execute with precise timing
fn multi_run_timed(args) {
    let command = dict_get(args, "command") ?? ""
    if3 len(command) == 0 {
        return {"ok": false, "error": "missing 'command'", "trit": T_FALSE}
    }
    let t0 = time()
    let result = do_tool_run({"command": command, "timeout": dict_get(args, "timeout") ?? 30})
    let elapsed = time() - t0
    let wall_human = str(round(elapsed, 3)) + "s"
    if3 elapsed < 1 {
        let wall_human = str(round(elapsed * 1000, 1)) + "ms"
    }
    result = dict_set(result, "timing", {
        "wall_seconds": round(elapsed, 4),
        "wall_ms": round(elapsed * 1000, 2),
        "wall_human": wall_human
    })
    return result
}

// run/retry: Execute with automatic retry on failure (up to H3=3 attempts)
fn multi_run_retry(args) {
    let command = dict_get(args, "command") ?? ""
    let max_retries = dict_get(args, "retries") ?? H3
    let delay = dict_get(args, "delay") ?? 1.0

    if3 len(command) == 0 {
        return {"ok": false, "error": "missing 'command'", "trit": T_FALSE}
    }

    let attempts = []
    let attempt = 1
    let last_result = {}

    while3 attempt <= max_retries {
        let result = do_tool_run({"command": command, "timeout": dict_get(args, "timeout") ?? 30})
        let last_result = result
        let step_ok = dict_get(result, "ok") ?? false
        attempts = append(attempts, {"attempt": attempt, "ok": step_ok, "code": dict_get(result, "code") ?? -1})

        if3 step_ok == true {
            result = dict_set(result, "retry", {"attempts": attempts, "succeeded_on": attempt, "total_tries": attempt})
            let rtrit = T_TRUE
            if3 attempt > 1 {
                let rtrit = T_MAYBE
            }
            result = dict_set(result, "trit", rtrit)
            return result
        }

        // Wait before retry (delegate to nova_run to avoid blocking)
        if3 attempt < max_retries {
            shell("timeout /t " + str(delay) + " /nobreak > NUL")
        }

        attempt = attempt + 1
    }

    last_result = dict_set(last_result, "retry", {"attempts": attempts, "succeeded_on": -1, "total_tries": max_retries})
    last_result = dict_set(last_result, "trit", T_FALSE)
    return last_result
}

// ============================================================================
// TMULTI: EDIT MODES
// ============================================================================

// edit/regex: Edit with regex pattern matching
fn multi_edit_regex(args) {
    args = dict_set(args, "regex", true)
    return do_tool_edit(args)
}

// edit/multi: Edit across multiple files simultaneously
fn multi_edit_multi(args) {
    let old_string = dict_get(args, "old_string") ?? ""
    let new_string = dict_get(args, "new_string") ?? ""
    let path_val = dict_get(args, "path") ?? NOVAX_ROOT
    let glob_filter = dict_get(args, "glob") ?? "*.py"
    let regex_mode = dict_get(args, "regex") ?? false

    if3 len(old_string) == 0 {
        return {"ok": false, "error": "missing 'old_string'", "trit": T_FALSE}
    }

    // Pure NovaLang file enumeration via dir
    let esc_path = replace(path_val, "\\", "/")
    let esc_glob = replace(glob_filter, "\\", "\\\\")
    let find_cmd = "dir /s /b \"" + replace(esc_path, "/", "\\") + "\\" + glob_filter + "\" 2>NUL"
    let find_r = shell(find_cmd)
    let find_out = try3 { dict_get(find_r, "stdout") } fail { "" }
    let find_lines = split(find_out, "\n")
    let target_files = []
    for3 fl in find_lines {
        let ff = trim(fl)
        if3 len(ff) > 2 {
            // Skip common dirs
            if3 contains(ff, ".git\\") == false {
                if3 contains(ff, "__pycache__\\") == false {
                    if3 contains(ff, "node_modules\\") == false {
                        target_files = append(target_files, replace(ff, "\\", "/"))
                    }
                }
            }
        }
    }

    let edit_results = []
    let total_replacements = 0
    let fi = 0

    while3 fi < len(target_files) {
        let fpath = target_files[fi]
        let r = do_tool_edit({
            "path": fpath, "old_string": old_string,
            "new_string": new_string, "replace_all": true, "regex": regex_mode
        })
        let r_ok = dict_get(r, "ok") ?? false
        if3 r_ok == true {
            let rep_count = dict_get(r, "replacements") ?? 0
            edit_results = append(edit_results, {"path": fpath, "replacements": rep_count})
            total_replacements = total_replacements + rep_count
        }
        fi = fi + 1
    }

    let mtrit = T_MAYBE
    if3 total_replacements > 0 {
        let mtrit = T_TRUE
    }

    return {
        "ok": true, "old_string": old_string, "new_string": new_string,
        "files_edited": edit_results,
        "total_files": len(edit_results),
        "total_replacements": total_replacements,
        "trit": mtrit
    }
}

// ============================================================================
// TMULTI: PIPE MODES
// ============================================================================

// pipe/parallel: Execute all pipeline steps sequentially (no threading in NovaLang)
fn multi_pipe_parallel(args) {
    let pipeline = dict_get(args, "pipeline") ?? []
    if3 len(pipeline) == 0 {
        return {"ok": false, "error": "missing 'pipeline'", "trit": T_FALSE}
    }

    let t0 = time()
    let results = []
    let all_ok = true
    let pi = 0

    while3 pi < len(pipeline) {
        let step = pipeline[pi]
        let tool_name = dict_get(step, "tool") ?? ""
        let step_params = dict_get(step, "params") ?? {}

        let step_result = {}
        if3 tool_name == "read" { step_result = do_tool_read(step_params)
        } else if3 tool_name == "write" { step_result = do_tool_write(step_params)
        } else if3 tool_name == "grep" { step_result = do_tool_grep(step_params)
        } else if3 tool_name == "glob" { step_result = do_tool_glob(step_params)
        } else if3 tool_name == "run" { step_result = do_tool_run(step_params)
        } else if3 tool_name == "edit" { step_result = do_tool_edit(step_params)
        } else3 { step_result = {"ok": false, "error": "unknown tool: " + tool_name}
        }

        step_result = dict_set(step_result, "step", pi)
        step_result = dict_set(step_result, "tool", tool_name)
        results = append(results, step_result)

        if3 (dict_get(step_result, "ok") ?? false) == false {
            let all_ok = false
        }

        pi = pi + 1
    }

    let elapsed = round((time() - t0) * 1000, 2)
    let ptrit = T_TRUE
    if3 all_ok == false {
        let ptrit = T_FALSE
    }

    return {
        "ok": all_ok, "parallel": true, "steps": len(results),
        "results": results, "ms": elapsed, "trit": ptrit
    }
}

// pipe/conditional: Pipeline with ternary branching
fn multi_pipe_conditional(args) {
    let pipeline = dict_get(args, "pipeline") ?? []
    if3 len(pipeline) == 0 {
        return {"ok": false, "error": "missing 'pipeline'", "trit": T_FALSE}
    }

    let t0 = time()
    let results = []
    let step_idx = 0
    let all_ok = true
    let max_steps = len(pipeline)

    while3 step_idx < max_steps {
        let step = pipeline[step_idx]
        let tool_name = dict_get(step, "tool") ?? ""
        let step_params = dict_get(step, "params") ?? {}

        let step_result = {}
        if3 tool_name == "read" { step_result = do_tool_read(step_params)
        } else if3 tool_name == "write" { step_result = do_tool_write(step_params)
        } else if3 tool_name == "grep" { step_result = do_tool_grep(step_params)
        } else if3 tool_name == "glob" { step_result = do_tool_glob(step_params)
        } else if3 tool_name == "run" { step_result = do_tool_run(step_params)
        } else if3 tool_name == "edit" { step_result = do_tool_edit(step_params)
        } else3 { step_result = {"ok": false, "error": "unknown tool: " + tool_name}
        }

        let trit = tool_trit(step_result)
        step_result = dict_set(step_result, "step", step_idx)
        step_result = dict_set(step_result, "tool", tool_name)
        step_result = dict_set(step_result, "branch_trit", trit)
        results = append(results, step_result)

        // Ternary branching
        let next_step = step_idx + 1
        if3 trit == T_TRUE { next_step = dict_get(step, "on_true") ?? (step_idx + 1)
        } else if3 trit == T_MAYBE { next_step = dict_get(step, "on_maybe") ?? (step_idx + 1)
        } else3 { next_step = dict_get(step, "on_false") ?? -1
            if3 next_step == -1 {
                step_result = dict_set(step_result, "aborted", true)
                all_ok = false
                step_idx = max_steps
            }
        }

        // Prevent infinite loops
        if3 next_step <= step_idx {
            step_result = dict_set(step_result, "error", "loop detected, aborting")
            let step_idx = max_steps
        } else3 { step_idx = next_step
        }
    }

    let elapsed = round((time() - t0) * 1000, 2)
    let ctrit = T_TRUE
    if3 all_ok == false {
        let ctrit = T_FALSE
    }

    return {
        "ok": all_ok, "conditional": true, "steps": len(results),
        "results": results, "ms": elapsed, "trit": ctrit
    }
}

// ============================================================================
// TMULTI DISPATCHER
// ============================================================================

fn execute_multi(tool, mode, args) {
    let t0 = time()
    record_tool_call("multi:" + tool + "/" + mode)

    // Default mode: delegate to original tool
    if3 mode == "default" {
        if3 tool == "read" {
            return do_tool_read(args)
        } else if3 tool == "write" {
            return do_tool_write(args)
        } else if3 tool == "grep" {
            return do_tool_grep(args)
        } else if3 tool == "glob" {
            return do_tool_glob(args)
        } else if3 tool == "run" {
            return do_tool_run(args)
        } else if3 tool == "edit" {
            return do_tool_edit(args)
        } else if3 tool == "pipe" {
            return do_tool_pipe(args)
        } else3 {
            return {"ok": false, "error": "unknown tool: " + tool, "trit": T_FALSE}
        }
    }

    // Dispatch to composed handler
    let result = {}
    let handled = false

    // read modes
    if3 tool == "read" {
        let handled = true
        if3 mode == "stats" { result = multi_read_stats(args)
        } else if3 mode == "diff" { result = multi_read_diff(args)
        } else if3 mode == "extract" { result = multi_read_extract(args)
        } else if3 mode == "classify" { result = multi_read_classify(args)
        } else3 { handled = false
        }
    }

    // write modes
    if3 tool == "write" {
        let handled = true
        if3 mode == "template" { result = multi_write_template(args)
        } else if3 mode == "append" { result = multi_write_append(args)
        } else if3 mode == "atomic" { result = multi_write_atomic(args)
        } else3 { handled = false
        }
    }

    // grep modes
    if3 tool == "grep" {
        let handled = true
        if3 mode == "analyze" { result = multi_grep_analyze(args)
        } else if3 mode == "replace" { result = multi_grep_replace(args)
        } else if3 mode == "todo" { result = multi_grep_todo(args)
        } else3 { handled = false
        }
    }

    // glob modes
    if3 tool == "glob" {
        let handled = true
        if3 mode == "tree" { result = multi_glob_tree(args)
        } else if3 mode == "size" { result = multi_glob_size(args)
        } else if3 mode == "recent" { result = multi_glob_recent(args)
        } else3 { handled = false
        }
    }

    // run modes
    if3 tool == "run" {
        let handled = true
        if3 mode == "safe" { result = multi_run_safe(args)
        } else if3 mode == "timed" { result = multi_run_timed(args)
        } else if3 mode == "retry" { result = multi_run_retry(args)
        } else3 { handled = false
        }
    }

    // edit modes
    if3 tool == "edit" {
        let handled = true
        if3 mode == "regex" { result = multi_edit_regex(args)
        } else if3 mode == "multi" { result = multi_edit_multi(args)
        } else3 { handled = false
        }
    }

    // pipe modes
    if3 tool == "pipe" {
        let handled = true
        if3 mode == "parallel" { result = multi_pipe_parallel(args)
        } else if3 mode == "conditional" { result = multi_pipe_conditional(args)
        } else3 { handled = false
        }
    }

    if3 handled == false {
        return {
            "ok": false,
            "error": "unknown mode '" + mode + "' for tool '" + tool + "'",
            "trit": T_FALSE
        }
    }

    let elapsed = round((time() - t0) * 1000, 2)
    if3 dict_has(result, "ms") == false {
        result = dict_set(result, "ms", elapsed)
    }
    result = dict_set(result, "multi", {"tool": tool, "mode": mode})

    let trit = dict_get(result, "trit") ?? T_MAYBE
    record_op_trit(trit)
    record_metric("multi:" + tool + "/" + mode, elapsed, 0, 0, "", dict_get(result, "ok") ?? false)

    if3 dict_has(result, "char") == false {
        result = dict_set(result, "char", trit_char(trit))
    }

    return result
}

