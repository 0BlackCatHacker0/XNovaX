troute(server, "POST", "/multi",           "handle_multi")
troute(server, "POST", "/tools/mkdir",     "handle_mkdir")
troute(server, "POST", "/tools/ls",        "handle_ls")
troute(server, "POST", "/tools/du",        "handle_du")
troute(server, "POST", "/tools/df",        "handle_df")
troute(server, "POST", "/tools/chmod",     "handle_chmod")
troute(server, "POST", "/tools/chown",     "handle_chown")
troute(server, "POST", "/tools/tree",      "handle_tree")
troute(server, "POST", "/tzip/toggle",     "handle_tzip_toggle")
troute(server, "POST", "/tzip/status",     "handle_tzip_path_status")

