let TABLE = {
    "system": "executor",
    "coding": "deepseek",
    "analysis": "claude",
    "creative": "claude",
    "vision": "llava",
    "fast": "phi3",
    "research": "claude",
    "general": "mixtral"
}

let FALLBACK = {
    "deepseek": "claude",
    "claude": "mixtral",
    "mixtral": "phi3",
    "executor": "mixtral",
    "llava": "claude",
    "phi3": "mixtral"
}

fn choose(text) {
    category = classify(text)
    learned = best_model(category)
    if3 learned {
        return learned, category, "learned"
}
    primary = TABLE.get(category, "mixtral")
    return primary, category, "rule"

}
fn get_fallback(model) {
    return FALLBACK.get(model, "mixtral")
}
