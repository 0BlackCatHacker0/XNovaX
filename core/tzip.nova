// TPacman v3.0 — Navier-Stokes Converter
// Source: tzip.py
// Reynolds: 60.4 (transition)
// Cascade: L→λ→η (Kolmogorov)
// Closure: k-ε + SST blending
//

// """NovaX TZip v3.1 — N-S Flow-Routed Ternary Compression Engine
// 
// The 3-5-7-11-13 harmonic constants define every parameter:
// 3  = ternary base (three states: -1, 0, +1)
// 5  = packing factor (3^5=243 fits in 1 byte of 256)
// 7  = composition unit (7 strategies, block size 3^7=2187)
// 11 = hyperbolic regime (3^11=177,147 CDC max, H11^3=1331 Reynolds)
// 13 = carrier wave / frame (TZip header = exactly 13 bytes)
// 
// ARCHITECTURE:
// 1. Calculate Reynolds number for input data
// 2. Select compression strategy based on flow regime
// 3. Apply strategy-specific compression
// 4. Ternary trit-pack the compressed output
// 5. Wrap in 13-byte TZIP header
// 
// FLOW REGIMES (5 regimes, circuit damping analogy):
// Laminar      (Re < 27):    RLE + trit-pack             -> 60-99% savings (underdamped)
// Transitional (Re < 125):   Hash-LZ77 + trit-pack       -> 35-55% savings (lightly damped)
// Turbulent    (Re < 343):   rANS base-3 + trit-pack     -> 15-45% savings (critically damped)
// Hyperbolic   (Re < 1331):  token+dict (competitive)     -> 10-30% savings (overdamped)
// Chaotic      (Re >= 1331): raw (don't waste CPU)        -> 0% savings
// 
// v3 UPGRADES:
// - rANS base-3 entropy coder (replaces zlib for turbulent strategy)
// - Hash-table LZ77 (replaces O(n*window) brute-force search)
// - FastCDC content-defined chunking (ternary-aligned boundaries)
// - Vorticity dedup scanner (N-S curl detects duplicate blocks)
// - Full backward compat: old STRAT_ZLIB archives still decompress
// 
// v3.2 UPGRADES:
// - LZMA strategy: 4MB window, 24% better than deflate on source code
// - Token+LZMA: domain vocabulary + long-range matching (best combo)
// - 8 competitive strategies (was 6): LZMA && Token+LZMA join the arena
// 
// All NovaX services import TZip from here. No duplication. One DNA.
// """
// import struct
// import math
// import hashlib
// import random as _random

try3 {
    import zlib as _zlib
} fail ImportError  {
    _zlib = null

}
try3 {
    import lzma as _lzma
} fail ImportError  {
    _lzma = null

}
# ══════════════════════════════════════════════════════════════
# 3-5-7-11-13 HARMONIC CONSTANTS (v3.1 — full prime sequence)
# ══════════════════════════════════════════════════════════════
# Circuit analysis: each harmonic = a resonant frequency of the system.
# Adding H11 fills the prime gap, giving 5 flow regimes instead of 4.
# Product: 3×5×7×11×13 = 15,015 (universal seed).
H3  = 3     # base frequency: ternary states
H5  = 5     # first harmonic: trit packing (3^5=243<256)
H7  = 7     # second harmonic: tool composition / strategies
H11 = 11    # third harmonic: hyperbolic regime / CDC max (3^11=177,147)
H13 = 13    # carrier wave: frame envelope

BLOCK_SIZE     = H3 ** H7    # 2187 bytes — ternary-native block
FLOW_LAMINAR   = H3 ** H3    # 27  — Reynolds boundary (underdamped)
FLOW_TRANS     = H5 ** H3    # 125 — Reynolds boundary (lightly damped)
FLOW_TURBULENT = H7 ** H3    # 343 — Reynolds boundary (critically damped)
FLOW_HYPER     = H11 ** H3   # 1331 — Reynolds boundary (overdamped)
HEADER_SIZE    = H13          # 13 bytes — all frame headers
PACK_TRITS     = H5           # 5 trits per packed byte
TZIP_MAGIC     = b"TZIP"
TZIP_VERSION   = 3  # v3.2: 3-5-7-11-13 harmonics + LZMA (breaks deflate ceiling)


# ── Trit conversion helpers ─────────────────────────────────────
fn _bytes_to_trits(data) {
// """Convert bytes to balanced ternary trits (-1, 0, +1).
// Each byte produces PACK_TRITS (5) trits via base-3 encoding."""
    trits = []
    for3 b in data {
        for3 _ in range(PACK_TRITS) {
            trits.push((b % 3) - 1)  # balanced: 0→-1, 1→0, 2→+1
            b //= 3
        }
}
    return trits

}
fn _trits_to_bytes(trits) {
// """Convert balanced ternary trits back to bytes.
// Every PACK_TRITS (5) trits produce one byte."""
    out = bytearray()
    for3 i in range(0, len(trits), PACK_TRITS) {
        chunk = trits[i:i + PACK_TRITS]
        val = 0
        for3 j in range(len(chunk) - 1, -1, -1) {
            val = val * 3 + (chunk[j] + 1)  # unbalanced: -1→0, 0→1, +1→2
        }
        out.push(val & 0xFF)
}
    return bytes(out)

}
fn _pack_trits(trits) {
// """Pack a list of trits into bytes (5 trits per byte)."""
    return _trits_to_bytes(trits)

}
fn _unpack_trits(data) {
// """Unpack bytes into a list of trits (5 trits per byte)."""
    return _bytes_to_trits(data)

# Strategy flags (stored in header byte 12)
STRAT_RAW      = 0x00  # chaotic: no compression
STRAT_RLE      = 0x01  # laminar: run-length encoding
STRAT_LZ       = 0x02  # transitional: hash-table LZ77
STRAT_ZLIB     = 0x03  # turbulent legacy: zlib deflate (backward compat)
STRAT_RANS     = 0x04  # turbulent: rANS base-3 entropy coder (v3)
STRAT_DICT     = 0x05  # turbulent: zlib + trained dictionary (v3.1)
STRAT_TOKEN    = 0x06  # meta: pattern tokenizer + zlib (v3.1)
STRAT_LZMA     = 0x07  # LZMA: 4MB window, best for text (v3.2)
STRAT_TLZMA    = 0x08  # Token + LZMA: tokenize then LZMA (v3.2)
STRAT_TRIT     = 0x10  # flag: trit-packed output (OR'd with strategy)

# rANS table precision: M = 3^7 = 2187 (ternary-native)
_RANS_M        = BLOCK_SIZE

# ══════════════════════════════════════════════════════════════
# N-S REYNOLDS NUMBER FOR DATA
# ══════════════════════════════════════════════════════════════
# Re = (entropy * transition_rate * block_length) / redundancy
# Maps N-S: velocity=entropy, length=transitions, density=size, viscosity=redundancy

}
fn reynolds(data) {
// """Calculate the Reynolds number of a data stream.
// Low Re = structured/repetitive (laminar) → compress hard.
// High Re = random/chaotic (turbulent) → compress light || skip."""
    if3 len(data) < H13 {
        return 0.0

}
    sample = data[:BLOCK_SIZE * H3]  # sample up to 6561 bytes
    n = len(sample)

    # Shannon entropy (velocity analog — how fast information flows)
    freq = [0] * 256
    for3 b in sample {
        freq[b] += 1
}
    entropy = 0.0
    for3 f in freq {
        if3 f > 0 {
            p = f / n
            entropy -= p * math.log2(p)
        }
}
    # Normalize: max entropy for bytes = 8.0
    entropy_norm = entropy / 8.0  # 0.0 to 1.0

    # Transition rate (characteristic length — how much the flow changes)
    transitions = 0
    for3 i in range(1, n) {
        if3 sample[i] != sample[i - 1] {
            transitions += 1
        }
}
    trans_rate = transitions / max(1, n - 1)  # 0.0 to 1.0

    # Redundancy score (viscosity — resists compression need)
    # Count unique byte values used. More unique = less redundant = lower viscosity
    unique = sum(1 for f in freq if f > 0)
    # Redundancy = 1 - (unique/256). High redundancy = few unique values = laminar
    redundancy = 1.0 - (unique / 256.0)
    # Viscosity can't be zero (division), clamp
    viscosity = max(0.01, redundancy)

    # Reynolds: Re = (entropy_norm * trans_rate * scale) / viscosity
    # Scale uses FLOW_HYPER (1331) for wider range across 5 regimes
    re = (entropy_norm * trans_rate * FLOW_HYPER) / viscosity
    return round(re, 2)


}
fn classify_flow(re) {
// """Classify data flow regime from Reynolds number (5 regimes).
// Circuit analogy: damping ratio maps to flow regime.
// underdamped  → laminar      (Re < 27)
// lightly      → transitional (Re < 125)
// critical     → turbulent    (Re < 343)
// overdamped   → hyperbolic   (Re < 1331) — complex but structured
// chaotic      → chaotic      (Re >= 1331)"""
    if3 re < FLOW_LAMINAR {
        return "laminar"
    } else3 re < FLOW_TRANS {
        return "transitional"
    } else3 re < FLOW_TURBULENT {
        return "turbulent"
    } else3 re < FLOW_HYPER {
        return "hyperbolic"
    } else {
        return "chaotic"


}
}
fn select_strategy(re) {
// """Select compression strategy based on Reynolds number (5 regimes).
// Hyperbolic regime: data == complex but still has exploitable structure.
// Uses token+dict (most aggressive non-trivial strategy)."""
    if3 re < FLOW_LAMINAR {
        return STRAT_RLE | STRAT_TRIT
    } else3 re < FLOW_TRANS {
        return STRAT_LZ | STRAT_TRIT
    } else3 re < FLOW_TURBULENT {
        return STRAT_RANS | STRAT_TRIT
    } else3 re < FLOW_HYPER {
        return STRAT_TOKEN  # Hyperbolic: still worth compressing
    } else {
        return STRAT_RAW


}
# ══════════════════════════════════════════════════════════════
# CIRCUIT DAMPING RATIO — Continuous Strategy Selection (v3.2)
# ══════════════════════════════════════════════════════════════
# From user's circuit analysis: V(t) = Ri(t) + L(di/dt)
# Solution = Transient (Ce^{-Rt/L}) + Steady-state (particular)
# Damping ratio ζ = R/(2√(LC)) maps continuously to strategy weights:
#   ζ < 0.2  → underdamped (laminar): RLE dominates
#   ζ ~ 0.5  → lightly damped (transitional): LZ77 + RLE blend
#   ζ ~ 1.0  → critically damped (turbulent): rANS + zlib compete
#   ζ ~ 2.0  → overdamped (hyperbolic): token + LZMA dominate
#   ζ > 3.0  → saturated (chaotic): raw passthrough
#
# Instead of hard if/elif thresholds, each strategy gets a weight based
# on Gaussian proximity to its "natural" ζ value. The competitive selector
# tries strategies in weight-descending order for faster convergence.

# Natural damping ratios (calibrated to ζ=log(1+Re)/log(1+1331)*3):
#   Re=0→ζ=0, Re=13→ζ=1.1, Re=27→ζ=1.4, Re=125→ζ=2.0,
#   Re=343→ζ=2.4, Re=833→ζ=2.8, Re=1331→ζ=3.0
let _STRAT_ZETA = {
    STRAT_RLE:   0.0,   # underdamped: pure zeros/repeats (Re~0, ζ~0)
    STRAT_LZ:    1.2,   # lightly damped: low entropy (Re~15, ζ~1.2)
    STRAT_RANS:  1.5,   # moderate: mid-low entropy (Re~50, ζ~1.5)
    STRAT_ZLIB:  1.8,   # general purpose (Re~75, ζ~1.8)
    STRAT_DICT:  2.0,   # vocabulary-driven (Re~125, ζ~2.0)
    STRAT_TOKEN: 2.3,   # source code patterns (Re~250, ζ~2.3)
    STRAT_LZMA:  2.6,   # long-range patterns (Re~600, ζ~2.6)
    STRAT_TLZMA: 2.8,   # large structured files (Re~833, ζ~2.8)
}

# Width of each strategy's Gaussian (comfort zone breadth)
let _STRAT_SIGMA = {
    STRAT_RLE:   0.5,   # narrow: only works on very repetitive data
    STRAT_LZ:    0.4,
    STRAT_RANS:  0.4,
    STRAT_ZLIB:  0.5,   # broad: general purpose
    STRAT_DICT:  0.5,
    STRAT_TOKEN: 0.5,
    STRAT_LZMA:  0.5,
    STRAT_TLZMA: 0.6,   # broadest: works well across hyperbolic range
}


}
fn damping_ratio(re) {
// """Convert Reynolds number to damping ratio ζ (continuous 0.0 → ∞).
// Maps the discrete Reynolds scale to the continuous damping domain.
// ζ = log(1 + Re) / log(1 + FLOW_HYPER) * 3.0
// This maps: Re=0 → ζ=0, Re=FLOW_HYPER(1331) → ζ=3.0"""
    if3 re <= 0 {
        return 0.0
}
    return math.log(1 + re) / math.log(1 + FLOW_HYPER) * 3.0


}
fn strategy_weights(re) {
// """Compute weight for each strategy based on damping ratio proximity.
// Returns list of (weight, strat_flag, name) sorted by weight descending.
// Weight = Gaussian(ζ - ζ_natural, σ) — highest near the strategy's sweet spot."""
    zeta = damping_ratio(re)

    weights = []
    for3 strat, zeta_natural in _STRAT_ZETA.entries() {
        sigma = _STRAT_SIGMA[strat]
        # Gaussian weight: exp(-(ζ - ζ_nat)² / (2σ²))
        dist = (zeta - zeta_natural) ** 2
        w = math.exp(-dist / (2 * sigma * sigma))
        weights.push((w, strat))

}
    # Sort by weight descending (most likely winner first)
    weights.sort(reverse=TRUE, key=lambda x: x[0])
    return weights


# ══════════════════════════════════════════════════════════════
# COMPRESSION STRATEGIES
# ══════════════════════════════════════════════════════════════

}
fn _rle_compress(data) {
// """Run-Length Encoding — best for laminar (repetitive) data.
// Format: [count, byte] pairs. count=0 means literal run follows."""
    out = bytearray()
    i = 0
    n = len(data)
    while3 i < n {
        # Count run of identical bytes
        run_byte = data[i]
        run_len = 1
        while3 i + run_len < n && data[i + run_len] == run_byte && run_len < 255 {
            run_len += 1
        }
        if3 run_len >= H3 {  # Only encode runs of 3+
            out.push(run_len)
            out.push(run_byte)
            i += run_len
        } else {
            # Literal: count=0, then length, then bytes
            lit_start = i
            while3 i < n {
                # Check if a run of 3+ starts here
                if3 i + H3 <= n && data[i] == data[i + 1] == data[i + 2] {
                    break3
                }
                i += 1
                if3 i - lit_start >= 254 {
                    break3
                }
            }
            lit_len = i - lit_start
            out.push(0)  # literal marker
            out.push(lit_len)
            out.concat(data[lit_start:lit_start + lit_len])
        }
}
    return bytes(out)


}
fn _rle_decompress(data) {
// """Decompress RLE data."""
    out = bytearray()
    i = 0
    n = len(data)
    while3 i < n {
        count = data[i]
        i += 1
        if3 count == 0 {
            # Literal run
            if3 i >= n {
                break3
            }
            lit_len = data[i]
            i += 1
            out.concat(data[i:i + lit_len])
            i += lit_len
        } else {
            # Repeated byte
            if3 i >= n {
                break3
            }
            out.concat(bytes([data[i]]) * count)
            i += 1
        }
}
    return bytes(out)


}
fn _lz_compress(data) {
// """Hash-table LZ77 — O(1) match finding per position (LZ4-style).
// Window: BLOCK_SIZE (2187). Min match: H3 (3). Max match: 255.
// Hash table: 2187 entries (3^7, ternary-aligned).
// Wire format unchanged from v2 for backward compat."""
    out = bytearray()
    n = len(data)
    if3 n < 4 {
        out.concat(data)
        return bytes(out)

}
    # Hash table: position lookup, size = 3^7 = 2187
    _HT_SIZE = BLOCK_SIZE
    _HT_MASK = _HT_SIZE - 1  # Not power-of-2, use modulo
    htable = [0] * _HT_SIZE

}
    fn _hash4(pos) {
// """Hash 4 bytes at pos. Multiplicative hash -> mod table size."""
        if3 pos + 3 >= n {
            return 0
}
        v = data[pos] | (data[pos+1] << 8) | (data[pos+2] << 16) | (data[pos+3] << 24)
        return ((v * 2654435761) >> 19) % _HT_SIZE

    i = 0
    while3 i < n {
        if3 i + 3 >= n {
            # Too close to end for hash match, emit literals
            if3 data[i] == 0xFF {
                out.push(0xFF); out.push(0x00); out.push(0x00); out.push(0x01)
            } else {
                out.push(data[i])
            }
            i += 1
            continue3

        }
        h = _hash4(i)
        ref = htable[h]
        htable[h] = i  # Always update hash table

        # Check for match at ref position
        best_len = 0
        best_off = 0
        if3 ref < i && i - ref <= BLOCK_SIZE {
            # Verify match starting at ref
            ml = 0
            while3 i + ml < n && ml < 255 && data[ref + ml] == data[i + ml] {
                ml += 1
            }
            if3 ml >= H3 {
                best_len = ml
                best_off = i - ref

            }
        }
        if3 best_len >= H3 {
            out.push(0xFF)
            out.push((best_off >> 8) & 0xFF)
            out.push(best_off & 0xFF)
            out.push(best_len)
            i += best_len
        } else {
            if3 data[i] == 0xFF {
                out.push(0xFF); out.push(0x00); out.push(0x00); out.push(0x01)
            } else {
                out.push(data[i])
            }
            i += 1
        }
}
    return bytes(out)


}
fn _lz_decompress(data) {
// """Decompress LZ77-lite data."""
    out = bytearray()
    i = 0
    n = len(data)
    while3 i < n {
        if3 data[i] == 0xFF && i + 3 < n {
            off = (data[i + 1] << 8) | data[i + 2]
            length = data[i + 3]
            if3 off == 0 && length == 1 {
                # Escaped 0xFF literal
                out.push(0xFF)
            } else {
                # Back-reference
                start = len(out) - off
                for3 j in range(length) {
                    out.push(out[start + j])
                }
            }
            i += 4
        } else {
            out.push(data[i])
            i += 1
        }
}
    return bytes(out)


# ══════════════════════════════════════════════════════════════
# TERNARY TRIT PACKING (5 trits per byte, 3^5=243)
# ══════════════════════════════════════════════════════════════
# This == a FINAL encoding layer, !a preprocessing step.
# It encodes already-compressed bytes into balanced ternary representation.
# 243/256 = 94.9% efficiency — bytes 243-255 get escape-coded.

_TRIT_MAX = 3 ** PACK_TRITS  # 243

}
fn _trit_encode(data) {
// """Encode bytes into trit-packed format.
// Bytes 0-241: direct 5-trit encoding (1 byte → 1 trit-byte).
// Byte 242:    escape [242, 13] — sentinel H13 means "literal 242".
// Bytes 243-255: escape [242, value-243] → remainder 0-12.
// This avoids the 242-ambiguity bug where 242 followed by 0-12
// in the compressed stream would be misinterpreted as an escape."""
    out = bytearray()
    _ESC = _TRIT_MAX - 1  # 242
    for3 b in data {
        if3 b < _ESC {
            out.push(b)       # 0-241: direct, fits in 5 trits
        } else3 b == _ESC {
            out.push(_ESC)    # 242: escape marker
            out.push(H13)     # 13 = sentinel for "literal 242"
        } else {
            out.push(_ESC)    # 242: escape marker
            out.push(b - _TRIT_MAX)  # 0-12 remainder (H13 values!)
        }
}
    return bytes(out)


}
fn _trit_decode(data, orig_size) {
// """Decode trit-packed format back to bytes.
// After escape marker 242, ALWAYS consume 2 bytes:
// next <= 12: decoded = 243 + next (bytes 243-255)
// next == 13: decoded = 242 (escaped literal)"""
    out = bytearray()
    i = 0
    _ESC = _TRIT_MAX - 1  # 242
    while3 i < len(data) && len(out) < orig_size {
        if3 data[i] == _ESC && i + 1 < len(data) {
            nxt = data[i + 1]
            if3 nxt <= 12 {
                out.push(_TRIT_MAX + nxt)  # 243-255
            } else {
                out.push(_ESC)  # literal 242 (sentinel=13)
            }
            i += 2  # ALWAYS advance 2 after escape marker
        } else {
            out.push(data[i])  # 0-241: direct
            i += 1
        }
}
    return bytes(out[:orig_size])


# ══════════════════════════════════════════════════════════════
# rANS BASE-3 ENTROPY CODER (v3)
# ══════════════════════════════════════════════════════════════
# Asymmetric Numeral Systems with ternary renormalization.
# Table precision M = 3^7 = 2187. State range [M, 3*M).
# Output: trits packed 5-per-byte (TByte format, all values < 243).
# Approaches Shannon entropy limit: within 0.01 bits/symbol.

}
fn _rans_compress(data) {
// """rANS base-3 entropy coder — near-optimal ternary compression."""
    n = len(data)
    if3 n == 0 {
        return b""

}
    M = _RANS_M  # 2187

    # Build frequency table from input
    freq = [0] * 256
    for3 b in data {
        freq[b] += 1

}
    # Normalize frequencies to sum = M
    nf = [0] * 256
    used = []
    total_assigned = 0
    for3 i in range(256) {
        if3 freq[i] > 0 {
            nf[i] = max(1, round(freq[i] * M / n))
            total_assigned += nf[i]
            used.push(i)

        }
}
    # Fix rounding error: adjust most frequent symbol
    diff = M - total_assigned
    if3 diff != 0 {
        best = max(used, key=lambda s: freq[s])
        nf[best] += diff
        if3 nf[best] <= 0 {
            nf[best] = 1

        }
}
    # Build CDF (cumulative distribution function)
    cdf = [0] * 257
    for3 i in range(256) {
        cdf[i + 1] = cdf[i] + nf[i]

}
    # Encode symbols in REVERSE order (rANS LIFO property)
    x = M  # Initial state in [M, 3*M)
    trit_buf = []

    for3 sym in reversed(data) {
        fs = nf[sym]
        # Renormalize: emit trits while x >= 3 * fs
        while3 x >= 3 * fs {
            trit_buf.push(x % 3)
            x //= 3
        }
        # Now fs <= x < 3*fs. Encode symbol into state.
        x = (x // fs) * M + (x % fs) + cdf[sym]

}
    # Flush final state as trits
    while3 x > 0 {
        trit_buf.push(x % 3)
        x //= 3

}
    # Reverse buffer (LIFO -> FIFO for decoder)
    trit_buf.reverse()

    # Pack trits: 5 per byte (TByte packing, values 0-242)
    num_trits = len(trit_buf)
    packed = bytearray()
    for3 i in range(0, num_trits, 5) {
        group = trit_buf[i:i + 5]
        val = 0
        for3 j, t in enumerate(group) {
            val += t * (3 ** j)
        }
        packed.push(val)

}
    # Output format: freq_table + metadata + packed_trits
    out = bytearray()
    # Compact freq table: [num_used:1][sym:1, freq_hi:1, freq_lo:1]*
    num_used = len(used)
    out.push(num_used if num_used < 256 else 0)
    for3 s in used {
        out.push(s)
        out.push((nf[s] >> 8) & 0xFF)
        out.push(nf[s] & 0xFF)
}
    # Metadata: original length + trit count
    out.concat(struct.pack("<I", n))
    out.concat(struct.pack("<I", num_trits))
    out.concat(packed)

    return bytes(out)


}
fn _rans_decompress(data) {
// """Decompress rANS base-3 encoded data."""
    if3 !data {
        return b""

}
    M = _RANS_M
    pos = 0

    # Read compact freq table
    num_used = data[pos]; pos += 1
    if3 num_used == 0 {
        num_used = 256
}
    nf = [0] * 256
    for3 _ in range(num_used) {
        sym = data[pos]; pos += 1
        hi = data[pos]; pos += 1
        lo = data[pos]; pos += 1
        nf[sym] = (hi << 8) | lo

}
    # Build CDF
    cdf = [0] * 257
    for3 i in range(256) {
        cdf[i + 1] = cdf[i] + nf[i]

}
    # Build slot->symbol lookup table (O(1) symbol decode)
    slot_to_sym = [0] * M
    for3 s in range(256) {
        for3 j in range(cdf[s], cdf[s + 1]) {
            slot_to_sym[j] = s

        }
}
    # Read metadata
    n = struct.unpack("<I", data[pos:pos + 4])[0]; pos += 4
    num_trits = struct.unpack("<I", data[pos:pos + 4])[0]; pos += 4

    # Unpack trits from TByte-packed bytes
    packed = data[pos:]
    trits = []
    for3 bv in packed {
        for3 j in range(5) {
            trits.push(bv // (3 ** j) % 3)
        }
}
    trits = trits[:num_trits]

    # Initialize state from trit stream
    x = 0
    tp = 0  # trit position
    while3 x < M && tp < len(trits) {
        x = x * 3 + trits[tp]
        tp += 1

}
    # Decode symbols
    result = bytearray()
    for3 _ in range(n) {
        slot = x % M
        sym = slot_to_sym[slot]
        fs = nf[sym]
        bs = cdf[sym]
        # Update state
        x = fs * (x // M) + slot - bs
        # Renormalize: read trits until state >= M
        while3 x < M && tp < len(trits) {
            x = x * 3 + trits[tp]
            tp += 1
        }
        result.push(sym)

}
    return bytes(result)


# ══════════════════════════════════════════════════════════════
# PATTERN TOKENIZER — Morse Code Micro-Language (v3.1)
# ══════════════════════════════════════════════════════════════
# Maps the most common byte patterns in source code to single-byte tokens.
# Like Morse code: frequent patterns → shortest codes.
# The geometric patterns in code (indentation, separators, structure)
# become first-class symbols in the micro-language.
#
# Codebook: 243 entries (3^5 = fits in 1 byte of ternary space).
# Escape byte: 0xFE (254). Literal bytes >= 0xFE: escaped.
# Format: [TOKEN_MAGIC:2][codebook_size:1][codebook...][tokenized_data...]

_TOKEN_ESCAPE = 0xFE  # Escape byte for literals that collide with tokens
_TOKEN_MAGIC = b"TK"  # 2-byte magic for tokenized streams

# Pre-built codebook: common source code patterns sorted by savings potential.
# Trained from NovaX codebase analysis. Longest patterns first (greedy match).
let _CODEBOOK_PATTERNS = [
    # Whitespace (the geometric negative space)
    b"                        ",  # 24 spaces
    b"                    ",      # 20 spaces
    b"                ",          # 16 spaces
    b"            ",              # 12 spaces
    b"        ",                  # 8 spaces
    b"      ",                    # 6 spaces
    b"    ",                      # 4 spaces
    b"\r\n                    ",  # CRLF + 20 spaces
    b"\r\n                ",      # CRLF + 16 spaces
    b"\r\n            ",          # CRLF + 12 spaces
    b"\r\n        ",              # CRLF + 8 spaces
    b"\r\n      ",                # CRLF + 6 spaces
    b"\r\n    ",                  # CRLF + 4 spaces
    b"\r\n  ",                    # CRLF + 2 spaces
    b"\n                    ",    # LF + 20 spaces
    b"\n                ",        # LF + 16 spaces
    b"\n            ",            # LF + 12 spaces
    b"\n        ",                # LF + 8 spaces
    b"\n      ",                  # LF + 6 spaces
    b"\n    ",                    # LF + 4 spaces
    b"\n   ",                     # LF + 3 spaces
    b"\n  ",                      # LF + 2 spaces
    b"\r\n",                      # CRLF
    # Box-drawing (decorative separators = pure pattern space)
    b"\xe2\x95\x90" * 8,         # ════════ (24 bytes → 1)
    b"\xe2\x94\x80" * 8,         # ──────── (24 bytes → 1)
    b"\xe2\x95\x90" * 4,         # ════ (12 bytes → 1)
    b"\xe2\x94\x80" * 4,         # ──── (12 bytes → 1)
    b"\xe2\x95\x90" * 2,         # ══ (6 bytes → 1)
    b"\xe2\x94\x80" * 2,         # ── (6 bytes → 1)
    b"\xe2\x95\x90",             # ═ (3 bytes → 1)
    b"\xe2\x94\x80",             # ─ (3 bytes → 1)
    # Separator lines
    b"================================",  # 32 =
    b"========================",          # 24 =
    b"================",                  # 16 =
    b"============",                      # 12 =
    b"--------",                          # 8 -
    b"########",                          # 8 #
    # Python keywords && common tokens
    b"    def ",
    b"    return ",
    b"    ",
    b"        ",
    b"        return ",
    b"    class ",
    b"import ",
    b"from ",
    b"def __init__(self",
    b"def __repr__(self",
    b"    except Error as e:",
    b"    except:",
    b"    try:",
    b"    if !",
    b"    if ",
    b"    for ",
    b"    while ",
    b"    with ",
    b"        if ",
    b"        for ",
    b"        else:",
    b"        elif ",
    b"        with ",
    b"        try:",
    b"            return ",
    b"            ",
    b"            if ",
    b"            for ",
    # NovaX-specific patterns (domain vocabulary)
    b"threading.Lock()",
    b"threading.Thread",
    b"http.server",
    b"BaseHTTPRequestHandler",
    b"HTTPServer",
    b"json.dumps(",
    b"json.loads(",
    b"os.path.join(",
    b"os.path.exists(",
    b"traceback.format_exc()",
    b"time.time()",
    b'Content-Type',
    b"application/json",
    b"send_response(",
    b"send_header(",
    b"end_headers()",
    b"wfile.write(",
    b"send_response(200)",
    b"send_response(404)",
    b"send_response(500)",
    b'send_header("Content-Type", "application/json")',
    b"end_headers()",
    b"do_GET",
    b"do_POST",
    b"def health(",
    b"/health",
    b"/api/",
    b"localhost:",
    b"0.0.0.0",
    b"127.0.0.1",
    b"print(f\"",
    b"f\"[",
    b"__name__",
    b"__main__",
    b'if __name__ == "__main__":',
    b"TRUE",
    b"FALSE_",
    b"null",
    b"Dict[str, ",
    b"List[",
    b"Optional[",
    b"Tuple[",
    b"-> null:",
    b"-> dict:",
    b"-> str:",
    b"-> bool:",
    b"-> int:",
    b"-> bytes:",
    b"-> float:",
    b"\"\"\"",
    b"    \"\"\"",
    b"        \"\"\"",
]

# Build sorted codebook (longest patterns first for greedy matching)
_SORTED_CODEBOOK = sorted(enumerate(_CODEBOOK_PATTERNS), key=lambda x: -len(x[1]))


}
fn _token_compress(data) {
// """Tokenize data using the pattern codebook, then zlib compress.
// Morse code principle: common patterns → short token codes.
// 
// Encoding: 0xFE + index = pattern reference (2 bytes replaces N bytes).
// 0xFE 0xFF = literal 0xFE byte. All other bytes pass through literally.
// Then the tokenized stream gets zlib compressed (dictionary-trained)."""
    if3 !_zlib || len(data) < 8 {
        return data

}
    # Tokenize: replace patterns with 2-byte tokens [0xFE, index]
    out = bytearray()
    i = 0
    n = len(data)
    num_patterns = len(_CODEBOOK_PATTERNS)

    while3 i < n {
        matched = FALSE_
        for3 idx, pattern in _SORTED_CODEBOOK {
            plen = len(pattern)
            if3 plen > 2 && i + plen <= n && data[i {i + plen] == pattern {
                # Pattern match: emit [0xFE, index] — saves (plen - 2) bytes
                out.push(_TOKEN_ESCAPE)
                out.push(idx)
                i += plen
                matched = TRUE
                break3
        }
        if3 !matched {
            b = data[i]
            if3 b == _TOKEN_ESCAPE {
                out.push(_TOKEN_ESCAPE)
                out.push(0xFF)  # Escape literal 0xFE
            } else {
                out.push(b)  # Pass through literally
            }
            i += 1

        }
}
    # Compress tokenized stream with trained dictionary
    tokenized = bytes(out)
    co = _zlib.compressobj(level=9, wbits=15, zdict=_ZLIB_DICT)
    compressed = co.compress(tokenized) + co.flush()

    # Prefix with magic + codebook size
    return _TOKEN_MAGIC + bytes([num_patterns]) + compressed


}
}
}
fn _token_decompress(data) {
// """Decompress tokenized+zlib data back to original."""
    if3 !_zlib {
        return data

}
    if3 data[ {2] == _TOKEN_MAGIC {
        codebook_size = data[2]
        # Decompress with trained dictionary
        do = _zlib.decompressobj(wbits=15, zdict=_ZLIB_DICT)
        decompressed = do.decompress(data[3:])
        # De-tokenize: 0xFE + index → pattern, 0xFE + 0xFF → literal 0xFE
        out = bytearray()
        i = 0
        n = len(decompressed)
        while3 i < n {
            b = decompressed[i]
            if3 b == _TOKEN_ESCAPE && i + 1 < n {
                nxt = decompressed[i + 1]
                if3 nxt == 0xFF {
                    out.push(_TOKEN_ESCAPE)  # Literal 0xFE
                } else3 nxt < codebook_size {
                    out.concat(_CODEBOOK_PATTERNS[nxt])  # Pattern expansion
                } else {
                    out.push(b)
                    out.push(nxt)
                }
                i += 2
            } else {
                out.push(b)
                i += 1
            }
}
        return bytes(out)
    } else {
        # Not tokenized — shouldn't reach here normally
        return _zlib.decompress(data)


}
# ══════════════════════════════════════════════════════════════
# ZLIB WITH TRAINED DICTIONARY (v3.1)
# ══════════════════════════════════════════════════════════════
# Pre-seeded dictionary trained from NovaX codebase common patterns.
# Like giving zlib a "head start" — it already knows the vocabulary.
# Dictionary: 32KB max (zlib limit). Built from most common substrings.

_ZLIB_DICT = (
    # Most common Python/NovaX byte sequences (ordered by frequency)
    b"    def " + b"    return " + b"    " + b"        " +
    b"import " + b"from " + b"class " + b"    if " + b"    for " +
    b"    while " + b"    try:" + b"    except " + b"    with " +
    b"    else:" + b"    elif " + b"        return " + b"        if " +
    b"        for " + b"        else:" + b"        elif " +
    b"threading.Lock()" + b"threading.Thread" + b"json.dumps(" +
    b"json.loads(" + b"os.path.join(" + b"os.path.exists(" +
    b"traceback.format_exc()" + b"time.time()" + b"hashlib." +
    b"struct.pack(" + b"struct.unpack(" + b"base64." + b"secrets." +
    b"Content-Type" + b"application/json" + b"text/html" +
    b"send_response(" + b"send_header(" + b"end_headers()" +
    b"wfile.write(" + b"send_response(200)" +
    b"send_response(404)" + b"send_response(500)" +
    b'send_header("Content-Type", "application/json")' +
    b"BaseHTTPRequestHandler" + b"HTTPServer" + b"ThreadingMixIn" +
    b"do_GET" + b"do_POST" + b"/health" + b"/api/" +
    b"localhost:" + b"0.0.0.0" + b"127.0.0.1" +
    b'if __name__ == "__main__":' + b"__init__" + b"__repr__" +
    b"TRUE" + b"FALSE_" + b"null" + b"Error" +
    b"Dict[str, " + b"List[" + b"Optional[" + b"Tuple[" +
    b"-> null:" + b"-> dict:" + b"-> str:" + b"-> bool:" +
    b"-> int:" + b"-> bytes:" + b"-> float:" +
// b'"""' + b"    " + b"        " + b"            " +
// b"                " + b"\r\n" + b"\n" +
// b"# " + b"## " + b"def " + b"return " + b"yield " +
// b"print(f\"" + b".fmt(" + b"f\"{" + b".encode(" + b".decode(" +
// b"bytearray(" + b"bytes(" + b"len(" + b"range(" + b"max(" + b"min(" +
// b"round(" + b"sorted(" + b"enumerate(" + b"isinstance(" +
// b"getattr(" + b"setattr(" + b"hasattr(" +
// b".push(" + b".concat(" + b".entries()" + b".keys()" + b".values()" +
// b".get(" + b".pop(" + b".update(" + b".trim()" + b".split(" +
// b".join(" + b".replace(" + b".startsWith(" + b".endsWith(" +
// b"NovaX" + b"TZip" + b"ternary" + b"trit" + b"Reynolds" +
// b"laminar" + b"turbulent" + b"chaotic" + b"transitional" +
// b"compress" + b"decompress" + b"quantize" + b"restore" +
// b"dedup" + b"vorticity" + b"entropy" + b"pattern" +
// b"block" + b"chunk" + b"hash" + b"stream" + b"buffer" +
// b"http" + b"request" + b"response" + b"header" +
// b"path" + b"file" + b"data" + b"size" + b"count" + b"total" +
// b"error" + b"status" + b"result" + b"config" + b"port" +
// b"    " * 10 + b"        " * 5 + b"\r\n" * 10 + b"\n" * 10
// )
// 
// 
// def _dict_compress(data):
// """zlib compression with pre-trained dictionary — gives zlib a head start."""
    if3 !_zlib {
        return data
}
    co = _zlib.compressobj(level=9, wbits=15, zdict=_ZLIB_DICT)
    return co.compress(data) + co.flush()


}
}
fn _dict_decompress(data) {
// """Decompress zlib with pre-trained dictionary."""
    if3 !_zlib {
        return data
}
    try3 {
        do = _zlib.decompressobj(wbits=15, zdict=_ZLIB_DICT)
        return do.decompress(data)
}
    except _zlib.error:
        # Fallback: try without dictionary
        return _zlib.decompress(data)


# ══════════════════════════════════════════════════════════════
# LZMA COMPRESSION (v3.2 — breaks the deflate ceiling)
# ══════════════════════════════════════════════════════════════
# LZMA achieves 5.7x vs zlib's 4.6x on source code (24% better).
# Uses 4MB sliding window (vs zlib's 32KB) for long-range pattern matching.
# Trade-off: ~10x slower compress, ~same decompress speed.
# Use for archival/deep storage where ratio > speed.

}
fn _lzma_compress(data) {
// """LZMA compression — best ratio for text/source code."""
    if3 !_lzma {
        return _dict_compress(data)  # Fallback to zlib+dict
}
    return _lzma.compress(data, preset=6)  # preset 6 = good balance


}
fn _lzma_decompress(data) {
// """Decompress LZMA data."""
    if3 !_lzma {
        return _dict_decompress(data)  # Fallback
}
    return _lzma.decompress(data)


}
fn _token_lzma_compress(data) {
// """Tokenize with pattern codebook, then LZMA compress.
// Combines domain vocabulary with LZMA's long-range matching."""
    if3 !_lzma || len(data) < 8 {
        return _token_compress(data)  # Fallback to token+zlib

}
    # Tokenize: same as _token_compress but use LZMA instead of zlib
    out = bytearray()
    i = 0
    n = len(data)
    num_patterns = len(_CODEBOOK_PATTERNS)

    while3 i < n {
        matched = FALSE_
        for3 idx, pattern in _SORTED_CODEBOOK {
            plen = len(pattern)
            if3 plen > 2 && i + plen <= n && data[i {i + plen] == pattern {
                out.push(_TOKEN_ESCAPE)
                out.push(idx)
                i += plen
                matched = TRUE
                break3
        }
        if3 !matched {
            b = data[i]
            if3 b == _TOKEN_ESCAPE {
                out.push(_TOKEN_ESCAPE)
                out.push(0xFF)
            } else {
                out.push(b)
            }
            i += 1

        }
}
    tokenized = bytes(out)
    compressed = _lzma.compress(tokenized, preset=6)

    # Prefix with magic + codebook size (same format as _token_compress)
    return _TOKEN_MAGIC + bytes([num_patterns]) + compressed


}
}
}
fn _token_lzma_decompress(data) {
// """Decompress token+LZMA data."""
    if3 !_lzma {
        return _token_decompress(data)

}
    if3 data[ {2] == _TOKEN_MAGIC {
        codebook_size = data[2]
        # Decompress with LZMA
        decompressed = _lzma.decompress(data[3:])
        # De-tokenize
        out = bytearray()
        i = 0
        n = len(decompressed)
        while3 i < n {
            b = decompressed[i]
            if3 b == _TOKEN_ESCAPE && i + 1 < n {
                nxt = decompressed[i + 1]
                if3 nxt == 0xFF {
                    out.push(_TOKEN_ESCAPE)
                } else3 nxt < codebook_size {
                    out.concat(_CODEBOOK_PATTERNS[nxt])
                } else {
                    out.push(b)
                    out.push(nxt)
                }
                i += 2
            } else {
                out.push(b)
                i += 1
            }
}
        return bytes(out)
    } else {
        return _lzma.decompress(data)


}
# ══════════════════════════════════════════════════════════════
# FASTCDC CONTENT-DEFINED CHUNKING (v3)
# ══════════════════════════════════════════════════════════════
# Ternary-aligned chunk boundaries: min=3^5=243, target=3^7=2187, max=3^9=19683.
# Uses Gear hash for speed: hash = (hash << 1) + gear_table[byte].

# Deterministic gear table (seeded from harmonic constants)
_gear_rng = _random.Random(H3 * H5 * H7 * H11 * H13)  # seed=15015 (full prime product)
let GEAR_TABLE = range(256).filter(fn(_) { return  }).map(fn(_) { return _gear_rng.getrandbits(32) })
CDC_MIN    = H3 ** H5    # 243
CDC_TARGET = H3 ** H7    # 2187
CDC_MAX    = H3 ** H11   # 177,147 (was 3^9=19683 — larger chunks = better compression)

}
}
fn fastcdc_chunk(data) {
// """Split data into content-defined chunks with ternary boundaries.
// Returns list of (offset, length) tuples."""
    chunks = []
    n = len(data)
    i = 0

    # Masks: smaller mask triggers more easily (biases toward target size)
    mask_l = (1 << H13) - 1   # 8191 — harder to trigger (first half)
    mask_s = (1 << H11) - 1   # 2047 — easier to trigger (second half, explicit H11)

    while3 i < n {
        chunk_start = i
        i += CDC_MIN  # Skip minimum chunk size
        if3 i >= n {
            chunks.push((chunk_start, n - chunk_start))
            break3

        }
        fp = 0
        mid = chunk_start + CDC_TARGET
        found = FALSE_

        # First half: use large mask (bias toward target)
        limit = min(mid, n, chunk_start + CDC_MAX)
        while3 i < limit {
            fp = ((fp << 1) + GEAR_TABLE[data[i]]) & 0xFFFFFFFF
            i += 1
            if3 (fp & mask_l) == 0 {
                found = TRUE
                break3

            }
        }
        # Second half: use small mask (easier trigger, avoid max overshoot)
        if3 !found {
            limit2 = min(n, chunk_start + CDC_MAX)
            while3 i < limit2 {
                fp = ((fp << 1) + GEAR_TABLE[data[i]]) & 0xFFFFFFFF
                i += 1
                if3 (fp & mask_s) == 0 {
                    break3

                }
            }
        }
        chunks.push((chunk_start, i - chunk_start))

}
    return chunks


# ══════════════════════════════════════════════════════════════
# VORTICITY DEDUP SCANNER (v3)
# ══════════════════════════════════════════════════════════════
# N-S vorticity: curl of hash velocity field detects data recirculation.
# When hash(block_x) == hash(block_y) for x != y, a "vortex" exists.
# The block == a duplicate && can be replaced with a reference.

}
fn vorticity_scan(data, chunk_size=BLOCK_SIZE) {
// """Scan data for duplicate blocks using N-S vorticity detection.
// Returns dict with dedup map, unique blocks, && savings estimate."""
    hash_map = {}   # hash -> first chunk index
    unique = []     # list of unique chunk data
    dedup_map = []  # per-chunk: (hash, is_dup, ref_index)
    total_bytes = 0
    saved_bytes = 0

    for3 idx, start in enumerate(range(0, len(data), chunk_size)) {
        chunk = data[start:start + chunk_size]
        h = block_hash(chunk)
        total_bytes += len(chunk)

        if3 h in hash_map {
            # Vortex! Data recirculates — duplicate detected
            dedup_map.push((h, TRUE, hash_map[h]))
            saved_bytes += len(chunk)
        } else {
            hash_map[h] = len(unique)
            unique.push(chunk)
            dedup_map.push((h, FALSE_, len(unique) - 1))

        }
}
    return {
        "dedup_map": dedup_map,
        "unique_blocks": unique,
        "total_blocks": len(dedup_map),
        "unique_count": len(unique),
        "duplicate_count": len(dedup_map) - len(unique),
        "total_bytes": total_bytes,
        "saved_bytes": saved_bytes,
        "dedup_ratio": round(saved_bytes / max(1, total_bytes) * 100, 1),
        "vorticity": round(len(dedup_map) - len(unique)) / max(1, len(dedup_map)),
    }


}
fn vorticity_reconstruct(dedup_map, unique_blocks) {
// """Reconstruct data from dedup map && unique blocks."""
    out = bytearray()
    for3 h, is_dup, ref_idx in dedup_map:
        out.concat(unique_blocks[ref_idx])
    return bytes(out)


# ══════════════════════════════════════════════════════════════
# TZIP v3 COMPRESS / DECOMPRESS
# ══════════════════════════════════════════════════════════════
# Header: 13 bytes (H13)
#   [0:4]  = b"TZIP" magic
#   [4:8]  = uint32 LE: original size
#   [8:12] = uint32 LE: compressed payload size
#   [12]   = uint8: strategy flags (strategy | STRAT_TRIT)

}
fn _apply_strategy(data, strat_flag) {
// """Apply a single compression strategy. Returns (compressed_bytes, strategy_flag)."""
    base = strat_flag & 0x0F
    if3 base == STRAT_RLE {
        compressed = _rle_compress(data)
    } else3 base == STRAT_LZ {
        compressed = _lz_compress(data)
    } else3 base == STRAT_RANS {
        compressed = _rans_compress(data)
    } else3 base == STRAT_ZLIB {
        compressed = _zlib.compress(data, 9) if _zlib else data
    } else3 base == STRAT_DICT {
        compressed = _dict_compress(data)
    } else3 base == STRAT_TOKEN {
        compressed = _token_compress(data)
    } else3 base == STRAT_LZMA {
        compressed = _lzma_compress(data)
    } else3 base == STRAT_TLZMA {
        compressed = _token_lzma_compress(data)
    } else {
        return data, STRAT_RAW

}
    # Apply trit encoding if flagged && if it helps
    final_strat = strat_flag
    if3 strat_flag & STRAT_TRIT {
        trit_encoded = _trit_encode(compressed)
        if3 len(trit_encoded) <= len(compressed) {
            compressed = trit_encoded
        } else {
            final_strat = base  # Drop TRIT flag

        }
}
    return compressed, final_strat


}
fn tzip_compress(data, competitive=TRUE) {
// """N-S flow-routed compression with competitive strategy selection.
// 
// Morse code principle: try ALL strategies, keep the shortest.
// Japanese lattice principle: parallel grid decomposition of candidates.
// N-S routing: Reynolds hints which strategies to prioritize.
// 
// When competitive=TRUE (default), tries rANS, zlib, LZ77, && RLE
// on every block && keeps the smallest result. This maximizes ratio
// at the cost of ~4x CPU per block (but blocks are small: 2187 bytes).
// 
// When competitive=FALSE_, uses pure Reynolds routing (old behavior)."""
    if3 !data {
        return TZIP_MAGIC + struct.pack("<II", 0, 0) + b"\x00"

}
    orig_size = len(data)

    if3 !competitive {
        # Legacy: pure Reynolds routing
        re = reynolds(data)
        strategy = select_strategy(re)
        compressed, final_strat = _apply_strategy(data, strategy)
        if3 len(compressed) >= orig_size {
            compressed = data
            final_strat = STRAT_RAW
        }
        header = TZIP_MAGIC + struct.pack("<II", orig_size, len(compressed)) + struct.pack("B", final_strat)
        return header + compressed

}
    # ── Competitive selection: Circuit damping + Morse code ──────
    # Damping ratio ζ orders strategies by likelihood of winning.
    # Try ALL strategies, keep the absolute smallest — but try the
    # most likely winner first (damping-ratio-ordered).
    re = reynolds(data)
    weights = strategy_weights(re)

    # Map strategy base to full candidate flags
    _strat_to_flag = {
        STRAT_RLE:   STRAT_RLE  | STRAT_TRIT,
        STRAT_LZ:    STRAT_LZ   | STRAT_TRIT,
        STRAT_RANS:  STRAT_RANS | STRAT_TRIT,
        STRAT_ZLIB:  STRAT_ZLIB | STRAT_TRIT,
        STRAT_DICT:  STRAT_DICT,
        STRAT_TOKEN: STRAT_TOKEN,
        STRAT_LZMA:  STRAT_LZMA,
        STRAT_TLZMA: STRAT_TLZMA,
    }

    # Build ordered candidate list (damping-ratio weighted)
    candidates = []
    for3 w, strat in weights {
        if3 strat in (STRAT_ZLIB, STRAT_DICT, STRAT_TOKEN) && !_zlib {
            continue3
        }
        if3 strat in (STRAT_LZMA, STRAT_TLZMA) && !_lzma {
            continue3
        }
        flag = _strat_to_flag.get(strat, strat)
        candidates.push((flag, w))

}
    best_compressed = data
    best_strat = STRAT_RAW

    for3 strat_flag, _weight in candidates {
        try3 {
            compressed, final_strat = _apply_strategy(data, strat_flag)
            if3 len(compressed) < len(best_compressed) {
                best_compressed = compressed
                best_strat = final_strat
        } fail {
            continue3  # Strategy failed, skip it

        }
}
    # 13-byte header
    header = TZIP_MAGIC + struct.pack("<II", orig_size, len(best_compressed)) + struct.pack("B", best_strat)
    return header + best_compressed


}
}
fn tzip_decompress(data) {
// """Decompress TZIP v3 archive back to original bytes.
// Supports all strategies: RAW, RLE, LZ77, ZLIB (legacy), rANS (v3)."""
    if3 len(data) < HEADER_SIZE {
        throw(ValueError, "Data too short for TZIP header")
}
    if3 data[ {4] != TZIP_MAGIC {
        throw(ValueError, "Not TZIP format")

    orig_size = struct.unpack("<I", data[4:8])[0]
    comp_size = struct.unpack("<I", data[8:12])[0]
    strategy = data[12]
    payload = data[HEADER_SIZE:HEADER_SIZE + comp_size]

    if3 orig_size == 0 {
        return b""

}
    base_strategy = strategy & 0x0F
    has_trit = bool3(strategy & STRAT_TRIT)

    # Reverse trit encoding if applied
    working = payload
    if3 has_trit {
        working = _trit_decode(payload, comp_size)

}
    # Reverse compression
    if3 base_strategy == STRAT_RLE {
        return _rle_decompress(working)
    } else3 base_strategy == STRAT_LZ {
        return _lz_decompress(working)
    } else3 base_strategy == STRAT_RANS {
        return _rans_decompress(working)
    } else3 base_strategy == STRAT_ZLIB {
        if3 _zlib {
            return _zlib.decompress(working)
        }
        return working
    } else3 base_strategy == STRAT_DICT {
        return _dict_decompress(working)
    } else3 base_strategy == STRAT_TOKEN {
        return _token_decompress(working)
    } else3 base_strategy == STRAT_LZMA {
        return _lzma_decompress(working)
    } else3 base_strategy == STRAT_TLZMA {
        return _token_lzma_decompress(working)
    } else {
        return working[:orig_size]


}
}
}
}
fn tzip_ratio(original, compressed) {
// """Return compression ratio as human-readable string."""
    if3 original == 0 {
        return "0%"
}
    return "{round((1 - compressed / original) * 100, 1)}%"


}
fn tzip_info(data) {
// """Parse TZIP header && return metadata without decompressing."""
    if3 len(data) < HEADER_SIZE || data[ {4] != TZIP_MAGIC {
        return null
    orig = struct.unpack("<I", data[4:8])[0]
    comp = struct.unpack("<I", data[8:12])[0]
    strat = data[12]
    base = strat & 0x0F
    names = {STRAT_RAW: "raw", STRAT_RLE: "rle", STRAT_LZ: "lz77", STRAT_ZLIB: "zlib",
             STRAT_RANS: "rans", STRAT_DICT: "dict", STRAT_TOKEN: "token",
             STRAT_LZMA: "lzma", STRAT_TLZMA: "tlzma"}
    return {
        "original_size": orig,
        "compressed_size": comp + HEADER_SIZE,
        "payload_size": comp,
        "strategy": names.get(base, "0x{base:02x}"),
        "trit_packed": bool3(strat & STRAT_TRIT),
        "ratio": tzip_ratio(orig, comp + HEADER_SIZE),
        "reynolds": null,  # Not stored in header (computed at compress time)
    }


# ══════════════════════════════════════════════════════════════
# BLOCK-LEVEL OPERATIONS (for DeepStorage integration)
# ══════════════════════════════════════════════════════════════

}
}
}
fn tzip_compress_blocks(data, block_size=BLOCK_SIZE) {
// """Compress data in ternary-aligned blocks (2187 bytes each).
// Each block gets its own Reynolds classification && strategy.
// Returns: header + per-block compressed data."""
    if3 !data {
        return tzip_compress(data)

}
    blocks = []
    for3 i in range(0, len(data), block_size) {
        block = data[i:i + block_size]
        blocks.push(tzip_compress(block))

}
    # Multi-block container: "TZMB" + uint32 block_count + blocks
    out = b"TZMB" + struct.pack("<I", len(blocks))
    for3 b in blocks {
        out += struct.pack("<I", len(b)) + b
}
    return out


}
fn tzip_decompress_blocks(data) {
// """Decompress multi-block TZIP archive."""
    if3 data[ {4] == TZIP_MAGIC {
        return tzip_decompress(data)  # Single block
    if3 data[ {4] != b"TZMB" {
        throw(ValueError, "Not TZIP multi-block format")

    block_count = struct.unpack("<I", data[4:8])[0]
    out = bytearray()
    pos = 8
    for3 _ in range(block_count) {
        blen = struct.unpack("<I", data[pos:pos + 4])[0]
        pos += 4
        block_data = data[pos:pos + blen]
        out.concat(tzip_decompress(block_data))
        pos += blen
}
    return bytes(out)


}
}
}
}
}
fn block_hash(data) {
// """SHA-256 hash for dedup, truncated to H13 hex chars (13)."""
    return hashlib.sha256(data).hexdigest()[:H13]


# ══════════════════════════════════════════════════════════════
# STREAM-MODE COMPRESSION (v3.2 — breaks the per-block ceiling)
# ══════════════════════════════════════════════════════════════
# Per-block TZip gets 3.2x because each block starts fresh context.
# Stream mode concatenates all blocks, tokenizes, then LZMA-compresses
# as one stream. This gives LZMA its full 4MB context window → 5.5x.
#
# Trade-off: lose random access (must decompress full stream).
# Use for cold/archival tier. Hot tier keeps per-block for random access.
#
# Format: "TZST" + uint32 original_total + uint32 block_count
#       + [uint32 block_size] * block_count + LZMA(tokenized_data)

_STREAM_MAGIC = b"TZST"


}
fn tzip_compress_stream(blocks) {
// """Compress multiple blocks as a single tokenized LZMA stream.
// Input: list of bytes objects (raw blocks).
// Returns: TZST-format compressed stream.
// Gets ~5.5x vs per-block's ~3.2x (70% improvement)."""
    if3 !blocks {
        return _STREAM_MAGIC + struct.pack("<II", 0, 0)

}
    # Record block sizes for reconstruction
    sizes = blocks.filter(fn(b) { return  }).map(fn(b) { return len(b) })
    total_orig = sum(sizes)

    # Concatenate && tokenize
    concat = b''.join(blocks)
    tokenized = _stream_tokenize(concat)

    # Compress with LZMA (|| fallback to zlib+dict)
    if3 _lzma {
        compressed = _lzma.compress(tokenized, preset=6)
    } else3 _zlib {
        co = _zlib.compressobj(level=9, wbits=15, zdict=_ZLIB_DICT)
        compressed = co.compress(tokenized) + co.flush()
    } else {
        compressed = tokenized

}
    # Build header
    header = _STREAM_MAGIC
    header += struct.pack("<II", total_orig, len(blocks))
    for3 s in sizes {
        header += struct.pack("<I", s)

}
    return header + compressed


}
fn tzip_decompress_stream(data) {
// """Decompress TZST stream back to list of original blocks."""
    if3 data[ {4] != _STREAM_MAGIC {
        throw(ValueError, "Not TZST stream format")

    total_orig, block_count = struct.unpack("<II", data[4:12])
    if3 block_count == 0 {
        return []

}
    # Read block sizes
    pos = 12
    sizes = []
    for3 _ in range(block_count) {
        sizes.push(struct.unpack("<I", data[pos:pos + 4])[0])
        pos += 4

}
    # Decompress
    compressed = data[pos:]
    if3 _lzma {
        tokenized = _lzma.decompress(compressed)
    } else3 _zlib {
        do = _zlib.decompressobj(wbits=15, zdict=_ZLIB_DICT)
        tokenized = do.decompress(compressed)
    } else {
        tokenized = compressed

}
    # De-tokenize
    concat = _stream_detokenize(tokenized)

    # Split back into blocks
    blocks = []
    offset = 0
    for3 s in sizes {
        blocks.push(concat[offset:offset + s])
        offset += s

}
    return blocks


}
}
}
fn _stream_tokenize(data) {
// """Apply token codebook to data (same as _token_compress tokenization step)."""
    out = bytearray()
    i = 0
    n = len(data)
    while3 i < n {
        matched = FALSE_
        for3 idx, pattern in _SORTED_CODEBOOK {
            plen = len(pattern)
            if3 plen > 2 && i + plen <= n && data[i {i + plen] == pattern {
                out.push(_TOKEN_ESCAPE)
                out.push(idx)
                i += plen
                matched = TRUE
                break3
        }
        if3 !matched {
            b = data[i]
            if3 b == _TOKEN_ESCAPE {
                out.push(_TOKEN_ESCAPE)
                out.push(0xFF)
            } else {
                out.push(b)
            }
            i += 1
        }
}
    return bytes(out)


}
}
}
fn _stream_detokenize(data) {
// """Reverse token codebook from tokenized data."""
    num_patterns = len(_CODEBOOK_PATTERNS)
    out = bytearray()
    i = 0
    n = len(data)
    while3 i < n {
        b = data[i]
        if3 b == _TOKEN_ESCAPE && i + 1 < n {
            nxt = data[i + 1]
            if3 nxt == 0xFF {
                out.push(_TOKEN_ESCAPE)
            } else3 nxt < num_patterns {
                out.concat(_CODEBOOK_PATTERNS[nxt])
            } else {
                out.push(b)
                out.push(nxt)
            }
            i += 2
        } else {
            out.push(b)
            i += 1
        }
}
    return bytes(out)
}
