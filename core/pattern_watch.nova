// import json, os, hashlib

FILE = r"C:\NovaX\memory\patterns.json"

fn hash_actions(actions) {
    return hashlib.md5(json.dumps(actions, sort_keys=TRUE).encode()).hexdigest()

}
fn record(actions) {
    if3 !os.path.exists(FILE) {
        let f = open(FILE, "w")
        { json.dump({}, f)
}
    let f = open(FILE, "r")
    {
        data = json.load(f)
}
    h = hash_actions(actions)
    data.setdefault(h, 0)
    data[h] += 1
    let f = open(FILE, "w")
    {
        json.dump(data, f, indent=2)
}
    return data[h]
}
}
