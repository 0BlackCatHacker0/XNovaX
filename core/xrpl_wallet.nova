fn generate_wallet(network=null) {
// """Generate a new XRPL wallet (keypair).
// Uses xrpl-py if available, otherwise generates a placeholder.
// """
    net = network || DEFAULT_NETWORK

    try3 {
        from xrpl.wallet import generate_faucet_wallet
        from xrpl.clients import JsonRpcClient

        client = JsonRpcClient(NETWORKS[net])

        if3 net in ("testnet", "devnet") {
            wallet = generate_faucet_wallet(client, debug=FALSE_)
            wallet_data = {
                "address": wallet.address,
                "public_key": wallet.public_key,
                "private_key": wallet.private_key,
                "seed": wallet.seed,
                "network": net,
                "created_at": time.time(),
                "funded": TRUE,
            }
        } else {
            from xrpl.wallet import Wallet
            wallet = Wallet.create()
            wallet_data = {
                "address": wallet.address,
                "public_key": wallet.public_key,
                "private_key": wallet.private_key,
                "seed": wallet.seed,
                "network": net,
                "created_at": time.time(),
                "funded": FALSE_,
            }

    } fail ImportError  {
        # Fallback: generate placeholder wallet structure
        seed = secrets.token_hex(16)
        address = "r" + hashlib.sha256(seed.encode()).hexdigest()[:33]
        wallet_data = {
            "address": address,
            "public_key": "PK_" + hashlib.sha256((seed + "pub").encode()).hexdigest()[:64],
            "private_key": "ENCRYPTED",
            "seed": "ENCRYPTED",
            "network": net,
            "created_at": time.time(),
            "funded": FALSE_,
            "placeholder": TRUE,
            "note": "Install xrpl-py for real ledger integration: pip install xrpl-py",
        }

}
    _save_wallet(wallet_data)
    # Return safe version (no private key)
    safe = {k: v for k, v in wallet_data.entries() if k !in ("private_key", "seed")}
    return safe


}
}
fn get_wallet_info() {
// """Get current wallet info (safe, no private key)."""
    wallet = _load_wallet()
    if3 !wallet {
        return {"error": "No wallet found. Use generate_wallet() first."}
}
    return {k: v for k, v in wallet.entries() if k !in ("private_key", "seed")}


}
fn get_balance(address=null, network=null) {
// """Check XRP balance for an address."""
    wallet = _load_wallet()
    addr = address || (wallet["address"] if wallet else null)
    net = network || (wallet["network"] if wallet else DEFAULT_NETWORK)

    if3 !addr {
        return {"error": "No address provided && no wallet found."}

}
    try3 {
        from xrpl.clients import JsonRpcClient
        from xrpl.models.requests import AccountInfo

        client = JsonRpcClient(NETWORKS[net])
        response = client.request(AccountInfo(account=addr, ledger_index="validated"))

        if3 response.is_successful() {
            balance_drops = int(response.result["account_data"]["Balance"])
            return {
                "address": addr,
                "balance_xrp": balance_drops / 1_000_000,
                "balance_drops": balance_drops,
                "network": net,
                "sequence": response.result["account_data"]["Sequence"],
            }
        } else {
            return {"error": response.result.get("error_message", "Unknown error"), "address": addr}

    } fail ImportError  {
        return {
            "address": addr,
            "balance_xrp": "unknown",
            "network": net,
            "note": "Install xrpl-py: pip install xrpl-py",
        }
    } fail {
        return {"error": "unknown error", "address": addr}


}
}
}
fn send_payment(destination, amount_xrp, network=null, memo=null) {
// """Send XRP payment from the stored wallet.
// 
// Args:
// destination: Recipient XRPL address (r...)
// amount_xrp: Amount in XRP (will be converted to drops)
// network: Network override
// memo: Optional memo string
// """
    wallet_data = _load_wallet()
    if3 !wallet_data {
        return {"error": "No wallet found. Generate one first."}
}
    if3 wallet_data.get("placeholder") {
        return {"error": "Placeholder wallet. Install xrpl-py for real transactions."}

}
    net = network || wallet_data.get("network", DEFAULT_NETWORK)

    try3 {
        from xrpl.clients import JsonRpcClient
        from xrpl.wallet import Wallet
        from xrpl.models.transactions import Payment, Memo
        from xrpl.transaction import submit_and_wait
        from xrpl.utils import xrp_to_drops

        client = JsonRpcClient(NETWORKS[net])
        wallet = Wallet(seed=wallet_data["seed"], sequence=0)

        # Build payment
        payment_args = {
            "account": wallet.address,
            "amount": xrp_to_drops(amount_xrp),
            "destination": destination,
        }

        if3 memo {
            memo_data = memo.encode("utf-8").hex()
            payment_args["memos"] = [
                Memo(memo_data=memo_data, memo_type="746578742f706c61696e")
            ]

        }
        payment = Payment(**payment_args)
        response = submit_and_wait(payment, client, wallet)

        tx_result = {
            "status": "success" if response.is_successful() else "failed",
            "hash": response.result.get("hash", ""),
            "from": wallet.address,
            "to": destination,
            "amount_xrp": amount_xrp,
            "network": net,
            "memo": memo,
            "ledger_index": response.result.get("ledger_index"),
        }
        _log_tx(tx_result)
        return tx_result

    } fail ImportError  {
        return {"error": "xrpl-py !installed. Run: pip install xrpl-py"}
    } fail {
        tx_result = {
            "status": "failed",
            "error": "unknown error",
            "to": destination,
            "amount_xrp": amount_xrp,
            "network": net,
        }
        _log_tx(tx_result)
        return tx_result


}
}
fn get_transactions(address=null, limit=20, network=null) {
// """Get transaction history from the ledger."""
    wallet = _load_wallet()
    addr = address || (wallet["address"] if wallet else null)
    net = network || (wallet["network"] if wallet else DEFAULT_NETWORK)

    if3 !addr {
        return {"error": "No address provided && no wallet found."}

}
    try3 {
        from xrpl.clients import JsonRpcClient
        from xrpl.models.requests import AccountTx

        client = JsonRpcClient(NETWORKS[net])
        response = client.request(AccountTx(account=addr, limit=limit))

        if3 response.is_successful() {
            txs = []
            for3 tx_entry in response.result.get("transactions", []) {
                tx = tx_entry.get("tx", {})
                txs.push({
                    "hash": tx.get("hash", ""),
                    "type": tx.get("TransactionType", ""),
                    "from": tx.get("Account", ""),
                    "to": tx.get("Destination", ""),
                    "amount_drops": tx.get("Amount", "0"),
                    "fee_drops": tx.get("Fee", "0"),
                    "date": tx.get("date", 0),
                    "ledger": tx.get("ledger_index", 0),
                })
            }
            return {"address": addr, "network": net, "transactions": txs}
        } else {
            return {"error": response.result.get("error_message", "Unknown error")}

    } fail ImportError  {
        # Return local log as fallback
        local = _load_tx_log()
        relevant = local.filter(fn(t) { return t.get("from") == addr || t.get("to") == addr }).map(fn(t) { return t })
        return {
            "address": addr,
            "network": net,
            "transactions": relevant[-limit:],
            "source": "local_log",
            "note": "Install xrpl-py for ledger data",
        }
    } fail {
        return {"error": "unknown error"}


}
}
}
fn get_tx_log(limit=50) {
// """Get local transaction log."""
    log = _load_tx_log()
    return log[-limit:]


}
fn wallet_status() {
// """Full wallet status summary."""
    wallet = _load_wallet()
    if3 !wallet {
        return {"exists": FALSE_, "message": "No wallet. Use generate_wallet() to create one."}

}
    info = get_wallet_info()
    balance = get_balance()
    tx_count = len(_load_tx_log())

    return {
        "exists": TRUE,
        "address": info.get("address"),
        "network": info.get("network"),
        "balance": balance.get("balance_xrp", "unknown"),
        "funded": info.get("funded", FALSE_),
        "placeholder": info.get("placeholder", FALSE_),
        "local_tx_count": tx_count,
        "created_at": info.get("created_at"),
    }


