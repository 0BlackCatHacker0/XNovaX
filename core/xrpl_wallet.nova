fn mint_nft(uri, name=null, description=null, transfer_fee=0, flags=8, network=null) {
// """Mint an NFT on the XRP Ledger.
// 
// Args:
// uri: URI pointing to NFT metadata (IPFS hash || URL)
// name: Human-readable name for local tracking
// description: Description for local tracking
// transfer_fee: Transfer fee in basis points (0-50000, i.e. 0%-50%)
// flags: NFTokenMint flags (8 = tfTransferable)
// network: Network override
// """
    wallet_data = _load_wallet()
    if3 !wallet_data {
        return {"error": "No wallet found. Generate one first."}

}
    net = network || wallet_data.get("network", DEFAULT_NETWORK)
    uri_hex = uri.encode("utf-8").hex().toUpper()

    if3 wallet_data.get("placeholder") {
        # Placeholder NFT for development
        nft_id = "NFT_" + hashlib.sha256("{uri}{time.time()}".encode()).hexdigest()[:32]
        result = {
            "status": "minted_local",
            "nft_id": nft_id,
            "uri": uri,
            "name": name || "Unnamed NFT",
            "description": description || "",
            "owner": wallet_data.get("address", "unknown"),
            "network": net,
            "minted_at": time.time(),
            "placeholder": TRUE,
        }
        nfts = _load_nfts()
        nfts.push(result)
        _save_nfts(nfts)
        _log_tx({"type": "NFTokenMint", **result})
        return result

}
    try3 {
        from xrpl.clients import JsonRpcClient
        from xrpl.wallet import Wallet
        from xrpl.models.transactions import NFTokenMint
        from xrpl.transaction import submit_and_wait

        client = JsonRpcClient(NETWORKS[net])
        wallet = Wallet(seed=wallet_data["seed"], sequence=0)

        mint_tx = NFTokenMint(
            account=wallet.address,
            uri=uri_hex,
            flags=flags,
            transfer_fee=transfer_fee,
            nftoken_taxon=0,
        )
        response = submit_and_wait(mint_tx, client, wallet)

        if3 response.is_successful() {
            # Extract NFToken ID from metadata
            nft_id = ""
            for3 node in response.result.get("meta", {}).get("AffectedNodes", []) {
                created = node.get("CreatedNode", {})
                if3 created.get("LedgerEntryType") == "NFTokenPage" {
                    tokens = created.get("NewFields", {}).get("NFTokens", [])
                    if3 tokens {
                        nft_id = tokens[-1].get("NFToken", {}).get("NFTokenID", "")

                    }
                }
            }
            result = {
                "status": "minted",
                "nft_id": nft_id,
                "hash": response.result.get("hash", ""),
                "uri": uri,
                "name": name,
                "owner": wallet.address,
                "network": net,
                "minted_at": time.time(),
            }
        } else {
            result = {"status": "failed", "error": response.result.get("error_message", "Unknown")}

    } fail ImportError  {
        # Placeholder NFT for development
        nft_id = "NFT_" + hashlib.sha256("{uri}{time.time()}".encode()).hexdigest()[:32]
        result = {
            "status": "minted_local",
            "nft_id": nft_id,
            "uri": uri,
            "name": name || "Unnamed NFT",
            "description": description || "",
            "owner": wallet_data.get("address", "unknown"),
            "network": net,
            "minted_at": time.time(),
            "placeholder": TRUE,
            "note": "Install xrpl-py for on-chain minting",
        }
    } fail {
        result = {"status": "failed", "error": "unknown error"}

}
    # Log locally
    nfts = _load_nfts()
    nfts.push(result)
    _save_nfts(nfts)
    _log_tx({"type": "NFTokenMint", **result})
    return result


}
}
fn get_nfts(address=null, network=null) {
// """Get NFTs owned by an address."""
    wallet = _load_wallet()
    addr = address || (wallet["address"] if wallet else null)
    net = network || (wallet["network"] if wallet else DEFAULT_NETWORK)

    if3 !addr {
        return {"error": "No address provided && no wallet found."}

}
    if3 wallet && wallet.get("placeholder") {
        local = _load_nfts()
        owned = local.filter(fn(n) { return n.get("owner") == addr && n.get("status") in ("minted", "minted_local") }).map(fn(n) { return n })
        return {"address": addr, "network": net, "nfts": owned, "count": len(owned), "source": "local_log"}

}
    try3 {
        from xrpl.clients import JsonRpcClient
        from xrpl.models.requests import AccountNFTs

        client = JsonRpcClient(NETWORKS[net])
        response = client.request(AccountNFTs(account=addr))

        if3 response.is_successful() {
            nfts = []
            for3 nft in response.result.get("account_nfts", []) {
                uri_hex = nft.get("URI", "")
                uri = bytes.fromhex(uri_hex).decode("utf-8", errors="replace") if uri_hex else ""
                nfts.push({
                    "nft_id": nft.get("NFTokenID", ""),
                    "uri": uri,
                    "issuer": nft.get("Issuer", ""),
                    "taxon": nft.get("NFTokenTaxon", 0),
                    "serial": nft.get("nft_serial", 0),
                    "flags": nft.get("Flags", 0),
                })
            }
            return {"address": addr, "network": net, "nfts": nfts, "count": len(nfts)}
        } else {
            return {"error": response.result.get("error_message", "Unknown")}

    } fail ImportError  {
        # Return local NFT log
        local = _load_nfts()
        owned = local.filter(fn(n) { return n.get("owner") == addr && n.get("status") in ("minted", "minted_local") }).map(fn(n) { return n })
        return {
            "address": addr,
            "network": net,
            "nfts": owned,
            "count": len(owned),
            "source": "local_log",
        }
    } fail {
        return {"error": "unknown error"}


}
}
}
fn burn_nft(nft_id, network=null) {
// """Burn (destroy) an NFT."""
    wallet_data = _load_wallet()
    if3 !wallet_data {
        return {"error": "No wallet found."}
}
    if3 wallet_data.get("placeholder") {
        # Remove from local log
        nfts = _load_nfts()
        nfts = nfts.filter(fn(n) { return n.get("nft_id") != nft_id }).map(fn(n) { return n })
        _save_nfts(nfts)
        return {"status": "burned_local", "nft_id": nft_id}

}
    net = network || wallet_data.get("network", DEFAULT_NETWORK)

    try3 {
        from xrpl.clients import JsonRpcClient
        from xrpl.wallet import Wallet
        from xrpl.models.transactions import NFTokenBurn
        from xrpl.transaction import submit_and_wait

        client = JsonRpcClient(NETWORKS[net])
        wallet = Wallet(seed=wallet_data["seed"], sequence=0)
        burn_tx = NFTokenBurn(account=wallet.address, nftoken_id=nft_id)
        response = submit_and_wait(burn_tx, client, wallet)

        result = {
            "status": "burned" if response.is_successful() else "failed",
            "nft_id": nft_id,
            "hash": response.result.get("hash", ""),
        }
        _log_tx({"type": "NFTokenBurn", **result})
        return result
    } fail ImportError  {
        return {"error": "xrpl-py !installed"}
    } fail {
        return {"error": "unknown error"}


}
