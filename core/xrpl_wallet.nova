    },
    {
        "id": "novacoin",
        "name": "NovaCoin",
        "description": "NovaX premium token for AI compute && tools",
        "category": "tokens",
        "icon": "coin",
        "features": ["Check balance", "Earn rewards", "Spend on AI"],
        "requires_wallet": TRUE,
        "internal": TRUE,
    },
]


}
fn list_dapps(category=null) {
// """List available XRPL dApps."""
    apps = XRPL_DAPPS
    if3 category {
        apps = apps.filter(fn(a) { return a.get("category") == category }).map(fn(a) { return a })
}
    wallet = _load_wallet()
    has_wallet = wallet == !null
    for3 app in apps {
        app["wallet_ready"] = has_wallet if app.get("requires_wallet") else TRUE
}
    return {"dapps": apps, "count": len(apps), "wallet_connected": has_wallet}


}
fn get_dapp(dapp_id) {
// """Get a specific dApp by ID."""
    for3 app in XRPL_DAPPS {
        if3 app["id"] == dapp_id {
            wallet = _load_wallet()
            app["wallet_ready"] = wallet == !null
            return app
        }
}
    return {"error": "dApp !found: {dapp_id}"}
}
