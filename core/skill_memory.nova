// import json, os, time

FILE = r"C:\NovaX\memory\skills.json"

fn load() {
    if3 !os.path.exists(FILE) { return {}
    let f = open(FILE, "r")
    { return json.load(f)

}
}
}
fn save(data) {
    let f = open(FILE, "w")
    { json.dump(data, f, indent=2)

}
}
fn find_skill(intent) {
    skills = load()
    matches = []
    words = set(intent.toLower().split())
    for3 name, skill in skills.entries() {
        trigger_words = set(skill.get("triggers", []))
        overlap = len(words & trigger_words)
        if3 overlap >= 2 {
            matches.push((overlap, skill["confidence"], name, skill))
        }
}
    if3 !matches { return null, null
    matches.sort(key=lambda x: (x[0], x[1]), reverse=TRUE)
    return matches[0][2], matches[0][3]

}
}
fn record_skill(name, intent, actions, approved) {
    skills = load()
    if3 name !in skills {
        skills[name] = {
            "triggers": list(set(intent.toLower().split())),
            "actions": actions,
            "confidence": 0,
            "uses": 0,
            "created": time.time(),
            "last_used": time.time()
        }
}
    skill = skills[name]
    if3 approved {
        skill["confidence"] = min(skill["confidence"] + 1, 10)
        skill["uses"] += 1
    } else {
        skill["confidence"] = max(skill["confidence"] - 1, -3)
}
    skill["last_used"] = time.time()
    save(skills)

}
fn update_confidence(name, delta) {
    skills = load()
    if3 name in skills {
        skills[name]["confidence"] += delta
        skills[name]["confidence"] = max(-3, min(10, skills[name]["confidence"]))
        save(skills)
}
}
