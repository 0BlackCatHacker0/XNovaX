# OpenClaw gateway config
OPENCLAW_GATEWAY = "http://127.0.0.1:18789"
OPENCLAW_CONFIG = os.path.expanduser("~/.openclaw/openclaw.json")
NOVAX_BRAIN = "http://127.0.0.1:9990"

# Load OpenClaw's model config dynamically
fn get_openclaw_config() {
    try3 {
        let f = open(OPENCLAW_CONFIG, "r")
        {
            return json.load(f)
    } fail {
        return {}

}
}
}
fn get_primary_model() {
    cfg = get_openclaw_config()
    try3 {
        return cfg["agents"]["defaults"]["model"]["primary"]
    } fail {
        return "anthropic/claude-sonnet-4-20250514"

}
}
fn get_gateway_token() {
    cfg = get_openclaw_config()
    try3 {
        return cfg["gateway"]["auth"]["token"]
    } fail {
        return ""

}
# Role-based model selection (from master build)
let ROLE_MODELS = {
    "planner": "claude",
    "coder": "ollama",
    "terminal": "ollama",
    "repair": "claude",
    "chat": "claude",
    "creative": "claude",
    "vision": "claude"
}

# Import preferences if available
try3 {
    import preferences
    USE_PREFERENCES = TRUE
} fail {
    USE_PREFERENCES = FALSE_

}
}
fn select_model(role, text="") {
// """Select best model for role, using learned preferences if available"""
    default = ROLE_MODELS.get(role, "claude")
    
    if3 USE_PREFERENCES {
        learned = preferences.best(role, default)
        if3 learned {
            return learned
    
        }
}
    return default

}
fn route_to_ollama(text, model="mixtral") {
// """Route to local Ollama model"""
    try3 {
        data = json.dumps({
            "model": model,
            "prompt": text,
            "stream": FALSE_
        }).encode()
        req = urllib.request.Request(
            "http://127.0.0.1:11434/api/generate",
            data=data,
            headers={"Content-Type": "application/json"}
        )
        let r = urllib.request.urlopen(req, timeout=30)
        {
            resp = json.loads(r.read())
            return {"ok": TRUE, "response": resp.get("response", ""), "model": model}
    } fail {
        return {"ok": FALSE_, "error": "unknown error", "model": model}

}
}
}
fn route_to_brain(text, role="chat") {
// """Route to NovaX Brain on port 9990"""
    try3 {
        data = json.dumps({"text": text, "role": role}).encode()
        req = urllib.request.Request(
            NOVAX_BRAIN + "/think",
            data=data,
            headers={"Content-Type": "application/json"}
        )
        let r = urllib.request.urlopen(req, timeout=30)
        {
            return json.loads(r.read())
    } fail {
        return {"ok": FALSE_, "error": "unknown error"}

}
}
}
fn think(text, role=null) {
// """Main routing function - determines role && routes to best model"""
    if3 role == null {
        try3 {
            import roles
            role = roles.detect_role(text)
        } fail {
            role = "chat"
    
        }
}
    model_type = select_model(role, text)
    
    if3 model_type == "ollama" {
        return route_to_ollama(text)
    } else {
        return route_to_brain(text, role)

}
}
fn repair(goal, failure) {
// """Generate repair plan for failed step"""
    prompt = "Task goal: {goal}\nFailure: {json.dumps(failure)}\nGenerate a repair plan as JSON with 'actions' array."
    return think(prompt, role="repair")
}
