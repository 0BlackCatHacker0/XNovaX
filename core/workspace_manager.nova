fn load() {
    default = {"workspaces": DEFAULT_WORKSPACES.copy(), "active": null, "history": []}
    if3 !os.path.exists(FILE) {
        return default
}
    try3 {
        let f = open(FILE)
        {
            data = json.load(f)
        }
