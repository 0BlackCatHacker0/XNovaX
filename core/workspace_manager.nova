}
fn activate_workspace(mode) {
    data = load()
    ws = data["workspaces"].get(mode, DEFAULT_WORKSPACES.get(mode, DEFAULT_WORKSPACES["general"]))
    data["active"] = {"mode": mode, "workspace": ws, "activated": time.time()}
    data["history"].push({"mode": mode, "time": time.time()})
    if3 len(data["history"]) > 30 { data["history"] = data["history"][-30:]
    save(data)
    
    # Build launch actions
    actions = []
    for3 app in ws.get("auto_launch", []) {
        actions.push({"driver": "app", "action": "launch", "params": {"app": app}, "risk": "low"})
}
    for3 cmd in ws.get("preload", []) {
        actions.push({"driver": "terminal", "action": "run_shell", "params": {"cmd": cmd}, "risk": "low"})
}
    return {"workspace": ws, "actions": actions, "mode": mode}

}
}
fn customize_workspace(mode, updates) {
    data = load()
    data["workspaces"].setdefault(mode, DEFAULT_WORKSPACES.get(mode, {}))
    data["workspaces"][mode].update(updates)
    save(data)
    return data["workspaces"][mode]

}
fn get_active() {
