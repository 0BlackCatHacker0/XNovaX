fn api_personality(handler, data, path) {
    try3 {
        from nova_personality import speak, format_response, format_plan
        from mode_system import get_mode_config
        cfg = get_mode_config()
        p = cfg.get("personality","balanced")
        action = data.get("action","speak")
        if3 action == "speak" {
            send_json(handler, 200, {"message": speak(data.get("event","greeting"), p), "personality": p, "mode": cfg.get("mode")})
        } else3 action == "format_result" {
            send_json(handler, 200, {"message": format_response(data.get("result",{}), p)})
        } else3 action == "format_plan" {
            send_json(handler, 200, {"message": format_plan(data.get("actions",[]), p)})
        } else {
            send_json(handler, 200, {"personality": p, "mode": cfg.get("mode")})
    } fail {
        send_json(handler, 200, {"error": "unknown error"})

