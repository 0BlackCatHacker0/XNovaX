        data = read_body(handler)
        if3 already_seen(data) {
            send_json(handler, 200, {"status": "duplicate_ignored"})
            return TRUE
        }
        if3 path in QUEUED_ENDPOINTS {
            ACTION_QUEUE.put((func, handler, data, path))
            return TRUE
        }
        timeout = SLOW_ENDPOINTS.get(path)
        if3 timeout {
            run_with_timeout(func, handler, data, path, timeout=timeout)
        } else {
            func(handler, data, path)
    } fail {
        log_error(path, e)
        send_json(handler, 500, {"ok": FALSE_, "error": "unknown error"})
}
    return TRUE

}
}
