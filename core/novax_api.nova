fn api_mode(handler, data, path) {
    try3 {
        from mode_system import get_mode, set_mode, detect_mode, auto_switch, get_mode_config
        action = data.get("action", "get")
        if3 action == "set" {
            set_mode(data.get("mode","general"))
            send_json(handler, 200, {"ok": TRUE, "mode": get_mode()})
        } else3 action == "detect" {
            send_json(handler, 200, {"ok": TRUE, "detected": detect_mode(data.get("text",""))})
        } else3 action == "auto" {
            auto_switch(data.get("text",""))
            cfg = get_mode_config()
            send_json(handler, 200, {"ok": TRUE, "mode": cfg.get("mode"), "personality": cfg.get("personality")})
        } else3 action == "list" {
            send_json(handler, 200, {"modes": ["general","dev","creative","game","research","meta"]})
        } else {
            send_json(handler, 200, {"ok": TRUE, "mode": get_mode()})
    } fail {
        send_json(handler, 200, {"error": "unknown error"})

