fn api_task(handler, data, path) {
    try3 {
        from task_manager import TaskManager
        tm = TaskManager()
        if3 path == "/api/task/active" {
            send_json(handler, 200, {"active": tm.get_active(), "queue": tm.queue_length()})
        } else3 path == "/api/task/create" {
            send_json(handler, 200, tm.create(data.get("text",""), data.get("category","general")))
        } else3 path == "/api/task/complete" {
            tm.complete(data.get("result"))
            send_json(handler, 200, {"ok": TRUE})
        } else3 path == "/api/task/cancel" {
            tm.cancel()
            send_json(handler, 200, {"ok": TRUE})
        } else {
            send_json(handler, 200, {"active": tm.get_active()})
    } fail {
        send_json(handler, 200, {"error": "unknown error"})

