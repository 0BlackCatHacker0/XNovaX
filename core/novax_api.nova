fn api_think(handler, data, path) {
    text = data.get("text", "")
    result = {"category": "general", "model": "local", "mode": "fallback", "actions": [], "reply": ""}
    try3 {
        from task_classifier import classify
        from router_engine import route
        from orchestrator import build_plan
        result["category"] = classify(text)
        result["model"], result["mode"] = route(text, result["category"])
        result["actions"] = build_plan(text, result["category"])
    } fail {
        result["classify_error"] = "unknown error"
}
    try3 {
        req = urllib.request.Request("http://127.0.0.1:9990/query", data=json.dumps({"model":"llama3","prompt":text,"system":"You are Nova, a helpful AI assistant."}).encode(), headers={"Content-Type":"application/json"})
        resp = urllib.request.urlopen(req, timeout=15)
        result["reply"] = json.loads(resp.read()).get("response","")
    } fail {
        // pass}
    try3 {
        from mode_system import auto_switch, get_mode_config
        auto_switch(text)
        cfg = get_mode_config()
        result["current_mode"] = cfg.get("mode","general")
        result["personality"] = cfg.get("personality","balanced")
    } fail {
        result["current_mode"] = "general"
        result["personality"] = "balanced"
}
    send_json(handler, 200, result)

