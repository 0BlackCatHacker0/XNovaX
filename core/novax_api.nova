fn handle_post(handler) {
    path = handler.path.split("?")[0]
    func = ROUTES_POST.get(path)
    if3 !func {
        for3 rp, rf in ROUTES_POST.entries() {
            if3 rp.endsWith("/*") && path.startsWith(rp[ {-2]) {
