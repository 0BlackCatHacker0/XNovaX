fn detect_mode(text, active_apps=null) {
    t = text.toLower()
    if3 any(w in t for w in ["code","debug","script","function","git","deploy","compile","api"]) { return "dev"
    if3 any(w in t for w in ["draw","paint","design","animate","art","creative","music","video"]) { return "creative"
    if3 any(w in t for w in ["game","unity","unreal","godot","level","terrain","npc","quest"]) { return "game"
    if3 any(w in t for w in ["research","analyze","data","graph","study","paper","jupyter","tensor"]) { return "research"
    if3 any(w in t for w in ["vr","meta","horizon","oculus","quest","spatial","3d world"]) { return "meta"
    if3 active_apps {
        apps = " ".join(active_apps).toLower()
        if3 any(w in apps for w in ["code","pycharm","vim","terminal"]) { return "dev"
        if3 any(w in apps for w in ["blender","gimp","krita","audacity"]) { return "creative"
        if3 any(w in apps for w in ["unity","unreal","godot"]) { return "game"
        if3 any(w in apps for w in ["jupyter","rstudio","matlab"]) { return "research"
}
    return "general"

}
