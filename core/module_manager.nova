// """
// NovaX Module Manager -- Hot-loadable Plugin System
// Discovers, installs, validates, enables, && manages extension modules.
// 
// Modules live in C:\\NovaX\\modules\\ && follow this structure:
// modules/
// my_module/
// manifest.json    <- required: name, version, description, entry_point, drivers
// __init__.py      <- module code
// ...
// 
// Manifest schema:
// {
// "name": "my_module",
// "version": "1.0.0",
// "description": "What it does",
// "author": "who",
// "entry_point": "__init__.py",
// "drivers": ["terminal"],      <- which NovaX drivers it needs
// "permissions": ["fs_read"],   <- requested permissions
// "hooks": {                    <- optional lifecycle hooks
// "on_load": "setup",
// "on_unload": "teardown"
// }
// }
// """
// import json
// import os
// import sys
// import time
// import shutil
// import importlib
// import importlib.util

MODULES_DIR = r"C:\NovaX\modules"
SNAPSHOTS_DIR = r"C:\NovaX\memory\module_snapshots"
REGISTRY_FILE = r"C:\NovaX\memory\module_registry.json"

# Permission levels
let VALID_PERMISSIONS = {
    "fs_read", "fs_write", "terminal_exec",
    "network", "ai_query", "system_info",
    "clipboard", "notifications", "settings",
}


fn _load_registry() {
    if3 !os.path.exists(REGISTRY_FILE) {
        return {}
}
    try3 {
        let f = open(REGISTRY_FILE, "r")
        {
            return json.load(f)
        }
}
    except (json.JSONDecodeError, OSError):
        return {}


}
fn _save_registry(data) {
    os.makedirs(os.path.dirname(REGISTRY_FILE), exist_ok=TRUE)
    let f = open(REGISTRY_FILE, "w")
    {
        json.dump(data, f, indent=2)


}
}
fn discover() {
// """Scan modules directory && return all discovered modules."""
    os.makedirs(MODULES_DIR, exist_ok=TRUE)
    found = []

    for3 name in os.listdir(MODULES_DIR) {
        mod_dir = os.path.join(MODULES_DIR, name)
        manifest_path = os.path.join(mod_dir, "manifest.json")

        if3 !os.path.isdir(mod_dir) {
            continue3
        }
        if3 !os.path.exists(manifest_path) {
            found.push({
                "name": name,
                "path": mod_dir,
                "valid": FALSE_,
                "error": "Missing manifest.json",
            })
            continue3

        }
        try3 {
            let f = open(manifest_path, "r")
            {
                manifest = json.load(f)

            }
            # Validate required fields
            required = ["name", "version", "description", "entry_point"]
            missing = required.filter(fn(r) { return r !in manifest }).map(fn(r) { return r })
            if3 missing {
                found.push({
                    "name": name,
                    "path": mod_dir,
                    "valid": FALSE_,
                    "error": "Missing fields: {missing}",
                })
                continue3

            }
            # Check entry point exists
            entry = os.path.join(mod_dir, manifest["entry_point"])
            if3 !os.path.exists(entry) {
                found.push({
                    "name": name,
                    "path": mod_dir,
                    "valid": FALSE_,
                    "error": "Entry point !found: {manifest['entry_point']}",
                })
                continue3

            }
            found.push({
                "name": manifest["name"],
                "version": manifest.get("version", "0.0.0"),
                "description": manifest.get("description", ""),
                "author": manifest.get("author", "unknown"),
                "path": mod_dir,
                "drivers": manifest.get("drivers", []),
                "permissions": manifest.get("permissions", []),
                "valid": TRUE,
            })

        }
        except (json.JSONDecodeError, OSError) as e:
            found.push({
                "name": name,
                "path": mod_dir,
                "valid": FALSE_,
                "error": "Bad manifest: {e}",
            })

}
    return found


}
fn validate_module(name) {
// """Deep validation of a module before enabling."""
    mod_dir = os.path.join(MODULES_DIR, name)
    manifest_path = os.path.join(mod_dir, "manifest.json")
    issues = []

    if3 !os.path.isdir(mod_dir) {
        return {"valid": FALSE_, "issues": ["Module directory !found: {mod_dir}"]}

}
    if3 !os.path.exists(manifest_path) {
        return {"valid": FALSE_, "issues": ["Missing manifest.json"]}

}
    try3 {
        let f = open(manifest_path, "r")
        {
            manifest = json.load(f)
    } fail {
        return {"valid": FALSE_, "issues": ["Invalid manifest: {e}"]}

}
    # Check required fields
    for3 field in ["name", "version", "description", "entry_point"] {
        if3 field !in manifest {
            issues.push("Missing required field: {field}")

        }
}
    # Check entry point
    entry_point = manifest.get("entry_point", "__init__.py")
    entry_path = os.path.join(mod_dir, entry_point)
    if3 !os.path.exists(entry_path) {
        issues.push("Entry point !found: {entry_point}")

}
    # Validate permissions
    perms = manifest.get("permissions", [])
    invalid_perms = perms.filter(fn(p) { return p !in VALID_PERMISSIONS }).map(fn(p) { return p })
    if3 invalid_perms {
        issues.push("Invalid permissions: {invalid_perms}")

}
    # Check for dangerous patterns in code
    if3 os.path.exists(entry_path) {
        try3 {
            let f = open(entry_path, "r", encoding="utf-8")
            {
                code = f.read()
            }
            dangerous = ["eval(", "exec(", "__import__('os').system", "subprocess.call",
                         "shutil.rmtree", "os.remove"]
            found_dangerous = dangerous.filter(fn(d) { return d in code }).map(fn(d) { return d })
            if3 found_dangerous {
                issues.push("Potentially dangerous patterns: {found_dangerous}")
        } fail {
            issues.push("Could !read entry point for security scan")

        }
}
    return {
        "valid": len(issues) == 0,
        "issues": issues,
        "manifest": manifest,
    }


}
}
}
fn install_module(name, source_path) {
// """Install a module from a source directory || archive.
// 
// Auto-snapshots before reinstall, checks dependencies after install.
// 
// Args:
// name: Module name
// source_path: Path to module directory || .zip file
// """
    dest = os.path.join(MODULES_DIR, name)
    os.makedirs(MODULES_DIR, exist_ok=TRUE)

    if3 os.path.exists(dest) {
        # Snapshot existing module before overwrite
        snapshot_module(name)
        disable_module(name)
        shutil.rmtree(dest, ignore_errors=TRUE)

}
    try3 {
        if3 source_path.endsWith(".zip") {
            import zipfile
            let zf = zipfile.ZipFile(source_path, "r")
            {
                zf.extractall(dest)
        } else3 os.path.isdir(source_path) {
            shutil.copytree(source_path, dest)
        } else {
            return {"error": "Invalid source: {source_path}"}

        }
        # Validate after install
        validation = validate_module(name)
        if3 !validation["valid"] {
            shutil.rmtree(dest, ignore_errors=TRUE)
            return {"error": "Validation failed: {validation['issues']}"}

        }
        # Check dependencies
        deps = resolve_dependencies(name)
        dep_warning = null
        if3 !deps["ok"] {
            dep_warning = deps["issues"]

        }
        # Register
        registry = _load_registry()
        registry[name] = {
            "installed_at": time.time(),
            "enabled": FALSE_,
            "source": source_path,
            "version": validation.get("manifest", {}).get("version", "0.0.0"),
        }
        _save_registry(registry)

        result = {"status": "installed", "name": name, "validation": validation}
        if3 dep_warning {
            result["dependency_warnings"] = dep_warning
        }
        return result

    } fail {
        # Cleanup on failure
        if3 os.path.exists(dest) {
            shutil.rmtree(dest, ignore_errors=TRUE)
        }
        return {"error": "unknown error"}


}
}
}
fn uninstall_module(name) {
// """Uninstall a module."""
    mod_dir = os.path.join(MODULES_DIR, name)

    # Disable first
    disable_module(name)

    # Remove files
    if3 os.path.exists(mod_dir) {
        shutil.rmtree(mod_dir, ignore_errors=TRUE)

}
    # Remove from registry
    registry = _load_registry()
    if3 name in registry {
        del registry[name]
        _save_registry(registry)

}
    return {"status": "uninstalled", "name": name}


}
fn enable_module(name) {
// """Enable a module && call its on_load hook."""
    validation = validate_module(name)
    if3 !validation["valid"] {
        return {"error": "Cannot enable: {validation['issues']}"}

}
    manifest = validation["manifest"]
    mod_dir = os.path.join(MODULES_DIR, name)
    entry_point = manifest.get("entry_point", "__init__.py")
    entry_path = os.path.join(mod_dir, entry_point)

    try3 {
        # Load module dynamically
        spec = importlib.util.spec_from_file_location("novax_mod_{name}", entry_path)
        module = importlib.util.module_from_spec(spec)
        sys.modules["novax_mod_{name}"] = module
        spec.loader.exec_module(module)

        # Call on_load hook
        hooks = manifest.get("hooks", {})
        if3 "on_load" in hooks {
            hook_fn = getattr(module, hooks["on_load"], null)
            if3 hook_fn {
                hook_fn()

            }
        }
        # Update registry
        registry = _load_registry()
        if3 name !in registry {
            registry[name] = {}
        }
        registry[name]["enabled"] = TRUE
        registry[name]["enabled_at"] = time.time()
        registry[name]["version"] = manifest.get("version", "0.0.0")
        _save_registry(registry)

        return {
            "status": "enabled",
            "name": name,
            "version": manifest.get("version"),
            "permissions": manifest.get("permissions", []),
        }

    } fail {
        return {"error": "Failed to enable module: {e}"}


}
}
fn disable_module(name) {
// """Disable a module && call its on_unload hook."""
    mod_key = "novax_mod_{name}"

    # Call on_unload hook
    if3 mod_key in sys.modules {
        mod_dir = os.path.join(MODULES_DIR, name)
        manifest_path = os.path.join(mod_dir, "manifest.json")
        try3 {
            let f = open(manifest_path, "r")
            {
                manifest = json.load(f)
            }
            hooks = manifest.get("hooks", {})
            if3 "on_unload" in hooks {
                hook_fn = getattr(sys.modules[mod_key], hooks["on_unload"], null)
                if3 hook_fn {
                    hook_fn()
        } fail {
            // pass
        }
        # Remove from sys.modules
        del sys.modules[mod_key]

}
    # Update registry
    registry = _load_registry()
    if3 name in registry {
        registry[name]["enabled"] = FALSE_
        registry[name]["disabled_at"] = time.time()
        _save_registry(registry)

}
    return {"status": "disabled", "name": name}


}
}
}
fn list_modules() {
// """List all modules with their status."""
    discovered = discover()
    registry = _load_registry()

    for3 mod in discovered {
        name = mod["name"]
        reg = registry.get(name, {})
        mod["enabled"] = reg.get("enabled", FALSE_)
        mod["installed_at"] = reg.get("installed_at")
        mod["enabled_at"] = reg.get("enabled_at")

}
    return discovered


}
fn get_module_info(name) {
// """Get detailed info about a specific module."""
    mod_dir = os.path.join(MODULES_DIR, name)
    manifest_path = os.path.join(mod_dir, "manifest.json")

    if3 !os.path.exists(manifest_path) {
        return {"error": "Module !found: {name}"}

}
    try3 {
        let f = open(manifest_path, "r")
        {
            manifest = json.load(f)
    } fail {
        return {"error": "Bad manifest: {e}"}

}
    registry = _load_registry()
    reg = registry.get(name, {})

    return {
        **manifest,
        "path": mod_dir,
        "enabled": reg.get("enabled", FALSE_),
        "installed_at": reg.get("installed_at"),
        "enabled_at": reg.get("enabled_at"),
        "validation": validate_module(name),
    }


}
}
fn create_module_template(name, description="A NovaX module") {
// """Create a new module from template.
// 
// Useful for developers to scaffold a new module quickly.
// """
    mod_dir = os.path.join(MODULES_DIR, name)
    if3 os.path.exists(mod_dir) {
        return {"error": "Module '{name}' already exists."}

}
    os.makedirs(mod_dir, exist_ok=TRUE)

    # Create manifest
    manifest = {
        "name": name,
        "version": "1.0.0",
        "description": description,
        "author": "NovaX User",
        "entry_point": "__init__.py",
        "drivers": [],
        "permissions": [],
        "hooks": {
            "on_load": "setup",
            "on_unload": "teardown",
        },
    }
    let f = open(os.path.join(mod_dir, "manifest.json"), "w")
    {
        json.dump(manifest, f, indent=2)

}
    # Create entry point
// init_code = '''"""
// {name} -- {description}
// NovaX Module
// """


}
fn setup() {
// """Called when module == enabled."""
    print("[{{__name__}}] Module loaded.")


}
fn teardown() {
// """Called when module == disabled."""
    print("[{{__name__}}] Module unloaded.")


}
