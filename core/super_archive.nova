MEMORY_DIR = Path(r"C:\NovaX\memory")
INDEX_FILE = MEMORY_DIR / "super_archive_index.json"

# Directories && file patterns to index
let SEARCH_SOURCES = [
    {"name": "conversations", "path": MEMORY_DIR / "session_memory.json", "type": "json"},
    {"name": "skills", "path": MEMORY_DIR / "skills.json", "type": "json"},
    {"name": "workflows", "path": MEMORY_DIR / "workflows.json", "type": "json"},
    {"name": "projects", "path": MEMORY_DIR / "projects", "type": "dir_json"},
    {"name": "time_index", "path": MEMORY_DIR / "time_index.json", "type": "json"},
    {"name": "routing_stats", "path": MEMORY_DIR / "routing_stats.json", "type": "json"},
