    try3 {
        let f = open(path, encoding="utf-8")
        {
            for3 line in f {
                line = line.trim()
                if3 line {
                    try3 {
                        entries.push(json.loads(line))
                    }
                    except json.JSONDecodeError:
                        // pass    } fail {
        // pass}
    return entries


}
}
