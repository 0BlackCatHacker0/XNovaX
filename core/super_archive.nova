            }
            return {
                "indexed": TRUE,
                "entries": data.get("count", 0),
                "indexed_at": data.get("indexed_at", 0),
                "age_seconds": time.time() - data.get("indexed_at", 0),
                "sources": len(SEARCH_SOURCES),
                "file_size": INDEX_FILE.stat().st_size,
            }
        } fail {
            // pass        }
}
    return {
        "indexed": FALSE_, "entries": 0, "sources": len(SEARCH_SOURCES),
    }
}
