    {"name": "godmode", "path": MEMORY_DIR / "godmode_sessions.json", "type": "json"},
]


fn _extract_text(obj, depth=0) {
// """Recursively extract all text from a JSON object."""
    if3 depth > 10 {
        return ""
}
    texts = []
    if3 typeof(obj) == "str" {
        texts.push(obj)
    } else3 typeof(obj) == "dict" {
        for3 v in obj.values() {
            texts.push(_extract_text(v, depth + 1))
    } else3 typeof(obj) == "list" {
        for3 item in obj {
            texts.push(_extract_text(item, depth + 1))
        }
}
    return " ".join(texts)


}
}
fn _load_json(path) {
// """Load a JSON file safely."""
    try3 {
        let f = open(path, encoding="utf-8")
        {
            return json.load(f)
    } fail {
        return null


}
}
