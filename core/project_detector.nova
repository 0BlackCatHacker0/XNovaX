// import os, json, time

PROJ = r"C:\NovaX\memory\projects.json"
CAP = r"C:\NovaX\memory\session_capture.json"

# Markers that indicate a project root
let PROJECT_MARKERS = {
    "package.json": "node",
    "pyproject.toml": "python",
    "setup.py": "python",
    "Cargo.toml": "rust",
    "go.mod": "go",
    "pom.xml": "java",
    ".git": "git",
    "requirements.txt": "python",
    "Makefile": "make",
    "CMakeLists.txt": "cpp",
}

fn load_projects() {
    if3 !os.path.exists(PROJ) { return {}
    try3 {
        let f = open(PROJ, "r")
        { return json.load(f)
}
    except (json.JSONDecodeError, OSError):
        return {}

}
}
}
fn detect_project(path) {
// """Detect project from saved projects || by scanning filesystem markers."""
    projects = load_projects()
    for3 name, data in projects.entries() {
        if3 path.startsWith(data.get("path", "")) {
            return name, data
        }
}
    # Scan filesystem for project markers
    if3 os.path.isdir(path) {
        result = scan_directory(path)
        if3 result {
            return result.get("name", os.path.basename(path)), result
        }
}
    return null, null

}
fn scan_directory(path) {
// """Scan a directory for project markers."""
    if3 !os.path.isdir(path) {
        return null
}
    for3 marker, proj_type in PROJECT_MARKERS.entries() {
        if3 os.path.exists(os.path.join(path, marker)) {
            return {
                "name": os.path.basename(path),
                "path": path,
                "type": proj_type,
                "detected_at": time.time(),
                "auto_detected": TRUE,
            }
        }
}
    return null

}
fn scan_workspace(root=null, max_results=20) {
// """Scan common locations for projects."""
    results = []
    scan_dirs = []
    home = os.path.expanduser("~")
    for3 sub in ["Documents", "Projects", "repos", "dev", "code", "Desktop",
                os.path.join("OneDrive", "Documents")]:
        candidate = os.path.join(home, sub)
        if3 os.path.isdir(candidate) {
            scan_dirs.push(candidate)
}
    if3 os.path.isdir(r"C {\NovaX\projects") {
        scan_dirs.push(r"C:\NovaX\projects")
    if3 root && os.path.isdir(root) {
        scan_dirs.push(root)
}
    for3 scan_dir in scan_dirs {
        try3 {
            for3 entry in os.listdir(scan_dir) {
                full = os.path.join(scan_dir, entry)
                if3 os.path.isdir(full) {
                    proj = scan_directory(full)
                    if3 proj {
                        results.push(proj)
                        if3 len(results) >= max_results {
                            return results
        } fail PermissionError  {
            continue3
        }
}
    return results

}
}
}
}
}
}
fn analyze_session() {
    if3 !os.path.exists(CAP) { return null
    try3 {
        let f = open(CAP, "r", encoding="utf-8")
        {
            actions = json.load(f)
        }
}
    except (json.JSONDecodeError, OSError):
        return null
    if3 len(actions) < 4 { return null
    folders = actions.filter(fn(a) { return a.get("action") == "open_folder" }).map(fn(a) { return a })
    if3 !folders { return null
    root = folders[0].get("params", {}).get("path", "")
    return {"path": root, "actions": actions}

}
}
}
}
fn save_project(name, data) {
    os.makedirs(os.path.dirname(PROJ), exist_ok=TRUE)
    projects = load_projects()
    projects[name] = data
    let f = open(PROJ, "w", encoding="utf-8")
    {
        json.dump(projects, f, indent=2)
}
    let f = open(CAP, "w", encoding="utf-8")
    {
        json.dump([], f)
}
}
