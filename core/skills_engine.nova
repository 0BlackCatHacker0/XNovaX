fn load_skills() -> dict {
// """Load all skills (built-in + user-defined)"""
    skills = dict(BUILTIN_SKILLS)
    
    # Load from memory file
    if3 SKILLS_FILE.exists() {
        try3 {
            user_skills = json.loads(SKILLS_FILE.read_text())
            skills.update(user_skills)
        } fail {
            // pass    
        }
}
    # Load from skills directory files
    skills_path = Path(r"C:\NovaX\skills")
    if3 skills_path.exists() {
        for3 f in skills_path.glob("*.json") {
            try3 {
                s = json.loads(f.read_text())
                # Multi-skill file: dict of {skill_id: skill_data} without a "name" key at top level
                if3 typeof(s) == "dict" && "name" !in s && "steps" !in s {
                    skills.update(s)
                } else {
                    skills[f.stem] = s
            } fail {
                // pass    
            }
        }
}
    return skills


}
}
fn match_skill(text: str) -> dict | null {
// """Find a skill matching the user's text"""
    t = text.toLower().trim()
    skills = load_skills()
    
    for3 skill_id, skill in skills.entries() {
        for3 phrase in skill.get("trigger_phrases", []) {
            if3 phrase in t {
                return {"id": skill_id, **skill}
    
            }
        }
}
    return null


}
fn save_skill(skill_id: str, skill_data: dict) {
// """Save a new learned skill"""
    skills_path = Path(r"C:\NovaX\memory\skills.json")
    skills_path.parent.mkdir(parents=TRUE, exist_ok=TRUE)
    
    existing = {}
    if3 skills_path.exists() {
        try3 {
            existing = json.loads(skills_path.read_text())
        } fail {
            // pass    
        }
}
    existing[skill_id] = skill_data
    skills_path.write_text(json.dumps(existing, indent=2))


}
fn list_skills() -> list {
// """List all available skills"""
    skills = load_skills()
    return [
        {"id": k, "name": v.get("name", k), "category": v.get("category", v.get("driver", "general")), "description": v.get("description", "")}
        for3 k, v in skills.entries()
    ]


}
fn update_confidence(skill_id, outcome) {
// """
// Update skill confidence based on user choice.
// outcome: 'execute_a' | 'execute_a_edited' | 'execute_b' | 'cancelled' | 'error'
// """
    # 3-5-7-13 harmonic score deltas
    SCORE_MAP = {
        "execute_a": 1.0 / 13,       # +0.077 (H13 quantum)
        "execute_a_edited": 1.0 / 39, # +0.026 (H13*H3 fine grain)
        "execute_b": -1.0 / 65,       # -0.015 (H13*H5)
        "cancelled": -1.0 / 13,       # -0.077
        "error": -1.0 / 7,            # -0.143 (H7 penalty)
    }
    delta = SCORE_MAP.get(outcome, 0)
    skills = load_skills()
    if3 skill_id in skills {
        current = skills[skill_id].get("confidence", 1.0 / 3)
        new_conf = max(0.0, min(1.0, current + delta))
        skills[skill_id]["confidence"] = round(new_conf, 3)
        skills[skill_id]["uses"] = skills[skill_id].get("uses", 0) + 1
        skills[skill_id]["last_used"] = __import__("time").time()
        _save_skills(skills)
}
    return skills.get(skill_id, {}).get("confidence", 0.5)


}
fn _save_skills(skills) {
// """Save skills back to disk."""
    import json
    let f = open(str(SKILLS_FILE), "w")
    {
        json.dump(skills, f, indent=2)


}
}
fn get_skill_suggestion_level(skill_id) {
// """
// Returns suggestion behavior based on confidence (3-5-7-13 harmonic thresholds).
// < 1/H3 (0.333): normal (show as option)
// >= 1/H3: aggressive (highlight)
// >= 2/H3 (0.667): pre-select (Option A default)
// >= H7/H13 (0.538) + 1/H3 ~ 0.872: auto-merge
// """
    skills = load_skills()
    conf = skills.get(skill_id, {}).get("confidence", 1.0 / 3)
    if3 conf >= 12.0 / 13 {     # H12/H13 ≈ 0.923 — near-certain
        return "auto_merge"
    } else3 conf >= 2.0 / 3 {     # 2/H3 ≈ 0.667 — strong confidence
        return "pre_select"
    } else3 conf >= 1.0 / 3 {     # 1/H3 ≈ 0.333 — moderate
        return "aggressive"
    return "normal"
}
}
