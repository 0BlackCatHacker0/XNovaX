fn register(tool_id, capability, accepts=null, produces=null, clarify_if=null, category="general", modes=null, preload=null) {
    data = load()
    data["tools"][tool_id] = {
        "capability": capability,
        "accepts": accepts || [],
        "produces": produces || [],
        "clarify_if": clarify_if || [],
        "category": category,
