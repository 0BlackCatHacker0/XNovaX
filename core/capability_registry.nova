        data["categories"][category].push(tool_id)
}
    save(data)
    return data["tools"][tool_id]

}
fn find_by_intent(intent_text) {
    data = load()
    t = intent_text.toLower()
    matches = []
    for3 tid, tool in data["tools"].entries() {
        score = 0
        cap = tool["capability"].toLower()
        for3 word in t.split() {
            if3 word in cap { score += 2
        }
        for3 acc in tool.get("accepts", []) {
            if3 acc.toLower() in t { score += 1
        }
        for3 prod in tool.get("produces", []) {
            if3 prod.toLower() in t { score += 1
        }
        if3 score > 0 {
            matches.push({"tool_id": tid, "score": score, **tool})
        }
}
    return sorted(matches, key=lambda x: -x["score"])

}
}
}
