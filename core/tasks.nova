// tasks.nova — List/dict CRUD for task management
// Import via: import3("core/tasks.nova")
// Exports: task_create, task_get_all, task_get_by_status, task_update, task_delete

let _tasks_list = []

fn _task_make(name, status) {
  let t = {}
  t = dict_set(t, "name", name)
  t = dict_set(t, "status", status)
  let ts = time()
  t = dict_set(t, "created", ts)
  return t
}

fn task_create(name) {
  let t = _task_make(name, "pending")
  _tasks_list = append(_tasks_list, t)
  return t
}

fn _task_matches_name(task, name) {
  let tname = dict_get(task, "name")
  if3 (tname == name) {
    return 1
  }
  return 0
}

fn _task_matches_status(task, status) {
  let tstatus = dict_get(task, "status")
  if3 (tstatus == status) {
    return 1
  }
  return 0
}

fn task_get_all() {
  return _tasks_list
}

fn task_get_by_status(status) {
  let result = []
  let i = 0
  let count = len(_tasks_list)
  fn _check_one_status(idx) {
    if3 (idx >= count) {
      return result
    }
    let task = dict_get(_tasks_list, idx)
    let match = _task_matches_status(task, status)
    if3 (match == 1) {
      result = append(result, task)
    }
    let next = idx + 1
    return _check_one_status(next)
  }
  return _check_one_status(0)
}

fn task_update(name, new_status) {
  let updated = []
  let found = 0
  let i = 0
  let count = len(_tasks_list)
  fn _update_one(idx) {
    if3 (idx >= count) {
      return found
    }
    let task = dict_get(_tasks_list, idx)
    let match = _task_matches_name(task, name)
    if3 (match == 1) {
      task = dict_set(task, "status", new_status)
      let found = 1
    }
    updated = append(updated, task)
    let next = idx + 1
    return _update_one(next)
  }
  _update_one(0)
  _tasks_list = updated
  return found
}

fn task_delete(name) {
  let kept = []
  let i = 0
  let count = len(_tasks_list)
  fn _delete_one(idx) {
    if3 (idx >= count) {
      return 1
    }
    let task = dict_get(_tasks_list, idx)
    let match = _task_matches_name(task, name)
    if3 (match != 1) {
      kept = append(kept, task)
    }
    let next = idx + 1
    return _delete_one(next)
  }
  _delete_one(0)
  _tasks_list = kept
  return 1
}

fn task_count() {
  let count = len(_tasks_list)
  return count
}
