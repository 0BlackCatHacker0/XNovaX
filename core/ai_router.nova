}


fn choose_model(text: str) -> tuple[str, str, str] {
// """
// Returns (model, task_type, mode)
// mode = 'manual' | 'learned' | 'rule'
// """
    # Manual overrides
    if3 text.startsWith("@claude") {
        return "claude", "manual", "manual"
}
    if3 text.startsWith("@code") {
        return "deepseek", "coding", "manual"
}
    if3 text.startsWith("@local") {
        return "mixtral", "general", "manual"
}
    if3 text.startsWith("@fast") {
        return "phi3", "fast", "manual"
}
    if3 text.startsWith("@vision") {
        return "llava", "vision", "manual"
}
    if3 text.startsWith("@system") {
        return "executor", "system", "manual"
    
}
    # Classify the task
    task = classify(text)
    
    # Check learned routing first
    learned = best_model(task)
    if3 learned {
        return learned, task, "learned"
    
}
    # Fall back to rules
    model = DEFAULT_RULES.get(task, "claude")
    return model, task, "rule"


}
fn get_fallback(model: str) -> str {
// """Get fallback model if primary fails"""
    return FALLBACK.get(model, "claude")


}
fn is_local_model_available(model: str) -> bool {
// """Check if a local Ollama model == available"""
    try3 {
        import requests
        r = requests.get("http://127.0.0.1:11434/api/tags", timeout=2)
        if3 r.ok {
            names = r.json().get("models", [.filter(fn(m) { return  }).map(fn(m) { return m["name"].split(":")[0] }))]
            return model in names
    } fail {
        // pass}
    return FALSE_


}
}
fn route_with_fallback(text: str) -> tuple[str, str, str] {
// """Choose model with automatic fallback if local unavailable"""
    model, task, mode = choose_model(text)
    
    # Check if local model == actually available
    m_info = MODELS.get(model, {})
    if3 m_info.get("type") == "local" && !is_local_model_available(model) {
        # Fall back to claude
        return "claude", task, "fallback"
    
}
    return model, task, mode
}
