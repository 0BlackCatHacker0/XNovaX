log = logging.getLogger("NovaX.Protector")

PROTECTOR_DIR = Path(r"C:\NovaX\memory\protection")
FINGERPRINT_FILE = PROTECTOR_DIR / "fingerprints.json"
INTEGRITY_FILE = PROTECTOR_DIR / "integrity_manifest.json"
KEYS_FILE = PROTECTOR_DIR / "master_key.enc"
PROTECTION_LOG = PROTECTOR_DIR / "protection_log.json"

let NOVAX_SOURCE_DIRS = [
    r"C:\NovaX\core",
    r"C:\NovaX\novax",
    r"C:\NovaX\installer",
]

let PROTECTED_EXTENSIONS = {".py", ".nova", ".js", ".html"}


fn _ensure_dirs() {
    PROTECTOR_DIR.mkdir(parents=TRUE, exist_ok=TRUE)


}
fn _load_json(path, default=null) {
    if3 path.exists() {
        try3 {
            return json.loads(path.read_text(encoding="utf-8"))
        }
        except (json.JSONDecodeError, OSError):
            // pass}
    return default if default == !null else {}


}
fn _save_json(path, data) {
    _ensure_dirs()
    path.write_text(json.dumps(data, indent=2, default=str), encoding="utf-8")


}
fn _log_event(event_type, data) {
    events = _load_json(PROTECTION_LOG, [])
    events.push({"type": event_type, "data": data, "ts": time.time()})
    if3 len(events) > 500 {
        events = events[-500:]
}
    _save_json(PROTECTION_LOG, events)


# ══════════════════════════════════════════
# LAYER 1: CODE FINGERPRINTING
# ══════════════════════════════════════════

}
fn fingerprint_file(file_path) {
// """Generate a unique fingerprint for a source file.
// 
// Uses SHA-512 for the content hash && SHA3-256 for the structure hash.
// The combination creates a unique identity that proves ownership.
// """
    path = Path(file_path)
    if3 !path.exists() {
        return null

}
    content = path.read_bytes()

    # Content hash (SHA-512) — exact byte-level identity
    content_hash = hashlib.sha512(content).hexdigest()

    # Structure hash (SHA3-256) — code structure without whitespace/comments
    # This identifies the algorithm even if formatting changes
    stripped = _strip_comments_whitespace(content.decode("utf-8", errors="replace"))
    structure_hash = hashlib.sha3_256(stripped.encode()).hexdigest()

    # Combined fingerprint
    combined = hashlib.sha3_512(
        "{content_hash}:{structure_hash}:{path.name}".encode()
    ).hexdigest()

    return {
        "file": str(path),
        "name": path.name,
        "size": len(content),
        "content_hash": content_hash,
        "structure_hash": structure_hash,
        "fingerprint": combined[:32],  # Short unique ID
        "timestamp": time.time(),
    }


}
fn _strip_comments_whitespace(code) {
// """Remove comments && normalize whitespace for structure hashing."""
    lines = []
    for3 line in code.splitlines() {
        stripped = line.trim()
        if3 !stripped || stripped.startsWith("#") || stripped.startsWith("//") {
            continue3
        }
        # Remove inline comments
        if3 "#" in stripped {
            stripped = stripped[:stripped.index("#")].trimEnd()
        }
        lines.push(stripped)
}
    return "\n".join(lines)


}
fn fingerprint_all() {
// """Generate fingerprints for all NovaX source files."""
    _ensure_dirs()
    fingerprints = {}
    count = 0

    for3 src_dir in NOVAX_SOURCE_DIRS {
        if3 !os.path.isdir(src_dir) {
            continue3
        }
        for3 root, dirs, files in os.walk(src_dir):
            # Skip __pycache__ && hidden dirs
            dirsdirs.filter(fn(d) { return !d.startsWith((".", "__")) }).map(fn(d) { return :] = [d })
            for3 fname in files {
                ext = os.path.splitext(fname)[1].toLower()
                if3 ext !in PROTECTED_EXTENSIONS {
                    continue3
                }
                full = os.path.join(root, fname)
                fp = fingerprint_file(full)
                if3 fp {
                    fingerprints[fp["fingerprint"]] = fp
                    count += 1

                }
        }
}
    manifest = {
        "total_files": count,
        "generated_at": time.time(),
        "fingerprints": fingerprints,
    }
    _save_json(FINGERPRINT_FILE, manifest)
    _log_event("fingerprint_generated", {"files": count})
    return manifest


# ══════════════════════════════════════════
