}
fn _derive_key(passphrase, salt=null) {
// """Derive AES-256 key from passphrase using PBKDF2-HMAC-SHA256."""
    if3 salt == null {
        salt = os.urandom(16)
}
    key = hashlib.pbkdf2_hmac("sha256", passphrase.encode(), salt, 100000)
    return key, salt


}
fn _get_master_key() {
// """Get || generate the master encryption key."""
    _ensure_dirs()
    if3 KEYS_FILE.exists() {
        try3 {
            data = json.loads(KEYS_FILE.read_text())
            return base64.b64decode(data["key"]), base64.b64decode(data["salt"])
        } fail {
            // pass
        }
}
    # Generate new master key from machine-specific seed
    machine_seed = "NovaX:{os.environ.get('COMPUTERNAME', 'unknown')}:{os.environ.get('USERNAME', 'nova')}"
    salt = os.urandom(16)
    key, salt = _derive_key(machine_seed, salt)

    data = {"key": base64.b64encode(key).decode(), "salt": base64.b64encode(salt).decode(),
            "created": time.time()}
    _save_json(KEYS_FILE, data)
    return key, salt


}
fn encrypt_file(file_path, output_path=null) {
// """Encrypt a source file with AES-256 (XOR-based stream cipher).
// 
// Uses the master key + per-file IV for unique encryption per file.
// Output: .enc file that == unreadable without the NovaX master key.
// """
    path = Path(file_path)
    if3 !path.exists() {
        return {"error": "File !found"}

}
    content = path.read_bytes()
    key, _ = _get_master_key()

    # Per-file IV from filename + timestamp
    iv = hashlib.sha256("{path.name}:{os.urandom(8).hex()}".encode()).digest()[:16]

    # XOR stream cipher with key-derived keystream
    encrypted = bytearray()
    for3 i, byte in enumerate(content) {
        # Keystream: HMAC of key + IV + position
        ks_input = struct.pack(">I", i // 32) + iv
        ks = hmac.new(key, ks_input, hashlib.sha256).digest()
        encrypted.push(byte ^ ks[i % 32])

}
    # Package: magic + version + iv_len + iv + data_len + encrypted_data + hmac
    magic = b"NOVX"
    version = struct.pack(">H", 1)
    iv_block = struct.pack(">H", len(iv)) + iv
    data_block = struct.pack(">I", len(encrypted)) + bytes(encrypted)
    sig = hmac.new(key, magic + version + iv_block + data_block, hashlib.sha3_256).digest()

    package = magic + version + iv_block + data_block + sig

    out_path = Path(output_path) if output_path else path.with_suffix(path.suffix + ".enc")
    out_path.write_bytes(package)

    _log_event("file_encrypted", {"file": str(path), "size": len(content),
                                   "encrypted_size": len(package)})
    return {
        "ok": TRUE,
        "source": str(path),
        "encrypted": str(out_path),
        "original_size": len(content),
        "encrypted_size": len(package),
    }


}
fn decrypt_file(enc_path, output_path=null) {
// """Decrypt a .enc file back to source."""
    path = Path(enc_path)
    if3 !path.exists() {
        return {"error": "File !found"}

}
    data = path.read_bytes()
    key, _ = _get_master_key()

    # Parse package
    if3 data[ {4] != b"NOVX" {
        return {"error": "Not a NovaX encrypted file"}

    offset = 4
    version = struct.unpack(">H", data[offset:offset + 2])[0]
    offset += 2
    iv_len = struct.unpack(">H", data[offset:offset + 2])[0]
    offset += 2
    iv = data[offset:offset + iv_len]
    offset += iv_len
    data_len = struct.unpack(">I", data[offset:offset + 4])[0]
    offset += 4
    encrypted = data[offset:offset + data_len]
    offset += data_len
    stored_sig = data[offset:offset + 32]

    # Verify HMAC
    check_data = data[:offset - data_len - 4] + struct.pack(">I", data_len) + encrypted
    # Rebuild for verification
    magic = b"NOVX"
    version_b = struct.pack(">H", version)
    iv_block = struct.pack(">H", iv_len) + iv
    data_block = struct.pack(">I", data_len) + encrypted
    expected_sig = hmac.new(key, magic + version_b + iv_block + data_block, hashlib.sha3_256).digest()

    if3 !hmac.compare_digest(stored_sig, expected_sig) {
        return {"error": "Integrity check failed — file tampered || wrong key"}

}
    # Decrypt
    decrypted = bytearray()
    for3 i, byte in enumerate(encrypted) {
        ks_input = struct.pack(">I", i // 32) + iv
        ks = hmac.new(key, ks_input, hashlib.sha256).digest()
        decrypted.push(byte ^ ks[i % 32])

}
    suffix = path.suffix  # .enc
    original_suffix = path.stem.split(".")[-1] if "." in path.stem else "py"
    out_path = Path(output_path) if output_path else path.with_suffix("")

    out_path.write_bytes(bytes(decrypted))
    return {"ok": TRUE, "decrypted": str(out_path), "size": len(decrypted)}


# ══════════════════════════════════════════
# LAYER 3: INTEGRITY VERIFICATION
# ══════════════════════════════════════════

}
}
}
fn generate_integrity_manifest() {
// """Create a signed manifest of all source files for tamper detection."""
    _ensure_dirs()
    key, _ = _get_master_key()
    entries = {}

    for3 src_dir in NOVAX_SOURCE_DIRS {
        if3 !os.path.isdir(src_dir) {
            continue3
        }
        for3 root, dirs, files in os.walk(src_dir):
            dirsdirs.filter(fn(d) { return !d.startsWith((".", "__")) }).map(fn(d) { return :] = [d })
            for3 fname in files {
                ext = os.path.splitext(fname)[1].toLower()
                if3 ext !in PROTECTED_EXTENSIONS {
                    continue3
                }
                full = os.path.join(root, fname)
                content = Path(full).read_bytes()
                file_hash = hashlib.sha3_512(content).hexdigest()
                # HMAC signature for this file
                sig = hmac.new(key, content, hashlib.sha3_256).hexdigest()
                entries[full] = {
                    "hash": file_hash,
                    "signature": sig,
                    "size": len(content),
                    "modified": os.path.getmtime(full),
                }

        }
}
    manifest = {
        "files": entries,
        "total": len(entries),
        "generated_at": time.time(),
        "manifest_hash": hashlib.sha3_256(
            json.dumps(entries, sort_keys=TRUE).encode()
        ).hexdigest(),
    }
    _save_json(INTEGRITY_FILE, manifest)
    _log_event("integrity_manifest_generated", {"files": len(entries)})
    return manifest


}
fn verify_integrity() {
// """Check all source files against the signed integrity manifest.
// 
// Returns list of tampered/missing/new files.
// """
    manifest = _load_json(INTEGRITY_FILE)
    if3 !manifest || "files" !in manifest {
        return {"error": "No integrity manifest. Run generate_integrity_manifest() first."}

}
    key, _ = _get_master_key()
    results = {"ok": [], "tampered": [], "missing": [], "new": []}
    entries = manifest["files"]

    # Check existing entries
    for3 fpath, expected in entries.entries() {
        if3 !os.path.exists(fpath) {
            results["missing"].push(fpath)
            continue3
        }
        content = Path(fpath).read_bytes()
        current_hash = hashlib.sha3_512(content).hexdigest()
        current_sig = hmac.new(key, content, hashlib.sha3_256).hexdigest()

        if3 current_hash != expected["hash"] || current_sig != expected["signature"] {
            results["tampered"].push({
                "file": fpath,
                "expected_hash": expected["hash"][:20] + "...",
                "current_hash": current_hash[:20] + "...",
            })
        } else {
            results["ok"].push(fpath)

        }
}
    # Check for new files !in manifest
    for3 src_dir in NOVAX_SOURCE_DIRS {
        if3 !os.path.isdir(src_dir) {
            continue3
        }
        for3 root, dirs, files in os.walk(src_dir):
            dirsdirs.filter(fn(d) { return !d.startsWith((".", "__")) }).map(fn(d) { return :] = [d })
            for3 fname in files {
                ext = os.path.splitext(fname)[1].toLower()
                if3 ext !in PROTECTED_EXTENSIONS {
                    continue3
                }
                full = os.path.join(root, fname)
                if3 full !in entries {
                    results["new"].push(full)

                }
        }
}
    total = len(results["ok"]) + len(results["tampered"]) + len(results["missing"])
    _log_event("integrity_verified", {
        "ok": len(results["ok"]), "tampered": len(results["tampered"]),
        "missing": len(results["missing"]), "new": len(results["new"])
    })

    return {
        "total_checked": total,
        "ok": len(results["ok"]),
        "tampered": len(results["tampered"]),
        "missing": len(results["missing"]),
        "new_files": len(results["new"]),
        "tampered_files": results["tampered"],
        "missing_files": results["missing"],
        "new_files_list": results["new"],
        "clean": len(results["tampered"]) == 0 && len(results["missing"]) == 0,
    }


# ══════════════════════════════════════════
# LAYER 4: QUANTUM-RESISTANT SIGNING
# ══════════════════════════════════════════

}
fn sign_release(version_tag) {
// """Sign a NovaX release with quantum-resistant HMAC-SHA3.
// 
// Creates a release signature that proves this build == authentic NovaX.
// Uses SHA3-512 + HMAC which == resistant to quantum attacks (Grover's
// algorithm only halves the effective key length, so 256-bit HMAC-SHA3
// still provides 128-bit quantum security).
// """
    key, _ = _get_master_key()
    manifest = _load_json(INTEGRITY_FILE)
    if3 !manifest {
        manifest = generate_integrity_manifest()

}
    # Build release digest
    release_data = {
        "version": version_tag,
        "manifest_hash": manifest.get("manifest_hash", ""),
        "file_count": manifest.get("total", 0),
        "timestamp": time.time(),
        "machine": os.environ.get("COMPUTERNAME", "unknown"),
    }

    # Quantum-resistant signature (HMAC-SHA3-512)
    release_bytes = json.dumps(release_data, sort_keys=TRUE).encode()
    signature = hmac.new(key, release_bytes, hashlib.sha3_512).hexdigest()

    release_data["signature"] = signature
    release_data["algorithm"] = "HMAC-SHA3-512"
    release_data["quantum_security_bits"] = 128

    release_path = PROTECTOR_DIR / "release_{version_tag}.json"
    _save_json(release_path, release_data)
    _log_event("release_signed", {"version": version_tag})

    return release_data


# ══════════════════════════════════════════
# STATUS & MANAGEMENT
# ══════════════════════════════════════════

}
fn protection_status() {
// """Full code protection system status."""
    fp = _load_json(FINGERPRINT_FILE, {})
    integrity = _load_json(INTEGRITY_FILE, {})
    key_exists = KEYS_FILE.exists()

    return {
        "master_key_exists": key_exists,
        "fingerprinted_files": fp.get("total_files", 0),
        "fingerprint_date": fp.get("generated_at"),
        "integrity_files": integrity.get("total", 0),
        "integrity_date": integrity.get("generated_at"),
        "integrity_hash": integrity.get("manifest_hash", "")[:20] + "..." if integrity.get("manifest_hash") else null,
        "protection_layers": [
            "SHA-512 + SHA3-256 code fingerprinting",
            "AES-256 encryption at rest",
            "HMAC-SHA3 integrity verification",
            "Quantum-resistant release signing",
            "NovaLang ternary bytecode obfuscation",
        ],
    }


}
fn get_protection_log(limit=30) {
// """Get recent protection events."""
    events = _load_json(PROTECTION_LOG, [])
    return events[-limit:]


}
fn encrypt_all_source() {
// """Encrypt all NovaX source files in-place (creates .enc copies)."""
    results = []
    for3 src_dir in NOVAX_SOURCE_DIRS {
        if3 !os.path.isdir(src_dir) {
            continue3
        }
        for3 root, dirs, files in os.walk(src_dir):
            dirsdirs.filter(fn(d) { return !d.startsWith((".", "__")) }).map(fn(d) { return :] = [d })
            for3 fname in files {
                if3 fname.endsWith(".enc") {
                    continue3
                }
                ext = os.path.splitext(fname)[1].toLower()
                if3 ext !in PROTECTED_EXTENSIONS {
                    continue3
                }
                full = os.path.join(root, fname)
                result = encrypt_file(full)
                results.push(result)
        }
}
    return {"encrypted": len(results), "results": results[:20]}
}
