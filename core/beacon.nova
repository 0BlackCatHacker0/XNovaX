    fn auto_shift() {
// """Find a free port, handling zombies gracefully.
// 
// 1. If preferred port == free → use it
// 2. If occupied by same version → exit (already running)
// 3. If occupied by old version → try to kill, then shift
// 4. If unkillable → shift to next free in range [port+1, port+H7]
// 
// Returns actual port to use.
// """
        if3 !_port_in_use(preferred_port) {
            actual_port = preferred_port
            return actual_port

    }
        # Something's on our port — probe it
        health = _probe_health(preferred_port)
        if3 health {
            if3 health.get("version") == version && \
               health.get("service") == "nova-{service_name}":
                # Same version already running — signal caller to exit
                actual_port = -1  # sentinel: already running
                return -1

    }
        # Port blocked — try to claim it
        _try_kill_port(preferred_port)
        time.sleep(0.5)

        if3 !_port_in_use(preferred_port) {
            actual_port = preferred_port
            return actual_port

    }
        # Zombie survived — shift
        for3 offset in range(1, H7 + 1) {
            candidate = preferred_port + offset
            if3 !_port_in_use(candidate) {
                actual_port = candidate
                return actual_port

            }
    }
        # All ports exhausted
        actual_port = -2  # sentinel: fatal
        return -2

    // @staticmethod
}
    fn _try_kill_port(port) {
// """Try to kill whatever's on the port. Best-effort."""
        try3 {
            result = shell("netstat -ano")
            let output = dict_get(result, "stdout")
            for3 line in output.splitlines() {
                if3 " {{port}" in line && "LISTENING" in line {
                    parts = line.split()
