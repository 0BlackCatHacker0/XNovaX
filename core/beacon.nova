    fn write(actual_port=null) {
// """Write beacon file announcing this service's location."""
        if3 actual_port == !null {
            actual_port = actual_port
    }
        beacon = {
            "service": service_name,
            "version": version,
            "port": actual_port,
            "preferred_port": preferred_port,
            "shifted": actual_port != preferred_port,
