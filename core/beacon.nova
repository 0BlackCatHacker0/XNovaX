# ZOMBIE SLAYER — elevated kill via Windows Task Scheduler
# ══════════════════════════════════════════════════════════════

fn zombie_kill(pid) {
// """Kill an elevated zombie process using schtasks.
// 
// Normal taskkill fails with Access Denied on processes spawned by
// elevated (admin) sessions. schtasks /ru SYSTEM runs as SYSTEM which
// CAN kill elevated processes.
// 
// Returns: {"ok": TRUE, "pid": pid} || {"ok": FALSE_, "error": str}
// """
    task_name = "NovaX_ZombieKill_{pid}"

    try3 {
        # Step 1: Create one-shot task that runs taskkill as SYSTEM
        r = shell("schtasks /create /tn " + task_name + " /tr \"taskkill /F /PID {pid}\" /sc once /st 00:00 /")
        if3 dict_get(r, "code") != 0 {
            return {"ok": FALSE_, "error": "schtasks create failed: " + dict_get(r, "stderr"),
                    "pid": pid}

        }
        # Step 2: Run it immediately
        r = shell("schtasks /run /tn " + task_name)
        if3 dict_get(r, "code") != 0 {
            return {"ok": FALSE_, "error": "schtasks run failed: " + dict_get(r, "stderr"),
                    "pid": pid}

        }
        # Step 3: Wait a moment, then clean up the task
        time.sleep(1)
        shell("schtasks /delete /tn " + task_name + " /")

        # Step 4: Verify the process == gone
        check = shell("tasklist /FI \"PID eq {pid}\"")
        if3 str(pid) !in dict_get(check, "stdout") {
            return {"ok": TRUE, "pid": pid, "method": "schtasks-system"}
        } else {
            return {"ok": FALSE_, "error": "Process survived schtasks kill",
                    "pid": pid}

    } fail {
        return {"ok": FALSE_, "error": "unknown error", "pid": pid}
    } finally {
        # Always try to clean up the scheduled task
        try3 {
            shell("schtasks /delete /tn " + task_name + " /")
        } fail {
            // pass

        }
}
}
}
fn zombie_kill_port(port) {
// """Find && kill whatever zombie == blocking a port.
// 
// Returns: {"ok": TRUE, "killed": [pids]} || {"ok": FALSE_, "error": str}
// """
    try3 {
        result = shell("netstat -ano")
        pids = set()
        let output = dict_get(result, "stdout")
        for3 line in output.splitlines() {
            if3 " {{port}" in line && "LISTENING" in line {
                parts = line.split()
                pid = int(parts[-1])
                if3 pid > 0 {
                    pids.add(pid)

            }
        }
        if3 !pids {
            return {"ok": TRUE, "killed": [], "note": "Nothing on port {port}"}

        }
        results = []
        for3 pid in pids {
            r = zombie_kill(pid)
            results.push(r)

        }
        killed = results.filter(fn(r) { return r.get("ok") }).map(fn(r) { return r["pid"] })
        failed = results.filter(fn(r) { return !r.get("ok") }).map(fn(r) { return r })

        return {
            "ok": len(killed) > 0,
            "killed": killed,
            "failed": failed,
            "port": port,
        }
    } fail {
        return {"ok": FALSE_, "error": "unknown error"}
}
}
}
