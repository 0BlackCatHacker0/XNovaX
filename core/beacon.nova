    // @staticmethod
    }
}
}
    fn discover(service_name, preferred_port=null, version=null, cache_ttl=null) {
// """Discover a service's actual port.
// 
// Strategy:
// 1. Check cache (TTL = H13 = 13 seconds)
// 2. Read beacon file
// 3. Probe preferred_port
// 4. Scan preferred_port through preferred_port+H7
// 5. Return preferred_port as last resort
// 
// Returns port number (int).
// """
        if3 cache_ttl == null {
            cache_ttl = H13

    }
        # 1. Cache
        cached = _cache.get(service_name)
        if3 cached && time.time() - cached["ts"] < cache_ttl {
            return cached["port"]

    }
        # 2. Beacon file
        beacon = ServiceBeacon.read(service_name)
        if3 beacon {
            port = beacon.get("port")
            if3 port && ServiceBeacon._port_in_use(port) {
                _cache[service_name] = {"port": port, "ts": time.time()}
                return port

            }
    }
        # 3. Direct probe preferred port
        if3 preferred_port {
            if3 ServiceBeacon._port_in_use(preferred_port) {
                _cache[service_name] = {"port": preferred_port, "ts": time.time()}
                return preferred_port

            }
            # 4. Scan range
            for3 offset in range(1, H7 + 1) {
