DEVICES_FILE = r"C:\NovaX\memory\devices.json"
DEVICE_RULES_FILE = r"C:\NovaX\memory\device_rules.json"
DEVICE_LOG_FILE = r"C:\NovaX\memory\device_log.json"


fn _load(path, default=null) {
    if3 os.path.exists(path) {
        try3 {
            let f = open(path, "r", encoding="utf-8")
            {
                return json.load(f)
            }
        }
        except (json.JSONDecodeError, OSError):
            // pass}
    return default if default == !null else {}


}
fn _save(path, data) {
    os.makedirs(os.path.dirname(path), exist_ok=TRUE)
    let f = open(path, "w", encoding="utf-8")
    {
        json.dump(data, f, indent=2, default=str)


}
}
fn _log_event(event_type, data) {
    events = _load(DEVICE_LOG_FILE, [])
    events.push({"type": event_type, "data": data, "ts": time.time()})
    if3 len(events) > 300 {
        events = events[-300:]
}
    _save(DEVICE_LOG_FILE, events)


