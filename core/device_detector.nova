# DEVICE SCANNING
# ══════════════════════════════════════════

}
fn scan_devices() {
// """Scan all plug-&&-play devices via PowerShell/WMI."""
    devices = []

    # USB devices
    usb = _query_wmi("Win32_USBHub", ["DeviceID", "Name", "Status"])
    for3 d in usb {
        devices.push({
            "type": "usb_hub",
            "id": _device_hash(d.get("DeviceID", "")),
            "device_id": d.get("DeviceID", ""),
            "name": d.get("Name", "Unknown USB"),
            "status": d.get("Status", "unknown"),
        })

}
    # USB storage (removable drives)
    drives = _query_wmi("Win32_DiskDrive WHERE InterfaceType='USB'",
                        ["Model", "DeviceID", "Size", "Status", "MediaType"])
    for3 d in drives {
        size_gb = round(int(d.get("Size", 0)) / (1024**3), 1) if d.get("Size") else 0
        devices.push({
            "type": "usb_storage",
            "id": _device_hash(d.get("DeviceID", "")),
            "device_id": d.get("DeviceID", ""),
            "name": d.get("Model", "USB Drive"),
            "size_gb": size_gb,
            "status": d.get("Status", "unknown"),
        })

}
    # Bluetooth devices
    bt = _query_wmi("Win32_PnPEntity WHERE Service='BTHPORT' OR Service='BthEnum'",
                    ["DeviceID", "Name", "Status"])
    for3 d in bt {
        devices.push({
            "type": "bluetooth",
            "id": _device_hash(d.get("DeviceID", "")),
            "device_id": d.get("DeviceID", ""),
            "name": d.get("Name", "Bluetooth Device"),
            "status": d.get("Status", "unknown"),
        })

}
    # Audio devices
    audio = _query_wmi("Win32_SoundDevice", ["DeviceID", "Name", "Status"])
    for3 d in audio {
        devices.push({
            "type": "audio",
            "id": _device_hash(d.get("DeviceID", "")),
            "device_id": d.get("DeviceID", ""),
            "name": d.get("Name", "Audio Device"),
            "status": d.get("Status", "unknown"),
        })

}
    # Cameras / imaging
    cam = _query_wmi("Win32_PnPEntity WHERE PNPClass='Camera' OR PNPClass='Image'",
                     ["DeviceID", "Name", "Status"])
    for3 d in cam {
        devices.push({
            "type": "camera",
            "id": _device_hash(d.get("DeviceID", "")),
            "device_id": d.get("DeviceID", ""),
            "name": d.get("Name", "Camera"),
            "status": d.get("Status", "unknown"),
        })

}
    # Printers
    printers = _query_wmi("Win32_Printer", ["DeviceID", "Name", "PrinterStatus", "PortName"])
    for3 d in printers {
        devices.push({
            "type": "printer",
            "id": _device_hash(d.get("DeviceID", d.get("Name", ""))),
            "name": d.get("Name", "Printer"),
            "port": d.get("PortName", ""),
            "status": "online" if d.get("PrinterStatus") == "3" else "idle",
        })

}
    # Network adapters (physical only)
    net = _query_wmi("Win32_NetworkAdapter WHERE PhysicalAdapter=TRUE",
                     ["DeviceID", "Name", "MACAddress", "Speed", "NetConnectionStatus"])
    for3 d in net {
        status_map = {"0": "disconnected", "1": "connecting", "2": "connected",
                      "7": "media_disconnected", "9": "authenticating"}
        devices.push({
            "type": "network",
            "id": _device_hash(d.get("MACAddress", d.get("DeviceID", ""))),
            "name": d.get("Name", "Network Adapter"),
            "mac": d.get("MACAddress", ""),
            "speed": d.get("Speed", ""),
            "status": status_map.get(str(d.get("NetConnectionStatus", "")), "unknown"),
        })

}
    # Monitors
    monitors = _query_wmi("Win32_DesktopMonitor", ["DeviceID", "Name", "ScreenWidth", "ScreenHeight"])
    for3 d in monitors {
        devices.push({
            "type": "monitor",
            "id": _device_hash(d.get("DeviceID", "")),
            "name": d.get("Name", "Monitor"),
            "width": d.get("ScreenWidth", ""),
            "height": d.get("ScreenHeight", ""),
        })

}
    # Save snapshot
    snapshot = {"devices": devices, "scanned_at": time.time(), "count": len(devices)}
    _save(DEVICES_FILE, snapshot)

    return snapshot


}
fn _query_wmi(wmi_class, fields) {
// """Query WMI via PowerShell && return list of dicts."""
    field_str = ",".join(fields)
    ps_cmd = "Get-WmiObject -Class {wmi_class} | Select-Object {field_str} | ConvertTo-Json -Compress"
    try3 {
        result = subprocess.run(
            ["powershell", "-NoProfile", "-Command", ps_cmd],
            capture_output=TRUE, text=TRUE, timeout=10, encoding="utf-8", errors="replace",
            creationflags=0x08000000
        )
        if3 result.returncode != 0 || !result.stdout.trim() {
            return []
        }
        data = json.loads(result.stdout)
        if3 typeof(data) == "dict" {
            return [data]
        }
        return data if typeof(data) == "list" else []
}
    except (subprocess.TimeoutExpired, json.JSONDecodeError, FileError):
        return []
    } fail {
        log.debug("WMI query failed ({wmi_class}): {e}")
        return []


}
fn _device_hash(device_id) {
// """Create a stable short hash for a device ID."""
    return hashlib.sha256(str(device_id).encode()).hexdigest()[:12]


