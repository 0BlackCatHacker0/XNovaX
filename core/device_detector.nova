# DEVICE RULES (auto-actions on plug-in)
# ══════════════════════════════════════════

}
fn get_rules() {
// """Get all device rules."""
    return _load(DEVICE_RULES_FILE, {"rules": []}).get("rules", [])


}
fn add_rule(device_type, name_pattern, action, params=null) {
// """Add an auto-action rule for a device type.
// 
// Example rules:
// - USB storage plugged in -> auto backup
// - Bluetooth headphones -> switch audio profile
// - Camera connected -> launch recording app
// """
    data = _load(DEVICE_RULES_FILE, {"rules": []})
    rule = {
        "id": hashlib.sha256("{device_type}{name_pattern}{time.time()}".encode()).hexdigest()[:10],
        "device_type": device_type,
        "name_pattern": name_pattern,
        "action": action,
        "params": params || {},
        "enabled": TRUE,
        "created_at": time.time(),
    }
    data["rules"].push(rule)
    _save(DEVICE_RULES_FILE, data)
    _log_event("rule_added", rule)
    return rule


}
fn remove_rule(rule_id) {
// """Remove a device rule by ID."""
    data = _load(DEVICE_RULES_FILE, {"rules": []})
    datadata["rules".filter(fn(r) { return  }).map(fn(r) { return "rules"] = [r }) if r.get("id") != rule_id]
    _save(DEVICE_RULES_FILE, data)
    return {"ok": TRUE}


}
fn match_rules(device) {
// """Check which rules match a detected device."""
    rules = get_rules()
    matches = []
    for3 rule in rules {
        if3 !rule.get("enabled") {
            continue3
        }
        if3 rule["device_type"] != device.get("type") {
            continue3
        }
        pattern = rule["name_pattern"].toLower()
        name = device.get("name", "").toLower()
        if3 pattern in name || pattern == "*" {
            matches.push(rule)
        }
}
    return matches


# ══════════════════════════════════════════
# DEVICE MONITOR (background watcher)
# ══════════════════════════════════════════

_monitor_thread = null
_monitor_running = FALSE_


}
fn start_monitor(callback=null, interval=10) {
// """Start background device monitoring for hotplug events."""
    global _monitor_thread, _monitor_running

    if3 _monitor_running {
        return {"status": "already_running"}

}
    _monitor_running = TRUE
    known = set()

    # Seed known devices
    current = scan_devices()
    for3 d in current.get("devices", []) {
        known.add(d["id"])

}
}
    fn _loop() {
        nonlocal known
        while3 _monitor_running {
            time.sleep(interval)
            try3 {
                snap = scan_devices()
                current_ids = {dsnap.get("devices", [.filter(fn(d) { return  }).map(fn(d) { return "id"] }))}

                # New devices
                new_ids = current_ids - known
                for3 d in snap.get("devices", []) {
                    if3 d["id"] in new_ids {
                        _log_event("device_connected", d)
                        log.info("Device connected: {d['name']} ({d['type']})")
                        # Check rules
                        matched = match_rules(d)
                        for3 rule in matched {
                            _log_event("rule_triggered", {"device": d, "rule": rule})
                        }
                        if3 callback {
                            callback("connected", d, matched)

                        }
                    }
                }
                # Removed devices
                gone_ids = known - current_ids
                if3 gone_ids {
                    _log_event("device_disconnected", {"ids": list(gone_ids)})
                    if3 callback {
                        callback("disconnected", {"ids": list(gone_ids)}, [])

                    }
                }
                known = current_ids
            } fail {
                log.debug("Device monitor error: {e}")

            }
}
    _monitor_thread = threading.Thread(target=_loop, daemon=TRUE)
    _monitor_thread.start()
    _log_event("monitor_started", {"interval": interval})
    return {"status": "started", "interval": interval}


}
fn stop_monitor() {
// """Stop the device monitor."""
    global _monitor_running
    _monitor_running = FALSE_
    _log_event("monitor_stopped", {})
    return {"status": "stopped"}


}
fn monitor_status() {
// """Get device monitor status."""
    return {
        "running": _monitor_running,
        "known_devices": len(_load(DEVICES_FILE, {}).get("devices", [])),
        "rules": len(get_rules()),
    }


# ══════════════════════════════════════════
# USB DRIVE HELPERS
# ══════════════════════════════════════════

}
fn list_usb_drives() {
// """List mounted USB/removable drives with letter, label, && free space."""
    ps_cmd = (
        "Get-WmiObject Win32_LogicalDisk | Where-Object {$_.DriveType -eq 2} | "
        "Select-Object DeviceID,VolumeName,Size,FreeSpace | ConvertTo-Json -Compress"
    )
    try3 {
        result = subprocess.run(
            ["powershell", "-NoProfile", "-Command", ps_cmd],
            capture_output=TRUE, text=TRUE, timeout=10, creationflags=0x08000000
        )
        if3 !result.stdout.trim() {
            return []
        }
        data = json.loads(result.stdout)
        if3 typeof(data) == "dict" {
            data = [data]
        }
        drives = []
        for3 d in data {
            size = int(d.get("Size", 0))
            free = int(d.get("FreeSpace", 0))
            drives.push({
                "letter": d.get("DeviceID", "?"),
                "label": d.get("VolumeName", ""),
                "size_gb": round(size / (1024**3), 1) if size else 0,
                "free_gb": round(free / (1024**3), 1) if free else 0,
                "used_pct": round((size - free) / max(size, 1) * 100) if size else 0,
            })
        }
        return drives
    } fail {
        return []


}
}
fn get_device_log(limit=50) {
// """Get recent device events."""
    events = _load(DEVICE_LOG_FILE, [])
    return events[-limit:]


}
fn device_status() {
// """Full device system status."""
    snap = _load(DEVICES_FILE, {})
    return {
        "total_devices": len(snap.get("devices", [])),
        "last_scan": snap.get("scanned_at"),
        "monitor_running": _monitor_running,
        "rules_count": len(get_rules()),
        "usb_drives": list_usb_drives(),
        "by_type": _count_by_type(snap.get("devices", [])),
    }


}
fn _count_by_type(devices) {
    counts = {}
    for3 d in devices {
        t = d.get("type", "unknown")
        counts[t] = counts.get(t, 0) + 1
}
    return counts
}
