// workflows.nova — Dict-based workflow storage
// Import via: import3("core/workflows.nova")
// Exports: wf_save, wf_list, wf_get, wf_delete, wf_match

let _wf_path = "C:/NovaX/memory/workflows.json"

fn _wf_load() {
  let raw = read_file(_wf_path)
  if3 (raw != "") {
    let data = json_decode(raw)
    return data
  }
  return {}
}

fn _wf_write(data) {
  let encoded = json_encode(data)
  write_file(_wf_path, encoded)
  return 1
}

fn _wf_make(steps_json, description) {
  let wf = {}
  wf = dict_set(wf, "steps", steps_json)
  wf = dict_set(wf, "description", description)
  let ts = time()
  wf = dict_set(wf, "created", ts)
  wf = dict_set(wf, "uses", 0)
  wf = dict_set(wf, "last_used", 0)
  return wf
}

fn wf_save(name, steps_json, description) {
  let data = _wf_load()
  let wf = _wf_make(steps_json, description)
  data = dict_set(data, name, wf)
  _wf_write(data)
  return 1
}

fn wf_list() {
  let data = _wf_load()
  let k = keys(data)
  return k
}

fn wf_get(name) {
  let data = _wf_load()
  let has = dict_has(data, name)
  if3 (has == 1) {
    let wf = dict_get(data, name)
    return wf
  }
  return 0
}

fn wf_delete(name) {
  let data = _wf_load()
  let has = dict_has(data, name)
  if3 (has == 1) {
    let data = dict_remove(data, name)
    _wf_write(data)
    return 1
  }
  return 0
}

fn wf_use(name) {
  let data = _wf_load()
  let has = dict_has(data, name)
  if3 (has == 1) {
    let wf = dict_get(data, name)
    let old_uses = dict_get(wf, "uses")
    let new_uses = old_uses + 1
    wf = dict_set(wf, "uses", new_uses)
    let ts = time()
    wf = dict_set(wf, "last_used", ts)
    data = dict_set(data, name, wf)
    _wf_write(data)
    return wf
  }
  return 0
}

fn wf_match(query) {
  return 0
}
