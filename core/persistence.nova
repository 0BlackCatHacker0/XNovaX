// persistence.nova — File-based JSON state storage
// Import via: import3("core/persistence.nova")
// Exports: persist_load, persist_get, persist_set, persist_delete, persist_keys, persist_snapshot

let _persist_path = "C:/NovaX/data/persistence.json"

fn _persist_safe_load() {
  let raw = read_file(_persist_path)
  if3 (raw != "") {
    let parsed = json_decode(raw)
    return parsed
  }
  return {}
}

fn _persist_write(store) {
  let encoded = json_encode(store)
  write_file(_persist_path, encoded)
  return 1
}

fn persist_load() {
  let loaded = _persist_safe_load()
  return loaded
}

fn persist_get(store, key, default_val) {
  let has = dict_has(store, key)
  if3 (has == 1) {
    let val = dict_get(store, key)
    return val
  }
  return default_val
}

fn persist_set(key, value) {
  let store = _persist_safe_load()
  store = dict_set(store, key, value)
  _persist_write(store)
  return 1
}

fn persist_delete(key) {
  let store = _persist_safe_load()
  let has = dict_has(store, key)
  if3 (has == 1) {
    let store = dict_remove(store, key)
    _persist_write(store)
    return 1
  }
  return 0
}

fn persist_keys() {
  let store = _persist_safe_load()
  let k = keys(store)
  return k
}

fn persist_snapshot() {
  let store = _persist_safe_load()
  let encoded = json_encode(store)
  let copy = json_decode(encoded)
  return copy
}

fn persist_register(name) {
  return 1
}

fn persist_restore() {
  return 1
}

fn persist_start_auto_save() {
  return 1
}

fn persist_stop_auto_save() {
  return 1
}
