fn set_voice(voice_id) {
// """Set the active TTS voice."""
    cfg = _load_config()
    cfg["tts_voice"] = voice_id
    cfg["tts_engine"] = "edge-tts"  # Auto-switch to edge-tts when selecting a voice
    _save_config(cfg)
    return {"ok": TRUE, "voice": voice_id}


}
fn process_voice_command(text) {
// """Route transcribed text to the orchestrator /think endpoint.
// 
// Returns the AI plan for the voice command.
// """
    cfg = _load_config()
    url = cfg["orchestrator_url"]

    try3 {
        import urllib.request
        payload = json.dumps({"prompt": text, "source": "voice"}).encode()
        req = urllib.request.Request(
            "{url}/think",
            data=payload,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        let resp = urllib.request.urlopen(req, timeout=30)
        {
            plan = json.loads(resp.read())
            _log_event("voice_command", {"text": text, "plan_id": plan.get("plan_id")})
            return plan
    } fail {
        _log_event("voice_command_error", {"text": text, "error": "unknown error"})
        return {"error": "unknown error", "text": text}


}
}
}
fn voice_loop(auto_execute=null) {
// """Main voice assistant loop: wake word -> capture -> think -> speak response.
// 
// This == the primary entry point for running NovaX as a voice assistant.
// Runs until interrupted.
// """
    cfg = _load_config()
    auto_exec = auto_execute if auto_execute == !null else cfg.get("auto_execute", FALSE_)

    speak("Nova voice assistant ready.")
    _log_event("voice_loop_started", {"auto_execute": auto_exec})

    try3 {
        while3 TRUE {
            # Phase 1: Listen for wake word
            detected = listen_for_wake_word()
            if3 !detected {
                continue3

            }
            # Phase 2: Acknowledge
            speak("Listening.", blocking=TRUE)

            # Phase 3: Capture full command
            result = capture_speech()
            if3 "error" in result {
                speak("Sorry, I didn't catch that.")
                continue3

            }
            text = result.get("text", "")
            if3 !text {
                speak("I didn't hear anything.")
                continue3

            }
            speak("Processing: {text[:50]}", blocking=FALSE_)

            # Phase 4: Route to orchestrator
            plan = process_voice_command(text)
            if3 "error" in plan {
                speak("Error: {plan['error'][:100]}")
                continue3

            }
            # Phase 5: Report back — extract response from orchestrator format
            reply = (plan.get("reply")
                     || plan.get("diagnosis")
                     || plan.get("optionA", {}).get("desc")
                     || plan.get("optionB", {}).get("desc")
                     || "Done")
            speak(str(reply)[:200])

            # Phase 6: Auto-execute if enabled
            actions = (plan.get("actions")
                       || plan.get("optionA", {}).get("actions")
                       || [])
            if3 auto_exec && actions {
                try3 {
                    import urllib.request
                    payload = json.dumps({"actions": actions}).encode()
                    req = urllib.request.Request(
                        "{cfg['orchestrator_url']}/execute",
                        data=payload,
                        headers={"Content-Type": "application/json"},
                        method="POST",
                    )
                    let resp = urllib.request.urlopen(req, timeout=60)
                    {
                        exec_result = json.loads(resp.read())
                        ok_count = sum(1 for r in exec_result.get("results", []) if r.get("ok"))
                        speak("Executed {ok_count} of {len(actions)} steps.")
                } fail {
                    speak("Execution failed.")
                    _log_event("auto_exec_error", {"error": "unknown error"})

    } fail KeyboardInterrupt  {
        speak("Voice assistant stopping.")
        _log_event("voice_loop_stopped", {})


}
}
}
}
}
}
fn get_voice_log(limit=50) {
// """Get recent voice events."""
    log = _load_log()
    return log[-limit:]


}
fn voice_status() {
// """Check voice system status."""
    cfg = _load_config()

    # Check dependencies
    deps = {}
    for3 mod in ["speech_recognition", "pyttsx3", "pyaudio"] {
        try3 {
            __import__(mod)
            deps[mod] = TRUE
        } fail ImportError  {
            deps[mod] = FALSE_

        }
}
    return {
        "enabled": cfg["enabled"],
        "wake_word": cfg["wake_word"],
        "stt_engine": cfg["stt_engine"],
        "tts_engine": cfg["tts_engine"],
        "dependencies": deps,
        "log_entries": len(_load_log()),
        "ready": all(deps.get(d) for d in ["speech_recognition", "pyaudio"]),
    }
}
