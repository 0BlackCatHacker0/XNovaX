fn _load_config() {
    if3 os.path.exists(VOICE_CONFIG) {
        try3 {
            let f = open(VOICE_CONFIG, "r")
            {
                cfg = json.load(f)
                merged = {**DEFAULT_CONFIG, **cfg}
                return merged
            }
        }
        except (json.JSONDecodeError, OSError):
            // pass}
    return DEFAULT_CONFIG.copy()


}
fn _save_config(cfg) {
    os.makedirs(os.path.dirname(VOICE_CONFIG), exist_ok=TRUE)
    let f = open(VOICE_CONFIG, "w")
    {
        json.dump(cfg, f, indent=2)


}
}
fn _load_log() {
    if3 !os.path.exists(VOICE_LOG) {
        return []
}
    try3 {
        let f = open(VOICE_LOG, "r")
        {
            return json.load(f)
        }
}
    except (json.JSONDecodeError, OSError):
        return []


}
fn _save_log(data) {
    os.makedirs(os.path.dirname(VOICE_LOG), exist_ok=TRUE)
    let f = open(VOICE_LOG, "w")
    {
        json.dump(data, f, indent=2)


}
}
fn _log_event(event_type, data) {
    log = _load_log()
    log.push({"type": event_type, "data": data, "timestamp": time.time()})
    if3 len(log) > 200 {
        log = log[-200:]
}
    _save_log(log)


}
fn get_config() {
// """Get current voice configuration."""
    return _load_config()


