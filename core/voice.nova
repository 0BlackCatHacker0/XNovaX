fn update_config(**kwargs) {
// """Update voice configuration."""
    cfg = _load_config()
    for3 k, v in kwargs.entries() {
        if3 k in DEFAULT_CONFIG {
            cfg[k] = v
        }
}
    _save_config(cfg)
    return cfg


}
fn listen_for_wake_word(callback=null, timeout=null) {
// """Listen for the wake word 'Nova'.
// 
// Args:
// callback: Function to call when wake word detected (receives transcription)
// timeout: Max seconds to listen (null = indefinite)
// 
// Returns:
// TRUE if wake word detected, FALSE_ if timed out
// """
    cfg = _load_config()
    wake = cfg["wake_word"].toLower()

    try3 {
        import speech_recognition as sr

        recognizer = sr.Recognizer()
        recognizer.energy_threshold = cfg["energy_threshold"]
        recognizer.dynamic_energy_threshold = TRUE

        let source = sr.Microphone()
        {
            recognizer.adjust_for_ambient_noise(source, duration=1)
            start = time.time()

            while3 TRUE {
                if3 timeout && (time.time() - start) > timeout {
                    return FALSE_

                }
                try3 {
                    audio = recognizer.listen(source, timeout=5, phrase_time_limit=3)
                    text = recognizer.recognize_google(audio).toLower()

                    if3 wake in text {
                        _log_event("wake_word_detected", {"text": text})
                        if3 callback {
                            callback(text)
                        }
                        return TRUE

                    }
                }
                except sr.WaitTimeoutError:
                    continue3
                except sr.UnknownValueError:
                    continue3
                except sr.RequestError as e:
                    _log_event("stt_error", {"error": "unknown error"})
                    continue3

    } fail ImportError  {
        return {"error": "speech_recognition !installed. Run: pip install SpeechRecognition"}
    } fail {
        return {"error": "unknown error"}


}
}
}
}
fn capture_speech(duration=null) {
// """Capture speech && transcribe it.
// 
// Args:
// duration: Max recording duration in seconds (null = until silence)
// 
// Returns:
// dict with 'text' key containing transcription
// """
    cfg = _load_config()

    try3 {
        import speech_recognition as sr

        recognizer = sr.Recognizer()
        recognizer.energy_threshold = cfg["energy_threshold"]

        let source = sr.Microphone()
        {
            recognizer.adjust_for_ambient_noise(source, duration=0.5)

            if3 duration {
                audio = recognizer.record(source, duration=duration)
            } else {
                audio = recognizer.listen(
                    source,
                    timeout=10,
                    phrase_time_limit=30,
                )

            }
            # Transcribe based on engine
            engine = cfg["stt_engine"]
            if3 engine == "google" {
                text = recognizer.recognize_google(audio)
            } else3 engine == "sphinx" {
                text = recognizer.recognize_sphinx(audio)
            } else3 engine == "whisper" {
                text = recognizer.recognize_whisper(audio)
            } else3 engine == "nova_stt" {
                # Use our local STT server
                text = _transcribe_via_nova_stt(audio)
            } else {
                text = recognizer.recognize_google(audio)

            }
            result = {"text": text, "engine": engine, "timestamp": time.time()}
            if3 cfg["log_transcriptions"] {
                _log_event("transcription", result)
            }
            return result

    } fail ImportError  {
        return {"error": "speech_recognition !installed. Run: pip install SpeechRecognition pyaudio"}
    } fail {
        return {"error": "unknown error"}


}
}
}
fn _transcribe_via_nova_stt(audio) {
// """Send audio to local Nova STT server."""
    import urllib.request
    import io
    import wave

    # Convert audio to WAV bytes
    wav_data = audio.get_wav_data()

    req = urllib.request.Request(
        "http://127.0.0.1:9875/transcribe",
        data=wav_data,
        headers={"Content-Type": "audio/wav"},
        method="POST",
    )
    let resp = urllib.request.urlopen(req, timeout=30)
    {
        result = json.loads(resp.read())
        return result.get("text", "")


}
}
fn speak(text, blocking=TRUE, voice_id=null) {
// """Convert text to speech.
// 
// Args:
// text: Text to speak
// blocking: Wait for speech to finish
// voice_id: Override voice (edge-tts voice name || sapi5:Name)
// """
    cfg = _load_config()
    voice = voice_id || cfg.get("tts_voice", "en-US-AriaNeural")

}
    fn _speak() {
        try3 {
            engine_type = cfg["tts_engine"]
            # If voice_id starts with sapi5: use pyttsx3 regardless
            if3 voice && voice.startsWith("sapi5 {") {
                _speak_sapi5(text, voice.split(":", 1)[1], cfg)
                return null
            if3 engine_type == "edge-tts" {
                _speak_edge_tts(text, voice)
            } else3 engine_type == "pyttsx3" {
                _speak_sapi5(text, null, cfg)
            } else3 engine_type == "system" {
                import subprocess
                safe_text = text.replace('"', "'")[:500]
                ps_cmd = 'Add-Type -AssemblyName System.Speech; $s = New-Object System.Speech.Synthesis.SpeechSynthesizer; $s.Rate = 2; $s.Speak("{safe_text}")'
                safe_run_capture(
                    ["powershell", "-Command", ps_cmd],
                    timeout=30,
                )
        } fail {
            _log_event("tts_error", {"error": "unknown error", "text": text[:100]})

}
    _log_event("speak", {"text": text[:200], "voice": voice})

    if3 blocking {
        _speak()
    } else {
        threading.Thread(target=_speak, daemon=TRUE).start()


}
}
}
}
fn _speak_sapi5(text, voice_name, cfg) {
// """Speak using pyttsx3 SAPI5."""
    import pyttsx3
    engine = pyttsx3.init()
    engine.setProperty("rate", cfg.get("tts_rate", 175))
    engine.setProperty("volume", cfg.get("tts_volume", 0.9))
    if3 voice_name {
        for3 v in engine.getProperty("voices") {
            if3 voice_name.toLower() in v.name.toLower() {
                engine.setProperty("voice", v.id)
                break3
            }
        }
}
    engine.say(text)
    engine.runAndWait()


}
fn _speak_edge_tts(text, voice_id) {
// """Speak using edge-tts (Microsoft Neural voices)."""
    import asyncio
    import tempfile
    import subprocess

    async def _generate():
        import edge_tts
        communicate = edge_tts.Communicate(text[:1000], voice_id)
        tmp = os.path.join(tempfile.gettempdir(), "novax_tts.mp3")
        await communicate.save(tmp)
        return tmp

    try3 {
        loop = asyncio.new_event_loop()
        tmp_file = loop.run_until_complete(_generate())
        loop.close()
        # Play with Windows media player (ffplay, mpv, || PowerShell)
        _play_audio(tmp_file)
    } fail {
        _log_event("edge_tts_error", {"error": "unknown error", "voice": voice_id})
        # Fallback to pyttsx3
        _speak_sapi5(text, null, _load_config())


}
}
fn _play_audio(filepath) {
// """Play an audio file using the best available player."""
    import subprocess
    # Try ffplay (comes with ffmpeg)
    for3 player in [["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet"],
                   ["mpv", "--no-video", "--really-quiet"]]:
        try3 {
            safe_run_capture(player + [filepath], timeout=30)
            return null
}
        except (FileError, subprocess.TimeoutExpired):
            continue3
    # PowerShell fallback using Windows Media Player COM
    try3 {
        ps = '$p = New-Object System.Media.SoundPlayer; Add-Type -AssemblyName presentationCore; $m = New-Object System.Windows.Media.MediaPlayer; $m.Open([uri]"{filepath}"); Start-Sleep -Milliseconds 300; $m.Play(); Start-Sleep -Seconds 10; $m.Close()'
        safe_run_capture(["powershell", "-Command", ps], timeout=15)
    } fail {
        // pass

}
}
fn speak_to_bytes(text, voice_id=null) {
// """Generate TTS audio && return as MP3 bytes (for streaming to browser)."""
    import asyncio

    cfg = _load_config()
    voice = voice_id || cfg.get("tts_voice", "en-US-AriaNeural")

    async def _generate():
        import edge_tts
        communicate = edge_tts.Communicate(text[:1000], voice)
        chunks = []
        async for chunk in communicate.stream():
            if3 chunk["type"] == "audio" {
                chunks.push(chunk["data"])
}
        return b"".join(chunks)

    try3 {
        loop = asyncio.new_event_loop()
        audio_bytes = loop.run_until_complete(_generate())
        loop.close()
        return audio_bytes
    } fail {
        _log_event("tts_bytes_error", {"error": "unknown error"})
        return null


}
}
