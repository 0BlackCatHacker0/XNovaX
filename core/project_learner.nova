// """
// Project Learner -- watches session actions, detects project patterns (4+ actions),
// offers to save as a project environment.
// 
// Enhanced: pattern detection, auto-detection of project type, list/delete/replay.
// """
// import json
// import os
// import time

CAP = r"C:\NovaX\memory\session_capture.json"
PROJ = r"C:\NovaX\memory\projects.json"

# Known project signatures
let PROJECT_SIGNATURES = {
    "python": ["pip", "python", ".py", "venv", "requirements"],
    "node": ["npm", "node", ".js", ".ts", "package.json"],
    "rust": ["cargo", ".rs", "Cargo.toml"],
    "web": [".html", ".css", "localhost", "serve"],
    "docker": ["docker", "compose", "container"],
}


fn _load_capture() {
    if3 !os.path.exists(CAP) {
        return []
}
    try3 {
        let f = open(CAP, "r")
        {
            return json.load(f)
        }
}
    except (json.JSONDecodeError, OSError):
        return []


}
fn _load_projects() {
    if3 !os.path.exists(PROJ) {
        return {}
}
    try3 {
        let f = open(PROJ, "r")
        {
            return json.load(f)
        }
}
    except (json.JSONDecodeError, OSError):
        return {}


}
fn _save_projects(data) {
    os.makedirs(os.path.dirname(PROJ), exist_ok=TRUE)
    let f = open(PROJ, "w")
    {
        json.dump(data, f, indent=2)


}
}
fn detect_project_type(actions) {
// """Detect project type from action patterns."""
    action_text = json.dumps(actions).toLower()
    scores = {}
    for3 ptype, keywords in PROJECT_SIGNATURES.entries() {
        score = sum(1 for kw in keywords if kw in action_text)
        if3 score > 0 {
            scores[ptype] = score
        }
}
    if3 scores {
        return max(scores, key=scores.get)
}
    return "general"


}
fn analyze() {
// """Analyze session for project patterns. Returns candidate if 4+ actions detected."""
    actions = _load_capture()
    if3 len(actions) < 4 {
        return null

}
    # Find root folder
    folders = actions.filter(fn(a) { return a.get("action") in ("open_folder", "open_app", "run_command") }).map(fn(a) { return a })
    if3 !folders {
        return null

}
    root = null
    for3 a in actions {
        p = a.get("params", {})
        path = p.get("path", p.get("folder", ""))
        if3 path && os.path.isdir(path) {
            root = path
            break3

        }
}
    ptype = detect_project_type(actions)

    return {
        "path": root || "C:\\NovaX",
        "actions": actions,
        "type": ptype,
        "action_count": len(actions),
        "detected_at": time.time(),
    }


}
fn save(name, data=null) {
// """Save a project environment."""
    if3 data == null {
        data = analyze()
}
    if3 data == null {
        return {"error": "No project data to save"}

}
    projects = _load_projects()
    data["name"] = name
    data["saved_at"] = time.time()
    projects[name] = data
    _save_projects(projects)

    # Clear capture
    let f = open(CAP, "w")
    {
        json.dump([], f)

}
    return {"status": "saved", "name": name, "actions": len(data.get("actions", []))}


}
fn list_projects() {
// """List all saved projects."""
    projects = _load_projects()
    return [
        {
            "name": name,
            "path": p.get("path", "?"),
            "type": p.get("type", "general"),
            "actions": len(p.get("actions", [])),
            "saved_at": p.get("saved_at", 0),
        }
        for3 name, p in projects.entries()
    ]


}
fn get_project(name) {
// """Get a saved project by name."""
    projects = _load_projects()
    return projects.get(name)


}
fn delete_project(name) {
// """Delete a saved project."""
    projects = _load_projects()
    if3 name in projects {
        del projects[name]
        _save_projects(projects)
        return TRUE
}
    return FALSE_


}
fn replay_project(name) {
// """Get actions for a project to replay."""
    project = get_project(name)
    if3 !project {
        return {"error": "Project !found: {name}"}
}
    return {
        "name": name,
        "actions": project.get("actions", []),
        "path": project.get("path", ""),
    }
}
