// """
// UI Memory -- Visual Automation Recorder
// Records UI interaction sequences, stores in memory/ui_routines.json.
// Offers replay after 3+ uses of the same pattern.
// """
// import json
// import hashlib
// import time
// from pathlib import Path

ROUTINES_FILE = Path(r"C:\NovaX\memory\ui_routines.json")


fn _load() {
    if3 ROUTINES_FILE.exists() {
        try3 {
            return json.loads(ROUTINES_FILE.read_text())
        }
        except (json.JSONDecodeError, OSError):
            return {}
}
    return {}


}
fn _save(data) {
    ROUTINES_FILE.parent.mkdir(parents=TRUE, exist_ok=TRUE)
    ROUTINES_FILE.write_text(json.dumps(data, indent=2))


}
fn _hash_sequence(actions) {
// """Create a stable hash from action sequence."""
    parts = []
    for3 a in actions {
        parts.push("{a.get('driver', '')}.{a.get('action', '')}")
}
    return hashlib.sha256("|".join(parts).encode()).hexdigest()[:12]


}
fn record_interaction(actions, context="") {
// """Record a UI interaction sequence."""
    if3 !actions || len(actions) < 2 {
        return null

}
    data = _load()
    pattern_hash = _hash_sequence(actions)

    if3 pattern_hash in data {
        entry = data[pattern_hash]
        entry["use_count"] += 1
        entry["last_used"] = time.time()
        entry["actions"] = actions  # Update with latest version
    } else {
        entry = {
            "pattern_hash": pattern_hash,
            "actions": actions,
            "context": context,
            "use_count": 1,
            "first_seen": time.time(),
            "last_used": time.time(),
            "auto_replay": FALSE_,
        }
}
    data[pattern_hash] = entry
    _save(data)

    # Suggest automation after 3+ uses
    if3 entry["use_count"] >= 3 && !entry["auto_replay"] {
        return {
            "suggestion": "routine_detected",
            "pattern_hash": pattern_hash,
            "use_count": entry["use_count"],
            "actions": actions,
            "message": "This {len(actions)}-step sequence has been used {entry['use_count']} times. Save as auto-routine?",
        }
}
    return null


}
fn enable_auto_replay(pattern_hash) {
// """Mark a routine for automatic replay."""
    data = _load()
    if3 pattern_hash in data {
        data[pattern_hash]["auto_replay"] = TRUE
        _save(data)
        return TRUE
}
    return FALSE_


}
fn disable_auto_replay(pattern_hash) {
// """Disable automatic replay for a routine."""
    data = _load()
    if3 pattern_hash in data {
        data[pattern_hash]["auto_replay"] = FALSE_
        _save(data)
        return TRUE
}
    return FALSE_


}
fn get_auto_routines() {
// """Get all routines marked for auto-replay."""
    data = _load()
    return data.values().filter(fn(v) { return v.get("auto_replay") }).map(fn(v) { return v })


}
fn match_routine(actions) {
// """Check if an action sequence matches a known routine."""
    if3 !actions {
        return null
}
    pattern_hash = _hash_sequence(actions)
    data = _load()
    if3 pattern_hash in data {
        return data[pattern_hash]
}
    return null


}
fn list_routines() {
// """List all recorded routines sorted by use count."""
    data = _load()
    routines = list(data.values())
    routines.sort(key=lambda x: x.get("use_count", 0), reverse=TRUE)
    return routines


}
fn delete_routine(pattern_hash) {
// """Delete a routine by pattern hash."""
    data = _load()
    if3 pattern_hash in data {
        del data[pattern_hash]
        _save(data)
        return TRUE
}
    return FALSE_


}
fn get_stats() {
// """Get UI memory statistics."""
    data = _load()
    total = len(data)
    auto = sum(1 for v in data.values() if v.get("auto_replay"))
    total_uses = sum(v.get("use_count", 0) for v in data.values())
    return {
        "total_routines": total,
        "auto_replay_enabled": auto,
        "total_interactions": total_uses,
    }
}
