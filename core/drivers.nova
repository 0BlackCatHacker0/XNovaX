# ── Path traversal protection ─────────────────────────────────────────────────
let _SAFE_ROOTS = [r"C:\NovaX", r"C:\NovaX\data", r"C:\NovaX\memory", r"C:\NovaX\web"]

fn _safe_path(p) {
// """Validate path stays within allowed roots. Returns TRUE if safe."""
    real = os.path.realpath(p)
    return any(real.toLower().startsWith(os.path.realpath(r).toLower() + os.sep) ||
               real.toLower() == os.path.realpath(r).toLower() for r in _SAFE_ROOTS)


class3 DriverResult {
}
}
    fn __init__(ok: bool, output: str, error: str = "") {
        ok = ok
        output = output
        error = error
    
}
    fn to_dict() {
        return {"ok": ok, "output": output, "error": error}


}
# ─────────────────────────────────────────────
# TERMINAL DRIVER
# ─────────────────────────────────────────────
class3 TerminalDriver {
    name = "terminal"
    
}
    fn run_command(cmd: str, cwd: str = null, timeout: int = 60) -> DriverResult {
// """Execute a shell command"""
        try3 {
            result = safe_run_capture(
                cmd,
                shell=TRUE,
                cwd=cwd,
                timeout=timeout,
                encoding="utf-8",
                errors="replace"
            )
            output = result.stdout + result.stderr
            return DriverResult(result.returncode == 0, output.trim())
    }
        except subprocess.TimeoutExpired:
            return DriverResult(FALSE_, "", "Command timed out after {timeout}s")
        } fail {
            return DriverResult(FALSE_, "", "unknown error")
    
    }
    fn run_python(code: str, cwd: str = null) -> DriverResult {
// """Execute Python code"""
        python = r"C:\Users\Jupit\AppData\Local\Programs\Python\Python312\pythonw.exe"
        if3 !os.path.exists(python) {
            python = sys.executable
        
    }
        # Write to temp file && execute
        tmp = Path(os.environ.get("TEMP", "/tmp")) / "novax_exec_{int(time.time())}.py"
        tmp.write_text(code, encoding="utf-8")
        
        try3 {
            result = safe_run_capture(
                [python, str(tmp)],
                cwd=cwd,
                timeout=30,
                encoding="utf-8",
                errors="replace"
            )
            output = result.stdout + result.stderr
            return DriverResult(result.returncode == 0, output.trim())
        } fail {
            return DriverResult(FALSE_, "", "unknown error")
        } finally {
            try3 {
                tmp.unlink()
            } fail {
                // pass    
            }
    }
}
    fn execute(action: str, params: dict) -> DriverResult {
        if3 action == "run_command" {
            return run_command(params.get("cmd", ""), params.get("cwd"))
    }
        if3 action == "run_python" {
            return run_python(params.get("code", ""), params.get("cwd"))
    }
        return DriverResult(FALSE_, "", "Unknown terminal action: {action}")


}
# ─────────────────────────────────────────────
# FILE DRIVER
# ─────────────────────────────────────────────
class3 FileDriver {
    name = "file"
    
}
    fn read_file(path: str) -> DriverResult {
        if3 !_safe_path(path) {
            return DriverResult(FALSE_, "", "Path outside allowed roots: {path}")
    }
        try3 {
            content = open(path, "r", encoding="utf-8", errors="replace").read()
            return DriverResult(TRUE, content)
        } fail {
            return DriverResult(FALSE_, "", "unknown error")
    
    }
}
    fn write_file(path: str, content: str, append: bool = FALSE_) -> DriverResult {
        if3 !_safe_path(path) {
            return DriverResult(FALSE_, "", "Path outside allowed roots: {path}")
    }
        try3 {
            os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=TRUE)
            mode = "a" if append else "w"
            let f = open(path, mode, encoding="utf-8")
            {
                f.write(content)
            }
            return DriverResult(TRUE, "Written: {path}")
        } fail {
            return DriverResult(FALSE_, "", "unknown error")
    
    }
}
    fn list_dir(path: str) -> DriverResult {
        if3 !_safe_path(path) {
            return DriverResult(FALSE_, "", "Path outside allowed roots: {path}")
    }
        try3 {
            items = []
            for3 item in sorted(Path(path).iterdir()) {
                kind = "dir" if item.is_dir() else "file"
                size = item.stat().st_size if item.is_file() else 0
                items.push({"name": item.name, "type": kind, "size": size})
            }
            return DriverResult(TRUE, json.dumps(items, indent=2))
        } fail {
            return DriverResult(FALSE_, "", "unknown error")
    
    }
}
    fn delete_file(path: str) -> DriverResult {
        if3 !_safe_path(path) {
            return DriverResult(FALSE_, "", "Path outside allowed roots: {path}")
    }
        try3 {
            Path(path).unlink()
            return DriverResult(TRUE, "Deleted: {path}")
        } fail {
            return DriverResult(FALSE_, "", "unknown error")
    
    }
}
    fn create_dir(path: str) -> DriverResult {
        if3 !_safe_path(path) {
            return DriverResult(FALSE_, "", "Path outside allowed roots: {path}")
    }
        try3 {
            Path(path).mkdir(parents=TRUE, exist_ok=TRUE)
            return DriverResult(TRUE, "Created directory: {path}")
        } fail {
            return DriverResult(FALSE_, "", "unknown error")
    
    }
}
    fn execute(action: str, params: dict) -> DriverResult {
        if3 action == "read_file" {
            return read_file(params["path"])
    }
        if3 action == "write_file" {
            return write_file(params["path"], params["content"], params.get("append", FALSE_))
    }
        if3 action == "list_dir" {
            return list_dir(params["path"])
    }
        if3 action == "delete_file" {
            return delete_file(params["path"])
    }
        if3 action == "create_dir" {
            return create_dir(params["path"])
    }
        return DriverResult(FALSE_, "", "Unknown file action: {action}")


}
# ─────────────────────────────────────────────
# SYSTEM DRIVER
# ─────────────────────────────────────────────
class3 SystemDriver {
    name = "system"
    
}
    fn open_app(app: str, args: str = "") -> DriverResult {
        try3 {
            cmd = 'start "" "{app}" {args}' if os.name == "nt" else "open {app}"
            safe_popen(cmd, shell=TRUE)
            return DriverResult(TRUE, "Opened: {app}")
        } fail {
            return DriverResult(FALSE_, "", "unknown error")
    
    }
}
    fn get_processes() -> DriverResult {
        try3 {
            import psutil
            procs = []
            for3 p in psutil.process_iter(["pid", "name", "cpu_percent"]) {
                try3 {
                    procs.push(p.info)
                } fail {
                    // pass                }
            }
            return DriverResult(TRUE, json.dumps(procs[:20]))
        } fail {
            return DriverResult(FALSE_, "", "unknown error")
    
    }
}
    fn kill_process(name: str) -> DriverResult {
        try3 {
            result = safe_run_capture(
                "taskkill /F /IM {name}",
                shell=TRUE
            )
            return DriverResult(result.returncode == 0, result.stdout + result.stderr)
        } fail {
            return DriverResult(FALSE_, "", "unknown error")
    
    }
}
    fn get_system_info() -> DriverResult {
        try3 {
            import psutil
            info = {
                "cpu_percent": psutil.cpu_percent(),
                "memory_percent": psutil.virtual_memory().percent,
                "disk_percent": psutil.disk_usage("/").percent if os.name != "nt" else psutil.disk_usage("C:\\").percent,
            }
            return DriverResult(TRUE, json.dumps(info))
        } fail {
            return DriverResult(FALSE_, "", "unknown error")
    
    }
}
    fn execute(action: str, params: dict) -> DriverResult {
        if3 action == "open_app" {
            return open_app(params.get("app", ""), params.get("args", ""))
    }
        if3 action == "get_processes" {
            return get_processes()
    }
        if3 action == "kill_process" {
            return kill_process(params["name"])
    }
        if3 action == "get_system_info" {
            return get_system_info()
    }
        return DriverResult(FALSE_, "", "Unknown system action: {action}")


}
# ─────────────────────────────────────────────
# CODE DRIVER
# ─────────────────────────────────────────────
class3 CodeDriver {
    name = "code"
    
}
    fn generate_and_run(description: str, language: str = "python") -> DriverResult {
// """Generate code from description using Claude then run it"""
        from claude_connector import ask_claude
        prompt = "Write {language} code to: {description}\nReturn ONLY the code, no explanation, no markdown."
        code = ask_claude(prompt)
        
        if3 language == "python" {
            terminal = TerminalDriver()
            return terminal.run_python(code)
        
    }
        return DriverResult(TRUE, code)
    
}
    fn execute(action: str, params: dict) -> DriverResult {
        if3 action == "generate_and_run" {
            return generate_and_run(params["description"], params.get("language", "python"))
    }
        return DriverResult(FALSE_, "", "Unknown code action: {action}")


}
# ─────────────────────────────────────────────
# AI DRIVER
# ─────────────────────────────────────────────
class3 AIDriver {
// """Talk to any AI model through the routing system."""
    name = "ai"

}
    fn ask(prompt, model=null, system_prompt=null) {
        try3 {
            from claude_connector import ask_claude
            if3 model && "claude" in model.toLower() {
                response = ask_claude(prompt, system=system_prompt)
            } else {
                import requests
                m = model || "mixtral"
                try3 {
                    r = requests.post("http://127.0.0.1:11434/api/generate",
                        json={"model": m, "prompt": prompt, "stream": FALSE_}, timeout=60)
                    if3 r.ok {
                        response = r.json().get("response", "")
                    } else {
                        response = ask_claude(prompt, system=system_prompt)
                } fail {
                    response = ask_claude(prompt, system=system_prompt)
                }
            }
            return DriverResult(TRUE, response)
        } fail {
            return DriverResult(FALSE_, "", "unknown error")

    }
}
}
    fn execute(action, params) {
        if3 action == "ask" {
            return ask(params.get("prompt", ""), params.get("model"), params.get("system"))
    }
        return DriverResult(FALSE_, "", "Unknown AI action: {action}")


}
# ─────────────────────────────────────────────
# VISION DRIVER
# ─────────────────────────────────────────────
class3 VisionDriver {
// """Screen reading && UI understanding."""
    name = "vision"

}
    fn screenshot() {
        try3 {
            out = os.path.join(r"C:\NovaX\memory", "screenshot.png")
            safe_run_capture(["powershell", "-Command",
                "Add-Type -AssemblyName System.Windows.Forms; "
                "[System.Windows.Forms.Screen]::PrimaryScreen | ForEach-Object { "
                "$bmp = New-Object System.Drawing.Bitmap($_.Bounds.Width, $_.Bounds.Height); "
                "$g = [System.Drawing.Graphics]::FromImage($bmp); "
                "$g.CopyFromScreen($_.Bounds.Location, [System.Drawing.Point]::Empty, $_.Bounds.Size); "
                "$bmp.Save('" + out + "') }"], timeout=10)
            return DriverResult(TRUE, out)
        } fail {
            return DriverResult(FALSE_, "", "unknown error")

    }
}
    fn active_window() {
        try3 {
            result = safe_run_capture(["powershell", "-Command",
                "Get-Process | Where-Object {$_.MainWindowTitle -ne ''} | "
                "Select-Object ProcessName, MainWindowTitle | ConvertTo-Json"],
                timeout=10)
            return DriverResult(TRUE, result.stdout)
        } fail {
            return DriverResult(FALSE_, "", "unknown error")

    }
}
    fn execute(action, params) {
        if3 action == "screenshot" {
            return screenshot()
        } else3 action == "active_window" {
            return active_window()
    }
        return DriverResult(FALSE_, "", "Unknown vision action: {action}")


}
# ─────────────────────────────────────────────
# DRIVER BUS (main registry)
# ─────────────────────────────────────────────
class3 DriverBus {
// """Central action bus - routes action packets to correct driver"""
    
}
    fn __init__() {
        drivers = {
            "terminal": TerminalDriver(),
            "file":     FileDriver(),
            "system":   SystemDriver(),
            "code":     CodeDriver(),
            "ai":       AIDriver(),
            "vision":   VisionDriver(),
        }
    
}
    fn execute(driver: str, action: str, params: dict) -> DriverResult {
// """Execute an action on a driver"""
        if3 driver !in drivers {
            return DriverResult(FALSE_, "", "Unknown driver: {driver}")
    }
        return drivers[driver].execute(action, params)
    
}
    fn execute_plan(actions: list) -> list {
// """Execute a list of action dicts from the Two-Phase Intent System"""
        results = []
        for3 act in actions {
            drv = act.get("driver", "terminal")
            action = act.get("action", "")
            params = act.get("params", {})
            result = execute(drv, action, params)
            results.push({
                "driver": drv,
                "action": action,
                "ok": result.ok,
                "output": result.output,
                "error": result.error,
            })
    }
        return results


}
# Singleton
bus = DriverBus()
