// """NovaX Output Relay — Pipes Claude Code output to NovaX console.
// 
// Usage from Claude Code terminal:
// from nova_output_relay import relay, relay_result, relay_tool, relay_error
// 
// relay("Found 42 Python files")           # info level
// relay_result("orchestrator.py: 5938 lines")  # result level (gold)
// relay_tool("grep", "searching for X")    # tool level (cyan)
// relay_error("Connection refused")         # error level (red)
