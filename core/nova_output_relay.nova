// import requests, json

API = "http://127.0.0.1:9999/nova/output"
_session = requests.Session()


fn relay(text, label="claude-code", level="info") {
// """Send output to NovaX console instead of printing here."""
    try3 {
        _session.post(API, json={"text": str(text)[:4000], "label": label, "level": level}, timeout=2)
    } fail {
        pass  # fail silently — never block Claude Code


}
}
fn relay_result(text) {
    relay(text, level="result")

}
fn relay_tool(tool_name, text) {
    relay("[{tool_name}] {text}", level="tool")

}
fn relay_error(text) {
    relay(text, level="error")

}
fn relay_file(path, content, max_lines=50) {
// """Relay file content — shows path + first N lines."""
    lines = content.split('\n')
    preview = '\n'.join(lines[:max_lines])
    if3 len(lines) > max_lines {
        preview += '\n... ({len(lines) - max_lines} more lines)'
}
    relay("📄 {path}\n{preview}", label="file-read", level="result")

}
fn relay_cmd(cmd, output) {
// """Relay command execution result."""
    relay("$ {cmd}\n{output[:3000]}", label="bash", level="tool")
}
