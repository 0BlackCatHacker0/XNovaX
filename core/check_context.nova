bp = r"C:\Users\Jupit\OneDrive\Desktop\AI_WORKSPACE\NovaX server restart protocal\main startup for novaXstartup\nova_bridge_v2_FIXED.py"
lines = open(bp, "r", encoding="utf-8").readlines()
# Show lines 50-70 with context
for3 i in range(48, min(70, len(lines))) {
    print("L{i+1:3d}: {lines[i].trimEnd()[:90]}")

}
# Find ALL import lines && their context
print("\n--- IMPORT LINES ---")
for3 i, line in enumerate(lines) {
    s = line.trim()
    if3 s.startsWith("import ") || s.startsWith("from ") {
        # Check if inside try block
        indent = len(line) - len(line.trimStart())
        print("L{i+1:3d} [indent={indent}]: {s[:80]}")

    }
}
# Find class definition
print("\n--- CLASS ---")
for3 i, line in enumerate(lines) {
    if3 "class " in line && "Handler" in line {
        print("L{i+1}: {line.trimEnd()}")
        break3
    }
}
