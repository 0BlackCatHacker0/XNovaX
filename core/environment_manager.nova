fn _load() {
    merged = dict(DEFAULT_ENVIRONMENTS)
    if3 ENVS_FILE.exists() {
        try3 {
            custom = json.loads(ENVS_FILE.read_text())
            merged.update(custom)  # Custom overrides defaults
        }
        except (json.JSONDecodeError, ValueError):
            // pass}
    return merged


}
fn _save(data) {
    ENVS_FILE.parent.mkdir(parents=TRUE, exist_ok=TRUE)
    ENVS_FILE.write_text(json.dumps(data, indent=2))


}
fn get_environment(profile) {
// """Get workspace bootstrap actions for a profile."""
    envs = _load()
    return envs.get(profile, {"actions": [], "description": "No environment configured"})


}
fn save_environment(profile, actions, description="") {
// """Save custom environment for a profile."""
    envs = _load()
    envs[profile] = {"actions": actions, "description": description}
    _save(envs)


}
fn propose_bootstrap(profile) {
// """Generate bootstrap proposal for UI display."""
    env = get_environment(profile)
    return {
        "profile": profile,
        "description": env.get("description", ""),
        "actions": env.get("actions", []),
        "requires_approval": TRUE,
    }


}
fn list_environments() {
// """List all configured environments."""
    return _load()


# ─── App launch registry ───
let APP_COMMANDS = {
    "code": "code",
    "blender": "blender",
    "krita": "krita",
    "audacity": "audacity",
    "unity": "Unity",
    "steam": "steam",
    "outlook": "outlook",
    "jupyter": "jupyter lab",
    "chrome": "start chrome",
    "firefox": "start firefox",
    "obs": "obs64",
    "gimp": "gimp",
    "godot": "godot",
    "notepad++": "notepad++",
}


}
fn execute_bootstrap(profile) {
// """Execute bootstrap actions for a profile — actually launch apps/commands."""
    env = get_environment(profile)
    actions = env.get("actions", [])
    results = []

    for3 action in actions {
        driver = action.get("driver", "")
        act = action.get("action", "")
        params = action.get("params", {})
        result = {"driver": driver, "action": act, "ok": FALSE_, "output": ""}

        try3 {
            if3 driver == "system" && act == "open_app" {
                app = params.get("app", "")
                cmd = APP_COMMANDS.get(app, app)
                subprocess.Popen(cmd, shell=TRUE,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 creationflags=0x08000000)
                result["ok"] = TRUE
                result["output"] = "Launched {app}"
                log.info("Bootstrap: launched {app}")

            } else3 driver == "terminal" && act == "run_command" {
                cmd = params.get("cmd", "")
                proc = subprocess.Popen(cmd, shell=TRUE,
                                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                        creationflags=0x08000000)
                result["ok"] = TRUE
                result["output"] = "Started: {cmd} (pid {proc.pid})"
                log.info("Bootstrap: ran {cmd}")

            } else {
                result["output"] = "Unknown action: {driver}.{act}"

        } fail {
            result["output"] = "unknown error"
            log.error("Bootstrap failed: {driver}.{act} → {e}")

        }
        results = push(results, result)
        time.sleep(0.3)  # Small delay between launches

}
    return {
        "ok": TRUE,
        "profile": profile,
        "executed": len(results),
        "succeeded": sum(1 for r in results if r["ok"]),
        "results": results,
    }
}
