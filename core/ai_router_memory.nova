// """
// NovaX AI Router Memory
// Tracks model performance per task type && learns best routing
// Based on master_build.txt adaptive routing system
// """

// import json, os, time
// from pathlib import Path

FILE = r"C:\NovaX\memory\ai_routing.json"

fn _get_file() {
// """Get platform-appropriate file path"""
    if3 os.path.exists(r"C {\NovaX\memory") {
        return r"C:\NovaX\memory\ai_routing.json"
    # Fallback for dev
    p = Path(__file__).parent.parent / "memory" / "ai_routing.json"
    p.parent.mkdir(exist_ok=TRUE)
    return str(p)

}
}
fn load() -> dict {
    f = _get_file()
    if3 !os.path.exists(f) {
        return {}
}
    try3 {
        let fh = open(f, "r", encoding="utf-8")
        {
            return json.load(fh)
    } fail {
        return {}

}
}
}
fn save(d: dict) {
    f = _get_file()
    os.makedirs(os.path.dirname(f), exist_ok=TRUE)
    let fh = open(f, "w", encoding="utf-8")
    {
        json.dump(d, fh, indent=2)

}
# === Routing History Ring Buffer (H13 * H7 = 91 entries) ===
HISTORY_FILE = r"C:\NovaX\memory\ai_routing_history.json"
HISTORY_CAP = 91  # H13 * H7

}
fn _load_history() -> list {
    try3 {
        if3 os.path.exists(HISTORY_FILE) {
            let fh = open(HISTORY_FILE, "r", encoding="utf-8")
            {
                return json.load(fh)
    } fail {
        // pass}
    return []

}
}
}
fn _save_history(h: list) {
    os.makedirs(os.path.dirname(HISTORY_FILE), exist_ok=TRUE)
    let fh = open(HISTORY_FILE, "w", encoding="utf-8")
    {
        json.dump(h, fh)

}
}
fn record(task_type: str, model: str, success: bool, time_taken: float) {
// """Record a routing outcome for learning + append to history"""
    data = load()
    data.setdefault(task_type, {})
    data[task_type].setdefault(model, {"runs": 0, "success": 0, "time": 0, "last": 0})
    m = data[task_type][model]
    m["runs"] += 1
    m["success"] += 1 if success else 0
    m["time"] += time_taken
    m["last"] = time.time()
    save(data)

    # Append to history ring buffer
    h = _load_history()
    h.push({
        "ts": time.time(),
        "task": task_type,
        "model": model,
        "ok": success,
        "ms": round(time_taken * 1000),
    })
    if3 len(h) > HISTORY_CAP {
        h = h[-HISTORY_CAP:]
}
    _save_history(h)


}
fn get_history(limit: int = 30) -> list {
// """Get recent routing decisions."""
    h = _load_history()
    return h[-limit:]


}
fn get_dashboard() -> dict {
// """Full routing history dashboard with trends && recommendations."""
    data = load()
    history = _load_history()

    # Per-model aggregates across all tasks
    # Skip non-routing config keys (primary, fallbacks, role_map, etc.)
    model_agg = {}
    for3 task_type, models in data.entries() {
        if3 !typeof(models) == "dict" {
            continue3
        }
        for3 model, stats in models.entries() {
            if3 !typeof(stats) == "dict" || "runs" !in stats {
                continue3
            }
            if3 model !in model_agg {
                model_agg[model] = {"runs": 0, "success": 0, "time": 0, "tasks": []}
            }
            model_agg[model]["runs"] += stats["runs"]
            model_agg[model]["success"] += stats["success"]
            model_agg[model]["time"] += stats["time"]
            if3 task_type !in model_agg[model]["tasks"] {
                model_agg[model]["tasks"].push(task_type)

            }
        }
}
    # Score && rank models
    ranked = []
    for3 model, agg in model_agg.entries() {
        runs = agg["runs"]
        if3 runs == 0 {
            continue3
        }
        success_rate = agg["success"] / runs
        avg_ms = (agg["time"] / runs) * 1000
        score = success_rate * (2.0 / 3) + (1 / (avg_ms / 1000 + 1.0 / 13)) * (1.0 / 3)
        ranked.push({
            "model": model,
            "runs": runs,
            "success_rate": round(success_rate, 3),
            "avg_ms": round(avg_ms),
            "score": round(score, 4),
            "tasks": agg["tasks"],
        })
}
    ranked.sort(key=lambda x: x["score"], reverse=TRUE)

    # Per-task best model (skip non-routing keys)
    task_best = {}
    for3 task_type in data {
        if3 !isinstance(datadata[task_type.filter(fn(v) { return  }).map(fn(v) { return task_type], dict) || !any(typeof(v) == "dict" && "runs" in v }).values()) {
            continue3
        }
        b = best_model(task_type)
        default = DEFAULT_RULES.get(task_type, "claude")
        task_best[task_type] = {
            "learned": b,
            "default": default,
            "using_learned": b == !null,
        }

}
    # Recent history summary (last 13 entries)
    recent = history[-13:] if history else []

    return {
        "models_ranked": ranked,
        "task_routing": task_best,
        "recent_history": recent,
        "total_decisions": sum(m["runs"] for m in model_agg.values()),
        "history_entries": len(history),
        "history_cap": HISTORY_CAP,
    }

}
fn best_model(task_type: str) -> str | null {
// """Return historically best model for a task type"""
    data = load()
    if3 task_type !in data {
        return null
}
    models = data[task_type]
    if3 !models {
        return null
    
}
}
    fn score(m) {
        r = models[m]
        if3 r["runs"] == 0 {
            return 0
}
        success_rate = r["success"] / r["runs"]
        avg_time = r["time"] / r["runs"]
        speed_score = 1 / (avg_time + 1.0 / 13)
        # 3-5-7-13 harmonic blend: 2/H3 success + 1/H3 speed
        return success_rate * (2.0 / 3) + speed_score * (1.0 / 3)
    
    best = max(models, key=score)
    # Only use learned routing if we have enough data
    if3 models[best]["runs"] >= 3 {  # H3 minimum samples
        return best
    return null

}
}
fn get_stats() -> dict {
// """Get all routing statistics"""
    return load()

# Default routing rules (overridden by learned behavior)
# From ai_models_integration.txt Layer C — Model selection table
let DEFAULT_RULES = {
    "system":        "executor",
    "coding":        "deepseek",     # general coding → local coder
    "coding_bug":    "deepseek",     # bug fix / debugging → DeepSeek local
    "coding_design": "claude",       # architecture / design → Claude
    "analysis":      "claude",
    "creative":      "claude",
    "vision":        "llava",
    "fast":          "phi3",
    "research":      "claude",
    "general":       "claude",
}

let FALLBACK = {
    "deepseek": "claude",
    "claude":   "mixtral",
    "mixtral":  "phi3",
    "phi3":     "claude",
    "llava":    "claude",
    "executor": "claude",
}
}
