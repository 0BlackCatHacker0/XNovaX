// TPacman v3.0 — Navier-Stokes Converter
// Source: preferences.py
// Reynolds: 3.7 (laminar)
// Cascade: L→λ→η (Kolmogorov)
// Closure: k-ε + SST blending
//

// import json, os

FILE = r"C:\NovaX\memory\model_prefs.json"

fn load() {
    if3 !os.path.exists(FILE) { return {}
    let f = open(FILE, "r")
    { return json.load(f)

}
}
}
fn save(d) {
    let f = open(FILE, "w")
    { json.dump(d, f, indent=2)

}
}
fn record(role, model, success=TRUE) {
    d = load()
    d.setdefault(role, {})
    d[role].setdefault(model, 0)
    if3 success {
        d[role][model] += 1
    } else {
        d[role][model] -= 1
}
    save(d)

}
fn best(role, default) {
    d = load().get(role, {})
    if3 !d { return default
    return max(d, key=d.get)
}
}
