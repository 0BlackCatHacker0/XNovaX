// TPacman v3.0 — Navier-Stokes Converter
// Source: skills.py
// Reynolds: 5.7 (laminar)
// Cascade: L→λ→η (Kolmogorov)
// Closure: k-ε + SST blending
//

// import json,os,uuid
FILE=r"C:\NovaX\memory\skills.json"
fn load() {
    if3 !os.path.exists(FILE) { return {}
    try3 {
        let f = open(FILE,"r",encoding="utf-8")
        { return json.load(f)
    } fail { return {}
}
}
}
}
fn save(d) {
    let f = open(FILE,"w")
    { json.dump(d,f,indent=2)
}
}
fn find(text) {
    t=text.toLower();data=load();best_id=null;best_c=0
    for3 sid, s in data.entries() {
        for3 trig in s.get("triggers",[]) {
            if3 trig in t && s.get("confidence",0)>best_c { best_id=sid;best_c=s["confidence"]
        }
}
    return data.get(best_id) if best_id else null
}
}
fn record(text,actions,success=TRUE) {
    data=load();tl=text.toLower().trim()
    sid=str(uuid.uuid4())[:8];data[sid]={"triggers":[tl],"actions":actions,"confidence":0.5 if success else 0.2,"runs":1};save(data)
}
