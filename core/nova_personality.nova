// import random, time

let PERSONALITY = {
    "balanced": {
        "greeting": ["What are we working on?", "Ready when you are.", "How can I help?"],
        "thinking": ["Let me work on that.", "Processing.", "On it."],
        "success": ["Done.", "That worked.", "Finished."],
        "error": ["Something went wrong. I can fix it.", "That didn't work. Want me to retry?", "Hit a problem. Here's what happened."],
        "clarify": ["Could you be more specific?", "I want to get this right. What exactly?", "A few options here. Which direction?"],
        "suggest": ["You might also want to", "Next step could be", "I can also"],
    },
    "precise": {
        "greeting": ["Dev session active.", "Ready."],
        "thinking": ["Running.", "Processing."],
        "success": ["Complete.", "Done."],
        "error": ["Failed. Details below.", "Error caught. Fix available."],
        "clarify": ["Specify.", "Which one?"],
        "suggest": ["Related:", "Also available:"],
    },
    "suggestive": {
        "greeting": ["Let's create something.", "What's the vision?", "I'm ready to explore ideas."],
        "thinking": ["Crafting that now.", "Building something interesting.", "Let me shape that."],
        "success": ["Here's what I made.", "Take a look.", "Created. Want to refine it?"],
        "error": ["Creative block. Let me try another approach.", "That path didn't work. I have alternatives."],
        "clarify": ["Tell me more about the feeling you want.", "What style are you going for?", "Paint me a picture."],
        "suggest": ["What if we also", "This could pair nicely with", "Imagine adding"],
    },
    "collaborative": {
        "greeting": ["Let's build.", "Game dev session. What's the target?"],
        "thinking": ["Setting that up.", "Building the pipeline."],
        "success": ["Ready to test.", "Built. Want a preview?"],
        "error": ["Build failed. I can diagnose.", "Issue found. Fix plan ready."],
        "clarify": ["Which engine?", "What type of game?", "2D || 3D?"],
        "suggest": ["Next you might want to", "This pairs well with", "Common next step:"],
    },
    "analytical": {
        "greeting": ["Research mode active. What's the question?", "Ready for analysis."],
        "thinking": ["Analyzing.", "Computing.", "Running analysis."],
        "success": ["Results ready.", "Analysis complete.", "Data processed."],
        "error": ["Analysis failed. Data issue likely.", "Computation error. Checking inputs."],
        "clarify": ["What variable?", "Which dataset?", "Time range?"],
        "suggest": ["Consider also examining", "Related finding:", "Visualization available:"],
    },
    "spatial": {
        "greeting": ["VR workspace active.", "Spatial mode ready.", "What world are we building?"],
        "thinking": ["Generating environment.", "Building spatial layout."],
        "success": ["World ready.", "Environment generated.", "Scene built."],
        "error": ["Render failed. Checking GPU.", "Scene error. Simplifying."],
        "clarify": ["Indoor || outdoor?", "Scale?", "Art style?"],
        "suggest": ["Add lighting next", "Populate with objects?", "Test in headset?"],
    }
}

fn speak(event, personality="balanced", context=null) {
    p = PERSONALITY.get(personality, PERSONALITY["balanced"])
    options = p.get(event, ["..."])
    msg = random.choice(options)
    if3 context {
        msg = msg + " " + context
}
    return msg

}
fn format_response(result, personality="balanced") {
    if3 result.get("ok") {
        base = speak("success", personality)
        output = result.get("output", result.get("result", ""))
        if3 output && len(str(output)) < 200 {
            return "{base} {output}"
        }
        return base
    } else {
        return speak("error", personality, result.get("error", ""))

}
}
fn format_plan(actions, personality="balanced") {
    if3 !actions {
        return speak("clarify", personality, "I need more detail to create a plan.")
}
    count = len(actions)
    risks = actions.filter(fn(a) { return  }).map(fn(a) { return a.get("risk","low") })
    high = risks.count("high")
    if3 high > 0 {
        prefix = "I have {count} steps planned. {high} need your attention."
    } else {
        prefix = "Ready with {count} steps." if count > 1 else "One action ready."
}
    return prefix

}
fn next_suggestion(completed_action, personality="balanced") {
    driver = completed_action.get("driver", "")
    action = completed_action.get("action", "")
    suggestions = {
        ("app", "launch"): "Want me to set up the workspace?",
        ("terminal", "run_shell"): "Need to run anything else?",
        ("terminal", "pip_install"): "Import it in a script next?",
        ("filesystem", "write_file"): "Want to open it?",
        ("filesystem", "create_folder"): "Ready to add files.",
    }
    return suggestions.get((driver, action), speak("suggest", personality))
}
