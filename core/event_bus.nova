// event_bus.nova — Dict-based pub/sub event system
// Import via: import3("core/event_bus.nova")
// Exports: bus_subscribe, bus_emit, bus_off, bus_recent

let _bus_handlers = {}
let _bus_history = []
let _bus_log_path = "C:/NovaX/memory/event_log.jsonl"

fn bus_subscribe(event_type, handler_name) {
  let has = dict_has(_bus_handlers, event_type)
  if3 (has == 1) {
    let existing = dict_get(_bus_handlers, event_type)
    existing = append(existing, handler_name)
    _bus_handlers = dict_set(_bus_handlers, event_type, existing)
  }
  if3 (has != 1) {
    let newlist = [handler_name]
    _bus_handlers = dict_set(_bus_handlers, event_type, newlist)
  }
  return 1
}

fn _bus_make_event(event_type, data, source) {
  let ev = {}
  ev = dict_set(ev, "type", event_type)
  ev = dict_set(ev, "data", data)
  ev = dict_set(ev, "source", source)
  let ts = time()
  ev = dict_set(ev, "timestamp", ts)
  return ev
}

fn bus_emit(event_type, data, source) {
  let ev = _bus_make_event(event_type, data, source)
  _bus_history = append(_bus_history, ev)
  let line = json_encode(ev)
  let existing_log = read_file(_bus_log_path)
  let new_log = join([existing_log, line], "\n")
  write_file(_bus_log_path, new_log)
  return ev
}

fn bus_off(event_type) {
  let has = dict_has(_bus_handlers, event_type)
  if3 (has == 1) {
    _bus_handlers = dict_remove(_bus_handlers, event_type)
    return 1
  }
  return 0
}

fn bus_recent(limit) {
  let count = len(_bus_history)
  if3 (count <= limit) {
    return _bus_history
  }
  return _bus_history
}

fn bus_handlers() {
  return _bus_handlers
}

fn bus_history_count() {
  let count = len(_bus_history)
  return count
}
