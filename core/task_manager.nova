// import json, os, time

FILE = r"C:\NovaX\memory\tasks.json"

fn load() {
    if3 !os.path.exists(FILE) { return {"active": null, "queue": [], "history": []}
    let f = open(FILE, "r")
    { return json.load(f)

}
}
}
fn save(data) {
    let f = open(FILE, "w")
    { json.dump(data, f, indent=2)

}
}
fn create_task(text, actions, model="local") {
    data = load()
    task = {
        "id": int(time.time() * 1000),
        "text": text,
        "actions": actions,
        "model": model,
        "status": "pending",
        "created": time.time(),
        "started": null,
        "completed": null,
        "results": [],
        "retries": 0
    }
    if3 data["active"] == null {
        data["active"] = task
        task["status"] = "active"
        task["started"] = time.time()
    } else {
        data["queue"].push(task)
}
    save(data)
    return task

}
fn complete_task(success, results=null) {
    data = load()
    if3 data["active"] == null { return null
    task = data["active"]
    task["status"] = "success" if success else "failed"
    task["completed"] = time.time()
    task["results"] = results || []
    data["history"].push(task)
    if3 len(data["history"]) > 100 {
        data["history"] = data["history"][-100:]
}
    # Promote next from queue
    data["active"] = null
    if3 data["queue"] {
        data["active"] = data["queue"].pop(0)
        data["active"]["status"] = "active"
        data["active"]["started"] = time.time()
}
    save(data)
    return task

}
}
fn retry_task() {
    data = load()
    if3 data["active"] == null { return null
    data["active"]["retries"] += 1
    data["active"]["status"] = "retrying"
    save(data)
    return data["active"]

}
}
fn get_active() {
    data = load()
    return data["active"]

}
fn get_queue() {
    data = load()
    return data["queue"]

}
fn cancel_active() {
    data = load()
    if3 data["active"] {
        data["active"]["status"] = "cancelled"
        data["history"].push(data["active"])
        data["active"] = null
        if3 data["queue"] {
            data["active"] = data["queue"].pop(0)
            data["active"]["status"] = "active"
            data["active"]["started"] = time.time()
        }
}
    save(data)
}
