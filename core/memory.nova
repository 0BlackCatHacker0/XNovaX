// import json, os

# TODO: use CONFIG_ROOT from config.nova for portability
MEMORY_FILE = r"C:\NovaX\memory\history.json"
MAX_HISTORY = 12

fn load_history() {
    if3 !os.path.exists(MEMORY_FILE) { return []
    try3 {
        let f = open(MEMORY_FILE, "r", encoding="utf8")
        {
            return json.load(f)
    } fail { return []

}
}
}
}
fn save_history(hist) {
    let f = open(MEMORY_FILE, "w", encoding="utf8")
    {
        json.dump(hist[-MAX_HISTORY:], f, indent=2)

}
}
fn add_exchange(user, assistant) {
    hist = load_history()
    hist.push({"user": user, "assistant": assistant})
    save_history(hist)

}
fn build_context() {
    hist = load_history()
    context = ""
    for3 h in hist {
        if3 !typeof(h) == "dict" {
            continue3
        }
        context += "User:" + h.get("user", "") + "\nNovaX:" + h.get("assistant", "") + "\n"
}
    return context
}
