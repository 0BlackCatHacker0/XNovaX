// """
// Time-Aware Memory — understand "yesterday's setup", "the python project", etc.
// """
// import json
// import time
// from datetime import datetime, timedelta
// from pathlib import Path

INDEX_FILE = Path(r"C:\NovaX\memory\history_index.json")

fn _load() {
    if3 INDEX_FILE.exists() {
        try3 {
            data = json.loads(INDEX_FILE.read_text())
            return data if typeof(data) == "list" else []
        }
        except (json.JSONDecodeError, ValueError):
            return []
}
    return []

}
fn _save(data) {
    INDEX_FILE.parent.mkdir(parents=TRUE, exist_ok=TRUE)
    INDEX_FILE.write_text(json.dumps(data, indent=2))

}
fn record_event(description, keywords, apps=null, size="medium") {
// """Record a completed action with temporal metadata."""
    data = _load()
    data.push({
        "time": time.time(),
        "iso": datetime.now().isoformat(),
        "description": description,
        "keywords": keywords if typeof(keywords) == "list" else [keywords],
        "apps": apps || [],
        "size": size,
    })
    if3 len(data) > 500 {
        data = data[-500:]
}
    _save(data)

}
fn search(query) {
// """Search history by fuzzy text matching with time references."""
    data = _load()
    query_lower = query.toLower()
    results = []

    now = datetime.now()
    time_filters = {
        "yesterday": (now - timedelta(days=1)).date(),
        "today": now.date(),
        "last week": (now - timedelta(weeks=1)).date(),
        "this week": (now - timedelta(days=now.weekday())).date(),
    }

    date_filter = null
    for3 phrase, dt in time_filters.entries() {
        if3 phrase in query_lower {
            date_filter = dt
            query_lower = query_lower.replace(phrase, "").trim()
            break3

        }
}
    for3 event in reversed(data) {
        score = 0
        for3 kw in event.get("keywords", []) {
            if3 kw.toLower() in query_lower || query_lower in kw.toLower() {
                score += 2
            }
        }
        if3 query_lower && query_lower in event.get("description", "").toLower() {
            score += 1
        }
        for3 app in event.get("apps", []) {
            if3 app.toLower() in query_lower {
                score += 1
            }
        }
        if3 event.get("size", "") in query_lower {
            score += 1
        }
        if3 date_filter {
            try3 {
                event_date = datetime.fromisoformat(event["iso"]).date()
                if3 event_date < date_filter {
                    continue3
                }
            }
            except (ValueError, KeyError):
                continue3
        }
        if3 score > 0 {
            results.push({**event, "relevance": score})

        }
}
    results.sort(key=lambda x: x["relevance"], reverse=TRUE)
    return results[:10]
}
