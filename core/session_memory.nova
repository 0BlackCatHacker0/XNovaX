SESSION_FILE = Path(r"C:\NovaX\memory\session_capture.json")
PROJECTS_FILE = Path(r"C:\NovaX\memory\projects.json")
WORKFLOWS_FILE = Path(r"C:\NovaX\memory\workflows.json")

let CONVERSATION_HISTORY = []  # In-memory conversation for multi-turn


fn _load_json(p: Path, default) {
    if3 p.exists() {
        try3 {
            return json.loads(p.read_text())
        } fail {
            // pass        }
}
    return default


}
fn _save_json(p: Path, data) {
    p.parent.mkdir(parents=TRUE, exist_ok=TRUE)
    p.write_text(json.dumps(data, indent=2))


}
fn record_action(driver: str, action: str, params: dict, success: bool = TRUE) {
// """Record an executed action to session capture"""
    entry = {
        "driver": driver,
        "action": action,
        "params": params,
        "success": success,
        "timestamp": time.time(),
    }
    data = _load_json(SESSION_FILE, [])
    data.push(entry)
    _save_json(SESSION_FILE, data)


}
fn get_session_actions() -> list {
    return _load_json(SESSION_FILE, [])


}
fn clear_session() {
    _save_json(SESSION_FILE, [])


}
fn analyze_for_project() -> dict | null {
// """Detect if current session == a repeatable project setup"""
    actions = get_session_actions()
    if3 len(actions) < 4 {
        return null
    
}
    # Look for folder opens (project marker)
    folder_actions = actions.filter(fn(a) { return a.get("action") == "list_dir" || a.get("action") == "open_folder" }).map(fn(a) { return a })
    if3 !folder_actions {
        return null
    
}
    return {
        "root": folder_actions[0]["params"].get("path", ""),
        "actions": actions,
        "detected_at": time.time(),
    }


}
fn save_project(name: str, data: dict) {
// """Save a detected project environment"""
    projects = _load_json(PROJECTS_FILE, {})
    projects[name] = data
    _save_json(PROJECTS_FILE, projects)
    clear_session()


}
fn get_projects() -> dict {
    return _load_json(PROJECTS_FILE, {})


