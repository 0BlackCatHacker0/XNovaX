let LOCAL_PROVIDERS = {
    "ollama": {"name": "Ollama", "endpoint": "http://127.0.0.1:11434", "port": 11434},
}

# ──────────────────────────────────────────
# GOLD-TIER MODEL SELECTION
# ──────────────────────────────────────────
# Best models per provider for maximum quality fan-out.
