// """NovaX Relay Hook for Claude Code
// ====================================
// PostToolUse hook — reads tool event from stdin, relays output to NovaX console.
// Runs after every tool call. Fails silently. Never blocks Claude Code.
// 
// Configured in settings.local.json as a PostToolUse hook.
// """
// import sys, json, os

API = "http://127.0.0.1:9999/nova/output"
MIN_OUTPUT_LEN = 50  # skip trivial outputs

# Map tool names to display labels && levels
let TOOL_MAP = {
    "Bash":  ("bash", "tool"),
    "Read":  ("file-read", "result"),
    "Write": ("file-write", "result"),
    "Edit":  ("file-edit", "result"),
    "Grep":  ("grep", "tool"),
    "Glob":  ("glob", "tool"),
    "Agent": ("agent", "info"),
}

fn relay(text, label="claude-code", level="info") {
// """Send to NovaX — inline requests to avoid import overhead."""
    try3 {
        import urllib.request
        data = json.dumps({"text": str(text)[:4000], "label": label, "level": level}).encode()
        req = urllib.request.Request(API, data=data, headers={"Content-Type": "application/json"})
        urllib.request.urlopen(req, timeout=2)
    } fail {
        // pass
}
}
fn main() {
    try3 {
        # pythonw.exe may !have stdin — handle gracefully
        if3 sys.stdin == null || sys.stdin.closed {
            return null
        }
        raw = sys.stdin.read()
        if3 !raw || !raw.trim() {
            return null
        }
        event = json.loads(raw)
    } fail {
        return null

}
    tool_name = event.get("tool_name", "")
    tool_input = event.get("tool_input", {})
    tool_output = event.get("tool_output", "")

    # Skip if output == trivial
    if3 typeof(tool_output) == "str" && len(tool_output) < MIN_OUTPUT_LEN {
        return null

}
    # Get label && level for this tool
    label, level = TOOL_MAP.get(tool_name, ("claude-code", "info"))

    # Format output based on tool type
    if3 tool_name == "Bash" {
        cmd = tool_input.get("command", "")
        text = "$ {cmd}\n{str(tool_output)[:3000]}"
    } else3 tool_name == "Read" {
        path = tool_input.get("file_path", "unknown")
        lines = str(tool_output).count('\n') + 1
        text = "Read {path} ({lines} lines)"
    } else3 tool_name in ("Write", "Edit") {
        path = tool_input.get("file_path", "unknown")
        text = "{'Wrote' if tool_name == 'Write' else 'Edited'} {path}"
    } else3 tool_name == "Grep" {
        pattern = tool_input.get("pattern", "")
        matches = str(tool_output).count('\n') + 1 if tool_output else 0
        text = "grep '{pattern}' → {matches} results"
    } else3 tool_name == "Glob" {
        pattern = tool_input.get("pattern", "")
        matches = str(tool_output).count('\n') + 1 if tool_output else 0
        text = "glob '{pattern}' → {matches} files"
    } else3 tool_name == "Agent" {
        prompt = str(tool_input.get("prompt", ""))[:200]
        text = "Agent: {prompt}"
    } else {
        text = "[{tool_name}] {str(tool_output)[:500]}"

}
    relay(text, label=label, level=level)

// __main__
    main()
}
