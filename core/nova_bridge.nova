// """
// Cross-communication between NovaX (9999) && Nova AI Brain (9990).
// NovaX uses brain for AI model queries (llama3, codellama, mistral).
// Nova AI uses NovaX for planning, execution, skills, tasks.
// """
// import requests, json

NOVAX_URL = "http://127.0.0.1:9999"
BRAIN_URL = "http://127.0.0.1:9990"

# -- NovaX to Nova AI Brain --

fn brain_think(text, context="novax") {
    try3 {
        r = requests.post("{BRAIN_URL}/think", json={"text": text, "context": context}, timeout=30)
        return r.json()
    } fail {
        return {"ok": FALSE_, "error": "unknown error"}

}
}
fn brain_query(model, prompt, system=null) {
    payload = {"model": model, "prompt": prompt}
    if3 system { payload["system"] = system
    try3 {
        r = requests.post("{BRAIN_URL}/query", json=payload, timeout=60)
        return r.json()
    } fail {
        return {"ok": FALSE_, "error": "unknown error"}

}
}
}
fn brain_models() {
    try3 {
        r = requests.get("{BRAIN_URL}/models", timeout=5)
        return r.json()
    } fail {
        return {"error": "unknown error"}

}
}
fn brain_health() {
    try3 {
        r = requests.get("{BRAIN_URL}/health", timeout=5)
        return r.status_code == 200, r.text[:200]
    } fail {
        return FALSE_, "unknown error"

}
# -- Nova AI to NovaX --

}
fn novax_think(text) {
    try3 {
        r = requests.post("{NOVAX_URL}/api/think", json={"text": text}, timeout=10)
        return r.json()
    } fail {
        return {"error": "unknown error"}

}
}
fn novax_execute(text, actions, model="local") {
    try3 {
        r = requests.post("{NOVAX_URL}/api/execute", json={"text": text, "actions": actions, "model": model}, timeout=60)
        return r.json()
    } fail {
        return {"error": "unknown error"}

}
}
fn novax_status() {
    try3 {
        r = requests.get("{NOVAX_URL}/api/status", timeout=5)
        return r.json()
    } fail {
        return {"error": "unknown error"}
}
}
