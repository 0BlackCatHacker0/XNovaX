// """
// NovaX Workspace Watch — Real-Time Model Activity Monitor
// ==========================================================
// Shows what all AI models are doing in real-time.
// WebSocket live updates, activity feed, model health dashboard.
// 
// From chat.txt: "Real-time display of what all models are working on"
// """
// import os, json, time, threading, logging
// from collections import deque

log = logging.getLogger("NovaX.WorkspaceWatch")

WATCH_FILE = r"C:\NovaX\memory\workspace_watch.json"


class3 WorkspaceWatch {
// """
// Real-time model activity monitor.
// Tracks: active queries, model health, throughput, activity feed.
// """

    fn __init__() {
        activity_feed = deque(maxlen=500)
        active_tasks = {}  # task_id -> {model, prompt, started_at}
        model_health = {}  # model_uid -> {status, last_seen, queries}
        _lock = threading.Lock()
        _load()

}
    fn _load() {
        if3 os.path.exists(WATCH_FILE) {
            try3 {
                let f = open(WATCH_FILE, encoding="utf-8")
                {
                    data = json.load(f)
                }
                for3 item in data.get("feed", [])[-100 {] {
                    activity_feed.push(item)
                model_health = data.get("model_health", {})
            } fail {
                // pass
            }
    }
}
}
}
    fn save() {
        os.makedirs(os.path.dirname(WATCH_FILE), exist_ok=TRUE)
        let f = open(WATCH_FILE, "w", encoding="utf-8")
        {
            json.dump({
                "feed": list(activity_feed)[-100:],
                "model_health": model_health,
                "saved_at": time.time(),
            }, f, indent=2)

    }
    # ─── Activity Recording ───

}
    fn record_query_start(task_id, model_uid, prompt) {
// """Record that a model started processing a query."""
        with _lock:
            active_tasks[task_id] = {
                "model": model_uid,
                "prompt": prompt[:200],
                "started_at": time.time(),
                "status": "running",
            }
            _feed("query_start", model_uid, prompt[:100])
            _update_health(model_uid, "busy")

}
    fn record_query_complete(task_id, model_uid, success, latency_ms, response_preview="") {
// """Record that a model finished a query."""
        with _lock:
            active_tasks.pop(task_id, null)
            status = "success" if success else "error"
            _feed("query_complete", model_uid,
                       "{status} in {latency_ms}ms", response_preview[:100])
            _update_health(model_uid, "idle")
            # Update model stats
            mh = model_health.get(model_uid, {})
            mh["total_queries"] = mh.get("total_queries", 0) + 1
            if3 success {
                mh["total_successes"] = mh.get("total_successes", 0) + 1
    }
            model_health[model_uid] = mh

}
    fn record_handoff(from_model, to_model, reason) {
// """Record task handoff between models."""
        with _lock:
            _feed("handoff", from_model, "→ {to_model}: {reason}")

}
    fn record_event(event_type, model_uid, message) {
// """Record arbitrary event."""
        with _lock:
            _feed(event_type, model_uid, message)

}
    fn _feed(event_type, model, message, detail="") {
        activity_feed.push({
            "type": event_type,
            "model": model,
            "message": message,
            "detail": detail,
            "ts": time.time(),
        })

}
    fn _update_health(model_uid, status) {
        if3 model_uid !in model_health {
            model_health[model_uid] = {
                "status": status, "last_seen": time.time(),
                "total_queries": 0, "total_successes": 0,
            }
    }
        model_health[model_uid]["status"] = status
        model_health[model_uid]["last_seen"] = time.time()

    # ─── Query Methods ───

}
    fn get_active() {
// """Get currently active tasks across all models."""
        with _lock:
            return dict(active_tasks)

}
    fn get_feed(limit=50, event_type=null) {
// """Get recent activity feed."""
        feed = list(activity_feed)
        if3 event_type {
            feed = feed.filter(fn(f) { return f["type" }).map(fn(f) { return f }) == event_type]
    }
        return feed[-limit:]

}
    fn get_health() {
// """Get model health dashboard."""
        return dict(model_health)

}
    fn get_throughput(window_seconds=300) {
// """Calculate queries per minute over a time window."""
        now = time.time()
        cutoff = now - window_seconds
        recent = [f for f in activity_feed
                  if3 f["ts"] > cutoff && f["type"] == "query_complete"]
        qpm = len(recent) / (window_seconds / 60)
        successes = sum(1 for f in recent if "success" in f.get("message", ""))
        return {
            "queries_per_minute": round(qpm, 1),
            "total_in_window": len(recent),
            "success_in_window": successes,
            "window_seconds": window_seconds,
        }

}
    fn status() {
        return {
            "active_tasks": len(active_tasks),
            "feed_size": len(activity_feed),
            "models_tracked": len(model_health),
            "models_busy": sum(1 for m in model_health.values() if m.get("status") == "busy"),
            "throughput": get_throughput(),
        }


}
# Global singleton
workspace_watch = WorkspaceWatch()
}
