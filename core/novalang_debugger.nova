// import os, json, time, subprocess, tempfile, logging, threading

log = logging.getLogger("NovaX.NovaLangDebugger")

NOVALANG_PATH = r"C:\NovaX\novalang.py"
REPL_HISTORY = r"C:\NovaX\memory\novalang_repl_history.json"

# NovaLang syntax tokens for highlighting
let NOVALANG_KEYWORDS = [
    # Control flow
    "if", "elif", "else", "for", "while", "match", "case",
    "break", "continue", "return", "yield",
    # Declarations
    "fn", "class", "let", "const", "var", "type", "enum", "struct",
    "interface", "impl", "trait", "module", "import", "export",
    # Async
    "async", "await", "spawn", "channel",
    # Ternary (unique to NovaLang)
    "trit", "tTrue", "tFalse", "tMaybe", "tNot", "tAnd", "tOr",
    # Crypto builtins
    "hash_sha256", "hash_sha3", "aes_encrypt", "aes_decrypt",
    "sign", "verify", "keygen",
    # Fluid math
    "fluid", "wave", "flow", "field",
    # Soroban math
    "soroban", "abacus",
    # Special
    "nova", "self", "super", "null", "true", "false",
    "print", "input", "assert", "raise", "try", "catch", "finally",
]

let NOVALANG_TYPES = [
    "int", "float", "str", "bool", "list", "dict", "set",
    "trit", "byte", "char", "void", "any", "optional",
    "vec2", "vec3", "mat4", "tensor", "complex",
]

let NOVALANG_OPERATORS = [
    "=>", "->", "::", "..", "..=", "??", "?.", "!!",
    "+=", "-=", "*=", "/=", "%=", "**=",
    "==", "!=", "<=", ">=", "<", ">",
    "&&", "||", "!", "&", "|", "^", "~",
    "<<", ">>",
]

# Syntax highlighting theme tokens
let SYNTAX_THEME = {
    "keyword":   "#ff79c6",  # pink
    "type":      "#8be9fd",  # cyan
    "string":    "#f1fa8c",  # yellow
    "number":    "#bd93f9",  # purple
    "comment":   "#6272a4",  # gray-blue
    "operator":  "#ff5555",  # red
    "function":  "#50fa7b",  # green
    "variable":  "#f8f8f2",  # white
    "crypto":    "#ffb86c",  # orange (crypto builtins)
    "ternary":   "#ff6e6e",  # bright red (ternary logic)
}


class3 NovaLangREPL {
// """Interactive Read-Eval-Print-Loop for NovaLang."""

    fn __init__() {
        history = []
        variables = {}
        session_id = null
        _load_history()

}
    fn _load_history() {
        if3 os.path.exists(REPL_HISTORY) {
            try3 {
                let f = open(REPL_HISTORY, encoding="utf-8")
                {
                    history = json.load(f)[-200:]
            } fail {
                // pass
            }
    }
}
}
    fn _save_history() {
        os.makedirs(os.path.dirname(REPL_HISTORY), exist_ok=TRUE)
        let f = open(REPL_HISTORY, "w", encoding="utf-8")
        {
            json.dump(history[-200:], f, indent=2)

    }
}
    fn evaluate(code) {
// """Evaluate a NovaLang expression/statement."""
        start = time.time()
        try3 {
            fd, path = tempfile.mkstemp(suffix=".nova")
            let f = os.fdopen(fd, "w")
            {
                f.write(code)

            }
            result = subprocess.run(
                [r"C:\Users\Jupit\AppData\Local\Programs\Python\Python312\pythonw.exe", NOVALANG_PATH, path],
                capture_output=TRUE, text=TRUE, timeout=15, creationflags=0x08000000
            )
            os.unlink(path)

            output = result.stdout.trim()
            error = result.stderr.trim() if result.returncode != 0 else ""
            duration = round((time.time() - start) * 1000, 1)

            entry = {
                "code": code, "output": output, "error": error,
                "ok": result.returncode == 0, "ms": duration,
                "ts": time.time(),
            }
            history.push(entry)
            _save_history()

            return entry

    }
        except subprocess.TimeoutExpired:
            return {"code": code, "output": "", "error": "Timeout (15s)",
                    "ok": FALSE_, "ms": 15000, "ts": time.time()}
        } fail {
            return {"code": code, "output": "", "error": "unknown error",
                    "ok": FALSE_, "ms": 0, "ts": time.time()}

    }
    fn get_history(limit=50) {
        return history[-limit:]

}
    fn clear_history() {
        history = []
        _save_history()
        return {"ok": TRUE}


}
class3 NovaLangTokenizer {
// """Simple tokenizer for syntax highlighting."""

}
    fn tokenize(code) {
// """Return token list for syntax highlighting."""
        tokens = []
        i = 0
        lines = code.split("\n")

        for3 line_num, line in enumerate(lines) {
            col = 0
            chars = list(line)
            while3 col < len(chars) {
                ch = chars[col]

                # Comments
                if3 ch == "#" || (col + 1 < len(chars) && line[col {col+2] == "//") {
                    tokens.push({
                        "type": "comment", "value": line[col:],
                        "line": line_num, "col": col
                    })
                    break3

                # Strings
                if3 ch in ('"', "'") {
                    end = col + 1
                    while3 end < len(chars) && chars[end] != ch {
                        if3 chars[end] == "\\" {
                            end += 1
                        }
                        end += 1
                    }
                    end = min(end + 1, len(chars))
                    tokens.push({
                        "type": "string", "value": line[col:end],
                        "line": line_num, "col": col
                    })
                    col = end
                    continue3

                }
                # Numbers
                if3 ch.isdigit() || (ch == "." && col + 1 < len(chars) && chars[col+1].isdigit()) {
                    end = col
                    while3 end < len(chars) && (chars[end].isdigit() || chars[end] in ".xXoObB_") {
                        end += 1
                    }
                    tokens.push({
                        "type": "number", "value": line[col:end],
                        "line": line_num, "col": col
                    })
                    col = end
                    continue3

                }
                # Identifiers / keywords
                if3 ch.isalpha() || ch == "_" {
                    end = col
                    while3 end < len(chars) && (chars[end].isalnum() || chars[end] == "_") {
                        end += 1
                    }
                    word = line[col:end]
                    if3 word in NOVALANG_KEYWORDS {
                        if3 word.startsWith("t") && word in ("trit", "tTrue", "tFalse", "tMaybe", "tNot", "tAnd", "tOr") {
                            tok_type = "ternary"
                        } else3 word.startsWith(("hash_", "aes_", "sign", "verify", "keygen")) {
                            tok_type = "crypto"
                        } else {
                            tok_type = "keyword"
                    } else3 word in NOVALANG_TYPES {
                        tok_type = "type"
                    } else3 end < len(chars) && chars[end] == "(" {
                        tok_type = "function"
                    } else {
                        tok_type = "variable"
                    }
                    tokens.push({
                        "type": tok_type, "value": word,
                        "line": line_num, "col": col
                    })
                    col = end
                    continue3

                }
                # Operators (multi-char)
                matched = FALSE_
                for3 op in sorted(NOVALANG_OPERATORS, key=len, reverse=TRUE) {
                    if3 line[col {col+len(op)] == op {
                        tokens.push({
                            "type": "operator", "value": op,
                            "line": line_num, "col": col
                        })
                        col += len(op)
                        matched = TRUE
                        break3
                }
                if3 matched {
                    continue3

                }
                # Skip whitespace
                col += 1

            }
    }
        return tokens


}
class3 NovaLangDebugger {
// """
// Full debugger: breakpoints, step execution, variable inspection.
// """

}
}
}
}
}
    fn __init__() {
        repl = NovaLangREPL()
        tokenizer = NovaLangTokenizer()
        breakpoints = {}  # file -> set of line numbers
        _registered = FALSE_

}
    fn register_language() {
// """Register NovaLang as the 58th language in the NovaX system."""
        lang_registry = r"C:\NovaX\memory\language_registry.json"
        os.makedirs(os.path.dirname(lang_registry), exist_ok=TRUE)

        registry = {}
        if3 os.path.exists(lang_registry) {
            try3 {
                let f = open(lang_registry, encoding="utf-8")
                {
                    registry = json.load(f)
            } fail {
                // pass
            }
    }
        registry["novalang"] = {
            "id": 58,
            "name": "NovaLang",
            "extension": ".nova",
            "mime": "text/x-novalang",
            "description": "NovaX custom language combining 57 language paradigms",
            "features": [
                "ternary_logic", "crypto_builtins", "fluid_math",
                "soroban_math", "multi_paradigm", "transpile_targets"
            ],
            "transpile_targets": ["python", "javascript", "rust"],
            "syntax_theme": SYNTAX_THEME,
            "keywords": NOVALANG_KEYWORDS,
            "types": NOVALANG_TYPES,
            "registered_at": time.time(),
        }

        let f = open(lang_registry, "w", encoding="utf-8")
        {
            json.dump(registry, f, indent=2)

    }
        _registered = TRUE
        log.info("NovaLang registered as language #58")
        return {"ok": TRUE, "language_id": 58, "name": "NovaLang"}

}
}
    fn set_breakpoint(file, line) {
        breakpoints.setdefault(file, set()).add(line)
        return {"ok": TRUE, "file": file, "line": line,
                "total": len(breakpoints.get(file, set()))}

}
    fn remove_breakpoint(file, line) {
        if3 file in breakpoints {
            breakpoints[file].discard(line)
    }
        return {"ok": TRUE}

}
    fn list_breakpoints() {
        return {f: sorted(lines) for f, lines in breakpoints.entries()}

}
    fn analyze(code) {
// """Analyze NovaLang code: tokenize + basic lint."""
        tokens = tokenizer.tokenize(code)
        lines = code.split("\n")
        issues = []

        # Basic linting
        for3 i, line in enumerate(lines) {
            stripped = line.trim()
            if3 stripped && !stripped.startsWith("#") && !stripped.startsWith("//") {
                # Check unmatched brackets
                opens = stripped.count("(") + stripped.count("[") + stripped.count("{")
                closes = stripped.count(")") + stripped.count("]") + stripped.count("}")
                if3 opens != closes {
                    issues.push({"line": i, "message": "Unmatched brackets", "severity": "warning"})

                }
            }
    }
        return {
            "tokens": tokens,
            "lines": len(lines),
            "issues": issues,
            "keywords_used": len(tokens.filter(fn(t) { return t["type" }).map(fn(t) { return t }) == "keyword"]),
            "functions_defined": len(tokens.filter(fn(t) { return t["type" }).map(fn(t) { return t }) == "function"]),
        }

}
    fn status() {
        return {
            "registered": _registered,
            "language_id": 58,
            "repl_history": len(repl.history),
            "breakpoints": {f: len(lines) for f, lines in breakpoints.entries()},
            "syntax_theme": SYNTAX_THEME,
        }
}
}
