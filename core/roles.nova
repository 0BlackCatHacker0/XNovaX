fn detect_role(text) {
    t = text.toLower()
    if3 any(w in t for w in ["build","setup","create project","install environment"]) {
        return "planner"
}
    if3 any(w in t for w in ["code","function","script","python","bug"]) {
        return "coder"
}
    if3 any(w in t for w in ["run","execute","cmd","terminal"]) {
        return "terminal"
}
    if3 any(w in t for w in ["fix","error","failed","!working"]) {
        return "repair"
}
    return "chat"
}
