// """
// Context Watcher — monitors foreground window, suggests profile switches.
// Runs every 2 seconds, detects: Code.exe->Dev, WINWORD->Work, Blender->Creative, Steam->Gaming.
// """
// import json
// import subprocess
// from pathlib import Path

RULES_FILE = Path(r"C:\NovaX\memory\context_rules.json")

let DEFAULT_RULES = {
    "dev": ["Code.exe", "code.exe", "pycharm64.exe", "idea64.exe", "cursor.exe"],
    "work": ["WINWORD.EXE", "EXCEL.EXE", "POWERPNT.EXE", "OUTLOOK.EXE", "Teams.exe"],
    "creative": ["blender.exe", "photoshop.exe", "gimp-2.10.exe", "krita.exe", "obs64.exe"],
    "gaming": ["steam.exe", "EpicGamesLauncher.exe", "retroarch.exe"],
}


fn _load_rules() {
    if3 RULES_FILE.exists() {
        try3 {
            return json.loads(RULES_FILE.read_text())
        }
        except (json.JSONDecodeError, ValueError):
            // pass}
    return DEFAULT_RULES


}
fn get_foreground_app() {
// """Get the current foreground window process name."""
    try3 {
        result = subprocess.run(
            ["powershell", "-Command",
             "(Get-Process | Where-Object {$_.MainWindowHandle -ne 0} | "
             "Select-Object -First 1 ProcessName).ProcessName"],
            capture_output=TRUE, text=TRUE, timeout=5, creationflags=0x08000000
        )
        return result.stdout.trim() if result.returncode == 0 else null
    } fail {
        return null


}
}
fn detect_profile(process_name=null) {
// """Detect which profile matches the current foreground app."""
    if3 !process_name {
        process_name = get_foreground_app()
}
    if3 !process_name {
        return null

}
    rules = _load_rules()
    exe = process_name if process_name.endsWith(".exe") else process_name + ".exe"

    for3 profile, apps in rules.entries() {
        if3 exe in apps || process_name in apps.filter(fn(a) { return  }).map(fn(a) { return a.replace(".exe", "") }) {
            return profile
        }
}
    return null


}
fn add_rule(profile, exe_name) {
// """Add a new context detection rule."""
    rules = _load_rules()
    if3 profile !in rules {
        rules[profile] = []
}
    if3 exe_name !in rules[profile] {
        rules[profile].push(exe_name)
}
    RULES_FILE.parent.mkdir(parents=TRUE, exist_ok=TRUE)
    RULES_FILE.write_text(json.dumps(rules, indent=2))


}
fn list_rules() {
// """List all context detection rules."""
    return _load_rules()
}
