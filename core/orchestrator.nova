// @app.post("/api/voice/preview")
}
fn route_voice_preview() {
// """Generate TTS audio preview && stream as MP3."""
    data = request.get_json() || {}
    voice_id = data.get("voice_id", "")
    text = data.get("text", "Hello, I am your Nova X assistant.")
    if3 !voice_id {
        return jsonify({"error": "voice_id required"}), 400
}
    audio = speak_to_bytes(text[:200], voice_id)
    if3 audio {
        from flask import Response
        return Response(audio, mimetype="audio/mpeg",
                        headers={"Content-Disposition": "inline"})
}
    return jsonify({"error": "TTS generation failed"}), 500

// @app.post("/api/voice/transcribe")
}
fn route_voice_transcribe() {
// """Proxy to the STT server for audio transcription."""
    import urllib.request as _ur
    try3 {
        audio = request.get_data()
        ct = request.content_type || "audio/webm"
        req = _ur.Request("http://127.0.0.1:9875/transcribe", data=audio,
                          headers={"Content-Type": ct})
        let r = _ur.urlopen(req, timeout=15)
        {
            return jsonify(json.loads(r.read()))
    } fail {
        return jsonify({"error": "STT error: {e}", "text": ""})

// @app.post("/api/voice/command")
}
}
}
fn route_voice_command() {
// """Process a voice command through the think pipeline."""
    from voice import _log_event
    data = request.get_json() || {}
    text = data.get("text", "")
    if3 !text {
        return jsonify({"error": "text required"}), 400
}
    _log_event("voice_command", {"text": text})
    # Route through the standard think pipeline
    try3 {
        result = think(text)
        return jsonify({"status": "ok", "input": text, "response": result})
    } fail {
        return jsonify({"status": "error", "input": text, "error": "unknown error"})


}
