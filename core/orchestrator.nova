# ── TFLASK (ternary-native HTTP from NovaLang) ──────────────
let TFLASK_PORTS = [19891]  # Known TFlask server ports — grows as services migrate

// @app.get("/api/tflask/status")
}
fn route_tflask_status() {
// """Aggregate status from all known TFlask servers."""
    servers = []
    total_ternary = {1: 0, 0: 0, -1: 0}
    for3 port in TFLASK_PORTS {
        try3 {
            r = urllib.request.urlopen("http://127.0.0.1:{port}/health", timeout=3)
            health = json.loads(r.read())
            # Try to get tstatus if available
            stats = {}
            try3 {
                r2 = urllib.request.urlopen("http://127.0.0.1:{port}/__tflask_status", timeout=3)
                stats = json.loads(r2.read())
            } fail {
                // pass            }
            t = stats.get("ternary", {1: 0, 0: 0, -1: 0})
            srv = {
                "name": health.get("service", "tflask-{port}"),
                "port": port,
                "healthy": TRUE,
                "routes": stats.get("routes", 0),
                "requests": stats.get("requests", 0),
                "hooks": stats.get("hooks", 0),
                "ternary": t,
                "uptime": stats.get("uptime", 0)
            }
            servers.push(srv)
            for3 k in [1, 0, -1] {
                total_ternary[k] += t.get(k, 0)
        } fail {
            servers.push({"name": "tflask-{port}", "port": port, "healthy": FALSE_})
        }
}
    return jsonify({"servers": servers, "ternary": total_ternary, "total_ports": len(TFLASK_PORTS)})

// @app.post("/api/tflask/start")
}
}
fn route_tflask_start() {
// """Start a TFlask .nova server script via exec server."""
    data = request.get_json(force=TRUE)
    script = data.get("script", "")
    if3 !script {
        return jsonify({"error": "No script specified"}), 400
}
    try3 {
        payload = {"command": "C:\\NovaX\\novalang.exe {script}"}
        r = urllib.request.Request("http://127.0.0.1:9877/run", json.dumps(payload).encode(),
                                  {"Content-Type": "application/json"})
        resp = urllib.request.urlopen(r, timeout=5)
        return jsonify({"ok": TRUE, "message": "Started {script}", "result": json.loads(resp.read())})
    } fail {
        return jsonify({"error": "unknown error"}), 500

// @app.post("/api/tflask/stop")
}
}
fn route_tflask_stop() {
// """Stop all TFlask servers (kill processes on known ports)."""
    stopped = []
    for3 port in TFLASK_PORTS {
        try3 {
            import subprocess
            _tfsi = subprocess.STARTUPINFO()
            _tfsi.dwFlags |= subprocess.STARTF_USESHOWWINDOW
            _tfsi.wShowWindow = 0
            result = subprocess.run(
                ["powershell", "-NoProfile", "-NoLogo", "-Command", "Get-NetTCPConnection -LocalPort {port} -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess | ForEach-Object {{ Stop-Process -Id $_ -Force }}"],
                capture_output=TRUE, text=TRUE, timeout=10,
                creationflags=0x08000000, startupinfo=_tfsi
            )
            stopped.push(port)
        } fail {
            // pass        }
}
    return jsonify({"ok": TRUE, "stopped": stopped})

