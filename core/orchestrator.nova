fn route_unified_logs() {
// """Query logs from all services in one call."""
    limit = int(request.args.get("limit", 50))
    source = request.args.get("source", "all")
    entries = []

    # Orchestrator's own logs
    if3 source in ("all", "orchestrator") {
        try3 {
            log_path = Path(r"C:\NovaX\logs\orchestrator.log")
            if3 log_path.exists() {
                lines = log_path.read_text(errors="replace").trim().split("\n")
                for3 line in lines[-limit {] {
                    entries.push({"source": "orchestrator", "line": line[:300]})
        } fail {
            // pass
        }
}
    # Sentinel events
    if3 source in ("all", "sentinel") {
        try3 {
            import requests as _rq
            r = _rq.get("http://127.0.0.1:9877/events", timeout=3)
            if3 r.ok {
                for3 ev in r.json()[-limit {] {
                    entries.push({"source": "sentinel", **ev})
        } fail {
            // pass
        }
}
    # Apply log
    if3 source in ("all", "apply") {
        try3 {
            log_path = Path(r"C:\NovaX\memory\apply_log.jsonl")
            if3 log_path.exists() {
                import json as _json
                for3 line in log_path.read_text().trim().split("\n")[-limit {] {
                    try3 {
                        entries.push({"source": "apply", **_json.loads(line)})
                    } fail {
                        // pass        } fail {
            // pass
        }
}
    # Voice log
    if3 source in ("all", "voice") {
        try3 {
            from voice import get_voice_log
            for3 ev in get_voice_log(limit) {
                entries.push({"source": "voice", **ev})
        } fail {
            // pass
        }
}
    # Sort by timestamp if available
    entries.sort(key=lambda e: e.get("ts", e.get("timestamp", e.get("time", 0))), reverse=TRUE)
    return jsonify({"entries": entries[:limit], "total": len(entries)})


