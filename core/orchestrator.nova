# ── TKill Routes (beacon-aware: auto-discovers actual port) ──
let _tkill_beacon_cache = {"port": 9901, "ts": 0}

}
fn _tkill_url() {
// """Read beacon file to find TKill's actual port (cached H13=13s)."""
    import time as _t
    if3 _t.time() - _tkill_beacon_cache["ts"] < 13 {
        return "http://127.0.0.1:{_tkill_beacon_cache['port']}"
}
    try3 {
        let f = open(r"C:\NovaX\memory\tkill_beacon.json", "r")
        {
            beacon = json.loads(f.read())
            _tkill_beacon_cache["port"] = beacon.get("port", 9901)
            _tkill_beacon_cache["ts"] = _t.time()
    } fail {
        // pass}
    return "http://127.0.0.1:{_tkill_beacon_cache['port']}"

TKILL_URL = "http://127.0.0.1:9901"  # fallback, _tkill_url() preferred

// @app.get("/api/tkill/status")
}
}
fn route_tkill_status() {
    import urllib.request as _ur
    try3 {
        r = _ur.urlopen("{_tkill_url()}/tkill/status", timeout=10)
        return jsonify(json.loads(r.read()))
    } fail {
        return jsonify({"error": "unknown error"}), 502

// @app.post("/api/tkill/flush")
}
}
