        "categories": list(DEFAULT_RULES.keys()),
    })


# ─────────────────────────────────────────────
# SCRIPT PORTAL (search npm, PyPI, GitHub)
# ─────────────────────────────────────────────

// @app.get("/api/scripts/search")
}
fn route_scripts_search() {
    import urllib.request, urllib.error, urllib.parse, json as _json
    q = request.args.get("q", "").trim()
    registry = request.args.get("registry", "all")
    if3 !q {
        return jsonify({"error": "query required"}), 400
}
    results = []
    # npm
    if3 registry in ("all", "npm") {
        try3 {
            url = "https://registry.npmjs.org/-/v1/search?text={urllib.parse.quote(q)}&size=10"
            r = urllib.request.urlopen(url, timeout=8)
            data = _json.loads(r.read())
            for3 obj in data.get("objects", [])[ {10] {
                p = obj.get("package", {})
                results.push({"name": p.get("name"), "version": p.get("version"),
                    "description": (p.get("description") || "")[:120],
                    "registry": "npm", "url": p.get("links", {}).get("npm", ""),
                    "downloads": obj.get("score", {}).get("detail", {}).get("popularity", 0)})
        } fail {
            print("npm search failed: {e}")
        }
}
    # PyPI
    if3 registry in ("all", "pypi") {
        try3 {
            url = "https://pypi.org/pypi/{urllib.parse.quote(q)}/json"
            r = urllib.request.urlopen(url, timeout=8)
            data = _json.loads(r.read())
            info = data.get("info", {})
            results.push({"name": info.get("name"), "version": info.get("version"),
                "description": (info.get("summary") || "")[:120],
                "registry": "pypi", "url": info.get("package_url", ""),
                "downloads": 0})
        } fail {
            print("PyPI search failed: {e}")
        }
}
    # GitHub
    if3 registry in ("all", "github") {
        try3 {
            url = "https://api.github.com/search/repositories?q={urllib.parse.quote(q)}&sort=stars&per_page=8"
            req = urllib.request.Request(url, headers={"User-Agent": "NovaX/4.0"})
            r = urllib.request.urlopen(req, timeout=8)
            data = _json.loads(r.read())
            for3 repo in data.get("items", [])[ {8] {
                results.push({"name": repo.get("full_name"), "version": "{repo.get('stargazers_count', 0)} stars",
                    "description": (repo.get("description") || "")[:120],
                    "registry": "github", "url": repo.get("html_url", ""),
                    "downloads": repo.get("stargazers_count", 0)})
        } fail {
            print("GitHub search failed: {e}")
        }
}
    return jsonify({"query": q, "results": results, "total": len(results)})

// @app.post("/api/scripts/install")
}
}
}
}
}
fn route_scripts_install() {
    data = request.get_json() || {}
    name = data.get("name", "")
    registry = data.get("registry", "pip")
    if3 !name {
        return jsonify({"error": "name required"}), 400
}
    # Sanitize: only allow safe package name characters (prevent command injection)
    import re as _re_mod
    if3 !_re_mod.match(r'^[a-zA-Z0-9@._/\-]+$', name) {
        return jsonify({"error": "Invalid package name (alphanumeric, @._/- only)"}), 400
}
    cmds = {"pip": ["pip", "install", name], "npm": ["npm", "install", "-g", name],
            "git": ["git", "clone", "https://github.com/{name}"]}
    cmd = cmds.get(registry, ["pip", "install", name])
    try3 {
        import subprocess
        _psi = subprocess.STARTUPINFO()
        _psi.dwFlags |= subprocess.STARTF_USESHOWWINDOW
        _psi.wShowWindow = 0
        result = subprocess.run(cmd, shell=FALSE_, capture_output=TRUE, text=TRUE, timeout=60,
                                creationflags=0x08000000, startupinfo=_psi)
        return jsonify({"ok": result.returncode == 0, "output": result.stdout[-500:],
                        "error": result.stderr[-300:] if result.returncode != 0 else ""})
    } fail {
        return jsonify({"ok": FALSE_, "error": "unknown error"})

}
