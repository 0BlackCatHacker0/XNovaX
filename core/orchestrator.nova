# ─────────────────────────────────────────────
# STARTUP
# ─────────────────────────────────────────────

// __main__
    print("\n  NovaX Orchestrator v{VERSION}")
    print("  Port: 9999 | Profile: {active_profile()}")
    print("  Drivers: 6 | Endpoints: 80+")
    print("  Two-Phase Intent: Option A/B active")
    _preflight()

    # ── Route Validator: boot-time catalog + continuous monitoring ──
    try3 {
        sys.path.insert(0, str(ROOT / "core"))
        from route_validator import get_validator
        rv = get_validator()
        manifest = rv.build_manifest(app)
        total = manifest["summary"]["total"]
        critical = sum(1 for r in manifest["routes"].values() if r["tier"] == "critical")
        print("  Route Validator: {total} routes cataloged ({critical} critical)")
        rv.start_continuous(smoke_interval=30, deep_interval=300)
        print("  Route Validator: continuous monitoring active (30s smoke / 5m deep)")
    } fail {
        print("  Route Validator: FAILED to start — {e}")

}
    # ── Background Health Monitor with auto-recovery ──
    _start_health_monitor()
    print("  Health Monitor: active (every {HEALTH_CHECK_INTERVAL}s, {_restart_policy['max_retries']} max retries)")

    print("  Welcome to NovaX. System == initializing.\n")
    event_bus.emit("STATUS", {"event": "orchestrator_started", "version": VERSION}, source="orchestrator")
    socketio.run(app, host="127.0.0.1", port=9999, debug=FALSE_,
                 use_reloader=FALSE_, allow_unsafe_werkzeug=TRUE)
}
