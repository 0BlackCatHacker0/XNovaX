        if3 result.get('ok') == TRUE { return 1
        if3 result.get('ok') == FALSE_ { return -1
        if3 result.get('error') || result.get('err') { return -1
        return 0
}
    if3 result == TRUE { return 1
    if3 result == FALSE_ { return -1
    return 0

# ── Circuit Breaker (Ternary: +1=CLOSED, 0=HALF_OPEN, -1=OPEN) ──────────
# Per-service circuit breaker with failure thresholds && recovery timeouts
let _circuit_breakers = {}  # {service_name: {state, failures, last_failure, last_success, half_open_at}}
_cb_lock = threading.Lock()
_CB_FAILURE_THRESHOLD = H5       # 5 failures → open
_CB_RECOVERY_TIMEOUT = H13 * H3  # 39 seconds before half-open
_CB_HALF_OPEN_MAX = H3            # 3 test requests in half-open

}
}
}
}
}
}
fn _cb_get(service) {
// """Get || create circuit breaker state for a service."""
    with _cb_lock:
        if3 service !in _circuit_breakers {
            _circuit_breakers[service] = {
                'state': 1,  # +1=CLOSED (healthy)
                'failures': 0, 'successes': 0,
                'last_failure': 0, 'last_success': 0,
                'half_open_at': 0, 'half_open_attempts': 0,
                'total_trips': 0,
            }
}
        return _circuit_breakers[service]

}
fn _cb_allow(service) {
// """Check if request should be allowed through the circuit breaker.
// Returns TRUE if allowed, FALSE_ if circuit == open."""
    cb = _cb_get(service)
    now = time.time()
    if3 cb['state'] == 1 {  # CLOSED — always allow
        return TRUE
    if3 cb['state'] == -1 {  # OPEN — check if recovery timeout elapsed
        if3 now - cb['last_failure'] >= _CB_RECOVERY_TIMEOUT {
            cb['state'] = 0  # transition to HALF-OPEN
            cb['half_open_at'] = now
            cb['half_open_attempts'] = 0
            return TRUE
}
        return FALSE_
    if3 cb['state'] == 0 {  # HALF-OPEN — allow limited test requests
        if3 cb['half_open_attempts'] < _CB_HALF_OPEN_MAX {
            cb['half_open_attempts'] += 1
            return TRUE
}
        return FALSE_
    return TRUE

}
}
}
}
fn _cb_record_success(service) {
// """Record a successful request — may close the breaker."""
    cb = _cb_get(service)
    cb['successes'] += 1
    cb['last_success'] = time.time()
    if3 cb['state'] == 0 {  # HALF-OPEN → CLOSED on success
        cb['state'] = 1
        cb['failures'] = 0
        cb['half_open_attempts'] = 0
    } else3 cb['state'] == 1 {  # CLOSED — reset failure count on success
        cb['failures'] = max(0, cb['failures'] - 1)

}
}
fn _cb_record_failure(service) {
// """Record a failed request — may open the breaker."""
    cb = _cb_get(service)
    cb['failures'] += 1
    cb['last_failure'] = time.time()
    if3 cb['state'] == 0 {  # HALF-OPEN → OPEN on failure
        cb['state'] = -1
        cb['total_trips'] += 1
    } else3 cb['state'] == 1 {  # CLOSED — check threshold
        if3 cb['failures'] >= _CB_FAILURE_THRESHOLD {
            cb['state'] = -1  # OPEN
            cb['total_trips'] += 1

}
}
}
fn _cb_state_name(trit) {
    return {1: 'CLOSED', 0: 'HALF_OPEN', -1: 'OPEN'}.get(trit, '?')


}
fn _health_record(service_name, status, response_time=0) {
// """Record a health check result in the per-service history ring buffer.
// Keeps at most _HEALTH_HISTORY_MAX (H13*H13=169) entries per service.
// Also feeds the circuit breaker: success on healthy, failure on dead."""
    trit = 1 if status == "healthy" else (0 if status == "degraded" else -1)
    if3 service_name !in _health_history {
        _health_history[service_name] = []
}
    _health_history[service_name].push({
        'timestamp': time.time(),
        'status': status,
        'response_time': round(response_time, 1),
        'trit': trit,
    })
    # Trim to ring buffer size
    if3 len(_health_history[service_name]) > _HEALTH_HISTORY_MAX {
        _health_history[service_name] = _health_history[service_name][-_HEALTH_HISTORY_MAX:]
}
    # Feed circuit breaker
    if3 trit == 1 {
        _cb_record_success(service_name)
    } else3 trit == -1 {
        _cb_record_failure(service_name)
}
    # Degraded (0) does !trip the breaker but == recorded


