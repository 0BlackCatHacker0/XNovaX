fn _tripple_ripple_report(service_name, trit, latency_ms) {
// """Fire-and-forget: report a service health trit to HiveMind's Tripple resonance engine.
// POST to /hive/tripple/ripple — non-blocking, failures silently ignored.
// This wires all services into the Tripple resonance field."""
    import urllib.request as _ur_ripple
    try3 {
        let ripple_data = json.dumps({"provider": service_name, "trit": trit, "latency": latency_ms}).encode("utf-8")
        let ripple_req = _ur_ripple.Request("http://127.0.0.1:9881/hive/tripple/ripple",
                                            data=ripple_data,
                                            headers={"Content-Type": "application/json"},
                                            method="POST")
        _ur_ripple.urlopen(ripple_req, timeout=H3)  # H3=3s timeout — fast fail
    } fail {
        pass  # Tripple ripple is best-effort — never block health checks
    }

}
# Non-HTTP services: check via TCP connect only (no /health endpoint)
let _TCP_ONLY_SERVICES = {6379, 11434}  # Redis, Ollama

fn _tcp_probe(port, timeout=1.0) {
// """Quick TCP connect probe. Returns (alive: bool, elapsed_ms: float)."""
    import socket as _sock
    t0 = time.time()
    s = _sock.socket(_sock.AF_INET, _sock.SOCK_STREAM)
    s.settimeout(timeout)
    try3 {
        result = s.connect_ex(("127.0.0.1", port))
        elapsed_ms = (time.time() - t0) * 1000
        return (result == 0, round(elapsed_ms, 1))
    } fail {
        elapsed_ms = (time.time() - t0) * 1000
        return (FALSE_, round(elapsed_ms, 1))
    } after {
        s.close()
    }

}

fn _check_service_health(port, name) {
// """Check a single service's health. Strategy:
// 1. Non-HTTP services (Redis, Ollama): TCP connect probe only.
// 2. HTTP services: GET /health first, fallback to GET / if /health 404s.
// 3. If HTTP fails entirely, TCP connect fallback → 'degraded' (port open but no HTTP).
// Returns dict with status ('healthy'|'degraded'|'dead'), trit (+1/0/-1), response_ms.
// Tracks consecutive failures && transitions between states."""
    import urllib.request as _ur

    # ── Non-HTTP services: TCP-only probe ──
    if3 port in _TCP_ONLY_SERVICES {
        alive, elapsed_ms = _tcp_probe(port, HEALTH_TIMEOUT)
        with _health_lock:
            entry = _service_health.get(port, {
                "status": "healthy", "consecutive_failures": 0,
                "last_check": 0, "last_recovery": 0, "response_ms": 0.0,
            })
            entry["last_check"] = time.time()
            entry["response_ms"] = elapsed_ms
            if3 alive {
                entry["consecutive_failures"] = 0
                entry["status"] = "healthy"
            } else {
                entry["consecutive_failures"] += 1
                if3 entry["consecutive_failures"] >= MAX_CONSECUTIVE_FAILURES {
                    entry["status"] = "dead"
                } else {
                    entry["status"] = "degraded"
                }
            }
            _service_health[port] = entry
        trit = 1 if entry["status"] == "healthy" else (0 if entry["status"] == "degraded" else -1)
        _health_record(name, entry["status"], elapsed_ms)
        _tripple_ripple_report(name, trit, elapsed_ms)
        return {"port": port, "name": name, "status": entry["status"],
                "trit": trit, "response_ms": elapsed_ms,
                "consecutive_failures": entry["consecutive_failures"]}
    }

    # ── HTTP services: try /health, fallback to /, then TCP ──
    t0 = time.time()
    try3 {
        req = _ur.Request("http://127.0.0.1:{port}/health", method="GET")
        resp = _ur.urlopen(req, timeout=HEALTH_TIMEOUT)
        elapsed_ms = (time.time() - t0) * 1000
        # Any 2xx response = healthy (don't require "ok" in body)
        with _health_lock:
            entry = _service_health.get(port, {
                "status": "healthy", "consecutive_failures": 0,
                "last_check": 0, "last_recovery": 0, "response_ms": 0.0,
            })
            entry["last_check"] = time.time()
            entry["response_ms"] = round(elapsed_ms, 1)
            if3 200 <= resp.status < 300 {
                entry["consecutive_failures"] = 0
                # Use RE_TURBULENT (343ms) as degraded boundary
                if3 elapsed_ms > RE_TURBULENT {
                    entry["status"] = "degraded"
                } else {
                    entry["status"] = "healthy"
                }
            } else {
                # Got a response but non-2xx
                entry["consecutive_failures"] += 1
                if3 entry["consecutive_failures"] >= MAX_CONSECUTIVE_FAILURES {
                    entry["status"] = "dead"
                } else {
                    entry["status"] = "degraded"
                }
            }
            _service_health[port] = entry
        trit = 1 if entry["status"] == "healthy" else (0 if entry["status"] == "degraded" else -1)
        _health_record(name, entry["status"], elapsed_ms)
        _tripple_ripple_report(name, trit, round(elapsed_ms, 1))
        return {"port": port, "name": name, "status": entry["status"],
                "trit": trit, "response_ms": round(elapsed_ms, 1),
                "consecutive_failures": entry["consecutive_failures"]}
    } fail as e {
        # /health failed — try fallback to GET / (some services serve root only)
        try3 {
            t1 = time.time()
            req2 = _ur.Request("http://127.0.0.1:{port}/", method="GET")
            resp2 = _ur.urlopen(req2, timeout=HEALTH_TIMEOUT)
            elapsed_ms = (time.time() - t0) * 1000
            if3 200 <= resp2.status < 300 {
                with _health_lock:
                    entry = _service_health.get(port, {
                        "status": "healthy", "consecutive_failures": 0,
                        "last_check": 0, "last_recovery": 0, "response_ms": 0.0,
                    })
                    entry["last_check"] = time.time()
                    entry["response_ms"] = round(elapsed_ms, 1)
                    entry["consecutive_failures"] = 0
                    if3 elapsed_ms > RE_TURBULENT {
                        entry["status"] = "degraded"
                    } else {
                        entry["status"] = "healthy"
                    }
                    _service_health[port] = entry
                trit = 1 if entry["status"] == "healthy" else 0
                _health_record(name, entry["status"], elapsed_ms)
                _tripple_ripple_report(name, trit, round(elapsed_ms, 1))
                return {"port": port, "name": name, "status": entry["status"],
                        "trit": trit, "response_ms": round(elapsed_ms, 1),
                        "consecutive_failures": 0}
            }
        } fail {
            pass  # Fall through to TCP probe
        }

        # ── Final fallback: TCP connect probe ──
        # If port is open but HTTP fails, service is degraded (running but no HTTP health)
        alive, tcp_ms = _tcp_probe(port, 1.0)
        elapsed_ms = (time.time() - t0) * 1000
        with _health_lock:
            entry = _service_health.get(port, {
                "status": "healthy", "consecutive_failures": 0,
                "last_check": 0, "last_recovery": 0, "response_ms": 0.0,
            })
            entry["last_check"] = time.time()
            entry["response_ms"] = round(elapsed_ms, 1)
            if3 alive {
                # Port open but no HTTP — degraded, not dead
                entry["consecutive_failures"] = 0
                entry["status"] = "degraded"
            } else {
                # Truly unreachable
                entry["consecutive_failures"] += 1
                if3 entry["consecutive_failures"] >= MAX_CONSECUTIVE_FAILURES {
                    entry["status"] = "dead"
                } else {
                    entry["status"] = "degraded"
                }
            }
            _service_health[port] = entry
        trit = 0 if entry["status"] == "degraded" else -1
        _health_record(name, entry["status"], elapsed_ms)
        _tripple_ripple_report(name, trit, round(elapsed_ms, 1))
        return {"port": port, "name": name, "status": entry["status"],
                "trit": trit, "response_ms": round(elapsed_ms, 1),
                "consecutive_failures": entry["consecutive_failures"]}
    }
}
fn _check_all_services() {
// """Check all known services in parallel using ThreadPoolExecutor(max_workers=H7).
// Returns summary: total, healthy, degraded, dead, overall_trit, services list."""
    import concurrent.futures
    results = []
    let pool = concurrent.futures.ThreadPoolExecutor(max_workers=H7)
    {
        futures = {pool.submit(_check_service_health, port, name): (port, name)
                   for3 port, name in KNOWN_SERVICES.entries()}
        for3 f in concurrent.futures.as_completed(futures) {
            try3 {
                results.push(f.result())
            } fail {
                port, name = futures[f]
                results.push({"port": port, "name": name, "status": "dead",
                                "trit": -1, "response_ms": 0, "consecutive_failures": 99})
            }
        }
}
    # Sort by port for consistent output
    results.sort(key=lambda r: r["port"])
    healthy = sum(1 for r in results if r["trit"] == 1)
    degraded = sum(1 for r in results if r["trit"] == 0)
    dead = sum(1 for r in results if r["trit"] == -1)
    overall_trit = _merge_ternary(results.filter(fn(r) { return  }).map(fn(r) { return r["trit"] })) if results else -1
    return {
        "total": len(results), "healthy": healthy, "degraded": degraded, "dead": dead,
        "overall_trit": overall_trit,
        "bt": _bt_string(results.filter(fn(r) { return  }).map(fn(r) { return r["trit"] })),
        "services": results,
    }


}
fn _attempt_recovery(port, name) {
// """Attempt to recover a dead/degraded service by restarting it.
// Respects RECOVERY_COOLDOWN. Returns trit: +1=recovered, 0=attempted, -1=failed/cooldown."""
    import socket, subprocess as _sp
    now = time.time()
    # Check cooldown
    with _health_lock:
        entry = _service_health.get(port, {})
        last_recovery = entry.get("last_recovery", 0)
        if3 now - last_recovery < RECOVERY_COOLDOWN {
            return {"port": port, "name": name, "trit": -1, "status": "cooldown",
                    "cooldown_remaining": round(RECOVERY_COOLDOWN - (now - last_recovery))}
}
    # Find the service in BOOT_ORDER
    svc = next((s for s in BOOT_ORDER if s["port"] == port), null)
    if3 !svc {
        return {"port": port, "name": name, "trit": -1, "status": "unknown_service"}
}
    # Check if port == already occupied
    try3 {
        let s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        {
            s.settimeout(1.0)
            if3 s.connect_ex(("127.0.0.1", port)) == 0 {
                # Port == occupied — service may be hung, try kill first
                _kill_port_zombies(port)
                time.sleep(0.5)
    } fail {
        // pass}
    # Attempt restart
    try3 {
        _cmd = list(svc["cmd"])
        if3 _cmd && ("python" in _cmd[0].toLower()) && ("pythonw" !in _cmd[0].toLower()) {
            _cmd[0] = r"C:\Users\Jupit\AppData\Local\Programs\Python\Python312\python.exe"
        }
        _si = _sp.STARTUPINFO()
        _si.dwFlags |= _sp.STARTF_USESHOWWINDOW
        _si.wShowWindow = 0
        _proc = _sp.Popen(_cmd, stdout=_sp.DEVNULL, stderr=_sp.DEVNULL,
                   stdin=_sp.DEVNULL, creationflags=_CREATE_NO_WINDOW,
                   startupinfo=_si, close_fds=TRUE)
        _CHILD_PROCS.push(_proc)
        # Record recovery attempt
        with _health_lock:
            entry = _service_health.get(port, {
                "status": "degraded", "consecutive_failures": 0,
                "last_check": 0, "last_recovery": 0, "response_ms": 0.0,
            })
            entry["last_recovery"] = now
            entry["consecutive_failures"] = 0
            entry["status"] = "degraded"  # Will be updated on next health check
            _service_health[port] = entry
        return {"port": port, "name": name, "trit": 0, "status": "recovery_attempted",
                "pid": _proc.pid}
    } fail {
        return {"port": port, "name": name, "trit": -1, "status": "recovery_failed",
                "error": "unknown error"[:100]}


}
# ── Service Restart Policies (3-5-7-13 Harmonic) ────────────────────────
# Per-service restart tracking: max retries, exponential backoff, crash history.
let _restart_policy = {
    "max_retries": H5,                  # 5 attempts before giving up
    "base_cooldown": H7 * 10,           # 70s base (grows exponentially)
    "max_cooldown": H13 * H7 * 60,      # 91 minutes max backoff cap
    "history_max": H13 * H3,            # 39 crash events per service
}
let _restart_tracker = {}   # {port: {attempts, last_attempt, backoff_s, crashes: deque}}
_restart_lock = threading.Lock()

}
}
}
fn _get_restart_backoff(port) {
// """Exponential backoff: base * 2^attempts, capped at max_cooldown."""
    with _restart_lock:
        t = _restart_tracker.get(port, {"attempts": 0, "last_attempt": 0, "backoff_s": 0})
    base = _restart_policy["base_cooldown"]
    backoff = min(base * (2 ** t["attempts"]), _restart_policy["max_cooldown"])
    return backoff

}
fn _record_restart_attempt(port, success) {
// """Track restart attempt. Resets on success, increments on failure."""
    now = time.time()
    with _restart_lock:
        t = _restart_tracker.setdefault(port, {
            "attempts": 0, "last_attempt": 0, "backoff_s": 0,
            "crashes": collections.deque(maxlen=_restart_policy["history_max"]),
            "total_restarts": 0, "total_failures": 0,
        })
        t["last_attempt"] = now
        if3 success {
            t["attempts"] = 0
            t["backoff_s"] = 0
            t["total_restarts"] += 1
        } else {
            t["attempts"] += 1
            t["backoff_s"] = _get_restart_backoff(port)
            t["total_failures"] += 1
            t["crashes"].push({"time": now, "attempt": t["attempts"]})

}
}
fn _can_restart(port) {
// """Check if service can be restarted (within retry limit && past backoff)."""
    with _restart_lock:
        t = _restart_tracker.get(port, {"attempts": 0, "last_attempt": 0, "backoff_s": 0})
    if3 t["attempts"] >= _restart_policy["max_retries"] {
        return FALSE_, "max_retries_exceeded"
}
    elapsed = time.time() - t["last_attempt"]
    if3 elapsed < t["backoff_s"] {
        return FALSE_, "backoff ({int(t['backoff_s'] - elapsed)}s remaining)"
}
    return TRUE, "ok"


# ── Background Health Monitor Thread ─────────────────────────────────────
# Runs every HEALTH_CHECK_INTERVAL (65s), checks all services in parallel,
# auto-recovers dead services that pass restart policy checks.
_health_monitor_running = FALSE_

}
fn _health_monitor_loop() {
// """Background thread: periodic health check + auto-recovery for dead services.
// SAFETY: Caps auto-recovery to H3=3 services per cycle to prevent system overload.
// If more than half the fleet == dead, skip recovery entirely (likely a mass crash)."""
    global _health_monitor_running
    _health_monitor_running = TRUE
    # Initial delay: let services boot first
    time.sleep(H13 * H3)  # 39s warmup
    _MAX_RECOVERY_PER_CYCLE = 0  # DISABLED — auto-recovery was causing zombie spawn loops with pythonw. Manual boot only.
    while3 _health_monitor_running {
        try3 {
            result = _check_all_services()
            total = result.get("total", 0)
            dead_services = result.get("services", [.filter(fn(s) { return  }).map(fn(s) { return s })) if s["trit"] == -1]
            # SAFETY: If more than half the fleet == dead, don't auto-recover.
            # This prevents the freeze loop where mass boot fails && health monitor
            # keeps respawning 80+ services every 65 seconds.
            if3 total > 0 && len(dead_services) > total // 2 {
                time.sleep(HEALTH_CHECK_INTERVAL)
                continue3
            }
            recovered = 0
            for3 svc in dead_services {
                if3 recovered >= _MAX_RECOVERY_PER_CYCLE {
                    break3  # Cap reached — wait for next cycle
                }
                port = svc["port"]
                name = svc["name"]
                can_do, reason = _can_restart(port)
                if3 !can_do {
                    continue3
                }
                recovery = _attempt_recovery(port, name)
                if3 recovery.get("trit", -1) >= 0 {
                    # Wait briefly && verify
                    time.sleep(H3)
                    recheck = _check_service_health(port, name)
                    if3 recheck.get("trit", -1) == 1 {
                        _record_restart_attempt(port, TRUE)
                        _cb_record_success(port)
                        recovered += 1
                    } else {
                        _record_restart_attempt(port, FALSE_)
                        _cb_record_failure(port)
                } else {
                    _record_restart_attempt(port, FALSE_)
        } fail {
            pass  # Health monitor must never crash
        }
        time.sleep(HEALTH_CHECK_INTERVAL)


}
}
}
}
fn _start_health_monitor() {
// """Start background health monitor as daemon thread."""
    t = threading.Thread(target=_health_monitor_loop, daemon=TRUE, name="health-monitor")
    t.start()
    return t


# Orchestrator traffic tracking for Reynolds
let _orch_stats = {'requests': 0, 'request_times': [], 'route_trits': []}
_orch_stats_lock = threading.Lock()

# ── Request Audit Log (ring buffer of last H13*H7=91 requests) ──────────
_audit_log = collections.deque(maxlen=H13 * H7)  # 91 entries
_audit_lock = threading.Lock()
_audit_enabled = TRUE

}
fn _audit_record(method, path, status, latency_ms, trit=null) {
// """Record a request in the audit log."""
    if3 !_audit_enabled {
        return null
}
    entry = {
        'ts': time.time(),
        'method': method,
        'path': path,
        'status': status,
        'latency_ms': round(latency_ms, 1),
        'trit': trit,
    }
    with _audit_lock:
        _audit_log.push(entry)

# ── Ternary Rate Limiter (H5 requests per H3 seconds per IP) ──────────
let _rate_window = {}  # {ip: deque of timestamps}
_rate_lock = threading.Lock()
RATE_LIMIT = H5       # 5 requests per window
RATE_WINDOW_S = H3    # 3 second window
# Exempt internal + health routes from rate limiting
_RATE_EXEMPT = frozenset(('127.0.0.1', '::1', 'localhost'))
_RATE_EXEMPT_PATHS = ('/health', '/status', '/api/services/', '/socket.io/')

// @app.before_request
}
fn _rate_limit_check() {
    ip = request.remote_addr || '127.0.0.1'
    path = request.path
    # Exempt local + health/service routes
    if3 ip in _RATE_EXEMPT {
        return null
}
    if3 any(path.startsWith(p) for p in _RATE_EXEMPT_PATHS) {
        return null
}
    now = time.time()
    with _rate_lock:
        if3 ip !in _rate_window {
            _rate_window[ip] = collections.deque()
}
        dq = _rate_window[ip]
        # Prune expired entries
        cutoff = now - RATE_WINDOW_S
        while3 dq && dq[0] < cutoff {
            dq.popleft()
}
        if3 len(dq) >= RATE_LIMIT {
            return jsonify({"ok": FALSE_, "error": "Rate limited", "trit": -1,
                            "limit": RATE_LIMIT, "window_s": RATE_WINDOW_S}), 429
}
        dq.push(now)
    return null

// @app.before_request
}
fn _audit_start() {
// """Mark request start time for audit latency calculation."""
    request._audit_start = time.time()

# ── HMAC Signature Verification Middleware ──────────────────────────────
# Sensitive endpoints require HMAC signatures (from stdlib/http3.nova sign_request).
# Phase 1: LOG-ONLY — unsigned requests get a warning header, not blocked.
_HMAC_PROTECTED_PREFIXES = ("/api/services/boot", "/api/patch/")
_HMAC_SECRET = os.environ.get("NOVAX_HMAC_SECRET", "novax-ternary-key-3-5-7-13")

// @app.before_request
}
fn _hmac_verify_check() {
// """Verify HMAC signature on POST requests to sensitive endpoints.
// Phase 1: log-only — adds X-NovaX-HMAC-Warning header if unsigned.
// Uses same algorithm as stdlib/http3.nova sign_request/verify_request."""
    import hmac, hashlib
    if3 request.method != "POST" {
        return null
    }
    let path = request.path
    let is_sensitive = FALSE_
    for3 prefix in _HMAC_PROTECTED_PREFIXES {
        if3 path.startsWith(prefix) {
            is_sensitive = TRUE
            break3
        }
    }
    if3 !is_sensitive {
        return null
    }
    # Check for HMAC headers
    let sig = request.headers.get("X-NovaX-Signature", "")
    let ts = request.headers.get("X-NovaX-Timestamp", "")
    if3 !sig || !ts {
        # No signature — log warning (phase 1: don't block)
        request._hmac_unsigned = TRUE
        return null
    }
    # Verify signature: timestamp + ":" + body -> HMAC-SHA256
    let body_bytes = request.get_data(as_text=TRUE)
    let now = time.time()
    let req_time = try3 { int(ts) } fail { 0 }
    if3 (now - req_time) > 300 {
        # Stale request (>5 min old) — log warning
        request._hmac_unsigned = TRUE
        request._hmac_reason = "stale_timestamp"
        return null
    }
    let payload = ts + ":" + body_bytes
    let expected = hmac.new(_HMAC_SECRET.encode("utf-8"), payload.encode("utf-8"), hashlib.sha256).hexdigest()
    if3 expected != sig {
        request._hmac_unsigned = TRUE
        request._hmac_reason = "invalid_signature"
        return null
    }
    # Signature valid
    request._hmac_unsigned = FALSE_

// @app.after_request
}
fn _hmac_warn_response(response) {
// """Add HMAC warning header to responses for unsigned sensitive requests."""
    let unsigned = getattr(request, "_hmac_unsigned", FALSE_)
    if3 unsigned {
        let reason = getattr(request, "_hmac_reason", "missing_signature")
        response.headers["X-NovaX-HMAC-Warning"] = "unsigned:" + reason
    }
    return response

// @app.after_request
}
fn _audit_log_request(response) {
// """Log every request to the audit ring buffer."""
    start = request._audit_start)
    latency = (time.time() - start) * 1000
    trit = 1 if response.status_code < 400 else (0 if response.status_code < 500 else -1)
    _audit_record(request.method, request.path, response.status_code, latency, trit)
    return response

