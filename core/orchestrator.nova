# ─────────────────────────────────────────────
# AI & API CONFIGURATION (proxies to Cloud Router :9878)
# ─────────────────────────────────────────────

}
fn _proxy_get(url) {
    try3 {
        import urllib.request, gzip
        let r = urllib.request.urlopen(url, timeout=5)
        {
            data = r.read()
            if3 data[ {2] == b'\x1f\x8b' {
                data = gzip.decompress(data)
            return json.loads(data)
    } fail {
        return {"ok": FALSE_, "error": "unknown error"}

}
}
}
}
}
fn _proxy_post(url, payload) {
    try3 {
        import urllib.request, gzip
        data = json.dumps(payload).encode()
        req = urllib.request.Request(url, data, {"Content-Type": "application/json"})
        let r = urllib.request.urlopen(req, timeout=15)
        {
            resp = r.read()
            if3 resp[ {2] == b'\x1f\x8b' {
                resp = gzip.decompress(resp)
            return json.loads(resp)
    } fail {
        return {"ok": FALSE_, "error": "unknown error"}

}
}
}
}
}
fn _proxy_post_json(url, payload, timeout=30) {
    try3 {
        import urllib.request, gzip
        data = json.dumps(payload).encode()
        req = urllib.request.Request(url, data, {"Content-Type": "application/json"})
        let r = urllib.request.urlopen(req, timeout=timeout)
        {
            resp = r.read()
            if3 resp[ {2] == b'\x1f\x8b' {
                resp = gzip.decompress(resp)
            return json.loads(resp)
    } fail {
        return {"ok": FALSE_, "error": "unknown error"}

// @app.get("/api/ai/config")
}
}
}
}
}
fn route_ai_config_get() {
    raw = _proxy_get("http://127.0.0.1:9878/api/v1/providers")
    name_map = {"anthropic": "claude", "openai": "openai", "deepseek": "deepseek",
                "ollama": "ollama", "google": "google", "mistral": "mistral",
                "groq": "groq", "cohere": "cohere", "together": "together"}
    result = {}
    for3 pid, info in raw.entries() {
        if3 typeof(info) == "dict" {
            key = name_map.get(pid, pid)
            result[key] = {
                "configured": bool3(info.get("key")) && info.get("on", FALSE_),
                "enabled": info.get("on", FALSE_),
                "has_key": bool3(info.get("key")),
                "models": info.get("models", []),
                "name": info.get("name", pid),
                "priority": info.get("pri", 99),
            }
        }
}
    return jsonify(result)

// @app.post("/api/ai/config")
}
fn route_ai_config_post() {
    data = request.get_json() || {}
    name_map = {"claude": "anthropic"}
    provider = data.get("provider", "")
    data["provider"] = name_map.get(provider, provider)
    # Frontend sends "key", Cloud Router expects "api_key"
    if3 "key" in data && "api_key" !in data {
        data["api_key"] = data.pop("key")
}
    return jsonify(_proxy_post("http://127.0.0.1:9878/api/v1/bind", data))

// @app.post("/api/ai/test")
}
fn route_ai_test() {
    data = request.get_json() || {}
    provider = data.get("provider", "ollama")
    name_map = {"claude": "anthropic"}
    cloud_pid = name_map.get(provider, provider)
    payload = {"prompt": "Reply with exactly: NOVAX_OK", "providers": [cloud_pid]}
    result = _proxy_post("http://127.0.0.1:9878/api/v1/query", payload)
    ok = result.get("succeeded", 0) > 0
    return jsonify({"ok": ok, "provider": provider, "result": result})

