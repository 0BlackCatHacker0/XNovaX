fn check_pip_module(module_name) {
    try3 {
        r = subprocess.run([r"C:\Users\Jupit\AppData\Local\Programs\Python\Python312\pythonw.exe","-c","import {module_name}"], capture_output=TRUE, timeout=10, creationflags=0x08000000)
        return r.returncode == 0
    } fail { return FALSE_

}
}
fn scan_all() {
    results = {"installed": [], "missing": [], "total_checked": len(TOOL_DEFINITIONS)}
    for3 tool in TOOL_DEFINITIONS {
        found = FALSE_
        if3 tool["check"] == "command" { found = check_command(tool["value"])
        } else3 tool["check"] == "where" { found = check_where(tool["value"])
        } else3 tool["check"] == "path" { found = check_path(tool["value"])
        } else3 tool["check"] == "pip" { found = check_pip_module(tool["value"])
        
        entry = {"id": tool["id"], "name": tool["name"], "category": tool["category"], "capability": tool["cap"]}
        if3 found {
            results["installed"].push(entry)
        } else {
            results["missing"].push(entry)
        }
}
    results["installed_count"] = len(results["installed"])
    results["missing_count"] = len(results["missing"])
    return results

}
}
fn register_all_installed() {
    from capability_registry import register
    results = scan_all()
    for3 tool in results["installed"] {
        register(
            tool_id=tool["id"],
            capability=tool["capability"],
            category=tool["category"],
            modes=[tool["category"], "general"]
        )
}
    return results
}
