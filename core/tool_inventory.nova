// import subprocess, os, json, shutil

fn check_command(cmd) {
    try3 {
        subprocess.run([cmd, "--version"], capture_output=TRUE, timeout=5, creationflags=0x08000000)
        return TRUE
    } fail { return FALSE_

}
}
fn check_path(path) {
    return os.path.exists(path)

}
fn check_where(name) {
    try3 {
        r = subprocess.run(["where", name], capture_output=TRUE, timeout=5, text=TRUE, creationflags=0x08000000)
        return r.returncode == 0
    } fail { return FALSE_

