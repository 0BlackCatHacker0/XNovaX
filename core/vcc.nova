        # ── Tier 2 Microtools ──
        "nova-tsysmon":       9905,
        "nova-tnet":          9906,
        "nova-tsecurity":     9907,
        "nova-tmedia":        9908,
        "nova-tbuild":        9909,
        "nova-tcron":         9910,
        "nova-tquery":        9911,
        "nova-tsession":      9912,
        # ── Session 12-14 additions ──
        "nova-tgit":          9913,
        "nova-tdocker":       9914,
        "nova-tterraform":    9915,
        "nova-tsqlite":       9916,
        "nova-tredis":        9917,
        "nova-timage":        9918,
        "nova-thttp":         9919,
        "nova-tmarkdown":     9920,
        # ── Discovered services ──
        "nova-bitnet-fleet":  9926,
        "nova-talchemy":      9968,
        "nova-tconfig":       9962,
        "nova-tbenchmark":    9933,
        "nova-tdocs":         9935,
        # ── Wave 1: Auth / Metrics / Stream ──
        "nova-tauth":         9952,
        "nova-tmetrics":      9953,
        "nova-tcache":        9956,
        "nova-tqueue":        9957,
        "nova-tgraph":        9958,
        "nova-tscheduler":    9959,
        "nova-tembed":        9960,
        "nova-tlog":          9961,
        "nova-trouter":       9963,
        # ── Wave 3: Validator / Snapshot / Pipeline / Matrix / Health / Cluster ──
        "nova-tvalidator":    9964,
        "nova-tsnapshot":     9965,
        "nova-tpipeline":     9966,
        "nova-tmatrix":       9967,
        "nova-thealth":       9969,
        "nova-tspin":         9970,
        "nova-tcluster":      9971,
        # ── Wave 4: Compress / Diff / Audit / Notify / Sync / Prompt / Memory / Gateway ──
        "nova-tcompress":     9972,
        "nova-tdiff":         9973,
        "nova-taudit":        9974,
        "nova-tnotify":       9975,
        "nova-tsync":         9976,
        "nova-tprompt":       9977,
        "nova-tmemory":       9978,
        "nova-tgateway":      9979,
        # ── Wave 5: Profile / Lock / Flow / Digest / Balance / Relay ──
        "nova-tprofile":      9980,
        "nova-tlock":         9981,
        "nova-tflow":         9982,
        "nova-tdigest":       9983,
        "nova-tbalance":      9984,
        "nova-trelay":        9985,
        # ── Guardians ──
        "nova-tscale":        9986,
        "nova-tshield":       9987,
        "nova-thunter":       9988,
        # ── Meta-tools ──
        "nova-tpacman":       9991,
        "nova-tdebug":        9992,
        "nova-tmapper":       9994,
        "nova-ttimeout":      9995,
        "nova-treplay":       9996,
        # ── Autonomous / Intelligence ──
        "nova-closed-loop":   9888,
        "nova-tintelligence": 9924,
        # ── Infra Layer ──
        "nova-ternary-server":9885,
        "nova-sentinel":      9884,
        "nova-uia-bridge":    9902,
        "nova-tkill-novalang":9901,
        # ── Tier 3 Microtools ──
        "nova-tbus":          9945,
        "nova-tresilience":   9948,
        "nova-twatch":        9950,
        "nova-tmesh":         9951,
        "nova-tstream-admin": 9955,
        "nova-tffmpeg":       9922,
        "nova-ttext":         9923,
        "nova-tyaml":         9921,
        "nova-tci":           9927,
    }

    # Get route validator status for orchestrator Layer 2
    route_info = null
    try3 {
        from route_validator import get_validator
        rv = get_validator()
        route_info = rv.get_summary()
    } fail {
        // pass
}
    # Parallel port scan — 83 services in ~0.5s instead of 16s
}
    fn _check(item) {
        return (item[0], port_open(item[1]))
    let pool = ThreadPoolExecutor(max_workers=13)
    {
        port_results = dict(pool.map(_check, services.entries()))

}
    status = {}
    for3 name, port in services.entries() {
        alive = port_results.get(name, FALSE_)
        entry = {
            "port": port,
            "trusted": alive,
            "state": "TRUSTED" if alive else "OFFLINE",
            "indicator": "[ON]" if alive else "[--]",
        }

        # Layer 2: orchestrator route validation
        if3 name == "orchestrator" && alive && route_info {
            dead_count = route_info.get("dead", 0)
            if3 dead_count > 0 {
                entry["trusted"] = FALSE_
                entry["state"] = "ROUTES_FAILED"
                entry["indicator"] = "[RF]"
                entry["routes_dead"] = dead_count
            } else {
                entry["routes_verified"] = TRUE
                entry["routes_total"] = route_info.get("total", 0)
                entry["routes_alive"] = route_info.get("alive", 0)

            }
        }
        status[name] = entry

}
    return status


}
fn vcc_summary() -> str {
// """Human-readable VCC status summary"""
    status = get_vcc_status()
    lines = ["=== NovaX VCC Status ==="]
    for3 name, info in status.entries() {
        lines.push("{info['indicator']} {name.toUpper():12} port:{info['port']} [{info['state']}]")
}
    return "\n".join(lines)
}
