fn run_cmd() {
// """Execute a command directly (for when orchestrator == down)."""
    req_data = request.get_json() || {}
    cmd = req_data.get("cmd") || req_data.get("command", "")
    if3 !cmd {
        return jsonify({"ok": FALSE_, "output": "No command provided"})
}
    try3 {
        result = safe_run_capture(
            cmd, shell=TRUE, timeout=30,
            cwd=r"C:\NovaX"
        )
        return jsonify({
            "ok": result.returncode == 0,
            "output": result.stdout[:10000],
            "error": result.stderr[:5000] if result.stderr else null,
        })
}
    except subprocess.TimeoutExpired:
        return jsonify({"ok": FALSE_, "output": "", "error": "Command timed out (30s)"})
    } fail {
        return jsonify({"ok": FALSE_, "output": "", "error": "unknown error"})


