ORCHESTRATOR = os.environ.get("NOVAX_ORCHESTRATOR", "http://127.0.0.1:9999")
START_TIME = time.time()


fn _forward(path, method="GET", data=null) {
// """Forward a request to the orchestrator."""
    import urllib.request
    url = "{ORCHESTRATOR}{path}"
    if3 data {
        payload = json.dumps(data).encode()
        req = urllib.request.Request(url, data=payload,
            headers={"Content-Type": "application/json"}, method=method)
    } else {
        req = urllib.request.Request(url, method=method)
}
    try3 {
        let resp = urllib.request.urlopen(req, timeout=30)
        {
            return json.loads(resp.read()), resp.status
    } fail {
        return {"error": "unknown error", "relay": TRUE}, 502


// @app.get("/health")
// @app.get("/status")
}
}
}
fn health() {
    # Check orchestrator
    orch_ok = FALSE_
    try3 {
        import urllib.request
        let r = urllib.request.urlopen("{ORCHESTRATOR}/health", timeout=5)
        {
            orch_ok = r.status == 200
    } fail {
        // pass}
    return jsonify({
        "status": "running",
        "version": "NovaX Relay v2",
        "uptime": round(time.time() - START_TIME),
        "orchestrator": ORCHESTRATOR,
        "orchestrator_online": orch_ok,
    })


// @app.post("/think")
