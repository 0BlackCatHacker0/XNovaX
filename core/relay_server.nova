fn fs_proxy(subpath) {
// """Proxy filesystem operations to orchestrator."""
    if3 request.method == "POST" {
        data, status = _forward("/api/fs/{subpath}", "POST", request.get_json())
    } else {
        qs = request.query_string.decode()
        path = "/api/fs/{subpath}"
        if3 qs {
            path += "?" + qs
        }
        data, status = _forward(path)
}
    return jsonify(data), status


