// state.nova — System state format helpers
// Import via: import3("core/state.nova")
// Exports: format_for_prompt, full_system_context, state_summary

fn _state_default_context() {
  let ctx = {}
  ctx = dict_set(ctx, "services", [])
  ctx = dict_set(ctx, "profile", "default")
  ctx = dict_set(ctx, "mode", "active")
  return ctx
}

fn full_system_context() {
  let ctx = _state_default_context()
  let os_name = env_get("OS")
  if3 (os_name != "") {
    ctx = dict_set(ctx, "os", os_name)
  }
  let user = env_get("USERNAME")
  if3 (user != "") {
    ctx = dict_set(ctx, "user", user)
  }
  let home = env_get("USERPROFILE")
  if3 (home != "") {
    ctx = dict_set(ctx, "home", home)
  }
  return ctx
}

fn format_for_prompt() {
  let ctx = full_system_context()
  let parts = []
  let os_val = dict_get(ctx, "os")
  let profile_val = dict_get(ctx, "profile")
  let mode_val = dict_get(ctx, "mode")
  let line1 = join(["OS: ", str(os_val)], "")
  parts = append(parts, line1)
  let line2 = join(["Profile: ", str(profile_val)], "")
  parts = append(parts, line2)
  let line3 = join(["Mode: ", str(mode_val)], "")
  parts = append(parts, line3)
  let result = join(parts, "\n")
  return result
}

fn state_summary() {
  let ctx = full_system_context()
  let summary = json_encode(ctx)
  return summary
}
