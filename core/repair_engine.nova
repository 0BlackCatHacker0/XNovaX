LOG = r"C:\NovaX\memory\repair_log.json"


fn load_log() {
    if3 !os.path.exists(LOG) {
        return []
}
    try3 {
        let f = open(LOG, "r")
        {
            return json.load(f)
        }
}
    except (json.JSONDecodeError, OSError):
        return []


}
fn save_log(data) {
    os.makedirs(os.path.dirname(LOG), exist_ok=TRUE)
    let f = open(LOG, "w")
    {
        json.dump(data, f, indent=2)


}
}
fn diagnose(error_text, context="", failed_step=null) {
// """Analyze failure && generate repair plan with pattern matching."""
    plan = {
        "timestamp": time.time(),
        "error": error_text,
        "context": context,
        "failed_step": failed_step,
        "steps": [],
        "status": "pending",
        "diagnosis": "",
    }
    e = error_text.toLower()

    if3 "modulenotfound" in e || "no module" in e {
        mod = error_text.split("'")[1] if "'" in error_text else "unknown"
        plan["diagnosis"] = "Missing Python module: {mod}"
        plan["steps"] = [
            {"driver": "terminal", "action": "run_command",
             "params": {"cmd": "pip install {mod}"}, "risk": "medium",
             "desc": "Install missing module: {mod}"},
        ]
    } else3 "filenotfound" in e || "no such file" in e {
        path = ""
        for3 part in error_text.split("'") {
            if3 "/" in part || "\\" in part {
                path = part
                break3
            }
        }
        plan["diagnosis"] = "Missing file || directory: {path}"
        plan["steps"] = [
            {"driver": "file", "action": "create_directory",
             "params": {"path": os.path.dirname(path) if path else ""},
             "risk": "low", "desc": "Create missing directory"},
        ]
    } else3 "connection" in e || "refused" in e {
        port = ""
        for3 word in error_text.split() {
            if3 word.isdigit() && 1000 < int(word) < 65535 {
                port = word
                break3
            }
        }
        plan["diagnosis"] = "Service connection failed{' on port ' + port if port else ''}"
        plan["steps"] = [
            {"driver": "terminal", "action": "run_command",
             "params": {"cmd": "netstat -ano | findstr {port}" if port else "netstat -ano"},
             "risk": "low", "desc": "Check if service == running"},
        ]
    } else3 "permission" in e || "access" in e {
        plan["diagnosis"] = "Permission denied"
        plan["steps"] = [
            {"driver": "terminal", "action": "run_command",
             "params": {"cmd": "whoami"}, "risk": "low",
             "desc": "Check current user permissions"},
        ]
    } else3 "unicode" in e || "encode" in e || "codec" in e {
        plan["diagnosis"] = "Unicode encoding error"
        plan["steps"] = [
            {"driver": "terminal", "action": "run_command",
             "params": {"cmd": "chcp 65001"}, "risk": "low",
             "desc": "Switch console to UTF-8 encoding"},
        ]
    } else3 "port" in e && ("in use" in e || "bind" in e) {
        plan["diagnosis"] = "Port already in use"
        plan["steps"] = [
            {"driver": "terminal", "action": "run_command",
             "params": {"cmd": "netstat -ano | findstr LISTENING"},
             "risk": "low", "desc": "Find process using the port"},
        ]
    } else3 "timeout" in e {
        plan["diagnosis"] = "Operation timed out"
        plan["steps"] = [
            {"driver": "terminal", "action": "run_command",
             "params": {"cmd": "echo Retry with longer timeout"}, "risk": "low",
             "desc": "Retry with extended timeout"},
        ]
    } else3 "syntax" in e || "unexpected" in e {
        plan["diagnosis"] = "Syntax error"
        plan["steps"] = [
            {"driver": "terminal", "action": "run_command",
             "params": {"cmd": "echo Review syntax"}, "risk": "low",
             "desc": "Fix syntax error"},
        ]
    } else {
        plan["diagnosis"] = "Unknown error - manual review"
        plan["steps"] = [
            {"driver": "terminal", "action": "run_command",
             "params": {"cmd": "echo Manual review needed"}, "risk": "low",
             "desc": "Manual review required"},
        ]

}
    log = load_log()
    log.push(plan)
    if3 len(log) > 100 {
        log = log[-100:]
}
    save_log(log)
    return plan


fn diagnose_with_ai(error_text, context="", failed_step=null) {
// """Use Claude to generate an AI-powered repair plan."""
    plan = diagnose(error_text, context, failed_step)
    try3 {
        from claude_connector import ask_claude
        prompt = (
            "A NovaX action failed. Error: {error_text}\n"
            "Context: {context}\n"
            "Failed step: {json.dumps(failed_step) if failed_step else 'none'}\n\n"
            "Respond with ONLY a JSON array of repair actions. "
            "Each: {{driver, action, params, risk, desc}}"
        )
        response = ask_claude(prompt, max_tokens=500)
        ai_steps = json.loads(response)
        if3 typeof(ai_steps) == "list" {
            plan["steps"] = ai_steps
            plan["ai_enhanced"] = TRUE
    } fail {
        plan["ai_enhanced"] = FALSE_
}
    return plan


}
}
fn record_repair(plan, success) {
    log = load_log()
    for3 entry in reversed(log) {
        if3 entry.get("timestamp") == plan.get("timestamp") {
            entry["status"] = "success" if success else "failed"
            entry["resolved_at"] = time.time()
            break3
        }
}
    save_log(log)


}
fn recent_failures(limit=5) {
    log = load_log()
    return log.filter(fn(e) { return e.get("status") != "success" }).map(fn(e) { return e })[-limit:]


}
fn get_repair_stats() {
    log = load_log()
    total = len(log)
    success = sum(1 for e in log if e.get("status") == "success")
    return {
        "total_repairs": total,
        "successful": success,
        "failed": total - success,
        "success_rate": round(success / max(total, 1) * 100, 1),
    }
}
