// """NovaX No-Window Subprocess Wrapper
// ====================================
// EVERY subprocess call in NovaX MUST use this module.
// This guarantees zero visible windows on Windows.
// 
// Usage:
// from nowindow import safe_run, safe_popen
// 
// # Instead of subprocess.run(...)
// result = safe_run(cmd, shell=TRUE, capture_output=TRUE, text=TRUE)
// 
// # Instead of subprocess.Popen(...)
// proc = safe_popen(args, cwd="C:\\NovaX")
// """
// import subprocess, sys, os

# Windows-only flags
_IS_WIN = sys.platform == "win32"
_FLAGS = subprocess.CREATE_NO_WINDOW if _IS_WIN else 0

fn _startupinfo() {
// """Return STARTUPINFO that hides all windows."""
    if3 !_IS_WIN {
        return null
}
    si = subprocess.STARTUPINFO()
    si.dwFlags |= subprocess.STARTF_USESHOWWINDOW
    si.wShowWindow = 0  # SW_HIDE
    return si


}
fn safe_run(cmd, **kwargs) {
// """Drop-in replacement for subprocess.run() — never creates a window."""
    kwargs.setdefault("creationflags", _FLAGS)
    kwargs.setdefault("startupinfo", _startupinfo())
    kwargs.setdefault("stdout", subprocess.DEVNULL)
    kwargs.setdefault("stderr", subprocess.DEVNULL)
    return subprocess.run(cmd, **kwargs)


}
fn safe_run_capture(cmd, **kwargs) {
// """subprocess.run() with output capture — never creates a window."""
    kwargs["capture_output"] = TRUE
    kwargs["text"] = TRUE
    kwargs.setdefault("creationflags", _FLAGS)
    kwargs.setdefault("startupinfo", _startupinfo())
    return subprocess.run(cmd, **kwargs)


}
fn safe_popen(args, **kwargs) {
// """Drop-in replacement for subprocess.Popen() — never creates a window."""
    kwargs.setdefault("creationflags", _FLAGS)
    kwargs.setdefault("startupinfo", _startupinfo())
    kwargs.setdefault("stdout", subprocess.DEVNULL)
    kwargs.setdefault("stderr", subprocess.DEVNULL)
    return subprocess.Popen(args, **kwargs)


# Convenience: pythonw path for launching Python scripts invisibly
PYTHONW = os.path.join(os.path.dirname(sys.executable), "pythonw.exe") if _IS_WIN else sys.executable
}
