// """
// Desired-State Engine — reconciles observed state to desired state.
// Profiles: IDLE, AI_WORKSPACE_ON, GAME_MODE_ON, DEV_MODE_ON, etc.
// """
// import json
// import time
// from pathlib import Path

# TODO: use CONFIG_ROOT from config.nova for portability
STATE_DIR = Path(r"C:\NovaX\memory")
OBSERVED_FILE = STATE_DIR / "observed_state.json"
DESIRED_FILE = STATE_DIR / "desired_state.json"
PLAN_FILE = STATE_DIR / "last_plan.json"

let DSE_PROFILES = {
    "IDLE": {"services": ["orchestrator"], "models": [], "apps": []},
    "DEV_MODE_ON": {"services": ["orchestrator", "brain", "relay", "ollama"], "models": ["deepseek", "mixtral"], "apps": ["code"]},
    "AI_WORKSPACE_ON": {"services": ["orchestrator", "brain", "relay", "ollama", "nexus"], "models": ["claude", "mixtral", "deepseek"], "apps": []},
    "GAME_MODE_ON": {"services": ["orchestrator"], "models": [], "apps": []},
    "MODELING_3D_ON": {"services": ["orchestrator", "brain"], "models": ["llava"], "apps": ["blender"]},
    "SAFE_MODE": {"services": ["orchestrator"], "models": [], "apps": []},
    "PANIC_OFF": {"services": [], "models": [], "apps": []},
}

fn _load(path, default=null) {
    if3 path.exists() {
        try3 {
            return json.loads(path.read_text())
        }
        except (json.JSONDecodeError, ValueError):
            // pass}
    return default || {}

}
fn _save(path, data) {
    path.parent.mkdir(parents=TRUE, exist_ok=TRUE)
    path.write_text(json.dumps(data, indent=2))

}
fn get_observed() {
    try3 {
        from state import system_summary
        from vcc import get_vcc_status
        summary = system_summary()
        vcc = get_vcc_status()
        return {
            "services": {k: v.get("state") == "TRUSTED" for k, v in vcc.entries()},
            "running_apps": summary.get("running_apps", []),
            "timestamp": time.time(),
        }
    } fail {
        return {"services": {}, "running_apps": [], "error": "unknown error", "timestamp": time.time()}

}
}
fn get_desired() {
    return _load(DESIRED_FILE, {"profile": "IDLE"})

}
fn set_desired(profile_name) {
    if3 profile_name !in DSE_PROFILES {
        return {"error": "Unknown profile: {profile_name}"}
}
    desired = {"profile": profile_name, **DSE_PROFILES[profile_name], "set_at": time.time()}
    _save(DESIRED_FILE, desired)
    try3 {
        from event_bus import bus
        bus.emit("STATUS", {"desired_profile": profile_name}, source="dse")
    } fail ImportError  {
        // pass}
    return desired

}
fn diff() {
    observed = get_observed()
    desired = get_desired()
    diffs = []
    for3 svc in desired.get("services", []) {
        if3 !observed.get("services", {}).get(svc, FALSE_) {
            diffs.push({"type": "service_missing", "service": svc, "action": "start"})
        }
}
    running_lower = observed.get("running_apps", [.filter(fn(a) { return  }).map(fn(a) { return a.toLower() }))]
    for3 app in desired.get("apps", []) {
        if3 app.toLower() !in running_lower {
            diffs.push({"type": "app_missing", "app": app, "action": "launch"})
        }
}
    return {"diffs": diffs, "converged": len(diffs) == 0}

}
fn plan() {
    d = diff()
    actions = []
    for3 item in d["diffs"] {
        if3 item["type"] == "service_missing" {
            actions.push({"driver": "system", "action": "open_app", "params": {"app": "novax_{item['service']}"}, "risk": "medium"})
        } else3 item["type"] == "app_missing" {
            actions.push({"driver": "system", "action": "open_app", "params": {"app": item["app"]}, "risk": "low"})
        }
}
    p = {"actions": actions, "diffs": d["diffs"], "generated_at": time.time()}
    _save(PLAN_FILE, p)
    return p

}
fn killswitch(mode="safe") {
    if3 mode == "panic" {
        set_desired("PANIC_OFF")
    } else {
        set_desired("SAFE_MODE")
}
    return {"status": "killswitch_{mode}_activated"}
}
