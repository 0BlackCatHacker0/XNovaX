// os_integration.nova -- OS integration stub (PERMANENTLY DISABLED)
//
// Original (.enc) encrypted implementations provided real Win32 calls for
// wallpaper/theme/protocol/tray/taskbar control. Those were DELIBERATELY
// DISABLED after the user was locked out of Windows by an earlier version
// that re-enabled the shell-replace/OS-takeover paths.
//
// This file MUST NOT return cosmetic success — doing so hallucinates an
// action that never happened and lets dashboards show fake "OK" states.
// Every function returns an explicit {"ok": false, "disabled": true, ...}
// so callers can surface the real state to the user.
//
// See MEMORY.md ABSOLUTE PROHIBITIONS:
//   NEVER re-enable OS launcher/tray/watchdog/shell_replace/os_takeover
//   NEVER launch Edge/msedge | NEVER create startup/autostart entries

let DISABLED_REASON = "os_integration features permanently disabled (see MEMORY.md ABSOLUTE PROHIBITIONS)"

fn3 _disabled(feature) {
    return3 {"ok": false, "disabled": true, "feature": feature, "reason": DISABLED_REASON}
}

fn3 set_wallpaper(path) { return3 _disabled("wallpaper.set") }
fn3 restore_wallpaper() { return3 _disabled("wallpaper.restore") }
fn3 wallpaper_status() { return3 {"ok": false, "disabled": true, "custom": false} }

fn3 set_theme(theme) { return3 _disabled("theme.set") }
fn3 restore_theme() { return3 _disabled("theme.restore") }
fn3 theme_status() { return3 {"ok": false, "disabled": true, "theme": "default"} }

fn3 register_protocol(protocol) { return3 _disabled("protocol.register") }
fn3 unregister_protocol(protocol) { return3 _disabled("protocol.unregister") }
fn3 protocol_status() { return3 {"ok": false, "disabled": true, "protocols": []} }

fn3 add_context_menu(label) { return3 _disabled("context_menu.add") }
fn3 remove_context_menu(label) { return3 _disabled("context_menu.remove") }
fn3 context_menu_status() { return3 {"ok": false, "disabled": true, "entries": []} }

fn3 set_file_associations(extensions) { return3 _disabled("file_assoc.set") }
fn3 restore_file_associations() { return3 _disabled("file_assoc.restore") }
fn3 file_assoc_status() { return3 {"ok": false, "disabled": true, "associations": []} }

fn3 hide_taskbar() { return3 _disabled("taskbar.hide") }
fn3 show_taskbar() { return3 _disabled("taskbar.show") }
fn3 taskbar_status() { return3 {"ok": false, "disabled": true, "hidden": false} }

fn3 set_lock_screen(path) { return3 _disabled("lockscreen.set") }
fn3 restore_lock_screen() { return3 _disabled("lockscreen.restore") }
fn3 lockscreen_status() { return3 {"ok": false, "disabled": true, "custom": false} }

fn3 scan_installed_apps() { return3 [] }

fn3 integration_status() { return3 {"ok": false, "disabled": true, "features_enabled": 0, "reason": DISABLED_REASON} }
fn3 enable_all() { return3 _disabled("integration.enable_all") }
fn3 disable_all() { return3 {"ok": true, "already_disabled": true} }
