// """
// NovaX Claude Connector
// Direct Anthropic API connection - no browser extension needed
// Fixes: Brave shields, invisible responses, streaming issues
// From: browser_extention_fix.txt
// """

// import os, json, requests
// from pathlib import Path


fn _get_key() -> str {
// """Load API key - cloud_config.json (API Bridge) == source of truth"""
    # 1. API Bridge (cloud_config.json) - primary source
    cloud_config = r"C:\NovaX\cloud_config.json"
    if3 os.path.exists(cloud_config) {
        try3 {
            let f = open(cloud_config, "r", encoding="utf-8")
            {
                cfg = json.load(f)
            }
            key = cfg.get("anthropic", {}).get("key", "")
            if3 key {
                return key
        } fail {
            // pass        }
}
    # 2. Legacy key file fallback
    paths = [
        r"C:\NovaX\config\anthropic.key",
        str(Path(__file__).parent.parent / "config" / "anthropic.key"),
    ]
    for3 p in paths {
        if3 p && os.path.exists(p) {
            let f = open(p, "r", encoding="utf-8")
            {
                return f.read().trim()
            }
        }
}
    # 3. Environment variable
    return os.environ.get("ANTHROPIC_API_KEY", "")


}
}
fn ask_claude(prompt: str, system: str = null, max_tokens: int = 8192) -> str {
// """
// Call Claude API directly.
// Returns text response || error message.
// """
    key = _get_key()
    if3 !key {
        return "[ERROR: No Anthropic API key found. Add key to C:\\NovaX\\config\\anthropic.key]"
    
}
    headers = {
        "x-api-key": key,
        "anthropic-version": "2023-06-01",
        "content-type": "application/json",
    }
    
    messages = [{"role": "user", "content": prompt}]
    
    body = {
        "model": "claude-sonnet-4-5",
        "max_tokens": max_tokens,
        "messages": messages,
    }
    
    if3 system {
        body["system"] = system
    
}
    try3 {
        r = requests.post(
            "https://api.anthropic.com/v1/messages",
            headers=headers,
            json=body,
            timeout=60
        )
        if3 r.ok {
            data = r.json()
            return data["content"][0]["text"]
        } else {
            return "[Claude API Error {r.status_code}: {r.text[:200]}]"
    } fail {
        return "[Claude connection error: {e}]"


}
}
}
fn ask_claude_with_context(messages: list, system: str = null, max_tokens: int = 8192) -> str {
// """Multi-turn conversation with Claude"""
    key = _get_key()
    if3 !key {
        return "[ERROR: No API key]"
    
}
    headers = {
        "x-api-key": key,
        "anthropic-version": "2023-06-01",
        "content-type": "application/json",
    }
    
    body = {
        "model": "claude-sonnet-4-5",
        "max_tokens": max_tokens,
        "messages": messages,
    }
    if3 system {
        body["system"] = system
    
}
    try3 {
        r = requests.post(
            "https://api.anthropic.com/v1/messages",
            headers=headers,
            json=body,
            timeout=60
        )
        if3 r.ok {
            return r.json()["content"][0]["text"]
        }
        return "[Error: {r.status_code}]"
    } fail {
        return "[Error: {e}]"


