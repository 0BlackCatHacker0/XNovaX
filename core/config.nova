// config.nova — Configuration via env_get
// Import via: import3("core/config.nova")
// Exports: config_get, config_root, config_port, config_version, config_load

let CONFIG_ROOT = "C:/NovaX"
let CONFIG_DATA_DIR = "C:/NovaX/data"
let CONFIG_MEMORY_DIR = "C:/NovaX/memory"
let CONFIG_CORE_DIR = "C:/NovaX/core"
let CONFIG_PORT = 9999
let CONFIG_DEBUG = 0
let CONFIG_VERSION = "5.0.0"
let CONFIG_HOST = "0.0.0.0"

fn config_get(key, default_val) {
  let env_key = join(["NOVAX_", key], "")
  let val = env_get(env_key)
  if3 (val != "") {
    return val
  }
  return default_val
}

fn config_set(key, value) {
  return 1
}

fn config_root() {
  return CONFIG_ROOT
}

fn config_port() {
  return CONFIG_PORT
}

fn config_version() {
  return CONFIG_VERSION
}

fn config_host() {
  return CONFIG_HOST
}

fn config_debug() {
  return CONFIG_DEBUG
}

fn config_load() {
  let result = {}
  result = dict_set(result, "port", CONFIG_PORT)
  result = dict_set(result, "debug", CONFIG_DEBUG)
  result = dict_set(result, "version", CONFIG_VERSION)
  result = dict_set(result, "host", CONFIG_HOST)
  result = dict_set(result, "root", CONFIG_ROOT)
  return result
}

fn config_data_dir() {
  return CONFIG_DATA_DIR
}

fn config_memory_dir() {
  return CONFIG_MEMORY_DIR
}

fn config_core_dir() {
  return CONFIG_CORE_DIR
}
