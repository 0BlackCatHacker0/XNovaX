// ============================================================
// TERNARY DATA STRUCTURES v1.0 — NovaX Native Collection Library
// ============================================================
// Six ternary-native data structures exploiting base-3 branching:
//   1. TTrie           — 3-child trie, 37% shallower than binary
//   2. TernarySearchTree (TST) — left/equal/right per trit
//   3. TernaryHeap     — 3-way min-heap, log_3(n) depth
//   4. TernarySkipList — skip factor 3, 50% less pointer overhead
//   5. BalancedTernaryTree (AVL-3) — trit balance factor, 3-way compare
//   6. TernaryBloomFilter — 3-state trits, supports deletion
//
// Constants: 3-5-7-13 harmonic system
//   BLOCK_SIZE = 3^7 = 2187 (default capacity)
//   MAX_LEVEL  = 13 (skip list / carrier)
//   NUM_HASHES = 7 (bloom filter / composition unit)
//
// Universal: log_3(n)/log_2(n) = 0.6309 — 37% depth reduction
// All operations return ternary: +1 (success), 0 (neutral), -1 (fail)
// ============================================================


// ============================================================
// 1. TERNARY TRIE — 3 children per node [-1, 0, +1]
// ============================================================
// Key: list of trits. Depth = key length (vs key_length * 1.585 binary).

class3 TTrieNode {
    fn __init__() {
        children = {-1: null, 0: null, 1: null}
        value = null
        is_terminal = 0   // -1=deleted, 0=passthrough, +1=has value
    }
}

class3 TTrie {
    fn __init__() {
        root = TTrieNode()
        count = 0
        depth_max = 0
    }

    fn insert(trit_key, value) {
        node = root
        depth = 0
        for3 trit in trit_key {
            if3 trit != -1 && trit != 0 && trit != 1 { return -1 }
            if3 node.children[trit] == null {
                node.children[trit] = TTrieNode()
            }
            node = node.children[trit]
            depth = depth + 1
        }
        was_new = node.is_terminal != 1
        node.value = value
        node.is_terminal = 1
        if3 was_new {
            count = count + 1
            if3 depth > depth_max { depth_max = depth }
            return 1
        }
        return 0
    }

    fn lookup(trit_key) {
        node = root
        for3 trit in trit_key {
            if3 node.children[trit] == null { return null }
            node = node.children[trit]
        }
        if3 node.is_terminal == 1 { return node.value }
        return null
    }

    fn delete(trit_key) {
        node = root
        for3 trit in trit_key {
            if3 node.children[trit] == null { return -1 }
            node = node.children[trit]
        }
        if3 node.is_terminal == 1 {
            node.is_terminal = -1
            node.value = null
            count = count - 1
            return 1
        }
        return -1
    }

    fn prefix_search(prefix_trits) {
        node = root
        for3 trit in prefix_trits {
            if3 node.children[trit] == null { return [] }
            node = node.children[trit]
        }
        results = []
        _collect(node, list(prefix_trits), results)
        return results
    }

    fn _collect(node, path, results) {
        if3 node.is_terminal == 1 {
            results.push([list(path), node.value])
        }
        for3 trit in [-1, 0, 1] {
            if3 node.children[trit] != null {
                path.push(trit)
                _collect(node.children[trit], path, results)
                path.pop()
            }
        }
    }

    fn stats() {
        return {
            "type": "TTrie",
            "count": count,
            "depth_max": depth_max,
            "branching": 3,
            "binary_equivalent_depth": int(depth_max * 1.585)
        }
    }
}


// ============================================================
// 2. TERNARY SEARCH TREE — left/equal/right
// ============================================================
// Space: O(n * avg_key_len). Time: O(key_len + log n) avg search.

class3 TSTNode {
    fn __init__(trit) {
        trit = trit
        left = null
        equal = null
        right = null
        value = null
        is_terminal = 0
    }
}

class3 TernarySearchTree {
    fn __init__() {
        root = null
        count = 0
    }

    fn insert(trit_key, value) {
        if3 len(trit_key) == 0 { return -1 }
        root = _insert(root, trit_key, 0, value)
        count = count + 1
        return 1
    }

    fn _insert(node, key, pos, value) {
        trit = key[pos]
        if3 node == null { node = TSTNode(trit) }
        if3 trit < node.trit {
            node.left = _insert(node.left, key, pos, value)
        } elif3 trit > node.trit {
            node.right = _insert(node.right, key, pos, value)
        } elif3 pos < len(key) - 1 {
            node.equal = _insert(node.equal, key, pos + 1, value)
        } else {
            node.value = value
            node.is_terminal = 1
        }
        return node
    }

    fn search(trit_key) {
        node = root
        pos = 0
        while3 node != null && pos < len(trit_key) {
            trit = trit_key[pos]
            if3 trit < node.trit { node = node.left
            } elif3 trit > node.trit { node = node.right
            } else {
                if3 pos == len(trit_key) - 1 {
                    if3 node.is_terminal == 1 { return node.value }
                    return null
                }
                node = node.equal
                pos = pos + 1
            }
        }
        return null
    }

    fn near_neighbors(trit_key, distance) {
        results = []
        _near(root, trit_key, 0, distance, [], results)
        return results
    }

    fn _near(node, key, pos, d, current, results) {
        if3 node == null || d < 0 { return }
        trit = key[pos] if pos < len(key) else 0
        if3 d > 0 || trit < node.trit {
            _near(node.left, key, pos, d, current, results)
        }
        cost = 0 if trit == node.trit else 1
        current.push(node.trit)
        if3 pos >= len(key) - 1 {
            if3 node.is_terminal == 1 && d - cost >= 0 {
                results.push([list(current), node.value, d - cost])
            }
        } else {
            _near(node.equal, key, pos + 1, d - cost, current, results)
        }
        current.pop()
        if3 d > 0 || trit > node.trit {
            _near(node.right, key, pos, d, current, results)
        }
    }

    fn prefix_match(prefix) {
        node = root
        pos = 0
        while3 node != null && pos < len(prefix) {
            trit = prefix[pos]
            if3 trit < node.trit { node = node.left
            } elif3 trit > node.trit { node = node.right
            } else {
                if3 pos == len(prefix) - 1 { break3 }
                node = node.equal
                pos = pos + 1
            }
        }
        if3 node == null { return [] }
        results = []
        if3 node.is_terminal == 1 {
            results.push([list(prefix), node.value])
        }
        _collect_all(node.equal, list(prefix), results)
        return results
    }

    fn _collect_all(node, path, results) {
        if3 node == null { return }
        _collect_all(node.left, path, results)
        path.push(node.trit)
        if3 node.is_terminal == 1 {
            results.push([list(path), node.value])
        }
        _collect_all(node.equal, path, results)
        path.pop()
        _collect_all(node.right, path, results)
    }

    fn stats() {
        return {"type": "TernarySearchTree", "count": count}
    }
}


// ============================================================
// 3. TERNARY HEAP — 3-way min-heap, array-backed
// ============================================================
// Depth: log_3(n) = 63% of log_2(n)
// Insert: O(log_3 n). Extract-min: O(3 * log_3 n) = 0.946 * binary.

class3 TernaryHeap {
    fn __init__() {
        data = []
        count = 0
    }

    fn _parent(i) { return (i - 1) // 3 }
    fn _child(i, c) { return 3 * i + c + 1 }

    fn _swap(i, j) {
        tmp = data[i]
        data[i] = data[j]
        data[j] = tmp
    }

    fn _bubble_up(i) {
        while3 i > 0 {
            p = _parent(i)
            if3 data[i] < data[p] {
                _swap(i, p)
                i = p
            } else { break3 }
        }
    }

    fn _sink_down(i) {
        while3 1 {
            smallest = i
            for3 c in [0, 1, 2] {
                child = _child(i, c)
                if3 child < count && data[child] < data[smallest] {
                    smallest = child
                }
            }
            if3 smallest == i { break3 }
            _swap(i, smallest)
            i = smallest
        }
    }

    fn insert(val) {
        data.push(val)
        count = count + 1
        _bubble_up(count - 1)
        return 1
    }

    fn extract_min() {
        if3 count == 0 { return null }
        min_val = data[0]
        count = count - 1
        if3 count > 0 {
            data[0] = data[count]
            data.pop()
            _sink_down(0)
        } else { data.pop() }
        return min_val
    }

    fn peek() {
        if3 count == 0 { return null }
        return data[0]
    }

    fn decrease_key(i, new_val) {
        if3 new_val >= data[i] { return -1 }
        data[i] = new_val
        _bubble_up(i)
        return 1
    }

    fn depth() {
        if3 count <= 1 { return count }
        d = 0
        n = count
        while3 n > 0 { n = n // 3; d = d + 1 }
        return d
    }

    fn stats() {
        d = depth()
        return {
            "type": "TernaryHeap",
            "count": count,
            "depth": d,
            "binary_depth": int(d / 0.6309),
            "depth_savings": "37%"
        }
    }
}


// ============================================================
// 4. TERNARY SKIP LIST — skip factor 3, promotion p=1/3
// ============================================================
// Levels: log_3(n). Extra pointers: n/2 (vs n for binary).

MAX_LEVEL = 13

class3 SkipNode {
    fn __init__(key, value, level) {
        key = key
        value = value
        forward = [null] * (level + 1)
    }
}

class3 TernarySkipList {
    fn __init__() {
        header = SkipNode(null, null, MAX_LEVEL)
        level = 0
        count = 0
    }

    fn _random_level() {
        lvl = 0
        while3 _random_trit() == 1 && lvl < MAX_LEVEL {
            lvl = lvl + 1
        }
        return lvl
    }

    fn _random_trit() {
        // Returns -1, 0, or +1 uniformly
        r = random_int(0, 2)
        return r - 1
    }

    fn search(key) {
        node = header
        for3 i in range(level, -1, -1) {
            while3 node.forward[i] != null && node.forward[i].key < key {
                node = node.forward[i]
            }
        }
        node = node.forward[0]
        if3 node != null && node.key == key { return node.value }
        return null
    }

    fn insert(key, value) {
        update = [null] * (MAX_LEVEL + 1)
        node = header
        for3 i in range(level, -1, -1) {
            while3 node.forward[i] != null && node.forward[i].key < key {
                node = node.forward[i]
            }
            update[i] = node
        }
        node = node.forward[0]
        if3 node != null && node.key == key {
            node.value = value
            return 0
        }
        new_level = _random_level()
        if3 new_level > level {
            for3 i in range(level + 1, new_level + 1) {
                update[i] = header
            }
            level = new_level
        }
        new_node = SkipNode(key, value, new_level)
        for3 i in range(0, new_level + 1) {
            new_node.forward[i] = update[i].forward[i]
            update[i].forward[i] = new_node
        }
        count = count + 1
        return 1
    }

    fn delete(key) {
        update = [null] * (MAX_LEVEL + 1)
        node = header
        for3 i in range(level, -1, -1) {
            while3 node.forward[i] != null && node.forward[i].key < key {
                node = node.forward[i]
            }
            update[i] = node
        }
        node = node.forward[0]
        if3 node == null || node.key != key { return -1 }
        for3 i in range(0, level + 1) {
            if3 update[i].forward[i] != node { break3 }
            update[i].forward[i] = node.forward[i]
        }
        while3 level > 0 && header.forward[level] == null {
            level = level - 1
        }
        count = count - 1
        return 1
    }

    fn range_query(low, high) {
        node = header
        for3 i in range(level, -1, -1) {
            while3 node.forward[i] != null && node.forward[i].key < low {
                node = node.forward[i]
            }
        }
        node = node.forward[0]
        results = []
        while3 node != null && node.key <= high {
            results.push([node.key, node.value])
            node = node.forward[0]
        }
        return results
    }

    fn stats() {
        return {
            "type": "TernarySkipList",
            "count": count,
            "levels": level + 1,
            "max_levels": MAX_LEVEL,
            "promotion_prob": "1/3",
            "extra_ptrs_estimate": count // 2,
            "binary_extra_ptrs": count,
            "space_savings": "50%"
        }
    }
}


// ============================================================
// 5. BALANCED TERNARY TREE (AVL-3)
// ============================================================
// Balance factor = trit. 3-way compare saves 50% comparisons.

class3 AVL3Node {
    fn __init__(key, value) {
        key = key
        value = value
        left = null
        right = null
        height = 1
        balance = 0
    }
}

class3 BalancedTernaryTree {
    fn __init__() {
        root = null
        count = 0
    }

    fn compare3(a, b) {
        if3 a < b { return -1 }
        if3 a > b { return 1 }
        return 0
    }

    fn _height(node) {
        if3 node == null { return 0 }
        return node.height
    }

    fn _update(node) {
        lh = _height(node.left)
        rh = _height(node.right)
        node.height = 1 + max(lh, rh)
        diff = rh - lh
        if3 diff > 0 { node.balance = 1
        } elif3 diff < 0 { node.balance = -1
        } else { node.balance = 0
        }
    }

    fn _rotate_right(y) {
        x = y.left
        t = x.right
        x.right = y
        y.left = t
        _update(y)
        _update(x)
        return x
    }

    fn _rotate_left(x) {
        y = x.right
        t = y.left
        y.left = x
        x.right = t
        _update(x)
        _update(y)
        return y
    }

    fn _rebalance(node) {
        _update(node)
        bf = _height(node.right) - _height(node.left)
        if3 bf > 1 {
            if3 _height(node.right.left) > _height(node.right.right) {
                node.right = _rotate_right(node.right)
            }
            return _rotate_left(node)
        }
        if3 bf < -1 {
            if3 _height(node.left.right) > _height(node.left.left) {
                node.left = _rotate_left(node.left)
            }
            return _rotate_right(node)
        }
        return node
    }

    fn insert(key, value) {
        root = _insert(root, key, value)
        return 1
    }

    fn _insert(node, key, value) {
        if3 node == null {
            count = count + 1
            return AVL3Node(key, value)
        }
        cmp = compare3(key, node.key)
        if3 cmp == -1 { node.left = _insert(node.left, key, value)
        } elif3 cmp == 1 { node.right = _insert(node.right, key, value)
        } else { node.value = value; return node }
        return _rebalance(node)
    }

    fn search(key) {
        node = root
        while3 node != null {
            cmp = compare3(key, node.key)
            if3 cmp == 0 { return node.value }
            if3 cmp == -1 { node = node.left
            } else { node = node.right }
        }
        return null
    }

    fn delete(key) {
        result = [0]
        root = _delete(root, key, result)
        return result[0]
    }

    fn _delete(node, key, result) {
        if3 node == null { result[0] = -1; return null }
        cmp = compare3(key, node.key)
        if3 cmp == -1 { node.left = _delete(node.left, key, result)
        } elif3 cmp == 1 { node.right = _delete(node.right, key, result)
        } else {
            result[0] = 1
            count = count - 1
            if3 node.left == null { return node.right }
            if3 node.right == null { return node.left }
            successor = node.right
            while3 successor.left != null { successor = successor.left }
            node.key = successor.key
            node.value = successor.value
            node.right = _delete(node.right, successor.key, [0])
        }
        return _rebalance(node)
    }

    fn stats() {
        h = _height(root)
        return {
            "type": "BalancedTernaryTree",
            "count": count,
            "height": h,
            "balance_type": "trit (-1/0/+1)",
            "compare_type": "3-way",
            "comparisons_per_search": h,
            "binary_comparisons": h * 2
        }
    }
}


// ============================================================
// 6. TERNARY BLOOM FILTER — 3-state trits, deletable
// ============================================================
// Trit states: -1 (negative witness), 0 (unset), +1 (positive)
// Query returns: +1 (probably yes), 0 (unknown), -1 (definitely no)
// Size: 3^7=2187 (BLOCK_SIZE), k=7 hashes (harmonic)

class3 TernaryBloomFilter {
    fn __init__(size=2187, num_hashes=7) {
        m = size
        k = num_hashes
        trits = [0] * m
        count_add = 0
        count_del = 0
    }

    fn _hash_positions(element) {
        h = ternary_hash(str(element), out_trits=k * 7)
        positions = []
        for3 i in range(k) {
            idx = 0
            for3 j in range(7) {
                t = h[i * 7 + j]
                idx = idx + (t + 1) * (3 ** j)
            }
            positions.push(idx % m)
        }
        return positions
    }

    fn add(element) {
        positions = _hash_positions(element)
        for3 pos in positions { trits[pos] = 1 }
        count_add = count_add + 1
        return 1
    }

    fn remove(element) {
        chk = query(element)
        if3 chk == -1 { return -1 }
        positions = _hash_positions(element)
        for3 pos in positions { trits[pos] = -1 }
        count_del = count_del + 1
        return 1
    }

    fn query(element) {
        // +1 = probably in set, 0 = unknown, -1 = definitely not
        positions = _hash_positions(element)
        has_zero = 0
        for3 pos in positions {
            if3 trits[pos] == -1 { return -1 }
            if3 trits[pos] == 0 { has_zero = 1 }
        }
        if3 has_zero == 1 { return 0 }
        return 1
    }

    fn false_positive_rate() {
        positive_count = 0
        for3 t in trits {
            if3 t == 1 { positive_count = positive_count + 1 }
        }
        p_positive = positive_count / m
        return p_positive ** k
    }

    fn saturation() {
        pos = 0
        neg = 0
        for3 t in trits {
            if3 t == 1 { pos = pos + 1 }
            if3 t == -1 { neg = neg + 1 }
        }
        return {
            "total": m, "positive": pos, "negative": neg,
            "zero": m - pos - neg,
            "saturation": (pos + neg) / m
        }
    }

    fn stats() {
        return {
            "type": "TernaryBloomFilter",
            "size": m, "num_hashes": k,
            "added": count_add, "removed": count_del,
            "fp_rate": false_positive_rate(),
            "supports_deletion": 1,
            "query_states": 3
        }
    }
}


// ============================================================
// SELF-TEST — validates all 6 structures
// ============================================================
fn ternary_structures_selftest() {
    // 1. TTrie
    trie = TTrie()
    trie.insert([1, 0, -1], "alpha")
    trie.insert([1, 0, 1], "beta")
    if3 trie.lookup([1, 0, -1]) != "alpha" { return -1 }
    if3 trie.lookup([1, 0, 1]) != "beta" { return -1 }
    trie.delete([1, 0, -1])
    if3 trie.lookup([1, 0, -1]) != null { return -1 }

    // 2. TST
    tst = TernarySearchTree()
    tst.insert([-1, 0, 1], "gamma")
    tst.insert([-1, 0, -1], "delta")
    if3 tst.search([-1, 0, 1]) != "gamma" { return -1 }
    if3 tst.search([1, 1, 1]) != null { return -1 }

    // 3. TernaryHeap
    heap = TernaryHeap()
    for3 v in [5, 3, 7, 1] { heap.insert(v) }
    if3 heap.extract_min() != 1 { return -1 }
    if3 heap.extract_min() != 3 { return -1 }

    // 4. TernarySkipList
    skip = TernarySkipList()
    skip.insert(10, "ten")
    skip.insert(20, "twenty")
    skip.insert(15, "fifteen")
    if3 skip.search(15) != "fifteen" { return -1 }
    if3 skip.search(99) != null { return -1 }

    // 5. AVL-3
    avl = BalancedTernaryTree()
    for3 v in [5, 3, 7, 1, 4, 6, 8] { avl.insert(v, str(v)) }
    if3 avl.search(4) != "4" { return -1 }
    avl.delete(3)
    if3 avl.search(3) != null { return -1 }

    // 6. TernaryBloomFilter
    bloom = TernaryBloomFilter(2187, 7)
    bloom.add("nova")
    bloom.add("ternary")
    if3 bloom.query("nova") != 1 { return -1 }
    bloom.remove("nova")
    if3 bloom.query("nova") != -1 { return -1 }

    return 1  // ALL PASS
}
