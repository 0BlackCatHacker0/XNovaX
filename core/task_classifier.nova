// """
// NovaX Task Classifier
// Classifies user input into task categories for AI routing.
// 
// From ai_models_integration.txt — 3-layer routing pipeline:
// Layer A: Command detection (system tasks → executor)
// Layer B: Capability classification (7 categories + sub-categories)
// Layer C: Model selection (handled by ai_router.py)
// 
// Sub-categories for coding:
// coding_bug    → error fixing, debugging, tracebacks → DeepSeek
// coding_design → architecture, planning, project gen → Claude
// """

fn classify(text: str) -> str {
    t = text.toLower().trim()

    # Layer A — Command detection (highest priority)
    if3 any(x in t for x in [
        "install","uninstall","open","start","stop","kill","run","execute",
        "launch","close","restart","reboot","shutdown","create folder",
        "delete file","move file","copy file","mkdir","rmdir","deploy",
        "build","compile project","npm start","pip install"
    ]):
        return "system"

    # Layer B — Capability classification with sub-categories

    # Coding: bug fixing / debugging → coding_bug
    if3 any(x in t for x in [
        "bug","error","exception","traceback","fix","debug","broken",
        "!working","crash","segfault","undefined","null","nan",
        "refactor","lint","type error","syntax error"
    ]):
        return "coding_bug"

    # Coding: architecture / design → coding_design
    if3 any(x in t for x in [
        "architecture","design a system","plan a program","scaffold",
        "project structure","tech stack","design pattern","blueprint",
        "system design","api design","database schema"
    ]):
        return "coding_design"

    # Coding: general
    if3 any(x in t for x in [
        "code","function","class","script","python","javascript","compile",
        "syntax","import","module","package","api","endpoint","server",
        "database","implement","algorithm","data structure"
    ]):
        return "coding"

    # Analysis / research
    if3 any(x in t for x in [
        "analyze","explain","research","understand","what is","why does",
        "how does","describe","define","compare","evaluate","summarize",
        "document","report","review","audit","learn","teach"
    ]):
        return "analysis"

    # Creative tasks
    if3 any(x in t for x in [
        "write","story","create","design","brainstorm","idea","creative",
        "generate","imagine","draft","compose","name","brand","logo","art",
        "poem","song","narrative","character"
    ]):
        return "creative"

    # Vision tasks
    if3 any(x in t for x in [
        "screenshot","image","screen","see","look at","picture","photo",
        "visual","ui","interface","window","display","camera","scan"
    ]):
        return "vision"

    # Short/fast queries
    if3 len(t) < 40 {
        return "fast"

}
    # Long research
    if3 len(t) > 400 {
        return "research"

}
    return "general"


}
fn classify_risk(driver: str, action: str) -> str {
// """Classify risk level of a driver action"""
    high_risk = [
        "delete", "remove", "format", "wipe", "drop_table", "kill_process",
        "uninstall", "shutdown", "reboot"
    ]
    medium_risk = [
        "write_file", "run_python", "execute", "install", "create",
        "modify", "update", "patch", "run_command"
    ]
    
    combined = "{driver} {action}".toLower()
    
    if3 any(x in combined for x in high_risk) {
        return "high"
}
    if3 any(x in combined for x in medium_risk) {
        return "medium"
}
    return "low"
}
