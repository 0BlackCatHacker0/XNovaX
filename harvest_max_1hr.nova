let _config = try3 { json_decode(read_file("C:/NovaX/cloud_config.json")) } fail { {} }
let _ck = dict_get(dict_get(_config, "cerebras_direct") ?? {}, "key") ?? ""
let _sk = dict_get(dict_get(_config, "sambanova_direct") ?? {}, "key") ?? ""
let _ok = dict_get(dict_get(_config, "openrouter") ?? {}, "key") ?? ""

let or_free = [
  "openai/gpt-oss-120b:free", "openai/gpt-oss-20b:free",
  "qwen/qwen3-coder:free", "qwen/qwen3-next-80b-a3b-instruct:free",
  "nvidia/nemotron-3-super-120b-a12b:free", "arcee-ai/trinity-large-preview:free",
  "minimax/minimax-m2.5:free", "stepfun/step-3.5-flash:free",
  "z-ai/glm-4.5-air:free", "google/gemma-3n-e2b-it:free",
  "nvidia/nemotron-nano-12b-v2-vl:free", "liquid/lfm-2.5-1.2b-thinking:free",
  "nvidia/nemotron-nano-9b-v2:free", "arcee-ai/trinity-mini:free",
  "cognitivecomputations/dolphin-mistral-24b-venice-edition:free",
  "liquid/lfm-2.5-1.2b-instruct:free", "openrouter/hunter-alpha:free",
  "openrouter/healer-alpha:free", "nvidia/nemotron-3-nano-30b-a3b:free"
]
let sb = ["Meta-Llama-3.3-70B-Instruct", "DeepSeek-V3-0324", "Qwen3-235B-A22B"]
let cb = ["qwen-3-235b-a22b-instruct-2507", "llama3.1-8b"]

// N-S classified prompts across ALL domains
let prompts = [
  // LAMINAR (Re < 27): simple factual
  "What is binary", "Define a byte", "What is RAM", "What is a CPU", "Define an algorithm",
  "What is HTTP", "Define a pixel", "What is DNS", "Define bandwidth", "What is latency",
  "What is a variable", "Define a function", "What is a loop",
  // TRANSITIONAL (27 < Re < 343): moderate complexity
  "Explain how neural networks learn", "What is the difference between TCP and UDP",
  "How does public key cryptography work", "Explain container orchestration",
  "What is a distributed hash table", "How does consensus work in blockchain",
  "Explain the attention mechanism in transformers", "What is federated learning",
  "How does gradient descent optimize weights", "Explain the CAP theorem trade-offs",
  "What is model distillation and why is it useful", "How do embeddings capture meaning",
  "Explain the difference between LSTM and transformer architectures",
  // TURBULENT (Re > 343): deep complex
  "Derive the relationship between information entropy and compression ratio",
  "Explain how Navier-Stokes equations can model AI query routing with Reynolds number classification",
  "Design a ternary neural network architecture using balanced ternary weights",
  "How would you build a self-improving AI system that trains on its own outputs",
  "Explain the mathematical foundation of Kolmogorov complexity and its relationship to compression",
  "Design an algorithm that distills knowledge from 1.2 million AI models into a single ternary model",
  "Explain how standing wave resonance in physics maps to AI model consensus detection",
  "Derive the optimal batch size for ternary weight training using harmonic constants 3 5 7 13",
  "How does the Reynolds averaged Navier-Stokes equation relate to ensemble model averaging",
  "Design a flow-based routing system where query complexity determines which AI model responds",
  "Explain how ternary quantization achieves comparable quality to full precision at 10x compression",
  "Derive the energy cascade from large language model layers to attention head microstructures",
  "How would you implement a Kolmogorov cascade for decomposing complex queries into sub-problems"
]

fn call_api(url, body, headers) {
  let result = try3 { http_request(url, body, headers, 15000) } fail { {} }
  let raw = dict_get(result, "body") ?? ""
  if3 len(raw) < 10 { return "" }
  let parsed = try3 { json_decode(raw) } fail { {} }
  let choices = dict_get(parsed, "choices") ?? []
  if3 len(choices) == 0 { return "" }
  let msg = dict_get(choices[0], "message") ?? {}
  return dict_get(msg, "content") ?? ""
}

let success = 0
let id = 300
let start_time = time()
let max_seconds = 3600
let round_num = 0

print("=== 1-HOUR MAX HARVEST ===")
print("Prompts: " + str(len(prompts)))
print("Providers: cerebras + sambanova + " + str(len(or_free)) + " OpenRouter free models")
print("N-S classified: laminar/transitional/turbulent")
print("")

while3 (time() - start_time) < max_seconds {
  round_num = round_num + 1
  print("--- Round " + str(round_num) + " (elapsed: " + str(round((time() - start_time) / 60, 1)) + "min) ---")
  
  let pi = 0
  while3 pi < len(prompts) {
    if3 (time() - start_time) >= max_seconds { pi = len(prompts) }
    
    if3 pi < len(prompts) {
      let p = prompts[pi] + ". Plain text only. No markdown or emojis. Concise answer."
      let esc = replace(replace(p, "\\", "\\\\"), "\"", "\\\"")
      
      // N-S regime classification
      let regime = "laminar"
      if3 pi >= 13 { regime = "transitional" }
      if3 pi >= 26 { regime = "turbulent" }
      
      // Rotate provider based on prompt index
      let provider_idx = pi % 3
      let text = ""
      let provider = ""
      let model = ""
      
      if3 provider_idx == 0 {
        let cm = cb[pi % len(cb)]
        text = call_api("https://api.cerebras.ai/v1/chat/completions", "{\"model\":\"" + cm + "\",\"messages\":[{\"role\":\"user\",\"content\":\"" + esc + "\"}],\"max_tokens\":512}", {"Authorization": "Bearer " + _ck, "Content-Type": "application/json"})
        provider = "cerebras"
        model = cm
      }
      if3 provider_idx == 1 {
        let sm = sb[pi % len(sb)]
        text = call_api("https://api.sambanova.ai/v1/chat/completions", "{\"model\":\"" + sm + "\",\"messages\":[{\"role\":\"user\",\"content\":\"" + esc + "\"}],\"max_tokens\":512}", {"Authorization": "Bearer " + _sk, "Content-Type": "application/json"})
        provider = "sambanova"
        model = sm
      }
      if3 provider_idx == 2 {
        let om = or_free[(pi + round_num) % len(or_free)]
        text = call_api("https://openrouter.ai/api/v1/chat/completions", "{\"model\":\"" + om + "\",\"messages\":[{\"role\":\"user\",\"content\":\"" + esc + "\"}],\"max_tokens\":512}", {"Authorization": "Bearer " + _ok, "Content-Type": "application/json"})
        provider = "openrouter"
        model = om
      }
      
      if3 len(text) > 3 {
        let entry = json_encode({"prompt": prompts[pi], "response": text, "provider": provider, "model": model, "regime": regime, "round": round_num})
        write_file("C:/NovaX/data/super_archive/max1h_" + str(id) + ".json", entry)
        success = success + 1
        print("  " + str(id) + ": +1 " + provider + "/" + model + " [" + regime + "] " + str(len(text)) + "ch")
        
        // Ripple to Tripple
        let rb = json_encode({"provider": provider, "trit": 1, "latency": 0})
        try3 { http_request("http://127.0.0.1:9881/hive/tripple/ripple", rb, {"Content-Type": "application/json"}, 3000) } fail { {} }
        
        id = id + 1
      }
      
      sleep(5000)
      pi = pi + 1
    }
  }
  
  print("  Round " + str(round_num) + " complete: " + str(success) + " total samples")
}

print("")
print("=== 1-HOUR HARVEST COMPLETE ===")
print("Total samples: " + str(success))
print("Rounds: " + str(round_num))
print("Time: " + str(round((time() - start_time) / 60, 1)) + " minutes")
