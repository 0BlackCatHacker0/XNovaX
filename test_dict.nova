fn make_entry(a, b, c, d, e) {
    let x = {
        "id": a,
        "provider": b,
        "tier": c,
        "context": d,
        "cost": e,
        "free": true,
        "abilities": [],
        "locked": false
    }
    return x
}
let r = make_entry("m1", "openai", "t1", 4096, "0")
print(r)
