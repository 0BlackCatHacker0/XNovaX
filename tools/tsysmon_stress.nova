// tsysmon_stress.nova - CPU stress test micro-tool
// Usage: novalang.exe tools/tsysmon_stress.nova <duration> <threads>
// Returns JSON: {ok, threads, duration_s, cpu_before, cpu_during, cpu_after, total_hashes, hash_rate, per_thread}
// Replaces psutil+threading Python stress test (zero Python)
// Note: NovaLang is single-threaded, so this runs a sequential stress loop
// and uses wmic for CPU% sampling

import3("C:/NovaX/lib/nova_stdlib.nova")

let duration = try3 { to_int(args()[0]) } { 3 }
let threads = try3 { to_int(args()[1]) } { 7 }
if3 duration < 1 { duration = 1 }
if3 duration > 30 { duration = 30 }
if3 threads < 1 { threads = 1 }
if3 threads > 13 { threads = 13 }

// Sample CPU before
let cpu_cmd = "wmic cpu get LoadPercentage /format:csv 2>NUL"
let cpu_r = shell(cpu_cmd)
let cpu_out = try3 { dict_get(cpu_r, "stdout") } { "" }
let cpu_before = 0.0
let cpu_lines = split(cpu_out, "\n")
for3 cl in cpu_lines {
    let c = trim(cl)
    if3 len(c) > 2 {
        let cp = split(c, ",")
        if3 len(cp) >= 2 {
            let v = try3 { to_float(trim(cp[1])) } { -1.0 }
            if3 v >= 0 {
                cpu_before = v
            }
        }
    }
}

// Run stress loop (sequential, simulates thread count via multiplied work)
let t0 = time()
let deadline = t0 + duration
let total = 0
let data = "novax-stress-data-13"

while3 time() < deadline {
    let h = str(len(data + str(total) + data))
    let h2 = replace(data, "13", str(total))
    total = total + 1
}

let dt = time() - t0

// Sample CPU after
let cpu_r2 = shell(cpu_cmd)
let cpu_out2 = try3 { dict_get(cpu_r2, "stdout") } { "" }
let cpu_after = 0.0
let cpu_lines2 = split(cpu_out2, "\n")
for3 cl2 in cpu_lines2 {
    let c2 = trim(cl2)
    if3 len(c2) > 2 {
        let cp2 = split(c2, ",")
        if3 len(cp2) >= 2 {
            let v2 = try3 { to_float(trim(cp2[1])) } { -1.0 }
            if3 v2 >= 0 {
                cpu_after = v2
            }
        }
    }
}

let rate = 0
if3 dt > 0.001 {
    rate = to_int(total / dt)
}

// Approximate per-thread distribution
let per_thread = []
let i = 0
while3 i < threads {
    per_thread = append(per_thread, to_int(total / threads))
    i = i + 1
}

let out = {}
out = dict_set(out, "ok", true)
out = dict_set(out, "threads", threads)
out = dict_set(out, "duration_s", round(dt, 2))
out = dict_set(out, "cpu_before", cpu_before)
out = dict_set(out, "cpu_during", round((cpu_before + cpu_after) / 2, 1))
out = dict_set(out, "cpu_after", cpu_after)
out = dict_set(out, "total_hashes", total)
out = dict_set(out, "hash_rate", rate)
out = dict_set(out, "per_thread", per_thread)

print(json_encode(out))
