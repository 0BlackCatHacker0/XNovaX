// tsize.nova - Ternary directory size calculator micro-tool
// Usage: novalang.exe tools/tsize.nova <path>
// Returns total bytes to stdout
// Replaces tools/tsize.py (zero Python)

import3("C:/NovaX/lib/nova_stdlib.nova")

let path = try3 { args()[0] } { "C:/NovaX" }

// Use dir /s to get total size summary
let cmd = "dir /s \"" + path + "\" 2>NUL | findstr /C:\"File(s)\""
let result = shell(cmd)
let stdout = try3 { dict_get(result, "stdout") } { "0" }

// Parse the last line which contains total bytes
// Format: "  X File(s)  Y,YYY bytes"
let cleaned = replace(stdout, ",", "")
let parts = split(trim(cleaned), " ")
let total = 0
for3 p in parts {
    let trimmed = trim(p)
    if3 len(trimmed) > 0 {
        let is_num = try3 { trimmed + 0 } { -999 }
        if3 is_num > 0 { total = is_num }
    }
}

print(str(total))
