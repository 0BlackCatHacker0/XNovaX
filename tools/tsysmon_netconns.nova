// tsysmon_netconns.nova - Network connections micro-tool
// Usage: novalang.exe tools/tsysmon_netconns.nova
// Returns JSON: {ok, total, established, listening, external, connections[]}
// Replaces psutil.net_connections() Python script (zero Python)

import3("C:/NovaX/lib/nova_stdlib.nova")

// Use netstat -ano for connection info
let cmd = "netstat -ano 2>NUL"
let result = shell(cmd)
let stdout = try3 { dict_get(result, "stdout") } { "" }
let lines = split(stdout, "\n")

let connections = []
let established = 0
let listening = 0
let external = 0
let total = 0
let PRIVATE = "127. 10. 192.168. 172. 0.0.0.0 [::1] [::] *:*"

for3 line in lines {
    let l = trim(line)
    // Parse lines like: TCP    127.0.0.1:9999    0.0.0.0:0    LISTENING    12345
    if3 starts_with(l, "TCP") {
        let parts = split(l, " ")
        // Filter out empty parts from multiple spaces
        let cleaned = []
        for3 p in parts {
            if3 len(trim(p)) > 0 {
                cleaned = append(cleaned, trim(p))
            }
        }
        if3 len(cleaned) >= 4 {
            let local_addr = cleaned[1]
            let remote_addr = cleaned[2]
            let status = cleaned[3]
            let pid = 0
            if3 len(cleaned) >= 5 {
                pid = try3 { to_int(cleaned[4]) } { 0 }
            }

            // Split local address
            let la_parts = split(local_addr, ":")
            let la = try3 { la_parts[0] } { "" }
            let lp = try3 { to_int(la_parts[len(la_parts) - 1]) } { 0 }

            // Split remote address
            let ra_parts = split(remote_addr, ":")
            let ra = try3 { ra_parts[0] } { "" }
            let rp = try3 { to_int(ra_parts[len(ra_parts) - 1]) } { 0 }

            if3 status == "ESTABLISHED" {
                established = established + 1
            }
            if3 status == "LISTENING" {
                listening = listening + 1
            }

            // Check if external
            let is_ext = false
            if3 len(ra) > 0 {
                is_ext = true
                if3 starts_with(ra, "127.") { is_ext = false }
                if3 starts_with(ra, "10.") { is_ext = false }
                if3 starts_with(ra, "192.168.") { is_ext = false }
                if3 starts_with(ra, "172.") { is_ext = false }
                if3 starts_with(ra, "0.0.0.0") { is_ext = false }
                if3 ra == "" { is_ext = false }
                if3 ra == "*" { is_ext = false }
            }
            if3 is_ext {
                external = external + 1
            }

            total = total + 1
            if3 len(connections) < 50 {
                let entry = {}
                entry = dict_set(entry, "local", la)
                entry = dict_set(entry, "lport", lp)
                entry = dict_set(entry, "remote", ra)
                entry = dict_set(entry, "rport", rp)
                entry = dict_set(entry, "status", status)
                entry = dict_set(entry, "pid", pid)
                entry = dict_set(entry, "external", is_ext)
                connections = append(connections, entry)
            }
        }
    }
}

let out = {}
out = dict_set(out, "ok", true)
out = dict_set(out, "total", total)
out = dict_set(out, "established", established)
out = dict_set(out, "listening", listening)
out = dict_set(out, "external", external)
out = dict_set(out, "connections", connections)

print(json_encode(out))
