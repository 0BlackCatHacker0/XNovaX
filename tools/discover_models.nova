// Discover all models from Ollama + cloud_config.json and output as JSON list

fn3 main() {
    let all_models = []

    // Ollama models
    try3 {
        let resp = http_get("http://127.0.0.1:11434/api/tags")
        let data = parse_json(resp)
        let models = dict_get(data, "models") ?? []
        for3 (m in models) {
            append(all_models, {"provider": "ollama", "model": dict_get(m, "name") ?? ""})
        }
    } catch3 (e) {
        // Ollama not available
    }

    // Cloud config models
    try3 {
        let raw = read_file("C:/NovaX/cloud_config.json")
        let cfg = parse_json(raw)
        let prov_names = dict_keys(cfg)
        for3 (prov_name in prov_names) {
            let prov_data = dict_get(cfg, prov_name)
            if3 (type_of(prov_data) != "dict") {
                // skip non-dict
            } else3 {
                let models = dict_get(prov_data, "models") ?? []
                if3 (type_of(models) == "list") {
                    for3 (m in models) {
                        let mid = ""
                        if3 (type_of(m) == "dict") {
                            mid = dict_get(m, "id") ?? (dict_get(m, "model") ?? "")
                        } else3 {
                            mid = str(m)
                        }
                        append(all_models, {"provider": prov_name, "model": mid})
                    }
                } else3 {
                    if3 (dict_get(prov_data, "model") != null) {
                        append(all_models, {"provider": prov_name, "model": dict_get(prov_data, "model")})
                    }
                }
            }
        }
    } catch3 (e) {
        // cloud_config not available
    }

    print(to_json(all_models))
}

main()
