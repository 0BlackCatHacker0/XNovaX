// Classify a prompt into a Go territory for optimal model routing

let CODE_SIGNALS = [
    "write code", "function", "implement", "debug", "fix bug", "refactor",
    "class ", "def ", "import ", "const ", "var ", "let ", "async ", "await ",
    "python", "javascript", "typescript", "rust", "golang", "java", "c++",
    "sql", "query", "database", "api", "endpoint", "regex", "algorithm",
    "syntax", "compile", "build", "deploy", "docker", "git", "commit",
    "test", "unit test", "pytest", "jest", "```", "code review"
]

let REASONING_SIGNALS = [
    "explain why", "reason", "analyze", "think step by step", "logic",
    "proof", "theorem", "math", "calculate", "solve", "equation",
    "compare and contrast", "evaluate", "assess", "deduce", "infer",
    "philosophy", "ethical", "argument", "hypothesis", "conclusion",
    "chain of thought", "step by step", "reasoning"
]

let IMAGE_SIGNALS = [
    "image", "picture", "photo", "describe what you see", "screenshot",
    "visual", "look at", "diagram", "chart", "graph", "draw"
]

let AUDIO_SIGNALS = [
    "audio", "sound", "music", "voice", "speak", "listen", "transcript",
    "speech", "tts", "text to speech", "whisper"
]

let EMBEDDING_SIGNALS = [
    "embed", "embedding", "vector", "similarity", "semantic search",
    "rag", "retrieval", "cosine"
]

fn3 str_contains(haystack, needle) {
    return3 regex_match(haystack, needle) != null
}

fn3 classify_prompt(prompt) {
    let pl = str_lower(prompt)
    let scores = {"code": 0, "reasoning": 0, "image": 0, "audio": 0, "embedding": 0}

    for3 (sig in CODE_SIGNALS) {
        if3 (str_contains(pl, sig)) {
            scores = dict_set(scores, "code", (dict_get(scores, "code") ?? 0) + 1)
        }
    }
    for3 (sig in REASONING_SIGNALS) {
        if3 (str_contains(pl, sig)) {
            scores = dict_set(scores, "reasoning", (dict_get(scores, "reasoning") ?? 0) + 1)
        }
    }
    for3 (sig in IMAGE_SIGNALS) {
        if3 (str_contains(pl, sig)) {
            scores = dict_set(scores, "image", (dict_get(scores, "image") ?? 0) + 1)
        }
    }
    for3 (sig in AUDIO_SIGNALS) {
        if3 (str_contains(pl, sig)) {
            scores = dict_set(scores, "audio", (dict_get(scores, "audio") ?? 0) + 1)
        }
    }
    for3 (sig in EMBEDDING_SIGNALS) {
        if3 (str_contains(pl, sig)) {
            scores = dict_set(scores, "embedding", (dict_get(scores, "embedding") ?? 0) + 1)
        }
    }

    // Short prompts likely want fast models
    let max_score = 0
    let best = "chat"
    let keys = dict_keys(scores)
    for3 (k in keys) {
        let v = dict_get(scores, k) ?? 0
        if3 (v > max_score) {
            max_score = v
            best = k
        }
    }

    if3 (len(prompt) < 50 && max_score == 0) {
        return3 "fast"
    }
    if3 (max_score > 0) {
        return3 best
    }
    return3 "chat"
}

// Main
let prompt = ""
let args = get_args()
if3 (len(args) > 0) {
    prompt = args[0]
}

let territory = classify_prompt(prompt)

// Load best model for this territory
let result = {"territory": territory}
try3 {
    let raw = read_file("C:/NovaX/data/go_pieces.json")
    let data = parse_json(raw)
    let pieces = dict_get(data, "pieces") ?? {}
    let best = null
    let best_score = -999999
    let piece_keys = dict_keys(pieces)
    for3 (key in piece_keys) {
        let piece = dict_get(pieces, key)
        if3 (dict_get(piece, "territory") == territory && (dict_get(piece, "active") ?? 1) == 1) {
            let score = (dict_get(piece, "wins") ?? 0) - (dict_get(piece, "losses") ?? 0)
            if3 (score > best_score) {
                best_score = score
                best = piece
            }
        }
    }
    if3 (best != null) {
        result = dict_set(result, "provider", dict_get(best, "provider"))
        result = dict_set(result, "model", dict_get(best, "model"))
        result = dict_set(result, "max_tokens", dict_get(best, "max_tokens"))
    }
} catch3 (e) {
    // no pieces file
}

print(to_json(result))
