// Hivemind Model Merge
// Reads existing models from a JSON file, fetches registry models,
// merges them (deduped), and writes the result back.
// Input:  C:/NovaX/tmp/existing_models.json
// Output: C:/NovaX/tmp/merged_models.json

fn3 fetch_json(url) {
    try3 {
        let resp = http_get(url)
        return3 parse_json(resp)
    } catch3 (e) {
        return3 {"error": "unknown error"}
    }
}

// Read existing models
let existing = []
try3 {
    existing = parse_json(read_file("C:/NovaX/tmp/existing_models.json"))
} catch3 (e) {
    existing = []
}

// Fetch from registry
let catalog = fetch_json("http://127.0.0.1:9860/catalog")
let models = []
if3 (dict_get(catalog, "error") == null) {
    let providers = dict_get(catalog, "providers") ?? {}
    let prov_keys = dict_keys(providers)
    for3 (prov in prov_keys) {
        let model_list = dict_get(providers, prov) ?? []
        if3 (type_of(model_list) == "list") {
            for3 (m in model_list) {
                let mid = ""
                if3 (type_of(m) == "dict") {
                    mid = dict_get(m, "id") ?? (dict_get(m, "name") ?? "")
                } else3 {
                    mid = str(m)
                }
                if3 (mid != "") {
                    append(models, mid)
                }
            }
        }
    }
}

// Merge and dedup (preserving order)
let seen = {}
let merged = []
for3 (item in existing) {
    let k = str(item)
    if3 (dict_get(seen, k) == null) {
        seen = dict_set(seen, k, 1)
        append(merged, item)
    }
}
for3 (item in models) {
    let k = str(item)
    if3 (dict_get(seen, k) == null) {
        seen = dict_set(seen, k, 1)
        append(merged, item)
    }
}

// Write merged result
shell("mkdir -p C:/NovaX/tmp")
write_file("C:/NovaX/tmp/merged_models.json", to_json(merged))

print(to_json({
    "ok": true,
    "existing": len(existing),
    "registry": len(models),
    "merged": len(merged)
}))
