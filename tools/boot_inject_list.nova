// Output ALL models from go_pieces.json for boot-time Mirror injection

let raw = read_file("C:/NovaX/data/go_pieces.json")
try3 {
    let d = parse_json(raw)
    let pieces = dict_get(d, "pieces") ?? {}
    let models = []
    let keys = dict_keys(pieces)
    for3 (k in keys) {
        let v = dict_get(pieces, k)
        append(models, {"id": dict_get(v, "model") ?? "", "provider": dict_get(v, "provider") ?? ""})
    }
    print(to_json({"count": len(models), "models": models}))
} catch3 (e) {
    print(to_json({"count": 0, "models": [], "error": "unknown error"}))
}
