// Hivemind Batch Merge
// Reads incoming_batch.json, merges into registry_models_live.json (deduped)
// Called by Hivemind's /hive/models/bulk endpoint

let LIVE = "C:/NovaX/tmp/registry_models_live.json"
let BATCH = "C:/NovaX/tmp/incoming_batch.json"

// Read existing
let existing = []
if3 (file_exists(LIVE)) {
    try3 {
        existing = parse_json(read_file(LIVE))
    } catch3 (e) {
        existing = []
    }
}

// Read incoming batch
let incoming = []
if3 (file_exists(BATCH)) {
    try3 {
        incoming = parse_json(read_file(BATCH))
    } catch3 (e) {
        incoming = []
    }
}

// Merge and dedup
let seen = {}
let merged = []
for3 (item in existing) {
    let k = str(item)
    if3 (dict_get(seen, k) == null) {
        seen = dict_set(seen, k, 1)
        append(merged, item)
    }
}
for3 (item in incoming) {
    let k = str(item)
    if3 (dict_get(seen, k) == null) {
        seen = dict_set(seen, k, 1)
        append(merged, item)
    }
}

// Write back
shell("mkdir -p C:/NovaX/tmp")
write_file(LIVE, to_json(merged))

print(to_json({"added": len(incoming), "total": len(merged)}))
