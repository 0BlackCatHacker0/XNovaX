// tsec_audit.nova - Security audit micro-tool
// Usage: novalang.exe tools/tsec_audit.nova <path> [max_depth]
// Returns JSON: {total_files, world_writable[], executables[], dotfiles[], large_files[], dangerous_exts[], high_entropy_files[], ...counts}
// Replaces dynamically-generated tsec_audit.py (zero Python)
// Note: world_writable and high_entropy are Windows-approximated (always 0/empty)

import3("C:/NovaX/lib/nova_stdlib.nova")

let path = try3 { args()[0] } { "C:/NovaX" }
let max_depth = try3 { to_int(args()[1]) } { 3 }

let DANGEROUS = ".exe .bat .cmd .com .scr .pif .vbs .js .wsh .ps1 .msi .dll .wsf .hta"
let EXEC_EXTS = ".exe .bat .cmd .com .ps1 .vbs .wsh .msi"

// Get file listing with sizes
let cmd = "forfiles /p \"" + path + "\" /s /c \"cmd /c echo @path:::@fsize:::@ext\" 2>NUL"
let result = shell(cmd)
let stdout = try3 { dict_get(result, "stdout") } { "" }
let lines = split(stdout, "\n")

let total = 0
let world_writable = []
let executables = []
let dotfiles = []
let large_files = []
let dangerous_exts = []
let high_entropy = []
let errors_count = 0

for3 line in lines {
    let l = trim(line)
    if3 len(l) > 3 {
        let parts = split(l, ":::")
        if3 len(parts) >= 3 {
            total = total + 1
            if3 total > 2000 {
            } else3 {
                let fp = trim(replace(parts[0], "\"", ""))
                let fsize = try3 { to_int(trim(parts[1])) } { 0 }
                let ext = lower(trim(replace(parts[2], "\"", "")))
                let fp_clean = replace(fp, "\\", "/")

                let path_parts = split(fp_clean, "/")
                let fname = path_parts[len(path_parts) - 1]

                // Executable check
                if3 contains(EXEC_EXTS, ext) {
                    if3 len(executables) < 20 {
                        let entry = {}
                        entry = dict_set(entry, "path", fp_clean)
                        entry = dict_set(entry, "ext", ext)
                        executables = append(executables, entry)
                    }
                }

                // Dotfile check
                if3 starts_with(fname, ".") {
                    if3 len(dotfiles) < 20 {
                        let entry = {}
                        entry = dict_set(entry, "path", fp_clean)
                        entry = dict_set(entry, "name", fname)
                        dotfiles = append(dotfiles, entry)
                    }
                }

                // Large file (>100MB)
                if3 fsize > 104857600 {
                    if3 len(large_files) < 20 {
                        let entry = {}
                        entry = dict_set(entry, "path", fp_clean)
                        entry = dict_set(entry, "size", fsize)
                        large_files = append(large_files, entry)
                    }
                }

                // Dangerous extensions
                if3 contains(DANGEROUS, ext) {
                    if3 len(dangerous_exts) < 20 {
                        let entry = {}
                        entry = dict_set(entry, "path", fp_clean)
                        entry = dict_set(entry, "ext", ext)
                        dangerous_exts = append(dangerous_exts, entry)
                    }
                }
            }
        }
    }
}

// world_writable: not meaningful on Windows (NTFS uses ACLs, not Unix permissions)
// high_entropy: requires byte-level file reading, approximated as 0

let out = {}
out = dict_set(out, "total_files", total)
out = dict_set(out, "world_writable", world_writable)
out = dict_set(out, "world_writable_count", 0)
out = dict_set(out, "executables", executables)
out = dict_set(out, "executables_count", len(executables))
out = dict_set(out, "dotfiles", dotfiles)
out = dict_set(out, "dotfiles_count", len(dotfiles))
out = dict_set(out, "large_files", large_files)
out = dict_set(out, "large_files_count", len(large_files))
out = dict_set(out, "dangerous_exts", dangerous_exts)
out = dict_set(out, "dangerous_exts_count", len(dangerous_exts))
out = dict_set(out, "high_entropy_files", high_entropy)
out = dict_set(out, "high_entropy_count", 0)
out = dict_set(out, "errors_count", errors_count)

print(json_encode(out))
