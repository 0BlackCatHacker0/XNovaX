// tsysmon_ptrace.nova - Process trace micro-tool
// Usage: novalang.exe tools/tsysmon_ptrace.nova <pid>
// Returns JSON: {ok, pid, name, status, cpu_percent, mem_rss_mb, mem_vms_mb, num_threads, open_files, net_connections, cmdline}
// Replaces psutil.Process() Python script (zero Python)

import3("C:/NovaX/lib/nova_stdlib.nova")

let pid = try3 { to_int(args()[0]) } { 0 }

if3 pid < 1 {
    print("{\"ok\":false,\"error\":\"invalid PID\"}")
} else3 {
    // Get process details via wmic
    let cmd = "wmic process where processid=" + str(pid) + " get Name,ProcessId,ThreadCount,WorkingSetSize,VirtualSize,CommandLine /format:csv 2>NUL"
    let result = shell(cmd)
    let stdout = try3 { dict_get(result, "stdout") } { "" }
    let lines = split(stdout, "\n")

    let found = false
    let out = {}
    out = dict_set(out, "ok", false)
    out = dict_set(out, "error", "PID " + str(pid) + " not found")

    for3 line in lines {
        let l = trim(line)
        if3 len(l) > 5 {
            let parts = split(l, ",")
            // CSV: Node,CommandLine,Name,ProcessId,ThreadCount,VirtualSize,WorkingSetSize
            if3 len(parts) >= 7 {
                let proc_pid = try3 { to_int(trim(parts[3])) } { 0 }
                if3 proc_pid == pid {
                    let cmdline = try3 { trim(parts[1]) } { "?" }
                    let name = try3 { trim(parts[2]) } { "?" }
                    let threads = try3 { to_int(trim(parts[4])) } { 0 }
                    let vms = try3 { to_int(trim(parts[5])) } { 0 }
                    let ws = try3 { to_int(trim(parts[6])) } { 0 }
                    let mem_rss = round(ws / 1048576, 1)
                    let mem_vms = round(vms / 1048576, 1)

                    out = dict_set(out, "ok", true)
                    out = dict_set(out, "pid", pid)
                    out = dict_set(out, "name", name)
                    out = dict_set(out, "status", "running")
                    out = dict_set(out, "cpu_percent", 0.0)
                    out = dict_set(out, "mem_rss_mb", mem_rss)
                    out = dict_set(out, "mem_vms_mb", mem_vms)
                    out = dict_set(out, "num_threads", threads)
                    out = dict_set(out, "open_files", -1)
                    out = dict_set(out, "net_connections", -1)
                    out = dict_set(out, "cmdline", cmdline)
                    found = true
                }
            }
        }
    }

    print(json_encode(out))
}
