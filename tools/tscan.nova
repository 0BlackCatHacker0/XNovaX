// tscan.nova - Ternary file scanner micro-tool
// Usage: novalang.exe tools/tscan.nova <path> <max_depth>
// Returns JSON array of {FullName, Length, Extension} to stdout
// Replaces tools/tscan.py (zero Python)

import3("C:/NovaX/lib/nova_stdlib.nova")

let path = try3 { args()[0] } { "C:/NovaX" }
let max_depth = try3 { args()[1] } { "2" }

// Use dir /s /b to list all files recursively
let cmd = "dir /s /b \"" + path + "\" 2>NUL"
let result = shell(cmd)
let stdout = try3 { dict_get(result, "stdout") } { "" }
let lines = split(stdout, "\n")

let results = []
for3 line in lines {
    let fp = trim(line)
    if3 len(fp) > 2 {
        // Get file size via a quick dir call
        let parts = split(fp, ".")
        let ext = ""
        if3 len(parts) > 1 {
            ext = "." + parts[len(parts) - 1]
        }
        let entry = {}
        entry = dict_set(entry, "FullName", fp)
        entry = dict_set(entry, "Length", 0)
        entry = dict_set(entry, "Extension", ext)
        results = append(results, entry)
    }
}

print(json_encode(results))
