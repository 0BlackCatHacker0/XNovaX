{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NovaLang",
  "scopeName": "source.nova",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#ternary-constants" },
    { "include": "#builtins" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nova",
          "match": "//.*$"
        },
        {
          "name": "comment.line.hash.nova",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nova",
          "begin": "\"",
          "end": "\"",
          "patterns": [{
            "name": "constant.character.escape.nova",
            "match": "\\\\[ntr0\\\\\"']"
          }]
        },
        {
          "name": "string.quoted.single.nova",
          "begin": "'",
          "end": "'",
          "patterns": [{
            "name": "constant.character.escape.nova",
            "match": "\\\\[ntr0\\\\\"']"
          }]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.nova",
          "match": "-?[0-9][0-9_]*\\.[0-9][0-9_]*"
        },
        {
          "name": "constant.numeric.integer.nova",
          "match": "-?[0-9][0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nova",
          "match": "\\b(if3|if|else3|else|for3|for|while3|while|try3|fail|catch3|match3|break3|continue3|return|maybe|done3|uncertain)\\b"
        },
        {
          "name": "keyword.declaration.nova",
          "match": "\\b(let|const|fn|class3|extends3|new3|import3)\\b"
        },
        {
          "name": "keyword.operator.nova",
          "match": "\\b(and|or|not|AND|OR|NOT|in)\\b"
        }
      ]
    },
    "ternary-constants": {
      "patterns": [
        {
          "name": "constant.language.true.nova",
          "match": "\\b(TRUE|T_TRUE|true)\\b"
        },
        {
          "name": "constant.language.maybe.nova",
          "match": "\\b(MAYBE|T_MAYBE)\\b"
        },
        {
          "name": "constant.language.false.nova",
          "match": "\\b(FALSE_|T_FALSE|false)\\b"
        },
        {
          "name": "constant.language.null.nova",
          "match": "\\bnull\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.ternary.nova",
          "match": "\\b(bool3|not3|and3|or3|merge3|cmp3|trit|tryte|trit_count|bt|bt_val|bt_neg|bt_add|bt_sub|bt_mul|bt_pack|bt_unpack|health3|health3_all|health3_bt)\\b"
        },
        {
          "name": "support.function.io.nova",
          "match": "\\b(print|str|len|type_of|int|float|round|abs|min|max|floor|ceil|sqrt|pow)\\b"
        },
        {
          "name": "support.function.string.nova",
          "match": "\\b(trim|split|join|replace|starts_with|ends_with|contains|upper|lower|substr|char_at|index_of)\\b"
        },
        {
          "name": "support.function.collection.nova",
          "match": "\\b(append|prepend|slice|reverse|sort|map|filter|reduce|range|keys|values|has_key|dict_get|dict_set|dict_keys|dict_values|dict_merge)\\b"
        },
        {
          "name": "support.function.system.nova",
          "match": "\\b(shell|file_read|file_write|file_exists|dir_list|dir_create|path_ext|path_filename|path_join|env_get|env_set|time|sleep)\\b"
        },
        {
          "name": "support.function.http.nova",
          "match": "\\b(tserve|troute|tstart|http_get|http_post|json_encode|json_decode|url_encode|url_decode)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.nova",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.nova",
          "match": "(\\+=|-=|\\*=|/=|=)"
        },
        {
          "name": "keyword.operator.comparison.nova",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.nova",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.arrow.nova",
          "match": "=>"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.nova",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
