{
  "name": "novalang",
  "displayName": "NovaLang",
  "description": "NovaLang ternary-first language support — syntax highlighting, LSP, formatter",
  "version": "1.0.0",
  "publisher": "novax",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{
      "id": "novalang",
      "aliases": ["NovaLang", "nova"],
      "extensions": [".nova"],
      "configuration": "./language-configuration.json",
      "icon": { "light": "./icon.png", "dark": "./icon.png" }
    }],
    "grammars": [{
      "language": "novalang",
      "scopeName": "source.nova",
      "path": "./syntaxes/novalang.tmLanguage.json"
    }]
  },
  "main": "./extension.js"
}
