// tfileops.nova - File operations micro-tool
// Usage: novalang.exe tools/tfileops.nova <operation> [args...]
// Operations: tree, glob_size, glob_recent, file_stats, diff, extract, find_files
// Returns JSON to stdout
// Replaces Python os/glob/json one-liners (zero Python)

import3("C:/NovaX/lib/nova_stdlib.nova")

let op = try3 { args()[0] } { "help" }

if3 op == "tree" {
    // Build directory tree: tfileops.nova tree <path> <max_depth> <show_files>
    let path = try3 { args()[1] } { "C:/NovaX" }
    let max_depth = try3 { to_int(args()[2]) } { 3 }
    let show_f = try3 { args()[3] } { "true" }
    let cmd = "dir /ad /b \"" + replace(path, "/", "\\") + "\" 2>NUL"
    let r = shell(cmd)
    let dirs_out = try3 { dict_get(r, "stdout") } { "" }
    let dir_lines = split(dirs_out, "\n")
    let tree_str = replace(path, "\\", "/") + "/"
    let dc = 0
    let fc = 0
    for3 dl in dir_lines {
        let dn = trim(dl)
        if3 len(dn) > 0 {
            if3 dn != ".git" {
                if3 dn != "__pycache__" {
                    if3 dn != "node_modules" {
                        tree_str = tree_str + "\n|-- " + dn + "/"
                        dc = dc + 1
                    }
                }
            }
        }
    }
    if3 show_f == "true" {
        let fcmd = "dir /a-d /b \"" + replace(path, "/", "\\") + "\" 2>NUL"
        let fr = shell(fcmd)
        let file_out = try3 { dict_get(fr, "stdout") } { "" }
        let file_lines = split(file_out, "\n")
        for3 fl in file_lines {
            let fn = trim(fl)
            if3 len(fn) > 0 {
                tree_str = tree_str + "\n|-- " + fn
                fc = fc + 1
            }
        }
    }
    let out = {}
    out = dict_set(out, "tree", tree_str)
    out = dict_set(out, "dirs", dc)
    out = dict_set(out, "files", fc)
    print(json_encode(out))

} else3 op == "glob_size" {
    // Find files by pattern, return with sizes: tfileops.nova glob_size <pattern> <max>
    let pattern = try3 { args()[1] } { "*" }
    let max_n = try3 { to_int(args()[2]) } { 20 }
    let cmd = "forfiles /p \"" + replace(pattern, "/", "\\") + "\" /s /c \"cmd /c echo @path:::@fsize\" 2>NUL"
    let r = shell(cmd)
    let out_str = try3 { dict_get(r, "stdout") } { "" }
    let lines = split(out_str, "\n")
    let files = []
    let total = 0
    for3 line in lines {
        let l = trim(line)
        if3 len(l) > 3 {
            let parts = split(l, ":::")
            if3 len(parts) >= 2 {
                if3 len(files) < max_n {
                    let fp = trim(replace(parts[0], "\"", ""))
                    let sz = try3 { to_int(trim(parts[1])) } { 0 }
                    let fe = {}
                    fe = dict_set(fe, "path", replace(fp, "\\", "/"))
                    fe = dict_set(fe, "size", sz)
                    files = append(files, fe)
                    total = total + sz
                }
            }
        }
    }
    let out = {}
    out = dict_set(out, "files", files)
    out = dict_set(out, "count", len(files))
    out = dict_set(out, "total_bytes", total)
    print(json_encode(out))

} else3 op == "glob_recent" {
    // Find recent files: tfileops.nova glob_recent <path> <max>
    let path = try3 { args()[1] } { "C:/NovaX" }
    let max_n = try3 { to_int(args()[2]) } { 20 }
    let cmd = "forfiles /p \"" + replace(path, "/", "\\") + "\" /s /c \"cmd /c echo @path:::@fdate @ftime:::@fsize\" 2>NUL"
    let r = shell(cmd)
    let out_str = try3 { dict_get(r, "stdout") } { "" }
    let lines = split(out_str, "\n")
    let files = []
    for3 line in lines {
        let l = trim(line)
        if3 len(l) > 3 {
            let parts = split(l, ":::")
            if3 len(parts) >= 3 {
                if3 len(files) < max_n {
                    let fp = trim(replace(parts[0], "\"", ""))
                    let fe = {}
                    fe = dict_set(fe, "path", replace(fp, "\\", "/"))
                    fe = dict_set(fe, "modified", trim(parts[1]))
                    fe = dict_set(fe, "size", try3 { to_int(trim(parts[2])) } { 0 })
                    files = append(files, fe)
                }
            }
        }
    }
    let out = {}
    out = dict_set(out, "files", files)
    out = dict_set(out, "count", len(files))
    print(json_encode(out))

} else3 op == "file_stats" {
    // File statistics: tfileops.nova file_stats <path>
    let path = try3 { args()[1] } { "" }
    let content = try3 { read_file(path) } { "" }
    let bytes_count = len(content)
    let lines_arr = split(content, "\n")
    let line_count = len(lines_arr)
    let words = split(content, " ")
    let word_count = len(words)
    let blank_count = 0
    let max_ll = 0
    let total_ll = 0
    for3 ln in lines_arr {
        let ll = len(ln)
        total_ll = total_ll + ll
        if3 ll > max_ll { max_ll = ll }
        if3 len(trim(ln)) == 0 { blank_count = blank_count + 1 }
    }
    let avg_ll = 0
    if3 line_count > 0 { avg_ll = round(total_ll / line_count, 1) }
    let out = {}
    out = dict_set(out, "bytes", bytes_count)
    out = dict_set(out, "lines", line_count)
    out = dict_set(out, "words", word_count)
    out = dict_set(out, "chars", len(content))
    out = dict_set(out, "entropy", 0)
    out = dict_set(out, "blank_lines", blank_count)
    out = dict_set(out, "avg_line_length", avg_ll)
    out = dict_set(out, "max_line_length", max_ll)
    print(json_encode(out))

} else3 op == "diff" {
    // Line-by-line diff: tfileops.nova diff <file_a> <file_b>
    let fa = try3 { args()[1] } { "" }
    let fb = try3 { args()[2] } { "" }
    let ca = try3 { read_file(fa) } { "" }
    let cb = try3 { read_file(fb) } { "" }
    let la = split(ca, "\n")
    let lb = split(cb, "\n")
    let ml = len(la)
    if3 len(lb) > ml { ml = len(lb) }
    let diffs = []
    let add = 0
    let rem = 0
    let chg = 0
    let i = 0
    while3 i < ml {
        let a_line = ""
        let b_line = ""
        if3 i < len(la) { a_line = la[i] }
        if3 i < len(lb) { b_line = lb[i] }
        if3 a_line != b_line {
            if3 i >= len(la) {
                let de = {}
                de = dict_set(de, "line", i + 1)
                de = dict_set(de, "type", "added")
                de = dict_set(de, "content", b_line)
                if3 len(diffs) < 100 { diffs = append(diffs, de) }
                add = add + 1
            } else3 i >= len(lb) {
                let de = {}
                de = dict_set(de, "line", i + 1)
                de = dict_set(de, "type", "removed")
                de = dict_set(de, "content", a_line)
                if3 len(diffs) < 100 { diffs = append(diffs, de) }
                rem = rem + 1
            } else3 {
                let de = {}
                de = dict_set(de, "line", i + 1)
                de = dict_set(de, "type", "changed")
                de = dict_set(de, "old", a_line)
                de = dict_set(de, "new", b_line)
                if3 len(diffs) < 100 { diffs = append(diffs, de) }
                chg = chg + 1
            }
        }
        i = i + 1
    }
    let out = {}
    out = dict_set(out, "diffs", diffs)
    out = dict_set(out, "added", add)
    out = dict_set(out, "removed", rem)
    out = dict_set(out, "changed", chg)
    out = dict_set(out, "lines_a", len(la))
    out = dict_set(out, "lines_b", len(lb))
    print(json_encode(out))

} else3 op == "find_files" {
    // Find files matching pattern: tfileops.nova find_files <path> <pattern>
    let path = try3 { args()[1] } { "C:/NovaX" }
    let pattern = try3 { args()[2] } { "*" }
    let cmd = "dir /s /b \"" + replace(path, "/", "\\") + "\\" + pattern + "\" 2>NUL"
    let r = shell(cmd)
    let out_str = try3 { dict_get(r, "stdout") } { "" }
    let lines = split(out_str, "\n")
    let files = []
    for3 line in lines {
        let f = trim(line)
        if3 len(f) > 2 {
            files = append(files, replace(f, "\\", "/"))
        }
    }
    let out = {}
    out = dict_set(out, "files", files)
    out = dict_set(out, "count", len(files))
    print(json_encode(out))

} else3 {
    print("{\"error\":\"unknown operation: " + op + "\",\"ops\":[\"tree\",\"glob_size\",\"glob_recent\",\"file_stats\",\"diff\",\"find_files\"]}")
}
