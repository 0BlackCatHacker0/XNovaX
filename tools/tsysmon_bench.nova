// tsysmon_bench.nova - CPU benchmark micro-tool
// Usage: novalang.exe tools/tsysmon_bench.nova <duration_seconds>
// Returns JSON: {ok, hashes, duration_s, hash_rate, data_size_bytes}
// Replaces Python hashlib benchmark (zero Python)
// Uses string concatenation loop as CPU workload

import3("C:/NovaX/lib/nova_stdlib.nova")

let duration = try3 { to_int(args()[0]) } { 3 }
if3 duration < 1 { duration = 1 }
if3 duration > 30 { duration = 30 }

let t0 = time()
let deadline = t0 + duration
let count = 0
let data = "novax-bench-data-13"

// CPU-intensive loop: string operations as workload
while3 time() < deadline {
    let h = str(len(data + str(count) + data + str(count + 1)))
    let h2 = replace(data, "13", str(count))
    count = count + 1
}

let dt = time() - t0
let rate = 0
if3 dt > 0.001 {
    rate = to_int(count / dt)
}

let out = {}
out = dict_set(out, "ok", true)
out = dict_set(out, "hashes", count)
out = dict_set(out, "duration_s", round(dt, 3))
out = dict_set(out, "hash_rate", rate)
out = dict_set(out, "data_size_bytes", len(data))

print(json_encode(out))
