// Return the best piece (model) per Go territory based on win/loss score

fn3 main() {
    try3 {
        let raw = read_file("C:/NovaX/data/go_pieces.json")
        let data = parse_json(raw)
        let pieces = dict_get(data, "pieces") ?? {}
        let best = {}
        let piece_keys = dict_keys(pieces)

        for3 (key in piece_keys) {
            let piece = dict_get(pieces, key)
            let terr = dict_get(piece, "territory") ?? ""
            let wins = dict_get(piece, "wins") ?? 0
            let losses = dict_get(piece, "losses") ?? 0
            let score = wins - losses
            let active = dict_get(piece, "active") ?? 1

            if3 (active == 0) {
                // skip inactive
            } else3 {
                let current_best = dict_get(best, terr)
                if3 (current_best == null || score > (dict_get(current_best, "score") ?? -999999)) {
                    best = dict_set(best, terr, {
                        "provider": dict_get(piece, "provider") ?? "",
                        "model": dict_get(piece, "model") ?? "",
                        "territory": terr,
                        "max_tokens": dict_get(piece, "max_tokens") ?? 8192,
                        "wins": wins,
                        "losses": losses,
                        "score": score
                    })
                }
            }
        }

        print(to_json({"ok": 1, "best_per_territory": best, "territories": len(dict_keys(best))}))
    } catch3 (e) {
        print(to_json({"ok": 0, "error": "no pieces file"}))
    }
}

main()
