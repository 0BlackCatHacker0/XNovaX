// NovaX Full-Spectrum Ability Scanner
// Scans ALL NovaX capabilities and classifies them into ability categories
// Based on cymatics research: each unique ability is a resonant mode
// H3=3 modes, H5=5 modes, H7=7 modes, H13=13 modes

fn3 fetch_json(url, timeout) {
    let result = http_get(url)
    if3 (result == null) {
        return3 null
    } else3 {
        return3 parse_json(result)
    }
}

fn3 scan_ai_abilities() {
    // H3 layer: AI model abilities from Model Registry
    let data = fetch_json("http://127.0.0.1:9860/models/stats", 5)
    if3 (data == null) {
        return3 {}
    } else3 {
        return3 dict_get(data, "ability_matrix") ?? {}
    }
}

fn3 scan_engine_abilities() {
    // H5 layer: NovaX engine capabilities (5 engines x 7 tools = 35 tools)
    let engines = [
        ["physics", 9850, ["vector", "force", "particle", "fluid", "collide", "field", "solve"]],
        ["microsoft", 9851, ["windows", "registry", "process", "system", "theme", "clipboard", "notify"]],
        ["rendering", 9852, ["ascii", "chart", "svg", "canvas", "color", "layout", "scene"]],
        ["simulation", 9853, ["automata", "agents", "monte", "network", "evolve", "terrain", "swarm"]],
        ["audio", 9854, ["wave", "freq", "synth", "envelope", "filter", "rhythm", "encode"]]
    ]
    let abilities = {}
    for3 (eng in engines) {
        let name = eng[0]
        let port = eng[1]
        let tools = eng[2]
        let health = fetch_json("http://127.0.0.1:" + str(port) + "/health", 5)
        if3 (health != null) {
            abilities = dict_set(abilities, name, len(tools))
        }
    }
    return3 abilities
}

fn3 scan_infrastructure_abilities() {
    // H7 layer: Infrastructure service capabilities
    let infra_map = [
        ["caching", [9956, 9886]],
        ["routing", [9963, 9979]],
        ["encryption", [9892]],
        ["compression", [9972, 9893]],
        ["scheduling", [9959, 9910]],
        ["monitoring", [9905, 9950, 9953]],
        ["testing", [9934, 9933]]
    ]
    let abilities = {}
    for3 (item in infra_map) {
        let name = item[0]
        let ports = item[1]
        let alive = 0
        for3 (port in ports) {
            let health = fetch_json("http://127.0.0.1:" + str(port) + "/health", 5)
            if3 (health != null) {
                alive = alive + 1
            }
        }
        if3 (alive > 0) {
            abilities = dict_set(abilities, name, alive)
        }
    }
    return3 abilities
}

fn3 scan_extended_abilities() {
    // H13 layer: Extended spectrum capabilities
    let extended_map = [
        ["search", [9903]], ["embedding", [9960]], ["streaming", [9955, 9998]],
        ["mesh", [9951, 9882]], ["sync", [9976]], ["pipeline", [9966, 9927]],
        ["graph", [9958]], ["queue", [9957]], ["resilience", [9948, 9984]],
        ["security", [9907, 9987, 9952]], ["intelligence", [9924, 9990]],
        ["data", [9928, 9916, 9917]], ["media", [9908, 9918, 9922]],
        ["text", [9923, 9920, 9921]], ["networking", [9906, 9919]],
        ["devops", [9913, 9914, 9915]], ["orchestration", [9999, 9869]],
        ["audit", [9974, 9964]], ["memory", [9978]], ["notification", [9975]],
        ["profiling", [9980]], ["replay", [9937]], ["documentation", [9935]],
        ["configuration", [9932, 9941]], ["locking", [9981]], ["diffing", [9973]],
        ["snapshot", [9965]]
    ]
    let abilities = {}
    for3 (item in extended_map) {
        let name = item[0]
        let ports = item[1]
        let alive = 0
        for3 (port in ports) {
            let health = fetch_json("http://127.0.0.1:" + str(port) + "/health", 5)
            if3 (health != null) {
                alive = alive + 1
            }
        }
        if3 (alive > 0) {
            abilities = dict_set(abilities, name, alive)
        }
    }
    return3 abilities
}

fn3 scan_swarm_abilities() {
    // Hivemind and multi-model swarm capabilities
    let abilities = {}
    let hive = fetch_json("http://127.0.0.1:9881/health", 5)
    if3 (hive != null) {
        abilities = dict_set(abilities, "swarm", 1)
        abilities = dict_set(abilities, "deliberation", 1)
    }
    let cl = fetch_json("http://127.0.0.1:9888/health", 5)
    if3 (cl != null) {
        abilities = dict_set(abilities, "feedback", 1)
    }
    let mp = fetch_json("http://127.0.0.1:9889/health", 5)
    if3 (mp != null) {
        abilities = dict_set(abilities, "alignment", 1)
    }
    return3 abilities
}

fn3 merge_abilities(sources) {
    let all_abilities = {}
    for3 (source in sources) {
        let keys = dict_keys(source)
        for3 (k in keys) {
            let existing = dict_get(all_abilities, k) ?? 0
            let new_val = dict_get(source, k) ?? 0
            all_abilities = dict_set(all_abilities, k, existing + new_val)
        }
    }
    return3 all_abilities
}

fn3 sum_values(d) {
    let total = 0
    let keys = dict_keys(d)
    for3 (k in keys) {
        total = total + (dict_get(d, k) ?? 0)
    }
    return3 total
}

// Main scan
let ai = scan_ai_abilities()
let engines = scan_engine_abilities()
let infra = scan_infrastructure_abilities()
let extended = scan_extended_abilities()
let swarm = scan_swarm_abilities()

let all_abilities = merge_abilities([ai, engines, infra, extended, swarm])
let total = sum_values(all_abilities)

let result = {
    "ok": true,
    "abilities": all_abilities,
    "count": len(dict_keys(all_abilities)),
    "total": total,
    "breakdown": {
        "ai": {"count": len(dict_keys(ai)), "total": sum_values(ai)},
        "engines": {"count": len(dict_keys(engines)), "total": sum_values(engines)},
        "infra": {"count": len(dict_keys(infra)), "total": sum_values(infra)},
        "extended": {"count": len(dict_keys(extended)), "total": sum_values(extended)},
        "swarm": {"count": len(dict_keys(swarm)), "total": sum_values(swarm)}
    }
}
print(to_json(result))
