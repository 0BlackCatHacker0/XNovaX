// tsec_scandir.nova - Security directory scanner micro-tool
// Usage: novalang.exe tools/tsec_scandir.nova <path> [max_depth]
// Returns JSON: {total_files, dangerous_count, large_count, dotfile_count, error_count, dangerous[], large[], dotfiles[], errors[]}
// Replaces dynamically-generated tsec_scandir.py (zero Python)

import3("C:/NovaX/lib/nova_stdlib.nova")

let path = try3 { args()[0] } { "C:/NovaX" }
let max_depth = try3 { to_int(args()[1]) } { 3 }

let DANGEROUS = ".exe .bat .cmd .com .scr .pif .vbs .js .wsh .ps1 .msi .dll .wsf .hta"

// Get file listing with sizes via forfiles
let cmd = "forfiles /p \"" + path + "\" /s /c \"cmd /c echo @path:::@fsize:::@ext\" 2>NUL"
let result = shell(cmd)
let stdout = try3 { dict_get(result, "stdout") } { "" }
let lines = split(stdout, "\n")

let total = 0
let dangerous = []
let large = []
let dotfiles = []
let errors = []

for3 line in lines {
    let l = trim(line)
    if3 len(l) > 3 {
        let parts = split(l, ":::")
        if3 len(parts) >= 3 {
            total = total + 1
            if3 total > 2000 {
            } else3 {
                let fp = trim(replace(parts[0], "\"", ""))
                let fsize = try3 { to_int(trim(parts[1])) } { 0 }
                let ext = lower(trim(replace(parts[2], "\"", "")))

                // Get filename from path
                let path_parts = split(replace(fp, "\\", "/"), "/")
                let fname = path_parts[len(path_parts) - 1]

                // Check dangerous extension
                if3 contains(DANGEROUS, ext) {
                    if3 len(dangerous) < 20 {
                        let entry = {}
                        entry = dict_set(entry, "path", replace(fp, "\\", "/"))
                        entry = dict_set(entry, "ext", ext)
                        dangerous = append(dangerous, entry)
                    }
                }

                // Check large file (>100MB)
                if3 fsize > 104857600 {
                    if3 len(large) < 20 {
                        let entry = {}
                        entry = dict_set(entry, "path", replace(fp, "\\", "/"))
                        entry = dict_set(entry, "size", fsize)
                        large = append(large, entry)
                    }
                }

                // Check dotfile
                if3 starts_with(fname, ".") {
                    if3 len(dotfiles) < 20 {
                        let entry = {}
                        entry = dict_set(entry, "path", replace(fp, "\\", "/"))
                        entry = dict_set(entry, "name", fname)
                        dotfiles = append(dotfiles, entry)
                    }
                }
            }
        }
    }
}

let out = {}
out = dict_set(out, "total_files", total)
out = dict_set(out, "dangerous_count", len(dangerous))
out = dict_set(out, "large_count", len(large))
out = dict_set(out, "dotfile_count", len(dotfiles))
out = dict_set(out, "error_count", len(errors))
out = dict_set(out, "dangerous", dangerous)
out = dict_set(out, "large", large)
out = dict_set(out, "dotfiles", dotfiles)
out = dict_set(out, "errors", errors)

print(json_encode(out))
