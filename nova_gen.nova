// ═══════════════════════════════════════════════════════════════════
// nova_gen.nova — NovaLang Self-Generation Engine v1.0.0
// ═══════════════════════════════════════════════════════════════════
// Nova writes Nova. Quantum self-extending code factory.
// Takes problem descriptions → generates .nova micro-tools/wrappers/services.
// Uses N-S Reynolds to tune complexity. Ternary throughout.
// ═══════════════════════════════════════════════════════════════════

import3("C:/NovaX/lib/nova_stdlib.nova")
import3("C:/NovaX/lib/nova_http_utils.nova")
import3("C:/NovaX/lib/nova_ns_core.nova")

let PORT = 9936
let VERSION = "1.0.0"
let server = tserve(PORT, "Nova Gen")
let _ns = ns_init_counters()
let _gen_count = 0
let _gen_history = []

// ═══════════════════════════════════════════════════════════════════
// TEMPLATE LIBRARY — NovaLang code patterns as strings
// ═══════════════════════════════════════════════════════════════════

// ── Base imports all services need ──
let TPL_IMPORTS = "// -- Shared Libraries (N-S Flow) --\nimport3(\"C:/NovaX/lib/nova_ns_core.nova\")\nimport3(\"C:/NovaX/lib/nova_stdlib.nova\")\nimport3(\"C:/NovaX/lib/nova_http_utils.nova\")\n\n"

// ── Health endpoint template ──
fn tpl_health(name, ver, port_num) {
    let h = "fn handle_health(req) {\n"
    h = h + "    let resp = ns_health_dict(\"" + name + "\", \"" + ver + "\", " + str(port_num) + ", _ns)\n"
    h = h + "    return resp\n"
    h = h + "}\n\n"
    return h
}

// ── Micro-tool function template ──
// Returns +1 (success), 0 (uncertain), -1 (failure)
fn tpl_microtool_fn(fn_name, description, input_field) {
    let code = "// " + description + "\n"
    code = code + "fn " + fn_name + "(input) {\n"
    code = code + "    let val = dict_get(input, \"" + input_field + "\", \"\")\n"
    code = code + "    if3 len(str(val)) == 0 {\n"
    code = code + "        return make_err(\"missing " + input_field + "\")\n"
    code = code + "    }\n"
    code = code + "    // ── Core logic (quantum gate) ──\n"
    code = code + "    let result = try3 {\n"
    code = code + "        // TODO: Implement " + description + "\n"
    code = code + "        make_ok({\"" + input_field + "\": val, \"trit\": 1})\n"
    code = code + "    } {\n"
    code = code + "        make_err(\"" + fn_name + " failed\")\n"
    code = code + "    }\n"
    code = code + "    return result\n"
    code = code + "}\n\n"
    return code
}

// ── HTTP handler template ──
fn tpl_handler(handler_name, fn_name) {
    let code = "fn " + handler_name + "(req) {\n"
    code = code + "    _ns = ns_record(_ns, 0, 0)\n"
    code = code + "    let body = parse_body(req)\n"
    code = code + "    let result = " + fn_name + "(body)\n"
    code = code + "    let trit = dict_get(result, \"trit\", 0)\n"
    code = code + "    if3 trit == -1 {\n"
    code = code + "        _ns = ns_record(_ns, 0, 1)\n"
    code = code + "    }\n"
    code = code + "    return json_ok(result)\n"
    code = code + "}\n\n"
    return code
}

// ── Route registration template ──
fn tpl_route(method, path, handler_name) {
    return "troute(server, \"" + method + "\", \"" + path + "\", \"" + handler_name + "\")\n"
}

// ── Wrapper function template (wraps external HTTP service) ──
fn tpl_wrapper_fn(fn_name, target_url, target_path, description) {
    let code = "// " + description + "\n"
    code = code + "fn " + fn_name + "(input) {\n"
    code = code + "    let url = \"" + target_url + target_path + "\"\n"
    code = code + "    let payload = json_encode(input)\n"
    code = code + "    let resp = try3 {\n"
    code = code + "        http_post(url, payload, {\"Content-Type\": \"application/json\"})\n"
    code = code + "    } {\n"
    code = code + "        return make_err(\"wrapper call failed: " + fn_name + "\")\n"
    code = code + "    }\n"
    code = code + "    let status = dict_get(resp, \"status\", 0)\n"
    code = code + "    if3 status >= 200 {\n"
    code = code + "        if3 status < 300 {\n"
    code = code + "            let body = try3 { json_decode(dict_get(resp, \"body\", \"{}\")) } { {} }\n"
    code = code + "            return make_ok(body)\n"
    code = code + "        }\n"
    code = code + "    }\n"
    code = code + "    return make_err(\"HTTP \" + str(status))\n"
    code = code + "}\n\n"
    return code
}

// ═══════════════════════════════════════════════════════════════════
// N-S COMPLEXITY SELECTOR — Reynolds determines generation depth
// ═══════════════════════════════════════════════════════════════════

fn ns_complexity(reynolds) {
    // Laminar (Re < 27) = simple micro-tool, single function
    // Transitional (27-343) = wrapper with error handling + health
    // Turbulent (Re > 343) = full service with multiple endpoints
    if3 reynolds < 27 {
        return "microtool"
    }
    if3 reynolds < 343 {
        return "wrapper"
    }
    return "service"
}

// ═══════════════════════════════════════════════════════════════════
// GENERATORS — Build complete .nova source code
// ═══════════════════════════════════════════════════════════════════

fn gen_microtool(name, description, input_field) {
    let code = "// ═══ " + name + " ═══\n"
    code = code + "// Generated by nova_gen.nova v" + VERSION + "\n"
    code = code + "// Type: micro-tool (laminar complexity)\n"
    code = code + "// " + description + "\n"
    code = code + "// ═══════════════════════════════════════════\n\n"
    code = code + TPL_IMPORTS
    code = code + "let _ns = ns_init_counters()\n\n"
    code = code + tpl_microtool_fn(name, description, input_field)
    code = code + "// ── Direct execution ──\n"
    code = code + "// Call " + name + "({\"" + input_field + "\": value}) to use\n"
    code = code + "print(\"[" + name + "] Micro-tool loaded\")\n"
    return code
}

fn gen_wrapper(name, description, target_url, target_path, port_num) {
    let code = "// ═══ " + name + " ═══\n"
    code = code + "// Generated by nova_gen.nova v" + VERSION + "\n"
    code = code + "// Type: wrapper (transitional complexity)\n"
    code = code + "// " + description + "\n"
    code = code + "// ═══════════════════════════════════════════\n\n"
    code = code + TPL_IMPORTS
    code = code + "let PORT = " + str(port_num) + "\n"
    code = code + "let server = tserve(PORT, \"" + name + "\")\n"
    code = code + "let _ns = ns_init_counters()\n\n"
    code = code + tpl_health(name, "1.0.0", port_num)
    code = code + tpl_wrapper_fn(name + "_call", target_url, target_path, description)
    code = code + tpl_handler("handle_" + name, name + "_call")
    code = code + "// ── Routes ──\n"
    code = code + tpl_route("GET", "/health", "handle_health")
    code = code + tpl_route("POST", "/" + name, "handle_" + name)
    code = code + "\nprint(\"[" + name + "] Wrapper service on port " + str(port_num) + "\")\n"
    code = code + "tstart(server)\n"
    return code
}

fn gen_service(name, description, port_num, endpoints) {
    let code = "// ═══ " + name + " ═══\n"
    code = code + "// Generated by nova_gen.nova v" + VERSION + "\n"
    code = code + "// Type: full service (turbulent complexity)\n"
    code = code + "// " + description + "\n"
    code = code + "// ═══════════════════════════════════════════\n\n"
    code = code + TPL_IMPORTS
    code = code + "let PORT = " + str(port_num) + "\n"
    code = code + "let server = tserve(PORT, \"" + name + "\")\n"
    code = code + "let _ns = ns_init_counters()\n\n"
    code = code + tpl_health(name, "1.0.0", port_num)

    // Generate each endpoint
    let i = 0
    while3 i < len(endpoints) {
        let ep = endpoints[i]
        let ep_name = dict_get(ep, "name") ?? "action" + str(i)
        let ep_desc = dict_get(ep, "description") ?? "endpoint " + str(i)
        let ep_field = dict_get(ep, "input_field") ?? "data"
        let ep_method = dict_get(ep, "method") ?? "POST"
        let ep_path = dict_get(ep, "path") ?? "/" + ep_name

        code = code + tpl_microtool_fn(ep_name, ep_desc, ep_field)
        code = code + tpl_handler("handle_" + ep_name, ep_name)
        code = code + tpl_route(ep_method, ep_path, "handle_" + ep_name)
        i = i + 1
    }

    code = code + "\n// ── Core routes ──\n"
    code = code + tpl_route("GET", "/health", "handle_health")
    code = code + "\nprint(\"[" + name + "] Full service on port " + str(port_num) + "\")\n"
    code = code + "tstart(server)\n"
    return code
}

// ═══════════════════════════════════════════════════════════════════
// MASTER GENERATOR — Auto-selects complexity via N-S Reynolds
// ═══════════════════════════════════════════════════════════════════

fn generate(spec) {
    let name = dict_get(spec, "name") ?? "unnamed_tool"
    let description = dict_get(spec, "description") ?? "auto-generated tool"
    let input_field = dict_get(spec, "input_field") ?? "data"
    let force_type = dict_get(spec, "type") ?? "auto"
    let port_num = dict_get(spec, "port") ?? 0
    let target_url = dict_get(spec, "target_url") ?? ""
    let target_path = dict_get(spec, "target_path") ?? "/"
    let endpoints = dict_get(spec, "endpoints") ?? []

    // N-S complexity selection
    let re = ns_reynolds(_ns)
    let complexity = ns_complexity(re)
    if3 force_type != "auto" {
        complexity = force_type
    }

    // Sequential if3 instead of match3 to avoid scoping gotcha
    let code = ""
    if3 complexity == "microtool" {
        code = gen_microtool(name, description, input_field)
    }
    if3 complexity == "wrapper" {
        if3 port_num == 0 { port_num = 9940 }
        code = gen_wrapper(name, description, target_url, target_path, port_num)
    }
    if3 complexity == "service" {
        if3 port_num == 0 { port_num = 9940 }
        code = gen_service(name, description, port_num, endpoints)
    }
    if3 len(code) == 0 {
        code = gen_microtool(name, description, input_field)
    }

    // Write to file
    let filename = "C:/NovaX/gen/" + name + ".nova"
    let write_ok = try3 {
        write_file(filename, code)
        1
    } fail {
        0
    }

    _gen_count = _gen_count + 1
    let entry = {
        "name": name,
        "type": complexity,
        "file": filename,
        "written": write_ok,
        "reynolds": re,
        "lines": len(split(code, "\n"))
    }
    _gen_history = append(_gen_history, entry)

    return {
        "trit": write_ok,
        "name": name,
        "type": complexity,
        "file": filename,
        "code": code,
        "lines": len(split(code, "\n")),
        "reynolds": re,
        "regime": ns_regime(re),
        "written": write_ok
    }
}

// ═══════════════════════════════════════════════════════════════════
// HTTP HANDLERS
// ═══════════════════════════════════════════════════════════════════

fn handle_health(req) {
    return ns_health_dict("nova-gen", VERSION, PORT, _ns)
}

fn handle_generate(req) {
    _ns = ns_record(_ns, 0, 0)
    let body = parse_body(req)
    let name = dict_get(body, "name") ?? ""
    if3 len(name) == 0 {
        _ns = ns_record(_ns, 0, 1)
        return json_ok(make_err("missing 'name' field"))
    }
    let result = generate(body)
    let trit = dict_get(result, "trit") ?? 0
    if3 trit == 0 {
        _ns = ns_record(_ns, 0, 1)
    }
    return json_ok(result)
}

fn handle_gen_microtool(req) {
    _ns = ns_record(_ns, 0, 0)
    let body = parse_body(req)
    body = dict_set(body, "type", "microtool")
    let name = dict_get(body, "name") ?? ""
    if3 len(name) == 0 {
        return json_ok(make_err("missing 'name' field"))
    }
    let result = generate(body)
    return json_ok(result)
}

fn handle_gen_wrapper(req) {
    _ns = ns_record(_ns, 0, 0)
    let body = parse_body(req)
    body = dict_set(body, "type", "wrapper")
    let name = dict_get(body, "name") ?? ""
    if3 len(name) == 0 {
        return json_ok(make_err("missing 'name' field"))
    }
    let result = generate(body)
    return json_ok(result)
}

fn handle_gen_service(req) {
    _ns = ns_record(_ns, 0, 0)
    let body = parse_body(req)
    body = dict_set(body, "type", "service")
    let name = dict_get(body, "name") ?? ""
    if3 len(name) == 0 {
        return json_ok(make_err("missing 'name' field"))
    }
    let result = generate(body)
    return json_ok(result)
}

fn handle_history(req) {
    return json_ok({
        "total_generated": _gen_count,
        "history": _gen_history,
        "reynolds": ns_reynolds(_ns),
        "regime": ns_regime(ns_reynolds(_ns))
    })
}

fn handle_templates(req) {
    return json_ok({
        "available": ["microtool", "wrapper", "service"],
        "description": {
            "microtool": "Single function returning +1/0/-1. Laminar complexity.",
            "wrapper": "HTTP wrapper around external service. Transitional complexity.",
            "service": "Full service with multiple endpoints. Turbulent complexity."
        },
        "ns_auto": "When type=auto, Reynolds number selects complexity: <27=microtool, 27-343=wrapper, >343=service"
    })
}

// ═══════════════════════════════════════════════════════════════════
// ROUTES
// ═══════════════════════════════════════════════════════════════════

troute(server, "GET",  "/health",        "handle_health")
troute(server, "POST", "/generate",      "handle_generate")
troute(server, "POST", "/gen/microtool", "handle_gen_microtool")
troute(server, "POST", "/gen/wrapper",   "handle_gen_wrapper")
troute(server, "POST", "/gen/service",   "handle_gen_service")
troute(server, "GET",  "/history",       "handle_history")
troute(server, "GET",  "/templates",     "handle_templates")

print("═══════════════════════════════════════════════════")
print("[nova-gen] NovaLang Self-Generation Engine v" + VERSION)
print("[nova-gen] Quantum code factory on port " + str(PORT))
print("[nova-gen] Templates: microtool | wrapper | service")
print("[nova-gen] N-S auto-complexity via Reynolds number")
print("═══════════════════════════════════════════════════")
tstart(server)
