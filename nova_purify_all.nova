// =================================================================
// NOVA PURIFY ALL — Convert EVERY Python File to Pure NovaLang
// =================================================================
// Fires conversion tasks to all 15 providers.
// Groups 118 Python files into 20 focused tasks.
// Each task generates complete .nova replacement code.
//
// Usage: novalang.exe nova_purify_all.nova
// =================================================================

import3("C:/NovaX/lib/nova_stdlib.nova")

let ROUTER = "http://127.0.0.1:9878/query"
let OUT = "C:/NovaX/purify_all"
shell("mkdir " + OUT + " 2>NUL")

let CTX = "You are converting Python code to pure NovaLang. NovaLang is a ternary-native language running on a Rust VM (novalang.exe). CRITICAL SYNTAX RULES: 1) if3 COND { } (NO parentheses around condition), 2) for3 item in list { }, 3) try3 { expr } { fallback } (NEVER return try3 inside if3 - assign to variable first), 4) dict_set(d,k,v) returns NEW dict - MUST reassign: d = dict_set(d,k,v), 5) append(l,item) returns NEW list - MUST reassign, 6) dict_get(d,key) only on dicts NOT lists - use brackets for lists: list[i], 7) http_post(url, json_encode(body)), 8) tserve(PORT,NAME) with troute(server,METHOD,PATH,HANDLER_NAME) for HTTP services, 9) handler receives req dict with body as raw string - MUST json_decode(req[body]), 10) return DICTS from handlers (auto-serialized to JSON), 11) No || or && operators (use nested if3), 12) shell() returns dict with ok,stdout,stderr,code, 13) write_file(path,content) and read_file(path), 14) import3(path), 15) Return dicts with 6+ keys MUST use dict_set chain (inline 6+ key dicts swallow next function), 16) Dict literals inside if3 blocks cause parser confusion - use helper functions, 17) TRUE/FALSE/MAYBE are reserved constants, 18) No semicolons - each statement on its own line. Service pattern: tserve(PORT,NAME) then troute() for each endpoint, then tstart(server). Every service needs GET /health returning ok:1."

let TASKS = [
    "core-ai-router: Convert C:/NovaX/core/ai_router.py to NovaLang. AI provider routing with cascade failover. Track provider stats in memory dict. POST /query routes to best provider. GET /health. This is the cloud router intelligence. Write complete .nova file.",

    "core-event-bus: Convert C:/NovaX/core/event_bus.py to NovaLang. Central pub/sub event system. POST /publish with topic,data. POST /subscribe with topic,callback_url. GET /events. Ternary classification: +1=success, 0=info, -1=error. Write complete .nova file.",

    "core-session-memory: Convert C:/NovaX/core/session_memory.py to NovaLang. POST /remember stores key-value. GET /recall retrieves. POST /save persists to JSON file. POST /load reads from disk. GET /history returns turns. Write complete .nova file.",

    "core-skills-engine: Convert C:/NovaX/core/skills_engine.py to NovaLang. POST /skills/match finds best skill by scanning C:/NovaX/skills/*.nova. GET /skills lists all. POST /skills/run executes a skill. Use read_file and split/contains for matching. Write complete .nova file.",

    "core-profile-mode: Convert core/profile_manager.py and core/mode_system.py to NovaLang. Two services: profile manager (port 9862) manages user profiles from C:/NovaX/profiles/. Mode system (port 9866) manages operational modes: dev, production, research, creative. Write two complete .nova files.",

    "core-task-vcc: Convert core/task_classifier.py and core/vcc.py to NovaLang. Task classifier (port 9863): POST /classify takes text, returns domain,trit,route by keyword matching. VCC (port 9864): GET /vcc/summary returns git status, POST /vcc/commit, GET /vcc/log, GET /vcc/diff via shell(git). Write two .nova files.",

    "core-conservation: Convert core/conservation_monitor.py to NovaLang. Port 9865. GET /resources returns cpu,memory,disk via shell. GET /budget tracks API token usage. POST /budget/add records spend. Ternary budget: +1=under, 0=near, -1=over. Write complete .nova file.",

    "core-workspace: Convert core/workspace_manager.py to NovaLang. Port 9867. GET /workspace returns current path. POST /workspace/set changes workspace. GET /workspace/files lists files. POST /workspace/scan indexes workspace. Write complete .nova file.",

    "core-persona-agent: Convert core/nova_persona.py and core/nova_agent.py to NovaLang. Persona manages personality traits and response styles. Agent handles autonomous task execution with tool selection. Both use tserve. Write two complete .nova files.",

    "core-persistence-state: Convert core/persistence.py, core/state.py, and core/config.py to NovaLang. Persistence saves/loads JSON data files. State manages runtime state dict. Config reads cloud_config.json and env vars. Write three complete .nova files as micro-services.",

    "core-repair-arbiter: Convert core/repair_engine.py and core/arbiter.py to NovaLang. Repair engine detects and fixes service failures using health3(). Arbiter mediates conflicts between services. Both use ternary scoring. Write two complete .nova files.",

    "tools-helpers: Convert these Python helper scripts to NovaLang: tools/tscan.py (file scanner), tools/tsize.py (size calculator), tools/classify_prompt.py (prompt classifier), tools/go_best.py (best provider selector). Each should be a standalone .nova script. Write all four.",

    "tools-hivemind: Convert hivemind_helper.py, tools/hivemind_batch_merge.py, tools/hivemind_model_inject.py, tools/hivemind_registry_sync.py to NovaLang. These help the hivemind service manage models and providers. Write all as standalone .nova scripts.",

    "tools-pacman: Convert tools/pacman_discover.py, tools/pacman_mega_discover.py, tools/pacman_stats.py, tools/pacman_boot_lock.py to NovaLang. Package manager discovery and stats tools. Write all as standalone .nova scripts.",

    "scripts-fleet: Convert scripts/fleet_audit.py, scripts/fleet_restart.py, scripts/check_all_novax_processes.py, scripts/kill_all_zombies.py to NovaLang. Fleet management scripts that use shell() for process control. Write all as standalone .nova scripts.",

    "scripts-dev: Convert scripts/nova_lint.py (code linter), scripts/brace_check.py (brace validator), scripts/rebuild_registry.py (registry builder), scripts/patch_registry.py (registry patcher) to NovaLang. Development tools. Write all as standalone .nova scripts.",

    "api-bridges: Convert cloud_api_call.py, audio_api_call.py, microsoft_api_call.py to NovaLang. These make HTTP API calls to external services. Use http_post with json_encode for request bodies, parse responses with json_decode. Write three complete .nova files.",

    "launcher-bridge: Convert launchers/nowindow.py (starts services without console windows using start /b) and launchers/uia_bridge.py (UI automation bridge). Write NovaLang replacements using shell(start /b) and shell() commands. Write two .nova files.",

    "swarm-scripts: Convert swarm_fire.py, swarm_direct_fire.py, swarm_max_run.py, max_run.py to NovaLang. These fire AI queries to multiple providers. Pattern: build body dict, http_post to router, parse response. Write all four as .nova scripts.",

    "core-misc: Convert core/context_watcher.py, core/time_index.py, core/tzip.py, core/dse.py, core/drivers.py, core/module_manager.py to NovaLang. Context watcher monitors conversation context. Time index tracks temporal events. TZip compresses ternary data. DSE is deep search engine. Drivers manages hardware. Module manager loads modules. Write six .nova micro-services."
]

let PROVIDERS = [
    "ollama", "openai", "anthropic", "google",
    "cerebras_direct", "sambanova_direct", "google_ai_studio",
    "openrouter", "mistral", "groq", "deepseek",
    "cohere", "together", "cortex", "novax-prime"
]

let total_hits = 0
let total_chars = 0

fn extract_text(parsed) {
    let r = try3 { dict_get(parsed, "result") } { {} }
    let inner_str = try3 { dict_get(r, "body") } { "{}" }
    let inner = try3 { json_decode(inner_str) } { {} }
    let text = try3 { dict_get(inner, "response") } { "" }
    if3 len(text) > 5 { return text }
    let choices = try3 { dict_get(inner, "choices") } { [] }
    if3 len(choices) > 0 {
        let first = choices[0]
        let msg = try3 { dict_get(first, "message") } { {} }
        let content = try3 { dict_get(msg, "content") } { "" }
        return content
    }
    ""
}

fn fire(task_desc, provider, task_id) {
    let body = {}
    body = dict_set(body, "prompt", CTX + "\n\nTASK: " + task_desc)
    body = dict_set(body, "provider", provider)
    body = dict_set(body, "max_tokens", 4096)

    let result = try3 { http_post(ROUTER, json_encode(body)) } { {} }
    let status = try3 { dict_get(result, "status") } { 0 }

    if3 status == 0 {
        print("  FAIL " + task_id + " | " + provider)
        return -1
    }

    let resp_body = try3 { dict_get(result, "body") } { "{}" }
    let parsed = try3 { json_decode(resp_body) } { {} }
    let ok = try3 { dict_get(parsed, "ok") } { 0 }

    if3 ok == 0 {
        print("  MISS " + task_id + " | " + provider + ": not ok")
        return 0
    }

    let text = extract_text(parsed)
    let tlen = len(text)

    if3 tlen > 100 {
        let save = {}
        save = dict_set(save, "task", task_id)
        save = dict_set(save, "provider", provider)
        save = dict_set(save, "chars", tlen)
        save = dict_set(save, "text", text)
        write_file(OUT + "/" + task_id + "_" + provider + ".json", json_encode(save))
        print("  HIT  " + task_id + " | " + provider + ": " + str(tlen) + " chars")
        return tlen
    }

    print("  MISS " + task_id + " | " + provider + ": short (" + str(tlen) + ")")
    return 0
}

print("=" * 65)
print("NOVA PURIFY ALL — 118 PYTHON FILES -> PURE NOVALANG")
print("Conversion tasks: " + str(len(TASKS)))
print("Providers: " + str(len(PROVIDERS)))
print("Target: Zero Python, 100% NovaLang")
print("=" * 65)

let tidx = 0
for3 task_desc in TASKS {
    let parts = split(task_desc, ":")
    let task_id = trim(parts[0])
    tidx = tidx + 1
    print("\n--- Convert " + str(tidx) + "/" + str(len(TASKS)) + ": " + task_id + " ---")

    for3 provider in PROVIDERS {
        let chars = fire(task_desc, provider, task_id)
        if3 chars > 0 {
            total_hits = total_hits + 1
            total_chars = total_chars + chars
        }
    }
}

print("\n" + "=" * 65)
print("PURIFY ALL COMPLETE")
print("Hits:  " + str(total_hits))
print("Chars: " + str(total_chars))
print("Files: " + OUT + "/")
print("=" * 65)
