// ── Cluster keyword classifier ───────────────────────────────────
let CLUSTER_KW = {
    "code": ["code", "function", "class", "debug", "error", "bug", "python", "javascript",
             "rust", "compile", "syntax", "refactor", "endpoint", "implement", "algorithm",
             "novalang", "write a function", "write code"],
    "reasoning": ["why", "analyze", "reason", "think", "logic", "compare", "evaluate",
                   "strategy", "plan", "design", "architecture", "tradeoff"],
    "math": ["calculate", "math", "equation", "formula", "integral", "derivative",
             "matrix", "vector", "probability", "proof", "theorem"],
    "vision": ["image", "picture", "photo", "screenshot", "visual", "diagram", "chart"]
}

fn classify(text) {
    let tl = lower(text)
    let best = "general"
    let best_score = 0
    let clusters = dict_keys(CLUSTER_KW)
    for3 i in range(len(clusters)) {
        let cname = clusters[i]
        let keywords = CLUSTER_KW[cname]
        let score = 0
        for3 k in range(len(keywords)) {
            let kw = keywords[k]
            if3 contains(tl, kw) {
                score = score + 1
            }
        }
        if3 score > best_score {
            best_score = score
            best = cname
        }
    }
    return best
}

// ── Build request dicts for swarm() ──────────────────────────────

// All cloud requests go through orchestrator's /api/ai/query (handles HTTPS+TLS)
let PROXY = "http://127.0.0.1:9999/api/ai/query"

fn build_cloud_req(prompt, sys, provider, model, timeout_ms) {
    // Messages: only user/assistant roles (Anthropic rejects system role in messages)
    // System prompt goes in separate "system" field — proxy handles per-provider routing
    let msgs = [{"role": "user", "content": prompt}]
    let body = json_encode({
        "provider": provider,
        "model": model,
        "messages": msgs,
        "system": sys,
        "max_tokens": 2048,
        "timeout": 15
    })
    return {
        "url": PROXY,
        "method": "POST",
        "body": body,
        "headers": json_encode({"Content-Type": "application/json"}),
        "timeout_ms": to_str(timeout_ms),
        "model": model
    }
}

fn build_ollama_req(prompt, sys, model, timeout_ms) {
    let msgs = []
    if3 len(sys) > 0 {
        msgs = append(msgs, {"role": "system", "content": sys})
    }
    msgs = append(msgs, {"role": "user", "content": prompt})
    let body = json_encode({"model": model, "messages": msgs, "stream": false})
    return {
        "url": join([OLLAMA, "/api/chat"], ""),
        "method": "POST",
        "body": body,
        "headers": json_encode({"Content-Type": "application/json"}),
        "timeout_ms": to_str(timeout_ms),
        "model": model
    }
}

// ── Build HuggingFace request (direct to HF Inference API) ───────
fn build_hf_req(prompt, model_id, timeout_ms) {
    let body = json_encode({"inputs": prompt})
    return {
        "url": join([HF_BASE, model_id], ""),
        "method": "POST",
        "body": body,
        "headers": json_encode({"Content-Type": "application/json"}),
        "timeout_ms": to_str(timeout_ms),
        "model": model_id
    }
}

