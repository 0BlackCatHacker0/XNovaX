// ── Unsolved N-S Endpoint ────────────────────────────────────────
// ── HuggingFace Hivemind Endpoints ───────────────────────────────

fn handle_hf_swarm(req) {
    let body = parse_body(req)
    let text = dict_get(body, "text") ?? ""
    let pipeline = dict_get(body, "pipeline") ?? "text-generation"
    let limit = to_num(dict_get(body, "limit") ?? 5)
    if3 len(text) == 0 { return json_err("no text") }

    // Get models for this pipeline from HF_CLUSTERS
    let cluster_map = {
        "text-generation": "general",
        "text2text-generation": "general",
        "text-classification": "classification",
        "summarization": "summarization",
        "translation": "translation",
        "question-answering": "qa",
        "feature-extraction": "embedding",
        "text-to-image": "image_gen",
        "automatic-speech-recognition": "speech",
        "zero-shot-classification": "zero_shot"
    }
    let cluster_name = dict_get(cluster_map, pipeline) ?? "general"
    let models = dict_get(HF_CLUSTERS, cluster_name) ?? []
    if3 limit < len(models) {
        models = slice(models, 0, limit)
    }

    // Fire all via swarm
    let result = hf_swarm(models, text)
    return json_ok(result)
}

fn handle_hf_discover(req) {
    let body = parse_body(req)
    let pipeline = dict_get(body, "pipeline") ?? "text-generation"
    let limit = to_num(dict_get(body, "limit") ?? 20)
    let result = hf_discover(pipeline, limit)
    return json_ok(result)
}

fn handle_hf_stats(req) {
    let stats = hf_trit_stats()
    let total = hf_total_models()
    let hf_cluster_keys = dict_keys(HF_CLUSTERS)
    let cluster_models = 0
    for3 i in range(len(hf_cluster_keys)) {
        let cmodels = dict_get(HF_CLUSTERS, hf_cluster_keys[i]) ?? []
        cluster_models = cluster_models + len(cmodels)
    }
    return json_ok({
        "trit": 1,
        "total_hf_models": total,
        "pipelines": len(dict_keys(HF_PIPELINES)),
        "hf_clusters": len(hf_cluster_keys),
        "cluster_models": cluster_models,
        "tested": dict_get(stats, "tested") ?? 0,
        "active": dict_get(stats, "active") ?? 0,
        "potential": dict_get(stats, "potential") ?? 0,
        "failed": dict_get(stats, "failed") ?? 0,
        "untested": total - dict_get(stats, "tested") ?? 0,
        "provider": "huggingface",
        "cost": 0,
        "api_key_required": false
    })
}

fn handle_hf_call(req) {
    let body = parse_body(req)
    let model = dict_get(body, "model") ?? ""
    let inputs = dict_get(body, "inputs") ?? dict_get(body, "text") ?? ""
    if3 len(model) == 0 { return json_err("missing model") }
    if3 len(inputs) == 0 { return json_err("missing inputs") }
    let result = hf_call(model, inputs)
    return json_ok(result)
}

fn handle_hf_pipelines(req) {
    let pipe_keys = dict_keys(HF_PIPELINES)
    let pipes = []
    let total = 0
    for3 i in range(len(pipe_keys)) {
        let k = pipe_keys[i]
        let p = dict_get(HF_PIPELINES, k) ?? {}
        let count = to_num(dict_get(p, "count") ?? 0)
        total = total + count
        pipes = append(pipes, {
            "pipeline": k,
            "models": count,
            "trit": to_num(dict_get(p, "trit") ?? 0)
        })
    }
    return json_ok({
        "trit": 1,
        "pipelines": pipes,
        "total_pipelines": len(pipe_keys),
        "total_models": total
    })
}

fn handle_ns_unsolved(req) {
    let re = ns_reynolds(_ns)
    let request_rate = dict_get(_ns, "requests") ?? 0
    let prev_rate = (dict_get(_ns, "total_requests") ?? 0) - request_rate
    let error_rate = dict_get(_ns, "errors") ?? 0
    let total_errors = dict_get(_ns, "total_errors") ?? 0

    // Smoothness (Millennium Prize analog)
    let smoothness = ns_smoothness_norm({
        "request_rate": request_rate,
        "prev_request_rate": prev_rate
    })

    // Vorticity (BKM singularity detection)
    let latency_var = abs_val((dict_get(_ns, "latency_sum") ?? 0) - request_rate * 100)
    let vorticity = ns_vorticity(to_num(error_rate), to_num(latency_var))

    // Energy conservation (Onsager)
    let total_reqs = dict_get(_ns, "total_requests") ?? 0
    let conservation = ns_energy_conservation(total_reqs * 100, total_reqs * 80, 1)

    // Kolmogorov cascade
    let cascade = ns_cascade_distribute(1000, 7)

    // Provider pressure gradients
    let pressures = [
        {"provider": "ollama", "pressure": 10},
        {"provider": "huggingface", "pressure": 5},
        {"provider": "openai", "pressure": 30},
        {"provider": "openrouter", "pressure": 50},
        {"provider": "anthropic", "pressure": 20}
    ]
    let separation = ns_pressure_gradient(pressures)

    return json_ok({
        "version": NS_UNSOLVED_VERSION,
        "reynolds": re,
        "regime": ns_regime(re),
        "millennium_prize": {
            "name": "Existence and Smoothness of N-S Solutions",
            "applied_as": "System flow singularity detection",
            "smoothness": smoothness,
            "status": "MONITORING"
        },
        "kolmogorov_cascade": {
            "name": "Kolmogorov 5/3 Energy Cascade",
            "applied_as": "Query energy distribution across model scales",
            "cascade": cascade,
            "status": "ACTIVE"
        },
        "beale_kato_majda": {
            "name": "BKM Singularity Criterion",
            "applied_as": "System crash prediction via vorticity tracking",
            "vorticity": vorticity,
            "status": "TRACKING"
        },
        "onsager_dissipation": {
            "name": "Onsager Energy Dissipation Conjecture",
            "applied_as": "Information loss detection in routing pipeline",
            "conservation": conservation,
            "status": "MEASURING"
        },
        "boundary_separation": {
            "name": "Boundary Layer Separation",
            "applied_as": "Provider degradation detection via pressure gradient",
            "separation": separation,
            "status": "MONITORING"
        },
        "trit": 1
    })
}

