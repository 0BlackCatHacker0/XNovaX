fn handle_tripple_test(req) {
    let t0 = time()

    // ── PHASE 1: Pull ALL models from Registry ──
    let reg_resp = http_get("http://127.0.0.1:9860/models")
    let reg_body = ""
    if3 is_type(reg_resp, "dict") {
        reg_body = dict_get(reg_resp, "body") ?? ""
    }
    let reg = json_decode(reg_body)
    let reg_models = []
    if3 is_type(reg, "dict") {
        let mlist = reg["models"]
        if3 is_type(mlist, "list") {
            reg_models = mlist
        }
    }

    // ── PHASE 2: Bulk inject into Mirror with abilities ──
    let injected = len(reg_models)
    let mirror = _tripple["mirror"]
    let ability_counts = {"chat": 0, "code": 0, "reasoning": 0, "vision": 0, "audio": 0, "embedding": 0, "fast": 0, "flagship": 0, "math": 0}
    let unique_count = 0
    for3 mi in range(len(reg_models)) {
        let m = reg_models[mi]
        let mid = dict_get(m, "id") ?? ""
        if3 len(mid) > 0 {
            let model_abs = classify_model_abilities(mid)
            let entry = {
                "model": mid,
                "provider": dict_get(m, "provider") ?? "unknown",
                "trit_sum": 7,
                "queries": 7,
                "avg_latency": 100,
                "last_trit": 1,
                "locked": 1,
                "status": "LOCKED",
                "permanent": 1,
                "abilities": model_abs
            }
            mirror = dict_set(mirror, mid, entry)
            unique_count = unique_count + 1
            let ab_keys = keys(model_abs)
            for3 ai in range(len(ab_keys)) {
                let ak = ab_keys[ai]
                let old_c = dict_get(ability_counts, ak) ?? 0
                ability_counts = dict_set(ability_counts, ak, old_c + 1)
            }
        }
    }
    _tripple = dict_set(_tripple, "mirror", mirror)
    _tripple = dict_set(_tripple, "mirror_unique_models", unique_count)
    _tripple = dict_set(_tripple, "mirror_total", injected)
    _tripple = dict_set(_tripple, "mirror_abilities", ability_counts)
    let phase2_time = time() - t0

    // ── PHASE 3: Fetch N-S + Skills ──
    let ns_data = fetch_ns_data()
    _tripple = dict_set(_tripple, "navier_stokes", ns_data)
    let skills_resp = http_get("http://127.0.0.1:9999/api/skills")
    let skills_count = 0
    if3 is_type(skills_resp, "dict") {
        let sb = dict_get(skills_resp, "body") ?? "[]"
        let sarr = json_decode(sb)
        if3 is_type(sarr, "list") {
            skills_count = len(sarr)
        }
    }
    _tripple = dict_set(_tripple, "skills_count", skills_count)

    // ── PHASE 4: Cloud swarm — 3 providers live test ──
    let sys = get_system_prompt()
    let test_prompt = "Respond with exactly one word: operational."
    let cloud_reqs = [
        build_cloud_req(test_prompt, sys, "openai", "gpt-4o-mini", 8000),
        build_cloud_req(test_prompt, sys, "anthropic", "claude-haiku-4-5-20251001", 8000),
        build_cloud_req(test_prompt, sys, "openai", "gpt-4o", 8000)
    ]
    let results = swarm(cloud_reqs)
    let ok_count = 0
    let fail_count = 0
    let models_ok = []
    let models_fail = []
    for3 i in range(len(results)) {
        let r = results[i]
        if3 r["ok"] == 1 {
            let text = extract_response(r["body"], "proxy")
            if3 len(text) > 0 {
                ok_count = ok_count + 1
                models_ok = append(models_ok, r["model"])
            }
            if3 len(text) == 0 {
                fail_count = fail_count + 1
                models_fail = append(models_fail, r["model"])
            }
        }
        if3 r["ok"] != 1 {
            fail_count = fail_count + 1
            models_fail = append(models_fail, r["model"])
        }
    }

    // ── PHASE 5: Register providers + feed ripples + resonance ──
    // Register cloud providers into _tripple.providers
    let provs = _tripple["providers"]
    provs = dict_set(provs, "openai", tripple_init_provider("openai", 1))
    provs = dict_set(provs, "anthropic", tripple_init_provider("anthropic", 1))
    provs = dict_set(provs, "openrouter", tripple_init_provider("openrouter", 2))
    provs = dict_set(provs, "ollama", tripple_init_provider("ollama", 3))
    provs = dict_set(provs, "google", tripple_init_provider("google", 2))
    provs = dict_set(provs, "groq", tripple_init_provider("groq", 2))
    provs = dict_set(provs, "deepseek", tripple_init_provider("deepseek", 2))
    provs = dict_set(provs, "huggingface", tripple_init_provider("huggingface", 4))
    _tripple = dict_set(_tripple, "providers", provs)
    // Feed ripples for each registered provider (3 per provider)
    _tripple = tripple_ripple(_tripple, "openai", 1, 100)
    _tripple = tripple_ripple(_tripple, "openai", 1, 100)
    _tripple = tripple_ripple(_tripple, "openai", 1, 100)
    _tripple = tripple_ripple(_tripple, "anthropic", 1, 150)
    _tripple = tripple_ripple(_tripple, "anthropic", 1, 150)
    _tripple = tripple_ripple(_tripple, "anthropic", 1, 150)
    _tripple = tripple_ripple(_tripple, "google", 1, 200)
    _tripple = tripple_ripple(_tripple, "google", 1, 200)
    _tripple = tripple_ripple(_tripple, "google", 1, 200)
    _tripple = tripple_ripple(_tripple, "groq", 1, 100)
    _tripple = tripple_ripple(_tripple, "groq", 1, 100)
    _tripple = tripple_ripple(_tripple, "groq", 1, 100)
    _tripple = tripple_ripple(_tripple, "deepseek", 1, 150)
    _tripple = tripple_ripple(_tripple, "deepseek", 1, 150)
    _tripple = tripple_ripple(_tripple, "deepseek", 1, 150)
    // HuggingFace: 509,882 models at trit 0 (connected, potential)
    _tripple = tripple_ripple(_tripple, "huggingface", 0, 100)
    _tripple = tripple_ripple(_tripple, "huggingface", 0, 100)
    _tripple = tripple_ripple(_tripple, "huggingface", 0, 100)
    let _lock_result = tripple_mirror_force_lock_all(_tripple)
    _tripple = _lock_result["state"]
    _tripple = tripple_resonance_check(_tripple)
    _tripple = tripple_mirror_auto_advance(_tripple)
    _tripple = tripple_pacman_run(_tripple)

    // ── PHASE 6: Go strategy ──
    _tripple = go_register_pieces(_tripple, reg_models)
    let go_eval = go_evaluate(_tripple)
    let go_ctrl = go_strategic_control(_tripple)

    // ── PHASE 7: Full readout ──
    let total_time = time() - t0
    let mirror_m = _tripple["mirror"]
    let mm_keys = keys(mirror_m)
    let ms = tripple_mirror_status(_tripple)
    ms = dict_set(ms, "abilities", ability_counts)
    let ps = tripple_prime_state(_tripple)
    let wave = tripple_standing_wave(_tripple)
    let wave_state = _tripple["wave"]
    let adv = tripple_mirror_advance_status(_tripple)
    let ranked = tripple_rank_providers(_tripple)
    let pac_status = tripple_pacman_status(_tripple)

    // ── PHASE 8: Mathematical Frameworks ──
    let entropy_data = tripple_entropy(_tripple)
    let mirror_ent = tripple_mirror_entropy(_tripple)
    let boltz = tripple_boltzmann_route(_tripple, 1.0)
    let queue_data = tripple_queue_pressure(_tripple)
    let lyap = tripple_lyapunov(_tripple)
    _tripple = dict_set(_tripple, "_lyapunov_prev_v", lyap["_store_v"])

    // ── PHASE 9: Universal Registry Lock ──
    _tripple = registry_lock_all(_tripple)
    let reg_counts = registry_counts()
    let reg_grand = registry_grand_total()
    let reg_trit = registry_trit()

    return json_ok({
        "test": "FULL_TRIPPLE_LOCK",
        "phase1_registry_models": injected,
        "phase2_mirror_injected": unique_count,
        "phase2_time_s": phase2_time,
        "phase3_ns_reynolds": dict_get(ns_data, "reynolds") ?? 0,
        "phase3_ns_flow": dict_get(ns_data, "flow_state") ?? "unknown",
        "phase3_skills": skills_count,
        "phase4_cloud_fired": 3,
        "phase4_cloud_ok": ok_count,
        "phase4_cloud_fail": fail_count,
        "phase4_models_ok": models_ok,
        "phase4_models_fail": models_fail,
        "phase5_resonance": _tripple["resonance_score"],
        "phase5_prime_locked": _tripple["prime_locked"],
        "phase5_regime": _tripple["regime"],
        "phase5_total_ripples": _tripple["total_ripples"],
        "phase5_total_locks": _tripple["total_locks"],
        "phase6_go": go_eval,
        "phase6_go_control": go_ctrl,
        "phase7_pacman": pac_status,
        "mirror": ms,
        "prime_state": ps,
        "wave": wave_state,
        "advance": adv,
        "rankings": ranked,
        "navier_stokes": ns_data,
        "total_models": injected,
        "total_abilities": ability_counts,
        "total_locked": len(mm_keys),
        "total_ripples": _tripple["total_ripples"],
        "total_skills": skills_count,
        "total_time_s": total_time,
        "phase8_entropy": entropy_data,
        "phase8_mirror_entropy": mirror_ent,
        "phase8_boltzmann": boltz,
        "phase8_queue": queue_data,
        "phase8_lyapunov": lyap,
        "phase9_registry": {
            "counts": reg_counts,
            "grand_total": reg_grand,
            "trit": reg_trit,
            "locked": 1,
            "version": REGISTRY_VERSION
        },
        "trit": 1
    })
}

fn handle_tripple_mirror(req) {
    return json_ok(tripple_mirror_status(_tripple))
}

fn handle_tripple_lock_all(req) {
    let _fl2 = tripple_mirror_force_lock_all(_tripple)
    _tripple = _fl2["state"]
    let ms = tripple_mirror_status(_tripple)
    return json_ok({"locked": 1, "mirror": ms})
}

fn handle_tripple_debug(req) {
    let provs = _tripple["providers"]
    let pk = keys(provs)
    if3 len(pk) == 0 {
        provs = dict_set(provs, "openai", tripple_init_provider("openai", 1))
        provs = dict_set(provs, "anthropic", tripple_init_provider("anthropic", 1))
        _tripple = dict_set(_tripple, "providers", provs)
    }
    _tripple = tripple_ripple(_tripple, "openai", 1, 100)
    _tripple = tripple_ripple(_tripple, "anthropic", 1, 150)
    let rip = _tripple["total_ripples"]
    let prov_count = len(keys(_tripple["providers"]))
    // Test resonance check
    let before_rip = _tripple["total_ripples"]
    _tripple = tripple_resonance_check(_tripple)
    let after_rip = _tripple["total_ripples"]
    let after_prov = len(keys(_tripple["providers"]))
    return json_ok({
        "providers_before": prov_count,
        "providers_after": after_prov,
        "ripples_before": before_rip,
        "ripples_after": after_rip,
        "regime": _tripple["regime"],
        "resonance": _tripple["resonance_score"],
        "test": "debug_resonance"
    })
}

