let TIERS        = 3         // H3 = cache tiers
let HEARTBEAT    = 5         // H5 = check interval seconds
let HEADER_SIZE  = 13        // H13 = frame header bytes
let PACK_TRITS   = 5         // H5 = trits per packed byte

// -- Cache Constants --
let MAX_CACHE    = 1183      // H13 * H13 * H7 = 13*13*7
let TIER_HOT     = 1
let TIER_WARM    = 0
let TIER_COLD    = -1

