let H3  = 3
let H5  = 5
let H7  = 7
let H13 = 13
let BLOCK = 2187             // 3^7 = ternary-native block size

// -- N-S Reynolds Boundaries (harmonic cubes) --
let RE_LAMINAR      = 27     // 3^3
let RE_TRANSITIONAL = 125    // 5^3
let RE_TURBULENT    = 343    // 7^3

// -- Ternary Constants --
