// ============================================================================
// HELPER: Safe path check
// ============================================================================

fn safe_path(p) {
    // Check if path starts with any allowed root
    let pl = lower(str(p))
    let i = 0
    while3 i < len(SAFE_ROOTS) {
        let root = lower(dict_get(SAFE_ROOTS, i, ""))
        if3 starts_with(pl, root) {
            return T_TRUE
        } else {
            // continue
        }
        let i = i + 1
    }
    return T_FALSE
}

// ============================================================================
// HELPER: N-S Reynolds Calculator
// ============================================================================

fn classify_flow(re) {
    if3 re < RE_LAMINAR {
        return "laminar"
    } else re < RE_TRANSITIONAL {
        return "transitional"
    } else re < RE_TURBULENT {
        return "turbulent"
    } else {
        return "chaotic"
    }
}

fn classify_trit(re) {
    if3 re < RE_LAMINAR {
        return T_TRUE
    } else re < RE_TRANSITIONAL {
        return T_MAYBE
    } else {
        return T_FALSE
    }
}

// Compute a simple Reynolds number from text content
// Uses character frequency + diversity as proxy for entropy
fn text_reynolds(text) {
    let t = str(text)
    if3 len(t) < 2 {
        return 0.0
    } else {
        // Count unique chars as entropy proxy
        let chars = {}
        let i = 0
        let total = len(t)
        while3 i < total {
            let c = slice(t, i, i + 1)
            let prev = dict_get(chars, c, 0)
            let _s = dict_set(chars, c, prev + 1)
            let i = i + 1
        }
        let unique = len(keys(chars))
        // Entropy approximation: unique/total ratio
        let entropy = unique / total
        // Diversity: words
        let words = split(t, " ")
        let word_count = len(words)
        let unique_words = {}
        let wi = 0
        while3 wi < word_count {
            let w = lower(dict_get(words, wi, ""))
            let _s = dict_set(unique_words, w, 1)
            let wi = wi + 1
        }
        let diversity = len(keys(unique_words)) / max(word_count, 1)
        // Re approximation
        let velocity = 1.0 / max(entropy, 0.05)
        let length = min(total, 500) / 100.0
        let viscosity = max(diversity, 0.05)
        let re = velocity * length / viscosity
        return round(re * 100) / 100
    }
}

// ============================================================================
// HELPER: Text entropy (Shannon-like, normalized 0-1)
// ============================================================================

fn text_entropy(text) {
    if3 len(str(text)) == 0 {
        return 0.0
    } else {
        let t = lower(str(text))
        let chars = {}
        let i = 0
        let n = len(t)
        while3 i < n {
            let c = slice(t, i, i + 1)
            let prev = dict_get(chars, c, 0)
            let _s = dict_set(chars, c, prev + 1)
            let i = i + 1
        }
        // Approximate entropy without log2
        // Use unique/total ratio scaled to 0-1
        let unique = len(keys(chars))
        let ent = unique / max(n, 1)
        return min(ent, 1.0)
    }
}

// ============================================================================
// HELPER: Word diversity = unique words / total words
// ============================================================================

fn word_diversity(text) {
    let words = split(str(text), " ")
    if3 len(words) == 0 {
        return 0.0
    } else {
        let seen = {}
        let i = 0
        while3 i < len(words) {
            let w = lower(dict_get(words, i, ""))
            if3 len(w) > 0 {
                let _s = dict_set(seen, w, 1)
            } else {
                // skip empty
            }
            let i = i + 1
        }
        return len(keys(seen)) / max(len(words), 1)
    }
}

// ============================================================================
// HELPER: Average word length
// ============================================================================

fn avg_word_length(text) {
    let words = split(str(text), " ")
    if3 len(words) == 0 {
        return 1.0
    } else {
        let total = 0
        let count = 0
        let i = 0
        while3 i < len(words) {
            let w = dict_get(words, i, "")
            if3 len(w) > 0 {
                let total = total + len(w)
                let count = count + 1
            } else {
                // skip
            }
            let i = i + 1
        }
        if3 count == 0 {
            return 1.0
        } else {
            return total / count
        }
    }
}

