// ============================================================================
// HELPER: LRU order management for cache
// ============================================================================

fn cache_order_remove(key) {
    let new_order = []
    let i = 0
    while3 i < len(_cache_order) {
        let k = dict_get(_cache_order, i, "")
        if3 k == key {
            // skip -- remove
        } else {
            append(new_order, k)
        }
        let i = i + 1
    }
    let _cache_order = new_order
}

fn cache_order_touch(key) {
    cache_order_remove(key)
    append(_cache_order, key)
}

fn cache_evict_cold() {
    // Evict first cold entry, fallback to LRU (oldest)
    let evicted = T_FALSE
    let i = 0
    while3 i < len(_cache_order) {
        let k = dict_get(_cache_order, i, "")
        let entry = dict_get(_cache, k, {})
        let tier = dict_get(entry, "tier", 0)
        if3 tier == TIER_COLD {
            let _d = dict_del(_cache, k)
            cache_order_remove(k)
            let _cache_evictions = _cache_evictions + 1
            let evicted = T_TRUE
            return T_TRUE
        } else {
            let i = i + 1
        }
    }
    // No cold entries -- evict oldest (front of order list)
    if3 len(_cache_order) > 0 {
        let oldest = dict_get(_cache_order, 0, "")
        let _d = dict_del(_cache, oldest)
        let _cache_order = slice(_cache_order, 1, len(_cache_order))
        let _cache_evictions = _cache_evictions + 1
    } else {
        // nothing to evict
    }
    return T_TRUE
}

// ============================================================================
// TOOL 1: TDIFF -- Ternary 3-State Diff (line-by-line)
// ============================================================================
// +1 = added, 0 = unchanged, -1 = removed
// Operates on text strings via line comparison

fn tdiff_compute(old_text, new_text) {
    let t0 = time()
    let old_lines = split(str(old_text), "\n")
    let new_lines = split(str(new_text), "\n")
    let old_len = len(old_lines)
    let new_len = len(new_lines)
    let max_len = max(old_len, new_len)

    let diff_entries = []
    let added = 0
    let removed = 0
    let unchanged = 0
    let i = 0

    while3 i < max_len {
        let old_line = ""
        let new_line = ""
        if3 i < old_len {
            let old_line = dict_get(old_lines, i, "")
        } else {
            // beyond old
        }
        if3 i < new_len {
            let new_line = dict_get(new_lines, i, "")
        } else {
            // beyond new
        }

        if3 i >= old_len {
            // Added line
            let entry = {}
            let _e = dict_set(entry, "line", i + 1)
            let _e = dict_set(entry, "trit", T_TRUE)
            let _e = dict_set(entry, "type", "added")
            let _e = dict_set(entry, "text", new_line)
            append(diff_entries, entry)
            let added = added + 1
        } else i >= new_len {
            // Removed line
            let entry = {}
            let _e = dict_set(entry, "line", i + 1)
            let _e = dict_set(entry, "trit", T_FALSE)
            let _e = dict_set(entry, "type", "removed")
            let _e = dict_set(entry, "text", old_line)
            append(diff_entries, entry)
            let removed = removed + 1
        } else old_line == new_line {
            // Unchanged
            let unchanged = unchanged + 1
        } else {
            // Changed -- count as remove + add
            let entry_r = {}
            let _e = dict_set(entry_r, "line", i + 1)
            let _e = dict_set(entry_r, "trit", T_FALSE)
            let _e = dict_set(entry_r, "type", "removed")
            let _e = dict_set(entry_r, "text", old_line)
            append(diff_entries, entry_r)
            let entry_a = {}
            let _e = dict_set(entry_a, "line", i + 1)
            let _e = dict_set(entry_a, "trit", T_TRUE)
            let _e = dict_set(entry_a, "type", "added")
            let _e = dict_set(entry_a, "text", new_line)
            append(diff_entries, entry_a)
            let added = added + 1
            let removed = removed + 1
        }
        let i = i + 1
    }

    let changed_pct = 0
    if3 max_len > 0 {
        let changed_pct = round((added + removed) * 10000 / max_len) / 100
    } else {
        // 0
    }

    let ms = round((time() - t0) * 1000 * 100) / 100

    return {
        "ok": true,
        "diff": diff_entries,
        "old_lines": old_len,
        "new_lines": new_len,
        "added": added,
        "removed": removed,
        "unchanged": unchanged,
        "changed_pct": changed_pct,
        "ms": ms
    }
}

fn tdiff_compute_files(old_path, new_path) {
    // Read files and compute line diff
    let old_text = ""
    let new_text = ""
    try3 {
        let old_text = nova_read(old_path)
    } else {
        return {"ok": false, "error": "Cannot read old file: " + str(old_path)}
    }
    try3 {
        let new_text = nova_read(new_path)
    } else {
        return {"ok": false, "error": "Cannot read new file: " + str(new_path)}
    }
    return tdiff_compute(old_text, new_text)
}

// ============================================================================
// TOOL 2: TCACHE -- Ternary In-Memory Cache
// ============================================================================
// 3 tiers: +1=hot, 0=warm, -1=cold
// LRU eviction with cold-first priority

fn tcache_set(key, value) {
    // Evict if full
    while3 len(_cache_order) >= MAX_CACHE {
        cache_evict_cold()
    }

    let now = time()
    let encoded = json_encode(value)
    let original_size = len(encoded)

    // Delegate compression to TZip service if available
    let compressed_size = original_size
    let saved = 0
    try3 {
        let resp = http_post("http://127.0.0.1:9885/tzip/compress",
            {"data": encoded})
        let cs = dict_get(resp, "compressed_size", original_size)
        let compressed_size = cs
        let saved = original_size - cs
    } else {
        // TZip not available -- store raw
    }

    let entry = {}
    let _e = dict_set(entry, "key", key)
    let _e = dict_set(entry, "value", value)
    let _e = dict_set(entry, "original_size", original_size)
    let _e = dict_set(entry, "compressed_size", compressed_size)
    let _e = dict_set(entry, "tier", TIER_HOT)
    let _e = dict_set(entry, "created", now)
    let _e = dict_set(entry, "last_access", now)
    let _e = dict_set(entry, "hits", 0)

    // Remove old entry if exists
    if3 dict_has(_cache, key) {
        cache_order_remove(key)
    } else {
        // new entry
    }

    let _s = dict_set(_cache, key, entry)
    append(_cache_order, key)
    let _cache_sets = _cache_sets + 1
    if3 saved > 0 {
        let _cache_bytes_saved = _cache_bytes_saved + saved
    } else {
        // no savings
    }

    return {
        "ok": true,
        "key": key,
        "original": original_size,
        "compressed": compressed_size,
        "saved": saved
    }
}

fn tcache_get(key) {
    let entry = dict_get(_cache, key, {})
    if3 len(keys(entry)) == 0 {
        let _cache_misses = _cache_misses + 1
        return {"ok": false, "error": "miss"}
    } else {
        let _cache_hits = _cache_hits + 1
        let hits = dict_get(entry, "hits", 0) + 1
        let _e = dict_set(entry, "hits", hits)
        let _e = dict_set(entry, "last_access", time())
        let _e = dict_set(entry, "tier", TIER_HOT)
        let _s = dict_set(_cache, key, entry)
        cache_order_touch(key)
        return {
            "ok": true,
            "key": key,
            "value": dict_get(entry, "value", null),
            "tier": TIER_HOT,
            "hits": hits,
            "compressed_size": dict_get(entry, "compressed_size", 0)
        }
    }
}

fn tcache_status() {
    let hot = 0
    let warm = 0
    let cold = 0
    let total_compressed = 0
    let total_original = 0

    let ks = keys(_cache)
    let i = 0
    while3 i < len(ks) {
        let k = dict_get(ks, i, "")
        let entry = dict_get(_cache, k, {})
        let tier = dict_get(entry, "tier", 0)
        if3 tier == TIER_HOT {
            let hot = hot + 1
        } else tier == TIER_WARM {
            let warm = warm + 1
        } else {
            let cold = cold + 1
        }
        let total_compressed = total_compressed + dict_get(entry, "compressed_size", 0)
        let total_original = total_original + dict_get(entry, "original_size", 0)
        let i = i + 1
    }

    let total_gets = _cache_hits + _cache_misses
    let hit_rate = 0
    if3 total_gets > 0 {
        let hit_rate = round(_cache_hits * 10000 / total_gets) / 100
    } else {
        // 0
    }

    let ram_saved_pct = 0
    if3 total_original > 0 {
        let ram_saved_pct = round((1 - total_compressed / total_original) * 10000) / 100
    } else {
        // 0
    }

    return {
        "sets": _cache_sets,
        "gets": total_gets,
        "hits": _cache_hits,
        "misses": _cache_misses,
        "evictions": _cache_evictions,
        "bytes_saved": _cache_bytes_saved,
        "entries": len(_cache_order),
        "hot": hot,
        "warm": warm,
        "cold": cold,
        "ram_compressed": total_compressed,
        "ram_original": total_original,
        "ram_saved_pct": str(ram_saved_pct) + "%",
        "hit_rate": str(hit_rate) + "%"
    }
}

// ============================================================================
// TOOL 3: TSYNC -- Ternary Delta Sync
// ============================================================================
// Syncs directories by computing diffs on changed files
// Delegates file listing to nova_run for dir walking

fn tsync_hash_file(path) {
    // Hash file via sha256 (first BLOCK bytes)
    try3 {
        let content = nova_read(path)
        let hash = sha256(content)
        return slice(hash, 0, 16)
    } else {
        return ""
    }
}

fn tsync_build_manifest(dir_path) {
    // Use nova_run to list files in directory
    let manifest = {}
    try3 {
        let cmd = "cmd /c dir /s /b \"" + str(dir_path) + "\""
        let output = nova_run(cmd)
        let files = split(str(output), "\n")
        let i = 0
        while3 i < len(files) {
            let fpath = trim(dict_get(files, i, ""))
            if3 len(fpath) > 0 {
                // Skip excluded dirs
                let skip = T_FALSE
                if3 contains(fpath, "\\.git\\") {
                    let skip = T_TRUE
                } else contains(fpath, "\\__pycache__\\") {
                    let skip = T_TRUE
                } else contains(fpath, "\\node_modules\\") {
                    let skip = T_TRUE
                } else contains(fpath, "\\ai_env\\") {
                    let skip = T_TRUE
                } else contains(fpath, "\\venv\\") {
                    let skip = T_TRUE
                } else {
                    // not excluded
                }
                if3 skip == T_FALSE {
                    let hash = tsync_hash_file(fpath)
                    if3 len(hash) > 0 {
                        // Use relative path as key
                        let rel = replace(fpath, dir_path + "\\", "")
                        let _s = dict_set(manifest, rel, hash)
                    } else {
                        // hash failed
                } else {
                    // excluded
            } else {
                // empty line
            }
            let i = i + 1
    } else {
        // dir listing failed
    }
    return manifest
}
}
}
}

fn tsync_sync(source, target) {
    if3 safe_path(source) == T_FALSE {
        return {"ok": false, "error": "Source path outside allowed roots"}
    } else safe_path(target) == T_FALSE {
        return {"ok": false, "error": "Target path outside allowed roots"}
    } else {
        let t0 = time()
        let src_manifest = tsync_build_manifest(source)
        let tgt_manifest = tsync_build_manifest(target)

        let synced = 0
        let skipped = 0
        let errors = 0
        let delta_bytes = 0
        let full_bytes = 0

        let src_keys = keys(src_manifest)
        let ki = 0
        while3 ki < len(src_keys) {
            let rel = dict_get(src_keys, ki, "")
            let src_hash = dict_get(src_manifest, rel, "")
            let tgt_hash = dict_get(tgt_manifest, rel, "")
            let src_path = source + "\\" + rel
            let tgt_path = target + "\\" + rel

            try3 {
                let src_content = nova_read(src_path)
                let full_bytes = full_bytes + len(src_content)

                if3 src_hash == tgt_hash {
                    let skipped = skipped + 1
                } else {
                    // File changed or new -- copy via nova_write
                    try3 {
                        nova_write(tgt_path, src_content)
                        let synced = synced + 1
                        let delta_bytes = delta_bytes + len(src_content)
                    } else {
                        let errors = errors + 1
            } else {
                let errors = errors + 1
            }
            let ki = ki + 1
        }

        let ms = round((time() - t0) * 1000 * 100) / 100
        let savings = 0
        if3 full_bytes > 0 {
            let savings = round((1 - delta_bytes / full_bytes) * 10000) / 100
        } else {
            // 0
        }

        return {
            "ok": true,
            "synced": synced,
            "skipped": skipped,
            "errors": errors,
            "delta_bytes": delta_bytes,
            "full_bytes": full_bytes,
            "savings": str(savings) + "%",
            "ms": ms
        }
    }
}

// ============================================================================
// TOOL 4: TINDEX -- Ternary Search Index
// ============================================================================
// Three-state search: +1=match, 0=partial, -1=miss
// Indexes files by sha256 fingerprint and text content
}
}

fn tindex_index_file(path) {
    if3 safe_path(path) == T_FALSE {
        return {"ok": false, "error": "Path outside allowed roots"}
    } else {
        try3 {
            let content = nova_read(path)
            let fp_hash = slice(sha256(content), 0, 12)
            let re = text_reynolds(content)
            let flow = classify_flow(re)

            let entry = {}
            let _e = dict_set(entry, "fingerprint_hash", fp_hash)
            let _e = dict_set(entry, "size", len(content))
            let _e = dict_set(entry, "reynolds", re)
            let _e = dict_set(entry, "flow", flow)
            let _e = dict_set(entry, "indexed_at", time())
            let _e = dict_set(entry, "content_preview", slice(lower(content), 0, BLOCK))
            let _s = dict_set(_index, path, entry)

            return {
                "ok": true,
                "path": path,
                "fingerprint": fp_hash,
                "reynolds": re,
                "flow": flow
        } else {
            return {"ok": false, "error": "Cannot read file: " + str(path)}
        }
    }
}
}

fn tindex_index_directory(dir_path) {
    if3 safe_path(dir_path) == T_FALSE {
        return {"ok": false, "error": "Path outside allowed roots"}
    } else {
        let count = 0
        let errs = 0
        try3 {
            let cmd = "cmd /c dir /s /b \"" + str(dir_path) + "\""
            let output = nova_run(cmd)
            let files = split(str(output), "\n")
            let i = 0
            while3 i < len(files) {
                let fpath = trim(dict_get(files, i, ""))
                if3 len(fpath) > 0 {
                    // Skip excluded extensions
                    let skip = T_FALSE
                    if3 ends_with(fpath, ".exe") {
                        let skip = T_TRUE
                    } else ends_with(fpath, ".dll") {
                        let skip = T_TRUE
                    } else ends_with(fpath, ".sys") {
                        let skip = T_TRUE
                    } else ends_with(fpath, ".msi") {
                        let skip = T_TRUE
                    } else contains(fpath, "\\.git\\") {
                        let skip = T_TRUE
                    } else contains(fpath, "\\__pycache__\\") {
                        let skip = T_TRUE
                    } else contains(fpath, "\\node_modules\\") {
                        let skip = T_TRUE
                    } else {
                        // not excluded
                    }
                    if3 skip == T_FALSE {
                        let r = tindex_index_file(fpath)
                        if3 dict_get(r, "ok", false) == true {
                            let count = count + 1
                        } else {
                            let errs = errs + 1
                    } else {
                        // excluded
                } else {
                    // empty
                }
                let i = i + 1
        } else {
            // dir listing failed
        }
        return {
            "ok": true,
            "indexed": count,
            "errors": errs,
            "total": len(keys(_index))
        }
    }
}
}
}
}

fn tindex_search(query, search_type) {
    let t0 = time()
    let q = lower(str(query))
    let results = []
    let matches = 0
    let partials = 0

    let idx_keys = keys(_index)
    let i = 0
    while3 i < len(idx_keys) {
        let path = dict_get(idx_keys, i, "")
        let entry = dict_get(_index, path, {})

        // Fingerprint comparison by hash prefix
        let q_hash = slice(sha256(q), 0, 12)
        let e_hash = dict_get(entry, "fingerprint_hash", "")
        let sim = 0.0

        // Check hash prefix overlap
        let match_chars = 0
        let mi = 0
        let hash_len = min(len(q_hash), len(e_hash))
        while3 mi < hash_len {
            if3 slice(q_hash, mi, mi + 1) == slice(e_hash, mi, mi + 1) {
                let match_chars = match_chars + 1
            } else {
                // no match
            }
            let mi = mi + 1
        }
        if3 hash_len > 0 {
            let sim = match_chars / hash_len
        } else {
            // 0
        }

        // Also check text content match
        let text_match = T_FALSE
        if3 search_type == "content" {
            let preview = dict_get(entry, "content_preview", "")
            if3 contains(preview, q) {
                let text_match = T_TRUE
                let sim = max(sim, 0.85)
            } else {
                // no content match
        } else {
            // fingerprint only
        }

        // Classify by ternary thresholds
        let state = T_FALSE
        let state_name = "miss"
        if3 sim > 0.667 {
            let state = T_TRUE
            let state_name = "match"
            let matches = matches + 1
        } else sim > 0.333 {
            let state = T_MAYBE
            let state_name = "partial"
            let partials = partials + 1
        } else {
            // miss -- skip from results
        }

        if3 state >= T_MAYBE {
            let result = {}
            let _e = dict_set(result, "path", path)
            let _e = dict_set(result, "similarity", round(sim * 10000) / 10000)
            let _e = dict_set(result, "state", state)
            let _e = dict_set(result, "state_name", state_name)
            let _e = dict_set(result, "reynolds", dict_get(entry, "reynolds", 0))
            let _e = dict_set(result, "flow", dict_get(entry, "flow", "unknown"))
            let _e = dict_set(result, "size", dict_get(entry, "size", 0))
            if3 text_match == T_TRUE {
                let _e = dict_set(result, "text_match", true)
            } else {
                // no text_match field
            }
            append(results, result)
        } else {
            // skip misses
        }

        let i = i + 1
    }

    // Sort results by similarity (descending) -- simple bubble sort
    let sorted = T_FALSE
    while3 sorted == T_FALSE {
        let sorted = T_TRUE
        let si = 0
        while3 si < len(results) - 1 {
            let a = dict_get(results, si, {})
            let b = dict_get(results, si + 1, {})
            let sa = dict_get(a, "similarity", 0)
            let sb = dict_get(b, "similarity", 0)
            if3 sa < sb {
                // Swap
                let _s = dict_set(results, si, b)
                let _s = dict_set(results, si + 1, a)
                let sorted = T_FALSE
            } else {
                // in order
            }
            let si = si + 1
        }
    }

    // Cap results at H13 * H3 = 39
    let max_results = H13 * H3
    if3 len(results) > max_results {
        let results = slice(results, 0, max_results)
    } else {
        // all fit
    }

    let ms = round((time() - t0) * 1000 * 100) / 100

    return {
        "ok": true,
        "query": query,
        "type": search_type,
        "matches": matches,
        "partials": partials,
        "results": results,
        "ms": ms
    }
}
}

fn tindex_status() {
    let flow_breakdown = {}
    let idx_keys = keys(_index)
    let i = 0
    while3 i < len(idx_keys) {
        let k = dict_get(idx_keys, i, "")
        let entry = dict_get(_index, k, {})
        let flow = dict_get(entry, "flow", "unknown")
        let prev = dict_get(flow_breakdown, flow, 0)
        let _s = dict_set(flow_breakdown, flow, prev + 1)
        let i = i + 1
    }
    return {
        "indexed_files": len(idx_keys),
        "flow_breakdown": flow_breakdown
    }
}

// ============================================================================
// TOOL 5: TMESH -- Ternary Service Mesh Relay
// ============================================================================
// Compressed inter-service relay via http_post

fn tmesh_relay(port, path, req_body, method) {
    let t0 = time()
    let url = "http://127.0.0.1:" + str(port) + str(path)

    try3 {
        let response = null
        let raw_size = 0

        if3 method == "GET" {
            let resp = http_get(url)
            let response = resp
            let raw_size = len(json_encode(resp))
        } else {
            let payload = {}
            if3 type_of(req_body) == "dict" {
                let payload = req_body
            } else type_of(req_body) == "string" {
                let payload = json_decode(req_body)
            } else {
                let payload = {}
            }
            let resp = http_post(url, payload)
            let response = resp
            let raw_size = len(json_encode(resp))
        }

        let _mesh_calls = _mesh_calls + 1
        let sent = len(json_encode(req_body))
        let _mesh_bytes_sent = _mesh_bytes_sent + sent
        let _mesh_bytes_raw = _mesh_bytes_raw + raw_size

        let ms = round((time() - t0) * 1000 * 100) / 100

        return {
            "ok": true,
            "response": response,
            "request_bytes": sent,
            "response_bytes": raw_size,
            "ms": ms
    } else {
        let _mesh_errors = _mesh_errors + 1
        return {"ok": false, "error": "Relay failed to " + url}
    }
}
}

fn tmesh_status() {
    let total = _mesh_bytes_sent + _mesh_bytes_raw
    return {
        "calls": _mesh_calls,
        "bytes_sent": _mesh_bytes_sent,
        "bytes_raw": _mesh_bytes_raw,
        "errors": _mesh_errors,
        "total_bytes": total,
        "total_mb": round(total * 100 / 1048576) / 100
    }
}

// ============================================================================
// TOOL 6: TSTREAM -- Ternary Streaming
// ============================================================================
// List-based ring buffers for real-time data streams

fn tstream_start(name, buffer_size) {
    if3 dict_has(_streams, name) {
        return {"ok": true, "stream": name, "status": "already_exists"}
    } else {
        let stream = {}
        let _e = dict_set(stream, "name", name)
        let _e = dict_set(stream, "buffer", [])
        let _e = dict_set(stream, "max_size", buffer_size)
        let _e = dict_set(stream, "created", time())
        let _e = dict_set(stream, "total_writes", 0)
        let _e = dict_set(stream, "total_bytes", 0)
        let _e = dict_set(stream, "total_compressed", 0)
        let _s = dict_set(_streams, name, stream)
        return {"ok": true, "stream": name, "buffer_size": buffer_size}
    }
}

fn tstream_write(name, data) {
    let stream = dict_get(_streams, name, {})
    if3 len(keys(stream)) == 0 {
        return {"ok": false, "error": "Stream not found: " + str(name)}
    } else {
        let raw_size = len(str(data))
        let buffer = dict_get(stream, "buffer", [])
        let max_size = dict_get(stream, "max_size", 455)

        // Delegate compression to TZip service
        let compressed_size = raw_size
        try3 {
            let resp = http_post("http://127.0.0.1:9885/tzip/compress",
                {"data": str(data)})
            let compressed_size = dict_get(resp, "compressed_size", raw_size)
        } else {
            // TZip not available
        }

        let entry = {}
        let _e = dict_set(entry, "data", str(data))
        let _e = dict_set(entry, "original_size", raw_size)
        let _e = dict_set(entry, "compressed_size", compressed_size)
        let _e = dict_set(entry, "timestamp", time())
        append(buffer, entry)

        // Trim buffer if exceeds max
        while3 len(buffer) > max_size {
            let buffer = slice(buffer, 1, len(buffer))
        }

        let tw = dict_get(stream, "total_writes", 0) + 1
        let tb = dict_get(stream, "total_bytes", 0) + raw_size
        let tc = dict_get(stream, "total_compressed", 0) + compressed_size

        let _e = dict_set(stream, "buffer", buffer)
        let _e = dict_set(stream, "total_writes", tw)
        let _e = dict_set(stream, "total_bytes", tb)
        let _e = dict_set(stream, "total_compressed", tc)
        let _s = dict_set(_streams, name, stream)

        return {
            "ok": true,
            "stream": name,
            "original": raw_size,
            "compressed": compressed_size
        }
    }
}

fn tstream_read(name, count) {
    let stream = dict_get(_streams, name, {})
    if3 len(keys(stream)) == 0 {
        return {"ok": false, "error": "Stream not found: " + str(name)}
    } else {
        let buffer = dict_get(stream, "buffer", [])
        let read_count = min(count, len(buffer))
        let entries = []
        let remaining_buf = []

        // Read from front of buffer (oldest first)
        let i = 0
        while3 i < len(buffer) {
            if3 i < read_count {
                let entry = dict_get(buffer, i, {})
                let out_entry = {}
                let _e = dict_set(out_entry, "data", dict_get(entry, "data", ""))
                let _e = dict_set(out_entry, "timestamp", dict_get(entry, "timestamp", 0))
                append(entries, out_entry)
            } else {
                append(remaining_buf, dict_get(buffer, i, {}))
            }
            let i = i + 1
        }

        let _e = dict_set(stream, "buffer", remaining_buf)
        let _s = dict_set(_streams, name, stream)

        return {
            "ok": true,
            "stream": name,
            "entries": entries,
            "remaining": len(remaining_buf)
        }
    }
}

fn tstream_status() {
    let stream_info = {}
    let skeys = keys(_streams)
    let i = 0
    while3 i < len(skeys) {
        let name = dict_get(skeys, i, "")
        let s = dict_get(_streams, name, {})
        let tb = dict_get(s, "total_bytes", 0)
        let tc = dict_get(s, "total_compressed", 0)
        let ratio = 0
        if3 tb > 0 {
            let ratio = round(tc * 10000 / tb) / 100
        } else {
            // 0
        }
        let info = {}
        let _e = dict_set(info, "writes", dict_get(s, "total_writes", 0))
        let _e = dict_set(info, "buffered", len(dict_get(s, "buffer", [])))
        let _e = dict_set(info, "bytes", tb)
        let _e = dict_set(info, "compressed", tc)
        let _e = dict_set(info, "saved", tb - tc)
        let _e = dict_set(info, "ratio", str(ratio) + "%")
        let _s = dict_set(stream_info, name, info)
        let i = i + 1
    }
    return {
        "streams": stream_info,
        "count": len(skeys)
    }
}

// ============================================================================
// TOOL 7: TFORGE -- Reynolds Code Analyzer
// ============================================================================
// Applies N-S fluid dynamics to source code
// Treats functions as flow channels, calculates per-function Reynolds

fn tforge_analyze(path) {
    let t0 = time()
    if3 safe_path(path) == T_FALSE {
        return {"ok": false, "error": "Path outside allowed roots"}
    } else {
        try3 {
            let content = nova_read(path)
            let lines = split(content, "\n")
            let total_lines = len(lines)
            let file_re = text_reynolds(content)
            let file_flow = classify_flow(file_re)

            // Find function definitions by scanning lines
            // Look for: def, class, function, fn, func
            let hotspots = []
            let func_starts = []
            let func_names = []
            let li = 0
            while3 li < total_lines {
                let line = dict_get(lines, li, "")
                let stripped = trim(line)
                let found_func = T_FALSE

                // Check for function keywords
                if3 starts_with(stripped, "def ") {
                    let fname = split(stripped, " ")
                    let name = dict_get(fname, 1, "unknown")
                    // Remove ( and : from name
                    let name = split(name, "(")
                    let name = dict_get(name, 0, "unknown")
                    append(func_starts, li)
                    append(func_names, name)
                    let found_func = T_TRUE
                } else starts_with(stripped, "class ") {
                    let fname = split(stripped, " ")
                    let name = dict_get(fname, 1, "unknown")
                    let name = split(name, "(")
                    let name = dict_get(name, 0, "unknown")
                    let name = split(name, ":")
                    let name = dict_get(name, 0, "unknown")
                    append(func_starts, li)
                    append(func_names, name)
                    let found_func = T_TRUE
                } else starts_with(stripped, "function ") {
                    let fname = split(stripped, " ")
                    let name = dict_get(fname, 1, "unknown")
                    let name = split(name, "(")
                    let name = dict_get(name, 0, "unknown")
                    append(func_starts, li)
                    append(func_names, name)
                    let found_func = T_TRUE
                } else starts_with(stripped, "fn ") {
                    let fname = split(stripped, " ")
                    let name = dict_get(fname, 1, "unknown")
                    let name = split(name, "(")
                    let name = dict_get(name, 0, "unknown")
                    append(func_starts, li)
                    append(func_names, name)
                    let found_func = T_TRUE
                } else starts_with(stripped, "async def ") {
                    let fname = split(stripped, " ")
                    let name = dict_get(fname, 2, "unknown")
                    let name = split(name, "(")
                    let name = dict_get(name, 0, "unknown")
                    append(func_starts, li)
                    append(func_names, name)
                    let found_func = T_TRUE
                } else {
                    // not a function definition
                }
                let li = li + 1
            }

            // Analyze each function body
            let fi = 0
            while3 fi < len(func_starts) {
                let start_line = dict_get(func_starts, fi, 0)
                let func_name = dict_get(func_names, fi, "unknown")

                // Determine end of function
                let end_line = total_lines
                if3 fi + 1 < len(func_starts) {
                    let end_line = dict_get(func_starts, fi + 1, total_lines)
                } else {
                    // last function -- goes to end
                }

                // Build function body text
                let body_parts = []
                let bi = start_line
                while3 bi < end_line {
                    append(body_parts, dict_get(lines, bi, ""))
                    let bi = bi + 1
                }
                let func_body = join(body_parts, "\n")
                let func_lines = end_line - start_line

                // Compute Reynolds for function body
                let func_re = text_reynolds(func_body)
                let func_flow = classify_flow(func_re)

                // Detect issues
                let issues = []
                let hints = []

                // Check nesting depth
                let max_indent = 0
                let base_indent = len(dict_get(lines, start_line, "")) - len(trim(dict_get(lines, start_line, "")))
                let ni = start_line
                while3 ni < end_line {
                    let line = dict_get(lines, ni, "")
                    let stripped = trim(line)
                    if3 len(stripped) > 0 {
                        let indent = len(line) - len(stripped)
                        let relative = indent - base_indent
                        if3 relative > max_indent {
                            let max_indent = relative
                        } else {
                            // not deeper
                    } else {
                        // empty line
                    }
                    let ni = ni + 1
                }

                let nesting_depth = max_indent / 4
                if3 nesting_depth > H3 {
                    append(issues, "deep nesting (" + str(nesting_depth) + " levels)")
                } else {
                    // ok nesting
                }

                // Check for complex patterns in body
                if3 func_lines > 100 {
                    append(issues, "long function (" + str(func_lines) + " lines)")
                } else {
                    // ok length
                }

                // Optimization hints by regime
                if3 func_re > RE_TRANSITIONAL {
                    append(hints, "extract inner logic to reduce Reynolds number")
                } else {
                    // laminar ok
                }
                if3 func_re > RE_TURBULENT {
                    append(hints, "break into smaller laminar functions")
                } else {
                    // not turbulent
                }
                if3 nesting_depth > H3 {
                    append(hints, "flatten nested structures")
                } else {
                    // ok
                }

                let hotspot = {}
                let _e = dict_set(hotspot, "name", func_name)
                let _e = dict_set(hotspot, "line", start_line + 1)
                let _e = dict_set(hotspot, "reynolds", func_re)
                let _e = dict_set(hotspot, "flow", func_flow)
                let _e = dict_set(hotspot, "lines", func_lines)
                let _e = dict_set(hotspot, "issues", issues)
                let _e = dict_set(hotspot, "hints", hints)
                append(hotspots, hotspot)

                let fi = fi + 1
            }

            // Sort hotspots by Reynolds (descending) -- bubble sort
            let sorted = T_FALSE
            while3 sorted == T_FALSE {
                let sorted = T_TRUE
                let si = 0
                while3 si < len(hotspots) - 1 {
                    let a = dict_get(hotspots, si, {})
                    let b = dict_get(hotspots, si + 1, {})
                    if3 dict_get(a, "reynolds", 0) < dict_get(b, "reynolds", 0) {
                        let _s = dict_set(hotspots, si, b)
                        let _s = dict_set(hotspots, si + 1, a)
                        let sorted = T_FALSE
                    } else {
                        // in order
                    }
                    let si = si + 1
                }
            }

            // Cap hotspots at H13
            if3 len(hotspots) > H13 {
                let hotspots = slice(hotspots, 0, H13)
            } else {
                // all fit
            }

            let turbulent_count = 0
            let ti = 0
            while3 ti < len(hotspots) {
                let h = dict_get(hotspots, ti, {})
                if3 dict_get(h, "reynolds", 0) > RE_TRANSITIONAL {
                    let turbulent_count = turbulent_count + 1
                } else {
                    // not turbulent
                }
                let ti = ti + 1
            }

            let ms = round((time() - t0) * 1000 * 100) / 100

            return {
                "ok": true,
                "path": path,
                "file_reynolds": file_re,
                "file_flow": file_flow,
                "total_lines": total_lines,
                "total_functions": len(func_starts),
                "turbulent_functions": turbulent_count,
                "hotspots": hotspots,
                "harmonic_boundaries": {
                    "laminar": "Re < " + str(RE_LAMINAR),
                    "transitional": str(RE_LAMINAR) + " < Re < " + str(RE_TRANSITIONAL),
                    "turbulent": str(RE_TRANSITIONAL) + " < Re < " + str(RE_TURBULENT),
                    "chaotic": "Re > " + str(RE_TURBULENT)
                },
                "ms": ms
        } else {
            return {"ok": false, "error": "Cannot read file: " + str(path)}
        }
    }
}

// ============================================================================
// TFILTER v2 -- N-S Reynolds Text Classifier
// ============================================================================
// Classifies text elements using N-S fluid dynamics:
//   Re < 27  (3^3)  -> laminar      -> +1 SIGNAL
//   Re < 125 (5^3)  -> transitional -> 0 UNCERTAIN
//   Re >= 125       -> turbulent    -> -1 NOISE
//
// N-S variables:
//   rho = element type weight (buttons heavy, text light)
//   v   = 1/entropy (repetitive text = fast = turbulent)
//   L   = normalized text length
//   mu  = semantic richness (diverse vocab dampens Re)
}
}

fn tfilter_reynolds(text, el_type, bounds, depth) {
    let t = trim(str(text))
    if3 len(t) == 0 {
        return {"re": 999.0, "regime": "chaotic", "trit": T_FALSE}
    } else {
        let tl = lower(t)

        // -- Instant classification: known patterns --
        if3 is_server_log(t) == T_TRUE {
            return {"re": 500.0, "regime": "chaotic", "trit": T_FALSE}
        } else is_noise_word(tl) == T_TRUE {
            return {"re": 200.0, "regime": "turbulent", "trit": T_FALSE}
        } else is_model_label(t) == T_TRUE {
            return {"re": 180.0, "regime": "turbulent", "trit": T_FALSE}
        } else {
            // proceed with N-S computation
        }

        // -- N-S Variable Computation --

        // rho (density) from element type
        let rho = TF_RHO_DEFAULT
        if3 type_of(el_type) == "number" {
            let type_key = str(int(el_type))
            let rho = dict_get(_tf_rho, type_key, TF_RHO_DEFAULT)
        } else {
            // use default
        }

        // v (velocity) = 1/entropy -- low entropy = fast = turbulent
        let entropy = text_entropy(t)
        let v = 1.0 / max(entropy, 0.05)

        // L (characteristic length)
        let tlen = min(len(t), 500)
        let big_l = tlen / 100.0

        // mu (viscosity) = semantic richness
        let diversity = word_diversity(t)
        let awl = avg_word_length(t)
        let punct_boost = 1.0
        if3 has_punctuation(t) == T_TRUE {
            let punct_boost = 1.5
        } else {
            // no punct
        }
        let mu = max(diversity * (awl / H5) * punct_boost, 0.05)

        // -- Core Reynolds: Re = rho * v * L / mu --
        let re = (rho * v * big_l) / mu

        // -- External Forces --

        // Spatial force: bounds x > 1300 -> preview panel -> noise boost
        if3 type_of(bounds) == "list" {
            if3 len(bounds) >= 1 {
                let bx = dict_get(bounds, 0, 0)
                if3 bx > 1300 {
                    let re = re * H3
                } else {
                    // not in preview panel
            } else {
                // no bounds data
        } else {
            // no bounds
        }

        // Depth force: shallow -> noise boost
        if3 type_of(depth) == "number" {
            if3 depth < H5 {
                let boost = 1.0 + (H5 - depth) * 0.3
                let re = re * boost
            } else {
                // deep enough
        } else {
            // no depth
        }

        // Badge contamination
        if3 has_badge(t) == T_TRUE {
            let re = re + 50
        } else {
            // no badge
        }

        // Short text penalty (under 15 chars)
        if3 len(t) < 15 {
            let re = re + 30
        } else {
            // long enough
        }

        // -- Classify by harmonic boundaries --
        let re = round(re * 100) / 100
        if3 re < RE_LAMINAR {
            return {"re": re, "regime": "laminar", "trit": T_TRUE}
        } else re < RE_TRANSITIONAL {
            return {"re": re, "regime": "transitional", "trit": T_MAYBE}
        } else re < RE_TURBULENT {
            return {"re": re, "regime": "turbulent", "trit": T_FALSE}
        } else {
            return {"re": re, "regime": "chaotic", "trit": T_FALSE}
        }
    }
}
}
}
}

fn tfilter_classify(text, texts, elements) {
    // Elements mode: classify UIA elements
    if3 type_of(elements) == "list" {
        if3 len(elements) > 0 {
            let results = []
            let count_signal = 0
            let count_uncertain = 0
            let count_noise = 0

            let ei = 0
            while3 ei < len(elements) {
                let el = dict_get(elements, ei, {})
                let name = dict_get(el, "name", "")
                if3 len(name) == 0 {
                    let name = dict_get(el, "text", "")
                } else {
                    // has name
                }
                let el_type = dict_get(el, "type", null)
                let bounds = dict_get(el, "bounds", null)
                let el_depth = dict_get(el, "depth", null)

                let r = tfilter_reynolds(name, el_type, bounds, el_depth)
                let trit = dict_get(r, "trit", 0)
                let label = "uncertain"
                if3 trit == T_TRUE {
                    let label = "signal"
                    let count_signal = count_signal + 1
                } else trit == T_FALSE {
                    let label = "noise"
                    let count_noise = count_noise + 1
                } else {
                    let count_uncertain = count_uncertain + 1
                }

                let entry = {}
                let _e = dict_set(entry, "text", slice(name, 0, 200))
                let _e = dict_set(entry, "trit", trit)
                let _e = dict_set(entry, "reynolds", dict_get(r, "re", 0))
                let _e = dict_set(entry, "regime", dict_get(r, "regime", "unknown"))
                let _e = dict_set(entry, "label", label)
                append(results, entry)

                let ei = ei + 1
            }

            return {
                "ok": true,
                "tool": "tfilter",
                "version": "2.0",
                "model": "navier-stokes",
                "results": results,
                "summary": {
                    "signal": count_signal,
                    "uncertain": count_uncertain,
                    "noise": count_noise,
                    "total": len(elements)
                },
                "boundaries": {
                    "laminar": RE_LAMINAR,
                    "transitional": RE_TRANSITIONAL,
                    "turbulent": RE_TURBULENT
        } else {
            // empty elements -- fall through to text mode
    } else {
        // not elements mode
    }

    // Texts mode: batch classify strings
    if3 type_of(texts) == "list" {
        if3 len(texts) > 0 {
            let results = []
            let count_signal = 0
            let count_uncertain = 0
            let count_noise = 0

            let ti = 0
            while3 ti < len(texts) {
                let t = dict_get(texts, ti, "")
                let r = tfilter_reynolds(t, null, null, null)
                let trit = dict_get(r, "trit", 0)
                let label = "uncertain"
                if3 trit == T_TRUE {
                    let label = "signal"
                    let count_signal = count_signal + 1
                } else trit == T_FALSE {
                    let label = "noise"
                    let count_noise = count_noise + 1
                } else {
                    let count_uncertain = count_uncertain + 1
                }

                let entry = {}
                let _e = dict_set(entry, "text", slice(str(t), 0, 200))
                let _e = dict_set(entry, "trit", trit)
                let _e = dict_set(entry, "reynolds", dict_get(r, "re", 0))
                let _e = dict_set(entry, "regime", dict_get(r, "regime", "unknown"))
                let _e = dict_set(entry, "label", label)
                append(results, entry)

                let ti = ti + 1
            }

            return {
                "ok": true,
                "tool": "tfilter",
                "version": "2.0",
                "model": "navier-stokes",
                "results": results,
                "summary": {
                    "signal": count_signal,
                    "uncertain": count_uncertain,
                    "noise": count_noise,
                    "total": len(texts)
        } else {
            // empty texts -- fall through to single
    } else {
        // not texts mode
    }

    // Single text mode
    let r = tfilter_reynolds(str(text), null, null, null)
    let trit = dict_get(r, "trit", 0)
    let label = "uncertain"
    if3 trit == T_TRUE {
        let label = "signal"
    } else trit == T_FALSE {
        let label = "noise"
    } else {
        // uncertain
    }

    return {
        "ok": true,
        "tool": "tfilter",
        "version": "2.0",
        "model": "navier-stokes",
        "trit": trit,
        "reynolds": dict_get(r, "re", 0),
        "regime": dict_get(r, "regime", "unknown"),
        "label": label,
        "text": slice(str(text), 0, 200)
    }
}

// ============================================================================
// TFLOW -- N-S Pipe Flow Router for Sessions + Downloads
// ============================================================================
// Hagen-Poiseuille: Q = (delta_P * pi * r^4) / (8 * mu * L)
// Messages are fluid particles flowing through ternary pipes
// Downloads use mass flow: mdot = rho * v * A
}
}
}
}
}
}

fn tflow_route_message(target, session, role, text) {
    let key = str(target) + "/" + str(session)

    // Reynolds for message content
    let r = tfilter_reynolds(str(text), null, null, null)
    let re_val = dict_get(r, "re", 0)
    let regime = dict_get(r, "regime", "unknown")
    let trit = dict_get(r, "trit", 0)

    // Hagen-Poiseuille throughput
    let words = split(str(text), " ")
    let delta_p = len(words) * word_diversity(str(text))
    let pipe_r = H7
    let mu_flow = max(text_entropy(str(text)), 0.1)
    let l_msg = max(len(str(text)) / 1000.0, 0.1)
    let q_val = (delta_p * 3.14159 * pipe_r * pipe_r * pipe_r * pipe_r) / (8 * mu_flow * l_msg)
    let q_val = round(q_val * 100) / 100

    // Encoding strategy by regime
    let encoding = "raw"
    let priority = "cold"
    if3 regime == "laminar" {
        let encoding = "tzip"
        let priority = "hot"
    } else regime == "transitional" {
        let encoding = "tzip+tspeak"
        let priority = "warm"
    } else {
        // turbulent/chaotic = raw, cold
    }

    // Compression ratio estimate via TZip delegation
    let compression_ratio = 1.0
    try3 {
        let resp = http_post("http://127.0.0.1:9885/tzip/compress",
            {"data": str(text)})
        let csize = dict_get(resp, "compressed_size", len(str(text)))
        let compression_ratio = round(csize * 1000 / max(len(str(text)), 1)) / 1000
    } else {
        // TZip not available
    }

    // Store message in session
    let sess = dict_get(_flow_sessions, key, {})
    if3 len(keys(sess)) == 0 {
        let sess = {}
        let _e = dict_set(sess, "target", target)
        let _e = dict_set(sess, "session", session)
        let _e = dict_set(sess, "messages", [])
        let _e = dict_set(sess, "created", time())
        let _e = dict_set(sess, "total_bytes_raw", 0)
        let _e = dict_set(sess, "total_bytes_compressed", 0)
    } else {
        // existing session
    }

    let msg = {}
    let _e = dict_set(msg, "role", role)
    let _e = dict_set(msg, "text", slice(str(text), 0, 5000))
    let _e = dict_set(msg, "reynolds", re_val)
    let _e = dict_set(msg, "regime", regime)
    let _e = dict_set(msg, "trit", trit)
    let _e = dict_set(msg, "throughput_Q", q_val)
    let _e = dict_set(msg, "encoding", encoding)
    let _e = dict_set(msg, "priority", priority)
    let _e = dict_set(msg, "compression_ratio", compression_ratio)
    let _e = dict_set(msg, "ts", time())

    let msgs = dict_get(sess, "messages", [])
    append(msgs, msg)

    // Trim to 1000 messages
    if3 len(msgs) > 1000 {
        let msgs = slice(msgs, len(msgs) - 1000, len(msgs))
    } else {
        // fits
    }

    let raw_total = dict_get(sess, "total_bytes_raw", 0) + len(str(text))
    let comp_total = dict_get(sess, "total_bytes_compressed", 0) + round(len(str(text)) * compression_ratio)

    let _e = dict_set(sess, "messages", msgs)
    let _e = dict_set(sess, "total_bytes_raw", raw_total)
    let _e = dict_set(sess, "total_bytes_compressed", comp_total)
    let _s = dict_set(_flow_sessions, key, sess)

    return {
        "ok": true,
        "tool": "tflow",
        "action": "route_message",
        "target": target,
        "session": session,
        "reynolds": re_val,
        "regime": regime,
        "throughput_Q": q_val,
        "encoding": encoding,
        "priority": priority,
        "compression_ratio": compression_ratio,
        "messages_stored": len(msgs)
    }
}

fn tflow_recall_session(target, session, limit) {
    let key = str(target) + "/" + str(session)
    let sess = dict_get(_flow_sessions, key, {})

    if3 len(keys(sess)) == 0 {
        return {"ok": false, "error": "Session not found: " + key}
    } else {
        let msgs = dict_get(sess, "messages", [])
        let start = max(len(msgs) - limit, 0)
        let result = []

        let i = start
        while3 i < len(msgs) {
            let m = dict_get(msgs, i, {})
            let entry = {}
            let _e = dict_set(entry, "role", dict_get(m, "role", "unknown"))
            let _e = dict_set(entry, "text", dict_get(m, "text", ""))
            let _e = dict_set(entry, "reynolds", dict_get(m, "reynolds", 0))
            let _e = dict_set(entry, "regime", dict_get(m, "regime", "unknown"))
            let _e = dict_set(entry, "ts", dict_get(m, "ts", 0))
            append(result, entry)
            let i = i + 1
        }

        let total_raw = dict_get(sess, "total_bytes_raw", 0)
        let total_comp = dict_get(sess, "total_bytes_compressed", 0)
        let savings = 0
        if3 total_raw > 0 {
            let savings = round((1 - total_comp / total_raw) * 10000) / 100
        } else {
            // 0
        }

        return {
            "ok": true,
            "tool": "tflow",
            "action": "recall",
            "target": target,
            "session": session,
            "messages": result,
            "count": len(result),
            "total_stored": len(msgs),
            "memory_savings": str(savings) + "%",
            "total_bytes_raw": total_raw,
            "total_bytes_compressed": total_comp
        }
    }
}

fn tflow_route_download(url, filename, size_bytes) {
    // Determine density by extension
    let rho = 1.0
    if3 ends_with(filename, ".zip") {
        let rho = 3.0
    } else ends_with(filename, ".gz") {
        let rho = 3.0
    } else ends_with(filename, ".7z") {
        let rho = 3.0
    } else ends_with(filename, ".rar") {
        let rho = 3.0
    } else ends_with(filename, ".mp4") {
        let rho = 3.0
    } else ends_with(filename, ".mp3") {
        let rho = 3.0
    } else ends_with(filename, ".jpg") {
        let rho = 3.0
    } else ends_with(filename, ".png") {
        let rho = 3.0
    } else ends_with(filename, ".exe") {
        let rho = 3.0
    } else ends_with(filename, ".dll") {
        let rho = 3.0
    } else {
        // sparse content
    }

    let v = max(size_bytes / 1048576, 0.1)
    let big_l = len(str(url)) / 100.0
    let mu = 0.5
    if3 contains(str(url), "localhost") {
        // local -- low viscosity
    } else {
        let mu = 2.0
    }

    let re = (rho * v * big_l) / max(mu, 0.1)
    let re = round(re * 100) / 100

    // Strategy by Reynolds
    let strategy = "direct"
    let chunks = 1
    let do_compress = true

    if3 re < RE_LAMINAR {
        let strategy = "direct"
        let chunks = 1
        let do_compress = true
    } else re < RE_TRANSITIONAL {
        let strategy = "dual"
        let chunks = H3
        let do_compress = true
    } else re < RE_TURBULENT {
        let strategy = "parallel"
        let chunks = H7
        let do_compress = true
    } else {
        let strategy = "scatter"
        let chunks = H13
        let do_compress = false
    }

    let regime = classify_flow(re)
    let tier = "hot"
    if3 size_bytes > 104857600 {
        let tier = "cold"
    } else size_bytes > 1048576 {
        let tier = "warm"
    } else {
        // hot
    }

    let estimated_savings = "5%"
    if3 do_compress == true {
        if3 rho < 3.0 {
            let estimated_savings = "60%"
        } else {
            // dense files don't compress well
    } else {
        // no compression
    }

    return {
        "ok": true,
        "tool": "tflow",
        "action": "download_route",
        "url": url,
        "filename": filename,
        "reynolds": re,
        "regime": regime,
        "strategy": strategy,
        "chunks": chunks,
        "compress": do_compress,
        "storage_tier": tier,
        "estimated_savings": estimated_savings
    }
}
}

fn tflow_list_sessions() {
    let result = {}
    let skeys = keys(_flow_sessions)
    let i = 0
    while3 i < len(skeys) {
        let key = dict_get(skeys, i, "")
        let data = dict_get(_flow_sessions, key, {})
        let n = len(dict_get(data, "messages", []))
        let raw = dict_get(data, "total_bytes_raw", 0)
        let comp = dict_get(data, "total_bytes_compressed", 0)
        let savings = 0
        if3 raw > 0 {
            let savings = round((1 - comp / raw) * 10000) / 100
        } else {
            // 0
        }
        let info = {}
        let _e = dict_set(info, "messages", n)
        let _e = dict_set(info, "bytes_raw", raw)
        let _e = dict_set(info, "bytes_compressed", comp)
        let _e = dict_set(info, "savings", str(savings) + "%")
        let _s = dict_set(result, key, info)
        let i = i + 1
    }
    return result
}

fn tflow_status() {
    let total_msgs = 0
    let total_raw = 0
    let total_comp = 0
    let skeys = keys(_flow_sessions)
    let i = 0
    while3 i < len(skeys) {
        let key = dict_get(skeys, i, "")
        let data = dict_get(_flow_sessions, key, {})
        let total_msgs = total_msgs + len(dict_get(data, "messages", []))
        let total_raw = total_raw + dict_get(data, "total_bytes_raw", 0)
        let total_comp = total_comp + dict_get(data, "total_bytes_compressed", 0)
        let i = i + 1
    }

    let savings = 0
    if3 total_raw > 0 {
        let savings = round((1 - total_comp / total_raw) * 10000) / 100
    } else {
        // 0
    }

    return {
        "ok": true,
        "tool": "tflow",
        "model": "navier-stokes",
        "pipe_model": "hagen-poiseuille",
        "total_sessions": len(skeys),
        "total_messages": total_msgs,
        "total_bytes_raw": total_raw,
        "total_bytes_compressed": total_comp,
        "memory_savings": str(savings) + "%",
        "sessions": tflow_list_sessions(),
        "boundaries": {
            "laminar": RE_LAMINAR,
            "transitional": RE_TRANSITIONAL,
            "turbulent": RE_TURBULENT
        }
    }
}

// ============================================================================
// TWEAVE -- Persistent Compressed Channels (Layer 2: Nervous System)
// ============================================================================

fn tweave_create_channel(source_port, dest_port) {
    let cid = str(source_port) + "->" + str(dest_port)
    let ch = {}
    let _e = dict_set(ch, "source", source_port)
    let _e = dict_set(ch, "dest", dest_port)
    let _e = dict_set(ch, "created", time())
    let _e = dict_set(ch, "messages", 0)
    let _e = dict_set(ch, "bytes_raw", 0)
    let _e = dict_set(ch, "bytes_compressed", 0)
    let _s = dict_set(_weave_channels, cid, ch)
    return cid
}

fn tweave_send(channel_id, data) {
    let ch = dict_get(_weave_channels, channel_id, {})
    if3 len(keys(ch)) == 0 {
        return {"ok": false, "error": "channel not found"}
    } else {
        let raw = json_encode(data)
        let raw_size = len(raw)
        let dest_port = dict_get(ch, "dest", 0)

        // Update stats
        let msgs = dict_get(ch, "messages", 0) + 1
        let br = dict_get(ch, "bytes_raw", 0) + raw_size
        let _e = dict_set(ch, "messages", msgs)
        let _e = dict_set(ch, "bytes_raw", br)

        // Attempt delivery
        let delivered = false
        try3 {
            let url = "http://127.0.0.1:" + str(dest_port) + "/tweave/receive"
            let resp = http_post(url, data)
            let delivered = true
        } else {
            // delivery failed
        }

        // Estimate compression
        let compressed_size = raw_size
        try3 {
            let resp = http_post("http://127.0.0.1:9885/tzip/compress",
                {"data": raw})
            let compressed_size = dict_get(resp, "compressed_size", raw_size)
        } else {
            // TZip not available
        }

        let bc = dict_get(ch, "bytes_compressed", 0) + compressed_size
        let _e = dict_set(ch, "bytes_compressed", bc)
        let _s = dict_set(_weave_channels, channel_id, ch)

        let savings = 0
        if3 raw_size > 0 {
            let savings = round((1 - compressed_size / raw_size) * 10000) / 100
        } else {
            // 0
        }

        return {
            "ok": true,
            "delivered": delivered,
            "raw": raw_size,
            "compressed": compressed_size,
            "savings": str(savings) + "%"
        }
    }
}

fn tweave_status() {
    let total_raw = 0
    let total_comp = 0
    let total_msgs = 0
    let channel_list = []
    let ckeys = keys(_weave_channels)
    let i = 0
    while3 i < len(ckeys) {
        let cid = dict_get(ckeys, i, "")
        let ch = dict_get(_weave_channels, cid, {})
        let total_raw = total_raw + dict_get(ch, "bytes_raw", 0)
        let total_comp = total_comp + dict_get(ch, "bytes_compressed", 0)
        let total_msgs = total_msgs + dict_get(ch, "messages", 0)
        append(channel_list, cid)
        let i = i + 1
    }
    let savings = 0
    if3 total_raw > 0 {
        let savings = round((1 - total_comp / total_raw) * 10000) / 100
    } else {
        // 0
    }
    return {
        "channels": len(ckeys),
        "total_messages": total_msgs,
        "bytes_raw": total_raw,
        "bytes_compressed": total_comp,
        "savings": str(savings) + "%",
        "channel_list": channel_list
    }
}

// ============================================================================
// TSHIELD -- Reynolds on HTTP Traffic (Layer 6)
// ============================================================================

fn tshield_record(source, method, path, size) {
    let entry = dict_get(_shield_traffic, source, {})
    if3 len(keys(entry)) == 0 {
        let entry = {}
        let _e = dict_set(entry, "requests", [])
        let _e = dict_set(entry, "total_bytes", 0)
    } else {
        // existing source
    }

    let req = {}
    let _e = dict_set(req, "time", time())
    let _e = dict_set(req, "method", method)
    let _e = dict_set(req, "path", path)
    let _e = dict_set(req, "size", size)

    let reqs = dict_get(entry, "requests", [])
    append(reqs, req)
    // Keep last 100 requests
    if3 len(reqs) > 100 {
        let reqs = slice(reqs, len(reqs) - 100, len(reqs))
    } else {
        // fits
    }

    let _e = dict_set(entry, "requests", reqs)
    let tb = dict_get(entry, "total_bytes", 0) + size
    let _e = dict_set(entry, "total_bytes", tb)
    let _s = dict_set(_shield_traffic, source, entry)
}

fn tshield_analyze(source) {
    let results = {}
    let src_keys = keys(_shield_traffic)

    // Filter to single source if provided
    if3 type_of(source) == "string" {
        if3 len(source) > 0 {
            let src_keys = [source]
        } else {
            // all sources
    } else {
        // all sources
    }

    let si = 0
    while3 si < len(src_keys) {
        let src = dict_get(src_keys, si, "")
        let data = dict_get(_shield_traffic, src, {})
        if3 len(keys(data)) == 0 {
            let si = si + 1
        } else {
            let reqs = dict_get(data, "requests", [])
            if3 len(reqs) < 2 {
                let _s = dict_set(results, src, {
                    "reynolds": 0, "regime": "laminar", "risk": "none"
                })
            } else {
                // Count recent requests (last 60 seconds)
                let now = time()
                let recent = []
                let ri = 0
                while3 ri < len(reqs) {
                    let req = dict_get(reqs, ri, {})
                    let rt = dict_get(req, "time", 0)
                    if3 now - rt < 60 {
                        append(recent, req)
                    } else {
                        // old request
                    }
                    let ri = ri + 1
                }

                if3 len(recent) == 0 {
                    let _s = dict_set(results, src, {
                        "reynolds": 0, "regime": "laminar", "risk": "none"
                    })
                } else {
                    let rate = len(recent) / 60.0

                    // Path diversity
                    let paths = {}
                    let avg_size = 0
                    let pi = 0
                    while3 pi < len(recent) {
                        let req = dict_get(recent, pi, {})
                        let p = dict_get(req, "path", "/")
                        let _s = dict_set(paths, p, 1)
                        let avg_size = avg_size + dict_get(req, "size", 0)
                        let pi = pi + 1
                    }
                    let avg_size = avg_size / max(len(recent), 1)
                    let diversity = len(keys(paths)) / max(len(recent), 1)

                    let re_val = rate * diversity * avg_size
                    let re_val = round(re_val * 100) / 100

                    let regime = "laminar"
                    let risk = "none"
                    if3 re_val >= RE_TURBULENT {
                        let regime = "chaotic"
                        let risk = "high"
                    } else re_val >= RE_TRANSITIONAL {
                        let regime = "turbulent"
                        let risk = "medium"
                    } else re_val >= RE_LAMINAR {
                        let regime = "transitional"
                        let risk = "low"
                    } else {
                        // laminar/none
                    }

                    let info = {}
                    let _e = dict_set(info, "reynolds", re_val)
                    let _e = dict_set(info, "regime", regime)
                    let _e = dict_set(info, "risk", risk)
                    let _e = dict_set(info, "rate_per_sec", round(rate * 100) / 100)
                    let _e = dict_set(info, "unique_routes", len(keys(paths)))
                    let _e = dict_set(info, "avg_payload", round(avg_size * 10) / 10)
                    let _e = dict_set(info, "recent_requests", len(recent))
                    let _s = dict_set(results, src, info)
                }
            }
            let si = si + 1
        }
    }
    return results
}

