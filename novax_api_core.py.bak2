# ── Request Handler ─────────────────────────────────────────────────

class NovaAPIHandler(http.server.SimpleHTTPRequestHandler):
    """Handles all NovaX API and static file requests."""

    def __init__(self, *args, **kwargs):
        # Set the static directory for serving files
        super().__init__(*args, directory=STATIC_DIR if os.path.isdir(STATIC_DIR) else ".", **kwargs)

    def log_message(self, format, *args):
        """Suppress default logging noise."""
        pass

    def send_json(self, data, status=200):
        """Send JSON response with CORS headers."""
        body = json.dumps(data, ensure_ascii=False, indent=2).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type, Authorization, X-API-Key")
        self.end_headers()
        self.wfile.write(body)

    def send_error_json(self, message, status=400):
        self.send_json({"error": message, "ok": False}, status)

    def read_body(self):
        """Read and parse JSON request body."""
        length = int(self.headers.get("Content-Length", 0))
        if length == 0:
            return {}
        raw = self.rfile.read(length)
        try:
            return json.loads(raw.decode("utf-8"))
        except:
            return {}

    def do_OPTIONS(self):
        """Handle CORS preflight."""
        self.send_response(204)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type, Authorization, X-API-Key")
        self.send_header("Access-Control-Max-Age", "86400")
        self.end_headers()

    def do_GET(self):
        parsed = urlparse(self.path)
        path = parsed.path.rstrip("/")
        params = parse_qs(parsed.query)

        # ── API v1 Routes ──
        if path == "/api/v1/manifest":
            return self.send_json(MANIFEST)

        elif path == "/api/v1/health":
            return self.handle_health()

        elif path == "/api/v1/services":
            return self.handle_services_get()

        elif path == "/api/v1/sections":
            return self.handle_sections()

        elif path == "/api/v1/system":
            return self.handle_system()

        elif path == "/api/v1/logs":
            return self.handle_logs(params)

        elif path == "/api/v1/files/read":
            return self.handle_file_read(params)

        elif path == "/api/v1/files/list":
            return self.handle_file_list(params)

        # ── Legacy terminal API (backward compat) ──
        elif path.startswith("/api/"):
            return self.send_error_json(f"Unknown GET endpoint: {path}", 404)

        # ── Static files ──
        elif path.startswith("/static/"):
            self.path = path[7:]  # strip /static prefix
            return super().do_GET()

        else:
            return super().do_GET()

    def do_POST(self):
        parsed = urlparse(self.path)
        path = parsed.path.rstrip("/")
        body = self.read_body()

        # ── API v1 Routes ──
        if path == "/api/v1/exec":
            return self.handle_exec(body)

        elif path == "/api/v1/python":
            return self.handle_python(body)

        elif path == "/api/v1/python_file":
            return self.handle_python_file(body)

        elif path == "/api/v1/services/action":
            return self.handle_services_action(body)

        elif path == "/api/v1/sections/open":
            return self.handle_sections_open(body)

        elif path == "/api/v1/files/write":
            return self.handle_file_write(body)

        elif path == "/api/v1/batch":
            return self.handle_batch(body)

        # ── Legacy bridge terminal API ──
        elif path == "/api/terminal":
            cmd = body.get("command", "")
            if not cmd:
                return self.send_error_json("No command provided")
            result = run_cmd(cmd)
            return self.send_json({"output": result["stdout"] or result["stderr"]})

        else:
            return self.send_error_json(f"Unknown POST endpoint: {path}", 404)

    # ── Handler implementations ─────────────────────────────────────

    def handle_health(self):
        statuses = get_service_status()
        running = sum(1 for s in statuses.values() if s["status"] == "running")
        total = len(statuses)
        if running == total:
            state = "operational"
        elif running == 0:
            state = "down"
        else:
            state = "degraded"
        self.send_json({
            "ok": True,
            "state": state,
            "services_up": running,
            "services_total": total,
            "timestamp": time.time(),
        })

    def handle_services_get(self):
        statuses = get_service_status()
        running = sum(1 for s in statuses.values() if s["status"] == "running")
        self.send_json({
            "ok": True,
            "services": statuses,
            "summary": f"{running}/{len(statuses)} running",
        })

    def handle_services_action(self, body):
        action = body.get("action", "")
        results = []

        if action == "launch_nova":
            # Launch main.py with UTF-8
            r = run_cmd(
                f'{PYTHON} -c "import subprocess,os; '
                f"env=os.environ.copy(); env['PYTHONUTF8']='1'; "
                f"subprocess.Popen([r'{PYTHON}', r'C:\\NovaX\\novax\\main.py'], "
                f"cwd=r'C:\\NovaX', env=env, creationflags=0x00000008)\"",
                timeout=10
            )
            results.append({"action": "launch_nova", "result": r})

        elif action == "stop_all":
            r = run_cmd(
                'powershell -Command "Get-NetTCPConnection -State Listen | '
                'Where-Object { $_.LocalPort -in @(9990,9991,9997,9998,18789) } | '
                'ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue; '
                'Write-Output \\"Stopped PID $($_.OwningProcess) on :$($_.LocalPort)\\" }"',
                timeout=10
            )
            results.append({"action": "stop_all", "result": r})

        elif action == "kill_stale":
            r = run_cmd(
                'powershell -Command "Get-NetTCPConnection -State Listen | '
                'Where-Object { $_.LocalPort -in @(9990,9991,9997,9998,18789) } | '
                'ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue; '
                'Write-Output \\"Killed PID $($_.OwningProcess) on :$($_.LocalPort)\\" }"',
                timeout=10
            )
            results.append({"action": "kill_stale", "result": r})

        elif action == "restart_all":
            # Stop then launch
            stop = run_cmd(
                'powershell -Command "Get-NetTCPConnection -State Listen | '
                'Where-Object { $_.LocalPort -in @(9990,9991,9997,9998,18789) } | '
                'ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }"',
                timeout=10
            )
            time.sleep(2)
            start = run_cmd(
                f'{PYTHON} -c "import subprocess,os; '
                f"env=os.environ.copy(); env['PYTHONUTF8']='1'; "
                f"subprocess.Popen([r'{PYTHON}', r'C:\\NovaX\\novax\\main.py'], "
                f"cwd=r'C:\\NovaX', env=env, creationflags=0x00000008)\"",
                timeout=10
            )
            results.append({"action": "stop", "result": stop})
            results.append({"action": "start", "result": start})

        else:
            return self.send_error_json(f"Unknown action: {action}. Use: launch_nova, stop_all, kill_stale, restart_all")

        self.send_json({"ok": True, "results": results})

    def handle_sections(self):
        sections = []
        for s in SECTIONS:
            sections.append({
                **s,
                "url": f"http://localhost:{PORT}/static/{s['file']}",
            })
        self.send_json({"ok": True, "sections": sections, "count": len(sections)})

    def handle_sections_open(self, body):
        # This returns URLs; actual opening is done by the caller
        ids = body.get("ids", [])
        if not ids:
            ids = [s["id"] for s in SECTIONS]  # open all
        urls = []
        for s in SECTIONS:
            if s["id"] in ids:
                urls.append(f"http://localhost:{PORT}/static/{s['file']}")
        self.send_json({"ok": True, "urls": urls})

    def handle_exec(self, body):
        cmd = body.get("command", "")
        if not cmd:
            return self.send_error_json("'command' is required")
        timeout = body.get("timeout", EXEC_TIMEOUT)
        cwd = body.get("cwd", None)
        result = run_cmd(cmd, timeout=timeout, cwd=cwd)
        result["ok"] = True
        self.send_json(result)

    def handle_python(self, body):
        code = body.get("code", "")
        if not code:
            return self.send_error_json("'code' is required")
        timeout = body.get("timeout", EXEC_TIMEOUT)
        # Escape for command line
        escaped = code.replace("\\", "\\\\").replace('"', '\\"')
        result = run_cmd(f'{PYTHON} -c "{escaped}"', timeout=timeout)
        result["ok"] = True
        self.send_json(result)

    def handle_python_file(self, body):
        code = body.get("code", "")
        if not code:
            return self.send_error_json("'code' is required")
        timeout = body.get("timeout", EXEC_TIMEOUT)
        # Write to temp file and execute
        tmp = os.path.join(NOVA_ROOT, "_api_tmp.py")
        try:
            with open(tmp, "w", encoding="utf-8") as f:
                f.write(code)
            result = run_cmd(f'{PYTHON} "{tmp}"', timeout=timeout)
            result["ok"] = True
            self.send_json(result)
        except Exception as e:
            self.send_error_json(str(e), 500)
        finally:
            try:
                os.remove(tmp)
            except:
                pass

    def handle_file_read(self, params):
        fpath = params.get("path", [None])[0]
        if not fpath:
            return self.send_error_json("'path' query param required")
        encoding = params.get("encoding", ["utf-8"])[0]
        try:
            with open(fpath, "r", encoding=encoding, errors="replace") as f:
                content = f.read()
            self.send_json({
                "ok": True,
                "path": fpath,
                "content": content,
                "size": len(content),
            })
        except FileNotFoundError:
            self.send_error_json(f"File not found: {fpath}", 404)
        except Exception as e:
            self.send_error_json(str(e), 500)

    def handle_file_write(self, body):
        fpath = body.get("path", "")
        content = body.get("content", "")
        if not fpath:
            return self.send_error_json("'path' is required")
        encoding = body.get("encoding", "utf-8")
        mode = body.get("mode", "w")
        try:
            os.makedirs(os.path.dirname(fpath), exist_ok=True)
            with open(fpath, mode, encoding=encoding) as f:
                f.write(content)
            self.send_json({
                "ok": True,
                "path": fpath,
                "bytes_written": len(content.encode(encoding)),
            })
        except Exception as e:
            self.send_error_json(str(e), 500)

    def handle_file_list(self, params):
        dpath = params.get("path", [NOVA_ROOT])[0]
        recursive = params.get("recursive", ["false"])[0].lower() == "true"
        try:
            entries = []
            if recursive:
                for root, dirs, files in os.walk(dpath):
                    # Skip heavy dirs
                    dirs[:] = [d for d in dirs if d not in (".git", "node_modules", "__pycache__", ".venv")]
                    for f in files:
                        full = os.path.join(root, f)
                        entries.append({
                            "name": f,
                            "path": full,
                            "type": "file",
                            "size": os.path.getsize(full),
                        })
                    if len(entries) > 500:
                        break
            else:
                for item in os.listdir(dpath):
                    full = os.path.join(dpath, item)
                    entries.append({
                        "name": item,
                        "path": full,
                        "type": "dir" if os.path.isdir(full) else "file",
                        "size": os.path.getsize(full) if os.path.isfile(full) else None,
                    })
            self.send_json({"ok": True, "path": dpath, "entries": entries, "count": len(entries)})
        except FileNotFoundError:
            self.send_error_json(f"Directory not found: {dpath}", 404)
        except Exception as e:
            self.send_error_json(str(e), 500)

    def handle_system(self):
        info = get_system_info()
        info["ok"] = True
        self.send_json(info)

    def handle_logs(self, params):
        name = params.get("name", [None])[0]
        lines = int(params.get("lines", ["50"])[0])

        if not os.path.isdir(LOG_DIR):
            return self.send_json({"ok": True, "logs": [], "message": "No log directory found"})

        if name:
            log_path = os.path.join(LOG_DIR, name)
        else:
            # Find most recent log
            logs = sorted(
                [f for f in os.listdir(LOG_DIR) if f.endswith(".log")],
                key=lambda f: os.path.getmtime(os.path.join(LOG_DIR, f)),
                reverse=True
            )
            if not logs:
                return self.send_json({"ok": True, "logs": [], "message": "No log files found"})
            log_path = os.path.join(LOG_DIR, logs[0])
            name = logs[0]

        try:
            with open(log_path, "r", encoding="utf-8", errors="replace") as f:
                all_lines = f.readlines()
            tail = all_lines[-lines:] if len(all_lines) > lines else all_lines
            self.send_json({
                "ok": True,
                "name": name,
                "path": log_path,
                "total_lines": len(all_lines),
                "returned_lines": len(tail),
                "content": "".join(tail),
            })
        except FileNotFoundError:
            self.send_error_json(f"Log not found: {name}", 404)
        except Exception as e:
            self.send_error_json(str(e), 500)

    def handle_batch(self, body):
        calls = body.get("calls", [])
        if not calls:
            return self.send_error_json("'calls' array is required")

        results = []
        for i, call in enumerate(calls):
            method = call.get("method", "GET").upper()
            path = call.get("path", "")
            call_body = call.get("body", {})

            try:
                # Route internally
                if method == "GET":
                    if path == "/services":
                        statuses = get_service_status()
                        running = sum(1 for s in statuses.values() if s["status"] == "running")
                        results.append({"ok": True, "services": statuses, "summary": f"{running}/{len(statuses)} running"})
                    elif path == "/health":
                        statuses = get_service_status()
                        running = sum(1 for s in statuses.values() if s["status"] == "running")
                        results.append({"ok": True, "services_up": running, "services_total": len(statuses)})
                    elif path == "/system":
                        results.append({**get_system_info(), "ok": True})
                    elif path == "/sections":
                        results.append({"ok": True, "sections": SECTIONS})
                    else:
                        results.append({"ok": False, "error": f"Unknown batch GET: {path}"})
                elif method == "POST":
                    if path == "/exec":
                        r = run_cmd(call_body.get("command", ""), timeout=call_body.get("timeout", EXEC_TIMEOUT))
                        r["ok"] = True
                        results.append(r)
                    elif path == "/python_file":
                        code = call_body.get("code", "")
                        tmp = os.path.join(NOVA_ROOT, f"_batch_{i}.py")
                        with open(tmp, "w", encoding="utf-8") as f:
                            f.write(code)
                        r = run_cmd(f'{PYTHON} "{tmp}"', timeout=call_body.get("timeout", EXEC_TIMEOUT))
                        r["ok"] = True
                        results.append(r)
                        try: os.remove(tmp)
                        except: pass
                    else:
                        results.append({"ok": False, "error": f"Unknown batch POST: {path}"})
            except Exception as e:
                results.append({"ok": False, "error": str(e), "index": i})

        self.send_json({"ok": True, "results": results, "count": len(results)})


# ── Server ──────────────────────────────────────────────────────────

class ThreadedHTTPServer(http.server.ThreadingHTTPServer):
    allow_reuse_address = True
    daemon_threads = True


def main():
    print(f"NovaX Core API v1 starting on :{PORT}")
    print(f"  Nova Root:  {NOVA_ROOT}")
    print(f"  Static Dir: {STATIC_DIR}")
    print(f"  Python:     {PYTHON}")
    print()

    # Check if bridge is already running on our port
    if check_port(PORT, timeout=0.5):
        print(f"  WARNING: Port {PORT} already in use (bridge running?)")
        print(f"  This API will replace the bridge. Stop bridge first or use a different port.")
        print()

    server = ThreadedHTTPServer((HOST, PORT), NovaAPIHandler)
    print(f"  API ready: http://localhost:{PORT}/api/v1/manifest")
    print(f"  Health:    http://localhost:{PORT}/api/v1/health")
    print(f"  Static:    http://localhost:{PORT}/static/shell.html")
    print()

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nShutting down...")
        server.shutdown()


if __name__ == "__main__":
    main()