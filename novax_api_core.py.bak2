# ── Helpers ─────────────────────────────────────────────────────────

def check_port(port, timeout=1.5):
    """Check if a port is listening."""
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=timeout):
            return True
    except (ConnectionRefusedError, TimeoutError, OSError):
        return False


def run_cmd(cmd, timeout=EXEC_TIMEOUT, cwd=None, shell=True):
    """Execute a command and return structured output."""
    try:
        env = os.environ.copy()
        env["PYTHONUTF8"] = "1"
        result = subprocess.run(
            cmd, shell=shell, capture_output=True, text=True,
            timeout=timeout, cwd=cwd or NOVA_ROOT, env=env,
            encoding="utf-8", errors="replace"
        )
        return {
            "success": result.returncode == 0,
            "exit_code": result.returncode,
            "stdout": result.stdout.strip(),
            "stderr": result.stderr.strip(),
        }
    except subprocess.TimeoutExpired:
        return {"success": False, "exit_code": -1, "stdout": "", "stderr": f"Timeout after {timeout}s"}
    except Exception as e:
        return {"success": False, "exit_code": -1, "stdout": "", "stderr": str(e)}


def run_python(code, timeout=EXEC_TIMEOUT):
    """Execute Python code in the Nova venv."""
    return run_cmd(f'{PYTHON} -c "{code}"', timeout=timeout)


def get_service_status():
    """Get status of all services."""
    results = {}
    # Use netstat for speed - one call checks all ports
    net = run_cmd('netstat -ano | findstr "LISTENING"', timeout=5)
    lines = net.get("stdout", "") if net["success"] else ""

    for sid, info in SERVICES.items():
        port_str = f":{info['port']}"
        listening = port_str in lines and "LISTENING" in lines
        # Get PID if listening
        pid = None
        if listening:
            for line in lines.split("\n"):
                if port_str in line and "LISTENING" in line:
                    parts = line.split()
                    if parts:
                        try:
                            pid = int(parts[-1])
                        except ValueError:
                            pass
                    break
        results[sid] = {
            "id": sid,
            "name": info["name"],
            "port": info["port"],
            "status": "running" if listening else "stopped",
            "pid": pid,
        }
    return results


def get_system_info():
    """Get system information."""
    info = {
        "platform": platform.system(),
        "release": platform.release(),
        "machine": platform.machine(),
        "python": sys.version.split()[0],
        "nova_root": NOVA_ROOT,
    }
    # RAM
    mem = run_cmd('powershell -Command "(Get-CimInstance Win32_OperatingSystem | Select FreePhysicalMemory,TotalVisibleMemorySize | ConvertTo-Json)"', timeout=5)
    if mem["success"]:
        try:
            m = json.loads(mem["stdout"])
            total = int(m.get("TotalVisibleMemorySize", 0)) / 1024  # MB
            free = int(m.get("FreePhysicalMemory", 0)) / 1024
            info["ram_total_mb"] = round(total)
            info["ram_free_mb"] = round(free)
            info["ram_used_pct"] = round((1 - free / total) * 100, 1) if total else 0
        except:
            pass
    # Disk
    disk = shutil.disk_usage("C:\\")
    info["disk_total_gb"] = round(disk.total / (1024**3), 1)
    info["disk_free_gb"] = round(disk.free / (1024**3), 1)
    info["disk_used_pct"] = round(disk.used / disk.total * 100, 1)
    # CPU
    cpu = run_cmd('powershell -Command "(Get-CimInstance Win32_Processor).LoadPercentage"', timeout=5)
    if cpu["success"] and cpu["stdout"].strip().isdigit():
        info["cpu_pct"] = int(cpu["stdout"].strip())
    return info


