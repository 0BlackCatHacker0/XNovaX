"""
NovaX Core API v1 - Universal AI Model Access Layer
=====================================================
Patches into the Nova Bridge (port 9999) to expose a structured
REST API that any AI model can use as tools/functions.

Endpoints:
  POST /api/v1/exec          - Execute shell commands (structured output)
  POST /api/v1/python        - Execute Python code directly
  GET  /api/v1/services      - Service health + status for all 6 ports
  POST /api/v1/services/action - Start/stop/restart services
  GET  /api/v1/sections      - List all 14 UI sections with URLs
  POST /api/v1/sections/open - Open section(s) in browser
  GET  /api/v1/files/read    - Read file contents
  POST /api/v1/files/write   - Write file contents
  GET  /api/v1/files/list    - List directory contents
  GET  /api/v1/system        - System info (RAM, CPU, disk, uptime)
  GET  /api/v1/logs          - Read Nova log files
  GET  /api/v1/health        - Quick health check (for heartbeats)
  GET  /api/v1/manifest      - Tool manifest for AI model discovery
  POST /api/v1/batch         - Execute multiple API calls in one request

Deploy: python novax_api_core.py
  - Patches into bridge at :9999 if running, else standalone on :9999
  - CORS enabled for all origins
  - No auth required (localhost only)
"""

import http.server
import json
import subprocess
import os
import sys
import socket
import time
import platform
import threading
import traceback
import shutil
import base64
from urllib.parse import urlparse, parse_qs
from pathlib import Path

