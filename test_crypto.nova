// ═══ NovaX Crypto Test Suite ═══
print("═══ CRYPTO TEST SUITE ═══")

// Test 1: SHA-256 (NIST FIPS 180-4)
print("")
print("--- SHA-256 ---")
let h1 = sha256("hello")
print("sha256('hello') = " + h1)
print("expected:         2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824")
if3 h1 == "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824" {
    print("  PASS +1")
} else3 {
    print("  FAIL -1")
}

let h2 = sha256("")
print("sha256('') = " + h2)
print("expected:    e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
if3 h2 == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" {
    print("  PASS +1")
} else3 {
    print("  FAIL -1")
}

// Test 2: HMAC-SHA256 (RFC 4231)
print("")
print("--- HMAC-SHA256 ---")
let hm = hmac_sha256("key", "The quick brown fox jumps over the lazy dog")
print("hmac('key', 'The quick...') = " + hm)
print("expected:                      f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8")
if3 hm == "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8" {
    print("  PASS +1")
} else3 {
    print("  FAIL -1")
}

// Test 3: PBKDF2-SHA256
print("")
print("--- PBKDF2-SHA256 ---")
let dk = pbkdf2("password", "salt", 1, 32)
print("pbkdf2('password','salt',1,32) = " + dk)
print("expected:                         120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b")
if3 dk == "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b" {
    print("  PASS +1")
} else3 {
    print("  FAIL -1")
}

// Test 4: Secure Random
print("")
print("--- SECURE RANDOM ---")
let r1 = random_bytes(16)
let r2 = random_bytes(16)
print("random_bytes(16) = " + r1)
print("random_bytes(16) = " + r2)
if3 r1 != r2 {
    print("  PASS +1 (different each time)")
} else3 {
    print("  FAIL -1 (identical!)")
}
print("length check: " + str(len(r1)) + " hex chars (expect 32)")

// Test 5: AES-256-GCM encrypt/decrypt round-trip
print("")
print("--- AES-256-GCM ---")
// Generate a 256-bit key via PBKDF2
let aes_key = pbkdf2("my_secret_password", "novax_salt_2026", 10000, 32)
print("key (from pbkdf2) = " + aes_key)

let plaintext = "NovaX Level 4 Security: Ternary-first AI OS with real encryption"
let encrypted = aes_encrypt(plaintext, aes_key)
print("encrypted = " + encrypted)

let decrypted = aes_decrypt(encrypted, aes_key)
print("decrypted = " + decrypted)

if3 decrypted == plaintext {
    print("  PASS +1 (round-trip verified)")
} else3 {
    print("  FAIL -1")
}

// Test 6: Tamper detection (authentication)
print("")
print("--- TAMPER DETECTION ---")
// Flip a bit in the ciphertext
let tampered = "00" + slice(encrypted, 2, len(encrypted))
let result = aes_decrypt(tampered, aes_key)
print("tampered decrypt = " + result)
if3 starts_with(result, "ERROR") {
    print("  PASS +1 (tamper detected!)")
} else3 {
    print("  FAIL -1 (tamper not detected)")
}

print("")
print("═══ CRYPTO SUITE COMPLETE ═══")
