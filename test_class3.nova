// Test class3/extends3/new3 + import3

print("=== class3/extends3 Test ===")

// Basic class
class3 Animal {
    fn init(self, name, sound) {
        self.name = name
        self.sound = sound
    }
    fn speak(self) {
        return self.name + " says " + self.sound
    }
    fn get_name(self) {
        return self.name
    }
}

// Inheritance
class3 Dog extends3 Animal {
    fn speak(self) {
        return self.name + " barks: " + self.sound + "!"
    }
    fn fetch(self, item) {
        return self.name + " fetches " + item
    }
}

class3 Cat extends3 Animal {
    fn speak(self) {
        return self.name + " purrs: " + self.sound
    }
}

// Instantiation
let a = new3 Animal("Parrot", "squawk")
print("Animal:", a.speak())
print("Name:", a.get_name())

let d = new3 Dog("Rex", "WOOF")
print("Dog:", d.speak())
print("Fetch:", d.fetch("ball"))
// Inherited method
print("Dog name:", d.get_name())

let c = new3 Cat("Whiskers", "mrrrow")
print("Cat:", c.speak())
print("Cat name:", c.get_name())

// Class with fields
class3 Counter {
    let count = 0
    fn init(self, start) {
        self.count = start
    }
    fn value(self) {
        return self.count
    }
}

let ctr = new3 Counter(42)
print("Counter:", ctr.value())

print("\n=== ALL CLASS3 TESTS PASSED ===")
