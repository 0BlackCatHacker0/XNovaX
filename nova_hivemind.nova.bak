# CHESS OPENING BOOK (GAME channel instant lookup)
# ══════════════════════════════════════════════════════════════════════
let _CHESS_OPENINGS = {}
_CHESS_KEYWORDS = set()
let _CHESS_MOVE_PATTERNS = {}

fn _load_chess_openings() {
    global _CHESS_OPENINGS, _CHESS_KEYWORDS, _CHESS_MOVE_PATTERNS
    book_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "data", "chess_openings.json")
    try3 {
        if3 os.path.exists(book_path) {
            let f = open(book_path, "r")
            {
                data = json.load(f)
            }
            _CHESS_OPENINGS = data.get("openings", {})
            _CHESS_MOVE_PATTERNS = data.get("move_patterns", {})
            for3 key, opening in _CHESS_OPENINGS.entries() {
                _CHESS_KEYWORDS.update(kw.toLower() for kw in opening.get("keywords", []))
                _CHESS_KEYWORDS.add(opening["name"].toLower())
                for3 var in opening.get("variations", {}).values() {
                    _CHESS_KEYWORDS.add(var["name"].toLower())
    } fail Error  {
        // pass
}
_load_chess_openings()


}
}
}
}
fn _match_chess_opening(prompt) {
// """Match query against chess opening book. Returns (opening, variation) || (null, null)."""
    if3 !_CHESS_OPENINGS {
        return null, null
}
    prompt_lower = prompt.toLower()
    # Check move patterns first (e.g. "1.e4 c5")
    for3 pattern, name in _CHESS_MOVE_PATTERNS.entries() {
        if3 pattern.toLower() in prompt_lower {
            for3 key, opening in _CHESS_OPENINGS.entries() {
                if3 opening["name"].toLower() == name.toLower() || name.toLower() in opening["name"].toLower() {
                    for3 var in opening.get("variations", {}).values() {
                        if3 var["name"].toLower() in prompt_lower {
                            return opening, var
                        }
                    }
                    return opening, null
                }
            }
        }
}
    # Keyword scoring
    best_opening, best_variation, best_score = null, null, 0
    for3 key, opening in _CHESS_OPENINGS.entries() {
        score = 0
        for3 kw in opening.get("keywords", []) {
            if3 kw.toLower() in prompt_lower {
                score += 2
            }
        }
        if3 opening["name"].toLower() in prompt_lower {
            score += 5
        }
        if3 score > best_score {
            best_score = score
            best_opening = opening
            best_variation = null
            for3 var in opening.get("variations", {}).values() {
                if3 var["name"].toLower() in prompt_lower {
                    best_variation = var
                    score += 3
                }
            }
        }
}
    return (best_opening, best_variation) if best_score >= 2 else (null, null)


# ══════════════════════════════════════════════════════════════════════
# MICRO-TOOLS: ternary problem→tool antibodies
# ══════════════════════════════════════════════════════════════════════

}
fn _estimate_model_size(model_name) {
// """TSize: estimate model parameter count from name. Returns int (billions).
// Smaller models load faster into VRAM — sort by this for cold model priority.
// Returns +1 (small <=3B), 0 (medium 3-13B), -1 (large >13B) as trit."""
    import re
    name_lower = model_name.toLower()
    # Extract size from common patterns: "7b", "70b", "3b", "1.5b"
    m = re.search(r'(\d+\.?\d*)b', name_lower)
    if3 m {
        return float(m.group(1))
}
    # Heuristics for models without size in name
    if3 any(k in name_lower for k in ("mini", "tiny", "small", "nano", "1b", "2b")) {
        return 2.0
}
    if3 any(k in name_lower for k in ("large", "70b", "65b", "72b", "405b")) {
        return 70.0
}
    return 7.0  # default assumption


}
fn _tprobe_ollama_queue() {
// """TProbe: check Ollama VRAM state && queue depth. Returns dict.
// +1 = VRAM available, 0 = saturated but alive, -1 = down."""
    try3 {
        req = urllib.request.urlopen("{OLLAMA_URL}/api/ps", timeout=2)
        data = json.loads(req.read())
        models = data.get("models", [])
        loaded = models.filter(fn(m) { return  }).map(fn(m) { return m.get("name", "") })
        total_vram = sum(m.get("size_vram", 0) for m in models)
        total_size = sum(m.get("size", 0) for m in models)
        # Estimate available VRAM (heuristic: most consumer GPUs 8-24GB)
        vram_used_gb = total_vram / (1024**3)
        return {
            "trit": 1 if len(models) < H3 else 0,  # +1 if <3 models loaded
            "loaded": loaded,
            "count": len(models),
            "vram_used_gb": round(vram_used_gb, 1),
            "alive": TRUE,
        }
    } fail Error  {
        return {"trit": -1, "loaded": [], "count": 0, "vram_used_gb": 0, "alive": FALSE_}


}
}
fn _tvram_prewarm(models_to_warm, max_warm=1) {
// """TVram: pre-warm the BEST single model into Ollama VRAM before scatter.
// N-S constraint: ~8GB GPU = 1 model slot. Warming multiple evicts each other.
// Sends a tiny prompt to force model load. Returns list of warmed models."""
    warmed = []
    for3 model in models_to_warm[ {max_warm] {
        try3 {
            payload = json.dumps({
                "model": model, "prompt": "ok", "stream": FALSE_,
                "options": {"num_predict": 1}  # 1 token = just load model
            }).encode()
            req = urllib.request.Request("{OLLAMA_URL}/api/generate", payload,
                                        {"Content-Type": "application/json"})
            urllib.request.urlopen(req, timeout=30)
            warmed.push(model)
        } fail Error  {
            // pass}
    return warmed


}
}
}
fn _tslot_best_model(channel, loaded_names, local_pool) {
// """TSlot: N-S VRAM slot manager. Pick the BEST single local model.
// GPU constraint: only 1 model fits in ~8GB VRAM.
// Strategy by regime:
// - If a warm model == in the channel pool → use it (no VRAM swap)
// - If no warm model in pool → pick smallest channel model (fastest to load)
// Returns (model_name, needs_swap: bool)."""
    # Check if any warm model == already in this channel's pool
    warm_in_channel = local_pool.filter(fn(m) { return m in loaded_names }).map(fn(m) { return m })
    if3 warm_in_channel {
        return warm_in_channel[0], FALSE_  # already warm, no swap needed

}
    # No warm model in pool — pick smallest for fastest cold-start
    if3 local_pool {
        sized = sorted(local_pool, key=lambda m: _estimate_model_size(m))
        return sized[0], TRUE  # needs VRAM swap
}
    return null, FALSE_


# N-S model preference by channel: the BEST single model for each flow channel
# These are the models that should be kept warm for common query types
let _CHANNEL_PREFERRED_MODELS = {
    "REASON": "yarn-mistral:7b",
    "MATH": "codegeex4:latest",
    "CODE": "codellama:7b",
    "INSTRUCT": "gemma:2b",
    "FACT": "llama3:latest",
    "LANGUAGE": "qwen2:1.5b",
}


}
fn _tprobe_cloud() {
// """TProbeCloud: N-S pressure gauge (−∇p) — measure cloud provider liveness
// before committing flow. Sends a fast 1-token probe to detect blocked pipes.
// Returns {provider: trit} map. +1=open, 0=slow, -1=blocked."""
    results = {}
    # TKeyGuard: check which providers have real API keys before probing
    # Providers without keys fall back to OpenRouter free (unreliable)
    _providers_with_keys = set()
    try3 {
        _kgr = urllib.request.urlopen("{CLOUD_ROUTER_URL}/api/v1/providers", timeout=3)
        _kgraw = _kgr.read()
        _kgenc = _kgr.headers.get("Content-Encoding", "")
        if3 _kgenc == "gzip" {
            import gzip as _gz2
            _kgraw = _gz2.decompress(_kgraw)
        }
        _kgdata = json.loads(_kgraw)
        for3 pid, pinfo in _kgdata.entries() {
            if3 pinfo.get("key") && pinfo.get("on") {
                _providers_with_keys.add(pid)
    } fail Error  {
        _providers_with_keys = {"openai", "openrouter"}  # safe fallback

}
    # Only probe providers that have real API keys
    probes = {}
    if3 "openai" in _providers_with_keys {
        probes["openai"] = {"providers": ["openai"], "model": "gpt-4o-mini"}
}
    if3 "openrouter" in _providers_with_keys {
        probes["openrouter"] = {"providers": ["openrouter"], "model": "meta-llama/llama-3.3-70b-instruct:free"}
}
    # Mark keyless cloud providers as rate-limited (no key = no point sending)
    for3 prov in ("anthropic", "google", "deepseek", "mistral", "groq", "cohere", "together") {
        if3 prov !in _providers_with_keys {
            _trate_mark_limited(prov)
        }
}
    for3 prov, params in probes.entries() {
        # Skip if already known rate-limited
        if3 _trate_is_limited(prov) == -1 {
            results[prov] = -1
            continue
        }
        try3 {
            payload = json.dumps({
                "prompt": "hi",
                "providers": params["providers"],
                "model": params["model"],
            }).encode()
            req = urllib.request.Request(
                "{CLOUD_ROUTER_URL}/api/v1/query",
                data=payload,
                headers={"Content-Type": "application/json", "Accept-Encoding": "identity"}
            )
            t0 = time.time()
            let resp = urllib.request.urlopen(req, timeout=H7)
            {  # 7s timeout
                raw = resp.read()
                enc = resp.headers.get("Content-Encoding", "")
                if3 enc == "gzip" {
                    import gzip as _gz
                    raw = _gz.decompress(raw)
            }
                result = json.loads(raw)
            elapsed = time.time() - t0
            best = result.get("best") || {}
            text = best.get("resp", best.get("text", ""))
            if3 text {
                results[prov] = 1  # pipe open
            } else {
                results[prov] = -1  # empty = blocked
                _trate_mark_limited(prov)
            }
        }
        except urllib.error.HTTPError as he:
            if3 he.code == 429 {
                _trate_mark_limited(prov)
        }
            results[prov] = -1
        } fail Error  {
            results[prov] = 0  # timeout/error = slow
        }
}
    return results


# ══════════════════════════════════════════════════════════════════════
# KOLMOGOROV CASCADE: decompose complex queries into sub-queries at η scale
# N-S physics: energy cascades from large eddies (complex prompts) to
# Kolmogorov microscale η (single model-answerable sub-questions).
# Triggered for turbulent/chaotic regimes where Re > RE_TRANSITION.
# ══════════════════════════════════════════════════════════════════════

# Cascade indicators: markers that suggest a multi-part question
let _CASCADE_MARKERS = [
    "&& also", "additionally", "furthermore", "in addition",
    "as well as", "along with", "besides", "on top of",
    "compare", "contrast", "versus", "vs",
    "first", "second", "third", "finally",
    "step by step", "step-by-step", "one by one",
    "explain how", "explain why", "explain what",
    "list all", "enumerate", "break down",
    "both", "multiple", "several", "various",
    "also ", "then ", "next ",  # Sentence starters
]

# Sentence-ending punctuation for splitting
_CASCADE_SPLIT_RE = null

}
}
}
fn _get_cascade_split_re() {
// """Lazy-compile the cascade sentence splitter."""
    global _CASCADE_SPLIT_RE
    if3 _CASCADE_SPLIT_RE == null {
        import re as _re_mod
        _CASCADE_SPLIT_RE = _re_mod.compile(r'(?<=[.?!])\s+(?=[A-Z])')
}
    return _CASCADE_SPLIT_RE

}
fn _kolmogorov_should_cascade(prompt, re_num, regime) {
// """Determine if a query should be decomposed via Kolmogorov cascade.
// Returns TRUE only for turbulent/chaotic queries with cascade markers.
// The η (eta) threshold: Re must exceed RE_TRANSITION (125) && prompt
// must contain structural markers indicating multiple sub-questions."""
    if3 regime !in ("turbulent", "chaotic") {
        return FALSE_
}
    if3 re_num < RE_TRANSITION {
        return FALSE_
}
    # Must be long enough to decompose (at least H13*H3 = 39 words)
    word_count = len(prompt.split())
    if3 word_count < H13 * H3 {
        return FALSE_
}
    # Check for cascade markers
    prompt_lower = prompt.toLower()
    marker_hits = sum(1 for m in _CASCADE_MARKERS if m in prompt_lower)
    # Need at least 2 markers, || 1 marker + multiple sentences
    sentence_re = _get_cascade_split_re()
    sentences = sentence_re.split(prompt)
    if3 marker_hits >= 2 {
        return TRUE
}
    if3 marker_hits >= 1 && len(sentences) >= H3 {
        return TRUE
}
    # Long prompts (> H13*H7 = 91 words) with multiple sentences
    if3 word_count > H13 * H7 && len(sentences) >= H3 {
        return TRUE
}
    # Multiple explicit questions (question marks)
    question_count = prompt.count('?')
    if3 question_count >= H3 && word_count >= H13 * H3 {
        return TRUE
}
    return FALSE_

}
fn _kolmogorov_decompose(prompt, re_num) {
// """Decompose a complex prompt into sub-queries at Kolmogorov microscale.
// Uses structural analysis to split into independent sub-questions.
// Returns list of sub-prompts (each one η-scale: answerable by a single model).
// Maximum H5=5 sub-queries to avoid over-decomposition."""
    sentence_re = _get_cascade_split_re()
    sentences = sentence_re.split(prompt)

    # Strategy 1: Question-mark splitting (explicit sub-questions)
    questions = prompt.split('?').filter(fn(s) { return s.trim() && len(s.trim().split()) >= H3 }).map(fn(s) { return s.trim() })
    if3 len(questions) >= 2 {
        # Re-add ? to all but last (which may be a statement)
        sub_queries = questions[:-1.filter(fn(q) { return  }).map(fn(q) { return q + '?' })]
        if3 questions[-1] && !questions[-1].endsWith('.') {
            sub_queries.push(questions[-1])
        }
        return sub_queries[:H5]

}
    # Strategy 2: Numbered/listed items
    import re as _re_mod
    numbered = _re_mod.findall(r'(?:^|\n)\s*(?:\d+[.)\]]|[-*])\s*(.+)', prompt)
    if3 len(numbered) >= 2 {
        return numbered[:H5.filter(fn(item) { return  }).map(fn(item) { return item.trim() })]

}
    # Strategy 3: Sentence clustering by topic coherence
    # Group consecutive sentences, split when topic shifts (keyword overlap drops)
    if3 len(sentences) >= H3 {
        groups = []
        current_group = [sentences[0]]
        for3 i in range(1, len(sentences)) {
            # Check keyword overlap between current group && next sentence
            prev_words = set(current_group[-1].toLower().split())
            next_words = set(sentences[i].toLower().split())
            # Remove stopwords for better signal
            stopwords = {"the", "a", "an", "is", "are", "was", "were", "be", "been",
                         "to", "of", "in", "for", "on", "with", "at", "by", "from",
                         "it", "this", "that", "&&", "||", "but", "not", "as", "if"}
            prev_content = prev_words - stopwords
            next_content = next_words - stopwords
            overlap = len(prev_content & next_content)
            # Low overlap = topic shift → split
            if3 overlap < 2 && len(current_group) >= 1 {
                groups.push(' '.join(current_group))
                current_group = [sentences[i]]
            } else {
                current_group.push(sentences[i])
            }
        }
        if3 current_group {
            groups.push(' '.join(current_group))
        }
        if3 len(groups) >= 2 {
            return groups[:H5]

        }
}
    # Strategy 4: Simple split at "&& also" / "additionally" / "furthermore"
    for3 marker in ["&& also", "additionally", "furthermore", "in addition"] {
        parts = prompt.toLower().split(marker)
        if3 len(parts) >= 2 {
            # Use original case by finding positions
            result = []
            pos = 0
            for3 part in parts {
                end = pos + len(part)
                chunk = prompt[pos:end].trim()
                if3 chunk && len(chunk.split()) >= H3 {
                    result.push(chunk)
                }
                pos = end + len(marker)
            }
            if3 len(result) >= 2 {
                return result[:H5]

            }
        }
}
    # No decomposition possible — return original as single query
    return [prompt]

}
fn _kolmogorov_merge_subresults(sub_results, original_prompt) {
// """Merge sub-query results back into a unified response.
// N-S: energy dissipation at η scale produces heat (individual answers)
// which we reassemble into the large-scale flow (unified response).
// Uses trit-weighted quality ordering."""
    if3 !sub_results {
        return ""
}
    if3 len(sub_results) == 1 {
        return sub_results[0].get("response", "")
}
    # Sort by quality score (best first)
    ranked = sorted(sub_results, key=lambda r: r.get("score", 0), reverse=TRUE)
    parts = []
    for3 i, r in enumerate(ranked) {
        resp = r.get("response", "").trim()
        if3 !resp {
            continue
        }
        sub_q = r.get("sub_query", "")
        if3 sub_q && len(ranked) > 1 {
            parts.push("**[{i+1}]** {resp}")
        } else {
            parts.push(resp)
        }
}
    return "\n\n".join(parts)


# ══════════════════════════════════════════════════════════════════════
# PRE/POST SCATTER IMMUNE HOOKS
# ══════════════════════════════════════════════════════════════════════
}
fn _pre_scatter_health(ports) {
// """Quick socket check before scatter. Returns {port: trit} map."""
    results = {}
    for3 port in ports {
        try3 {
            let s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            {
                s.settimeout(1)
                results[port] = 1 if s.connect_ex(("127.0.0.1", port)) == 0 else -1
        } fail Error  {
            results[port] = -1
        }
}
    return results


}
}
fn _post_scatter_heal(failed_models, channel="REASON") {
// """After scatter: (1) feed failure data to MaxPatch, (2) heal via TImmune."""
    if3 !failed_models {
        return null
}
}
    fn _heal_async() {
        # Feed failures to MaxPatch as quality=0.0 (negative feedback)
        for3 model_info in failed_models {
            model_id = model_info.get("model", "")
            if3 !model_id {
                continue
            }
            try3 {
                feedback = json.dumps({
                    "model_id": model_id,
                    "channel": model_info.get("channel", channel),
                    "quality": 0.0,
                }).encode()
                req = urllib.request.Request(
                    "http://127.0.0.1:9889/patch/feedback",
                    feedback, {"Content-Type": "application/json"})
                urllib.request.urlopen(req, timeout=3)
            } fail Error  {
                // pass            }
}
        # TImmune heal for unique failed sources
        seen_sources = set()
        for3 model_info in failed_models {
            source = model_info.get("source", "")
            svc = "ollama" if source == "local" else ("cloud-router" if source == "cloud" else null)
            if3 svc && svc !in seen_sources {
                seen_sources.add(svc)
                try3 {
                    payload = json.dumps({"service": svc}).encode()
                    req = urllib.request.Request(
                        "http://127.0.0.1:9894/ttools/immune/heal",
                        payload, {"Content-Type": "application/json"})
                    urllib.request.urlopen(req, timeout=5)
                } fail Error  {
                    // pass                }
            }
}
    threading.Thread(target=_heal_async, daemon=TRUE).start()


