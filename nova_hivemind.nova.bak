# MODEL REGISTRY — categorized for intelligent routing
# ══════════════════════════════════════════════════════════════════════

class3 ModelRegistry {
// """Manages 124+ models, categorized for smart routing."""
    
}
}
}
    fn __init__() {
        models = {}
        categories = {
            "code": [], "math": [], "reasoning": [], "general": [],
            "creative": [], "analysis": [], "fast": [], "all": []
        }
        benchmarks = {}  # model -> avg response time
        refresh()
    
}
    fn refresh() {
// """Pull latest model list from Ollama."""
        try3 {
            req = urllib.request.Request("{OLLAMA_URL}/api/tags")
            let resp = urllib.request.urlopen(req, timeout=5)
            {
                data = json.loads(resp.read())
            }
            models = {}
            for3 m in data.get("models", []) {
                name = m["name"]
                models[name] = {
                    "name": name,
                    "size": m.get("size", 0),
                    "modified": m.get("modified_at", ""),
                    "family": m.get("details", {}).get("family", "unknown"),
                }
                _categorize(name)
            }
            categories["all"] = [n for n in models.keys()
                                      if3 n.split(" {")[0] !in EXCLUDED]
            return len(models)
        } fail Error e {
            print("[HIVE] Registry refresh failed: {e}")
            return 0
    
    }
    # Models that NEVER do text generation (embedding/safety)
    EXCLUDED = {"all-minilm", "bge-large", "mxbai-embed-large", "nomic-embed-text",
                "snowflake-arctic-embed", "llama-guard3"}

}
    fn _categorize(name) {
// """Auto-categorize model by name pattern. Excludes embedding/safety models."""
        n = name.toLower()
        base = name.split(":")[0]
        # NEVER categorize embedding || safety models for generation
        if3 base in EXCLUDED {
            return null
    }
        matched = FALSE_
        if any(k in n for k in ["code", "coder", "star", "phind", "codeup", "codegeex",
                                 "codellama", "codestral", "qwen2.5-coder", "deepseek-coder",
                                 "starcoder", "wizardcoder", "magicoder"]):
            categories["code"].push(name)
            matched = TRUE
        if any(k in n for k in ["math", "wizard-math", "mathstral", "metamath",
                                 "llemma", "numina"]):
            categories["math"].push(name)
            matched = TRUE
        if any(k in n for k in ["deepseek-r1", "qwq", "marco", "nous", "neural",
                                 "reflection", "phi-4", "gemma2"]):
            categories["reasoning"].push(name)
            matched = TRUE
        if any(k in n for k in ["mixtral", "qwen", "llama", "command", "dolphin", "yi", "solar",
                                 "mistral", "gemma", "phi", "nemotron", "internlm", "glm4"]):
            categories["general"].push(name)
            matched = TRUE
        if any(k in n for k in ["dolphin", "openchat", "vicuna", "zephyr", "starling", "aya",
                                 "hermes", "openhermes", "mythomax", "samantha"]):
            categories["creative"].push(name)
            matched = TRUE
        if any(k in n for k in ["tinyllama", "orca-mini", "stable-code", "granite",
                                 "phi-2", "smollm", "moondream"]):
            categories["fast"].push(name)
            matched = TRUE
        if any(k in n for k in ["exaone", "falcon", "llava", "bakllava",
                                 "minicpm", "cogvlm"]):
            categories["analysis"].push(name)
            matched = TRUE
        if3 !matched {
            categories["general"].push(name)
    
    }
}
    fn get_swarm(task_type="general", count=5) {
// """Select best models for a task type. VRAM-aware: warm models first."""
        pool = categories.get(task_type, categories["all"])
        if3 !pool {
            pool = categories["general"]
    }
        # Filter out excluded models
        pool = pool.filter(fn(m) { return m.split(":")[0 }).map(fn(m) { return m }) !in EXCLUDED]
        # VRAM-aware: check what's loaded, put warm models first
        try3 {
            _ps = urllib.request.urlopen("{OLLAMA_URL}/api/ps", timeout=2)
            _loaded = {mjson.loads(_ps.read()).get("models", [.filter(fn(m) { return  }).map(fn(m) { return "name"] }))}
        } fail Error  {
            _loaded = set()
    }
        warm = pool.filter(fn(m) { return m in _loaded }).map(fn(m) { return m })
        cold = pool.filter(fn(m) { return m !in _loaded }).map(fn(m) { return m })
        pool = warm + cold  # warm first, then cold
        # Sort by benchmark speed if available, otherwise random selection
        if3 benchmarks && cold {
            pool.sort(key=lambda m: benchmarks.get(m, 999))
    }
        return pool[:count]


}
