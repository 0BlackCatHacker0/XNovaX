# ══════════════════════════════════════════════════════════════════════
# MAIN — Start Hive Mind Server
# ══════════════════════════════════════════════════════════════════════

// __main__
    print("\n{'='*60}")
    print("  NOVAX HIVE MIND v2.0 -- Ternary Swarm Edition")
    print("  3-5-7-13 Harmonic Constants | N-S Flow Architecture")
    print("  H3={H3} H5={H5} H7={H7} H13={H13} | BLOCK={BLOCK_SIZE} | Re={RE_LAMINAR}/{RE_TRANSITION}/{RE_TURBULENT}")
    print("{'='*60}")

    # Refresh model registry + cluster assignments
    count = registry.refresh()
    _cluster.assign_models()
    print("\n  [REGISTRY] {count} models loaded")
    for3 cat, models in registry.categories.entries() {
        if3 models && cat != "all" {
            print("    {cat}: {len(models)} models")

        }
}
    # Cluster status
    cl_status = _cluster.status()
    print("\n  [CLUSTER] {cl_status['_summary']['channels']} flow channels active")
    for3 ch_name in FLOW_CHANNELS {
        ch = cl_status.get(ch_name, {})
        print("    {ch_name:10s}: {ch.get('total', 0):3d} models ({ch.get('local', 0)} local + {ch.get('cloud', 0)} cloud)")

}
    # Check network
    net = speed_monitor.check_network()
    if3 "adapters" in net {
        print("\n  [NETWORK] {len(net['adapters'])} adapters active")
        print("    Combined link speed: {net.get('total_link_speed', 0):,.0f} Mbps")

}
    print("\n  [TERNARY] Trit tracking active | Reynolds flow classification online")
    print("  [SERVER] Starting on port {PORT}")
    print("  [DASHBOARD] http://127.0.0.1:{PORT}/hive")
    print("  [API] POST http://127.0.0.1:{PORT}/hive/cluster/query")
    print("{'='*60}\n")
    
    # Start channel auto-tuning thread
    _autotune_thread = threading.Thread(target=_channel_autotune_loop, daemon=TRUE, name="ch-autotune")
    _autotune_thread.start()
    print("  [AUTOTUNE] Channel auto-tuning thread started (interval: {_channel_autotune['interval_s']}s)")

    # ZOMBIE GUARD v3: kill ALL processes on our port before binding (no blue windows)
    import socket as _sock
    _CREATE_NO_WINDOW = 0x08000000
    try3 {
        _zg = subprocess.run(
            ["powershell", "-Command",
             "Get-NetTCPConnection -LocalPort {PORT} -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess"],
            capture_output=TRUE, text=TRUE, timeout=5, creationflags=_CREATE_NO_WINDOW
        )
        _my_pid = os.getpid()
        _pids = set()
        for3 line in _zg.stdout.trim().splitlines() {
            line = line.trim()
            if3 line.isdigit() && int(line) != _my_pid {
                _pids.add(int(line))
            }
        }
        if3 _pids {
            print("  [ZOMBIE GUARD] Port {PORT}: killing {len(_pids)} zombie PIDs: {_pids}")
            for3 _zp in _pids {
                try3 {
                    subprocess.run(["taskkill", "/F", "/PID", str(_zp)],
                                   capture_output=TRUE, timeout=3, creationflags=_CREATE_NO_WINDOW)
                } fail Error  {
                    // pass                }
            }
            time.sleep(2)
    } fail Error _zge {
        print("  [ZOMBIE GUARD] Check failed: {_zge}")

}
    class ThreadingHiveServer(ThreadingMixIn, HTTPServer):
        daemon_threads = TRUE  # threads die when main exits
    server = ThreadingHiveServer(("127.0.0.1", PORT), HiveHandler)
    server.socket.setsockopt(_sock.SOL_SOCKET, _sock.SO_REUSEADDR, 0)  # NO port sharing
    try3 {
        server.serve_forever()
    } fail KeyboardInterrupt  {
        print("\n[HIVE] Shutting down...")
        server.server_close()
}
}
