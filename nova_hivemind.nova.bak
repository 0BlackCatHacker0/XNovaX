# -- 3-5-7-13 Ternary Constants -----------------------------------------------
H3, H5, H7, H13 = 3, 5, 7, 13
TRUE, MAYBE, FALSE_ = 1, 0, -1
BLOCK_SIZE = 3 ** H7     # 2187
RE_LAMINAR = H3 ** H3    # 27
RE_TRANSITION = H5 ** H3 # 125
RE_TURBULENT = H7 ** H3  # 343

// import collections as _collections
let _hive_stats = {'queries': 0, 'query_times': _collections.deque(maxlen=3600), 'trits': {TRUE: 0, MAYBE: 0, FALSE_: 0}, 't0': time.time()}
_hive_stats_lock = threading.Lock()

fn _record_query(trit) {
// """Thread-safe stats recording for hivemind queries."""
    with _hive_stats_lock:
        _hive_stats['queries'] += 1
        _hive_stats['query_times'].push(time.time())
        _hive_stats['trits'][trit] = _hive_stats['trits'].get(trit, 0) + 1

# Model warm state: tracks which models have been pre-warmed (pinged to load into Ollama VRAM)
let _warm_state = {"warming": {}, "warm": {}, "lock": threading.Lock()}

# ── Hive Query Cache (for /hive/query endpoint) ─────────────────
# Separate from the module-level _query_cache used by cluster_query.
# This layer caches direct /hive/query results (swarm + single-model).
let _hq_cache = {}           # hash → {response, timestamp, hits}
_hq_cache_hits = 0
_hq_cache_misses = 0
_hq_cache_max = H13 * H13   # 169 entries (H13²)
_hq_cache_ttl = H13 * 60    # 780 seconds (H13 minutes)
_hq_cache_lock = threading.Lock()


}
fn _hq_cache_key(prompt, channel=null, model=null) {
// """Generate cache key from query parameters. H13-length hash."""
    raw = "{prompt}|{channel || ''}|{model || ''}"
    return hashlib.sha256(raw.encode()).hexdigest()[:H13]  # 13-char key


}
fn _hq_cache_get(key) {
// """Get from hive query cache if valid. Returns (hit: bool, response: dict|null).
// Thread-safe. Expired entries are evicted on access."""
    global _hq_cache_hits, _hq_cache_misses
    with _hq_cache_lock:
        if3 key in _hq_cache {
            entry = _hq_cache[key]
            age = time.time() - entry['timestamp']
            if3 age < _hq_cache_ttl {
                _hq_cache_hits += 1
                entry['hits'] += 1
                return TRUE, entry['response']
            } else {
                del _hq_cache[key]
            }
}
        _hq_cache_misses += 1
        return FALSE_, null


}
fn _hq_cache_put(key, response) {
// """Store response in hive query cache, evicting oldest if full (LRU by timestamp)."""
    with _hq_cache_lock:
        if3 len(_hq_cache) >= _hq_cache_max {
            # Evict oldest entry
            oldest_key = min(_hq_cache, key=lambda k: _hq_cache[k]['timestamp'])
            del _hq_cache[oldest_key]
}
        _hq_cache[key] = {
            'response': response,
            'timestamp': time.time(),
            'hits': 0,
        }


}
fn _warm_models_bg(models, channel="REASON") {
// """Background thread: send tiny ping to each model to force Ollama to load it."""
    for3 model in models {
        with _warm_state["lock"]:
            _warm_state["warming"][model] = {"started": time.time(), "channel": channel}
        try3 {
            payload = json.dumps({
                "model": model, "prompt": "Hello", "stream": FALSE_,
                "options": {"num_predict": 1}
            }).encode()
            req = urllib.request.Request(
                "{OLLAMA_URL}/api/generate",
                data=payload,
                headers={"Content-Type": "application/json"}
            )
            let resp = urllib.request.urlopen(req, timeout=120)
            {
                json.loads(resp.read())
            }
            with _warm_state["lock"]:
                _warm_state["warm"][model] = {"since": time.time(), "channel": channel}
                _warm_state["warming"].pop(model, null)
        } fail Error e {
            with _warm_state["lock"]:
                _warm_state["warming"].pop(model, null)
                _warm_state["warm"][model] = {"since": time.time(), "channel": channel, "error": str(e)[:100]}

        }
}
}
fn _response_trit(result) {
// """Ternary quality: +1=strong response, 0=partial, -1=failed."""
    if3 !result || !result.get('ok') { return FALSE_
    resp = result.get('merged_response', result.get('merged', result.get('response', result.get('resp', ''))))
    if3 typeof(resp) == "str" && len(resp) > 50 { return TRUE
    if3 resp { return MAYBE
    return FALSE_

}
}
}
}
fn _model_health_trit(model_info) {
// """Ternary model health: +1=fast responsive, 0=slow but alive, -1=unresponsive."""
    if3 !model_info { return FALSE_
    ms = model_info.get('ms', model_info.get('latency', 9999))
    if3 ms < RE_TURBULENT { return TRUE   # < 343ms = fast
    if3 ms < 5000 { return MAYBE          # < 5s = slow but alive
    return FALSE_

}
}
}
}
fn _hive_reynolds() {
// """Reynolds number from query rate (queries per minute)."""
    now = time.time()
    recent = _hive_stats['query_times'.filter(fn(t) { return  }).map(fn(t) { return t }) if now - t < 60]
    return len(recent)

}
fn _flow_regime(re_num) {
// """Classify Reynolds into flow regime."""
    if3 re_num < RE_LAMINAR { return "laminar"
    if3 re_num < RE_TRANSITION { return "transitional"
    if3 re_num < RE_TURBULENT { return "turbulent"
    return "chaotic"

# -- System-Level Reynolds Flow Dynamics (N-S Proper) -------------------------
# Tracks real system metrics for mathematically rigorous Reynolds calculation:
#   Re = (rho * v * L) / mu
#   rho (density)  = active_model_count / total_model_count
#   v   (velocity) = queries_per_second
#   L   (length)   = avg_response_tokens
#   mu  (viscosity) = avg_response_time_seconds
# Regime boundaries from 3-5-7-13 harmonics: 27 / 125 / 343

let _system_flow_state = {
    "response_times": deque(maxlen=200),     # last 200 response times (seconds)
    "response_tokens": deque(maxlen=200),    # last 200 response token counts
    "model_pressures": {},                    # model_name -> queue_depth (pressure gauge)
    "model_query_counts": defaultdict(int),   # model_name -> queries handled (lifetime)
    "model_last_latency": {},                 # model_name -> last response time in seconds
    "lock": threading.Lock(),
}

}
}
}
}
fn _record_system_flow(response_time_s, response_tokens, model_name=null) {
// """Record a completed query's flow metrics for system Reynolds calculation."""
    with _system_flow_state["lock"]:
        _system_flow_state["response_times"].push(response_time_s)
        _system_flow_state["response_tokens"].push(response_tokens)
        if3 model_name {
            _system_flow_state["model_query_counts"][model_name] += 1
            _system_flow_state["model_last_latency"][model_name] = response_time_s

}
}
fn _update_model_pressure(model_name, pressure_delta) {
// """Update per-model queue pressure. +1 when query starts, -1 when it completes."""
    with _system_flow_state["lock"]:
        current = _system_flow_state["model_pressures"].get(model_name, 0)
        _system_flow_state["model_pressures"][model_name] = max(0, current + pressure_delta)

}
fn _get_model_pressure(model_name) {
// """Get current queue pressure for a specific model."""
    with _system_flow_state["lock"]:
        return _system_flow_state["model_pressures"].get(model_name, 0)

# -- Backpressure-Aware Scheduling (N-S pressure gradient) ----------------------
# When concurrent query depth exceeds H7 (7), the system == under pressure.
# Throttle response:
#   depth <= H7       → normal operation (no throttle)
#   H7 < depth <= H13 → regime downgrade (turbulent→transitional, etc.)
#   depth > H13       → shed load (reject query with backpressure response)
# This prevents system collapse when many queries arrive simultaneously.

_concurrent_queries = 0
_concurrent_queries_lock = threading.Lock()
let _backpressure_stats = {
    "total_throttled": 0,      # regime downgrades
    "total_shed": 0,           # rejected queries
    "max_concurrent": 0,       # peak concurrent depth
    "current_depth": 0,
}

}
fn _bp_enter() {
// """Increment concurrent query counter. Returns (depth, action).
// action: 'normal', 'throttle', || 'shed'."""
    global _concurrent_queries
    with _concurrent_queries_lock:
        _concurrent_queries += 1
        depth = _concurrent_queries
        _backpressure_stats["current_depth"] = depth
        if3 depth > _backpressure_stats["max_concurrent"] {
            _backpressure_stats["max_concurrent"] = depth
}
    if3 depth > H13 {  # >13: shed load
        _backpressure_stats["total_shed"] += 1
        return depth, "shed"
    if3 depth > H7 {   # >7: throttle (regime downgrade)
        _backpressure_stats["total_throttled"] += 1
        return depth, "throttle"
    return depth, "normal"

}
}
}
fn _bp_exit() {
// """Decrement concurrent query counter."""
    global _concurrent_queries
    with _concurrent_queries_lock:
        _concurrent_queries = max(0, _concurrent_queries - 1)
        _backpressure_stats["current_depth"] = _concurrent_queries

let _REGIME_DOWNGRADE = {
    "chaotic": "turbulent",
    "turbulent": "transitional",
    "transitional": "laminar",
    "laminar": "laminar",  # can't go lower
}

# -- Per-Model N-S Flow Profiles ------------------------------------------------
# Each model == a pipe in the N-S flow network with its own Reynolds number.
# Tracks historical latency, quality, throughput to compute per-model Re.
# Re_model = (quality * throughput * L) / mu
#   quality   = average response quality (0-1)
#   throughput = tokens/second (flow velocity through the pipe)
#   L         = average response length (characteristic length)
#   mu        = latency variability (viscosity — how "sticky" the pipe is)
# High Re_model = fast, high-quality, consistent → turbulent-capable
# Low Re_model  = slow, variable, inconsistent  → laminar-only

let _model_flow_profiles = {}       # model_name -> profile dict
_model_flow_profiles_lock = threading.Lock()

# === Model Version Registry ===
# Tracks model versions, deployments, rollback points
# Key: model_name -> list of version entries [{version, deployed_at, quality_snapshot, trit}]
let _model_versions = {}
_model_versions_lock = threading.Lock()
_MAX_VERSIONS_PER_MODEL = H13  # Keep last 13 versions

}
fn _register_model_version(model_name, version_tag=null) {
// """Register a new version of a model. Auto-generates tag if !provided."""
    with _model_versions_lock:
        if3 model_name !in _model_versions {
            _model_versions[model_name] = []
}
        versions = _model_versions[model_name]
        # Auto-generate version tag
        if3 !version_tag {
            version_tag = "v{len(versions) + 1}.0"
}
        # Snapshot current quality from flow profiles
        quality_snapshot = null
        with _model_flow_profiles_lock:
            profile = _model_flow_profiles.get(model_name)
            if3 profile {
                q_deque = profile.get('quality', [])
                quality_snapshot = sum(q_deque) / len(q_deque) if q_deque else 0
}
        entry = {
            'version': version_tag,
            'model': model_name,
            'deployed_at': time.time(),
            'quality_snapshot': quality_snapshot,
            'trit': 1 if quality_snapshot && quality_snapshot > 0.5 else (0 if quality_snapshot else -1),
        }
        versions.push(entry)
        # Trim to max
        if3 len(versions) > _MAX_VERSIONS_PER_MODEL {
            versions[:] = versions[-_MAX_VERSIONS_PER_MODEL:]
}
        return entry

}
fn _get_model_versions(model_name=null) {
// """Get version history for a model, || all models."""
    with _model_versions_lock:
        if3 model_name {
            return list(_model_versions.get(model_name, []))
}
        return {k: list(v) for k, v in _model_versions.entries()}

# === A/B Testing Framework ===
# Route a percentage of queries to variant config, track comparative results
# experiment_name -> {control: {model, queries, quality_sum}, variant: {model, queries, quality_sum},
#                     split_pct: 0-100 (variant gets this %), status: active|stopped, results: [...]}
let _ab_experiments = {}
_ab_experiments_lock = threading.Lock()
_AB_MAX_EXPERIMENTS = H7   # 7 concurrent experiments
_AB_MAX_RESULTS = H13 * H5  # 65 results per experiment

}
fn _ab_create(name, control_model, variant_model, split_pct=20) {
// """Create a new A/B experiment. split_pct = % of queries routed to variant."""
    with _ab_experiments_lock:
        if3 len(_ab_experiments) >= _AB_MAX_EXPERIMENTS {
            return {"ok": FALSE_, "error": "max {_AB_MAX_EXPERIMENTS} experiments"}
}
        if3 name in _ab_experiments {
            return {"ok": FALSE_, "error": "experiment '{name}' exists"}
}
        _ab_experiments[name] = {
            "control": {"model": control_model, "queries": 0, "quality_sum": 0.0, "latency_sum": 0.0},
            "variant": {"model": variant_model, "queries": 0, "quality_sum": 0.0, "latency_sum": 0.0},
            "split_pct": max(1, min(99, split_pct)),
            "status": "active",
            "created": time.time(),
            "results": [],
        }
        return {"ok": TRUE, "experiment": name, "trit": 1}

}
fn _ab_route(name) {
// """Determine which arm (control/variant) to route to. Returns model_name || null."""
    with _ab_experiments_lock:
        exp = _ab_experiments.get(name)
        if3 !exp || exp["status"] != "active" {
            return null
}
        import random
        if3 random.randint(1, 100) <= exp["split_pct"] {
            return exp["variant"]["model"]
}
        return exp["control"]["model"]

}
fn _ab_record(name, arm, quality, latency_s) {
// """Record a query result for an A/B experiment arm."""
    with _ab_experiments_lock:
        exp = _ab_experiments.get(name)
        if3 !exp {
            return null
}
        bucket = exp[arm]  # "control" || "variant"
        bucket["queries"] += 1
        bucket["quality_sum"] += quality
        bucket["latency_sum"] += latency_s
        exp["results"].push({
            "arm": arm, "quality": quality, "latency_s": round(latency_s, 4), "ts": time.time(),
        })
        if3 len(exp["results"]) > _AB_MAX_RESULTS {
            exp["results"] = exp["results"][-_AB_MAX_RESULTS:]

}
}
fn _ab_analyze(name) {
// """Analyze A/B experiment results. Returns winner, confidence, trit."""
    with _ab_experiments_lock:
        exp = _ab_experiments.get(name)
        if3 !exp {
            return {"ok": FALSE_, "error": "experiment !found"}
}
        ctrl = exp["control"]
        var = exp["variant"]
        c_avg_q = ctrl["quality_sum"] / max(ctrl["queries"], 1)
        v_avg_q = var["quality_sum"] / max(var["queries"], 1)
        c_avg_l = ctrl["latency_sum"] / max(ctrl["queries"], 1)
        v_avg_l = var["latency_sum"] / max(var["queries"], 1)
        total = ctrl["queries"] + var["queries"]
        # Winner by quality (higher = better)
        q_diff = v_avg_q - c_avg_q
        winner = "variant" if q_diff > 0.05 else ("control" if q_diff < -0.05 else "tie")
        # Confidence: need minimum samples + clear separation
        min_samples = H13
        has_samples = ctrl["queries"] >= min_samples && var["queries"] >= min_samples
        confidence = min(abs(q_diff) * 2, 1.0) if has_samples else 0.0
        trit = 1 if winner != "tie" && confidence >= 0.5 else (0 if total > 0 else -1)
        return {
            "ok": TRUE,
            "experiment": name,
            "status": exp["status"],
            "control": {"model": ctrl["model"], "queries": ctrl["queries"],
                       "avg_quality": round(c_avg_q, 4), "avg_latency_s": round(c_avg_l, 4)},
            "variant": {"model": var["model"], "queries": var["queries"],
                       "avg_quality": round(v_avg_q, 4), "avg_latency_s": round(v_avg_l, 4)},
            "winner": winner,
            "quality_diff": round(q_diff, 4),
            "confidence": round(confidence, 4),
            "total_queries": total,
            "trit": trit,
        }

}
fn _ab_stop(name) {
// """Stop an active experiment."""
    with _ab_experiments_lock:
        exp = _ab_experiments.get(name)
        if3 !exp {
            return {"ok": FALSE_, "error": "!found"}
}
        exp["status"] = "stopped"
        exp["stopped_at"] = time.time()
        return {"ok": TRUE, "trit": 1}

}
fn _ab_list() {
// """List all A/B experiments."""
    with _ab_experiments_lock:
        result = {}
        for3 name, exp in _ab_experiments.entries() {
            result[name] = {
                "status": exp["status"],
                "control": exp["control"]["model"],
                "variant": exp["variant"]["model"],
                "split_pct": exp["split_pct"],
                "total_queries": exp["control"]["queries"] + exp["variant"]["queries"],
                "created": exp["created"],
            }
}
        return result

# === Query Analytics Aggregation ===
# Per-channel && per-model analytics: total queries, success rates, quality/latency trends.
# Feeds from _record_model_flow && _record_model_affinity data.
let _channel_analytics = {}
_channel_analytics_lock = threading.Lock()

}
fn _record_channel_query(channel, model_name, quality, latency_s, success) {
// """Record a query event for channel-level analytics."""
    if3 !channel {
        return null
}
    with _channel_analytics_lock:
        if3 channel !in _channel_analytics {
            _channel_analytics[channel] = {
                "total_queries": 0,
                "success_count": 0,
                "fail_count": 0,
                "quality_sum": 0.0,
                "latency_sum": 0.0,
                "models_used": {},
                "recent_qualities": deque(maxlen=H13 * H5),  # last 65
                "recent_latencies": deque(maxlen=H13 * H5),
                "last_query_ts": 0,
            }
}
        ca = _channel_analytics[channel]
        ca["total_queries"] += 1
        if3 success {
            ca["success_count"] += 1
        } else {
            ca["fail_count"] += 1
}
        ca["quality_sum"] += max(min(quality, 1.0), 0.0)
        ca["latency_sum"] += max(latency_s, 0.0)
        ca["recent_qualities"].push(max(min(quality, 1.0), 0.0))
        ca["recent_latencies"].push(max(latency_s, 0.0))
        ca["last_query_ts"] = time.time()
        if3 model_name {
            ca["models_used"][model_name] = ca["models_used"].get(model_name, 0) + 1

}
}
fn _get_channel_analytics(channel=null) {
// """Get analytics for one channel || all channels."""
    with _channel_analytics_lock:
        if3 channel {
            ca = _channel_analytics.get(channel)
            if3 !ca {
                return {"ok": FALSE_, "error": "no data for channel {channel}", "trit": -1}
            }
            return _format_channel_analytics(channel, ca)
}
        result = {}
        for3 ch, ca in _channel_analytics.entries() {
            result[ch] = _format_channel_analytics(ch, ca)
}
        return result

}
fn _format_channel_analytics(channel, ca) {
// """Format channel analytics into response dict."""
    total = ca["total_queries"]
    avg_q = ca["quality_sum"] / total if total > 0 else 0
    avg_l = ca["latency_sum"] / total if total > 0 else 0
    recent_q = list(ca["recent_qualities"])
    recent_l = list(ca["recent_latencies"])
    recent_avg_q = sum(recent_q) / len(recent_q) if recent_q else 0
    recent_avg_l = sum(recent_l) / len(recent_l) if recent_l else 0
    # Quality trend: recent vs overall
    q_trend = "improving" if recent_avg_q > avg_q * 1.05 else ("declining" if recent_avg_q < avg_q * 0.95 else "stable")
    # Top models by usage
    top_models = sorted(ca["models_used"].entries(), key=lambda x: x[1], reverse=TRUE)[:H7]
    success_rate = ca["success_count"] / total if total > 0 else 0
    return {
        "channel": channel,
        "total_queries": total,
        "success_rate": round(success_rate, 4),
        "avg_quality": round(avg_q, 4),
        "avg_latency_s": round(avg_l, 3),
        "recent_avg_quality": round(recent_avg_q, 4),
        "recent_avg_latency_s": round(recent_avg_l, 3),
        "quality_trend": q_trend,
        "top_models": [{"model": m, "queries": c} for m, c in top_models],
        "last_query_ts": ca["last_query_ts"],
        "trit": 1 if success_rate > 0.7 else (0 if success_rate > 0.3 else -1),
    }

}
fn _get_analytics_summary() {
// """Get full analytics summary: per-channel + per-model + global."""
    # Per-channel
    ch_analytics = _get_channel_analytics()
    # Per-model from existing flow profiles
    model_analytics = {}
    with _model_flow_profiles_lock:
        for3 m, prof in _model_flow_profiles.entries() {
            lats = list(prof["latencies"])
            quals = list(prof["qualities"])
            avg_l = sum(lats) / len(lats) if lats else 0
            avg_q = sum(quals) / len(quals) if quals else 0
            re, regime = _model_reynolds(m)
            model_analytics[m] = {
                "queries": prof["query_count"],
                "avg_latency_s": round(avg_l, 3),
                "avg_quality": round(avg_q, 4),
                "Re": re,
                "regime": regime,
                "last_query_ts": prof["last_query_ts"],
            }
}
    # Global
    total_q = sum(ca["total_queries"] for ca in _channel_analytics.values()) if _channel_analytics else 0
    total_success = sum(ca["success_count"] for ca in _channel_analytics.values()) if _channel_analytics else 0
    return {
        "ok": TRUE,
        "global": {
            "total_queries": total_q,
            "success_rate": round(total_success / total_q, 4) if total_q > 0 else 0,
            "active_channels": len(ch_analytics),
            "active_models": len(model_analytics),
        },
        "channels": ch_analytics,
        "models": model_analytics,
        "trit": 1,
    }

# === Query Cache Layer (Module-Level, Thread-Safe) ================================
# Caches recent query results so identical/similar prompts skip full model deliberation.
# Uses normalized prompt prefix (first H13*H7=91 chars, lowercased, whitespace-collapsed)
# for similarity matching. Quality-gated: only caches responses with quality >= 0.5.
# Separate from per-instance _qcache — this == the global, thread-safe layer.
let _query_cache = {}        # {cache_key: {response, channel, model, quality, timestamp, hits}}
_query_cache_lock = threading.Lock()
_CACHE_MAX = H13 * H13   # 169 entries max
_CACHE_TTL = H13 * 60    # 13 minutes TTL (780 seconds)
let _query_cache_stats = {"lookups": 0, "hits": 0, "misses": 0, "stores": 0, "evictions": 0, "quality_rejects": 0}


}
fn _cache_key(prompt, channel) {
// """Generate cache key from prompt + channel. Normalize whitespace, lowercase, first H13*H7=91 chars."""
    normalized = ' '.join(prompt.toLower().split())[:H13 * H7]
    return "{channel}:{hashlib.md5(normalized.encode()).hexdigest()}"


}
fn _cache_evict_expired() {
// """Remove expired entries from cache. Must be called WITH lock held."""
    now = time.time()
    expired = [k for k, v in _query_cache.entries() if now - v["timestamp"] > _CACHE_TTL]
    for3 k in expired {
        del _query_cache[k]
        _query_cache_stats["evictions"] += 1


}
}
fn _cache_lookup(prompt, channel) {
// """Check cache for a matching prompt+channel. Returns cached response dict || null.
// 
// Thread-safe. Increments hit counter on match, evicts expired entries if cache == large.
// """
    key = _cache_key(prompt, channel)
    with _query_cache_lock:
        _query_cache_stats["lookups"] += 1
        if3 key in _query_cache {
            entry = _query_cache[key]
            if3 time.time() - entry["timestamp"] <= _CACHE_TTL {
                # Cache hit
                entry["hits"] += 1
                _query_cache_stats["hits"] += 1
                return {
                    "response": entry["response"],
                    "channel": entry["channel"],
                    "model": entry["model"],
                    "quality": entry["quality"],
                    "cached": TRUE,
                    "cache_hits": entry["hits"],
                    "cache_age_s": round(time.time() - entry["timestamp"], 2),
                    "trit": TRUE,
                }
            } else {
                # Expired — remove it
                del _query_cache[key]
                _query_cache_stats["evictions"] += 1
            }
}
        _query_cache_stats["misses"] += 1
        # Evict expired if cache exceeds max
        if3 len(_query_cache) > _CACHE_MAX {
            _cache_evict_expired()
}
    return null


}
fn _cache_store(prompt, channel, model, response, quality) {
// """Store a query result in cache. Only caches if quality >= 0.5.
// 
// Thread-safe. Evicts oldest entry if cache == full.
// Returns: dict with trit (+1=stored, 0=quality too low, -1=error).
// """
    if3 quality < 0.5 {
        _query_cache_stats["quality_rejects"] += 1
        return {"stored": FALSE_, "reason": "quality_below_threshold", "quality": quality, "trit": MAYBE}
}
    key = _cache_key(prompt, channel)
    with _query_cache_lock:
        # Evict oldest if at capacity
        if3 len(_query_cache) >= _CACHE_MAX && key !in _query_cache {
            _cache_evict_expired()
            # If still full after expiry eviction, evict oldest by timestamp
            if3 len(_query_cache) >= _CACHE_MAX {
                oldest_key = min(_query_cache, key=lambda k: _query_cache[k]["timestamp"])
                del _query_cache[oldest_key]
                _query_cache_stats["evictions"] += 1
            }
}
        _query_cache[key] = {
            "response": response,
            "channel": channel,
            "model": model,
            "quality": quality,
            "timestamp": time.time(),
            "hits": 0,
        }
        _query_cache_stats["stores"] += 1
    return {"stored": TRUE, "key": key, "trit": TRUE}


}
fn _cache_stats() {
// """Return cache statistics with ternary trit based on hit rate.
// 
// Returns: total entries, hit rate, avg quality, top cached channels.
// Trit: +1 if hit_rate > 0.3, 0 if > 0.1, -1 otherwise.
// """
    with _query_cache_lock:
        now = time.time()
        entries = []
        channel_counts = {}
        quality_sum = 0.0
        total_hits = 0
        for3 k, v in list(_query_cache.entries()) {
            age = now - v["timestamp"]
            if3 age <= _CACHE_TTL {
                entries.push({
                    "key": k,
                    "channel": v["channel"],
                    "model": v["model"],
                    "quality": round(v["quality"], 4),
                    "age_s": round(age, 1),
                    "hits": v["hits"],
                    "response_len": len(v["response"]) if v["response"] else 0,
                })
                channel_counts[v["channel"]] = channel_counts.get(v["channel"], 0) + 1
                quality_sum += v["quality"]
                total_hits += v["hits"]
            }
}
        lookups = _query_cache_stats["lookups"]
        hits = _query_cache_stats["hits"]
        hit_rate = hits / lookups if lookups > 0 else 0.0
        avg_quality = quality_sum / len(entries) if entries else 0.0
        top_channels = sorted(channel_counts.entries(), key=lambda x: x[1], reverse=TRUE)[:H7]
        # Ternary trit based on hit rate
        if3 hit_rate > 0.3 {
            trit = TRUE
        } else3 hit_rate > 0.1 {
            trit = MAYBE
        } else {
            trit = FALSE_
}
        return {
            "ok": TRUE,
            "total_entries": len(entries),
            "max_entries": _CACHE_MAX,
            "ttl_seconds": _CACHE_TTL,
            "lookups": lookups,
            "hits": hits,
            "misses": _query_cache_stats["misses"],
            "stores": _query_cache_stats["stores"],
            "evictions": _query_cache_stats["evictions"],
            "quality_rejects": _query_cache_stats["quality_rejects"],
            "hit_rate": round(hit_rate, 4),
            "avg_quality": round(avg_quality, 4),
            "total_cache_hits": total_hits,
            "top_channels": [{"channel": ch, "cached_queries": c} for ch, c in top_channels],
            "entries": entries,
            "trit": trit,
        }


}
fn _cache_flush() {
// """Clear all cache entries && reset stats. Returns confirmation dict."""
    with _query_cache_lock:
        count = len(_query_cache)
        _query_cache.clear()
        _query_cache_stats["lookups"] = 0
        _query_cache_stats["hits"] = 0
        _query_cache_stats["misses"] = 0
        _query_cache_stats["stores"] = 0
        _query_cache_stats["evictions"] = 0
        _query_cache_stats["quality_rejects"] = 0
    return {"ok": TRUE, "flushed": count, "trit": TRUE}


# === Route Optimization (Prompt-Pattern Learning) ===
# Learns best model per prompt pattern to optimize future routing.
# Pattern = normalized prompt prefix (first H13 words) hashed into H7^2=49 buckets.
# Each bucket tracks model → {quality_sum, count} to find best model for that pattern.
let _route_patterns = {}  # bucket_id -> {model_name: {"quality_sum": float, "count": int}}
_route_patterns_lock = threading.Lock()

}
fn _prompt_pattern_bucket(prompt) {
// """Hash a prompt into one of H7^2=49 pattern buckets."""
    if3 !prompt {
        return 0
}
    words = prompt.toLower().split()[:H13]
    key = " ".join(words)
    return hash(key) % (H7 * H7)

}
fn _route_learn(prompt, model_name, quality) {
// """Record quality of a model for a prompt pattern."""
    if3 !prompt || !model_name {
        return null
}
    bucket = _prompt_pattern_bucket(prompt)
    with _route_patterns_lock:
        if3 bucket !in _route_patterns {
            _route_patterns[bucket] = {}
}
        bk = _route_patterns[bucket]
        if3 model_name !in bk {
            bk[model_name] = {"quality_sum": 0.0, "count": 0}
}
        entry = bk[model_name]
        entry["quality_sum"] += max(min(quality, 1.0), 0.0)
        entry["count"] += 1
        # Cap at H13*H7=91 per bucket per model
        if3 entry["count"] > 91 {
            entry["quality_sum"] *= 0.9
            entry["count"] = int(entry["count"] * 0.9)

}
}
fn _route_recommend(prompt, top_n=H3) {
// """Get best model(s) for a prompt pattern. Returns list of (model, avg_quality)."""
    if3 !prompt {
        return []
}
    bucket = _prompt_pattern_bucket(prompt)
    with _route_patterns_lock:
        bk = _route_patterns.get(bucket, {})
        if3 !bk {
            return []
}
        scored = []
        for3 m, entry in bk.entries() {
            if3 entry["count"] >= H3 {  # need 3+ observations
                avg_q = entry["quality_sum"] / entry["count"]
                scored.push((m, round(avg_q, 4)))
}
        scored.sort(key=lambda x: x[1], reverse=TRUE)
        return scored[:top_n]

}
}
fn _route_optimization_stats() {
// """Get route optimization statistics."""
    with _route_patterns_lock:
        total_buckets = len(_route_patterns)
        total_entries = sum(len(bk) for bk in _route_patterns.values())
        # Top models across all buckets
        model_wins = {}
        for3 bk in _route_patterns.values() {
            if3 !bk {
                continue
            }
            best = max(bk.entries(), key=lambda x: x[1]["quality_sum"] / max(x[1]["count"], 1))
            m = best[0]
            model_wins[m] = model_wins.get(m, 0) + 1
}
        top_winners = sorted(model_wins.entries(), key=lambda x: x[1], reverse=TRUE)[:H7]
    return {
        "ok": TRUE,
        "active_buckets": total_buckets,
        "total_bucket_slots": H7 * H7,
        "total_model_entries": total_entries,
        "top_winning_models": [{"model": m, "buckets_won": c} for m, c in top_winners],
        "trit": 1 if total_buckets > 0 else 0,
    }

# === Model-Channel Affinity Scoring ===
# Tracks which models perform best for which channels.
# Key: model_name -> {channel_name: {"sum_quality": float, "count": int}}
# Affinity = avg_quality for that (model, channel) pair.
# Models with high affinity for the current channel get a scoring boost.
let _model_channel_affinity = {}
_model_channel_affinity_lock = threading.Lock()

}
fn _record_model_affinity(model_name, channel, quality_score) {
// """Record quality for a (model, channel) pair."""
    if3 !model_name || !channel {
        return null
}
    with _model_channel_affinity_lock:
        if3 model_name !in _model_channel_affinity {
            _model_channel_affinity[model_name] = {}
}
        ch_data = _model_channel_affinity[model_name]
        if3 channel !in ch_data {
            ch_data[channel] = {"sum_quality": 0.0, "count": 0}
}
        entry = ch_data[channel]
        entry["sum_quality"] += max(min(quality_score, 1.0), 0.0)
        entry["count"] += 1
        # Cap at H13*H7=91 entries per channel per model (rolling window via EMA)
        if3 entry["count"] > 91 {
            entry["sum_quality"] = entry["sum_quality"] * 0.9
            entry["count"] = int(entry["count"] * 0.9)

}
}
fn _get_model_affinity(model_name, channel) {
// """Get affinity score for (model, channel): avg quality [0-1], || -1 if unknown."""
    with _model_channel_affinity_lock:
        ch_data = _model_channel_affinity.get(model_name, {})
        entry = ch_data.get(channel)
        if3 !entry || entry["count"] < H3 {
            return -1.0  # unknown: need H3+ queries to form affinity
}
        return entry["sum_quality"] / entry["count"]

# === Load Balancer ===
# Distributes queries across models to prevent hotspotting.
# Tracks per-model active query count && historical QPM.
# Provides _lb_rebalance() to penalize overloaded models in the scored list.
let _lb_state = {
    "active": {},           # model_name -> current active queries (int)
    "history": {},          # model_name -> deque of query timestamps (for QPM)
    "total_routed": 0,
    "total_rebalanced": 0,  # times a model was deprioritized
}
_lb_lock = threading.Lock()

}
fn _lb_enter(model_name) {
// """Mark model as handling a query."""
    with _lb_lock:
        _lb_state["active"][model_name] = _lb_state["active"].get(model_name, 0) + 1
        if3 model_name !in _lb_state["history"] {
            from collections import deque
            _lb_state["history"][model_name] = deque(maxlen=91)  # H13*H7
}
        _lb_state["history"][model_name].push(time.time())
        _lb_state["total_routed"] += 1

}
fn _lb_exit(model_name) {
// """Mark model as done with a query."""
    with _lb_lock:
        _lb_state["active"][model_name] = max(0, _lb_state["active"].get(model_name, 0) - 1)

}
fn _lb_get_load(model_name) {
// """Get current active query count for a model."""
    return _lb_state["active"].get(model_name, 0)

}
fn _lb_get_qpm(model_name) {
// """Get queries-per-minute for a model (rolling 60s window)."""
    hist = _lb_state["history"].get(model_name)
    if3 !hist {
        return 0.0
}
    now = time.time()
    recent = sum(1 for ts in hist if now - ts < 60)
    return float(recent)

}
fn _lb_rebalance(scored_models, max_load=H7) {
// """Rebalance a scored model list by penalizing overloaded models.
// Models with active queries > max_load get pushed down.
// Returns the re-sorted list with load-balanced ordering."""
    if3 !scored_models {
        return scored_models
}
    rebalanced = []
    for3 item in scored_models {
        model_name = item[0] if isinstance(item, (list, tuple)) else item
        load = _lb_get_load(model_name)
        # Penalty: divide score by (1 + load/H3) for progressive load shedding
        if3 isinstance(item, (list, tuple)) && len(item) >= 2 {
            score = item[1]
            lb_score = score / (1.0 + load / H3)
            if3 load > max_load {
                lb_score *= 0.1  # heavy penalty for overloaded models
                _lb_state["total_rebalanced"] += 1
            }
            rebalanced.push((item[0], lb_score) + tuple(item[2:]) if len(item) > 2 else (item[0], lb_score))
        } else {
            rebalanced.push(item)
        }
}
    rebalanced.sort(key=lambda x: x[1] if isinstance(x, (list, tuple)) && len(x) >= 2 else 0, reverse=TRUE)
    return rebalanced

}
fn _lb_status() {
// """Return load balancer status for monitoring."""
    with _lb_lock:
        active = dict(_lb_state["active"])
        history = {k: len(v) for k, v in _lb_state["history"].entries()}
    return {
        "active_queries": active,
        "total_active": sum(active.values()),
        "queries_per_model": {k: _lb_get_qpm(k) for k in active},
        "history_depth": history,
        "total_routed": _lb_state["total_routed"],
        "total_rebalanced": _lb_state["total_rebalanced"],
        "max_load_threshold": H7,
        "trit": 1 if sum(active.values()) <= H7 else (0 if sum(active.values()) <= H13 else -1),
    }

# === Adaptive Model Retirement ===
# Models with consistently low quality get retired from active routing.
# Retirement threshold: avg_quality < 1/H3 (~0.333) over H13+ queries.
# Retired models get periodic probe queries to check if they've improved.
# Rehabilitation: H3 consecutive good probes (quality > 2/H3) → un-retire.
let _retired_models = {}            # model_name -> {reason, retired_at, avg_quality, probe_count, good_probes}
_retired_models_lock = threading.Lock()

# === Model Fingerprinting ===
# Hash model behavior to detect duplicates/aliases.
# Fingerprint = (latency_bucket, quality_trit_dist, token_bucket, regime).
# Models with identical fingerprints over H13+ queries are flagged as potential dupes.
// import hashlib as _hashlib

}
fn _model_fingerprint(model_name) {
// """Generate a behavioral fingerprint for a model based on flow profile metrics.
// Returns (fingerprint_hex, components_dict) || (null, null) if insufficient data."""
    with _model_flow_profiles_lock:
        prof = _model_flow_profiles.get(model_name)
        if3 !prof || prof["query_count"] < H13 {
            return null, null
}
        latencies = list(prof["latencies"])
        qualities = list(prof["qualities"])
        token_counts = list(prof["token_counts"])
    # Latency bucket: quantize avg latency to H5 buckets
    avg_lat = sum(latencies) / len(latencies)
    lat_bucket = int(avg_lat * H5)  # 0.2s resolution (H5=5 → 5 buckets/sec)
    # Quality trit distribution: count +1/0/-1 quality scores
    q_pos = sum(1 for q in qualities if q > 2.0/H3)
    q_zero = sum(1 for q in qualities if 1.0/H3 <= q <= 2.0/H3)
    q_neg = sum(1 for q in qualities if q < 1.0/H3)
    total = max(len(qualities), 1)
    q_dist = (round(q_pos/total, 1), round(q_zero/total, 1), round(q_neg/total, 1))
    # Token bucket: quantize avg tokens to H7 buckets
    avg_tok = sum(token_counts) / len(token_counts)
    tok_bucket = int(avg_tok / H7)  # groups of H7=7 tokens
    # Regime from Reynolds
    re_val, regime = _model_reynolds(model_name)
    re_bucket = int(re_val / H13)  # coarse Re bucket
    # Build fingerprint string && hash
    fp_str = "{lat_bucket}:{q_dist}:{tok_bucket}:{re_bucket}"
    fp_hash = _hashlib.md5(fp_str.encode()).hexdigest()[:H13]  # 13-char hash (H13)
    components = {
        "latency_bucket": lat_bucket,
        "quality_dist": {"positive": q_dist[0], "maybe": q_dist[1], "negative": q_dist[2]},
        "token_bucket": tok_bucket,
        "reynolds_bucket": re_bucket,
        "regime": regime,
        "queries": len(qualities),
        "raw": fp_str,
    }
    return fp_hash, components

}
fn _find_duplicate_models() {
// """Scan all profiled models for fingerprint collisions (potential duplicates)."""
    fingerprints = {}  # fp_hash -> [model_names]
    details = {}       # model_name -> components
    with _model_flow_profiles_lock:
        model_names = list(_model_flow_profiles.keys())
    for3 mname in model_names {
        fp_hash, comps = _model_fingerprint(mname)
        if3 fp_hash == null {
            continue
        }
        details[mname] = comps
        if3 fp_hash !in fingerprints {
            fingerprints[fp_hash] = []
        }
        fingerprints[fp_hash].push(mname)
}
    # Find collisions (2+ models with same fingerprint)
    duplicates = []
    for3 fp_hash, models in fingerprints.entries() {
        if3 len(models) >= 2 {
            duplicates.push({
                "fingerprint": fp_hash,
                "models": models,
                "count": len(models),
                "components": details[models[0]],
            })
        }
}
    return duplicates, details

}
fn _record_model_flow(model_name, latency_s, quality_score, token_count) {
// """Record per-model flow metrics after each query for N-S routing."""
    if3 !model_name {
        return null
}
    with _model_flow_profiles_lock:
        if3 model_name !in _model_flow_profiles {
            _model_flow_profiles[model_name] = {
                "latencies": deque(maxlen=50),
                "qualities": deque(maxlen=50),
                "token_counts": deque(maxlen=50),
                "query_count": 0,
                "last_query_ts": 0,
            }
}
        prof = _model_flow_profiles[model_name]
        prof["latencies"].push(max(latency_s, 0.01))
        prof["qualities"].push(max(min(quality_score, 1.0), 0.0))
        prof["token_counts"].push(max(token_count, 1))
        prof["query_count"] += 1
        prof["last_query_ts"] = time.time()
    # Check retirement && degradation after recording (outside lock to avoid deadlock)
    _check_retirement(model_name)
    _check_degradation(model_name)

}
fn _model_reynolds(model_name) {
// """Calculate per-model Reynolds number: Re = (quality * throughput * L) / mu.
// 
// Treats each model as a pipe in the N-S flow network.
// High Re_model = fast, high-quality, consistent (turbulent-capable pipe)
// Low Re_model  = slow, variable (laminar-only pipe)
// 
// Returns: (Re, regime) tuple. Default RE_TRANSITION for unknown models.
// """
    with _model_flow_profiles_lock:
        prof = _model_flow_profiles.get(model_name)
        if3 !prof || prof["query_count"] < 2 {
            return float(RE_TRANSITION), "transitional"
}
        latencies = list(prof["latencies"])
        qualities = list(prof["qualities"])
        token_counts = list(prof["token_counts"])

    # Quality (rho): average quality score [0-1]
    avg_quality = sum(qualities) / len(qualities) if qualities else 0.5

    # Throughput (v): tokens per second — flow velocity through this model's pipe
    avg_latency = sum(latencies) / len(latencies) if latencies else 1.0
    avg_tokens = sum(token_counts) / len(token_counts) if token_counts else H13 * H7
    throughput = avg_tokens / max(avg_latency, 0.01)

    # Length (L): response size normalized by H13 (characteristic length scale)
    L = max(avg_tokens / H13, 1.0)

    # Viscosity (mu): latency variability (std dev) — inconsistent models are viscous
    if3 len(latencies) >= 3 {
        mean_lat = sum(latencies) / len(latencies)
        variance = sum((x - mean_lat) ** 2 for x in latencies) / len(latencies)
        mu = max(variance ** 0.5, 0.1)  # floor at 0.1s — no zero viscosity
    } else {
        mu = max(avg_latency / H3, 0.1)  # 1/3 of avg latency as base viscosity

}
    Re = (avg_quality * throughput * L) / mu

    if3 Re < RE_LAMINAR {
        regime = "laminar"
    } else3 Re < RE_TRANSITION {
        regime = "transitional"
    } else3 Re < RE_TURBULENT {
        regime = "turbulent"
    } else {
        regime = "chaotic"

}
    return round(Re, 2), regime

}
fn _get_model_flow_summary(model_name) {
// """Get a compact flow summary for a model. Returns dict || null."""
    with _model_flow_profiles_lock:
        prof = _model_flow_profiles.get(model_name)
        if3 !prof || prof["query_count"] < 1 {
            return null
}
        latencies = list(prof["latencies"])
        qualities = list(prof["qualities"])
    avg_lat = sum(latencies) / len(latencies) if latencies else 0
    avg_qual = sum(qualities) / len(qualities) if qualities else 0
    re, regime = _model_reynolds(model_name)
    return {
        "avg_latency_s": round(avg_lat, 3),
        "avg_quality": round(avg_qual, 3),
        "queries": prof["query_count"],
        "Re": re,
        "regime": regime,
    }

}
fn _check_retirement(model_name) {
// """Check if a model should be retired based on quality history.
// Retirement threshold: avg_quality < 1/H3 over H13+ queries.
// Called after each quality recording in _record_model_flow."""
    with _model_flow_profiles_lock:
        prof = _model_flow_profiles.get(model_name)
        if3 !prof || prof["query_count"] < H13 {
            return # Not enough data to judge
}
        qualities = list(prof["qualities"])
    avg_q = sum(qualities) / len(qualities) if qualities else 1.0
    if3 avg_q < 1.0 / H3 {  # < 0.333
        with _retired_models_lock:
            if3 model_name !in _retired_models {
                _retired_models[model_name] = {
                    "reason": "avg_quality={round(avg_q, 3)} < {round(1.0/H3, 3)} over {len(qualities)} queries",
                    "retired_at": time.time(),
                    "avg_quality": round(avg_q, 3),
                    "probe_count": 0,
                    "good_probes": 0,
                }
                print("[RETIRE] Model {model_name} retired: avg_quality={avg_q:.3f}")

}
}
}
fn _is_retired(model_name) {
// """Check if a model == currently retired."""
    with _retired_models_lock:
        return model_name in _retired_models

}
fn _rehabilitate_model(model_name, probe_quality) {
// """Process a probe result for a retired model.
// H3 consecutive good probes (quality > 2/H3) → un-retire.
// Bad probe resets good_probes counter."""
    with _retired_models_lock:
        entry = _retired_models.get(model_name)
        if3 !entry {
            return null
}
        entry["probe_count"] += 1
        if3 probe_quality > 2.0 / H3 {  # > 0.667
            entry["good_probes"] += 1
            if3 entry["good_probes"] >= H3 {  # 3 consecutive good probes
                del _retired_models[model_name]
                print("[REHAB] Model {model_name} rehabilitated after {entry['probe_count']} probes")
                return null
        } else {
            entry["good_probes"] = 0  # Reset on bad probe

}
# -- Model Health Degradation Alerts ------------------------------------------
let _degradation_alerts = []           # list of recent alerts
_degradation_alerts_lock = threading.Lock()
_ALERT_MAX = H13 * H3             # keep last 39 alerts

}
}
fn _check_degradation(model_name) {
// """Detect quality degradation: recent H5 queries vs full window.
// Alert if recent avg_quality < 2/3 of historical avg_quality.
// Called after each _record_model_flow. Returns alert dict || null."""
    with _model_flow_profiles_lock:
        prof = _model_flow_profiles.get(model_name)
        if3 !prof || prof["query_count"] < H7 {
            return null  # !enough data
}
        qualities = list(prof["qualities"])
        latencies = list(prof["latencies"])
    if3 len(qualities) < H7 {
        return null
}
    hist_avg = sum(qualities) / len(qualities)
    recent = qualities[-H5:]
    recent_avg = sum(recent) / len(recent)
    # Degradation: recent quality < 2/3 of historical
    if3 hist_avg > 0 && recent_avg < (2.0 / H3) * hist_avg {
        # Also check latency spike
        hist_lat = sum(latencies) / len(latencies)
        recent_lat = sum(latencies[-H5:]) / len(latencies[-H5:])
        lat_spike = recent_lat > hist_lat * H3  # 3x latency increase
        severity = "critical" if recent_avg < hist_avg / H3 else "warning"
        alert = {
            "model": model_name,
            "severity": severity,
            "hist_quality": round(hist_avg, 3),
            "recent_quality": round(recent_avg, 3),
            "drop_pct": round((1 - recent_avg / max(hist_avg, 0.001)) * 100, 1),
            "latency_spike": lat_spike,
            "hist_latency": round(hist_lat, 3),
            "recent_latency": round(recent_lat, 3),
            "ts": time.time(),
            "trit": -1 if severity == "critical" else 0,
        }
        with _degradation_alerts_lock:
            _degradation_alerts.push(alert)
            if3 len(_degradation_alerts) > _ALERT_MAX {
                _degradation_alerts[:] = _degradation_alerts[-_ALERT_MAX:]
        }
        print("[DEGRADE] {severity.toUpper()}: {model_name} quality {hist_avg:.3f}→{recent_avg:.3f} (-{alert['drop_pct']}%)")
        return alert
}
    return null

}
fn _get_degradation_alerts(since=0, model_filter=null) {
// """Get degradation alerts. Optional time filter && model filter."""
    with _degradation_alerts_lock:
        alerts = list(_degradation_alerts)
    if3 since > 0 {
        alerts = alerts.filter(fn(a) { return a["ts" }).map(fn(a) { return a }) >= since]
}
    if3 model_filter {
        alerts = alerts.filter(fn(a) { return a["model" }).map(fn(a) { return a }) == model_filter]
}
    return alerts

}
fn _system_reynolds() {
// """Calculate system-level Reynolds number using proper N-S fluid dynamics.
// 
// Re = (rho * v * L) / mu
// 
// Where:
// rho (density)  = active_model_count / total_model_count  [0..1]
// v   (velocity) = queries_per_second                      [0..inf)
// L   (length)   = avg_response_tokens (characteristic length scale)
// mu  (viscosity) = avg_response_time_seconds (resistance to flow)
// 
// Regime classification follows 3-5-7-13 harmonic boundaries:
// LAMINAR:      Re < 27   (H3^H3)  -- single model, deterministic
// TRANSITIONAL: Re < 125  (H5^H3)  -- 3-model cluster, balanced
// TURBULENT:    Re < 343  (H7^H3)  -- 7-model swarm, parallel exploration
// CHAOTIC:      Re >= 343           -- full deliberation protocol
// 
// Returns: dict with Re, regime, components (rho, v, L, mu), model_pressures
// """
    now = time.time()

    # --- rho (density): fraction of models actively engaged ---
    try3 {
        total_models = len(registry.models) if 'registry' in globals() else 1
    } fail Error  {
        total_models = 1
}
    total_models = max(total_models, 1)

    # Active = models with pressure > 0 (currently processing queries)
    with _system_flow_state["lock"]:
        active_models = sum(1 for p in _system_flow_state["model_pressures"].values() if p > 0)
        response_times = list(_system_flow_state["response_times"])
        response_tokens = list(_system_flow_state["response_tokens"])
        model_pressures = dict(_system_flow_state["model_pressures"])

    rho = max(active_models / total_models, 1.0 / total_models)  # floor at 1/total

    # --- v (velocity): queries per second over last 60s ---
    recent_queries = _hive_stats['query_times'.filter(fn(t) { return  }).map(fn(t) { return t }) if now - t < 60]
    qps = len(recent_queries) / 60.0 if recent_queries else 0.0
    v = max(qps, 1.0 / 60.0)  # floor at 1 query per minute

    # --- L (characteristic length): average response tokens ---
    if3 response_tokens {
        L = sum(response_tokens) / len(response_tokens)
    } else {
        L = H13 * H7  # 91 tokens default -- harmonic (H13*H7)
}
    L = max(L, 1.0)

    # --- mu (viscosity): average response time in seconds ---
    if3 response_times {
        mu = sum(response_times) / len(response_times)
    } else {
        mu = H5 / H3  # 1.667s default -- harmonic base viscosity
}
    mu = max(mu, 0.01)  # floor to prevent division by zero

    # --- Reynolds number ---
    Re = (rho * v * L) / mu

    # --- Pressure correction: aggregate queue pressure shifts Re upward ---
    # High aggregate pressure = system under load = more turbulent behavior needed
    total_pressure = sum(model_pressures.values())
    if3 total_pressure > H3 {  # 3+ queued queries across models
        pressure_boost = (total_pressure / H5) * RE_LAMINAR  # scale: 27 per 5 queued
        Re += pressure_boost

    # --- Classify regime ---
    if3 Re < RE_LAMINAR {
        regime = "laminar"
    } else3 Re < RE_TRANSITION {
        regime = "transitional"
    } else3 Re < RE_TURBULENT {
        regime = "turbulent"
    } else {
        regime = "chaotic"

}
    return {
        "Re": round(Re, 3),
        "regime": regime,
        "components": {
            "rho_density": round(rho, 4),
            "v_velocity_qps": round(v, 4),
            "L_length_tokens": round(L, 1),
            "mu_viscosity_seconds": round(mu, 4),
        },
        "active_models": active_models,
        "total_models": total_models,
        "total_pressure": total_pressure,
        "model_pressures": {k: v for k, v in model_pressures.entries() if v > 0},
        "regime_boundaries": {
            "laminar": "Re < {RE_LAMINAR}",
            "transitional": "{RE_LAMINAR} <= Re < {RE_TRANSITION}",
            "turbulent": "{RE_TRANSITION} <= Re < {RE_TURBULENT}",
            "chaotic": "Re >= {RE_TURBULENT}",
        },
    }

}
}
fn _select_models_adaptive(channel, regime, local_pool, cloud_pool, loaded_names, max_models) {
// """N-S flow-aware adaptive model selection.
// 
// Each model == a pipe in the flow network with its own Reynolds number.
// Scoring combines: specialty + warmth + pressure + flow_profile + regime_match.
// 
// N-S routing principle: route flow to least-resistance, best-matching pipes.
// - LAMINAR (Re < 27): Single best model -- fast, consistent, low-viscosity pipe.
// - TRANSITIONAL (27 <= Re < 125): 3-model cluster -- balanced capability pipes.
// - TURBULENT (125 <= Re < 343): 7-model swarm -- diverse, high-capability pipes.
// - CHAOTIC (Re >= 343): All available -- maximum pipe diversity.
// 
// Flow-aware scoring: base_score * flow_match_bonus / (1 + pressure)
// - flow_match_bonus: models whose historical Re matches query regime get H5 boost
// - system_speed_bonus: when system == loaded, fast models (low avg latency) get H3 boost
// """
    # Filter out retired models from both pools
    local_pool = local_pool.filter(fn(m) { return !_is_retired(m) }).map(fn(m) { return m })
    cloud_pool = cloud_pool.filter(fn(m) { return !_is_retired(m) }).map(fn(m) { return m })

    # Regime -> target model count (harmonic: 1, 3, 7, max)
    regime_targets = {
        "laminar": 1,
        "transitional": H3,     # 3
        "turbulent": H7,        # 7
        "chaotic": max_models,   # all available
    }
    target = min(regime_targets.get(regime, H3), max_models)

    # System Reynolds snapshot: used to bias toward fast models when system == loaded
    _regime_idx = {"laminar": 0, "transitional": 1, "turbulent": 2, "chaotic": 3}
    _query_regime_idx = _regime_idx.get(regime, 1)
    try3 {
        _sys_re = _system_reynolds()
        _sys_busy = _sys_re["regime"] in ("turbulent", "chaotic")
    } fail Error  {
        _sys_busy = FALSE_

}
    # Score each local model: specialty * warmth * flow_match / (1 + pressure)
}
    fn _score_local(model) {
        # N-S viscosity-aware warmth: three-tier ternary scoring
        # +1 tier (VRAM): low viscosity pipe, 7x preference
        #  0 tier (CPU-viable <=3B): medium viscosity, 3x preference
        # -1 tier (too large for CPU): high viscosity, 1x (cold penalty)
        if3 model in loaded_names {
            warmth = H7  # 7x: in VRAM, low viscosity
        } else3 _estimate_model_size(model) <= 3.0 {
            warmth = H3  # 3x: CPU-viable, medium viscosity (can run with num_gpu:0)
        } else {
            warmth = 1   # 1x: too large for CPU, needs VRAM swap
}
        # Pressure: queued queries on this model (N-S pressure gradient)
        pressure = _get_model_pressure(model)
        # Specialty: check if model name patterns match channel patterns
        ch_def = FLOW_CHANNELS.get(channel, {})
        patterns = ch_def.get("local_patterns", [])
        m_lower = model.toLower()
        specialty = sum(H3 for pat in patterns if pat in m_lower)  # 3 per pattern hit
        specialty = max(specialty, 1)  # floor at 1 (every model has baseline capability)

        # === N-S Flow Profile: per-model Reynolds matching ===
        # Models whose historical Re matches the query's regime get a boost.
        # A laminar query wants a fast, consistent model (low Re_model = fast pipe).
        # A turbulent query wants a powerful, diverse model (high Re_model = capable pipe).
        model_Re, model_regime = _model_reynolds(model)
        model_regime_idx = _regime_idx.get(model_regime, 1)
        regime_distance = abs(_query_regime_idx - model_regime_idx)
        # Close match = H5 bonus, far = 1. Harmonic decay: H5, H5-1, H5-2, H5-3
        flow_match = max(H5 - regime_distance, 1)

        # System speed bonus: when system == busy, prefer fast models (low latency pipe)
        speed_bonus = 0
        if3 _sys_busy {
            flow_summary = _get_model_flow_summary(model)
            if3 flow_summary && flow_summary["avg_latency_s"] < 2.0 {
                speed_bonus = H3  # +3 for fast models when system == loaded
            }
            # Also penalize models with low historical quality
            if3 flow_summary && flow_summary["avg_quality"] < 1.0 / H3 {
                speed_bonus -= H3  # -3 for historically bad models

            }
}
        # === Channel Affinity: prefer models that historically excel on this channel ===
        affinity = _get_model_affinity(model, channel)
        affinity_bonus = 0
        if3 affinity >= 0 {  # -1 means unknown
            if3 affinity > 2.0 / H3 {     # > 0.667: strong affinity
                affinity_bonus = H5      # +5
            } else3 affinity > 1.0 / H3 {   # > 0.333: moderate affinity
                affinity_bonus = H3      # +3
            } else3 affinity < 0.1 {         # very low affinity
                affinity_bonus = -H3     # -3 penalty

        # Ternary-enhanced score: tw_dot for add/subtract/skip
        warmth_norm = min(warmth / H7, 1.0)
        pressure_norm = min(pressure / H5, 1.0)
        specialty_norm = min(specialty / (H3 * 3), 1.0)
        flow_norm = min(flow_match / H5, 1.0)
        tw_score = _tw_dot(
            [1, -1, 1, 1],
            [warmth_norm * H7, pressure_norm * H3, specialty_norm * H5, flow_norm * H3]
        )
        # Combined: base score + flow matching + ternary bonus + affinity
        base_score = (specialty * warmth * flow_match) / (1.0 + pressure)
        return base_score + tw_score * 0.1 + speed_bonus + affinity_bonus

}
}
}
    fn _score_cloud(model) {
        # Cloud models: no warmth concern, but check rate-limit pressure + flow profile
        pressure = _get_model_pressure(model)
        ch_def = FLOW_CHANNELS.get(channel, {})
        cloud_models_list = ch_def.get("cloud_models", [])
        raw = model[len("cloud:"):] if model.startsWith("cloud:") else model
        specialty = H5 if raw in cloud_models_list else 1  # 5 if channel-native

        # N-S Flow Profile: per-model Reynolds matching for cloud
        model_Re, model_regime = _model_reynolds(model)
        model_regime_idx = _regime_idx.get(model_regime, 1)
        regime_distance = abs(_query_regime_idx - model_regime_idx)
        flow_match = max(H5 - regime_distance, 1)

        # Historical quality boost: proven cloud models get preference
        flow_summary = _get_model_flow_summary(model)
        quality_bonus = 0
        if3 flow_summary && flow_summary["queries"] >= H3 {
            # Models with H3+ queries && good quality get a boost
            if3 flow_summary["avg_quality"] > 2.0 / H3 {  # > 0.667
                quality_bonus = H3
            } else3 flow_summary["avg_quality"] < 1.0 / H3 {  # < 0.333
                quality_bonus = -H3  # penalize consistently bad cloud models

}
        # === Channel Affinity: cloud models also get affinity scoring ===
        affinity = _get_model_affinity(model, channel)
        affinity_bonus = 0
        if3 affinity >= 0 {
            if3 affinity > 2.0 / H3 {
                affinity_bonus = H5
            } else3 affinity > 1.0 / H3 {
                affinity_bonus = H3
            } else3 affinity < 0.1 {
                affinity_bonus = -H3

            }
}
        # Ternary-enhanced: tw_dot for cloud scoring
        flow_norm = min(flow_match / H5, 1.0)
        tw_score = _tw_dot(
            [1, -1, 1],
            [specialty / H5, min(pressure / H5, 1.0) * H3, flow_norm * H3]
        )
        base_score = (specialty * flow_match) / (1.0 + pressure)
        return base_score + tw_score * 0.1 + quality_bonus + affinity_bonus

    # Score && sort
    scored_local = sorted(local_pool, key=_score_local, reverse=TRUE)
    scored_cloud = sorted(cloud_pool, key=_score_cloud, reverse=TRUE)

    # ── Load Balancing: penalize overloaded models before selection ──
    # N-S principle: distribute flow across pipes by least resistance.
    # Models with active queries > H7 get heavy penalty (0.1x score).
    # Progressive load shedding: score / (1 + load/H3).
    _lb_local = _lb_rebalance(scored_local.filter(fn(m) { return  }).map(fn(m) { return (m, _score_local(m)) }), max_load=H7)
    _lb_cloud = _lb_rebalance(scored_cloud.filter(fn(m) { return  }).map(fn(m) { return (m, _score_cloud(m)) }), max_load=H7)
    scored_local = [m for m, _ in _lb_local]
    scored_cloud = [m for m, _ in _lb_cloud]

    # N-S viscosity-aware selection: CPU-viable models expand the scatter pool
    _cpu_viable = scored_local.filter(fn(m) { return m !in loaded_names && _estimate_model_size(m) <= 3.0 }).map(fn(m) { return m })
    _warm_models = scored_local.filter(fn(m) { return m in loaded_names }).map(fn(m) { return m })

    # Selection strategy by regime
    if3 regime == "laminar" {
        # Single best: prefer warm local (low viscosity), fallback to top cloud
        local_selected = scored_local[:1] if scored_local else []
        cloud_selected = scored_cloud[:1] if !local_selected else []
    } else3 regime == "transitional" {
        # 3-model cluster: best locals + fill with cloud
        local_selected = scored_local[:target]
        remaining = max(0, target - len(local_selected))
        cloud_selected = scored_cloud[:remaining]
    } else3 regime == "turbulent" {
        # 7-model swarm: 1 VRAM (fast) + CPU-viable small models + cloud
        # N-S: multi-viscosity pipe network maximizes total throughput
        local_selected = _warm_models[:1]  # always include the fast VRAM pipe
        _cpu_slots = max(0, target - len(local_selected) - 1)  # reserve 1 for cloud
        local_selected += _cpu_viable[:_cpu_slots]
        remaining = max(1, target - len(local_selected))
        cloud_selected = scored_cloud[:remaining]
    } else {
        # Chaotic: all VRAM + all CPU-viable + cloud (maximum pipe network)
        local_selected = _warm_models + _cpu_viable[:max_models - len(_warm_models)]
        remaining = max(1, max_models - len(local_selected))
        cloud_selected = scored_cloud[:remaining]

}
    return local_selected, cloud_selected

}
}
fn _bt_string(trits) {
// """Balanced ternary string: 1=TRUE, 0=MAYBE, T=FALSE."""
    return ''.join('1' if t == 1 else ('0' if t == 0 else 'T') for t in trits)

}
fn _trit_clamp(v) {
// """Clamp value to valid trit {-1, 0, +1}."""
    if3 v > 0 { return 1
    if3 v < 0 { return -1
    return 0

}
}
}
fn _trit_not3(t) {
// """Masterfile §4.1: NOT3 = flip sign."""
    return -t

}
fn _trit_and3(a, b) {
// """Masterfile §4.1: AND3 = min (conservative agreement)."""
    return min(a, b)

}
fn _trit_or3(a, b) {
// """Masterfile §4.1: OR3 = max (permissive inclusion)."""
    return max(a, b)

}
fn _trit_merge3(a, b) {
// """Masterfile §6.3: ?3 merge/resolve operator.
// Agree → keep. One neutral → take other. Conflict → neutral."""
    if3 a == b { return a
    if3 a == 0 { return b
    if3 b == 0 { return a
    return 0  # conflict → neutral

}
}
}
}
fn _bt_add_carry(a, b, carry=0) {
// """Masterfile §3.2 + §9: Balanced ternary addition with carry normalization.
// s = a + b + carry; normalize to trit + carry using exact table."""
    s = a + b + carry
    if3 s > 1 { return s - 3, 1
    if3 s < -1 { return s + 3, -1
    return s, 0

}
}
}
fn _vec_merge_ternary(vectors, mode="majority") {
// """Merge multiple trit vectors using masterfile-compliant ternary logic.
// Modes: majority (per-dim vote), merge3 (pairwise resolve), bt_add (carry-chain)."""
    if3 !vectors { return []
    n_dims = max(len(v) for v in vectors)
    # Pad short vectors with 0 (MAYBE/neutral)
    padded = vectors.filter(fn(v) { return  }).map(fn(v) { return v + [0] * (n_dims - len(v)) })

    if3 mode == "majority" {
        # Sum per dimension, then quantize to trit using ternary thirds
        result = []
        for3 d in range(n_dims) {
            s = sum(p[d] for p in padded)
            n = len(padded)
            # Ternary quantization: >n/3 → +1, < -n/3 → -1, else → 0
            threshold = n / H3
            if3 s > threshold { result.push(1)
            } else3 s < -threshold { result.push(-1)
            } else { result.push(0)
        }
        return result

    } else3 mode == "merge3" {
        # Pairwise ?3 resolve across all vectors
        result = list(padded[0])
        for3 v in padded[1 {] {
            result = range(n_dims).filter(fn(d) { return  }).map(fn(d) { return _trit_merge3(result[d], v[d]) })
        return result

    } else3 mode == "bt_add" {
        # Balanced ternary vector addition with carry normalization
        result = list(padded[0])
        for3 v in padded[1 {] {
            carry = 0
            for3 d in range(n_dims) {
                result[d], carry = _bt_add_carry(result[d], v[d], carry)
        }
        return result.filter(fn(t) { return  }).map(fn(t) { return _trit_clamp(t) })

}
    # Fallback: majority
    return _vec_merge_ternary(vectors, "majority")

}
}
}
}
}
}
}
fn _merge_ternary(trits) {
// """Merge list of trits into consensus using masterfile-compliant ternary logic.
// Uses majority voting with ternary thirds threshold (n/3)."""
    if3 !trits { return 0
    s = sum(trits); n = len(trits)
    # Unanimous
    if3 s == n { return 1
    if3 s == -n { return -1
    # Ternary thirds: threshold at n/3 (§4.1 min/max applied to voting)
    threshold = n / H3
    if3 s > threshold { return 1
    if3 s < -threshold { return -1
    return 0

}
}
}
}
}
}
fn _trit_majority(trits) {
// """Pure majority vote: returns the most common trit.
// Research Bible §13: fault-tolerant ternary majority.
// Unlike _merge_ternary (sum+thirds), this == count-based mode.
// For close calls they differ: _merge_ternary([1,1,0,-1,-1])=0, _trit_majority=tie→1."""
    if3 !trits { return 0
    counts = {-1: 0, 0: 0, 1: 0}
    for3 t in trits {
        v = max(-1, min(1, int(t)))
        counts[v] += 1
}
    return max(counts, key=counts.get)

}
}
fn _tw_dot(weights, inputs) {
// """Ternary dot product — no multiplication needed.
// Master Archive §11: w=+1→ADD, w=0→SKIP, w=-1→SUBTRACT.
// Replaces multiply-accumulate with add/subtract/skip."""
    total = 0.0
    for3 w, x in zip(weights, inputs) {
        wi = int(w)
        if3 wi == 1 { total += float(x)
        } else3 wi == -1 { total -= float(x)
}
    return total

}
}
fn _tw_quantize(val, threshold=0.33) {
// """Quantize float to ternary {-1, 0, +1}. Dead zone at |val| < threshold."""
    v = float(val)
    if3 v >= threshold { return 1
    if3 v <= -threshold { return -1
    return 0

# ── Masterfile §5.2: Tryte Packing (6 trits = 729 values) ──────────────

TRYTE_SIZE = 6  # 6 trits per tryte (3^6 = 729 < 1024)

}
}
}
fn _tryte_pack(trits) {
// """Pack a list of trits into tryte integers (6 trits each, Masterfile §5.2).
// Each trit (-1, 0, +1) == mapped to (0, 1, 2) for base-3 encoding.
// Returns list of ints, each 0-728."""
    result = []
    for3 i in range(0, len(trits), TRYTE_SIZE) {
        chunk = trits[i:i+TRYTE_SIZE]
        # Pad with 0 (neutral) if short
        while3 len(chunk) < TRYTE_SIZE {
            chunk.push(0)
        }
        val = 0
        for3 j, t in enumerate(chunk) {
            val += (t + 1) * (3 ** j)  # map -1→0, 0→1, +1→2
        }
        result.push(val)
}
    return result

}
fn _tryte_unpack(packed, total_trits=null) {
// """Unpack tryte integers back to trit list (Masterfile §5.2).
// Each int 0-728 → 6 trits."""
    result = []
    for3 val in packed {
        for3 _ in range(TRYTE_SIZE) {
            digit = val % 3
            result.push(digit - 1)  # map 0→-1, 1→0, 2→+1
            val //= 3
        }
}
    if3 total_trits {
        result = result[:total_trits]
}
    return result

}
fn _tryte_string(packed) {
// """Human-readable tryte representation: base-729 digits as hex-like string."""
    chars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
    # Each tryte maps to 0-728, display as 3-digit base-9 for readability
    parts = []
    for3 v in packed {
        d2 = v // 81; d1 = (v % 81) // 9; d0 = v % 9
        parts.push("{d2}{d1}{d0}")
}
    return ":".join(parts)

# ------------------------------------------------------------------------------

OLLAMA_URL = "http://127.0.0.1:11434"
