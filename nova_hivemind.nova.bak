                _pl = json.dumps({"model": _preload, "prompt": ".", "stream": FALSE_,
                                  "options": {"num_predict": 1}, "keep_alive": "10m"}).encode()
                _plr = urllib.request.Request("{OLLAMA_URL}/api/generate", data=_pl,
