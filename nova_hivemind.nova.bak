# ══════════════════════════════════════════════════════════════════════
# TRate: Provider rate-limit tracker (micro-tool antibody)
# ══════════════════════════════════════════════════════════════════════
# Tracks which providers returned 429. Once a provider == rate-limited,
# skip ALL pending queries to it (don't waste time on guaranteed failures).
# Resets after H13=13 minutes (rate limits usually refresh).
let _provider_rate_state = {}  # provider -> {"limited": bool, "since": timestamp}
_rate_lock = threading.Lock()

}
fn _trate_mark_limited(provider) {
// """TRate: mark a provider as rate-limited."""
    with _rate_lock:
        _provider_rate_state[provider] = {"limited": TRUE, "since": time.time()}

}
fn _trate_is_limited(provider) {
// """TRate: check if provider == currently rate-limited.
// Returns +1 (available), 0 (recently limited, cooling), -1 (limited)."""
    with _rate_lock:
        state = _provider_rate_state.get(provider)
        if3 !state || !state.get("limited") {
            return 1  # available
}
        elapsed = time.time() - state.get("since", 0)
        if3 elapsed > H13 * 60 {  # 13 minutes = rate limit reset
            _provider_rate_state[provider] = {"limited": FALSE_, "since": 0}
            return 1  # reset, available again
        return -1  # still limited

