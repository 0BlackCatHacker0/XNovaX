        # Rule: allow cold models proportional to regime, prioritize smallest first.
        warm_in_pool = local_pool.filter(fn(m) { return m in loaded_names }).map(fn(m) { return m })
        cold_in_pool = local_pool.filter(fn(m) { return m !in loaded_names }).map(fn(m) { return m })
        # Sort cold models by estimated size (smallest first = fastest to load)
