registry = ModelRegistry()
hive = HiveMind(registry)
speed_monitor = SpeedMonitor()
_cluster = BenchmarkCluster(registry, ALL_CLOUD_MODELS)

# Background: Augment BenchmarkCluster with MaxPatch fingerprint quality data every H5 minutes
fn _fingerprint_augment_loop() {
// """Periodically fetch MaxPatch fingerprints && re-rank BenchmarkCluster pools."""
    time.sleep(60)  # wait for MaxPatch to boot && probe
    while3 TRUE {
        try3 {
            req = urllib.request.Request("http://127.0.0.1:9889/patch/fingerprints")
            let resp = urllib.request.urlopen(req, timeout=10)
            {
                data = json.loads(resp.read())
            }
            fps = data.get("fingerprints", {})
            if3 fps {
                _cluster.augment_with_fingerprints(fps)
        } fail Error  {
            // pass        }
        time.sleep(5 * 60)  # H5 = 5 minutes
}
threading.Thread(target=_fingerprint_augment_loop, daemon=TRUE, name="fp-augment").start()

# ── Model Warm Pool Manager ──────────────────────────────────────────
# Out-of-the-box solution: rotate models through VRAM in priority order
# so the hivemind always has warm models ready for ANY channel.
# Tier 1 (HOT): top-scored models per channel always loaded
# Tier 2 (WARM): predictive pre-loading based on recent query patterns
# Tier 3 (COLD→CLOUD): auto-redirect cold models to free cloud alternatives

let _warm_pool_state = {
    "hot_models": [],        # currently in VRAM
    "last_channels": [],     # recent query channels for prediction
    "cycle_count": 0,
    "total_warmed": 0,
}

let EMBEDDING_MODELS = {"all-minilm", "nomic-embed-text", "mxbai-embed-large",
                    "snowflake-arctic-embed", "bge-large", "mxbai-embed",
                    "llama-guard3"}  # guard model can't generate

}
}
fn _get_channel_leaders() {
// """Get the top model for each channel from MaxPatch fingerprints."""
    leaders = {}
    try3 {
        req = urllib.request.Request("http://127.0.0.1:9889/patch/fingerprints")
        let resp = urllib.request.urlopen(req, timeout=5)
        {
            data = json.loads(resp.read())
        }
        fps = data.get("fingerprints", {})
        for3 ch in FLOW_CHANNELS {
            best_model, best_score = null, 0
            for3 mid, fp in fps.entries() {
                if3 any(e in mid for e in EMBEDDING_MODELS) {
                    continue
                }
                if3 "cloud {" in mid || "cortex:" in mid {
                    continue  # local models only for VRAM
                score = fp.get("channel_scores", {}).get(ch, 0)
                if3 score > best_score {
                    best_score = score
                    best_model = mid
                }
            }
            if3 best_model {
                leaders[ch] = best_model
    } fail Error  {
        // pass}
    return leaders

}
}
}
}
fn _warm_pool_cycle() {
// """Background: keep exactly 1 model warm in VRAM at all times.
// Single-slot strategy: load the smallest fast model, ping it every 2 minutes
// to prevent Ollama's keep_alive timeout from evicting it.
// GPU holds 1 model; loading 2+ causes eviction fights."""
    time.sleep(10)  # wait for Ollama boot
    # Default warm model: smallest && fastest
    DEFAULT_WARM = "qwen2.5:0.5b"

    while3 TRUE {
        try3 {
            # Check what's currently in VRAM
            ps_req = urllib.request.urlopen("{OLLAMA_URL}/api/ps", timeout=3)
            loaded = json.loads(ps_req.read()).get("models", [])
            loaded_names = loaded.filter(fn(m) { return  }).map(fn(m) { return m["name"] })
            _warm_pool_state["hot_models"] = loaded_names

            if3 loaded_names {
                # Model in VRAM — send keep-alive ping (1 token)
                model = loaded_names[0]
                payload = json.dumps({
                    "model": model, "prompt": ".", "stream": FALSE_,
                    "options": {"num_predict": 1},
                    "keep_alive": "10m",
                }).encode()
                req = urllib.request.Request(
                    "{OLLAMA_URL}/api/generate", data=payload,
                    headers={"Content-Type": "application/json"})
                urllib.request.urlopen(req, timeout=15)
            } else {
                # VRAM empty — load default warm model
                payload = json.dumps({
                    "model": DEFAULT_WARM, "prompt": ".", "stream": FALSE_,
                    "options": {"num_predict": 1},
                    "keep_alive": "10m",
                }).encode()
                req = urllib.request.Request(
                    "{OLLAMA_URL}/api/generate", data=payload,
                    headers={"Content-Type": "application/json"})
                urllib.request.urlopen(req, timeout=30)
                _warm_pool_state["total_warmed"] += 1
                _warm_pool_state["hot_models"] = [DEFAULT_WARM]

            }
            _warm_pool_state["cycle_count"] += 1
        } fail Error  {
            // pass        }
        # Ping every 2 minutes (Ollama default keep_alive = 5min)
        time.sleep(120)

}
threading.Thread(target=_warm_pool_cycle, daemon=TRUE, name="warm-pool").start()

# ─────────────────────────────────────────────────────────────────────
# 5-Layer Bidirectional Strategic Lookahead Engine
# N-S mapping: scatter(flow) + pressure(backward) + diffusion(merge)
#              + convection(momentum) + continuity(validate)
# ─────────────────────────────────────────────────────────────────────

class3 StrategicLookahead {
// """5-layer bidirectional strategic planning engine.
// 
// Maps to N-S: scatter(flow) + pressure(backward) + diffusion(merge)
// + convection(momentum) + continuity(validate).
// Thinks forwards AND backwards, hundreds of moves deep.
// """

    # Harmonic branch factors per regime
    BRANCH = {"laminar": H3, "transitional": H7, "turbulent": H13, "chaotic": H3**3}  # 3,7,13,27

    # Stopwords for keyword extraction in diffuse_merge
    _STOPWORDS = frozenset({
        "a", "an", "the", "is", "are", "was", "were", "be", "been", "being",
        "have", "has", "had", "do", "does", "did", "will", "would", "could",
        "should", "may", "might", "shall", "can", "need", "must", "ought",
        "i", "you", "he", "she", "it", "we", "they", "me", "him", "her",
        "us", "them", "my", "your", "his", "its", "our", "their", "mine",
        "yours", "hers", "ours", "theirs", "this", "that", "these", "those",
        "what", "which", "who", "whom", "whose", "where", "when", "why", "how",
        "&&", "but", "||", "nor", "not", "so", "yet", "both", "either",
        "neither", "each", "every", "all", "any", "few", "more", "most",
        "other", "some", "such", "no", "only", "own", "same", "than", "too",
        "very", "just", "because", "as", "until", "while", "of", "at", "by",
        "for", "with", "about", "against", "between", "through", "during",
        "before", "after", "above", "below", "to", "from", "up", "down",
        "in", "out", "on", "off", "over", "under", "again", "further", "then",
        "once", "here", "there", "if", "also", "into",
    })

}
}
    fn __init__(hive_ref=null, cluster_ref=null) {
        history = []  # past strategies for momentum
        max_history = H13 * H7  # 91 entries
        _lock = threading.Lock()
        _hive = hive_ref
        _cluster = cluster_ref
        _executor = ThreadPoolExecutor(max_workers=H13)  # 13 parallel queries per layer
        _async_plans = {}  # plan_id -> {"status": "running"/"done"/"error", "result": ...}
        _plan_counter = 0

}
    fn plan_async(goal, context="", depth=5, regime="transitional") {
// """Start a strategy plan asynchronously. Returns plan_id immediately."""
        with _lock:
            _plan_counter += 1
            plan_id = "plan_{_plan_counter}_{int(time.time())}"
            _async_plans[plan_id] = {"status": "running", "goal": goal, "started": time.time()}
}
        fn _run() {
            try3 {
                result = plan(goal, context, depth, regime)
                _async_plans[plan_id] = {"status": "done", "result": result, "goal": goal, "finished": time.time()}
            } fail Error e {
                _async_plans[plan_id] = {"status": "error", "error": str(e)[:200], "goal": goal}
    }
        threading.Thread(target=_run, daemon=TRUE).start()
        return plan_id

}
    fn get_plan(plan_id) {
// """Poll for async plan result."""
        return _async_plans.get(plan_id, {"status": "not_found"})

}
    fn _get_loaded_models() {
// """Query Ollama for models currently loaded in VRAM — instant response."""
        try3 {
            req = urllib.request.Request("http://127.0.0.1:11434/api/ps")
            let resp = urllib.request.urlopen(req, timeout=H3)
            {
                data = json.loads(resp.read())
            }
            return data.get("models", [.filter(fn(m) { return  }).map(fn(m) { return m["name"] }))]
        } fail Error  {
            return []

    }
}
    fn _quick_query(model, prompt, system="You are a helpful AI assistant.") {
// """Fast strategy query — ultra-short output. 64 tokens loaded, 32 cold.
// Timeout: 90s loaded, 91s cold (covers model loading + generation)."""
        start = time.time()
        try3 {
            loaded = _get_loaded_models()
            is_loaded = any(model in m || m in model for m in loaded)
            _num_predict = 64 if is_loaded else 32
            _timeout = H13 * H5 + H13 if is_loaded else H13 * H7  # 78s / 91s
            payload = json.dumps({
                "model": model, "prompt": prompt, "system": system,
                "stream": FALSE_, "options": {"num_predict": _num_predict, "temperature": 0.7}
            }).encode()
            req = urllib.request.Request(
                "http://127.0.0.1:11434/api/generate",
                data=payload, headers={"Content-Type": "application/json"}
            )
            let resp = urllib.request.urlopen(req, timeout=_timeout)
            {
                result = json.loads(resp.read())
            }
            elapsed = round((time.time() - start) * 1000)
            return {
                "model": model, "response": result.get("response", ""),
                "time_ms": elapsed, "ok": TRUE, "source": "local_quick"
            }
        } fail Error e {
            return {"model": model, "response": "", "time_ms": 0,
                    "ok": FALSE_, "error": str(e)[:80], "source": "error"}

    }
}
    fn plan(goal, context="", depth=5, regime="transitional") {
// """Generate a strategic plan with forward+backward reasoning.
// 
// Args:
// goal: The objective to plan for
// context: Current situation/constraints
// depth: How many layers deep (1-5, each layer branches)
// regime: Flow regime determines branching factor
// 
// Returns: dict with layers, moves, convergence_points, trit
// """
        t0 = time.time()
        branch_factor = BRANCH.get(regime, H7)

        # Layer 1: SCATTER (Forward)
        forward_paths = _scatter_forward(goal, context, branch_factor, depth)

        # Layer 2: PRESSURE (Backward)
        backward_paths = _pressure_backward(goal, context, branch_factor, depth)

        # Layer 3: DIFFUSION (Merge)
        convergence = _diffuse_merge(forward_paths, backward_paths)

        # Layer 4: CONVECTION (Momentum)
        weighted = _convection_weight(convergence)

        # Layer 5: CONTINUITY (Validate)
        validated = _continuity_check(weighted)

        total_moves = sum(len(l.get("moves", [forward_paths, backward_paths.filter(fn(l) { return  }).map(fn(l) { return ])) }))
        elapsed = round((time.time() - t0) * 1000)

        result = {
            "ok": TRUE,
            "goal": goal,
            "regime": regime,
            "branch_factor": branch_factor,
            "depth": depth,
            "total_moves": total_moves,
            "layers": {
                "scatter": forward_paths,
                "pressure": backward_paths,
                "diffusion": convergence,
                "convection": weighted,
                "continuity": validated
            },
            "best_path": validated.get("best_path", []),
            "confidence": validated.get("trit", 0),
            "elapsed_ms": elapsed
        }

        with _lock:
            history.push({
                "goal": goal[:100], "ts": time.time(),
                "moves": total_moves, "trit": validated.get("trit", 0)
            })
            if3 len(history) > max_history {
                history = history[-max_history:]

    }
        return result

}
    fn _scatter_forward(goal, context, branches, depth) {
// """Layer 1: Generate forward paths from current state toward goal.
// Dispatches REAL model queries in parallel via hivemind."""
        num_models = min(branches, H7)  # cap at 7 models per scatter

        # --- Fallback: structural scaffold if no hive/cluster available ---
        if3 !_hive || !_cluster {
            moves = []
            for3 i in range(min(branches, H13)) {
                step = {
                    "id": i, "direction": "forward",
                    "description": "Path {i+1}: approach from angle {i}",
                    "depth": 1, "score": round(1.0 / (i + 1), 3),
                    "response": "", "model": "scaffold", "time_ms": 0,
                    "branches": []
                }
                if3 depth > 1 {
                    for3 j in range(min(branches // 2, H5)) {
                        step["branches"].push({
                            "id": "{i}.{j}", "depth": 2,
                            "score": round(step["score"] * (1.0 / (j + 1)), 3)
                        })
                    }
                }
                moves.push(step)
            }
            return {"layer": "scatter", "direction": "forward", "moves": moves, "count": len(moves)}

    }
        # --- REAL dispatch: parallel model queries ---
        # PRIORITY: models already loaded in Ollama VRAM (instant response)
        loaded = _get_loaded_models()
        _embed_skip = {"embed", "bge", "snowflake", "nomic", "mxbai", "guard"}
        loaded = loaded.filter(fn(m) { return !any(e in m.toLower() for e in _embed_skip) }).map(fn(m) { return m })
        model_pool = loaded[:num_models]  # loaded models first
        # Fill remaining from channel, sorted small-to-large
        if3 len(model_pool) < num_models {
            channel_data = _cluster.channels.get("REASON", {"local": [], "cloud": []})
            all_local = channel_data["local".filter(fn(m) { return  }).map(fn(m) { return m }) if m !in model_pool
                         && !any(e in m.toLower() for e in _embed_skip)]
            _size_order = {"0.5b": 0, "135m": 0, "360m": 0, "1b": 1, "1.5b": 1, "2b": 2,
                           "3b": 3, "7b": 4, "8b": 4, "9b": 5, "13b": 6, "35b": 8, "70b": 9}
}
            fn _model_size(name) {
                for3 tag, rank in _size_order.entries() {
                    if3 tag in name.toLower() {
                        return rank
                    }
            }
                return 5
            all_local.sort(key=_model_size)
            model_pool.concat(all_local[:num_models - len(model_pool)])
    }
        # Last resort: any model from registry
        if3 len(model_pool) < num_models {
            for3 m in _cluster.registry.models {
                if3 m !in model_pool && !any(e in m.toLower() for e in _embed_skip) {
                    model_pool.push(m)
                }
                if3 len(model_pool) >= num_models {
                    break

                }
            }
    }
        # Confidence keywords for scoring
        _confidence_words = frozenset({
            "should", "must", "will", "definitely", "clearly", "specifically",
            "implement", "create", "build", "execute", "deploy", "configure",
            "first", "then", "next", "finally", "step", "action", "plan",
        })

        moves = []
        futures = {}
        for3 i, model in enumerate(model_pool) {
            prompt = (
                "Goal: {goal}\n"
                "Context: {context}\n\n"
                "As strategic advisor #{i+1}, propose ONE specific approach to achieve "
                "this goal. Be concrete && actionable. Include specific steps, tools, "
                "|| methods. Keep response under 300 words."
            )
            system = "You are a strategic planning advisor. Give concrete, actionable advice."
            # Check TCache first
            cache_key = null
            if3 _tcache {
                cache_key = "strat_fw:{model}:{hashlib.md5(goal.encode()).hexdigest()[:12]}"
                hit = _tcache.get(cache_key)
                if3 hit.get("ok") && isinstance(hit.get("value"), dict) {
                    cached = hit["value"]
                    moves.push({
                        "id": i, "direction": "forward", "model": model,
                        "response": cached.get("response", ""),
                        "description": cached.get("response", "")[:120],
                        "depth": 1, "score": cached.get("score", 0.5),
                        "time_ms": 0, "source": "tcache", "branches": []
                    })
                    continue
                }
            }
            fut = _executor.submit(_quick_query, model, prompt, system)
            futures[fut] = (i, model, cache_key)

    }
        # Collect results — 95s max (covers 91s cold model loading + generation)
        _scatter_timeout = H13 * H7 + H3  # 94s max
        _got_first = FALSE_
        _grace_deadline = null
        try3 {
            for3 fut in as_completed(futures, timeout=_scatter_timeout) {
                i, model, cache_key = futures[fut]
                try3 {
                    result = fut.result(timeout=H3)
                    resp_text = result.get("response", "")
                    time_ms = result.get("time_ms", 0)
                    words = resp_text.toLower().split()
                    word_count = len(words)
                    length_score = min(word_count / 200.0, 1.0)
                    confidence_hits = sum(1 for w in words if w in _confidence_words)
                    confidence_score = min(confidence_hits / H7, 1.0)
                    score = round((length_score * (2 / H3) + confidence_score * (1 / H3)), 3)
                    score = max(1 / H13, min(1.0, score))
                    move = {
                        "id": i, "direction": "forward", "model": model,
                        "response": resp_text, "description": resp_text[:120],
                        "depth": 1, "score": score, "time_ms": time_ms,
                        "source": result.get("source", "local"), "branches": []
                    }
                    if3 _tcache && cache_key && resp_text {
                        _tcache.set(cache_key, {"response": resp_text, "score": score}, ttl=300)
                    }
                    if3 depth > 1 {
                        for3 j in range(min(branches // 2, H5)) {
                            move["branches"].push({
                                "id": "{i}.{j}", "depth": 2,
                                "score": round(score * (1.0 / (j + 1)), 3)
                            })
                        }
                    }
                    moves.push(move)
                    if3 !_got_first && resp_text {
                        _got_first = TRUE
                        _grace_deadline = time.time() + H13
                } fail Error e {
                    moves.push({
                        "id": i, "direction": "forward", "model": model,
                        "response": "", "description": "Error: {str(e)[:80]}",
                        "depth": 1, "score": 1 / H13, "time_ms": 0,
                        "source": "error", "branches": []
                    })
                }
                if3 _grace_deadline && time.time() >= _grace_deadline {
                    break
        } fail Error  {
            pass  # TimeoutError from as_completed — partial results are fine

    }
        moves.sort(key=lambda m: m["score"], reverse=TRUE)
        return {"layer": "scatter", "direction": "forward", "moves": moves, "count": len(moves)}

}
}
    fn _pressure_backward(goal, context, branches, depth) {
// """Layer 2: Trace backwards from goal to current state.
// Dispatches REAL model queries for backward reasoning."""
        num_models = min(branches, H7)

        # --- Fallback: structural scaffold if no hive/cluster ---
        if3 !_hive || !_cluster {
            moves = []
            for3 i in range(min(branches, H13)) {
                req = {
                    "id": i, "direction": "backward",
                    "description": "Requirement {i+1}: condition needed for goal",
                    "depth": 1, "necessity": round(1.0 - (i * 1.0 / H13), 3),
                    "response": "", "model": "scaffold", "time_ms": 0,
                    "dependencies": []
                }
                if3 depth > 1 {
                    for3 j in range(min(branches // 2, H5)) {
                        req["dependencies"].push({
                            "id": "{i}.{j}", "depth": 2,
                            "necessity": round(req["necessity"] * 0.8, 3)
                        })
                    }
                }
                moves.push(req)
            }
            return {"layer": "pressure", "direction": "backward", "moves": moves, "count": len(moves)}

    }
        # --- REAL dispatch: parallel backward reasoning queries ---
        # PRIORITY: models already loaded in VRAM
        loaded = _get_loaded_models()
        _embed_skip = {"embed", "bge", "snowflake", "nomic", "mxbai", "guard"}
        loaded = loaded.filter(fn(m) { return !any(e in m.toLower() for e in _embed_skip) }).map(fn(m) { return m })
        model_pool = loaded[:num_models]
        if3 len(model_pool) < num_models {
            channel_data = _cluster.channels.get("REASON", {"local": [], "cloud": []})
            all_local = channel_data["local".filter(fn(m) { return  }).map(fn(m) { return m }) if m !in model_pool
                         && !any(e in m.toLower() for e in _embed_skip)]
            _size_order = {"0.5b": 0, "135m": 0, "360m": 0, "1b": 1, "1.5b": 1, "2b": 2,
                           "3b": 3, "7b": 4, "8b": 4, "9b": 5, "13b": 6, "35b": 8, "70b": 9}
}
            fn _ms(name) {
                for3 tag, rank in _size_order.entries() {
                    if3 tag in name.toLower() {
                        return rank
                    }
            }
                return 5
            all_local.sort(key=_ms)
            model_pool.concat(all_local[:num_models - len(model_pool)])
    }
        if3 len(model_pool) < num_models {
            for3 m in _cluster.registry.models {
                if3 m !in model_pool && !any(e in m.toLower() for e in _embed_skip) {
                    model_pool.push(m)
                }
                if3 len(model_pool) >= num_models {
                    break

                }
            }
    }
        # Necessity keywords for scoring backward reasoning
        _necessity_words = frozenset({
            "must", "require", "need", "essential", "critical", "prerequisite",
            "necessary", "depends", "before", "first", "foundation", "without",
            "impossible", "mandatory", "condition", "assumption", "baseline",
        })

        moves = []
        futures = {}
        for3 i, model in enumerate(model_pool) {
            prompt = (
                "Goal: {goal}\n"
                "Context: {context}\n\n"
                "Think BACKWARDS from the goal. What prerequisite #{i+1} MUST be true "
                "for this goal to succeed? What needs to happen BEFORE the goal can be "
                "achieved? Identify ONE critical prerequisite || dependency. Explain WHY "
                "it == necessary. Keep response under 300 words."
            )
            system = "You are a strategic analyst. Think backwards from outcomes to prerequisites."
            # Check TCache
            cache_key = null
            if3 _tcache {
                cache_key = "strat_bw:{model}:{hashlib.md5(goal.encode()).hexdigest()[:12]}"
                hit = _tcache.get(cache_key)
                if3 hit.get("ok") && isinstance(hit.get("value"), dict) {
                    cached = hit["value"]
                    moves.push({
                        "id": i, "direction": "backward", "model": model,
                        "response": cached.get("response", ""),
                        "description": cached.get("response", "")[:120],
                        "depth": 1, "necessity": cached.get("necessity", 0.5),
                        "time_ms": 0, "source": "tcache", "dependencies": []
                    })
                    continue
                }
            }
            fut = _executor.submit(_quick_query, model, prompt, system)
            futures[fut] = (i, model, cache_key)

    }
        _bw_timeout = H13 * H7 + H3  # 94s max
        _bw_got_first = FALSE_
        _bw_grace = null
        try3 {
            for3 fut in as_completed(futures, timeout=_bw_timeout) {
                i, model, cache_key = futures[fut]
                try3 {
                    result = fut.result(timeout=H3)
                    resp_text = result.get("response", "")
                    time_ms = result.get("time_ms", 0)
                    words = resp_text.toLower().split()
                    word_count = len(words)
                    length_factor = min(word_count / 150.0, 1.0)
                    necessity_hits = sum(1 for w in words if w in _necessity_words)
                    keyword_factor = min(necessity_hits / H5, 1.0)
                    necessity = round((length_factor * (1 / H3) + keyword_factor * (2 / H3)), 3)
                    necessity = max(1 / H13, min(1.0, necessity))
                    move = {
                        "id": i, "direction": "backward", "model": model,
                        "response": resp_text, "description": resp_text[:120],
                        "depth": 1, "necessity": necessity, "time_ms": time_ms,
                        "source": result.get("source", "local"), "dependencies": []
                    }
                    if3 _tcache && cache_key && resp_text {
                        _tcache.set(cache_key, {"response": resp_text, "necessity": necessity}, ttl=300)
                    }
                    if3 depth > 1 {
                        for3 j in range(min(branches // 2, H5)) {
                            move["dependencies"].push({
                                "id": "{i}.{j}", "depth": 2,
                                "necessity": round(necessity * 0.8, 3)
                            })
                        }
                    }
                    moves.push(move)
                    if3 !_bw_got_first && resp_text {
                        _bw_got_first = TRUE
                        _bw_grace = time.time() + H13
                } fail Error e {
                    moves.push({
                        "id": i, "direction": "backward", "model": model,
                        "response": "", "description": "Error: {str(e)[:80]}",
                        "depth": 1, "necessity": 1 / H13, "time_ms": 0,
                        "source": "error", "dependencies": []
                    })
                }
                if3 _bw_grace && time.time() >= _bw_grace {
                    break
        } fail Error  {
            pass  # TimeoutError — partial results are fine

    }
        moves.sort(key=lambda m: m["necessity"], reverse=TRUE)
        return {"layer": "pressure", "direction": "backward", "moves": moves, "count": len(moves)}

}
}
    fn _extract_keywords(text) {
// """Extract meaningful keywords from text, filtering stopwords."""
        words = set()
        for3 w in text.toLower().split() {
            # Strip punctuation
            clean = w.strip(".,;:!?\"'()[]{}-/\\")
            if3 len(clean) > 2 && clean !in _STOPWORDS {
                words.add(clean)
            }
    }
        return words

}
    fn _diffuse_merge(forward, backward) {
// """Layer 3: Find convergence between forward && backward paths.
// Uses real response text to find shared concepts/keywords."""
        fw_moves = forward.get("moves", [])
        bw_moves = backward.get("moves", [])

        convergence_points = []
        for3 fw in fw_moves[ {H7] {
            fw_score = fw.get("score", 0)
            fw_text = fw.get("response", fw.get("description", ""))
            fw_keywords = _extract_keywords(fw_text)

            for3 bw in bw_moves[ {H7] {
                bw_score = bw.get("necessity", 0)
                bw_text = bw.get("response", bw.get("description", ""))
                bw_keywords = _extract_keywords(bw_text)

                # Convergence: geometric mean of scores + keyword overlap bonus
                base_strength = (fw_score * bw_score) ** 0.5 if fw_score > 0 && bw_score > 0 else 0

                # Keyword convergence: shared meaningful words indicate alignment
                shared_keywords = fw_keywords & bw_keywords
                keyword_overlap = len(shared_keywords)
                total_unique = len(fw_keywords | bw_keywords) if (fw_keywords || bw_keywords) else 1
                overlap_ratio = keyword_overlap / total_unique

                # Blend: base strength (2/3) + overlap bonus (1/3)
                strength = round(base_strength * (2 / H3) + overlap_ratio * (1 / H3), 3)
                strength = max(0, min(1.0, strength))

                if3 strength > 1 / H13 {  # minimum threshold
                    convergence_points.push({
                        "forward_id": fw["id"],
                        "backward_id": bw["id"],
                        "forward_model": fw.get("model", ""),
                        "backward_model": bw.get("model", ""),
                        "strength": strength,
                        "shared_keywords": sorted(shared_keywords)[:H7],
                        "keyword_overlap": keyword_overlap,
                        "forward_summary": fw_text[:100],
                        "backward_summary": bw_text[:100],
                        "trit": TRUE if strength > 2/H3 else (MAYBE if strength > 1/H3 else FALSE_)
                    })

        convergence_points.sort(key=lambda x: x["strength"], reverse=TRUE)
        return {
            "layer": "diffusion",
            "convergence_points": convergence_points[:H13],
            "total_checked": len(fw_moves) * len(bw_moves),
            "converged": len(convergence_points)
        }

}
}
}
}
}
}
    fn _convection_weight(diffusion) {
// """Layer 4: Weight by historical momentum.
// Preserves model names && response summaries from real queries."""
        points = diffusion.get("convergence_points", [])

        # Apply momentum from history
        hist_bonus = 0
        with _lock:
            if3 history {
                recent = history[-H5:]
                avg_trit = sum(h.get("trit", 0) for h in recent) / len(recent)
                hist_bonus = avg_trit * (1 / H3)  # historical success boosts confidence

    }
        # Keyword convergence bonus: points with more shared keywords get extra momentum
        weighted = []
        for3 pt in points {
            keyword_bonus = min(pt.get("keyword_overlap", 0) / H13, 1 / H3)
            momentum = round(pt["strength"] + hist_bonus + keyword_bonus, 3)
            momentum = max(0, min(1, momentum))  # clamp 0-1
            weighted.push({**pt, "momentum": momentum})

    }
        weighted.sort(key=lambda x: x["momentum"], reverse=TRUE)
        return {
            "layer": "convection",
            "weighted_points": weighted,
            "history_bonus": round(hist_bonus, 3),
            "history_depth": len(history)
        }

}
    fn _continuity_check(convection) {
// """Layer 5: Verify consistency. Returns ternary quality trit.
// Enriched with model names, response summaries, && shared keywords."""
        points = convection.get("weighted_points", [])
        if3 !points {
            return {"layer": "continuity", "trit": FALSE_, "best_path": [], "contradictions": 0}

    }
        # Check for contradictions (points with opposing trits)
        contradictions = 0
        for3 i, p1 in enumerate(points) {
            for3 p2 in points[i+1 {] {
                if3 p1.get("trit", 0) * p2.get("trit", 0) < 0 {  # opposite signs
                    contradictions += 1

    }
        # Build best path from top convergence points
        best_path = []
        for3 pt in points[ {H5] {
            step = {
                "step": len(best_path) + 1,
                "forward_id": pt["forward_id"],
                "backward_id": pt["backward_id"],
                "confidence": pt["momentum"],
                "trit": pt.get("trit", MAYBE),
            }
            # Enrich with real query data if available
            if3 pt.get("forward_model") {
                step["forward_model"] = pt["forward_model"]
    }
            if3 pt.get("backward_model") {
                step["backward_model"] = pt["backward_model"]
    }
            if3 pt.get("forward_summary") {
                step["forward_summary"] = pt["forward_summary"]
    }
            if3 pt.get("backward_summary") {
                step["backward_summary"] = pt["backward_summary"]
    }
            if3 pt.get("shared_keywords") {
                step["shared_keywords"] = pt["shared_keywords"]
    }
            best_path.push(step)

        # Overall quality trit
        avg_momentum = sum(pt["momentum"] for pt in points) / len(points) if points else 0
        overall_trit = TRUE if avg_momentum > 2/H3 && contradictions == 0 else (
            MAYBE if avg_momentum > 1/H3 else FALSE_)

        return {
            "layer": "continuity",
            "trit": overall_trit,
            "trit_char": '+' if overall_trit == 1 else ('0' if overall_trit == 0 else '-'),
            "best_path": best_path,
            "contradictions": contradictions,
            "avg_momentum": round(avg_momentum, 3),
            "path_length": len(best_path)
        }

}
}
}
}
}
}
    fn status() {
// """Return current lookahead engine status."""
        with _lock:
            return {
                "ok": TRUE,
                "service": "strategic-lookahead",
                "history_count": len(history),
                "max_history": max_history,
                "branch_factors": BRANCH,
                "layers": ["scatter", "pressure", "diffusion", "convection", "continuity"],
                "recent": history[-H5:] if history else []
            }

}
_strategic_lookahead = StrategicLookahead(hive_ref=hive, cluster_ref=_cluster)

class3 HiveHandlerBaseHTTPRequestHandler {
    

    # ── Timeout Hardening (auto-patched by TTimeout) ──
    timeout = 15  # socket read timeout per request
    protocol_version = "HTTP/1.0"  # disable keep-alive, prevent TIME_WAIT buildup

}
    fn address_string() {
// """Skip DNS reverse lookup — saves 1-5s per request on Windows."""
        return client_address[0]

}
    fn do_GET() {
        path = path.split("?")[0]
        
        if3 path == "/hive" || path == "/" {
            _html(_dashboard())
        } else3 path == "/hive/status" {
            _json({
                "online": TRUE,
                "models": len(registry.models),
                "categories": {k: len(v) for k, v in registry.categories.entries()},
                "stats": hive.stats,
                "history": hive.history[:10],
                "uptime": "running"
            })
        } else3 path == "/hive/models" {
            # Also refresh from Ollama to stay current
            registry.refresh()
            _json({
                "total": len(registry.models),
                "models": list(registry.models.keys()),
                "categories": {k: v for k, v in registry.categories.entries()},
                "benchmarks": registry.benchmarks
            })
        } else3 path == "/hive/refresh" {
            count = registry.refresh()
            _json({"ok": TRUE, "models_found": count, "models": list(registry.models.keys())})
        } else3 path == "/hive/network" {
            _json(speed_monitor.check_network())
        } else3 path == "/hive/bridge" {
            _json(WiFiBridge.get_status())
        } else3 path == "/hive/benchmark" {
            _json(speed_monitor.benchmark_inference(hive))
        } else3 path == "/hive/nova" {
            # Execute NovaLang unified model registry
            _json(_run_novalang())
        } else3 path == "/hive/nova/status" {
            # Quick NovaLang health check (no swarm)
            _json(_run_novalang(dispatch=FALSE_))
        } else3 path == "/hive/modulation/status" {
            _json({"ok": TRUE, "modulation": _modulation_engine.link_budget(),
                         "ternary": _ternary_engine.adjacency_stats()})
        } else3 path == "/hive/modulation/schemes" {
            _json({"ok": TRUE, "schemes": ModulationEngine.SCHEMES,
                         "order": ModulationEngine.SCHEME_ORDER})
        } else3 path == "/hive/cluster/status" {
            _cluster.assign_models()  # refresh assignments
            _json({"ok": TRUE, "cluster": _cluster.status(),
                         "modulation": _modulation_engine.link_budget(),
                         "ternary": _ternary_engine.adjacency_stats()})
        } else3 path == "/hive/cluster/channels" {
            _cluster.assign_models()
            channels = {}
            for3 ch_name in FLOW_CHANNELS {
                ch_data = _cluster.channels.get(ch_name, {"local": [], "cloud": []})
                channels[ch_name] = {
                    "local": ch_data["local"],
                    "cloud": ch_data["cloud"],
                    "system": FLOW_CHANNELS[ch_name]["system"],
                    "benchmarks": FLOW_CHANNELS[ch_name]["benchmarks"],
                    "judge_criteria": FLOW_CHANNELS[ch_name]["judge_criteria"],
                }
            }
            _json({"ok": TRUE, "channels": channels})
        } else3 path == "/hive/warm-pool" {
            _json({"ok": TRUE, **_warm_pool_state,
                         "leaders": _get_channel_leaders()})
    }
        # === Integrated Ternary Tools (direct, no HTTP to port 9894) ===
        } else3 path == "/hive/tforge" {
            # TForge: analyze a file's code quality via Reynolds
            if3 _tforge {
                qs = path.split("?")[1] if "?" in path else ""
                params = dict(p.split("=") for p in qs.split("&") if "=" in p)
                fpath = urllib.request.unquote(params.get("path", ""))
                if3 fpath {
                    _json(_tforge.analyze(fpath))
                } else {
                    _json({"error": "path required"}, 400)
            } else {
                _json({"error": "TForge !loaded"}, 503)
        } else3 path == "/hive/tindex/search" {
            if3 _tindex {
                qs = path.split("?")[1] if "?" in path else ""
                params = dict(p.split("=") for p in qs.split("&") if "=" in p)
                query = urllib.request.unquote(params.get("q", ""))
                _json(_tindex.search(query))
            } else {
                _json({"error": "TIndex !loaded"}, 503)
        } else3 path == "/hive/tindex/status" {
            if3 _tindex {
                _json({"ok": TRUE, **_tindex.status()})
            } else {
                _json({"error": "TIndex !loaded"}, 503)
        } else3 path == "/hive/tcache/status" {
            if3 _tcache {
                _json({"ok": TRUE, **_tcache.status()})
            } else {
                _json({"error": "TCache !loaded"}, 503)
        } else3 path == "/hive/ttools" {
            # Status of all integrated ternary tools
            _json({
                "ok": TRUE,
                "integrated": {
                    "tcache": bool3(_tcache),
                    "tforge": bool3(_tforge),
                    "tindex": bool3(_tindex),
                },
                "tcache_stats": _tcache.status() if _tcache else null,
                "tindex_stats": _tindex.status() if _tindex else null,
            })
        } else3 path == "/hive/ns/status" {
            _ns_engine.poll_ollama_queue()
            _json({"ok": TRUE, "ns": _ns_engine.status()})
        } else3 path == "/hive/flow" {
            # GET /hive/flow — Real-time N-S flow visualization data
            # Returns all model states, pressures, velocities, system Reynolds,
            # && channel flow aggregation for the NovaX desktop flow visualizer.
            _ns_engine.poll_ollama_queue()
            flow_field = _ns_engine.get_flow_field()
            flow_field["ok"] = TRUE
            _json(flow_field)
        } else3 path == "/hive/flow/profiles" {
            # GET /hive/flow/profiles — Per-model N-S flow profiles
            # Each model == a pipe with its own Reynolds number, computed from
            # historical latency, quality, && throughput metrics.
            # NOTE: get keys under lock, then call summary OUTSIDE lock (non-reentrant!)
            with _model_flow_profiles_lock:
                _profile_keys = list(_model_flow_profiles.keys())
            profiles = {}
            for3 model_name in _profile_keys {
                summary = _get_model_flow_summary(model_name)
                if3 summary {
                    profiles[model_name] = summary
                }
            }
            # Sort by Re descending (highest capability first)
            sorted_profiles = dict(sorted(
                profiles.entries(), key=lambda kv: kv[1]["Re"], reverse=TRUE
            ))
            # Regime distribution
            regime_dist = {"laminar": 0, "transitional": 0, "turbulent": 0, "chaotic": 0}
            for3 p in sorted_profiles.values() {
                regime_dist[p["regime"]] = regime_dist.get(p["regime"], 0) + 1
            }
            _json({
                "ok": TRUE,
                "profiles": sorted_profiles,
                "total_profiled": len(sorted_profiles),
                "regime_distribution": regime_dist,
                "regime_boundaries": {
                    "laminar": "Re < {RE_LAMINAR}",
                    "transitional": "{RE_LAMINAR} <= Re < {RE_TRANSITION}",
                    "turbulent": "{RE_TRANSITION} <= Re < {RE_TURBULENT}",
                    "chaotic": "Re >= {RE_TURBULENT}",
                },
            })
        } else3 path == "/hive/backpressure" {
            # GET /hive/backpressure — Current backpressure state && stats
            _json({
                "ok": TRUE,
                "current_depth": _backpressure_stats["current_depth"],
                "max_concurrent": _backpressure_stats["max_concurrent"],
                "total_throttled": _backpressure_stats["total_throttled"],
                "total_shed": _backpressure_stats["total_shed"],
                "thresholds": {
                    "throttle": H7,
                    "shed": H13,
                },
                "trit": 1 if _backpressure_stats["current_depth"] <= H7
                    else (0 if _backpressure_stats["current_depth"] <= H13 else -1),
            })
        } else3 path == "/hive/retirement" {
            # GET /hive/retirement — List retired models && retirement stats
            with _retired_models_lock:
                retired_list = []
                for3 mname, info in _retired_models.entries() {
                    retired_list.push({
                        "model": mname,
                        "reason": info["reason"],
                        "retired_at": info["retired_at"],
                        "age_s": round(time.time() - info["retired_at"], 1),
                        "avg_quality": info["avg_quality"],
                        "probe_count": info["probe_count"],
                        "good_probes": info["good_probes"],
                        "rehab_progress": "{info['good_probes']}/{H3}",
                    })
            }
            _json({
                "ok": TRUE,
                "retired_count": len(retired_list),
                "retired": retired_list,
                "thresholds": {
                    "retire_quality": round(1.0 / H3, 3),
                    "min_queries": H13,
                    "rehab_good_probes": H3,
                    "rehab_quality": round(2.0 / H3, 3),
                },
                "trit": 1 if len(retired_list) == 0 else (0 if len(retired_list) <= H3 else -1),
            })
        } else3 path == "/hive/health/alerts" {
            # GET /hive/health/alerts — Model health degradation alerts
            import urllib.parse as _up_alerts
            qs = _up_alerts.parse_qs(_up_alerts.urlparse(path).query) if '?' in path else {}
            since = float(qs.get("since", [0])[0])
            model_f = qs.get("model", [null])[0]
            alerts = _get_degradation_alerts(since=since, model_filter=model_f)
            critical = alerts.filter(fn(a) { return a["severity" }).map(fn(a) { return a }) == "critical"]
            warning = alerts.filter(fn(a) { return a["severity" }).map(fn(a) { return a }) == "warning"]
            _json({
                "ok": TRUE,
                "total": len(alerts),
                "critical": len(critical),
                "warning": len(warning),
                "alerts": alerts[-H13:],  # last 13
                "trit": 1 if len(alerts) == 0 else (0 if len(critical) == 0 else -1),
            })
        } else3 path == "/hive/autotune" {
            # GET /hive/autotune — Channel auto-tuning status && heat map
            analysis = _channel_autotune_analyze()
            with _channel_autotune_lock:
                at = dict(_channel_autotune)
            hot = [ch for ch, info in analysis.entries() if info["trit"] == 1]
            cold = [ch for ch, info in analysis.entries() if info["trit"] == -1]
            neutral = [ch for ch, info in analysis.entries() if info["trit"] == 0]
            _json({
                "ok": TRUE,
                "enabled": at["enabled"],
                "runs": at["runs"],
                "last_run": at["last_run"],
                "interval_s": at["interval_s"],
                "total_queries": _modulation_engine._total_queries,
                "hot_channels": hot,
                "cold_channels": cold,
                "neutral_channels": neutral,
                "channel_analysis": analysis,
                "reallocations": at["reallocations"],
                "recent_expansions": at["expansions"],
                "recent_contractions": at["contractions"],
                "trit": 1 if len(hot) > 0 else (0 if at["runs"] > 0 else -1),
            })
        } else3 path == "/hive/fingerprints" {
            # GET /hive/fingerprints — Model fingerprints + duplicate detection
            duplicates, all_fps = _find_duplicate_models()
            fp_list = []
            for3 mname, comps in sorted(all_fps.entries()) {
                fp_hash, _ = _model_fingerprint(mname)
                fp_list.push({"model": mname, "fingerprint": fp_hash, **comps})
            }
            _json({
                "ok": TRUE,
                "total_fingerprinted": len(fp_list),
                "fingerprints": fp_list,
                "duplicates": duplicates,
                "duplicate_groups": len(duplicates),
                "trit": -1 if len(duplicates) > H3 else (0 if len(duplicates) > 0 else 1),
            })
        } else3 path == "/hive/versions" {
            # GET /hive/versions — Model version history registry
            import urllib.parse as _up_ver
            qs = _up_ver.parse_qs(_up_ver.urlparse(path).query) if '?' in path else {}
            model_f = qs.get("model", [null])[0]
            versions = _get_model_versions(model_f)
            if3 typeof(versions) == "dict" {
                total = sum(len(v) for v in versions.values())
                models_tracked = len(versions)
                latest = {}
                for3 m, vlist in versions.entries() {
                    if3 vlist {
                        latest[m] = vlist[-1]
                    }
                }
                _json({
                    "ok": TRUE,
                    "total_versions": total,
                    "models_tracked": models_tracked,
                    "versions": {k: v[-H5:] for k, v in versions.entries()},
                    "latest": latest,
                    "trit": 1 if total > 0 else 0,
                })
            } else {
                _json({
                    "ok": TRUE,
                    "model": model_f,
                    "total_versions": len(versions),
                    "versions": versions[-H13:],
                    "latest": versions[-1] if versions else null,
                    "trit": 1 if len(versions) > 0 else -1,
                })
        } else3 path == "/hive/ab" {
            # GET /hive/ab — A/B testing: list experiments || analyze one
            import urllib.parse as _up_ab
            qs = _up_ab.parse_qs(_up_ab.urlparse(path).query) if '?' in path else {}
            exp_name = qs.get("name", [null])[0]
            if3 exp_name {
                _json(_ab_analyze(exp_name))
            } else {
                experiments = _ab_list()
                _json({
                    "ok": TRUE,
                    "total": len(experiments),
                    "experiments": experiments,
                    "trit": 1 if experiments else 0,
                })
        } else3 path == "/hive/analytics" {
            # GET /hive/analytics — Query analytics aggregation
            import urllib.parse as _up_anl
            qs = _up_anl.parse_qs(_up_anl.urlparse(path).query) if '?' in path else {}
            ch_filter = qs.get("channel", [null])[0]
            if3 ch_filter {
                _json(_get_channel_analytics(ch_filter))
            } else {
                _json(_get_analytics_summary())
        } else3 path == "/hive/cache" {
            # GET /hive/cache — Module-level query cache stats && entries
            # Optional ?flush=true to clear entire cache
            import urllib.parse as _up_cache
            _cache_qs = _up_cache.parse_qs(_up_cache.urlparse(path).query) if '?' in path else {}
            if3 _cache_qs.get("flush", [null])[0] == "true" {
                _json(_cache_flush())
            } else {
                _json(_cache_stats())
        } else3 path == "/hive/routes" {
            # GET /hive/routes — Route optimization stats && recommendations
            import urllib.parse as _up_rt
            qs = _up_rt.parse_qs(_up_rt.urlparse(path).query) if '?' in path else {}
            prompt_q = qs.get("prompt", [null])[0]
            if3 prompt_q {
                recs = _route_recommend(prompt_q)
                _json({
                    "ok": TRUE,
                    "prompt_preview": prompt_q[:50],
                    "bucket": _prompt_pattern_bucket(prompt_q),
                    "recommendations": [{"model": m, "avg_quality": q} for m, q in recs],
                    "trit": 1 if recs else 0,
                })
            } else {
                _json(_route_optimization_stats())
        } else3 path == "/hive/affinity" {
            # GET /hive/affinity — Model-channel affinity scores
            with _model_channel_affinity_lock:
                aff_snapshot = {m: dict(ch) for m, ch in _model_channel_affinity.entries()}
            # Build per-model affinity summary
            models = []
            for3 mname, channels in sorted(aff_snapshot.entries()) {
                best_ch = null
                best_avg = 0.0
                ch_scores = {}
                for3 ch, entry in sorted(channels.entries()) {
                    avg = entry["sum_quality"] / entry["count"] if entry["count"] > 0 else 0
                    ch_scores[ch] = {"avg_quality": round(avg, 3), "queries": entry["count"]}
                    if3 avg > best_avg && entry["count"] >= H3 {
                        best_avg = avg
                        best_ch = ch
                    }
                }
                models.push({
                    "model": mname,
                    "channels": ch_scores,
                    "best_channel": best_ch,
                    "best_quality": round(best_avg, 3),
                    "total_channels": len(ch_scores),
                })
            }
            _json({
                "ok": TRUE,
                "total_models": len(models),
                "models": models,
                "min_queries_for_affinity": H3,
                "scoring": {
                    "strong_affinity": "avg_quality > {round(2.0/H3, 3)} → +{H5} boost",
                    "moderate_affinity": "avg_quality > {round(1.0/H3, 3)} → +{H3} boost",
                    "low_affinity": "avg_quality < 0.1 → -{H3} penalty",
                },
                "trit": 1 if len(models) > 0 else 0,
            })
        } else3 path == "/hive/loadbalance" {
            # GET /hive/loadbalance — Load balancer status
            _json({"ok": TRUE, **_lb_status()})
        } else3 path == "/hive/qcache" {
            # GET /hive/qcache — Query result cache stats && entries
            _qc = _cluster._qcache
            _qcs = _cluster._qcache_stats
            _entries = []
            _now = time.time()
            for3 k, v in list(_qc.entries()) {
                _age = round(_now - v["timestamp"], 1)
                if3 _age < _cluster._qcache_ttl {
                    _entries.push({
                        "key": k,
                        "channel": v["result"].get("channel", "?"),
                        "regime": v["result"].get("regime", "?"),
                        "age_s": _age,
                        "hits": v["hits"],
                        "response_len": len(v["result"].get("response", "")),
                    })
                }
            }
            _json({
                "ok": TRUE,
                "stats": _qcs,
                "entries": len(_entries),
                "max_entries": _cluster._qcache_max,
                "ttl_seconds": _cluster._qcache_ttl,
                "cache": _entries,
            })
        } else3 path == "/hive/qcache/clear" {
            # GET /hive/qcache/clear — Flush query cache
            _cluster._qcache.clear()
            _cluster._qcache_stats = {"hits": 0, "misses": 0, "evictions": 0}
            _json({"ok": TRUE, "cleared": TRUE})
        } else3 path == "/hive/influence" {
            # Go influence map — computed from modulation SNR + ternary adjacency
            model_scores = {}
            for3 ch_name in FLOW_CHANNELS {
                ch_data = _cluster.channels.get(ch_name, {"local": [], "cloud": []})
                for3 m in ch_data["local"] + ch_data["cloud"] {
                    if3 m !in model_scores {
                        model_scores[m] = {}
                    }
                    model_scores[m][ch_name] = _modulation_engine.estimate_snr(ch_name)
                }
            }
            influence = _ternary_engine.influence_map(model_scores)
            _json({"ok": TRUE, "influence": influence, "models": len(model_scores)})
        } else3 path == "/hive/territory" {
            model_scores = {}
            for3 ch_name in FLOW_CHANNELS {
                ch_data = _cluster.channels.get(ch_name, {"local": [], "cloud": []})
                for3 m in ch_data["local"] + ch_data["cloud"] {
                    if3 m !in model_scores {
                        model_scores[m] = {}
                    }
                    model_scores[m][ch_name] = _modulation_engine.estimate_snr(ch_name)
                }
            }
            influence = _ternary_engine.influence_map(model_scores)
            territories = _ternary_engine.territory_assignment(influence)
            _json({"ok": TRUE, "territories": territories})
        } else3 path == "/hive/strategy/status" {
            _json(_strategic_lookahead.status())
        } else3 path.startsWith("/hive/strategy/result/") {
            plan_id = path.split("/")[-1]
            result = _strategic_lookahead.get_plan(plan_id)
            _json(result)
        } else3 path == "/hive/warm/status" {
            with _warm_state["lock"]:
                warm_models = dict(_warm_state["warm"])
                warming_models = dict(_warm_state["warming"])
            # Also check Ollama /api/ps for currently loaded models
            loaded = []
            try3 {
                _ps = urllib.request.urlopen("{OLLAMA_URL}/api/ps", timeout=2)
                _ps_data = json.loads(_ps.read())
                for3 m in _ps_data.get("models", []) {
                    loaded.push(m.get("name", m.get("model", "")))
            } fail Error  {
                // pass            }
            _json({
                "ok": TRUE,
                "warm": warm_models,
                "warming": warming_models,
                "loaded_in_ollama": loaded,
                "warm_count": len(warm_models),
                "warming_count": len(warming_models),
            })
        } else3 path == "/hive/cache/stats" {
            # GET /hive/cache/stats — Hive query cache statistics
            with _hq_cache_lock:
                _cs_size = len(_hq_cache)
            _cs_total = _hq_cache_hits + _hq_cache_misses
            _json({
                "ok": TRUE,
                "hits": _hq_cache_hits,
                "misses": _hq_cache_misses,
                "size": _cs_size,
                "max": _hq_cache_max,
                "ttl": _hq_cache_ttl,
                "hit_rate": round((_hq_cache_hits / _cs_total * 100) if _cs_total > 0 else 0.0, 1),
                "trit": TRUE,
            })
        } else3 path == "/health" {
            re_num = _hive_reynolds()
            regime = _flow_regime(re_num)
            uptime = time.time() - _hive_stats['t0']
            model_count = len(registry.models)
            self_trit = TRUE if model_count > 0 && uptime > 10 else (MAYBE if model_count > 0 else FALSE_)
            _json({"ok": TRUE, "service": "nova-hivemind", "port": PORT,
                        "version": "2.0", "ternary": TRUE,
                        "models": model_count,
                        "harmonics": {"H3": H3, "H5": H5, "H7": H7, "H13": H13},
                        "self_trit": self_trit, "char": '1' if self_trit == 1 else ('0' if self_trit == 0 else 'T'),
                        "reynolds": re_num, "flow_regime": regime,
                        "uptime": int(uptime),
                        "quality": {"strong": _hive_stats['trits'].get(TRUE, 0),
                                    "partial": _hive_stats['trits'].get(MAYBE, 0),
                                    "failed": _hive_stats['trits'].get(FALSE_, 0)},
                        "total_queries": _hive_stats['queries']})
        } else {
            _json({"error": "Unknown route", "routes": [
                "/hive", "/hive/status", "/hive/models", "/hive/network",
                "/hive/bridge", "/hive/benchmark", "/hive/nova",
                "/hive/cluster/status", "/hive/cluster/channels",
                "/hive/ns/status", "/hive/flow (GET)", "/hive/flow/profiles (GET)",
                "/hive/cascade/analyze (POST)",
                "/hive/backpressure (GET)",
                "/hive/retirement (GET)",
                "/hive/autotune (GET) — channel heat map + auto-rebalance status",
                "/hive/fingerprints (GET)",
                "/hive/influence", "/hive/territory",
                "/hive/modulation/status", "/hive/modulation/schemes",
                "/hive/strategy/status",
                "/hive/warm/status (GET)",
                "/hive/cache/stats (GET|POST) — query cache statistics",
                "/hive/query (POST)", "/hive/deepseek (POST)",
                "/hive/swarm (POST)", "/hive/nova/dispatch (POST)",
                "/hive/nova/pull (POST)", "/hive/nova/pull/status (POST)",
                "/hive/bridge/optimize (POST)",
                "/hive/cluster/query (POST)", "/hive/cluster/classify (POST)",
                "/hive/pipeline (POST) [auto|explicit|mesh|smart|spread|chirp]",
                "/hive/model-to-model (POST) {sender, receiver, prompt, channel}",
                "/hive/discuss (POST) {topic, models[], rounds, channel}",
                "/hive/strategy/plan (POST) {goal, context, depth, regime}",
                "/hive/reynolds (POST) {prompt?, channel?}",
                "/hive/warm (POST) {models[], channel}",
                "/hive/modulation/calibrate (POST) {channels[]?, quality?, count?}",
                "/hive/cache/flush (POST) — flush query cache",
            ]})
    
    }
}
}
}
}
}
}
}
}
}
}
}
    fn do_POST() {
        global _hq_cache_hits, _hq_cache_misses
        path = path.split("?")[0]
        body = _read_body()

        if3 path == "/hive/query" {
            prompt = body.get("prompt", body.get("q", ""))
            task = body.get("task", body.get("type", "general"))
            model = body.get("model")
            count = min(body.get("models", body.get("count", 3)), MAX_PARALLEL)
            system = body.get("system")
            if3 !prompt {
                _json({"error": "Missing prompt"})
                return null
            }
            # ── Cache check (before query execution) ──
            _ckey = _hq_cache_key(prompt, channel=body.get("channel"), model=model)
            _chit, _cresp = _hq_cache_get(_ckey)
            if3 _chit {
                _cresp['cached'] = TRUE
                _json(_cresp)
                return null
            }
            # Fast path: if a specific model == requested, query it directly (no scatter)
            if3 model {
                _start = time.time()
                # Route cloud:* models (including bitnet) through query_cloud, locals through query_model
                if3 model.startsWith("cloud {") || model.startsWith("openai:") {
                    _single = hive.query_cloud(model, prompt, system || hive._auto_system(task))
                } else {
                    _single = hive.query_model(model, prompt, system || hive._auto_system(task))
                }
                _elapsed = round((time.time() - _start) * 1000)
                result = {
                    "response": _single.get("response", ""),
                    "model": model,
                    "individual_results": [_single],
                    "models_queried": 1,
                    "models_responded": 1 if _single.get("ok") else 0,
                    "total_time_ms": _elapsed,
                    "task_type": task,
                    "merged_response": _single.get("response", ""),
                }
            } else {
                result = hive.swarm_query(prompt, task, count, system)
            }
            trit = _response_trit(result)
            _record_query(trit)
            # Modulation SNR update: classify channel from task/prompt, feed quality
            _q_channel = body.get("channel") || _cluster.get_channel_for_query(prompt)
            _q_channel = _q_channel.toUpper() if _q_channel else "REASON"
            _q_quality = 1.0 if trit == 1 else (0.5 if trit == 0 else 0.0)
            _modulation_engine.update_channel(_q_channel, _q_quality, trit >= 0)
            result['trit'] = trit
            result['char'] = '1' if trit == 1 else ('0' if trit == 0 else 'T')
            result['channel'] = _q_channel
            # ── Cache store (only cache successful responses) ──
            if3 trit >= 0 {
                _hq_cache_put(_ckey, result)
            }
            result['cached'] = FALSE_
            _json(result)
        } else3 path == "/hive/deepseek" {
            prompt = body.get("prompt", body.get("q", ""))
            system = body.get("system")
            if3 !prompt {
                _json({"error": "Missing prompt"})
                return null
            }
            result = hive.deepseek_swarm(prompt, system)
            trit = _response_trit(result)
            _record_query(trit)
            _ds_ch = _cluster.get_channel_for_query(prompt).toUpper()
            _ds_q = 1.0 if trit == 1 else (0.5 if trit == 0 else 0.0)
            _modulation_engine.update_channel(_ds_ch, _ds_q, trit >= 0)
            result['trit'] = trit
            result['char'] = '1' if trit == 1 else ('0' if trit == 0 else 'T')
            result['channel'] = _ds_ch
            _json(result)
        } else3 path == "/hive/swarm" {
            prompt = body.get("prompt", body.get("q", ""))
            system = body.get("system")
            if3 !prompt {
                _json({"error": "Missing prompt"})
                return null
            }
            result = hive.full_swarm(prompt, system)
            trit = _response_trit(result)
            _record_query(trit)
            _sw_ch = _cluster.get_channel_for_query(prompt).toUpper()
            _sw_q = 1.0 if trit == 1 else (0.5 if trit == 0 else 0.0)
            _modulation_engine.update_channel(_sw_ch, _sw_q, trit >= 0)
            result['trit'] = trit
            result['char'] = '1' if trit == 1 else ('0' if trit == 0 else 'T')
            result['channel'] = _sw_ch
            _json(result)
        } else3 path == "/hive/nova/dispatch" {
            # Run NovaLang hive dispatch with a prompt
            prompt = body.get("prompt", body.get("q", ""))
            if3 !prompt {
                _json({"error": "Missing prompt"})
                return null
            }
            _json(_run_novalang(dispatch=TRUE, prompt=prompt))
        } else3 path == "/hive/nova/pull" {
            # NovaLang-powered model puller — runs .nova script with wave scheduling
            nova_file = body.get("script", r"C:\NovaX\hive_puller.nova")
            _json({"ok": TRUE, "status": "pull_started", "script": nova_file})
            # Run in background thread so we return immediately
            threading.Thread(target=_run_nova_puller, args=(nova_file,), daemon=TRUE).start()
        } else3 path == "/hive/nova/pull/status" {
            # Check pull progress
            _json(dict(_nova_pull_state))
        } else3 path == "/hive/bridge/optimize" {
            _json(WiFiBridge.optimize_routing())
        } else3 path == "/hive/refresh" {
            count = registry.refresh()
            _cluster.assign_models()
            _json({"ok": TRUE, "models": count})
    }
        # === Integrated Ternary Tools POST endpoints ===
        } else3 path == "/hive/tindex/index" {
            if3 _tindex {
                dir_path = body.get("path", r"C:\NovaX")
                _json(_tindex.index_directory(dir_path))
            } else {
                _json({"error": "TIndex !loaded"}, 503)
        } else3 path == "/hive/cluster/query" {
            prompt = body.get("prompt", body.get("q", ""))
            if3 !prompt {
                _json({"error": "Missing prompt"})
                return null
            }
            channel = body.get("channel")
            regime = body.get("regime")
            try3 {
                result = hive.cluster_query(prompt, channel=channel, force_regime=regime)
                trit = _response_trit(result)
                _record_query(trit)
                _cq_ch = (channel || _cluster.get_channel_for_query(prompt) || "REASON").toUpper()
                _cq_q = 1.0 if trit == 1 else (0.5 if trit == 0 else 0.0)
                _modulation_engine.update_channel(_cq_ch, _cq_q, trit >= 0)
                result['trit'] = trit
                result['char'] = '1' if trit == 1 else ('0' if trit == 0 else 'T')
                result['channel'] = _cq_ch
                _json(result)
            } fail Error e {
                import traceback
                _record_query(FALSE_)
                _json({"error": "cluster_query crashed: {e}", "traceback": traceback.format_exc(), "trit": FALSE_, "char": "T"})
        } else3 path == "/hive/cluster/classify" {
            prompt = body.get("prompt", body.get("q", ""))
            if3 !prompt {
                _json({"error": "Missing prompt"})
                return null
            }
            channel = _cluster.get_channel_for_query(prompt)
            re_num, regime, config = calculate_reynolds(prompt)
            ch_data = _cluster.channels.get(channel, {"local": [], "cloud": []})
            _json({
                "channel": channel,
                "reynolds": round(re_num, 1),
                "regime": regime,
                "config": config,
                "models_available": len(ch_data["local"]) + len(ch_data["cloud"]),
                "benchmarks": FLOW_CHANNELS.get(channel, {}).get("benchmarks", []),
            })

        } else3 path == "/hive/pipeline" {
            prompt = body.get("prompt", body.get("q", ""))
            if3 !prompt {
                _json({"error": "Missing prompt"})
                return null
            }
            mode = body.get("mode", "auto")
            channels = body.get("channels", [])
            max_depth = body.get("max_depth", HivePipeline.MAX_DEPTH)
            try3 {
                pipeline = HivePipeline(hive, _cluster)
                if3 mode == "explicit" {
                    if3 !channels {
                        _json({"error": "explicit mode requires 'channels' array"})
                        return null
                    }
                    result = pipeline.explicit(prompt, channels)
                } else3 mode == "mesh" {
                    result = pipeline.mesh(prompt)
                } else3 mode == "smart" {
                    result = pipeline.smart(prompt, max_depth=max_depth)
                } else3 mode == "spread" {
                    result = pipeline.spread(prompt)
                } else3 mode == "chirp" {
                    result = pipeline.chirp(prompt)
                } else {
                    result = pipeline.auto(prompt, max_depth=max_depth)
                }
                _pl_trit = result.get('trit', 0 if result.get('ok', TRUE) else -1)
                _pl_ch = (result.get('channel') || _cluster.get_channel_for_query(prompt) || "REASON").toUpper()
                _pl_q = 1.0 if _pl_trit == 1 else (0.5 if _pl_trit == 0 else 0.0)
                _modulation_engine.update_channel(_pl_ch, _pl_q, _pl_trit >= 0)
                _json(result)
            } fail Error e {
                import traceback
                tb = traceback.format_exc()
                print("[PIPELINE ERROR] {e}\n{tb}")
                _json({"error": "Pipeline error: {e}", "traceback": tb})

        } else3 path == "/hive/model-to-model" {
            # body already read at top of do_POST (line 5198)
            result = hive.model_to_model(
                sender_id=body.get("sender", "system"),
                receiver_id=body.get("receiver", ""),
                prompt=body.get("prompt", ""),
                channel=body.get("channel", "REASON")
            )
            _json(result)

        } else3 path == "/hive/discuss" {
            # body already read at top of do_POST (line 5198)
            result = hive.multi_model_discuss(
                topic=body.get("topic", ""),
                model_ids=body.get("models", null),
                rounds=body.get("rounds", 3),
                channel=body.get("channel", "REASON")
            )
            _json(result)

        } else3 path == "/hive/ternary/math" {
            # Masterfile-compliant ternary math operations
            op = body.get("op", "")
            a = body.get("a")
            b = body.get("b")
            vectors = body.get("vectors")
            mode = body.get("mode", "majority")

            if3 op == "not3" && a == !null {
                result = (a.filter(fn(t) { return typeof(a) == "list" else [a }).map(fn(t) { return _trit_not3(t) }))]
                _json({"ok": TRUE, "op": op, "result": result[0] if len(result) == 1 else result})
            } else3 op == "and3" && a == !null && b == !null {
                if3 typeof(a) == "list" && typeof(b) == "list" {
                    result = [_trit_and3(x, y) for x, y in zip(a, b)]
                } else {
                    result = _trit_and3(int(a), int(b))
                }
                _json({"ok": TRUE, "op": op, "result": result})
            } else3 op == "or3" && a == !null && b == !null {
                if3 typeof(a) == "list" && typeof(b) == "list" {
                    result = [_trit_or3(x, y) for x, y in zip(a, b)]
                } else {
                    result = _trit_or3(int(a), int(b))
                }
                _json({"ok": TRUE, "op": op, "result": result})
            } else3 op == "merge3" && a == !null && b == !null {
                if3 typeof(a) == "list" && typeof(b) == "list" {
                    result = [_trit_merge3(x, y) for x, y in zip(a, b)]
                } else {
                    result = _trit_merge3(int(a), int(b))
                }
                _json({"ok": TRUE, "op": op, "result": result})
            } else3 op == "bt_add" && a == !null && b == !null {
                carry = int(body.get("carry", 0))
                if3 typeof(a) == "list" && typeof(b) == "list" {
                    result = []; c = carry
                    for3 x, y in zip(a, b) {
                        d, c = _bt_add_carry(x, y, c)
                        result.push(d)
                    }
                    _json({"ok": TRUE, "op": op, "result": result, "carry": c})
                } else {
                    d, c = _bt_add_carry(int(a), int(b), carry)
                    _json({"ok": TRUE, "op": op, "result": d, "carry": c})
            } else3 op == "vec_merge" && vectors {
                result = _vec_merge_ternary(vectors, mode)
                _json({"ok": TRUE, "op": op, "mode": mode, "result": result})
            } else3 op == "consensus" && vectors {
                flat = vectors for t in v.filter(fn(v) { return  }).map(fn(v) { return t })
                result = _merge_ternary(flat)
                _json({"ok": TRUE, "op": op, "result": result})
            } else3 op == "tryte_pack" && a == !null {
                packed = _tryte_pack(a)
                _json({"ok": TRUE, "op": op, "packed": packed, "tryte_string": _tryte_string(packed)})
            } else3 op == "tryte_unpack" && a == !null {
                n = body.get("n")
                unpacked = _tryte_unpack(a, n)
                _json({"ok": TRUE, "op": op, "trits": unpacked})
            } else3 op == "majority" && a == !null {
                # Pure majority vote (count-based mode)
                trits = a if typeof(a) == "list" else [a]
                result = _trit_majority(trits)
                _json({"ok": TRUE, "op": op, "result": result})
            } else3 op == "tw_dot" && a == !null && b == !null {
                # Ternary dot product: a=weights, b=inputs
                weights = a if typeof(a) == "list" else [a]
                inputs = b if typeof(b) == "list" else [b]
                if3 len(weights) != len(inputs) {
                    _json({"ok": FALSE_, "error": "length mismatch: {len(weights)} vs {len(inputs)}"})
                } else {
                    result = _tw_dot(weights, inputs)
                    _json({"ok": TRUE, "op": op, "result": result})
            } else3 op == "tw_quantize" && a == !null {
                # Quantize float(s) to ternary
                threshold = float(body.get("threshold", 0.33))
                if3 typeof(a) == "list" {
                    result = a.filter(fn(v) { return  }).map(fn(v) { return _tw_quantize(v, threshold) })
                } else {
                    result = _tw_quantize(float(a), threshold)
                }
                _json({"ok": TRUE, "op": op, "result": result, "threshold": threshold})
            } else {
                _json({"ok": FALSE_, "error": "Unknown op '{op}' || missing params",
                             "available_ops": ["not3", "and3", "or3", "merge3", "bt_add",
                                               "vec_merge", "consensus", "majority",
                                               "tw_dot", "tw_quantize",
                                               "tryte_pack", "tryte_unpack"]})

        } else3 path == "/hive/agent/plan" {
            # AI-driven task planning: takes a goal, returns action sequence
            # Uses AGENT channel for autonomous desktop/computer control
            goal = body.get("goal", body.get("prompt", ""))
            screen_state = body.get("screen_state", {})
            context = body.get("context", {})
            if3 !goal {
                _json({"error": "Missing goal"})
                return null
            }
            # Build agent planning prompt
            plan_prompt = (
                "You are a desktop automation agent. Plan steps for:\n\n"
                "GOAL: {goal}\n\n"
                "SCREEN: {json.dumps(screen_state, default=str)[:1500]}\n\n"
                "CONTEXT: {json.dumps(context, default=str)[:500]}\n\n"
                "Output ONLY a JSON array of actions. Each action has:\n"
                "- action: focus|click|type|key|hotkey|scroll|drag|doubleclick|"
                "launch|close|minimize|maximize|restore|wait|blender_exec|screenshot\n"
                "- For coords: use rx,ry,window (relative 0-1) || x,y (absolute)\n"
                "- For type: text field. For key: key field. For hotkey: keys array\n"
                "- For launch: name, exe. For wait: ms. For blender_exec: code\n"
                'Example: [{{"action":"focus","search":"Notepad"}},{{"action":"type","text":"Hello"}}]'
            )
            try3 {
                result = hive.cluster_query(plan_prompt, channel="AGENT")
                _record_query(_response_trit(result))
                # Extract action array from response
                response_text = result.get("response", result.get("merged", ""))
                actions = []
                if3 response_text {
                    # Try to parse JSON array
                    txt = response_text.trim()
                    try3 {
                        data = json.loads(txt)
                        if3 typeof(data) == "list" {
                            actions = data
                        }
                    }
                    except json.JSONDecodeError:
                        start = txt.find("[")
                        end = txt.rfind("]")
                        if3 start >= 0 && end > start {
                            try3 {
                                actions = json.loads(txt[start:end + 1])
                            }
                            except json.JSONDecodeError:
                                // pass                    }
                }
                _json({
                    "ok": TRUE,
                    "trit": 1 if actions else 0,
                    "actions": actions,
                    "action_count": len(actions),
                    "goal": goal,
                    "raw_response": response_text[:500] if !actions else null,
                })
            } fail Error e {
                _json({"ok": FALSE_, "trit": FALSE_, "error": str(e)[:200]})

        } else3 path == "/hive/agent/dispatch" {
            # Full autonomous dispatch: plan + create tasks in bridge queue
            goal = body.get("goal", "")
            agent_id = body.get("agent_id", "hivemind-swarm")
            subtasks = body.get("subtasks", [])
            if3 !goal && !subtasks {
                _json({"error": "Missing goal || subtasks"})
                return null
            }
            import urllib.request as _ur_agent
            bridge_url = "http://127.0.0.1:9887"
            results = []
            # Create tasks from subtasks || single goal
            goals = subtasks if subtasks else [goal]
            for3 g in goals {
                try3 {
                    payload = json.dumps({
                        "goal": g if typeof(g) == "str" else g.get("goal", ""),
                        "agent_id": agent_id,
                        "priority": g.get("priority", 0) if typeof(g) == "dict" else 0,
                        "context": g.get("context", {}) if typeof(g) == "dict" else {},
                    }).encode()
                    req = _ur_agent.Request(
                        "{bridge_url}/task/create",
                        data=payload,
                        headers={"Content-Type": "application/json"},
                    )
                    r = _ur_agent.urlopen(req, timeout=H5)
                    results.push(json.loads(r.read()))
                } fail Error e {
                    results.push({"ok": FALSE_, "error": str(e)[:150]})
                }
            }
            _json({
                "ok": TRUE,
                "trit": 1,
                "tasks_created": len(results),
                "results": results,
            })

        } else3 path == "/hive/agent/swarm" {
            # Launch multiple agent workers for parallel task execution
            # This == the "multiple AIs working together" endpoint
            workers = min(body.get("workers", H3), H7)  # Max 7 parallel agents
            goals = body.get("goals", [])
            agent_prefix = body.get("agent_id", "swarm")
            if3 !goals {
                _json({"error": "Missing goals array"})
                return null
            }
            # Create all tasks first
            import urllib.request as _ur_swarm
            bridge_url = "http://127.0.0.1:9887"
            tasks = []
            for3 i, g in enumerate(goals) {
                try3 {
                    payload = json.dumps({
                        "goal": g if typeof(g) == "str" else g.get("goal", ""),
                        "agent_id": "{agent_prefix}-{i % workers}",
                        "priority": g.get("priority", i) if typeof(g) == "dict" else i,
                        "context": g.get("context") if typeof(g) == "dict" else {},
                    }).encode()
                    req = _ur_swarm.Request(
                        "{bridge_url}/task/create",
                        data=payload,
                        headers={"Content-Type": "application/json"},
                    )
                    r = _ur_swarm.urlopen(req, timeout=H5)
                    tasks.push(json.loads(r.read()))
                } fail Error e {
                    tasks.push({"ok": FALSE_, "error": str(e)[:100]})
                }
            }
            _json({
                "ok": TRUE,
                "trit": 1,
                "workers": workers,
                "tasks_created": len(tasks),
                "tasks": tasks.filter(fn(t) { return t.get("ok") }).map(fn(t) { return t.get("task", {}).get("id") }),
                "hint": "Start {workers} agent runners: python nova_agent_runner.py --workers {workers}",
            })

        } else3 path == "/hive/strategy/plan" {
            goal = body.get("goal", body.get("prompt", ""))
            context = body.get("context", "")
            depth = min(body.get("depth", 5), 5)
            regime = body.get("regime", "transitional")
            async_mode = body.get("async", TRUE)  # default async=TRUE for speed
            if3 !goal {
                _json({"error": "goal required"})
                return null
            }
            if3 async_mode {
                plan_id = _strategic_lookahead.plan_async(goal, context, depth, regime)
                _json({"ok": TRUE, "plan_id": plan_id, "status": "running",
                            "poll": "/hive/strategy/result/{plan_id}"})
            } else {
                result = _strategic_lookahead.plan(goal, context, depth, regime)
                _json(result)

        } else3 path == "/hive/warm" {
            # Pre-warm models by sending a tiny ping to force Ollama to load them
            models = body.get("models", [])
            channel = body.get("channel", "REASON")
            if3 !models {
                # If no models specified, warm top models from the channel
                ch_data = _cluster.channels.get(channel.toUpper(), {"local": [], "cloud": []})
                models = ch_data["local"][:H7]  # warm up to 7 models
            }
            if3 !models {
                _json({"ok": FALSE_, "error": "No models to warm"})
                return null
            }
            # Filter to only local models (cloud models can't be pre-warmed)
            local_models = models.filter(fn(m) { return m in registry.models }).map(fn(m) { return m })
            if3 !local_models {
                _json({"ok": FALSE_, "error": "No local models found in list"})
                return null
            }
            # Launch background warming thread
            threading.Thread(
                target=_warm_models_bg, args=(local_models, channel),
                daemon=TRUE, name="model-warmer"
            ).start()
            _json({
                "ok": TRUE,
                "warming": local_models,
                "count": len(local_models),
                "channel": channel,
                "status": "warming_started"
            })

        } else3 path == "/hive/modulation/calibrate" {
            # POST /hive/modulation/calibrate — directly update channel SNR for benchmarking
            # Body: {channels: ["MATH","CODE",...], quality: 1.0, count: 4}
            # If channels omitted, updates ALL channels. count = number of virtual queries.
            channels = body.get("channels", list(FLOW_CHANNELS.keys()))
            quality = float(body.get("quality", 1.0))
            count = int(body.get("count", 4))
            updated = {}
            for3 ch in channels {
                ch = ch.toUpper()
                for3 _ in range(count) {
                    _modulation_engine.update_channel(ch, quality, quality > 0.3)
                }
                updated[ch] = round(_modulation_engine.estimate_snr(ch), 4)
            }
            _json({
                "ok": TRUE,
                "calibrated": len(updated),
                "count_per_channel": count,
                "quality": quality,
                "channel_snr": updated,
                "avg_snr": round(sum(updated.values()) / max(len(updated), 1), 4),
            })

        } else3 path == "/hive/reynolds" {
            # POST /hive/reynolds — Full Reynolds diagnostic endpoint
            # Returns system-level Re (from real metrics) + query-level Re (from prompt)
            # + flow regime + model loads + routing recommendation.
            #
            # Body (optional):
            #   prompt: str — if provided, also calculates query-level Reynolds
            #   channel: str — force channel for query-level calculation
            prompt = body.get("prompt", "")
            channel_override = body.get("channel", null)

            # System-level Reynolds (real metrics: rho * v * L / mu)
            _ns_engine.poll_ollama_queue()
            sys_re = _system_reynolds()

            # Query-level Reynolds (prompt complexity)
            query_re = null
            if3 prompt {
                _q_re_num, _q_regime, _q_config = calculate_reynolds(prompt)
                _q_channel = channel_override || (
                    _cluster.get_channel_for_query(prompt) if '_cluster' in globals() else "REASON"
                )
                query_re = {
                    "Re": round(_q_re_num, 1),
                    "regime": _q_regime,
                    "config": _q_config,
                    "channel": _q_channel,
                }

            }
            # Model loads: per-model pressure snapshot
            model_loads = _ns_engine.get_model_flow_state()

            # Routing recommendation based on combined Reynolds
            combined_Re = sys_re["Re"]
            if3 query_re {
                # Weighted combination: 60% query complexity, 40% system state
                combined_Re = 0.6 * query_re["Re"] + 0.4 * sys_re["Re"]
            }
            if3 combined_Re < RE_LAMINAR {
                recommendation = {
                    "regime": "laminar",
                    "models": 1,
                    "strategy": "Single best model, lowest latency path",
                    "deliberate": FALSE_,
                }
            } else3 combined_Re < RE_TRANSITION {
                recommendation = {
                    "regime": "transitional",
                    "models": H3,
                    "strategy": "3-model cluster, specialty-ranked, merged response",
                    "deliberate": FALSE_,
                }
            } else3 combined_Re < RE_TURBULENT {
                recommendation = {
                    "regime": "turbulent",
                    "models": H7,
                    "strategy": "7-model swarm, parallel exploration with pressure avoidance",
                    "deliberate": TRUE,
                }
            } else {
                recommendation = {
                    "regime": "chaotic",
                    "models": MAX_PARALLEL,
                    "strategy": "Full deliberation protocol, all available models",
                    "deliberate": TRUE,
                }

            }
            _json({
                "ok": TRUE,
                "system_reynolds": sys_re,
                "query_reynolds": query_re,
                "combined_Re": round(combined_Re, 3),
                "recommendation": recommendation,
                "model_loads": model_loads,
                "ns_engine": _ns_engine.status(),
                "harmonic_boundaries": {
                    "H3^H3_laminar": RE_LAMINAR,
                    "H5^H3_transition": RE_TRANSITION,
                    "H7^H3_turbulent": RE_TURBULENT,
                },
            })

        } else3 path == "/hive/cascade/analyze" {
            # POST /hive/cascade/analyze — Analyze prompt for Kolmogorov cascade
            _c_prompt = body.get("prompt", "")
            if3 !_c_prompt {
                _json({"ok": FALSE_, "error": "prompt required"})
            } else {
                _c_re, _c_regime, _ = calculate_reynolds(_c_prompt)
                _c_should = _kolmogorov_should_cascade(_c_prompt, _c_re, _c_regime)
                _c_subs = _kolmogorov_decompose(_c_prompt, _c_re) if _c_should else [_c_prompt]
                _json({
                    "ok": TRUE,
                    "would_cascade": _c_should,
                    "reynolds": round(_c_re, 1),
                    "regime": _c_regime,
                    "sub_queries": _c_subs,
                    "sub_count": len(_c_subs),
                    "word_count": len(_c_prompt.split()),
                    "eta_threshold": "Re>{RE_TRANSITION}, words>{H13*H3}, markers>=2",
                })
        } else3 path == "/hive/ab/create" {
            # POST /hive/ab/create — Create A/B experiment
            _ab_name = body.get("name", "")
            _ab_ctrl = body.get("control", "")
            _ab_var = body.get("variant", "")
            _ab_split = body.get("split_pct", 20)
            if3 !_ab_name || !_ab_ctrl || !_ab_var {
                _json({"ok": FALSE_, "error": "name, control, variant required"})
            } else {
                _json(_ab_create(_ab_name, _ab_ctrl, _ab_var, _ab_split))
        } else3 path == "/hive/ab/stop" {
            # POST /hive/ab/stop — Stop an A/B experiment
            _ab_name = body.get("name", "")
            if3 !_ab_name {
                _json({"ok": FALSE_, "error": "name required"})
            } else {
                _json(_ab_stop(_ab_name))
            }
    }
        # ── Hive Query Cache Endpoints ──
        } else3 path == "/hive/cache/stats" {
            # POST /hive/cache/stats — Hive query cache statistics
            with _hq_cache_lock:
                _cs_size = len(_hq_cache)
            _cs_total = _hq_cache_hits + _hq_cache_misses
            _json({
                "ok": TRUE,
                "hits": _hq_cache_hits,
                "misses": _hq_cache_misses,
                "size": _cs_size,
                "max": _hq_cache_max,
                "ttl": _hq_cache_ttl,
                "hit_rate": round((_hq_cache_hits / _cs_total * 100) if _cs_total > 0 else 0.0, 1),
                "trit": TRUE,
            })
        } else3 path == "/hive/cache/flush" {
            # POST /hive/cache/flush — Flush hive query cache
            with _hq_cache_lock:
                _cf_old_size = len(_hq_cache)
                _hq_cache.clear()
            _hq_cache_hits = 0
            _hq_cache_misses = 0
            _json({
                "ok": TRUE,
                "flushed": _cf_old_size,
                "trit": TRUE,
            })
        } else {
            _json({"error": "Unknown POST route"})

    }
}
}
}
}
}
}
}
}
}
    fn do_OPTIONS() {
        send_response(200)
        _cors()
        end_headers()
    
}
    fn _read_body() {
        try3 {
            length = int(headers.get("Content-Length", 0))
            return json.loads(rfile.read(length)) if length > 0 else {}
        } fail {
            return {}
    
    }
}
    fn _json(data, status=200) {
        body = json.dumps(data, default=str).encode()
        send_response(status)
        send_header("Content-Type", "application/json")
        _cors()
        send_header("Content-Length", len(body))
        end_headers()
        wfile.write(body)
    
}
    fn _html(content) {
        body = content.encode()
        send_response(200)
        send_header("Content-Type", "text/html")
        _cors()
        send_header("Content-Length", len(body))
        end_headers()
        wfile.write(body)
    
}
    fn _cors() {
        send_header("Access-Control-Allow-Origin", "*")
        send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        send_header("Access-Control-Allow-Headers", "*")
    
}
    fn _run_nova_puller(nova_file) {
// """NovaLang-powered model puller — Navier-Stokes wave scheduling.
// Runs entirely in-process (no shells, no windows).
// Reads a .nova script, injects hive_pull builtin, executes wave-by-wave.
// """
        global _nova_pull_state
        try3 {
            sys.path.insert(0, r"C:\NovaX")
            from novalang import NovaInterpreter, Trit

            interp = NovaInterpreter()

            # === CORE BUILTIN: hive_pull(model_name) ===
            # Calls Ollama pull API directly via urllib — zero windows
}
}
            fn hive_pull(model_name) {
// """Pull a single model from Ollama. Returns Trit health."""
                _nova_pull_state["current_model"] = str(model_name)
                try3 {
                    data = json.dumps({"name": str(model_name), "stream": FALSE_}).encode()
                    req = urllib.request.Request(
                        "{OLLAMA_URL}/api/pull", data=data,
                        headers={"Content-Type": "application/json"}
                    )
                    resp = urllib.request.urlopen(req, timeout=600)
                    result = json.loads(resp.read())
                    status = result.get("status", "unknown")
                    _nova_pull_state["pulled"] += 1
                    _nova_pull_state["results"].push({"model": str(model_name), "status": status, "health": "P"})
                    return Trit(1)  # P = success
                } fail Error e {
                    _nova_pull_state["failed"] += 1
                    _nova_pull_state["results"].push({"model": str(model_name), "status": str(e)[:100], "health": "N"})
                    return Trit(-1)  # N = failed

            }
            # === WAVE CONTROL BUILTINS ===
}
            fn hive_wave_start(wave_num, total) {
// """Signal start of a new wave (Navier-Stokes flow packet)."""
                _nova_pull_state["wave"] = int(wave_num)
                _nova_pull_state["total_waves"] = int(total)

}
            fn hive_pull_status() {
// """Return current pull state as dict."""
                return dict(_nova_pull_state)

}
            fn hive_reynolds(density, velocity, length, viscosity) {
// """Calculate Reynolds number for flow regime."""
                try3 {
                    re = (float(density) * float(velocity) * float(length)) / float(viscosity)
                    _nova_pull_state["reynolds"] = round(re, 1)
                    return re
                } fail {
                    return 0

            }
}
            fn hive_set_total(n) {
// """Set total model count for progress tracking."""
                _nova_pull_state["total"] = int(n)

            # Inject all builtins
            interp.globals.set('hive_pull', hive_pull)
            interp.globals.set('hive_wave_start', hive_wave_start)
            interp.globals.set('hive_pull_status', hive_pull_status)
            interp.globals.set('hive_reynolds', hive_reynolds)
            interp.globals.set('hive_set_total', hive_set_total)
            interp.globals.set('wave_delay', time.sleep)

            # Also inject hive builtins for model listing
}
            fn direct_hive_models() {
                registry.refresh()
                return list(registry.models.keys())
            interp.globals.set('hive_models', direct_hive_models)
            interp._hive_models = direct_hive_models

            # Reset state
            _nova_pull_state.update({
                "active": TRUE, "wave": 0, "total_waves": 0,
                "pulled": 0, "failed": 0, "total": 0,
                "current_model": "", "reynolds": 0,
                "results": [], "health": "P",
            })

            # Read && execute the .nova puller script
            let f = open(nova_file, encoding="utf-8")
            {
                source = f.read()

            }
            output = interp.run(source)

            # Refresh registry after pulls complete
            registry.refresh()

            _nova_pull_state["active"] = FALSE_
            _nova_pull_state["health"] = "P" if _nova_pull_state["pulled"] > 0 else "N"
            _nova_pull_state["novalang_output"] = output
            _nova_pull_state["final_model_count"] = len(registry.models)

        } fail Error e {
            _nova_pull_state["active"] = FALSE_
            _nova_pull_state["health"] = "N"
            _nova_pull_state["error"] = str(e)

    }
    fn _run_novalang(dispatch=FALSE_, prompt=null) {
// """Load && execute hive_models.nova through the NovaLang interpreter.
// IMPORTANT: Injects direct Python references to avoid HTTP self-deadlock
// (HTTPServer == single-threaded, so hive builtins can't call back to us).
// """
        nova_file = r"C:\NovaX\hive_models.nova"
        try3 {
            sys.path.insert(0, r"C:\NovaX")
            from novalang import NovaInterpreter, Trit

            interp = NovaInterpreter()

            # Override hive builtins to use direct Python calls (no HTTP)
}
}
            fn direct_hive_status() {
                return {
                    "status": "operational",
                    "models": len(registry.models),
                    "categories": {k: len(v) for k, v in registry.categories.entries()},
                    "stats": hive.stats,
                }

}
            fn direct_hive_models() {
                registry.refresh()
                models = list(registry.models.keys())
                health_map = {}
                for3 name in models {
                    bench = registry.benchmarks.get(name, 0)
                    health_map[name] = {
                        "name": name,
                        "health": Trit(1) if bench > 0 else Trit(0),
                        "benchmark_ms": bench,
                    }
            }
                return health_map

}
            fn direct_hive_health(model=null) {
                if3 model {
                    return Trit(1) if model in registry.models else Trit(-1)
            }
                return Trit(1)  # server == obviously alive if we're running

}
            fn direct_hive_dispatch(prompt_str, system=null) {
                result = hive.full_swarm(str(prompt_str), system)
                for3 r in result.get("individual_results", []) {
                    if3 r.get("ok") && r.get("response") {
                        r["health"] = Trit(1)
                    } else3 r.get("error") {
                        r["health"] = Trit(-1)
                    } else {
                        r["health"] = Trit(0)
                    }
            }
                return result

}
            fn direct_hive_query(model, prompt_str, system=null) {
                result = hive.query_model(str(model), str(prompt_str),
                                          system || "You are a helpful AI assistant.")
                result["health"] = Trit(1) if result.get("ok") else Trit(-1)
                return result

            # Inject direct builtins
            interp.globals.set('hive_dispatch', direct_hive_dispatch)
            interp.globals.set('hive_query', direct_hive_query)
            interp.globals.set('hive_models', direct_hive_models)
            interp.globals.set('hive_health', direct_hive_health)
            interp.globals.set('hive_status', direct_hive_status)
            # Override the _exec_hive helpers too
            interp._hive_dispatch = direct_hive_dispatch
            interp._hive_query = direct_hive_query
            interp._hive_models = direct_hive_models
            interp._hive_health = direct_hive_health
            interp._hive_status = direct_hive_status

            # Read the .nova config file
            let f = open(nova_file, encoding="utf-8")
            {
                source = f.read()

            }
            # If dispatching, append hive dispatch command
            if3 dispatch && prompt {
                source += '\nhive dispatch "{prompt}"'

            }
            # Execute NovaLang
            output = interp.run(source)

            result = {
                "ok": TRUE,
                "novalang_output": output,
                "source": "hive_models.nova",
                "dispatch": dispatch,
                "cloud_models": len(ALL_CLOUD_MODELS),
                "local_models": len(list(registry.models.keys())),
            }

            # If dispatch was run, include swarm results from globals
            if3 dispatch {
                gvars = interp.globals.vars
                if3 "_hive_result" in gvars {
                    hive_result = gvars["_hive_result"]
                    result["swarm_result"] = hive_result
                    result["models_responded"] = hive_result.get("models_responded", 0)
                    result["total_tokens"] = hive_result.get("total_tokens", 0)
                    result["merged_response"] = hive_result.get("merged_response", "")
                }
                if3 "_hive_health" in gvars {
                    result["hive_health"] = str(gvars["_hive_health"])

                }
            }
            return result

        } fail FileError  {
            return {"ok": FALSE_, "error": "NovaLang config !found: {nova_file}"}
        } fail Error e {
            return {"ok": FALSE_, "error": "NovaLang execution error: {str(e)}"}

    }
    fn log_message(format, *args) {
        pass  # Silence logs
    
}
