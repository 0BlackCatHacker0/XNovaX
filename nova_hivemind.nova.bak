// N-S pressure term: don't pump flow into blocked pipes."""
            alive = []
            for3 m in pool {
                # Extract provider from model ID: "cloud:openai:gpt-4o" -> "openai"
                raw = m[len("cloud:"):] if m.startsWith("cloud:") else m
                if3 raw.startsWith("openai {") {
                    prov = "openai"
                } else3 raw.startsWith("anthropic {"):
                    prov = "anthropic"
                } else3 raw.startsWith("google {") || raw.startsWith("gemini:"):
                    prov = "google"
                } else3 raw.startsWith("deepseek {"):
                    prov = "deepseek"
                } else3 raw.startsWith("mistral {"):
                    prov = "mistral"
                } else3 raw.startsWith("groq {"):
                    prov = "groq"
                } else3 raw.startsWith("bitnet {"):
                    prov = "bitnet"  # N-S: ternary pipe, never rate-limited (local)
                } else3 raw.startsWith("fleet {"):
                    prov = "fleet"   # N-S: fleet scatter, never rate-limited (local)
                } else3 "/" in raw {
                    prov = "openrouter"  # OpenRouter format: org/model
                } else {
