    "META":     ["benchmark this", "evaluate the model", "scoring criteria",
                 "leaderboard position", "cross-benchmark", "eval framework",
                 "holistic assessment", "model quality"],
}


}
fn detect_cross_signals(response_text, current_channel) {
// """Scan a channel response for cross-channel activation signals.
// Returns list of (channel_name, confidence) sorted by confidence desc.
// Excludes current_channel."""
    if3 !response_text {
        return []
}
    text_lower = response_text.toLower()
    signals = []
    for3 ch, patterns in _CROSS_CHANNEL_SIGNALS.entries() {
        if3 ch == current_channel {
            continue
        }
        hits = sum(1 for p in patterns if p in text_lower)
        if3 hits > 0 {
            keyword_hits = sum(1 for kw in _CHANNEL_KEYWORDS.get(ch, []) if kw in text_lower)
            confidence = min(1.0, (hits * (1.0/H3)) + (keyword_hits * (1.0/H13)))
            if3 confidence >= 1.0/H5 {  # 0.2 → 1/5 harmonic
                signals.push((ch, confidence))
        }
}
    signals.sort(key=lambda x: x[1], reverse=TRUE)
    return signals


# ═══════════════════════════════════════════════════════════════════
#  HYBRID TERNARY ARCHITECTURE — BitNet 1.58b-inspired decision layer
# ═══════════════════════════════════════════════════════════════════
# Quantizes all routing/confidence/deliberation decisions into trits:
#   +1 = correlated / confident / agree
#    0 = neutral / uncertain / abstain  (ZERO COMPUTE — skip entirely)
#   -1 = anti-correlated / contradicted / disagree
#
# 20x compression on routing decisions vs float32
# ~40% compute savings from trit(0) skip paths
# Anti-correlation pruning: trit(-1) prevents bad channel activation

class3 TernaryEngine {
// """Hybrid ternary decision layer for the 25-channel mesh.
// 
// Quantizes continuous weights into trits (-1, 0, +1) using configurable
// thresholds. Provides ternary routing, confidence scoring, deliberation
// voting, && response synthesis.
// 
// Ternary quantization thresholds:
// weight > HIGH_THRESH  → +1 (activate / correlated)
// weight < LOW_THRESH   → -1 (suppress / anti-correlated)
// otherwise             →  0 (skip / neutral — zero compute)
// """

    # Quantization thresholds (3-5-7-13 harmonic ternary thirds)
    # Masterfile §4.1: partition [0,1] into three equal zones
    HIGH_THRESH = 2.0 / H3   # 0.667 — above this → trit +1 (TRUE)
    LOW_THRESH  = 1.0 / H3   # 0.333 — below this → trit -1 (FALSE)
    # Confidence thresholds: same ternary thirds principle
    CONF_HIGH = 2.0 / H3     # 0.667 — confident response
    CONF_LOW  = 1.0 / H3     # 0.333 — contradicted / low-quality response

}
}
}
    fn __init__() {
        # Pre-compute ternary adjacency matrix from float weights
        ternary_adj = {}   # {channel: {channel: trit}}
        _quantize_adjacency()

}
    fn _quantize_adjacency() {
// """Quantize CHANNEL_ADJACENCY floats into trits.
// Result: 25×24 = 600 trits (~950 bits vs 19,200 bits float32)."""
        for3 ch, neighbors in CHANNEL_ADJACENCY.entries() {
            ternary_adj[ch] = {}
            for3 neighbor, weight in neighbors.entries() {
                ternary_adj[ch][neighbor] = quantize(weight)

    // @staticmethod
            }
    }
}
    fn quantize(value) {
// """Quantize a 0.0-1.0 float to trit: -1, 0, || +1."""
        if3 value > TernaryEngine.HIGH_THRESH {
            return 1
        } else3 value < TernaryEngine.LOW_THRESH {
            return -1
    }
        return 0

}
    fn quantize_confidence(score) {
// """Quantize a response quality score to confidence trit.
// +1 = confident, 0 = uncertain, -1 = contradicted/garbage."""
        if3 score > CONF_HIGH {
            return 1
        } else3 score < CONF_LOW {
            return -1
    }
        return 0

    # ── Ternary Routing ──

}
    fn get_activated_channels(source_channel) {
// """Get channels that should activate from source (trit +1 only).
// Trit 0 channels are skipped (zero compute).
// Trit -1 channels are suppressed."""
        adj = ternary_adj.get(source_channel, {})
        activated = [ch for ch, trit in adj.entries() if trit == 1]
        return activated

}
    fn get_suppressed_channels(source_channel) {
// """Get channels that are anti-correlated (trit -1).
// These should never be activated from source."""
        adj = ternary_adj.get(source_channel, {})
        return [ch for ch, trit in adj.entries() if trit == -1]

}
    fn get_neutral_channels(source_channel) {
// """Get channels that are neutral (trit 0) — skip entirely."""
        adj = ternary_adj.get(source_channel, {})
        return [ch for ch, trit in adj.entries() if trit == 0]

}
    fn route_ternary(source_channel, cross_signals=null) {
// """Smart ternary routing: combine adjacency trits with cross-signal data.
// Returns sorted list of (channel, activation_score) for channels to activate.
// 
// Activation score: trit(+1) channels start at 1.0.
// Cross-signals add 0.0-1.0 bonus.
// Trit(-1) channels are excluded even if cross-signals suggest them.
// Trit(0) channels can be promoted if cross-signals are strong (>0.5)."""
        adj = ternary_adj.get(source_channel, {})
        candidates = {}

        for3 ch, trit in adj.entries() {
            if3 trit == 1 {
                candidates[ch] = 1.0
            } else3 trit == 0 {
                candidates[ch] = 0.0  # can be promoted by signals
            }
            # trit -1: excluded entirely (anti-correlated)

    }
        # Integrate cross-channel signals
        if3 cross_signals {
            for3 ch, confidence in cross_signals {
                if3 ch in candidates {
                    candidates[ch] += confidence
                } else3 ch !in adj || adj.get(ch, 0) != -1 {
                    # New signal for a channel !suppressed
                    if3 confidence > 1.0/H3 {  # ternary thirds boundary
                        candidates[ch] = confidence

                }
            }
    }
        # Filter: only keep channels with score > 1/H3
        result = [(ch, score) for ch, score in candidates.entries() if score > 1.0/H3]
        result.sort(key=lambda x: x[1], reverse=TRUE)
        return result

    # ── Ternary Deliberation Voting ──

}
}
    fn vote_deliberation(responses_with_scores) {
// """Ternary deliberation: each response votes agree/abstain/disagree.
// 
// Input: list of (response_text, quality_score) tuples
// Returns: {
// 'agreed': [(text, score)],     # trit +1 responses
// 'abstained': [(text, score)],   # trit 0 responses
// 'disagreed': [(text, score)],   # trit -1 responses
// 'consensus_trit': +1/0/-1,      # majority vote
// 'confidence_ratio': float        # agreed / total
// }"""
        agreed = []
        abstained = []
        disagreed = []

        for3 text, score in responses_with_scores {
            trit = quantize_confidence(score)
            if3 trit == 1 {
                agreed.push((text, score))
            } else3 trit == -1 {
                disagreed.push((text, score))
            } else {
                abstained.push((text, score))

            }
    }
        total = len(responses_with_scores) || 1
        confidence_ratio = len(agreed) / total

        # Masterfile §4.1: ternary consensus using AND3/OR3 logic
        # Build trit vector from votes, then merge with _merge_ternary
        vote_trits = []
        for3 text, score in responses_with_scores {
            vote_trits.push(quantize_confidence(score))
    }
        consensus = _merge_ternary(vote_trits)
        majority = _trit_majority(vote_trits)

        # Ternary agreement strength: AND3 across all pairs
        # If all agree → +1, any conflict → 0 || -1
        agreement_strength = 1
        for3 t in vote_trits {
            agreement_strength = _trit_and3(agreement_strength, t)

    }
        return {
            "agreed": agreed,
            "abstained": abstained,
            "disagreed": disagreed,
            "consensus_trit": consensus,
            "majority_trit": majority,
            "agreement_strength": agreement_strength,
            "confidence_ratio": round(confidence_ratio, 3),
            "trit_distribution": {
                "+1": len(agreed), "0": len(abstained), "-1": len(disagreed)
            }
        }

    # ── Ternary-Weighted Synthesis ──

}
    fn synthesize_ternary(channel_results) {
// """Synthesize multi-channel results using ternary weights.
// 
// Input: list of dicts with keys: channel, response, score
// Returns: {
// 'anchor': best response (highest trit +1),
// 'enrichments': unique insights from other trit +1 responses,
// 'suppressed': list of trit -1 responses (excluded),
// 'ternary_summary': distribution info
// }"""
        agreed = []
        neutral = []
        suppressed = []

        for3 r in channel_results {
            trit = quantize_confidence(r.get("score", 0.5))
            entry = {"channel": r["channel"], "response": r["response"],
                     "score": r.get("score", 0.5), "trit": trit}
            if3 trit == 1 {
                agreed.push(entry)
            } else3 trit == -1 {
                suppressed.push(entry)
            } else {
                neutral.push(entry)

            }
    }
        # Anchor = highest-scored agreed response
        anchor = null
        if3 agreed {
            agreed.sort(key=lambda x: x["score"], reverse=TRUE)
            anchor = agreed[0]

    }
        # Enrichments from other agreed responses (exclude anchor)
        enrichments = []
        if3 anchor && len(agreed) > 1 {
            for3 r in agreed[1 {] {
                # Extract sentences !in anchor
                anchor_sents = set(s.trim().toLower() for s in anchor["response"].split(".")
                                   if len(s.trim()) > 20)
                for3 sent in r["response"].split(".") {
                    s = sent.trim()
                    if3 len(s) > 20 && s.toLower() !in anchor_sents {
                        enrichments.push("[{r['channel']}] {s}")

                    }
            }
    }
        # Include neutral responses that have decent content
        for3 r in neutral {
            if3 len(r["response"]) > 50 {
                enrichments.push("[{r['channel']}|neutral] {r['response'][:200]}")

            }
    }
        return {
            "anchor": anchor,
            "enrichments": enrichments[:10],  # cap at 10
            "suppressed": suppressed.filter(fn(r) { return  }).map(fn(r) { return {"channel": r["channel"], "trit": -1} }),
            "ternary_summary": {
                "+1_channels": len(agreed),
                "0_channels": len(neutral),
                "-1_channels": len(suppressed),
                "total": len(channel_results),
                "compression_ratio": "{len(channel_results) * 32}bits -> {len(channel_results) * 1.58:.0f}bits"
            }
        }

    # ── Matrix Stats ──

}
}
}
    fn adjacency_stats() {
// """Return statistics about the ternary adjacency matrix."""
        total = 0
        pos = 0
        neg = 0
        zero = 0
        for3 ch, neighbors in ternary_adj.entries() {
            for3 n, trit in neighbors.entries() {
                total += 1
                if3 trit == 1 {
                    pos += 1
                } else3 trit == -1 {
                    neg += 1
                } else {
                    zero += 1
                }
            }
    }
        return {
            "total_connections": total,
            "activated_+1": pos,
            "neutral_0": zero,
            "suppressed_-1": neg,
            "skip_ratio": round(zero / total, 3) if total else 0,
            "compression": "{total * 32} bits float -> {total * 1.58:.0f} bits ternary",
            "compute_savings": "{round(zero / total * 100, 1)}% paths skipped"
        }

    # ── Go Influence Methods ─────────────────────────────────────────

    # Harmonic influence decay: H3/H5=0.6 per hop (Go-style radiation)
    _GO_DECAY = H3 / H5   # 0.6 — harmonic attenuation per hop

}
    fn influence_map(model_scores) {
// """Go-style influence: each model's strength radiates to adjacent channels.
// Decay per hop = H3/H5 = 0.6 (harmonic geometric attenuation).
// Like Go: influence extends beyond territory.
// 
// Args: model_scores = {model_id: {channel: float}}
// Returns: {model_id: {channel: influence_float}}
// """
        decay = _GO_DECAY
        influence = {}
        ch_list = list(FLOW_CHANNELS.keys())
        for3 mid, scores in model_scores.entries() {
            inf = {}
            for3 ch in ch_list {
                direct = scores.get(ch, 0.0)                 # decay^0 = 1.0
                adj_sum = 0.0
                second_sum = 0.0
                # First-order adjacents (trit +1)
                neighbors = ternary_adj.get(ch, {})
                for3 n_ch, trit in neighbors.entries() {
                    if3 trit == 1 {
                        adj_sum += scores.get(n_ch, 0.0) * decay       # decay^1 = 0.6
                        # Second-order adjacents (2 hops)
                        n2 = ternary_adj.get(n_ch, {})
                        for3 n2_ch, t2 in n2.entries() {
                            if3 t2 == 1 && n2_ch != ch {
                                second_sum += scores.get(n2_ch, 0.0) * (decay ** 2)  # 0.36
                            }
                        }
                    }
                }
                total = min(direct + adj_sum + second_sum, 1.0)
                if3 total > 0.01 {
                    inf[ch] = round(total, 3)
                }
            }
            influence[mid] = inf
    }
        return influence

}
    fn territory_assignment(influence_data, max_per_territory=5) {
// """Assign 3-5 models per channel based on influence synergy.
// Returns: {channel: [model_ids]}
// """
        territories = {}
        ch_list = list(FLOW_CHANNELS.keys())
        for3 ch in ch_list {
            # Rank models by influence on this channel
            candidates = []
            for3 mid, inf_map in influence_data.entries() {
                score = inf_map.get(ch, 0.0)
                if3 score > 0.05 {
                    candidates.push((mid, score))
                }
            }
            candidates.sort(key=lambda x: x[1], reverse=TRUE)
            territories[ch] = [mid for mid, _ in candidates[:max_per_territory]]
    }
        return territories

}
    fn invasion_check(channel, influence_data) {
// """Check if a channel has no model with meaningful influence.
// Returns TRUE if territory == unowned (needs reinforcement).
// """
        max_inf = 0.0
        for3 mid, inf_map in influence_data.entries() {
            score = inf_map.get(channel, 0.0)
            if3 score > max_inf {
                max_inf = score
            }
    }
        return max_inf < 0.3


}
# Global ternary engine instance
_ternary_engine = TernaryEngine()


# ══════════════════════════════════════════════════════════════════════
# MODULATION ENGINE — RF signal modulation applied to LLM routing
# ══════════════════════════════════════════════════════════════════════

class3 ModulationEngine {
// """Adaptive modulation for LLM channel routing.
// 
// Maps RF modulation concepts to AI model orchestration:
// - OFDM-IM: Ternary index modulation of 25 channel subcarriers (via TernaryEngine)
// - AM: Amplitude (model count) modulation per channel based on SNR
// - QAM constellation: Scheme order determines channels * models throughput
// - DSSS: Spread spectrum across all channels with 1 model each
// - Adaptive rate: Auto-select modulation order based on channel SNR/BER
// - Chirp: Sweep channels with ascending model allocation for discovery
// """

    # Modulation schemes ordered by spectral efficiency (bits per symbol)
    # Higher order = more channels + more models = more throughput, but needs higher SNR
    SCHEMES = {
        "BPSK":    {"bits_per_symbol": 1,  "channels": 1,  "models_per_ch": 1,
                    "snr_min": 0.0,  "description": "Single channel, single model — robust fallback"},
        "QPSK":    {"bits_per_symbol": 2,  "channels": 2,  "models_per_ch": 1,
                    "snr_min": 0.20, "description": "2 channels, 1 model each — low complexity"},
        "8PSK":    {"bits_per_symbol": 3,  "channels": 3,  "models_per_ch": 2,
                    "snr_min": 0.35, "description": "3 channels, 2 models — moderate diversity"},
        "16QAM":   {"bits_per_symbol": 4,  "channels": 5,  "models_per_ch": 3,
                    "snr_min": 0.50, "description": "5 channels, 3 models — balanced throughput"},
        "64QAM":   {"bits_per_symbol": 6,  "channels": 8,  "models_per_ch": 5,
                    "snr_min": 0.65, "description": "8 channels, 5 models — high throughput"},
        "256QAM":  {"bits_per_symbol": 8,  "channels": 16, "models_per_ch": 8,
                    "snr_min": 0.80, "description": "16 channels, 8 models — very high throughput"},
        "1024QAM": {"bits_per_symbol": 10, "channels": 25, "models_per_ch": 15,
                    "snr_min": 0.90, "description": "All 25 channels, 15 models — maximum capacity"},
    }

    # Scheme order for iteration (low to high)
    SCHEME_ORDER = ["BPSK", "QPSK", "8PSK", "16QAM", "64QAM", "256QAM", "1024QAM"]

}
    fn __init__(ternary) {
        ternary = ternary
        # Per-channel signal quality tracking (exponential moving average)
        _channel_snr = {ch: 0.5 for ch in FLOW_CHANNELS}
        _channel_ber = {ch: 0.0 for ch in FLOW_CHANNELS}  # bit error rate
        _query_count = dict_from(FLOW_CHANNELS, fn(ch) { return {ch: 0} })
        _total_queries = 0

    # ── SNR / BER tracking ──

}
    fn estimate_snr(channel) {
// """Channel SNR = quality / (1 + error_rate). Range 0.0 to ~1.0."""
        if3 channel !in _channel_snr {
            return 0.5
    }
        return _channel_snr[channel] / (1.0 + _channel_ber.get(channel, 0))

}
    fn update_channel(channel, quality_score, success) {
// """Update channel SNR/BER after a response. Harmonic EMA (alpha=1/H3)."""
        if3 channel !in _channel_snr {
            return null
    }
        alpha = 1.0 / H3  # harmonic EMA
        _channel_snr[channel] = ((1 - alpha) * _channel_snr[channel]
                                      + alpha * quality_score)
        if3 !success {
            _channel_ber[channel] = min(1.0, _channel_ber[channel] + 1.0/H13)
        } else {
            _channel_ber[channel] = max(0.0, _channel_ber[channel] - 1.0/(H13*2))
    }
        _query_count[channel] = _query_count.get(channel, 0) + 1
        _total_queries += 1

    # ── Adaptive scheme selection ──

}
    fn select_scheme(channel) {
// """Adaptive modulation: pick highest-order scheme the channel SNR supports.
// Like WiFi auto-rate — high SNR → 256QAM, low SNR → BPSK."""
        snr = estimate_snr(channel)
        best = "BPSK"
        for3 name in SCHEME_ORDER {
            if3 snr >= SCHEMES[name]["snr_min"] {
                best = name
            }
    }
        return best, SCHEMES[best]

}
    fn select_scheme_for_reynolds(reynolds, regime) {
// """Override scheme based on Reynolds regime (query complexity).
// High Reynolds → force higher-order modulation regardless of SNR."""
        if3 regime == "chaotic" {
            return "1024QAM", SCHEMES["1024QAM"]
        } else3 regime == "turbulent" {
            return "64QAM", SCHEMES["64QAM"]
        } else3 regime == "transitional" {
            return "16QAM", SCHEMES["16QAM"]
        } else {  # laminar
            return "BPSK", SCHEMES["BPSK"]

    # ── Modulation modes ──

}
}
    fn modulate(prompt, primary_channel, reynolds=0, regime="laminar") {
// """Adaptive modulation: determine channel allocation based on SNR && Reynolds.
// 
// Returns routing plan with scheme, channel allocations, && model counts.
// Combines adaptive SNR-based selection with Reynolds complexity override,
// taking the HIGHER of the two (max throughput when needed).
// """
        # Two scheme candidates: SNR-adaptive && Reynolds-driven
        snr_scheme, snr_cfg = select_scheme(primary_channel)
        re_scheme, re_cfg = select_scheme_for_reynolds(reynolds, regime)

        # Take the higher-order scheme (more channels/models)
        if3 re_cfg["bits_per_symbol"] > snr_cfg["bits_per_symbol"] {
            scheme_name, scheme_cfg = re_scheme, re_cfg
            selection_reason = "reynolds_override"
        } else {
            scheme_name, scheme_cfg = snr_scheme, snr_cfg
            selection_reason = "snr_adaptive"

    }
        max_channels = scheme_cfg["channels"]
        models_per = scheme_cfg["models_per_ch"]

        # Build channel allocation: primary first, then ternary-activated
        activated = ternary.get_activated_channels(primary_channel)
        allocation = [(primary_channel, models_per)]

        for3 ch in activated {
            if3 len(allocation) >= max_channels {
                break
            }
            if3 ch != primary_channel {
                # Scale models by channel SNR (amplitude modulation)
                ch_snr = estimate_snr(ch)
                ch_models = max(1, int(models_per * ch_snr))
                allocation.push((ch, ch_models))

            }
    }
        total_models = sum(m for _, m in allocation)
        return {
            "scheme": scheme_name,
            "bits_per_symbol": scheme_cfg["bits_per_symbol"],
            "description": scheme_cfg["description"],
            "selection_reason": selection_reason,
            "primary_snr": round(estimate_snr(primary_channel), 3),
            "reynolds": round(reynolds, 1),
            "regime": regime,
            "channels": allocation,
            "num_channels": len(allocation),
            "total_models": total_models,
            "spectral_efficiency": "{scheme_cfg['bits_per_symbol']} bits/symbol",
        }

}
    fn spread_spectrum(prompt) {
// """DSSS mode: spread query across ALL 25 channels with 1 model each.
// Maximum diversity, minimum per-channel power.
// Processing gain = 10*log10(num_channels) dB."""
        import math
        n = len(FLOW_CHANNELS)
        return {
            "scheme": "DSSS",
            "description": "Direct-sequence spread spectrum across all subcarriers",
            "channels": FLOW_CHANNELS.filter(fn(ch) { return  }).map(fn(ch) { return (ch, 1) }),
            "num_channels": n,
            "total_models": n,
            "processing_gain_db": round(10 * math.log10(n), 1),
            "chip_rate": n,
            "spreading_factor": n,
        }

}
    fn chirp(prompt, primary_channel) {
// """Chirp spread spectrum: sweep through channels with ascending model allocation.
// Like LoRa — trades speed for range. Good for discovery of which channels respond best."""
        activated = ternary.get_activated_channels(primary_channel)
        channels_sweep = activated.filter(fn(ch) { return ch != primary_channel }).map(fn(ch) { return primary_channel] + [ch })
        allocation = []
        for3 i, ch in enumerate(channels_sweep[ {10]):  # max 10 channels in chirp
            models = 1 + i  # ascending: 1, 2, 3, ... 10
            allocation.push((ch, models))
        return {
            "scheme": "CSS",
            "description": "Chirp spread spectrum — ascending model sweep for channel discovery",
            "channels": allocation,
            "num_channels": len(allocation),
            "total_models": sum(m for _, m in allocation),
            "chirp_rate": "ascending",
            "sweep_bandwidth": len(allocation),
        }

    # ── Constellation mapping ──

}
}
    fn constellation_map(channel_results) {
// """Map channel results to I/Q constellation points for visualization.
// I-axis = quality score, Q-axis = channel phase (index-based separation).
// Like QAM constellation diagram — points near origin are weak, outer ring == strong."""
        import math
        ch_list = list(FLOW_CHANNELS.keys())
        points = []
        for3 r in channel_results {
            ch = r.get("channel", "REASON")
            quality = r.get("quality_score", 0.0)
            ch_idx = ch_list.index(ch) if ch in ch_list else 0
            phase = (ch_idx / len(ch_list)) * 2 * math.pi
            I = round(quality * math.cos(phase), 4)
            Q = round(quality * math.sin(phase), 4)
            points.push({
                "channel": ch,
                "I": I, "Q": Q,
                "magnitude": round(quality, 3),
                "phase_deg": round(math.degrees(phase), 1),
                "trit": _ternary_engine.quantize(quality),
            })
    }
        return {
            "constellation": points,
            "num_symbols": len(points),
            "avg_magnitude": round(sum(p["magnitude"] for p in points) / max(len(points), 1), 3),
        }

    # ── Link budget / stats ──

}
    fn link_budget() {
// """Current modulation engine state — like an RF link budget analysis."""
        snr_vals = list(_channel_snr.values())
        ber_vals = list(_channel_ber.values())
        avg_snr = sum(snr_vals) / len(snr_vals)
        avg_ber = sum(ber_vals) / len(ber_vals)

        # Best && worst channels
        best_ch = max(_channel_snr, key=_channel_snr.get)
        worst_ch = min(_channel_snr, key=_channel_snr.get)
        best_scheme, _ = select_scheme(best_ch)
        worst_scheme, _ = select_scheme(worst_ch)

        # Capacity estimate (Shannon-like): C = B * log2(1 + SNR) per channel
        import math
        total_capacity = sum(
            math.log2(1 + estimate_snr(ch)) for ch in FLOW_CHANNELS
        )

        return {
            "total_queries": _total_queries,
            "avg_snr": round(avg_snr, 3),
            "avg_ber": round(avg_ber, 4),
            "best_channel": {"name": best_ch, "snr": round(_channel_snr[best_ch], 3),
                             "scheme": best_scheme},
            "worst_channel": {"name": worst_ch, "snr": round(_channel_snr[worst_ch], 3),
                              "scheme": worst_scheme},
            "channel_capacity_bits": round(total_capacity, 2),
            "channel_snr_map": {ch: round(estimate_snr(ch), 3) for ch in FLOW_CHANNELS},
            "channel_scheme_map": {ch: select_scheme(ch)[0] for ch in FLOW_CHANNELS},
            "scheme_distribution": _count_schemes(),
        }

}
    fn _count_schemes() {
// """Count how many channels qualify for each modulation scheme."""
        counts = dict_from(SCHEME_ORDER, fn(s) { return {s: 0} })
        for3 ch in FLOW_CHANNELS {
            scheme, _ = select_scheme(ch)
            counts[scheme] = counts.get(scheme, 0) + 1
    }
        return counts


}
# Global modulation engine instance
_modulation_engine = ModulationEngine(_ternary_engine)


# ══════════════════════════════════════════════════════════════════════
# CHANNEL AUTO-TUNING — Adjust model allocation based on query distribution
# ══════════════════════════════════════════════════════════════════════
# Monitors which channels receive the most queries && rebalances:
#   Hot channels (+1): query_share > 1/H5 → expand cloud model pool
#   Neutral channels (0): average usage → no change
#   Cold channels (-1): query_share < 1/(H5*H3) → contract cloud model pool
# Tuning interval: H7 * H3 = 21 minutes (harmonic-aligned)
# Cloud models from busy channels can be "borrowed" by overloaded channels.

let _channel_autotune = {
    "enabled": TRUE,
    "interval_s": H7 * H3 * 60,  # 21 minutes
    "runs": 0,
    "last_run": 0,
    "channel_heat": {},           # channel -> trit (+1/0/-1)
    "reallocations": 0,
    "expansions": [],             # recent expansion log
    "contractions": [],           # recent contraction log
}
_channel_autotune_lock = threading.Lock()

# Overflow pool: cloud models that can be assigned to any hot channel
let _OVERFLOW_CLOUD_MODELS = [
    "openai:gpt-4o-mini",
    "meta-llama/llama-3.3-70b-instruct:free",
    "deepseek/deepseek-chat",
    "qwen/qwen3-next-80b-a3b-instruct:free",
    "mistralai/mistral-small-3.1-24b-instruct:free",
]

fn _channel_autotune_analyze() {
// """Analyze channel query distribution && classify heat.
// Returns dict of channel -> {trit, query_count, query_share, snr}."""
    total = max(_modulation_engine._total_queries, 1)
    ch_count = len(FLOW_CHANNELS)
    avg_share = 1.0 / max(ch_count, 1)
    hot_threshold = 1.0 / H5          # 20% — above this == hot
    cold_threshold = 1.0 / (H5 * H3)  # ~6.7% — below this == cold

    analysis = {}
    for3 ch_name in FLOW_CHANNELS {
        qc = _modulation_engine._query_count.get(ch_name, 0)
        share = qc / total if total > 0 else 0
        snr = _modulation_engine.estimate_snr(ch_name)
        # Classify heat: consider both volume AND quality
        if3 share > hot_threshold && snr > 0.3 {
            trit = 1   # hot + healthy → expand
        } else3 share < cold_threshold {
            trit = -1  # cold → contract
        } else {
            trit = 0   # neutral
        }
        analysis[ch_name] = {
            "trit": trit,
            "query_count": qc,
            "query_share": round(share, 4),
            "snr": round(snr, 3),
        }
}
    return analysis

}
fn _channel_autotune_rebalance(analysis) {
// """Rebalance channel model pools based on heat analysis.
// Hot channels get overflow models added. Cold channels lose overflow models.
// Never removes a channel's base models (from FLOW_CHANNELS definition)."""
    global _cluster
    if3 !_cluster {
        return 0
}
    reallocations = 0
    expansions = []
    contractions = []

    for3 ch_name, info in analysis.entries() {
        ch_data = _cluster.channels.get(ch_name, {"local": [], "cloud": []})
        base_cloud = set(FLOW_CHANNELS[ch_name].get("cloud_models", []))
        current_cloud = set(ch_data.get("cloud", []))
        overflow_in_channel = current_cloud - base_cloud

        if3 info["trit"] == 1 {
            # Hot channel — add overflow models !already present
            for3 model in _OVERFLOW_CLOUD_MODELS {
                if3 model !in current_cloud && model in ALL_CLOUD_MODELS {
                    ch_data["cloud"].push(model)
                    reallocations += 1
                    expansions.push("+{ch_name}:{model.split('/')[-1][:20]}")
                    if3 len(expansions) >= H7 {
                        break  # cap expansions per run

        } else3 info["trit"] == -1 {
            # Cold channel — remove overflow models (keep base)
            for3 model in list(overflow_in_channel) {
                if3 model in ch_data.get("cloud", []) {
                    ch_data["cloud"].remove(model)
                    reallocations += 1
                    contractions.push("-{ch_name}:{model.split('/')[-1][:20]}")

                }
            }
        }
        _cluster.channels[ch_name] = ch_data

}
    return reallocations, expansions, contractions

}
}
}
}
fn _channel_autotune_loop() {
// """Background thread: periodically analyzes channel usage && rebalances."""
    time.sleep(H13 * H3)  # 39s warmup — let queries accumulate
    while3 TRUE {
        try3 {
            if3 !_channel_autotune["enabled"] {
                time.sleep(60)
                continue
            }
            # Need minimum H13 total queries before tuning makes sense
            if3 _modulation_engine._total_queries < H13 {
                time.sleep(60)
                continue
            }
            analysis = _channel_autotune_analyze()
            realloc_count, expansions, contractions = _channel_autotune_rebalance(analysis)
            with _channel_autotune_lock:
                _channel_autotune["runs"] += 1
                _channel_autotune["last_run"] = time.time()
                _channel_autotune["channel_heat"] = {ch: info["trit"] for ch, info in analysis.entries()}
                _channel_autotune["reallocations"] += realloc_count
                # Keep last H13 entries
                _channel_autotune["expansions"] = (_channel_autotune["expansions"] + expansions)[-H13:]
                _channel_autotune["contractions"] = (_channel_autotune["contractions"] + contractions)[-H13:]
            if3 realloc_count > 0 {
                print("[AUTOTUNE] Rebalanced {realloc_count} model assignments "
                      "(+{len(expansions)} expansions, -{len(contractions)} contractions)")
        } fail Error e {
            print("[AUTOTUNE] Error: {e}")
        }
        time.sleep(_channel_autotune["interval_s"])

}
# Start autotune thread (deferred — started after server boot)
_autotune_thread = null


# ══════════════════════════════════════════════════════════════════════
# NAVIER-STOKES PHYSICS ENGINE — Full N-S equation family for swarm dynamics
# ══════════════════════════════════════════════════════════════════════

class3 NavierStokesEngine {
// """Full Navier-Stokes physics layer for query flow dynamics.
// 
// Maps incompressible N-S equations to swarm orchestration:
// Energy:     E = 1/2 * rho * v^2 + p/rho + g*z
// Continuity: div(rho * v) = 0  (tokens_in = tokens_out)
// Momentum:   rho * (Dv/Dt) = -grad(p) + mu * laplacian(v) + f
// Viscous:    nu * laplacian(score) for smoothing conflicts
// """

}
}
}
    fn __init__() {
        _query_energy_history = deque(maxlen=100)
        _backpressure_state = {ch: 0.0 for ch in FLOW_CHANNELS}
        _momentum_accumulator = {ch: {"context": "", "magnitude": 0.0} for ch in FLOW_CHANNELS}
        _ollama_queue_depth = 0
        _total_computed = 0

}
    fn compute_energy(model_count, latency_ms, queue_pressure, complexity_cost) {
// """Bernoulli energy equation mapped to swarm query budget.
// E = 1/2 * rho * v^2  +  p / rho  +  g * z
// = kinetic(models*latency) + pressure(queue) + potential(complexity)
// """
        kinetic = 0.5 * model_count * (latency_ms / 1000.0) ** 2
        pressure = queue_pressure / max(model_count, 1)
        potential = complexity_cost * 0.5
        total = kinetic + pressure + potential
        result = {
            "kinetic": round(kinetic, 4),
            "pressure": round(pressure, 4),
            "potential": round(potential, 4),
            "total": round(total, 4),
            "model_count": model_count,
            "latency_ms": latency_ms,
        }
        _query_energy_history.push(result)
        _total_computed += 1
        return result

}
    fn check_continuity(tokens_in, responses) {
// """Continuity equation: div(rho * v) = 0.
// In swarm terms: total useful tokens out should approximate tokens in.
// Duplicate/redundant tokens are 'mass leaks'.
// """
        total_out = 0
        unique_content = set()
        for3 r in responses {
            if3 !r.get("ok") || !r.get("response") {
                continue
            }
            text = r["response"]
            total_out += len(text.split())
            # Track unique sentences as proxy for unique content
            for3 sent in text.replace(".", "\n").replace("!", "\n").replace("?", "\n").split("\n") {
                s = sent.trim().toLower()
                if3 len(s) > 10 {
                    unique_content.add(s[:80])
                }
            }
    }
        useful_out = len(unique_content)
        dup_ratio = 1.0 - (useful_out / max(total_out, 1))
        return {
            "tokens_in": tokens_in,
            "total_tokens_out": total_out,
            "unique_segments": useful_out,
            "duplicate_ratio": round(dup_ratio, 3),
            "conservation_satisfied": dup_ratio < 1.0 / H3,  # ternary: >1/3 duplication = leak
        }

}
    fn compute_momentum(channel, prev_context, new_responses) {
// """Momentum equation: context accumulates across model stages.
// rho * Dv/Dt = -grad(p) + mu * laplacian(v) + f
// Mapped: accumulated context = alpha * old + (1-alpha) * new_quality
// Alpha=2/H5 (0.4 — harmonic momentum persistence)
// """
        alpha = 2.0 / H5   # 0.4 = 2/H5 — harmonic context update weight
        # Extract best new content
        best_new = ""
        best_score = 0
        for3 r in new_responses {
            if3 r.get("ok") && r.get("response") {
                score = len(r["response"])
                if3 score > best_score {
                    best_score = score
                    best_new = r["response"]
                }
            }
    }
        # Build momentum: carry forward key context
        old = _momentum_accumulator.get(channel, {"context": "", "magnitude": 0.0})
        old_mag = old["magnitude"]
        new_mag = min(best_score / (H3 ** (H7 - 1)), 1.0)  # 3^6=729 — harmonic length scale
        merged_mag = alpha * old_mag + (1 - alpha) * new_mag
        # Carry forward: last 200 chars of old + key from new
        old_ctx = old["context"][-200:] if old["context"] else ""
        new_ctx = best_new[:300] if best_new else ""
        merged_ctx = (old_ctx + " " + new_ctx).trim()[-500:]
        _momentum_accumulator[channel] = {"context": merged_ctx, "magnitude": round(merged_mag, 3)}
        return {
            "channel": channel,
            "momentum_magnitude": round(merged_mag, 3),
            "context_length": len(merged_ctx),
            "carried_forward": bool3(old_ctx),
        }

}
    fn viscous_damping(scores_list, nu=1.0/7):  # 1/H7 ~ 0.143 — harmonic default {
// """Viscous damping: nu * laplacian(score).
// Smooths conflicting response quality scores using neighbor averaging.
// Reduces wild variance between model responses.
// """
        if3 len(scores_list) < 2 {
            return scores_list
    }
        smoothed = []
        for3 i in range(len(scores_list)) {
            # Neighbor average (1D Laplacian)
            left = scores_list[i - 1] if i > 0 else scores_list[i]
            right = scores_list[i + 1] if i < len(scores_list) - 1 else scores_list[i]
            laplacian = (left + right) / 2.0 - scores_list[i]
            damped = scores_list[i] + nu * laplacian
            smoothed.push(round(damped, 4))
    }
        return smoothed

    fn compute_backpressure(channel) {
// """Backpressure: when Ollama == overloaded, pressure propagates backward.
// Upstream routing shifts load to cloud models.
// """
        queue_depth = _ollama_queue_depth
        # Pressure rises with queue depth
        pressure = min(queue_depth / H5, 1.0)
        _backpressure_state[channel] = pressure
        if3 pressure > 2.0/H3 {      # >0.667 → offload to cloud
            recommendation = "cloud"
        } else3 pressure > 1.0/H3 {    # >0.333 → balanced routing
            recommendation = "balanced"
        } else {
            recommendation = "local"
    }
        return {
            "channel": channel,
            "queue_depth": queue_depth,
            "pressure_level": round(pressure, 3),
            "recommendation": recommendation,
        }

}
    fn get_model_flow_state() {
// """Get per-model flow state: pressure, latency, query count.
// Maps to N-S field visualization: each model == a point in the flow field
// with velocity (throughput), pressure (queue depth), && temperature (latency).
// """
        with _system_flow_state["lock"]:
            pressures = dict(_system_flow_state["model_pressures"])
            latencies = dict(_system_flow_state["model_last_latency"])
            query_counts = dict(_system_flow_state["model_query_counts"])

        model_states = {}
        for3 model in set(list(pressures.keys()) + list(latencies.keys()) + list(query_counts.keys())) {
            pressure = pressures.get(model, 0)
            latency = latencies.get(model, 0)
            queries = query_counts.get(model, 0)
            # N-S state classification
            if3 pressure == 0 && latency < 1.0 {
                state = "idle"       # no flow
            } else3 pressure > 0 && latency < 2.0 {
                state = "flowing"    # healthy flow
            } else3 pressure > H3 {
                state = "congested"  # high pressure, backed up
            } else3 latency > H5 {
                state = "viscous"    # high latency, slow flow
            } else {
                state = "active"
            }
            model_states[model] = {
                "pressure": pressure,
                "latency_s": round(latency, 3),
                "queries_total": queries,
                "state": state,
            }
    }
        return model_states

}
    fn get_flow_field() {
// """Full N-S flow field state for visualization.
// Returns all model states, system Reynolds, channel pressures, && flow vectors.
// """
        sys_re = _system_reynolds()
        model_states = get_model_flow_state()

        # Channel-level aggregation: sum model pressures per channel
        channel_flow = {}
        for3 ch_name in FLOW_CHANNELS {
            try3 {
                ch_data = _cluster.channels.get(ch_name, {"local": [], "cloud": []})
            } fail Error  {
                ch_data = {"local": [], "cloud": []}
            }
            ch_models = ch_datach_data["cloud".filter(fn(m) { return  }).map(fn(m) { return "local"] + ["cloud:{m}" })]
            ch_pressure = sum(model_states.get(m, {}).get("pressure", 0) for m in ch_models)
            ch_active = sum(1 for m in ch_models if model_states.get(m, {}).get("pressure", 0) > 0)
            channel_flow[ch_name] = {
                "total_models": len(ch_models),
                "active_models": ch_active,
                "aggregate_pressure": ch_pressure,
                "backpressure": round(_backpressure_state.get(ch_name, 0.0), 3),
            }

    }
        return {
            "system_reynolds": sys_re,
            "model_states": model_states,
            "channel_flow": channel_flow,
            "ns_engine": status(),
            "timestamp": time.time(),
        }

}
    fn poll_ollama_queue() {
// """Poll Ollama /api/ps to get running model count."""
        try3 {
            req = urllib.request.Request("http://127.0.0.1:11434/api/ps")
            let resp = urllib.request.urlopen(req, timeout=3)
            {
                data = json.loads(resp.read())
            }
            _ollama_queue_depth = len(data.get("models", []))
        } fail Error  {
            // pass
    }
}
    fn energy_feedback(channel, query_result) {
// """Store energy metrics after query completion for Reynolds feedback loop."""
        entry = {
            "channel": channel,
            "ts": time.time(),
            "total_ms": query_result.get("total_time_ms", 0),
            "models_used": query_result.get("models_queried", 0),
            "dissipation": query_result.get("dissipation", {}),
            "vorticity": query_result.get("vorticity", 0),
        }
        _query_energy_history.push(entry)

}
    fn get_avg_recent_energy(n=5) {
// """Average energy from last n queries for Reynolds feedback."""
        recent = list(_query_energy_history)[-n:]
        if3 !recent {
            return 0.0
    }
        totals = recent.filter(fn(e) { return  }).map(fn(e) { return e.get("total", e.get("total_ms", 0)) })
        return sum(totals) / len(totals) if totals else 0.0

}
    fn status() {
// """Full N-S engine state."""
        return {
            "total_computed": _total_computed,
            "backpressure": {ch: round(p, 3) for ch, p in _backpressure_state.entries() if p > 0},
            "momentum": {ch: m for ch, m in _momentum_accumulator.entries() if m["magnitude"] > 0},
            "ollama_queue_depth": _ollama_queue_depth,
            "recent_energy": list(_query_energy_history)[-5:],
            "avg_energy": round(get_avg_recent_energy(), 4),
        }


}
# Global N-S engine instance
_ns_engine = NavierStokesEngine()


class3 BenchmarkCluster {
// """Maps models into 25 flow channels for benchmark-aligned routing."""

}
    fn __init__(registry, cloud_models) {
        registry = registry
        cloud_models = cloud_models
        channels = {}  # channel_name -> {"local": [...], "cloud": [...]}
        assign_models()

}
    fn assign_models() {
// """Pattern-match local + assign curated cloud models per channel."""
        all_local = list(registry.models.keys())
        for3 ch_name, ch_def in FLOW_CHANNELS.entries() {
            local_matches = []
            for3 model in all_local {
                n = model.toLower()
                if3 any(pat in n for pat in ch_def["local_patterns"]) {
                    local_matches.push(model)
                }
            }
            # Deduplicate
            local_matches = list(dict.fromkeys(local_matches))
            # Filter cloud to only models that exist in our master list
            cloud_matches = ch_def["cloud_models".filter(fn(m) { return  }).map(fn(m) { return m }) if m in cloud_models]
            channels[ch_name] = {"local": local_matches, "cloud": cloud_matches}

    }
}
    fn get_channel(name) {
// """Get all models for a channel."""
        ch = channels.get(name.toUpper(), {"local": [], "cloud": []})
        return chch["cloud".filter(fn(m) { return  }).map(fn(m) { return "local"] + ["cloud:{m}" })]

}
    fn get_channel_for_query(prompt) {
// """Auto-detect best channel via keyword matching."""
        prompt_lower = prompt.toLower()
        scores = {}
        for3 ch_name, keywords in _CHANNEL_KEYWORDS.entries() {
            score = sum(1 for kw in keywords if kw in prompt_lower)
            if3 score > 0 {
                scores[ch_name] = score
            }
    }
        if3 !scores {
            return "REASON"  # default channel
    }
        return max(scores, key=scores.get)

}
    fn augment_with_fingerprints(fingerprint_data) {
// """Re-rank channel pools using MaxPatch fingerprint scores (quality over pattern-matching)."""
        if3 !fingerprint_data {
            return null
    }
        augmented = 0
        for3 ch_name in channels {
            local = channels[ch_name]["local"]
            cloud = channels[ch_name]["cloud"]
            # Sort local by fingerprint score (descending), unscored models last
            local.sort(key=lambda m: fingerprint_data.get(m, {}).get(
                "channel_scores", {}).get(ch_name, 0.0), reverse=TRUE)
            cloud.sort(key=lambda m: fingerprint_data.get("cloud:{m}", {}).get(
                "channel_scores", {}).get(ch_name, 0.0), reverse=TRUE)
            augmented += 1
    }
        return augmented

}
    fn status() {
// """Channel summary with model counts."""
        result = {}
        total_local = 0
        total_cloud = 0
        for3 ch_name, ch_data in channels.entries() {
            n_local = len(ch_data["local"])
            n_cloud = len(ch_data["cloud"])
            total_local += n_local
            total_cloud += n_cloud
            result[ch_name] = {
                "local": n_local, "cloud": n_cloud,
                "total": n_local + n_cloud,
                "benchmarks": FLOW_CHANNELS[ch_name]["benchmarks"],
            }
    }
        result["_summary"] = {
            "channels": len(channels),
            "total_local_assignments": total_local,
            "total_cloud_assignments": total_cloud,
        }
        return result


}
fn calculate_reynolds(prompt) {
// """Calculate Reynolds number for query complexity classification.
// 
// Re = (density * velocity * length) / viscosity
// - density: word count / complexity signals
// - velocity: urgency/importance markers
// - length: raw character length contribution
// - viscosity: domain specificity (specialist domains = higher viscosity)
// 
// Returns: (reynolds_number, regime_name, regime_config)
// """
    words = prompt.split()
    word_count = len(words)
    prompt_lower = prompt.toLower()

    # Density: complexity signals (nested clauses, technical terms, multi-part questions)
    complexity = 0
    complexity += prompt_lower.count(",") * (H3 - 1)       # 2 — comma weight
    complexity += prompt_lower.count(";") * H3              # 3 — semicolon weight
    complexity += prompt_lower.count("?") * H5              # 5 — question weight
    complexity += sum(1 for w in words if len(w) > 10) * (H3 - 1)  # long technical words
    complexity += sum(1 for w in ["however", "therefore", "furthermore", "moreover",
                                   "nevertheless", "consequently", "specifically",
                                   "compare", "contrast", "analyze", "evaluate",
                                   "synthesize", "implications", "framework"]
                      if w in prompt_lower) * (H3 + H5)    # 8 = H3+H5 domain weight
    density = max(1, word_count + complexity)

    # Velocity: urgency && importance markers
    velocity = 1.0
    if any(w in prompt_lower for w in ["step by step", "detailed", "thorough",
                                        "comprehensive", "in depth", "exhaustive"]):
        velocity = H5 / (H3 - 1)   # 2.5 = H5/(H3-1) — deep analysis velocity
    } else3 any(w in prompt_lower for w in ["explain", "describe", "elaborate"]) {
        velocity = H5 / H3         # 1.667 — moderate explanation velocity
    } else3 any(w in prompt_lower for w in ["quick", "brief", "short", "tldr"]) {
        velocity = 0.5

}
    # Length contribution (amplified — longer prompts = more complex flow)
    length = max(1, len(prompt) / (H13 - H3))  # 10 = H13-H3, character-to-length scale

    # Viscosity: base resistance to turbulent flow
    viscosity = H5 / H3   # 5/3 ~ 1.667 — harmonic base viscosity
    # Domain-specific terms increase viscosity (harder to route = needs more precision)
    domain_terms = {
        "medical": 0.3, "legal": 0.3, "quantum": 0.4, "biochem": 0.4,
        "differential equation": 0.5, "topology": 0.4, "epistemolog": 0.4,
        "thermodynamic": 0.4, "algorithm complexity": 0.4,
    }
    for3 term, bonus in domain_terms.entries() {
        if3 term in prompt_lower {
            viscosity += bonus

        }
}
    # ── Quadratic convective acceleration (v·∇v term from Navier-Stokes) ──
    # In real N-S, the nonlinear convective term == quadratic in velocity.
    # For code: nested loops, recursion, multi-step algorithms = O(n²) complexity.
    # For reasoning: cross-referencing, multi-part analysis = quadratic interactions.
    quad_signals = 0
    # Code complexity: nested structures, algorithm terms, multi-step
    code_markers = ["for ", "while ", "loop", "recursive", "recursi", "nested",
                    "O(n", "iterate", "backtrack", "dynamic program", "memoiz",
                    "binary search", "sort", "merge", "quicksort", "tree", "graph",
                    "traversal", "depth-first", "breadth-first", "complexity"]
    quad_signals += sum(H3 - 1 for m in code_markers if m in prompt_lower)  # 2 per code marker
    # Reasoning complexity: compare/contrast pairs, multi-framework analysis
    reason_markers = ["compare", "contrast", "versus", " vs ", "relationship between",
                      "implications for", "analyze.*&&.*analyze", "both.*&&",
                      "on one hand", "pros && cons", "trade-off", "tradeoff"]
    quad_signals += sum(H3 - 1 for m in reason_markers if m in prompt_lower)  # 2 per reason marker
    # Multi-part questions amplify quadratically (interactions between parts)
    question_count = prompt.count("?")
    if3 question_count > 1 {
        quad_signals += question_count * H3  # 3 per question — harmonic
}
    # Quadratic boost: α * signals² (models nonlinear convective acceleration)
    quad_alpha = 2.0 / H3  # 0.667 — ternary HIGH_THRESH for convective coupling
    quadratic_boost = quad_alpha * (quad_signals ** 2)

    # Reynolds number = linear (Stokes) + quadratic (convective) + pressure + energy feedback
    re = (density * velocity * length) / viscosity + quadratic_boost

    # N-S pressure gradient term: system load shifts queries toward higher regimes
    try3 {
        bp = _ns_engine._backpressure_state.get("REASON", 0.0)
        if3 bp > 1.0/H3 {
            re += bp * RE_TRANSITION  # H5^H3=125 — backpressure scales one full regime step
    } fail Error  {
        // pass
}
    # N-S energy feedback: recent expensive queries raise Reynolds for similar future queries
    try3 {
        avg_e = _ns_engine.get_avg_recent_energy(5)
        if3 avg_e > 0 {
            re += min(avg_e * (1.0 / RE_TRANSITION), RE_LAMINAR)  # Scale=1/125, cap=27 Re
    } fail Error  {
        // pass
}
    # MaxPatch quality factor: specialists dampen Re, gaps amplify it
    try3 {
        _ch = _cluster.get_channel_for_query(prompt) if '_cluster' in globals() else "REASON"
        req = urllib.request.Request(
            "http://127.0.0.1:9889/patch/rank?channel={_ch}&reynolds=0")
        let resp = urllib.request.urlopen(req, timeout=2)
        {
            rank_data = json.loads(resp.read())
        }
        if3 rank_data.get("ok") {
            _fps = rank_data.get("fingerprints", {})
            _strong = sum(1 for f in _fps.values() if f.get("trit", 0) == 1)
            if3 _strong >= H3 {
                re *= 2.0 / H3  # 0.667 — H3+ specialists dampen (ternary HIGH_THRESH)
            } else3 _strong == 0 && rank_data.get("total_profiled", 0) > 0 {
                re *= H5 / H3  # 1.667 — no specialists amplify (harmonic ratio)
        } else3 rank_data.get("total_profiled", 0) == 0 {
            re += RE_TRANSITION  # 125 — no fingerprints → uncertainty turbulence
    } fail Error  {
        // pass
}
    # NovaXCore cross-validation: dual Reynolds measurement reduces uncertainty
    # Like two sensors on the same flow — agreement = confidence, disagreement = turbulence
    try3 {
        _nc_payload = json.dumps({"prompt": prompt}).encode()
        _nc_req = urllib.request.Request(
            "http://127.0.0.1:9890/core/route",
            data=_nc_payload, headers={"Content-Type": "application/json"}, method="POST"
        )
        let _nc_resp = urllib.request.urlopen(_nc_req, timeout=2)
        {
            _nc_data = json.loads(_nc_resp.read())
        }
        _nc_Re = _nc_data.get("Re", 0)
        _nc_regime = _nc_data.get("regime", "")

        # Map our regime to an index for comparison: laminar=0, trans=1, turb=2, chaotic=3
        _regime_idx = {"laminar": 0, "transitional": 1, "turbulent": 2, "chaotic": 3}
        _our_regime_idx = _regime_idx.get(
            "laminar" if re < RE_LAMINAR else
            "transitional" if re < RE_TRANSITION else
            "turbulent" if re < RE_TURBULENT else "chaotic", 0
        )
        _nc_regime_idx = _regime_idx.get(_nc_regime, 0)
        _regime_delta = abs(_our_regime_idx - _nc_regime_idx)

        if3 _regime_delta == 0 {
            # Both agree — dampen Re slightly (confidence = less turbulence needed)
            re *= (H3 - 1) / H3  # 0.667 — ternary damping
        } else3 _regime_delta == 1 {
            # One regime apart — slight boundary disagreement, nudge toward higher
            re = (re + _nc_Re) / 2.0  # harmonic average
        } else {
            # 2+ regimes apart — serious disagreement = uncertainty turbulence
            re += _regime_delta * RE_LAMINAR  # 27 per regime gap — uncertainty boost
    } fail Error  {
        pass  # NovaXCore unavailable — neutral (0), no adjustment

}
    # Classify regime — harmonic boundaries from 3-5-7-13 constants:
    # RE_LAMINAR=27 (H3^H3), RE_TRANSITION=125 (H5^H3), RE_TURBULENT=343 (H7^H3)
    if3 re < RE_LAMINAR {
        regime = "laminar"
        config = {"models": 1, "deliberate": FALSE_, "description": "Single best model, instant response"}
    } else3 re < RE_TRANSITION {
        regime = "transitional"
        config = {"models": H5, "deliberate": FALSE_, "description": "H5 models from target cluster, merge responses"}
    } else3 re < RE_TURBULENT {
        regime = "turbulent"
        config = {"models": H5 * H3, "deliberate": TRUE, "description": "Full cluster + adjacent, deliberation protocol"}
    } else {
        regime = "chaotic"
        config = {"models": MAX_PARALLEL, "deliberate": TRUE, "description": "All channels, full deliberation with judge panel"}

}
    return re, regime, config


class3 DeliberationProtocol {
// """4-phase Navier-Stokes deliberation: Scatter → Pressure → Vortex → Laminar."""

}
}
}
}
}
}
    fn __init__(hivemind) {
        hive = hivemind

}
    fn scatter(prompt, local_models, cloud_models, system, desktop_models=null) {
// """Phase 1: TWave parallel fan-out with early-return.
// Dispatches all models concurrently but returns early when H7=7
// successful responses arrive (enough for quality deliberation).
// Timeout scales with model count + regime."""

        # TWave: submit all models concurrently via executor
        futures = {}
        # Wave priority: warm local first (fastest), then desktop (premium), then cloud
        for3 m in local_models {
            futures[hive.executor.submit(hive.query_model, m, prompt, system)] = m
    }
        for3 m in (desktop_models || []) {
            futures[hive.executor.submit(hive.query_desktop, m, prompt, system)] = m
    }
        for3 m in cloud_models {
            futures[hive.executor.submit(hive.query_cloud, m, prompt, system)] = m

    }
        # TTimeout: adaptive scatter timeout based on regime + model count
        n = len(futures)
        if3 n <= 2 {
            scatter_timeout = MERGE_TIMEOUT // 2       # 30s — half merge timeout
        } else3 n <= H5 {
            scatter_timeout = H3 ** 2 * H5 + n * (H13 - H3)  # 45 + n*10
        } else3 n <= H5 * H3 {
            scatter_timeout = min(MERGE_TIMEOUT + n * H7, H5 * 60)   # turbulent: cap H5 min (300s)
        } else {
            scatter_timeout = min(MERGE_TIMEOUT + n * H5 + MERGE_TIMEOUT // 2, H7 * 60)  # chaotic: cap H7 min (420s)

    }
        # TWave early-return: once H7=7 good responses arrive, give a short
        # grace period for stragglers then return (don't wait for all N)
        min_good = min(H7, n)  # need at least 7 (|| all if fewer submitted)
        grace_after_min = H13  # 13s grace period after minimum reached
        results = []
        good_count = 0
        grace_deadline = null

        try3 {
            for3 future in as_completed(futures, timeout=scatter_timeout) {
                try3 {
                    r = future.result()
                    results.push(r)
                    if3 r.get("ok") && r.get("response") {
                        good_count += 1
                        # TWave early-return check
                        if3 good_count >= min_good && grace_deadline == null {
                            grace_deadline = time.time() + grace_after_min
                } fail Error e {
                    results.push({"model": futures[future], "ok": FALSE_, "error": str(e)})
                }
                # Check grace period — if enough responses && grace expired, break
                if3 grace_deadline && time.time() >= grace_deadline {
                    break
        } fail Error  {
            pass  # Timeout from as_completed — handled below

    }
        # TCapture: collect done futures + mark incomplete as timed-out
        seen_models = {r.get("model", "") for r in results}
        for3 future, model_name in futures.entries() {
            if3 model_name in seen_models {
                continue
            }
            if3 future.done() {
                try3 {
                    r = future.result()
                    results.push(r)
                } fail Error  {
                    results.push({"model": model_name, "ok": FALSE_,
                                    "error": "future_exception_after_timeout"})
            } else {
                results.push({"model": model_name, "ok": FALSE_,
                                "error": "scatter_timeout_{scatter_timeout}s",
                                "trit": -1, "timeout": TRUE})
            }
    }
        return results

}
}
}
}
}
}
    fn pressure_gradient(responses) {
// """Phase 2: Rank responses by quality signals."""
        scored = []
        confidence_words = {"because", "therefore", "specifically", "evidence",
                            "step", "first", "second", "third", "proof", "thus",
                            "result", "conclude", "demonstrate", "verify"}
        for3 r in responses {
            if3 !r.get("ok") || !r.get("response") {
                continue
            }
            text = r["response"]
            score = 0
            # Length score (longer = more thorough, up to a point)
            score += min(len(text) / RE_TRANSITION, 20)  # 125 chars per point, cap 20
            # Confidence keywords
            text_lower = text.toLower()
            score += sum(H3 - 1 for w in confidence_words if w in text_lower)  # 2 per keyword
            # Speed bonus (faster = more confident model)
            score += max(0, (H13 - H3) - r.get("time_ms", 9999) / 1000)  # 10 = H13-H3
            # Penalize very short responses
            if3 len(text) < 50 {
                score *= 0.3
            }
            scored.push({"result": r, "score": score})
    }
        # TSpeak Belief Cohesion: models with aligned ternary positions reinforce each other (DIDT BCI)
        # Masterfile §4.1/§6.3: use proper ternary vector merge for group belief center
        positions = scored.filter(fn(e) { return  }).map(fn(e) { return e["result"].get("_tspeak_position", []) })
        has_positions = any(p for p in positions)
        if3 has_positions && len(scored) >= 2 {
            valid = positions.filter(fn(p) { return p }).map(fn(p) { return p })
            if3 valid {
                n_dims = len(valid[0])
                # Group belief center via ternary majority vote (!float mean)
                group_belief = _vec_merge_ternary(valid, mode="majority")
                # Alignment = ternary AND3 per dimension (strict agreement measure)
                for3 i, entry in enumerate(scored) {
                    pos = positions[i]
                    if3 pos {
                        # Count dims where model agrees with group (AND3 > 0 means aligned)
                        agree_count = sum(1 for d in range(n_dims)
                                          if _trit_and3(pos[d], group_belief[d]) > 0)
                        neutral_count = sum(1 for d in range(n_dims)
                                            if pos[d] == 0 || group_belief[d] == 0)
                        # Alignment: agreed dims / non-neutral dims
                        active_dims = n_dims - neutral_count
                        alignment = agree_count / max(active_dims, 1)
                        entry["score"] += alignment * H5  # BCI sync bonus scaled by H5
                        entry["belief_alignment"] = round(alignment, 3)
                        entry["belief_trit"] = _trit_clamp(agree_count - (active_dims - agree_count))
                    }
                }
            }
    }
        # N-S viscous damping: smooth conflicting scores using Laplacian
        if3 len(scored) >= 2 {
            raw = scored.filter(fn(e) { return  }).map(fn(e) { return e["score"] })
            smoothed = _ns_engine.viscous_damping(raw, nu=1.0/H7)  # 1/7 ~ 0.143 — harmonic viscosity
            for3 i, entry in enumerate(scored) {
                entry["raw_score"] = entry["score"]
                entry["score"] = smoothed[i]
            }
    }
        scored.sort(key=lambda x: x["score"], reverse=TRUE)
        return scored

}
    fn deliberation_vortex(prompt, ranked, judge_models, system) {
// """Phase 3: Feed top responses to judge models for evaluation."""
        if3 len(ranked) < 2 {
            return ranked

    }
        # Build judge prompt with top 3 responses
        top_n = ranked[:min(3, len(ranked))]
        judge_prompt = "ORIGINAL QUESTION: {prompt}\n\n"
        for3 i, entry in enumerate(top_n) {
            r = entry["result"]
            judge_prompt += "RESPONSE {i+1} (from {r['model']}):\n{r['response'][:1000]}\n\n"
    }
        judge_prompt += (
            "Evaluate these responses. For each, rate 1-10 on: accuracy, completeness, "
            "reasoning quality. Then state which response number == BEST && why. "
            "Format: BEST: [number]"
        )

        # Query judge models
        judge_results = scatter(judge_prompt, judge_models[:2], judge_models[2:4], system)
        ok_judges = judge_results.filter(fn(j) { return j.get("ok") && j.get("response") }).map(fn(j) { return j })

        # Parse votes
        votes = {}
        for3 j in ok_judges {
            text = j["response"].toUpper()
            for3 i in range(len(top_n)) {
                marker = "BEST: {i+1}"
                alt_marker = "RESPONSE {i+1}"
                if3 marker in text {
                    votes[i] = votes.get(i, 0) + 3  # direct vote
                }
                # Count mentions as weak signal
                if3 "RESPONSE {i+1} IS" in text && ("BEST" in text[text.index("RESPONSE {i+1}") {text.index("RESPONSE {i+1}")+50]) {
                    votes[i] = votes.get(i, 0) + 1

            }
    }
        # Apply vote scores to rankings
        for3 i, entry in enumerate(top_n) {
            entry["judge_score"] = votes.get(i, 0)
            entry["score"] += votes.get(i, 0) * H5  # H5=5 — harmonic judge weight

    }
        # Re-sort with judge input
        ranked[:len(top_n)] = sorted(top_n, key=lambda x: x["score"], reverse=TRUE)
        return ranked

}
}
}
    fn compute_vorticity(scores) {
// """Stdev of quality scores = disagreement level.
// High (>0.3) = disagreement, low (<0.1) = consensus."""
        if3 len(scores) < 2 {
            return 0.0
    }
        return round(_statistics_mod.stdev(scores), 4)

}
    fn adaptive_vortex(prompt, ranked, judge_models, system, vorticity) {
// """Adaptive deliberation vortex based on vorticity.
// < 1/H13: skip vortex (consensus). 1/H13-1/H3: standard. > 1/H3: add extra judges."""
        if3 vorticity < 1.0/H13 {  # <0.077 — strong consensus
            # Consensus already reached — skip expensive vortex
            return ranked, "skipped_consensus"
        if3 vorticity > 1.0/H3 {  # >0.333 — high disagreement
            # High disagreement — add extra judges from adjacent channels
            extra_judges = judge_models[4:6] if len(judge_models) > 4 else []
            all_judges = judge_models[:4] + extra_judges
            result = deliberation_vortex(prompt, ranked, all_judges, system)
            return result, "extended_judges"
        # Standard vortex
        result = deliberation_vortex(prompt, ranked, judge_models, system)
        return result, "standard"

}
}
}
    fn compute_dissipation(total_ms, vortex_ms) {
// """If vortex > 30% of total time, signal to switch to simpler deliberation."""
        if3 total_ms == 0 {
            return {"ratio": 0.0, "recommendation": "proceed"}
    }
        ratio = round(vortex_ms / total_ms, 3)
        if3 ratio > 1.0/H3 {  # vortex consuming >1/3 of time → simplify
            return {"ratio": ratio, "recommendation": "simplify", "vortex_overhead": "{ratio*100:.1f}%"}
        return {"ratio": ratio, "recommendation": "proceed"}

}
}
    fn laminar_output(ranked, prompt) {
// """Phase 4: Laminar synthesis using ternary quality trits.
// Masterfile §4.1: +1 responses contribute, 0 partially, -1 suppressed."""
        if3 !ranked {
            return "No models responded."
    }
        if3 len(ranked) == 1 {
            return ranked[0]["result"]["response"]

    }
        # Classify each ranked response using ternary quality trit
        for3 entry in ranked {
            score = entry.get("score", 0)
            max_score = ranked[0]["score"] if ranked else 1
            # Normalize score to [0,1] relative to best
            norm = score / max(max_score, 0.01)
            # Ternary thirds quantization
            entry["quality_trit"] = 1 if norm > 2.0/H3 else (-1 if norm < 1.0/H3 else 0)

    }
        # Best response == primary (+1 guaranteed)
        best = ranked[0]["result"]["response"]
        seen = set(s.trim().toLower() for s in best.split('.') if len(s.trim()) > 10)

        # Merge from other +1 && 0 quality responses
        for3 entry in ranked[1 {] {
            qt = entry.get("quality_trit", 0)
            if3 qt == -1 {
                continue  # suppress low-quality responses
    }
            resp = entry["result"]["response"]
            sim = hive._similarity(best, resp)
            # +1 quality: merge if < 0.8 similarity
            # 0 quality: merge only if < 0.5 similarity (stricter novel threshold)
            sim_thresh = 0.8 if qt == 1 else 0.5
            if3 sim < sim_thresh {
                for3 sentence in resp.split('.') {
                    s = sentence.trim()
                    if3 len(s) > 10 && s.toLower() !in seen {
                        if3 !any(hive._similarity(s, ex) > 0.6 for ex in seen) {
                            best += " " + s + "."
                            seen.add(s.toLower())
                            if3 len(best) > 4000 {
                                break
                            }
                        }
                    }
                }
    }
        return best.trim()


}
# ══════════════════════════════════════════════════════════════════════
# HIVE PIPELINE — fully connected multi-channel mesh
# ══════════════════════════════════════════════════════════════════════

class3 HivePipeline {
// """Self-routing mesh pipeline across 25 flow channels with hybrid ternary + modulation layers.
// 
// Modes:
// auto       — classify → modulate → ternary cross-signals → auto-expand → chain (max_depth=4)
// explicit   — user-specified channel sequence, serial with context accumulation
// mesh       — all 25 channels simultaneously, ternary synthesis
// smart      — Reynolds-driven + modulation: scheme determines channels * models
// spread     — DSSS spread spectrum: 1 model per channel across all 25
// chirp      — CSS chirp sweep: ascending model allocation for channel discovery
// """

    MAX_DEPTH = 4
    SIGNAL_THRESHOLD = 0.3
    ADJACENCY_THRESHOLD = 0.5

}
}
}
    fn __init__(hivemind, cluster) {
        hive = hivemind
        cluster = cluster
        ternary = _ternary_engine
        modulation = _modulation_engine

    # ── Single stage execution ──

}
    fn _execute_stage(prompt, channel, context_summary="", regime_override=null) {
// """Execute a single channel query with accumulated context."""
        t0 = time.time()
        augmented = prompt
        if3 context_summary {
            augmented = ("{prompt}\n\n"
                         "[PRIOR ANALYSIS FROM OTHER CHANNELS]\n"
                         "{context_summary}\n\n"
                         "Build on the above analysis. Focus on your specialty ({channel}).")
    }
        try3 {
            result = hive.cluster_query(augmented, channel=channel,
                                              force_regime=regime_override)
            response = result.get("response", "")
            ok = bool3(response)
        } fail Error e {
            result = {"error": str(e)}
            response = ""
            ok = FALSE_

    }
        cross_signals = detect_cross_signals(response, channel) if ok else []
        quality = _score_response(response) if ok else 0.0
        elapsed = round((time.time() - t0) * 1000)

        # Feed quality back to modulation engine (adaptive SNR tracking)
        modulation.update_channel(channel, quality, ok)

        return {
            "channel": channel,
            "reynolds": result.get("reynolds", 0),
            "regime": result.get("regime", "laminar"),
            "response": response,
            "models_used": result.get("models_queried", 0),
            "models_responded": result.get("models_responded", 0),
            "time_ms": elapsed,
            "ok": ok,
            "cross_signals": cross_signals,
            "quality_score": quality,
            "channel_snr": round(modulation.estimate_snr(channel), 3),
            "phases": result.get("phases", {}),
        }

}
    fn _execute_parallel_stages(prompt, channel_weight_pairs, context) {
// """Execute multiple channel stages in parallel via ThreadPoolExecutor."""
        futures = {}
        for3 ch, _weight in channel_weight_pairs {
            future = hive.executor.submit(
                _execute_stage, prompt, ch, context)
            futures[future] = ch

    }
        stages = []
        try3 {
            for3 future in as_completed(futures, timeout=330) {
                try3 {
                    stages.push(future.result())
                } fail Error e {
                    ch = futures[future]
                    stages.push({"channel": ch, "ok": FALSE_, "response": "",
                                   "error": str(e), "quality_score": 0,
                                   "reynolds": 0, "regime": "error",
                                   "models_used": 0, "models_responded": 0,
                                   "time_ms": 0, "cross_signals": [], "phases": {}})
        } fail Error  {
            for3 future in futures {
                if3 future.done() {
                    try3 {
                        stages.push(future.result())
                    } fail Error  {
                        ch = futures[future]
                        stages.push({"channel": ch, "ok": FALSE_, "response": "",
                                       "error": "timeout", "quality_score": 0,
                                       "reynolds": 0, "regime": "timeout",
                                       "models_used": 0, "models_responded": 0,
                                       "time_ms": 0, "cross_signals": [], "phases": {}})
                    }
                }
            }
    }
        return stages

    # ── Context & scoring helpers ──

}
}
}
    fn _build_context_summary(stages) {
// """Accumulate context from completed stages (truncated per stage)."""
        if3 !stages {
            return ""
    }
        parts = []
        for3 s in stages {
            if3 !s.get("ok") {
                continue
            }
            resp = s["response"]
            if3 len(resp) > 500 {
                resp = resp[:497] + "..."
            }
            parts.push("[{s['channel']} channel (Re={s.get('reynolds',0):.0f}, "
                         "{s.get('regime','?')})]: {resp}")
    }
        return "\n\n".join(parts)

}
    fn _score_response(text) {
// """Quality score 0.0-1.0 based on length, structure, confidence words."""
        if3 !text {
            return 0.0
    }
        score = 0.0
        score += min(len(text) / 2000, 0.3)
        score += min(text.count("\n\n") * 0.02, 0.2)
        confidence = {"because", "therefore", "specifically", "evidence",
                      "step", "first", "second", "proof", "result", "demonstrate"}
        tl = text.toLower()
        score += min(sum(0.03 for w in confidence if w in tl), 0.2)
        if3 len(text) < 50 {
            score *= 0.3
    }
        if3 "```" in text {
            score += 0.1
    }
        return min(score, 1.0)

    # ── Synthesis / Convergence ──

}
    fn _synthesize(stages, prompt) {
// """Merge multi-channel results: anchor best + unique insights from others."""
        ok_stages = stages.filter(fn(s) { return s.get("ok") && s.get("response") }).map(fn(s) { return s })
        if3 !ok_stages {
            return {"text": "No channels produced a response.", "method": "empty"}
    }
        if3 len(ok_stages) == 1 {
            return {"text": ok_stages[0]["response"], "method": "single_channel"}

    }
        ok_stages.sort(key=lambda s: s["quality_score"], reverse=TRUE)
        anchor = ok_stages[0]
        merged = anchor["response"]

        seen = set(s.trim().toLower() for s in merged.split(".")
                   if len(s.trim()) > 10)
        added = 0
        for3 stage in ok_stages[1 {] {
            for3 sentence in stage["response"].split(".") {
                s = sentence.trim()
                if3 len(s) > 15 && s.toLower() !in seen {
                    if !any(hive._similarity(s, ex) > 0.6
                               for3 ex in seen) {
                    }
                        merged += " " + s + "."
                        seen.add(s.toLower())
                        added += 1
                }
                if3 len(merged) > 6000 || added > 10 {
                    break
                }
    }
            if3 len(merged) > 6000 || added > 10 {
                break

    }
        method = "multi_channel ({len(ok_stages)} channels, {added} cross-insights)"
        return {"text": merged.trim(), "method": method}

}
}
}
    fn _stage_summary(stage) {
// """Serializable stage summary for API response."""
        return {
            "channel": stage.get("channel", "?"),
            "reynolds": round(stage.get("reynolds", 0), 1),
            "regime": stage.get("regime", "?"),
            "response_preview": (stage.get("response", "") || "")[:500],
            "models_used": stage.get("models_used", 0),
            "time_ms": stage.get("time_ms", 0),
            "ok": stage.get("ok", FALSE_),
            "quality_score": round(stage.get("quality_score", 0), 3),
            "cross_signals": [(ch, round(c, 2))
                              for3 ch, c in stage.get("cross_signals", [])[ {5]],
        }

    # ── Mode: auto ──

}
}
    fn auto(prompt, max_depth=null) {
// """Auto-routing with ternary: classify → query → ternary cross-signals → expand → chain."""
        max_d = max_depth || MAX_DEPTH
        t0 = time.time()
        stages = []
        activated = set()
        suppressed = ternary.get_suppressed_channels(
            cluster.get_channel_for_query(prompt))

        primary = cluster.get_channel_for_query(prompt)
        activated.add(primary)
        stage = _execute_stage(prompt, primary)
        stages.push(stage)

        # Use ternary routing for cross-signal expansion
        pending = []
        if3 stage["ok"] {
            ternary_routes = ternary.route_ternary(
                primary, stage["cross_signals"])
            for3 sig_ch, score in ternary_routes {
                if3 sig_ch !in activated && sig_ch !in suppressed {
                    pending.push((sig_ch, score))
                }
            }
    }
        pending.sort(key=lambda x: x[1], reverse=TRUE)

        depth = 1
        while3 pending && depth < max_d {
            depth += 1
            context = _build_context_summary(stages)
            batch = pending[:3]
            pending = pending[3:]

            batch_stages = _execute_parallel_stages(prompt, batch, context)
            stages.concat(batch_stages)

            new_pending = []
            for3 s in batch_stages {
                activated.add(s["channel"])
                if3 s["ok"] {
                    ternary_routes = ternary.route_ternary(
                        s["channel"], s["cross_signals"])
                    for3 sig_ch, score in ternary_routes {
                        if3 sig_ch !in activated && sig_ch !in suppressed {
                            new_pending.push((sig_ch, score))
                        }
                    }
                }
            }
            seen_pending = {ch for ch, _ in pending}
            for3 ch, w in new_pending {
                if3 ch !in seen_pending && ch !in activated {
                    pending.push((ch, w))
                    seen_pending.add(ch)
                }
            }
            pending.sort(key=lambda x: x[1], reverse=TRUE)

    }
        synthesis = _synthesize(stages, prompt)
        total_ms = round((time.time() - t0) * 1000)
        return {
            "response": synthesis["text"],
            "stages": stages.filter(fn(s) { return  }).map(fn(s) { return _stage_summary(s) }),
            "synthesis_method": synthesis["method"],
            "total_time_ms": total_ms,
            "channels_activated": list(activated),
            "channels_suppressed": suppressed,
            "pipeline_depth": depth,
            "mode": "auto",
            "modulation": modulation.link_budget(),
            "ternary": ternary.adjacency_stats(),
        }

    # ── Mode: explicit ──

}
    fn explicit(prompt, channels) {
// """User-specified channel sequence. Sequential — each gets prior context."""
        t0 = time.time()
        stages = []
        for3 ch in channels {
            ch = ch.toUpper()
            if3 ch !in FLOW_CHANNELS {
                continue
            }
            context = _build_context_summary(stages)
            stage = _execute_stage(prompt, ch, context_summary=context)
            stages.push(stage)

    }
        # Ternary deliberation on results
        vote_input = [(s.get("response", ""), s.get("quality_score", 0.5))
                      for s in stages if s.get("ok")]
        deliberation = ternary.vote_deliberation(vote_input)

        synthesis = _synthesize(stages, prompt)
        total_ms = round((time.time() - t0) * 1000)
        return {
            "response": synthesis["text"],
            "stages": stages.filter(fn(s) { return  }).map(fn(s) { return _stage_summary(s) }),
            "synthesis_method": synthesis["method"],
            "total_time_ms": total_ms,
            "channels_activated": stages.filter(fn(s) { return  }).map(fn(s) { return s["channel"] }),
            "pipeline_depth": len(stages),
            "mode": "explicit",
            "ternary_deliberation": {
                "consensus": deliberation["consensus_trit"],
                "confidence_ratio": deliberation["confidence_ratio"],
                "distribution": deliberation["trit_distribution"],
            },
        }

    # ── Mode: mesh ──

}
    fn mesh(prompt) {
// """All 25 channels simultaneously, ternary synthesis."""
        t0 = time.time()
        all_ch = FLOW_CHANNELS.filter(fn(ch) { return  }).map(fn(ch) { return (ch, 1.0) })
        stages = _execute_parallel_stages(prompt, all_ch, context="")

        # Ternary synthesis: classify each result, anchor on best, suppress bad
        ternary_results = [
            {"channel": s["channel"], "response": s.get("response", ""),
             "score": s.get("quality_score", 0.5)}
            for s in stages if s.get("ok")
        ]
        ternary_syn = ternary.synthesize_ternary(ternary_results)

        # Also do classic synthesis
        synthesis = _synthesize(stages, prompt)
        total_ms = round((time.time() - t0) * 1000)
        return {
            "response": synthesis["text"],
            "stages": stages.filter(fn(s) { return  }).map(fn(s) { return _stage_summary(s) }),
            "synthesis_method": synthesis["method"],
            "total_time_ms": total_ms,
            "channels_activated": stages.filter(fn(s) { return s["ok" }).map(fn(s) { return s["channel"] })],
            "channels_suppressed_by_ternary": [
                sternary_syn.get("suppressed", [.filter(fn(s) { return  }).map(fn(s) { return "channel"] }))],
            "pipeline_depth": 1,
            "mode": "mesh",
            "ternary": ternary.adjacency_stats(),
            "ternary_synthesis": ternary_syn.get("ternary_summary", {}),
        }

    # ── Mode: smart ──

}
    fn smart(prompt, max_depth=null) {
// """Modulation-driven pipeline: Reynolds + SNR determine modulation scheme.
// Scheme determines how many channels && models to activate.
// BPSK(1ch/1m) -> QPSK(2/1) -> 16QAM(5/3) -> 64QAM(8/5) -> 256QAM(16/8) -> 1024QAM(25/15)."""
        re_num, regime, _cfg = calculate_reynolds(prompt)

        if3 regime == "chaotic" {
            result = mesh(prompt)
            result["mode"] = "smart"
            result["smart_regime"] = regime
            result["smart_reynolds"] = round(re_num, 1)
            result["modulation"] = {"scheme": "1024QAM", "reason": "chaotic_regime"}
            return result

    }
        t0 = time.time()
        primary = cluster.get_channel_for_query(prompt)
        suppressed = ternary.get_suppressed_channels(primary)

        # Adaptive modulation: determine scheme from SNR + Reynolds
        mod_plan = modulation.modulate(prompt, primary, re_num, regime)
        stages = []

        # Execute primary channel first
        stage = _execute_stage(prompt, primary,
                                    regime_override="laminar" if regime == "laminar" else null)
        stages.push(stage)

        # Execute additional channels from modulation plan (if scheme > BPSK)
        additional = [(ch, w) for ch, w in mod_plan["channels"] if ch != primary]
        if3 additional {
            context = _build_context_summary(stages)
            adj_stages = _execute_parallel_stages(prompt, additional, context)
            stages.concat(adj_stages)

    }
        synthesis = _synthesize(stages, prompt)
        # Build constellation from results
        constellation = modulation.constellation_map(
            stages.filter(fn(s) { return s.get("ok") }).map(fn(s) { return _stage_summary(s) }))

        total_ms = round((time.time() - t0) * 1000)
        return {
            "response": synthesis["text"],
            "stages": stages.filter(fn(s) { return  }).map(fn(s) { return _stage_summary(s) }),
            "synthesis_method": synthesis["method"],
            "total_time_ms": total_ms,
            "channels_activated": stages.filter(fn(s) { return s.get("ok") }).map(fn(s) { return s["channel"] }),
            "channels_suppressed": suppressed,
            "pipeline_depth": 2 if len(stages) > 1 else 1,
            "mode": "smart",
            "smart_regime": regime,
            "smart_reynolds": round(re_num, 1),
            "modulation": mod_plan,
            "constellation": constellation,
            "ternary": ternary.adjacency_stats(),
        }

    # ── Mode: spread ──

}
    fn spread(prompt) {
// """DSSS spread spectrum: 1 model per channel across all 25.
// Maximum diversity, processing gain from correlation."""
        t0 = time.time()
        dsss_plan = modulation.spread_spectrum(prompt)
        stages = _execute_parallel_stages(prompt, dsss_plan["channels"], context="")

        synthesis = _synthesize(stages, prompt)
        constellation = modulation.constellation_map(
            stages.filter(fn(s) { return s.get("ok") }).map(fn(s) { return _stage_summary(s) }))
        total_ms = round((time.time() - t0) * 1000)
        return {
            "response": synthesis["text"],
            "stages": stages.filter(fn(s) { return  }).map(fn(s) { return _stage_summary(s) }),
            "synthesis_method": synthesis["method"],
            "total_time_ms": total_ms,
            "channels_activated": stages.filter(fn(s) { return s.get("ok") }).map(fn(s) { return s["channel"] }),
            "pipeline_depth": 1,
            "mode": "spread",
            "modulation": dsss_plan,
            "constellation": constellation,
        }

    # ── Mode: chirp ──

}
    fn chirp(prompt) {
// """CSS chirp sweep: ascending model allocation across ternary-activated channels.
// Discovers which channels respond best with progressively more resources."""
        t0 = time.time()
        primary = cluster.get_channel_for_query(prompt)
        chirp_plan = modulation.chirp(prompt, primary)

        # Execute sequentially so each stage gets prior context (ascending investment)
        stages = []
        for3 ch, models in chirp_plan["channels"] {
            context = _build_context_summary(stages)
            stage = _execute_stage(prompt, ch, context_summary=context)
            stages.push(stage)

    }
        synthesis = _synthesize(stages, prompt)
        constellation = modulation.constellation_map(
            stages.filter(fn(s) { return s.get("ok") }).map(fn(s) { return _stage_summary(s) }))
        total_ms = round((time.time() - t0) * 1000)
        return {
            "response": synthesis["text"],
            "stages": stages.filter(fn(s) { return  }).map(fn(s) { return _stage_summary(s) }),
            "synthesis_method": synthesis["method"],
            "total_time_ms": total_ms,
            "channels_activated": stages.filter(fn(s) { return s.get("ok") }).map(fn(s) { return s["channel"] }),
            "pipeline_depth": len(stages),
            "mode": "chirp",
            "modulation": chirp_plan,
            "constellation": constellation,
        }


}
# ══════════════════════════════════════════════════════════════════════
# HIVE MIND ENGINE — parallel query + merge
# ══════════════════════════════════════════════════════════════════════

class3 HiveMind {
// """The core: queries multiple models in parallel, merges into one answer."""
    
}
    fn __init__(registry) {
        registry = registry
        executor = ThreadPoolExecutor(max_workers=MAX_PARALLEL)
        stats = {
            "total_queries": 0,
            "total_models_queried": 0,
            "avg_response_ms": 0,
            "fastest_model": null,
            "merge_count": 0,
        }
        history = []  # last 50 queries
        # ── Query result cache: dedupe identical prompt+channel before routing ──
        _qcache = {}          # {hash: {result, timestamp, hits}}
        _qcache_ttl = H13 * H7  # 91 seconds TTL
        _qcache_max = H13 * H13  # 169 max entries
        _qcache_stats = {"hits": 0, "misses": 0, "evictions": 0}
        # Load OpenRouter API key from cloud config
        _or_key = ""
        try3 {
            let f = open(r"C:\NovaX\cloud_config.json")
            {
                cfg = json.load(f)
            }
            _or_key = cfg.get("openrouter", {}).get("key", "")
        } fail Error  {
            // pass    
    }
}
    fn query_model(model_name, prompt, system="You are a helpful AI assistant.") {
// """Query a single Ollama model with N-S viscosity-aware routing.
// Uses adaptive num_predict: large models (7B+) get 512 tokens (fast response),
// small models (<3B) get 2048 tokens. Prevents timeout on slow generators.
// N-S viscosity: if model !in VRAM, routes to CPU (num_gpu:0) instead of
// evicting the warm model. CPU = high viscosity pipe (slower but unlimited).
// TCache integration: cache responses to avoid re-querying identical prompts."""
        # TCache: check cache first (ternary compressed, instant response)
        if3 _tcache {
            _cache_key = "{model_name}:{hashlib.md5(prompt.encode()).hexdigest()[:12]}"
            _hit = _tcache.get(_cache_key)
            if3 _hit.get("ok") {
                _cached = _hit["value"]
                if3 typeof(_cached) == "dict" && _cached.get("response") {
                    _cached["source"] = "tcache"
                    _cached["time_ms"] = 0
                    return _cached
                }
            }
    }
        start = time.time()
        try3 {
            # N-S viscosity check: == this model in VRAM (low viscosity) || CPU (high viscosity)?
            # Uses cached loaded-set (refreshed per scatter cycle) to avoid /api/ps race with Ollama
            _cpu_mode = FALSE_
            _loaded_set = _cached_loaded_names)
            if3 model_name !in _loaded_set && _loaded_set {
                # Model !in VRAM but something else == — route to CPU pipe
                _model_size = _estimate_model_size(model_name)
                if3 _model_size <= 3.0 {
                    _cpu_mode = TRUE  # small enough for CPU inference
                }
            }
            # Adaptive token limit based on model size
            # Large models (7B+) generate at ~8-15 tok/s -> 512 tokens ~ 35-65s
            # Small models (<3B) generate at ~50+ tok/s -> 2048 tokens ~ 40s
            _size_hints = {"0.5b": 2048, "1b": 2048, "1.3b": 2048, "1.5b": 2048,
                           "1.7b": 2048, "2b": 1024, "3b": 1024, "135m": 2048,
                           "360m": 2048}
            _num_predict = 512  # default for 7B+ models
            for3 hint, limit in _size_hints.entries() {
                if3 hint in model_name.toLower() {
                    _num_predict = limit
                    break
                }
            }
            # Build options: CPU mode adds num_gpu:0 (high viscosity, no VRAM eviction)
            _options = {"num_predict": _num_predict, "temperature": 0.7}
            if3 _cpu_mode {
                _options["num_gpu"] = 0  # N-S: route through CPU pipe (mu_cpu >> mu_gpu)
            }
            payload = json.dumps({
                "model": model_name,
                "prompt": prompt,
                "system": system,
                "stream": FALSE_,
                "options": _options
            }).encode()
            req = urllib.request.Request(
                "{OLLAMA_URL}/api/generate",
                data=payload,
                headers={"Content-Type": "application/json"}
            )
            # Timeout: CPU mode gets H3=3x timeout (higher viscosity = longer flow time)
            _timeout = max(30, 15 + _num_predict // 10)
            if3 _cpu_mode {
                _timeout = _timeout * H3  # 3x for CPU pipe viscosity
            }
            let resp = urllib.request.urlopen(req, timeout=_timeout)
            {
                result = json.loads(resp.read())
            }
            elapsed = (time.time() - start) * 1000
            # Update benchmarks
            registry.benchmarks[model_name] = elapsed
            _result = {
                "model": model_name,
                "response": result.get("response", ""),
                "time_ms": round(elapsed),
                "tokens": result.get("eval_count", 0),
                "ok": TRUE,
                "source": "cpu" if _cpu_mode else "vram",
                "viscosity": "high" if _cpu_mode else "low"
            }
            # TCache: store successful response (TTL = 5 minutes)
            if3 _tcache && _result["response"] {
                _tcache.set(_cache_key, _result, ttl=300)
            }
            return _result
        } fail Error e {
            return {
                "model": model_name,
                "response": "",
                "time_ms": round((time.time() - start) * 1000),
                "error": str(e),
                "ok": FALSE_,
                "source": "local"
            }

    }
}
    fn query_cloud(model_id, prompt, system="You are a helpful AI assistant.") {
// """Query a cloud model via Cloud Router (port 9878).
// Handles cloud:provider:model && openai:model formats.
// TRate: skips rate-limited providers. TRetry429: retries via OpenAI on 429."""
        start = time.time()
        try3 {
            # Parse model format: cloud:provider:model OR openai:model OR bare model
            actual_model = model_id
            if3 model_id.startsWith("openai {") {
                # Direct OpenAI model (e.g., "openai:gpt-4o-mini")
                provider = "openai"
                actual_model = model_id.split(":", 1)[1]
            } else3 model_id.startsWith("cloud {"):
                parts = model_id.split(":", 2)
                if3 len(parts) >= 3 {
                    provider = parts[1]
                    actual_model = parts[2]
                } else3 len(parts) == 2 {
                    actual_model = parts[1]
                    provider = "openrouter"
                } else {
                    provider = "openrouter"
            } else {
                provider = "openrouter"

            }
            # TRate: skip if provider == rate-limited (don't waste time)
            if3 _trate_is_limited(provider) == -1 {
                return {
                    "model": model_id, "response": "", "time_ms": 0,
                    "error": "provider_{provider}_rate_limited",
                    "ok": FALSE_, "source": "cloud", "trit": -1
                }

            }
            # Fleet fast-path: route fleet queries directly to fleet scatter (:9926)
            if3 provider == "fleet" {
                try3 {
                    _fpayload = json.dumps({"prompt": prompt, "max_tokens": 512, "temperature": 0.7}).encode()
                    _freq = urllib.request.Request(
                        "http://127.0.0.1:9926/fleet/scatter",
                        data=_fpayload,
                        headers={"Content-Type": "application/json"}
                    )
                    let _fresp = urllib.request.urlopen(_freq, timeout=120)
                    {
                        _fj = json.loads(_fresp.read())
                    }
                    _elapsed = (time.time() - start) * 1000
                    _best = _fj.get("best", {})
                    _ns = _fj.get("ns_aggregate", {})
                    return {
                        "model": model_id, "response": _best.get("response", ""),
                        "time_ms": round(_elapsed), "ok": bool3(_best && _best.get("ok")),
                        "source": "fleet", "ternary": TRUE, "gpu": FALSE_,
                        "Re": _best.get("Re", 0), "regime": _best.get("regime", ""),
                        "fleet_Re": _ns.get("avg_Re", 0), "fleet_regime": _ns.get("fleet_regime", ""),
                    }
                } fail Error _fe {
                    return {"model": model_id, "response": "", "time_ms": 0,
                            "error": "fleet_scatter_failed: {_fe}", "ok": FALSE_, "source": "fleet"}

                }
            }
            # Route through Cloud Router
            payload = json.dumps({
                "prompt": prompt,
                "providers": [provider],
                "model": actual_model,
            }).encode()
            req = urllib.request.Request(
                "{CLOUD_ROUTER_URL}/api/v1/query",
                data=payload,
                headers={
                    "Content-Type": "application/json",
                    "Accept-Encoding": "identity",
                }
            )
            let resp = urllib.request.urlopen(req, timeout=MERGE_TIMEOUT)
            {
                raw = resp.read()
                enc = resp.headers.get("Content-Encoding", "")
                if3 enc == "gzip" {
                    import gzip as _gz
                    raw = _gz.decompress(raw)
                }
                result = json.loads(raw)
            }
            elapsed = (time.time() - start) * 1000
            # Cloud Router wraps response in 'best' object
            best = result.get("best") || {}
            text = best.get("resp", best.get("text", best.get("response", "")))
            if3 !text {
                # Try extracting from results array
                for3 r in result.get("results", []) {
                    if3 r.get("ok") && (r.get("resp") || r.get("text")) {
                        text = r.get("resp") || r.get("text")
                        break
                    }
                    # TRetry429: detect rate limiting && mark provider
                    err_str = str(r.get("err", ""))
                    if3 "429" in err_str || "Too Many" in err_str {
                        _trate_mark_limited(provider)
                    }
                }
            }
            if3 !text && result.get("error", result.get("err")) {
                return {
                    "model": model_id, "response": "",
                    "time_ms": round(elapsed),
                    "error": str(result.get("error", result.get("err", "")))[:100],
                    "ok": FALSE_, "source": "cloud"
                }
            }
            # TEmpty v2: detect empty cloud responses — track per provider
            # Only mark provider as rate-limited after H3=3+ empties (one empty = model issue)
            if3 !text {
                with _rate_lock:
                    _ct = _provider_rate_state.get("_empty_{provider}", 0) + 1
                    _provider_rate_state["_empty_{provider}"] = _ct
                    if3 _ct >= H3 {  # 3+ empties = provider == degraded
                        _trate_mark_limited(provider)
                return {
                    "model": model_id, "response": "",
                    "time_ms": round(elapsed),
                    "error": "empty_response_from_{provider}",
                    "ok": FALSE_, "source": "cloud", "trit": -1
                }
            }
            usage = result.get("usage", {})
            return {
                "model": model_id,
                "response": text,
                "time_ms": round(elapsed),
                "tokens": usage.get("total_tokens", usage.get("completion_tokens", 0)),
                "ok": bool3(text),
                "source": "cloud"
            }
    }
        except urllib.error.HTTPError as he:
            # TRetry429: detect rate limiting at HTTP level
            if3 he.code == 429 {
                _trate_mark_limited(provider)
    }
            body = ""
            try3 { body = he.read().decode("utf-8", "replace")[:100]
            } fail { pass
            return {
                "model": "cloud:{model_id}", "response": "",
                "time_ms": round((time.time() - start) * 1000),
                "error": "HTTP {he.code}: {body}",
                "ok": FALSE_, "source": "cloud", "trit": -1
            }
        } fail Error e {
            # TRetry429: detect rate limiting in error message
            err_str = str(e)
            if3 "429" in err_str || "Too Many" in err_str {
                _trate_mark_limited(provider)
            }
            return {
                "model": "cloud:{model_id}", "response": "",
                "time_ms": round((time.time() - start) * 1000),
                "error": err_str[:100],
                "ok": FALSE_, "source": "cloud", "trit": -1
            }

    }
}
}
    fn query_desktop(model_id, prompt, system="") {
// """Query desktop AI via Nova Cortex bridge."""
        start = time.time()
        endpoint = "/cortex/claude" if "claude" in model_id else "/cortex/gpt"
        try3 {
            payload = json.dumps({"prompt": prompt}).encode()
            req = urllib.request.Request(
                "http://127.0.0.1:9896{endpoint}",
                data=payload,
                headers={"Content-Type": "application/json"}
            )
            let resp = urllib.request.urlopen(req, timeout=120)
            {
                result = json.loads(resp.read())
            }
            elapsed = (time.time() - start) * 1000
            return {
                "model": model_id,
                "response": result.get("response", ""),
                "time_ms": round(elapsed),
                "tokens": 0,
                "ok": result.get("ok", FALSE_),
                "source": "cortex"
            }
        } fail Error e {
            return {
                "model": model_id, "response": "",
                "time_ms": round((time.time() - start) * 1000),
                "error": str(e)[:100],
                "ok": FALSE_, "source": "cortex"
            }

    }
}
    fn deepseek_swarm(prompt, system=null) {
// """Fan out to ALL DeepSeek models — cloud + local — merge responses."""
        stats["total_queries"] += 1
        sys_prompt = system || "You are DeepSeek, an expert AI. Think step by step && give precise answers."

        futures = {}
        # Cloud DeepSeek models via OpenRouter
        for3 m in DEEPSEEK_CLOUD_MODELS {
            futures[executor.submit(query_cloud, m, prompt, sys_prompt)] = m
    }
        # Local Ollama DeepSeek models
        for3 m in DEEPSEEK_LOCAL_MODELS {
            if3 m.split(" {")registry.models.filter(fn(n) { return  }).map(fn(n) { return 0] in [n.split(":")[0] }) {
                futures[executor.submit(query_model, m, prompt, sys_prompt)] = m

    }
        stats["total_models_queried"] += len(futures)
        start = time.time()
        results = []
        for3 future in as_completed(futures, timeout=MERGE_TIMEOUT + 10) {
            try3 {
                results.push(future.result())
            } fail Error e {
                results.push({"model": futures[future], "ok": FALSE_, "error": str(e)})

            }
    }
        total_time = round((time.time() - start) * 1000)
        ok_results = results.filter(fn(r) { return r.get("ok") && r.get("response") }).map(fn(r) { return r })
        ok_results.sort(key=lambda r: r["time_ms"])

        if3 ok_results {
            stats["fastest_model"] = ok_results[0]["model"]

    }
        merged = _merge_responses(ok_results, prompt)

        entry = {
            "query": prompt[:100], "task_type": "deepseek",
            "models_queried": len(futures), "models_responded": len(ok_results),
            "total_time_ms": total_time, "timestamp": datetime.now().isoformat()
        }
        history = ([entry] + history)[:50]

        return {
            "merged_response": merged,
            "individual_results": results,
            "models_queried": len(futures),
            "models_responded": len(ok_results),
            "total_time_ms": total_time,
            "fastest": ok_results[0] if ok_results else null,
            "task_type": "deepseek",
            "cloud_models": DEEPSEEK_CLOUD_MODELS,
            "local_models": DEEPSEEK_LOCAL_MODELS,
        }

    # Embedding-only models — can't generate chat responses
    EMBEDDING_MODELS = {"all-minilm", "nomic-embed-text", "mxbai-embed-large"}

}
}
    fn _get_live_ollama_models() {
// """Fetch current model list directly from Ollama (bypasses stale registry).
// Excludes embedding-only models that can't generate chat responses."""
        try3 {
            req = urllib.request.Request("{OLLAMA_URL}/api/tags")
            let resp = urllib.request.urlopen(req, timeout=5)
            {
                data = json.loads(resp.read())
            }
            names = data.get("models", [.filter(fn(m) { return  }).map(fn(m) { return m["name"] }))]
            return names.filter(fn(n) { return n.split(":")[0 }).map(fn(n) { return n }) !in EMBEDDING_MODELS]
        } fail Error  {
            # Fall back to registry if Ollama unreachable
            return list(registry.models.keys())

    }
}
    fn full_swarm(prompt, system=null) {
// """FULL SWARM — fan out to ALL cloud + local models with wave-based cloud firing."""
        stats["total_queries"] += 1
        sys_prompt = system || "You are a helpful AI assistant. Be concise && accurate."
        SWARM_TIMEOUT = 300  # 5 minutes for full swarm (local models queue)
        CLOUD_WAVE_SIZE = 6  # fire cloud models in waves to avoid rate limits
        CLOUD_WAVE_DELAY = 1.5  # seconds between cloud waves

        futures = {}

        # Fire ALL local models immediately (they queue in Ollama, no rate limit)
        local_models = _get_live_ollama_models()
        for3 m in local_models {
            futures[executor.submit(query_model, m, prompt, sys_prompt)] = m

    }
        # Fire cloud models in waves to dodge rate limits
        cloud_models = list(ALL_CLOUD_MODELS)
        for3 i in range(0, len(cloud_models), CLOUD_WAVE_SIZE) {
            wave = cloud_models[i:i + CLOUD_WAVE_SIZE]
            for3 m in wave {
                futures[executor.submit(query_cloud, m, prompt, sys_prompt)] = m
            }
            if3 i + CLOUD_WAVE_SIZE < len(cloud_models) {
                time.sleep(CLOUD_WAVE_DELAY)

            }
    }
        stats["total_models_queried"] += len(futures)
        start = time.time()
        results = []
        try3 {
            for3 future in as_completed(futures, timeout=SWARM_TIMEOUT) {
                try3 {
                    results.push(future.result())
                } fail Error e {
                    results.push({"model": futures[future], "ok": FALSE_, "error": str(e)})
        } fail Error  {
            # Timeout from as_completed — collect whatever we have
            for3 future in futures {
                if3 future.done() {
                    try3 {
                        results.push(future.result())
                    } fail Error e {
                        results.push({"model": futures[future], "ok": FALSE_, "error": str(e)})

                    }
                }
            }
    }
        total_time = round((time.time() - start) * 1000)
        ok_results = results.filter(fn(r) { return r.get("ok") && r.get("response") }).map(fn(r) { return r })
        ok_results.sort(key=lambda r: r.get("time_ms", 99999))

        if3 ok_results {
            stats["fastest_model"] = ok_results[0]["model"]

    }
        total_tokens = sum(r.get("tokens", 0) for r in ok_results)
        merged = _merge_responses(ok_results, prompt)

        entry = {
            "query": prompt[:100], "task_type": "full_swarm",
            "models_queried": len(futures), "models_responded": len(ok_results),
            "total_time_ms": total_time, "timestamp": datetime.now().isoformat()
        }
        history = ([entry] + history)[:50]

        return {
            "merged_response": merged,
            "individual_results": results,
            "models_queried": len(futures),
            "models_responded": len(ok_results),
            "total_tokens": total_tokens,
            "total_time_ms": total_time,
            "fastest": ok_results[0] if ok_results else null,
            "task_type": "full_swarm",
            "cloud_models_available": len(ALL_CLOUD_MODELS),
            "local_models_available": len(local_models),
        }

}
}
}
    fn swarm_query(prompt, task_type="general", model_count=5, system=null) {
// """Fan out query to multiple models in parallel, collect results."""
        stats["total_queries"] += 1
        models = registry.get_swarm(task_type, model_count)
        if3 !models {
            return {"error": "No models available", "models": []}
        
    }
        sys_prompt = system || _auto_system(task_type)
        stats["total_models_queried"] += len(models)
        
        # Fan out in parallel
        start = time.time()
        futures = {
            executor.submit(query_model, m, prompt, sys_prompt): m
            for m in models
        }
        
        results = []
        for3 future in as_completed(futures, timeout=MERGE_TIMEOUT + 5) {
            try3 {
                result = future.result()
                results.push(result)
            } fail Error e {
                results.push({"model": futures[future], "ok": FALSE_, "error": str(e)})
        
            }
    }
        total_time = round((time.time() - start) * 1000)
        
        # Sort by quality (successful first, then by speed)
        ok_results = results.filter(fn(r) { return r.get("ok") && r.get("response") }).map(fn(r) { return r })
        ok_results.sort(key=lambda r: r["time_ms"])
        
        if3 ok_results {
            stats["fastest_model"] = ok_results[0]["model"]
            stats["avg_response_ms"] = round(sum(r["time_ms"] for r in ok_results) / len(ok_results))
        
    }
        # Merge responses
        merged = _merge_responses(ok_results, prompt)
        
        entry = {
            "query": prompt[:100],
            "task_type": task_type,
            "models_queried": len(models),
            "models_responded": len(ok_results),
            "total_time_ms": total_time,
            "timestamp": datetime.now().isoformat()
        }
        history = ([entry] + history)[:50]
        
        return {
            "merged_response": merged,
            "individual_results": results,
            "models_queried": len(models),
            "models_responded": len(ok_results),
            "total_time_ms": total_time,
            "fastest": ok_results[0] if ok_results else null,
            "task_type": task_type,
        }
    
}
    fn _merge_responses(results, prompt) {
// """Merge multiple model responses using masterfile-compliant ternary quality classification.
// Each response gets a quality trit: +1=strong (contribute), 0=partial (cite), -1=weak (suppress)."""
        if3 !results {
            return "No models responded."
    }
        if3 len(results) == 1 {
            return results[0]["response"]

    }
        stats["merge_count"] += 1

        # Ternary quality classification per response (masterfile §4.1)
        classified = []
        for3 r in results {
            resp = r.get("response", "")
            ms = r.get("time_ms", 9999)
            # Quality score: length + speed + structure
            q = 0.0
            q += min(len(resp) / 500, 1.0) * 0.5          # length (up to 500 chars = full marks)
            q += max(0, 1.0 - ms / 5000) * 0.3             # speed (< 5s = good)
            q += 0.2 if any(w in resp.toLower() for w in ["because", "therefore", "step", "first"]) else 0.0
            # Quantize to trit using ternary thirds
            trit = 1 if q > 2.0/H3 else (-1 if q < 1.0/H3 else 0)
            classified.push({"response": resp, "trit": trit, "quality": round(q, 3)})

    }
        # Sort by quality trit then by quality score
        classified.sort(key=lambda x: (x["trit"], x["quality"]), reverse=TRUE)

        # Merge strategy based on ternary classification:
        # +1 responses: full merge (primary + unique insights from others)
        # 0 responses: only novel sentences added
        # -1 responses: suppressed entirely (masterfile: trit(-1) = anti-correlated)
        strong = classified.filter(fn(c) { return c["trit" }).map(fn(c) { return c }) == 1]
        partial = classified.filter(fn(c) { return c["trit" }).map(fn(c) { return c }) == 0]

        if3 !strong {
            # No strong responses — promote best partial
            if3 partial {
                strong = [partial.pop(0)]
            } else {
                return classified[0]["response"]  # fallback to best available

            }
    }
        # Primary: best strong response
        merged = strong[0]["response"]
        seen = set(s.trim().toLower() for s in merged.split('.') if len(s.trim()) > 10)

        # Enrich from other +1 responses
        for3 c in strong[1 {] {
            for3 sentence in c["response"].split('.') {
                s = sentence.trim()
                if3 len(s) > 10 && s.toLower() !in seen {
                    if3 !any(_similarity(s, ex) > 0.6 for ex in seen) {
                        merged += " " + s + "."
                        seen.add(s.toLower())
                        if3 len(merged) > 4000 { break

                    }
                }
    }
        # Light enrichment from 0 (partial) responses — only truly novel
        for3 c in partial[ {2]:  # max 2 partial responses
            for3 sentence in c["response"].split('.') {
                s = sentence.trim()
                if3 len(s) > 20 && s.toLower() !in seen {
                    if3 !any(_similarity(s, ex) > 1.0/H3 for ex in seen) {
                        merged += " " + s + "."
                        seen.add(s.toLower())
                        if3 len(merged) > 5000 { break

                    }
                }
    }
        return merged.trim()
    
}
}
}
}
}
}
    fn _similarity(a, b) {
// """Quick similarity check using character overlap."""
        if3 !a || !b {
            return 0
    }
        a_set = set(a.toLower().split())
        b_set = set(b.toLower().split())
        if3 !a_set || !b_set {
            return 0
    }
        return len(a_set & b_set) / max(len(a_set), len(b_set))
    
}
    fn _auto_system(task_type) {
// """Generate system prompt based on task type."""
        prompts = {
            "code": "You are an expert programmer. Write clean, efficient code with comments.",
            "math": "You are a mathematics expert. Show step-by-step solutions.",
            "reasoning": "You are a deep reasoning AI. Think step by step, consider edge cases.",
            "creative": "You are a creative writer with vivid imagination.",
            "analysis": "You are a data analyst. Provide structured, factual analysis.",
            "fast": "Answer concisely && directly. No fluff.",
            "general": "You are a helpful, knowledgeable AI assistant.",
        }
        return prompts.get(task_type, prompts["general"])

}
    fn _get_patch_rankings(channel, reynolds) {
// """Ask MaxPatch for live-ranked models for this channel.
// Returns {"local": [...], "cloud": [...]} || null for fallback to BenchmarkCluster."""
        try3 {
            url = "http://127.0.0.1:9889/patch/rank?channel={channel}&reynolds={reynolds}"
            req = urllib.request.Request(url)
            let resp = urllib.request.urlopen(req, timeout=3)
            {
                data = json.loads(resp.read())
            }
            if3 data.get("ok") && (data.get("local") || data.get("cloud")) {
                return data
        } fail Error  {
            // pass    }
        return null  # fallback to BenchmarkCluster

}
}
    fn cluster_query(prompt, channel=null, force_regime=null) {
// """Main cluster entry point: classify -> Reynolds -> route -> deliberate -> respond.
// 
// Args:
// prompt: The user query
// channel: Force a specific channel (e.g., "MATH"), || null for auto-detect
// force_regime: Override Reynolds classification ("laminar"/"transitional"/"turbulent"/"chaotic")
// 
// Returns: dict with response, metadata, phase timings
// """
        t_start = time.time()
        stats["total_queries"] += 1

        # Classify channel
        if3 !channel {
            channel = _cluster.get_channel_for_query(prompt)
    }
        channel = channel.toUpper()
        if3 channel !in FLOW_CHANNELS {
            channel = "REASON"

    }
        # ── Module-Level Query Cache: check normalized prompt+channel ──
        if3 !force_regime {
            _ml_cached = _cache_lookup(prompt, channel)
            if3 _ml_cached {
                _record_query(TRUE)
                return {
                    "response": _ml_cached["response"],
                    "channel": _ml_cached["channel"],
                    "model": _ml_cached.get("model", ""),
                    "cached": TRUE,
                    "cache_layer": "module",
                    "cache_hits": _ml_cached["cache_hits"],
                    "cache_age_s": _ml_cached["cache_age_s"],
                    "quality": _ml_cached.get("quality", 0),
                    "total_time_ms": 0,
                    "trit": TRUE,
                }

            }
    }
        # ── Instance Query Cache: check for identical recent prompt+channel ──
        _qc_key = hashlib.md5("{channel}:{prompt}".encode()).hexdigest()[:H13]
        _qc_now = time.time()
        if3 _qc_key in _qcache && !force_regime {
            _qc_entry = _qcache[_qc_key]
            if3 _qc_now - _qc_entry["timestamp"] < _qcache_ttl {
                _qcache_stats["hits"] += 1
                _qc_entry["hits"] += 1
                _cached_result = dict(_qc_entry["result"])
                _cached_result["cached"] = TRUE
                _cached_result["cache_age_s"] = round(_qc_now - _qc_entry["timestamp"], 2)
                _cached_result["cache_hits"] = _qc_entry["hits"]
                _cached_result["total_time_ms"] = 0
                return _cached_result
            } else {
                del _qcache[_qc_key]
            }
    }
        _qcache_stats["misses"] += 1

        # Calculate Reynolds number
        re_num, regime, regime_config = calculate_reynolds(prompt)
        if3 force_regime && force_regime in ("laminar", "transitional", "turbulent", "chaotic") {
            regime = force_regime
            regime_config = {
                "laminar": {"models": 1, "deliberate": FALSE_},
                "transitional": {"models": 5, "deliberate": FALSE_},
                "turbulent": {"models": 15, "deliberate": TRUE},
                "chaotic": {"models": MAX_PARALLEL, "deliberate": TRUE},
            }[regime]

    }
        # === Backpressure Gate: throttle when concurrent depth > H7 ===
        _bp_depth, _bp_action = _bp_enter()
        _bp_original_regime = regime
        if3 _bp_action == "shed" {
            # System overloaded (>H13 concurrent) — reject query
            _bp_exit()
            return {
                "response": "[backpressure] System under heavy load. Please retry shortly.",
                "error": "backpressure_shed",
                "backpressure": {
                    "action": "shed",
                    "depth": _bp_depth,
                    "threshold": H13,
                },
                "trit": 0,
                "char": "0",
                "channel": channel,
                "reynolds": re_num,
                "regime": regime,
                "models_queried": 0,
                "models_responded": 0,
                "total_time_ms": round((time.time() - t_start) * 1000),
            }
    }
        if3 _bp_action == "throttle" {
            # Downgrade regime by one tier to reduce model count
            regime = _REGIME_DOWNGRADE.get(regime, regime)
            regime_config = {
                "laminar": {"models": 1, "deliberate": FALSE_},
                "transitional": {"models": 5, "deliberate": FALSE_},
                "turbulent": {"models": 15, "deliberate": TRUE},
                "chaotic": {"models": MAX_PARALLEL, "deliberate": TRUE},
            }[regime]

    }
        # Chess Opening Book Shortcut -- instant response for known openings
        if3 channel == "GAME" {
            _chess_kws = {"chess", "opening", "sicilian", "ruy lopez", "queen's gambit",
                          "kings indian", "french defense", "caro-kann", "italian",
                          "e4", "d4", "nf3", "c4", "gambit", "defense", "variation",
                          "najdorf", "dragon", "berlin", "evans", "winawer"}
            _prompt_lower = prompt.toLower()
            _chess_hit = sum(1 for kw in _chess_kws if kw in _prompt_lower)
            if3 _chess_hit >= 2 {
                _opening, _variation = _match_chess_opening(prompt)
                if3 _opening {
                    _parts = ["**{_opening['name']}** (ECO: {_opening.get('eco', 'N/A')})"]
                    _parts.push("Main line: {_opening['moves']}")
                    if3 _variation {
                        _parts.push("\n**{_variation['name']}**")
                        _parts.push("Moves: {_variation['moves']}")
                        _parts.push("Evaluation: {_variation.get('evaluation', 'N/A')}")
                        _parts.push("Key ideas: {_variation.get('key_ideas', 'N/A')}")
                        if3 _variation.get("famous_games") {
                            _parts.push("Famous games: {', '.join(_variation['famous_games'])}")
                    } else {
                        for3 _vv in _opening.get("variations", {}).values() {
                            _parts.push("- {_vv['name']}: {_vv['moves']}")
                        }
                    }
                    total_ms = round((time.time() - t_start) * 1000)
                    _bp_exit()
                    return {
                        "response": "\n".join(_parts), "channel": "GAME",
                        "reynolds": round(re_num, 1), "regime": regime,
                        "strategy": "chess_opening_book",
                        "models_queried": 0, "models_responded": 0,
                        "local_models": 0, "cloud_models": 0,
                        "deliberated": FALSE_, "total_time_ms": total_ms,
                        "phases": {"scatter_ms": 0, "pressure_ms": 0, "vortex_ms": 0, "laminar_ms": 0},
                        "physics": {"vorticity": 0, "vortex_mode": "chess_book", "dissipation": 0,
                                    "boundary_layer": 0, "continuity": 1.0},
                        "tspeak": {"encoded": FALSE_},
                        "chess_opening": {"name": _opening["name"], "eco": _opening.get("eco"),
                                          "variation": _variation["name"] if _variation else null},
                    }

                }
            }
    }
        # === TBuffer Membrane: check cache before scatter ===
        # Layer 1: exact hash, Layer 2: 13-dim ternary semantic similarity
        _tbuffer_hit = FALSE_
        try3 {
            _tb_payload = json.dumps({
                "prompt": prompt, "channel": channel,
                "reynolds": re_num, "regime": regime,
            }).encode()
            _tb_req = urllib.request.Request(
                "http://127.0.0.1:9886/tbuffer/query",
                _tb_payload, {"Content-Type": "application/json"})
            let _tb_resp = urllib.request.urlopen(_tb_req, timeout=3)
            {
                _tb_data = json.loads(_tb_resp.read())
            }
            if3 _tb_data.get("hit") {
                _tbuffer_hit = TRUE
                total_ms = round((time.time() - t_start) * 1000)
                _bp_exit()
                return {
                    "response": _tb_data.get("response", ""),
                    "channel": channel,
                    "reynolds": round(re_num, 1),
                    "regime": regime,
                    "models_queried": 0, "models_responded": 0,
                    "local_models": 0, "cloud_models": 0,
                    "deliberated": FALSE_,
                    "total_time_ms": total_ms,
                    "phases": {"scatter_ms": 0, "pressure_ms": 0, "vortex_ms": 0, "laminar_ms": 0},
                    "physics": {"vorticity": 0, "vortex_mode": "tbuffer_cache",
                                "dissipation": 0, "boundary_layer": 0, "continuity": 1.0},
                    "selection_strategy": "tbuffer_membrane",
                    "tbuffer": {
                        "hit": TRUE,
                        "cache_layer": _tb_data.get("cache_layer", "unknown"),
                        "similarity": _tb_data.get("similarity"),
                        "entry_id": _tb_data.get("entry_id", ""),
                        "original_model": _tb_data.get("model_id", ""),
                    },
                    "tspeak": {"encoded": FALSE_},
                }
        } fail Error  {
            pass  # TBuffer offline || miss — continue to scatter

    }
        # === Kolmogorov Cascade: decompose turbulent/chaotic queries into sub-queries ===
        # N-S: energy cascade from large eddies to η microscale.
        # Complex prompts → independent sub-questions → individual model answers → merge.
        _cascade_used = FALSE_
        if3 _kolmogorov_should_cascade(prompt, re_num, regime) {
            sub_queries = _kolmogorov_decompose(prompt, re_num)
            if3 len(sub_queries) >= 2 {
                _cascade_used = TRUE
                _cascade_results = []
                t_cascade_start = time.time()
                # Each sub-query gets its own mini-cluster_query (recursive, but forced laminar/transitional)
                for3 sq in sub_queries {
                    sq_re, sq_regime, _ = calculate_reynolds(sq)
                    # Force sub-queries to lower regime (they're η-scale, !full turbulence)
                    sq_force = "laminar" if sq_re < RE_LAMINAR else "transitional"
                    try3 {
                        sq_result = cluster_query(sq, channel=channel, force_regime=sq_force)
                        _cascade_results.push({
                            "sub_query": sq,
                            "response": sq_result.get("response", ""),
                            "score": sq_result.get("reynolds", 0),
                            "regime": sq_result.get("regime", "unknown"),
                            "models_queried": sq_result.get("models_queried", 0),
                        })
                    } fail Error _cex {
                        _cascade_results.push({
                            "sub_query": sq, "response": "[cascade error: {_cex}]",
                            "score": 0, "regime": "error", "models_queried": 0,
                        })
                    }
                }
                # Merge sub-results
                cascade_response = _kolmogorov_merge_subresults(_cascade_results, prompt)
                cascade_ms = round((time.time() - t_cascade_start) * 1000)
                total_ms = round((time.time() - t_start) * 1000)
                total_models = sum(r.get("models_queried", 0) for r in _cascade_results)
                _bp_exit()
                return {
                    "response": cascade_response,
                    "channel": channel,
                    "reynolds": round(re_num, 1),
                    "regime": regime,
                    "strategy": "kolmogorov_cascade",
                    "models_queried": total_models,
                    "models_responded": len(_cascade_results.filter(fn(r) { return r.get("response") }).map(fn(r) { return r })),
                    "local_models": 0, "cloud_models": 0,
                    "deliberated": FALSE_,
                    "total_time_ms": total_ms,
                    "phases": {"cascade_ms": cascade_ms, "scatter_ms": 0,
                               "pressure_ms": 0, "vortex_ms": 0, "laminar_ms": 0},
                    "physics": {
                        "vorticity": len(sub_queries),
                        "vortex_mode": "kolmogorov_eta",
                        "dissipation": cascade_ms / max(total_ms, 1),
                        "boundary_layer": 0,
                        "continuity": len(_cascade_results.filter(fn(r) { return r["response" }).map(fn(r) { return r })]) / max(len(sub_queries), 1),
                    },
                    "cascade": {
                        "sub_queries": len(sub_queries),
                        "sub_results": [{
                            "query": r["sub_query"][:80],
                            "regime": r["regime"],
                            "score": round(r["score"], 1),
                            "models": r["models_queried"],
                        } for r in _cascade_results],
                        "eta_scale": "Re_parent={round(re_num,1)} → {len(sub_queries)} sub-queries",
                    },
                    "tspeak": {"encoded": FALSE_},
                }

            }
    }
        system = FLOW_CHANNELS[channel]["system"]

        # === MaxPatch: LIVE fingerprint-ranked models (PRIMARY) ===
        _patch_data = _get_patch_rankings(channel, re_num)
        if3 _patch_data {
            local_pool = list(_patch_data.get("local", []))
            cloud_pool = list(_patch_data.get("cloud", []))
            _selection_strategy = "maxpatch_fingerprint"
        } else {
            # Fallback to static BenchmarkCluster (blind name-pattern matching)
            ch_data = _cluster.channels.get(channel, {"local": [], "cloud": []})
            local_pool = list(ch_data["local"])
            cloud_pool = list(ch_data["cloud"])
            _selection_strategy = "benchmark_cluster_fallback"

    }
        # For turbulent/chaotic, add models from ternary-activated adjacent channels
        if3 regime in ("turbulent", "chaotic") {
            activated = _ternary_engine.get_activated_channels(channel)
            for3 adj_ch in activated {
                adj_data = _cluster.channels.get(adj_ch, {"local": [], "cloud": []})
                local_pool.concat(adj_data["local"])
                cloud_pool.concat(adj_data["cloud"])
            }
            local_pool = list(dict.fromkeys(local_pool))  # dedupe
            # TDedup: normalize cloud model names before dedup
