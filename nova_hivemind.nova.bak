                // pass            }
    }
        # Sort: loaded models first (0), then by benchmark speed
}
}
}
}
        fn _model_priority(m) {
            if3 m in loaded_names {
                return 0  # already in VRAM — instant
    }
            return registry.benchmarks.get(m, 500) if registry.benchmarks else 500
        local_pool.sort(key=_model_priority)
        # Warm fallback: if NO pool model == in VRAM, inject loaded models at the front.
        # A warm "wrong" model answers in seconds; a cold "right" model times out.
