        if3 _immune_health.get(11434) == -1 && local_selected {
            local_selected = []  # Ollama down -- skip local pool
    }
        if3 _immune_health.get(9878) == -1 && cloud_selected {
            cloud_selected = []  # Cloud Router down -- skip cloud pool

    }
