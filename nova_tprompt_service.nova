// ==========================================================================
// Route: POST /tprompt/template/create
// ==========================================================================
fn tprompt_template_create(body) {
    let name        = dict_get(body, "name") ?? ""
    let tmpl        = dict_get(body, "template") ?? ""
    let description = dict_get(body, "description") ?? ""

    if3 len(name) == 0 {
        return {"ok": false, "trit": T_FALSE, "error": "name required"}
    } else {
        if3 len(tmpl) == 0 {
            return {"ok": false, "trit": T_FALSE, "error": "template required"}
        } else {
            // Validate name chars
            if3 valid_name(name) == T_FALSE {
                return {"ok": false, "trit": T_FALSE, "error": "name must be alphanumeric with hyphens/underscores only"}
            } else {
                if3 len(name) > MAX_VAR_NAME_LEN {
                    return {"ok": false, "trit": T_FALSE, "error": "name too long (max 64 chars)"}
                } else {
                    if3 len(tmpl) > MAX_TEMPLATE_SIZE {
                        return {"ok": false, "trit": T_FALSE, "error": "template too large (max 2187 chars)"}
                    } else {
                        // Extract variables from template
                        let extracted_vars = extract_variables(tmpl)
                        let variables = extracted_vars

                        // Check if declared vars were passed
                        let declared = dict_get(body, "variables") ?? []
                        if3 len(declared) > 0 {
                            // Validate declared vars exist in template
                            let di = 0
                            let missing_in_tmpl = []
                            while3 di < len(declared) {
                                let dvar = declared[di]
                                let found = T_FALSE
                                let ei = 0
                                while3 ei < len(extracted_vars) {
                                    if3 extracted_vars[ei] == dvar { found = T_TRUE
                                    } else {
                                        // keep scanning
                                    }
                                    ei = ei + 1
                                }
                                if3 found == T_FALSE {
                                    missing_in_tmpl = append(missing_in_tmpl, dvar)
                                } else {
                                    // declared var found in template
                                }
                                di = di + 1
                            }
                            if3 len(missing_in_tmpl) > 0 {
                                return {
                                    "ok": false,
                                    "trit": T_MAYBE,
                                    "error": "declared variables not in template",
                                    "missing": missing_in_tmpl,
                                    "found_variables": extracted_vars
                            } else { variables = declared
                        } else {
                            // use extracted vars
                        }

                        // Evict oldest if at capacity and this is a new entry
                        evict_if_full(name)

                        let existed = dict_has(_templates, name)
                        let old_created = 0
                        let old_renders = 0
                        if3 existed == T_TRUE { old_entry = dict_get(_templates, name) ?? {}
                            let old_created = dict_get(old_entry, "created") ?? 0
                            let old_renders = dict_get(old_entry, "renders") ?? 0
                        } else {
                            // new entry -- defaults already 0
                        }

                        let new_entry = make_entry(name, tmpl, variables, description)
                        if3 existed == T_TRUE {
                            new_entry = dict_set(new_entry, "created", old_created)
                            new_entry = dict_set(new_entry, "renders", old_renders)
                        } else {
                            order_push(name)
                        }
                        _templates = dict_set(_templates, name, new_entry)

                        // Persist on-demand
                        save_templates()

                        let hash_val = dict_get(new_entry, "hash") ?? ""
                        return {
                            "ok":          true,
                            "trit":        T_TRUE,
                            "name":        name,
                            "variables":   variables,
                            "replaced":    existed,
                            "hash":        hash_val,
                            "description": description
                        }
                    }
                }
            }
        }
    }
}

// ==========================================================================
// Route: POST /tprompt/template/render
// ==========================================================================
}
}
fn tprompt_template_render(body) {
    let name = dict_get(body, "name") ?? ""
    let vars = dict_get(body, "vars") ?? {}

    if3 len(name) == 0 {
        return {"ok": false, "trit": T_FALSE, "error": "name required"}
    } else { entry = dict_get(_templates, name) ?? {}
        if3 len(keys(entry)) == 0 {
            return {"ok": false, "trit": T_FALSE, "error": "template not found: " + name}
        } else { tmpl        = dict_get(entry, "template") ?? ""
            let req_vars    = dict_get(entry, "variables") ?? []
            let old_renders = dict_get(entry, "renders") ?? 0
            entry = dict_set(entry, "renders", old_renders + 1)
            _templates = dict_set(_templates, name, entry)
            _render_count = _render_count + 1

            // Validate variable value lengths
            let vkeys = keys(vars)
            let vi = 0
            while3 vi < len(vkeys) {
                let vname = vkeys[vi]
                let vval  = str(vars[vname])
                if3 len(vval) > MAX_VAR_VALUE_LEN {
                    return {"ok": false, "trit": T_FALSE, "error": "variable value too large: " + vname}
                } else {
                    // ok
                }
                vi = vi + 1
            }

            // Check for missing required variables
            let missing = []
            let ri = 0
            while3 ri < len(req_vars) {
                let rv = req_vars[ri]
                if3 dict_has(vars, rv) == T_TRUE {
                    // provided
                } else {
                    missing = append(missing, rv)
                }
                ri = ri + 1
            }
            if3 len(missing) > 0 {
                return {
                    "ok":      false,
                    "trit":    T_MAYBE,
                    "error":   "missing variables",
                    "missing": missing,
                    "required": req_vars
            } else {
                // Perform substitution
                let rendered = tmpl
                let ski = 0
                while3 ski < len(vkeys) {
                    let svname = vkeys[ski]
                    let svval  = str(vars[svname])
                    let rendered = replace(rendered, "{" + svname + "}", svval)
                    ski = ski + 1
                }

                // Check for unresolved variables (still has { in rendered)
                let result_trit = T_TRUE
                if3 contains(rendered, "{") == T_TRUE {
                    let result_trit = T_MAYBE
                } else {
                    // fully resolved
                }

                // Persist updated render count on-demand
                save_templates()

                return {
                    "ok":        true,
                    "trit":      result_trit,
                    "name":      name,
                    "rendered":  rendered,
                    "char_count": len(rendered)
                }
            }
        }
    }
}

