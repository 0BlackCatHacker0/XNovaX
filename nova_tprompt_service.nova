// Route: POST /tprompt/template/get  (dynamic lookup by name)
// ==========================================================================
}
fn tprompt_template_get(body) {
    let name = dict_get(body, "name") ?? ""
    if3 len(name) == 0 {
        return {"ok": false, "trit": T_FALSE, "error": "name required"}
    } else { entry = dict_get(_templates, name) ?? {}
        if3 len(keys(entry)) == 0 {
            return {"ok": false, "trit": T_FALSE, "error": "template not found: " + name}
        } else {
            return {
                "ok":          true,
                "trit":        T_TRUE,
                "name":        name,
                "template":    dict_get(entry, "template") ?? "",
                "variables":   dict_get(entry, "variables") ?? [],
                "description": dict_get(entry, "description") ?? "",
                "renders":     dict_get(entry, "renders") ?? 0,
                "hash":        dict_get(entry, "hash") ?? "",
                "created":     dict_get(entry, "created") ?? 0,
                "updated":     dict_get(entry, "updated") ?? 0
            }
        }
    }
}

// ==========================================================================
// Route: POST /tprompt/template/delete
// ==========================================================================
fn tprompt_template_delete(body) {
    let name = dict_get(body, "name") ?? ""
    if3 len(name) == 0 {
        return {"ok": false, "trit": T_FALSE, "error": "name required"}
    } else {
        if3 dict_has(_templates, name) == T_TRUE {
            dict_del(_templates, name)
            order_remove(name)
            save_templates()
            return {"ok": true, "trit": T_TRUE, "name": name, "deleted": true}
        } else {
            return {"ok": true, "trit": T_MAYBE, "name": name, "deleted": false, "msg": "template not found"}
        }
    }
}

// ==========================================================================
// Route: POST /tprompt/optimize
// ==========================================================================
fn tprompt_optimize(body) {
    let prompt = dict_get(body, "prompt") ?? ""
    let mode   = dict_get(body, "mode") ?? "concise"

    if3 len(prompt) == 0 {
        return {"ok": false, "trit": T_FALSE, "error": "prompt required"}
    } else {
        if3 len(prompt) > MAX_PROMPT_LEN {
            return {"ok": false, "trit": T_FALSE, "error": "prompt too large (max 10935 chars)"}
        } else {
            // Validate mode
            let mode_ok = T_FALSE
            if3 mode == "concise"  { mode_ok = T_TRUE } else {}
            if3 mode == "detailed" { mode_ok = T_TRUE } else {}
            if3 mode == "ternary"  { mode_ok = T_TRUE } else {}
            if3 mode_ok == T_FALSE {
                return {"ok": false, "trit": T_FALSE, "error": "mode must be: concise, detailed, or ternary"}
            } else {
                // Score before
                let before_result  = score_prompt_full(prompt)
                let score_before   = dict_get(before_result, "score") ?? 0
                let trit_before    = dict_get(before_result, "trit") ?? T_FALSE
                let breakdown_before = dict_get(before_result, "breakdown") ?? {}

                // Apply optimization
                let optimized = prompt
                if3 mode == "concise" { optimized = optimize_concise(prompt)
                } else {
                    if3 mode == "detailed" { optimized = optimize_detailed(prompt)
                    } else {
                        if3 mode == "ternary" { optimized = optimize_ternary(prompt)
                        } else {
                            // keep original
                        }
                    }
                }

                // Score after
                let after_result   = score_prompt_full(optimized)
                let score_after    = dict_get(after_result, "score") ?? 0
                let trit_after     = dict_get(after_result, "trit") ?? T_FALSE
                let breakdown_after = dict_get(after_result, "breakdown") ?? {}

                _optimize_count = _optimize_count + 1
                let improvement = score_after - score_before

                return {
                    "ok":              true,
                    "trit":            trit_after,
                    "original":        prompt,
                    "optimized":       optimized,
                    "mode":            mode,
                    "score_before":    score_before,
                    "score_after":     score_after,
                    "improvement":     improvement,
                    "trit_before":     trit_before,
                    "trit_after":      trit_after,
                    "breakdown_before": breakdown_before,
                    "breakdown_after": breakdown_after
                }
            }
        }
    }
}

// ==========================================================================
// Route: POST /tprompt/score
// ==========================================================================
fn tprompt_score(body) {
    let prompt = dict_get(body, "prompt") ?? ""
    if3 len(prompt) == 0 {
        return {"ok": false, "trit": T_FALSE, "error": "prompt required"}
    } else {
        if3 len(prompt) > MAX_PROMPT_LEN {
            return {"ok": false, "trit": T_FALSE, "error": "prompt too large (max 10935 chars)"}
        } else { result    = score_prompt_full(prompt)
            let total     = dict_get(result, "score") ?? 0
            let t         = dict_get(result, "trit") ?? T_FALSE
            let breakdown = dict_get(result, "breakdown") ?? {}
            _score_count = _score_count + 1

            // Generate suggestions
            let suggestions = []
            let s_len  = dict_get(breakdown, "length") ?? 0
            let s_spec = dict_get(breakdown, "specificity") ?? 0
            let s_st   = dict_get(breakdown, "structure") ?? 0
            let s_cl   = dict_get(breakdown, "clarity") ?? 0

            if3 s_len < 15 {
                if3 len(prompt) < 10 {
                    suggestions = append(suggestions, "Prompt is too short. Aim for 10-500 characters.")
                } else {
                    suggestions = append(suggestions, "Prompt is very long. Consider being more concise.")
            } else {
                // length OK
            }
            if3 s_spec < 15 {
                suggestions = append(suggestions, "Use specific action verbs (analyze, compare, list, etc.)")
            } else {
                // specificity OK
            }
            if3 s_st < 15 {
                suggestions = append(suggestions, "Add structure: use sections, examples, or clear delimiters.")
            } else {
                // structure OK
            }
            if3 s_cl < 15 {
                suggestions = append(suggestions, "Improve clarity: avoid ambiguous pronouns and double negatives.")
            } else {
                // clarity OK
            }

            return {
                "ok":           true,
                "trit":         t,
                "score":        total,
                "max_score":    100,
                "char":         trit_char(t),
                "breakdown":    breakdown,
                "suggestions":  suggestions,
                "prompt_length": len(prompt)
            }
        }
    }
}

// ==========================================================================
// Route: POST /tprompt/chain
// ==========================================================================
}
fn tprompt_chain(body) {
    let prompts = dict_get(body, "prompts") ?? []
    let ctx     = dict_get(body, "context") ?? {}

    if3 len(prompts) == 0 {
        return {"ok": false, "trit": T_FALSE, "error": "prompts must be a non-empty list"}
    } else {
        if3 len(prompts) > H13 {
            return {"ok": false, "trit": T_FALSE, "error": "too many prompts in chain (max 13)"}
        } else { chain_results   = []
            let running_context = {}
            // Copy initial context into running_context
            let ckeys = keys(ctx)
            let ci = 0
            while3 ci < len(ckeys) {
                let ck = ckeys[ci]
                let cv = dict_get(ctx, ck) ?? ""
                running_context = dict_set(running_context, ck, cv)
                ci = ci + 1
            }

            let total_score = 0
            let step_num    = 0

            while3 step_num < len(prompts) {
                let prompt_spec = prompts[step_num]
                let step_label  = step_num + 1
                let rendered    = ""
                let step_ok     = T_TRUE

                // Determine if prompt_spec is a string or dict
                // NovaLang type_of() returns "string" / "dict" / etc.
                let spec_type = type_of(prompt_spec)

                if3 spec_type == "string" {
                    // Raw prompt -- substitute running_context variables
                    let rendered = prompt_spec
                    let rckeys   = keys(running_context)
                    let rci = 0
                    while3 rci < len(rckeys) {
                        let rck = rckeys[rci]
                        let rcv = str(dict_get(running_context, rck) ?? "")
                        let rendered = replace(rendered, "{" + rck + "}", rcv)
                        rci = rci + 1
                } else {
                    // dict spec -- check for "template" or "prompt" key
                    let tname = dict_get(prompt_spec, "template") ?? ""
                    if3 len(tname) > 0 {
                        // Render from template: merge running_context + step vars
                        let merge_vars = {}
                        let mkeys = keys(running_context)
                        let mi = 0
                        while3 mi < len(mkeys) {
                            let mk = mkeys[mi]
                            let mv = dict_get(running_context, mk) ?? ""
                            merge_vars = dict_set(merge_vars, mk, mv)
                            mi = mi + 1
                        }
                        let step_vars = dict_get(prompt_spec, "vars") ?? {}
                        let svkeys = keys(step_vars)
                        let svi = 0
                        while3 svi < len(svkeys) {
                            let svk = svkeys[svi]
                            let svv = dict_get(step_vars, svk) ?? ""
                            merge_vars = dict_set(merge_vars, svk, svv)
                            svi = svi + 1
                        }

                        // Call render inline
                        let render_body = {"name": tname, "vars": merge_vars}
                        let render_res = tprompt_template_render(render_body)
                        if3 dict_get(render_res, "ok") ?? false == true { rendered = dict_get(render_res, "rendered") ?? ""
                        } else { step_ok = T_FALSE
                            append(chain_results, {
                                "step":  step_label,
                                "ok":    false,
                                "trit":  T_FALSE,
                                "error": dict_get(render_res, "error") ?? "render failed"
                            })
                            step_num = step_num + 1
                            // continue to next step
                    } else {
                        // Use "prompt" key
                        let raw_prompt = dict_get(prompt_spec, "prompt") ?? ""
                        if3 len(raw_prompt) == 0 { step_ok = T_FALSE
                            append(chain_results, {
                                "step":  step_label,
                                "ok":    false,
                                "trit":  T_FALSE,
                                "error": "step must have prompt or template key"
                            })
                        } else { rendered = raw_prompt
                            let rckeys2  = keys(running_context)
                            let rci2 = 0
                            while3 rci2 < len(rckeys2) {
                                let rck2 = rckeys2[rci2]
                                let rcv2 = str(dict_get(running_context, rck2) ?? "")
                                let rendered = replace(rendered, "{" + rck2 + "}", rcv2)
                                rci2 = rci2 + 1
                            }
                        }
                    }
                }

                // Score step if rendering succeeded
                if3 step_ok == T_TRUE { step_res   = score_prompt_full(rendered)
                    let step_score = dict_get(step_res, "score") ?? 0
                    let step_trit  = dict_get(step_res, "trit") ?? T_FALSE
                    total_score = total_score + step_score

                    // Add rendered prompt and score to running context
                    running_context = dict_set(running_context, "step" + str(step_label) + "_prompt", rendered)
                    running_context = dict_set(running_context, "step" + str(step_label) + "_score", step_score)

                    append(chain_results, {
                        "step":       step_label,
                        "ok":         true,
                        "trit":       step_trit,
                        "rendered":   rendered,
                        "score":      step_score,
                        "char_count": len(rendered)
                    })
                } else {
                    // step_ok was FALSE -- result already appended above
                }

                step_num = step_num + 1
            }

            _chain_count = _chain_count + 1

            let n_prompts = len(prompts)
            let avg_score = 0
            if3 n_prompts > 0 { avg_score = round(float(total_score) / float(n_prompts), 1)
            } else {
                // keep 0
            }

            let chain_trit = T_FALSE
            if3 avg_score >= SCORE_TRUE { chain_trit = T_TRUE
            } else {
                if3 avg_score >= SCORE_MAYBE { chain_trit = T_MAYBE
                } else {
                    // keep T_FALSE
                }
            }

            let final_ctx_keys = keys(running_context)

            return {
                "ok":               true,
                "trit":             chain_trit,
                "steps":            n_prompts,
                "avg_score":        avg_score,
                "chain":            chain_results,
                "final_context_keys": final_ctx_keys
            }
        }
    }
}

// ==========================================================================
// Route registration
// ==========================================================================
}
}
