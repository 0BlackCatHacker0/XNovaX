troute(server, "POST", "/tprompt/score",                      "tprompt_score")
troute(server, "POST", "/tprompt/chain",                      "tprompt_chain")

// ==========================================================================
// Startup: load templates then print banner
// ==========================================================================
let _boot_ok = load_templates()

print("[TPrompt] NovaX Ternary Prompt Engineering starting in NovaLang...")
print("[TPrompt] Port: " + str(PORT) + " | Version: " + VERSION + " | Runtime: NovaLang")
print("[TPrompt] MAX_TEMPLATES=H13*H7=" + str(MAX_TEMPLATES) + " | PERSIST=" + PERSIST_PATH)
print("[TPrompt] Scoring: TRUE>=" + str(SCORE_TRUE) + ", MAYBE>=" + str(SCORE_MAYBE) + ", FALSE<" + str(SCORE_MAYBE))
print("[TPrompt] 3-5-7-13: H3=" + str(H3) + " H5=" + str(H5) + " H7=" + str(H7) + " H13=" + str(H13) + " BLOCK=" + str(BLOCK))
print("[TPrompt] GET  /tprompt/health | /tprompt/template/list | /tprompt/stats")
print("[TPrompt] GET  /tprompt/template/{nova-query|code-analyze|summarize|ternary-classify}")
