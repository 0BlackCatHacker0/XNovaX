// Nova TSniffer v2.0 - Ternary Process Sniffer (NovaLang)
// Port 9926: Monitors python.exe processes, kills zombie/rogue spawns
//
// N-S Mapping:
//   process_count = velocity_field (flow of processes)
//   kill_count    = viscosity      (resistance/cleanup)
//   Reynolds      = process_count * H3
//
// Routes:
//   GET  /health          -- Health check
//   GET  /sniffer/status  -- Service status + stats
//   GET  /sniffer/log     -- Recent kill/scan log
//   POST /sniffer/scan    -- Scan for rogue processes
//   POST /sniffer/config  -- Update sniffer configuration

// -- Shared Libraries (N-S Flow) --
import3("C:/NovaX/lib/nova_ns_core.nova")
import3("C:/NovaX/lib/nova_stdlib.nova")

let PORT = 9936
let SERVICE_NAME = "nova-tsniffer"
let VERSION = "2.0"

let server = tserve(PORT, "Nova TSniffer")

// ── State ──
let _t0 = time()
let _scan_count = 0
let _kill_count = 0
let _log = []
let _active = true

// ── Health Handler ──
fn handle_health(req) {
    let uptime = round(time() - _t0, 1)
    let self_trit = T_MAYBE
    if3 uptime > 10 { self_trit = T_TRUE
    }
    let resp = ns_health_dict(SERVICE_NAME, VERSION, PORT, {})
    resp = dict_set(resp, "self_trit", self_trit)
    resp = dict_set(resp, "char", trit_char(self_trit))
    resp = dict_set(resp, "uptime_s", uptime)
    resp = dict_set(resp, "scans", _scan_count)
    resp = dict_set(resp, "kills", _kill_count)
    resp = dict_set(resp, "active", _active)
    return resp
}

// ── Status Handler ──
fn handle_status(req) {
    let uptime = round(time() - _t0, 1)
    let re = _scan_count * H3
    let regime = flow_regime(re)
    return {
        "ok": true,
        "service": SERVICE_NAME,
        "port": PORT,
        "version": VERSION,
        "uptime_s": uptime,
        "scans": _scan_count,
        "kills": _kill_count,
        "active": _active,
        "reynolds": re,
        "flow_regime": regime,
        "log_entries": len(_log),
        "trit": T_TRUE
    }
}

// ── Log Handler ──
fn handle_log(req) {
    return {
        "ok": true,
        "service": SERVICE_NAME,
        "entries": _log,
        "count": len(_log),
        "trit": T_TRUE
    }
}

// ── Scan Handler ──
fn handle_scan(body) {
    _scan_count = _scan_count + 1
    // Scan for rogue python.exe processes
    let cmd = "powershell -Command \"Get-Process python -ErrorAction SilentlyContinue | Select-Object Id,ProcessName,StartTime | ConvertTo-Json\""
    let raw = nova_run(cmd, 10)
    let trimmed = trim(str(raw))
    let entry = "scan #" + str(_scan_count) + " at " + str(round(time(), 0))
    _log = append(_log, entry)
    // Keep log bounded
    if3 len(_log) > 100 { _log = slice(_log, len(_log) - 100, len(_log))
    }
    return {
        "ok": true,
        "service": SERVICE_NAME,
        "scan_number": _scan_count,
        "raw_output": trimmed,
        "trit": T_TRUE
    }
}

// ── Config Handler ──
fn handle_config(body) {
    let new_active = dict_get(body, "active") ?? _active
    _active = new_active
    return {
        "ok": true,
        "service": SERVICE_NAME,
        "active": _active,
        "trit": T_TRUE
    }
}

// ── Routes ──
troute(server, "GET", "/health", "handle_health")
troute(server, "GET", "/sniffer/status", "handle_status")
troute(server, "GET", "/sniffer/log", "handle_log")
troute(server, "POST", "/sniffer/scan", "handle_scan")
troute(server, "POST", "/sniffer/config", "handle_config")

print("[TSniffer] NovaLang TSniffer v" + VERSION + " on port " + str(PORT))
print("[TSniffer] Harmonics: 3-5-7-13 | Runtime: NovaLang")
print("[TSniffer] Routes: /health, /sniffer/status, /sniffer/log, /sniffer/scan, /sniffer/config")

tstart(server)
