    # ====== Static + File serving ======
    def _serve_static(self, filename):
        # Try primary static dir first, then C:\NovaX\web
        for base in [STATIC_DIR, "C:/NovaX/web"]:
            filepath = os.path.normpath(os.path.join(base, filename))
            if not filepath.startswith(os.path.normpath(base)):
                continue
            if os.path.isfile(filepath):
                ext = os.path.splitext(filename)[1].lower()
                ct = MIME_TYPES.get(ext, "application/octet-stream")
                with open(filepath, "rb") as f: data = f.read()
                return self._binary(200, data, ct)
        self._json(404, {"error": f"not found: {filename}"})

    def _api_files(self, fpath):
        try:
            if not os.path.isdir(fpath):
                return self._json(404, {"error": f"not a directory: {fpath}"})
            entries = []
            for name in sorted(os.listdir(fpath)):
                full = os.path.join(fpath, name)
                is_dir = os.path.isdir(full)
                try:
                    st = os.stat(full)
                    size = st.st_size if not is_dir else 0
                    mod = st.st_mtime
                except: size, mod = 0, 0
                entries.append({"name": name, "path": full.replace("\\","/"),
                    "is_dir": is_dir, "size": size, "modified": mod,
                    "ext": os.path.splitext(name)[1].lower() if not is_dir else ""})
            self._json(200, {"path": fpath, "entries": entries})
        except Exception as e:
            self._json(500, {"error": str(e)})

    def _api_read_file(self, fpath):
        try:
            if not fpath or not os.path.isfile(fpath):
                return self._json(404, {"error": f"not found: {fpath}"})
            size = os.path.getsize(fpath)
            with open(fpath, "r", encoding="utf-8", errors="replace") as f:
                content = f.read(100000)
            self._json(200, {"path": fpath, "content": content,
                "truncated": size > 100000, "size": size})
        except Exception as e:
            self._json(500, {"error": str(e)})

    def _discovery(self, what):
        if not _nova or not hasattr(_nova, 'scanner'):
            return self._json(503, {"ok": False, "error": "scanner not ready"})
        s = _nova.scanner
        if what == "graph":
            r = {"ok": True, "nodes": s.to_dict(), "count": len(s.nodes)}
        elif what == "hardware":
            r = {"ok": True, "nodes": [n.to_dict() for n in s.by_type("hardware")]}
        elif what == "software":
            r = {"ok": True, "nodes": [n.to_dict() for n in s.by_type("software")]}
        elif what == "services":
            r = {"ok": True, "nodes": [n.to_dict() for n in s.by_type("service")]}
        elif what == "models":
            r = {"ok": True, "nodes": [n.to_dict() for n in s.by_type("model")]}
        elif what == "abilities":
            r = {"ok": True, "abilities": s.abilities_summary()}
        elif what == "health":
            r = {"ok": True, "health": s.health_summary()}
        else:
            r = {"ok": False, "error": f"unknown: {what}"}
        return self._json(200, r)

    def _discovery_can(self, data):
        if not _nova or not hasattr(_nova, 'scanner'):
            return self._json(503, {"ok": False})
        ability = data.get("ability", "")
        return self._json(200, _nova.scanner.can(ability))

    def _discovery_scan(self, data):
        if not _nova or not hasattr(_nova, 'scanner'):
            return self._json(503, {"ok": False})
        elapsed = _nova.scanner.full_scan()
        return self._json(200, {"ok": True, "nodes": len(_nova.scanner.nodes), "elapsed": elapsed})


def start_server(port=PORT):
    server = ThreadingHTTPServer(("0.0.0.0", port), NovaHandler)
    server.daemon_threads = True
    return server
