    # ====== WiFi Bridge (proxies to VPN Core :9880) ======
    def _api_wifi_status(self):
        raw = self._proxy_get("http://localhost:9880/n/wifi/speeds")
        # Transform for frontend: expects {bridged, download_speed, upload_speed}
        adapters = raw.get("adapters", [])
        bonded = raw.get("bonded_speed_mbps", 0)
        count = raw.get("count", len(adapters))
        self._json(200, {
            "ok": True,
            "bridged": count > 1,
            "adapter_count": count,
            "adapters": adapters,
            "bonded_speed_mbps": bonded,
            "download_speed": f"{bonded:.0f} Mbps" if bonded else "N/A",
            "upload_speed": f"{bonded/2:.0f} Mbps" if bonded else "N/A",
        })

    def _api_wifi_bridge(self, data):
        result = self._proxy_post("http://localhost:9880/n/wifi/optimize", data)
        result["status"] = "Bridge optimized" if result.get("ok") else "Bridge failed"
        self._json(200, result)

    def _api_wifi_unbridge(self, data):
