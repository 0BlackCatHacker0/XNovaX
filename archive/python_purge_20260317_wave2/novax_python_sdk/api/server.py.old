    # ====== AI / API Config (proxies to Cloud Router :9878) ======
    def _proxy_get(self, url):
        try:
            with urllib.request.urlopen(url, timeout=5) as r:
                return json.loads(r.read())
        except Exception as e:
            return {"ok": False, "error": str(e)}

    def _proxy_post(self, url, payload):
        try:
            data = json.dumps(payload).encode()
            req = urllib.request.Request(url, data, {"Content-Type": "application/json"})
            with urllib.request.urlopen(req, timeout=15) as r:
                return json.loads(r.read())
        except Exception as e:
            return {"ok": False, "error": str(e)}

    def _api_ai_config_get(self):
        raw = self._proxy_get("http://localhost:9878/api/v1/providers")
        # Transform: Cloud Router uses 'anthropic', frontend uses 'claude'
        # Frontend expects {provider: {configured: bool}}
        result = {}
        name_map = {"anthropic": "claude", "openai": "openai", "deepseek": "deepseek",
                     "ollama": "ollama", "google": "google", "mistral": "mistral",
                     "groq": "groq", "cohere": "cohere", "together": "together"}
        for pid, info in raw.items():
            if isinstance(info, dict):
                key = name_map.get(pid, pid)
                result[key] = {
                    "configured": bool(info.get("key")) and info.get("on", False),
                    "enabled": info.get("on", False),
                    "has_key": bool(info.get("key")),
                    "models": info.get("models", []),
                    "name": info.get("name", pid),
                    "priority": info.get("pri", 99),
                }
        self._json(200, result)

    def _api_ai_config_post(self, data):
        # Frontend sends {provider: 'claude', api_key: '...'}
        # Cloud Router expects {provider: 'anthropic', api_key: '...'}
        name_map = {"claude": "anthropic"}
        provider = data.get("provider", "")
        data["provider"] = name_map.get(provider, provider)
        self._json(200, self._proxy_post("http://localhost:9878/api/v1/bind", data))

    def _api_ai_test(self, data):
        provider = data.get("provider", "ollama")
        prompt = "Reply with exactly: NOVAX_OK"
        payload = {"prompt": prompt, "providers": [provider]}
        result = self._proxy_post("http://localhost:9878/api/v1/query", payload)
        ok = result.get("succeeded", 0) > 0
        self._json(200, {"ok": ok, "provider": provider, "result": result})

    def _api_ai_query(self, data):
        self._json(200, self._proxy_post("http://localhost:9878/api/v1/query", data))

    def _api_ai_cloud(self):
