// nova_tpipeline_service.nova -- NovaX Ternary Pipeline Engine
// Port 9966 | NovaLang conversion of nova_tpipeline.py
//
// Chain multiple service calls into sequential workflows.
// Each step's output feeds into the next.
// Ternary short-circuit: if any step returns T_FALSE, the pipeline stops.
//
// Step format (dict fields):
//   name       -- step identifier (string)
//   url        -- HTTP endpoint (string)
//   method     -- GET or POST (string, default POST)
//   input_map  -- dict mapping param names to $refs or literals
//   output_key -- where to store result in context (string)
//   on_fail    -- stop | continue | retry:N (string, default stop)
//
// $-reference syntax in input_map values:
//   $input.field    -- original pipeline input field
//   $stepname.field -- output field from a previous step
//   $stepname       -- whole output of a previous step
//   literal         -- passed through unchanged
//
// Pipeline trit = product of all step trits.
// Any T_FALSE makes the whole pipeline T_FALSE.
// T_MAYBE degrades from T_TRUE. All T_TRUE = T_TRUE.
//
// Harmonics:
//   Step timeout  = H13 (13) seconds
//   History depth = 1000 runs
//   Max pipelines = H3^H7 / H3 = 729
//   Max steps     = H13 * H3 = 39
//
// Papers/foundations:
//   Unix pipeline composition (McIlroy, 1964)
//   Ternary short-circuit evaluation (Kleene, 1938)
//   Saga pattern for distributed workflows (Garcia-Molina and Salem, 1987)
//   Navier-Stokes: pipeline = laminar channel flow, failure = turbulent breakup

// ---------------------------------------------------------------------------
// Server bootstrap
// ---------------------------------------------------------------------------

// -- Shared Libraries (N-S Flow) --
import3("C:/NovaX/lib/nova_ns_core.nova")
import3("C:/NovaX/lib/nova_stdlib.nova")

let PORT = 9966
let server = tserve(PORT, "nova-tpipeline")

// ---------------------------------------------------------------------------
// Harmonic constants (3-5-7-13)
// ---------------------------------------------------------------------------

let BLOCK = 2187

// ---------------------------------------------------------------------------
// Pipeline constants
// ---------------------------------------------------------------------------

let VERSION = "1.0"
let STEP_TIMEOUT = 13
let MAX_PIPELINES = 729
let MAX_STEPS = 39
let HISTORY_DEPTH = 1000
let MAX_BODY = 10935

// ---------------------------------------------------------------------------
// Ternary truth values
// ---------------------------------------------------------------------------

let T_TRUE = 1
let T_MAYBE = 0
let T_FALSE = -1

// ---------------------------------------------------------------------------
// Service state
// ---------------------------------------------------------------------------

// _pipelines: dict of pipeline_name -> pipeline_definition dict
let _pipelines = {}

// _history: list of execution records (capped at HISTORY_DEPTH)
let _history = []

// _history_count: how many records are stored (for cap enforcement)
let _history_count = 0

// _ops: total operations recorded
let _ops = 0

// _start_time: service start epoch
let _start_time = time()

// ---------------------------------------------------------------------------
// Helper: trit character
// Returns "+" for T_TRUE, "?" for T_MAYBE, "-" for T_FALSE
// ---------------------------------------------------------------------------

fn tchar(t) {
    let result = "?"
    if3 (t > 0) { result = "+"
    } else3 if3 (t < 0) { result = "-"
    }
    result
}

// ---------------------------------------------------------------------------
// Helper: clamp integer between lo and hi
// ---------------------------------------------------------------------------

fn clamp_int(val, lo, hi) {
    let out = val
    if3 (val < lo) { out = lo
    }
    if3 (val > hi) { out = hi
    }
    out
}

// ---------------------------------------------------------------------------
// Helper: record stats for an operation
// ---------------------------------------------------------------------------

fn record_stat(t) {
    _ops = _ops + 1
    T_TRUE
}

// ---------------------------------------------------------------------------
// Helper: health dict
// ---------------------------------------------------------------------------

fn build_health(pipeline_count, history_len) {
    let up = time() - _start_time
    let h = ns_health_dict("nova-tpipeline", VERSION, PORT, {})
    h = dict_set(h, "uptime_s", round(up, 1))
    h = dict_set(h, "ops", _ops)
    h = dict_set(h, "pipelines_defined", pipeline_count)
    h = dict_set(h, "executions_recorded", history_len)
    h
}

// ---------------------------------------------------------------------------
// Helper: resolve a $-prefixed reference against pipeline context
//
// Supports:
//   $input        -> dict_get(context, "input")
//   $input.field  -> dict_get(dict_get(context, "input"), "field")
//   $step         -> dict_get(context, "step")
//   $step.field   -> dict_get(dict_get(context, "step"), "field")
//   anything else -> returned as-is (literal)
//
// NovaLang note: no recursive dotted drilling beyond one level --
// the spec allows $step.field (one dot). Deeper nesting is not
// expressible without list[i] syntax, so we stop at one dot level.
// ---------------------------------------------------------------------------

fn resolve_ref(ref, context) { resolved = ref
    if3 (type_of(ref) == "string") {
        if3 (contains(ref, "$") ) {
            // Check that ref starts with $
            let first_char = slice(ref, 0, 1)
            if3 (first_char == "$") { path = slice(ref, 1, len(ref))
                let dot_pos = -1
                // Find first dot by checking split
                let parts = split(path, ".")
                let key = dict_get(parts, 0)
                let has_key = dict_has(context, key)
                if3 (has_key ) { val = dict_get(context, key)
                    let parts_len = len(parts)
                    if3 (parts_len > 1) {
                        // One-level field access
                        let field = dict_get(parts, 1)
                        if3 (type_of(val) == "dict") { has_field = dict_has(val, field)
                            if3 (has_field ) { resolved = dict_get(val, field)
                            } else3 {
                                resolved = ""
                            }
                        } else3 {
                            resolved = ""
                        }
                    } else3 {
                        resolved = val
                    }
                } else3 {
                    resolved = ""
                }
            }
        }
    }
    resolved
}

// ---------------------------------------------------------------------------
// Helper: build step input dict from input_map and context
// Resolves all $-refs. Non-dict / missing input_map passes context input.
// ---------------------------------------------------------------------------

fn build_step_input(input_map, context) {
    let result = {}
    if3 (type_of(input_map) == "dict") { map_keys = keys(input_map)
        let ki = 0
        let mk_len = len(map_keys)
        while3 (ki < mk_len) {
            let k = dict_get(map_keys, ki)
            let v = dict_get(input_map, k)
            if3 (type_of(v) == "string") { first_char = slice(v, 0, 1)
                if3 (first_char == "$") { resolved_v = resolve_ref(v, context)
                    result = dict_set(result, k, resolved_v)
                } else3 {
                    result = dict_set(result, k, v)
                }
            } else3 {
                result = dict_set(result, k, v)
            }
            ki = ki + 1
        }
    } else3 {
        // No input_map -- pass through the original input
        let has_input = dict_has(context, "input")
        if3 (has_input ) { ctx_input = dict_get(context, "input")
            if3 (type_of(ctx_input) == "dict") { ctx_keys = keys(ctx_input)
                let ci = 0
                let ck_len = len(ctx_keys)
                while3 (ci < ck_len) {
                    let ck = dict_get(ctx_keys, ci)
                    let cv = dict_get(ctx_input, ck)
                    result = dict_set(result, ck, cv)
                    ci = ci + 1
                }
            }
        }
    }
    result
}

// ---------------------------------------------------------------------------
// Helper: execute one pipeline step via HTTP
// Returns a step_result dict with fields:
//   step_trit  -- T_TRUE / T_MAYBE / T_FALSE
//   step_out   -- parsed response dict (or empty dict)
//   step_error -- error string (or "")
//
// on_fail handling:
//   "stop"     -- return T_FALSE on any error
//   "continue" -- return T_MAYBE on error so pipeline keeps going
//   "retry:N"  -- retry up to N times (capped at H7=7), then T_FALSE
// ---------------------------------------------------------------------------

fn execute_step(step, context) {
    let url = dict_get(step, "url")
    let method_raw = "POST"
    if3 (dict_has(step, "method") ) { method_raw = dict_get(step, "method")
    }
    let method = upper(method_raw)

    let on_fail = "stop"
    if3 (dict_has(step, "on_fail") ) { on_fail = dict_get(step, "on_fail")
    }

    let input_map = ""
    if3 (dict_has(step, "input_map") ) { input_map = dict_get(step, "input_map")
    }

    // Determine max_retries from on_fail
    let max_retries = 1
    if3 (type_of(on_fail) == "string") {
        if3 (contains(on_fail, "retry:") ) { parts = split(on_fail, ":")
            let retry_str = dict_get(parts, 1)
            let parsed_n = int(retry_str)
            max_retries = clamp_int(parsed_n, 1, H7)
        }
    }

    // Build request body
    let step_body = build_step_input(input_map, context)
    let body_str = json_encode(step_body)

    // Attempt loop
    let attempt = 0
    let step_trit = T_FALSE
    let step_out = {}
    let step_error = ""

    while3 (attempt < max_retries) {
        let call_result = {}
        if3 (method == "GET") { call_result = http_get(url)
        } else3 {
            call_result = http_post(url, body_str)
        }

        // http_get/http_post return dict with "ok", "body", "status", "error"
        let call_ok = dict_get(call_result, "ok")
        if3 (call_ok ) { raw_body = dict_get(call_result, "body")
            let parsed = {}
            try3 {
                let parsed = json_decode(raw_body)
            } catch3 {
                parsed = dict_set(parsed, "raw", raw_body)
            }

            // Extract trit from response
            let resp_trit = T_TRUE
            if3 (type_of(parsed) == "dict") {
                if3 (dict_has(parsed, "trit") ) { resp_trit = int(dict_get(parsed, "trit"))
                } else3 if3 (dict_has(parsed, "ok") ) { ok_val = dict_get(parsed, "ok")
                    if3 (ok_val == 0) { resp_trit = T_FALSE
                    }
                }
            }

            step_trit = resp_trit
            step_out = parsed
            step_error = ""
            // Success -- break out of retry loop by setting attempt = max_retries
            attempt = max_retries
        } else3 {
            step_error = dict_get(call_result, "error")
            step_trit = T_FALSE
            attempt = attempt + 1
        }
    }

    // If on_fail == "continue" and we failed, soften to T_MAYBE
    if3 (step_trit < 0) {
        if3 (on_fail == "continue") { step_trit = T_MAYBE
        }
    }

    let out = {}
    out = dict_set(out, "step_trit", step_trit)
    out = dict_set(out, "step_out", step_out)
    out = dict_set(out, "step_error", step_error)
    out
}

// ---------------------------------------------------------------------------
// Helper: validate a single step dict
// Returns dict with "ok" (1/0) and "err" (string)
// ---------------------------------------------------------------------------

fn validate_step(step, index) {
    let ok = 1
    let err = ""

    if3 (type_of(step) != "dict") { ok = 0
        let idx_str = str(index)
        let err = join(["step ", idx_str, ": must be a dict"], "")
    } else3 {
        let has_name = dict_has(step, "name")
        if3 (has_name == 0) { ok = 0
            let idx_str = str(index)
            let err = join(["step ", idx_str, ": name required"], "")
        } else3 {
            let sname = dict_get(step, "name")
            let has_url = dict_has(step, "url")
            if3 (has_url == 0) { ok = 0
                let err = join(["step ", sname, ": url required"], "")
            } else3 {
                let surl = dict_get(step, "url")
                let url_ok = 0
                if3 (contains(surl, "http://") ) { url_ok = 1
                }
                if3 (contains(surl, "https://") ) { url_ok = 1
                }
                if3 (url_ok == 0) { ok = 0
                    let err = join(["step ", sname, ": url must be http or https"], "")
                }
            }
        }
    }

    let r = {}
    r = dict_set(r, "ok", ok)
    r = dict_set(r, "err", err)
    r
}

// ---------------------------------------------------------------------------
// Helper: validate a full pipeline definition
// Returns dict with "ok" (1/0) and "err" (string)
// ---------------------------------------------------------------------------

fn validate_pipeline(definition) {
    let ok = 1
    let err = ""

    if3 (dict_has(definition, "name") == 0) { ok = 0
        let err = "name required (string)"
    } else3 {
        let pname = dict_get(definition, "name")
        let pname_len = len(pname)
        if3 (pname_len > 128) { ok = 0
            let err = "name too long (max 128 chars)"
        } else3 {
            if3 (dict_has(definition, "steps") == 0) { ok = 0
                let err = "steps required (non-empty list)"
            } else3 {
                let steps = dict_get(definition, "steps")
                let steps_len = len(steps)
                if3 (steps_len == 0) { ok = 0
                    let err = "steps required (non-empty list)"
                } else3 if3 (steps_len > MAX_STEPS) { ok = 0
                    let max_str = str(MAX_STEPS)
                    let err = join(["too many steps (max ", max_str, ")"], "")
                } else3 {
                    // Validate each step
                    let si = 0
                    while3 (si < steps_len) {
                        let st = dict_get(steps, si)
                        let sv = validate_step(st, si)
                        let sv_ok = dict_get(sv, "ok")
                        if3 (sv_ok == 0) { ok = 0
                            let err = dict_get(sv, "err")
                        }
                        si = si + 1
                    }
                }
            }
        }
    }

    let r = {}
    r = dict_set(r, "ok", ok)
    r = dict_set(r, "err", err)
    r
}

// ---------------------------------------------------------------------------
// Core: run a full pipeline, return an execution record dict
// ---------------------------------------------------------------------------

fn run_pipeline(pipeline_def, user_input) {
    let run_id = uuid_hex()
    let run_id = slice(run_id, 0, 13)

    let pname = "unknown"
    if3 (dict_has(pipeline_def, "name") ) { pname = dict_get(pipeline_def, "name")
    }

    let steps = []
    if3 (dict_has(pipeline_def, "steps") ) { steps = dict_get(pipeline_def, "steps")
    }

    let started = time()

    // Build initial context
    let context = {}
    context = dict_set(context, "input", user_input)

    // Pipeline-level trit accumulator
    let pipeline_trit = T_TRUE

    // Step records list
    let step_records = []

    // Stopped-at name (empty = not stopped early)
    let stopped_at = ""
    let stop_error = ""

    let steps_len = len(steps)
    let si = 0
    let pipeline_done = 0

    while3 (si < steps_len) {
        if3 (pipeline_done == 0) { step = dict_get(steps, si)

            let step_name = join(["step_", str(si)], "")
            if3 (dict_has(step, "name") ) { step_name = dict_get(step, "name")
            }

            let output_key = step_name
            if3 (dict_has(step, "output_key") ) { output_key = dict_get(step, "output_key")
            }

            let on_fail = "stop"
            if3 (dict_has(step, "on_fail") ) { on_fail = dict_get(step, "on_fail")
            }

            let t0 = time()
            let step_result = execute_step(step, context)
            let t1 = time()
            let elapsed_ms = round((t1 - t0) * 1000, 1)

            let step_trit = dict_get(step_result, "step_trit")
            let step_out = dict_get(step_result, "step_out")
            let step_error = dict_get(step_result, "step_error")

            // Store step output in context for subsequent steps
            if3 (type_of(step_out) == "dict") { context = dict_set(context, output_key, step_out)
            }

            // Build step record
            let step_url = ""
            if3 (dict_has(step, "url") ) { step_url = dict_get(step, "url")
            }
            let step_rec = {}
            step_rec = dict_set(step_rec, "index", si)
            step_rec = dict_set(step_rec, "name", step_name)
            step_rec = dict_set(step_rec, "url", step_url)
            step_rec = dict_set(step_rec, "trit", step_trit)
            step_rec = dict_set(step_rec, "char", tchar(step_trit))
            step_rec = dict_set(step_rec, "elapsed_ms", elapsed_ms)
            step_rec = dict_set(step_rec, "error", step_error)
            step_records = append(step_records, step_rec)

            // Update pipeline trit (product logic)
            if3 (step_trit < 0) { pipeline_trit = T_FALSE
            } else3 if3 (step_trit == 0) {
                if3 (pipeline_trit > 0) { pipeline_trit = T_MAYBE
                }
            }

            // Short-circuit on failure
            if3 (step_trit < 0) {
                if3 (on_fail == "stop") { stopped_at = step_name
                    stop_error = step_error
                    pipeline_done = 1
                } else3 {
                    if3 (contains(on_fail, "retry:") ) { stopped_at = step_name
                        stop_error = step_error
                        pipeline_done = 1
                    }
                }
            }
        }
        si = si + 1
    }

    let finished = time()
    let duration_ms = round((finished - started) * 1000, 1)

    // Build final output from context (exclude input key)
    let final_output = {}
    let ctx_keys = keys(context)
    let cki = 0
    let ck_len = len(ctx_keys)
    while3 (cki < ck_len) {
        let ck = dict_get(ctx_keys, cki)
        if3 (ck != "input") { cv = dict_get(context, ck)
            final_output = dict_set(final_output, ck, cv)
        }
        cki = cki + 1
    }

    // Assemble record
    let record = {}
    record = dict_set(record, "run_id", run_id)
    record = dict_set(record, "pipeline", pname)
    record = dict_set(record, "started", started)
    record = dict_set(record, "finished", finished)
    record = dict_set(record, "duration_ms", duration_ms)
    record = dict_set(record, "input", user_input)
    record = dict_set(record, "steps", step_records)
    record = dict_set(record, "trit", pipeline_trit)
    record = dict_set(record, "char", tchar(pipeline_trit))
    record = dict_set(record, "stopped_at", stopped_at)
    record = dict_set(record, "error", stop_error)
    record = dict_set(record, "output", final_output)
    record
}

// ---------------------------------------------------------------------------
// Helper: append execution record to history, respecting HISTORY_DEPTH cap
// ---------------------------------------------------------------------------

fn push_history(record) {
    _history = append(_history, record)
    _history_count = _history_count + 1
    // Trim oldest entries when over cap
    if3 (_history_count > HISTORY_DEPTH) { trim = _history_count - HISTORY_DEPTH
        _history = slice(_history, trim, _history_count)
        _history_count = HISTORY_DEPTH
    }
    T_TRUE
}

// ---------------------------------------------------------------------------
// Route: GET /health
// Route: GET /tpipeline/health
// ---------------------------------------------------------------------------

fn handle_health() {
    let pipeline_count = len(keys(_pipelines))
    build_health(pipeline_count, _history_count)
}

// ---------------------------------------------------------------------------
// Route: GET /tpipeline/list
// ---------------------------------------------------------------------------

fn handle_list() {
    let pipeline_names = keys(_pipelines)
    let pn_len = len(pipeline_names)
    let pipeline_summaries = {}
    let ni = 0
    while3 (ni < pn_len) {
        let pname = dict_get(pipeline_names, ni)
        let pdef = dict_get(_pipelines, pname)
        let pdesc = ""
        if3 (dict_has(pdef, "description") ) { pdesc = dict_get(pdef, "description")
        }
        let psteps = []
        if3 (dict_has(pdef, "steps") ) { psteps = dict_get(pdef, "steps")
        }
        let pstep_count = len(psteps)

        // Collect step names
        let step_names = []
        let sni = 0
        while3 (sni < pstep_count) {
            let sn_step = dict_get(psteps, sni)
            let sn_name = join(["step_", str(sni)], "")
            if3 (dict_has(sn_step, "name") ) { sn_name = dict_get(sn_step, "name")
            }
            step_names = append(step_names, sn_name)
            sni = sni + 1
        }

        let pcreated = 0
        if3 (dict_has(pdef, "created") ) { pcreated = dict_get(pdef, "created")
        }

        let summary = {}
        summary = dict_set(summary, "description", pdesc)
        summary = dict_set(summary, "steps", pstep_count)
        summary = dict_set(summary, "step_names", step_names)
        summary = dict_set(summary, "created", pcreated)
        pipeline_summaries = dict_set(pipeline_summaries, pname, summary)
        ni = ni + 1
    }

    let resp = {}
    resp = dict_set(resp, "ok", 1)
    resp = dict_set(resp, "trit", T_TRUE)
    resp = dict_set(resp, "pipelines", pipeline_summaries)
    resp = dict_set(resp, "count", pn_len)
    resp
}

// ---------------------------------------------------------------------------
// Route: GET /tpipeline/get -- expects "name" query param in body
//        POST /tpipeline/get -- body: {"name": "<pipeline_name>"}
// ---------------------------------------------------------------------------

fn handle_get(body) {
    let pname = ""
    if3 (dict_has(body, "name") ) { pname = dict_get(body, "name")
    }

    let resp = {}
    if3 (len(pname) == 0) { resp = dict_set(resp, "ok", 0)
        resp = dict_set(resp, "trit", T_FALSE)
        resp = dict_set(resp, "error", "pipeline name required")
    } else3 {
        if3 (dict_has(_pipelines, pname) == 0) { resp = dict_set(resp, "ok", 0)
            resp = dict_set(resp, "trit", T_FALSE)
            resp = dict_set(resp, "error", join(["pipeline '", pname, "' not found"], ""))
        } else3 {
            let pdef = dict_get(_pipelines, pname)
            resp = dict_set(resp, "ok", 1)
            resp = dict_set(resp, "trit", T_TRUE)
            resp = dict_set(resp, "pipeline", pdef)
        }
    }
    return resp
}

// ---------------------------------------------------------------------------
// Route: GET /tpipeline/history
// ---------------------------------------------------------------------------

fn handle_history() {
    // Return last 100 records, most recent first
    let hist_len = _history_count
    let start_idx = 0
    if3 (hist_len > 100) { start_idx = hist_len - 100
    }

    let recent = slice(_history, start_idx, hist_len)

    // Reverse to most-recent-first
    let recent = reverse(recent)

    // Build slim records
    let slim = []
    let ri = 0
    let recent_len = len(recent)
    while3 (ri < recent_len) {
        let r = dict_get(recent, ri)

        let rr_steps = []
        if3 (dict_has(r, "steps") ) { rr_steps = dict_get(r, "steps")
        }

        let sr = {}
        sr = dict_set(sr, "run_id", dict_get(r, "run_id"))
        sr = dict_set(sr, "pipeline", dict_get(r, "pipeline"))
        sr = dict_set(sr, "trit", dict_get(r, "trit"))
        sr = dict_set(sr, "char", dict_get(r, "char"))
        sr = dict_set(sr, "started", dict_get(r, "started"))
        sr = dict_set(sr, "duration_ms", dict_get(r, "duration_ms"))
        sr = dict_set(sr, "steps_executed", len(rr_steps))
        sr = dict_set(sr, "stopped_at", dict_get(r, "stopped_at"))
        sr = dict_set(sr, "error", dict_get(r, "error"))
        slim = append(slim, sr)
        ri = ri + 1
    }

    let resp = {}
    resp = dict_set(resp, "ok", 1)
    resp = dict_set(resp, "trit", T_TRUE)
    resp = dict_set(resp, "executions", slim)
    resp = dict_set(resp, "count", len(slim))
    resp
}

// ---------------------------------------------------------------------------
// Route: POST /tpipeline/run
// Body: {"pipeline": "<name>", "input": {...}}
// ---------------------------------------------------------------------------

fn handle_run(body) {
    let pname = ""
    if3 (dict_has(body, "pipeline") ) { pname = dict_get(body, "pipeline")
    }

    let user_input = {}
    if3 (dict_has(body, "input") ) { user_input = dict_get(body, "input")
    }

    let resp = {}
    if3 (len(pname) == 0) { resp = dict_set(resp, "ok", 0)
        resp = dict_set(resp, "trit", T_FALSE)
        resp = dict_set(resp, "error", "pipeline name required")
    } else3 {
        if3 (dict_has(_pipelines, pname) == 0) { avail = keys(_pipelines)
            resp = dict_set(resp, "ok", 0)
            resp = dict_set(resp, "trit", T_FALSE)
            resp = dict_set(resp, "error", join(["pipeline '", pname, "' not found"], ""))
            resp = dict_set(resp, "available", avail)
        } else3 {
            let pipeline_def = dict_get(_pipelines, pname)
            let record = run_pipeline(pipeline_def, user_input)
            let push_ok = push_history(record)
            let stat_ok = record_stat(dict_get(record, "trit"))

            let rec_steps = dict_get(record, "steps")
            let pipeline_steps = []
            if3 (dict_has(pipeline_def, "steps") ) { pipeline_steps = dict_get(pipeline_def, "steps")
            }
            let rtrit = dict_get(record, "trit")
            let ok_val = 0
            if3 (rtrit >= 0) { ok_val = 1
            }

            resp = dict_set(resp, "ok", ok_val)
            resp = dict_set(resp, "trit", rtrit)
            resp = dict_set(resp, "char", dict_get(record, "char"))
            resp = dict_set(resp, "run_id", dict_get(record, "run_id"))
            resp = dict_set(resp, "pipeline", pname)
            resp = dict_set(resp, "steps_total", len(pipeline_steps))
            resp = dict_set(resp, "steps_executed", len(rec_steps))
            resp = dict_set(resp, "stopped_at", dict_get(record, "stopped_at"))
            resp = dict_set(resp, "duration_ms", dict_get(record, "duration_ms"))
            resp = dict_set(resp, "step_results", rec_steps)
            resp = dict_set(resp, "output", dict_get(record, "output"))
            resp = dict_set(resp, "error", dict_get(record, "error"))
        }
    }
    return resp
}

// ---------------------------------------------------------------------------
// Route: POST /tpipeline/define
// Body: {"name": "...", "steps": [...], "description": "..."}
// ---------------------------------------------------------------------------

fn handle_define(body) {
    let pname = ""
    if3 (dict_has(body, "name") ) { pname = dict_get(body, "name")
    }

    let pdesc = ""
    if3 (dict_has(body, "description") ) { pdesc = dict_get(body, "description")
    }

    let psteps = []
    if3 (dict_has(body, "steps") ) { psteps = dict_get(body, "steps")
    }

    let resp = {}
    if3 (len(pname) == 0) { resp = dict_set(resp, "ok", 0)
        resp = dict_set(resp, "trit", T_FALSE)
        resp = dict_set(resp, "error", "name required")
    } else3 {
        let definition = {}
        definition = dict_set(definition, "name", pname)
        definition = dict_set(definition, "description", pdesc)
        definition = dict_set(definition, "steps", psteps)
        definition = dict_set(definition, "created", time())

        let vr = validate_pipeline(definition)
        let vr_ok = dict_get(vr, "ok")
        if3 (vr_ok == 0) { resp = dict_set(resp, "ok", 0)
            resp = dict_set(resp, "trit", T_FALSE)
            resp = dict_set(resp, "error", dict_get(vr, "err"))
        } else3 {
            let pipeline_count = len(keys(_pipelines))
            let is_update = dict_has(_pipelines, pname)
            if3 (is_update == 0) {
                if3 (pipeline_count >= MAX_PIPELINES) { max_str = str(MAX_PIPELINES)
                    resp = dict_set(resp, "ok", 0)
                    resp = dict_set(resp, "trit", T_FALSE)
                    resp = dict_set(resp, "error", join(["max pipelines (", max_str, ") reached"], ""))
                } else3 {
                    _pipelines = dict_set(_pipelines, pname, definition)
                    let stat_ok = record_stat(T_TRUE)
                    resp = dict_set(resp, "ok", 1)
                    resp = dict_set(resp, "trit", T_TRUE)
                    resp = dict_set(resp, "action", "created")
                    resp = dict_set(resp, "pipeline", pname)
                    resp = dict_set(resp, "steps", len(psteps))
                }
            } else3 {
                _pipelines = dict_set(_pipelines, pname, definition)
                let stat_ok = record_stat(T_TRUE)
                resp = dict_set(resp, "ok", 1)
                resp = dict_set(resp, "trit", T_TRUE)
                resp = dict_set(resp, "action", "updated")
                resp = dict_set(resp, "pipeline", pname)
                resp = dict_set(resp, "steps", len(psteps))
            }
        }
    }
    return resp
}

// ---------------------------------------------------------------------------
// Route: POST /tpipeline/delete
// Body: {"name": "<pipeline_name>"}
// ---------------------------------------------------------------------------

fn handle_delete(body) {
    let pname = ""
    if3 (dict_has(body, "name") ) { pname = dict_get(body, "name")
    }

    let resp = {}
    if3 (len(pname) == 0) { resp = dict_set(resp, "ok", 0)
        resp = dict_set(resp, "trit", T_FALSE)
        resp = dict_set(resp, "error", "name required")
    } else3 {
        if3 (dict_has(_pipelines, pname) == 0) { resp = dict_set(resp, "ok", 0)
            resp = dict_set(resp, "trit", T_FALSE)
            resp = dict_set(resp, "error", join(["pipeline '", pname, "' not found"], ""))
        } else3 {
            _pipelines = dict_del(_pipelines, pname)
            let stat_ok = record_stat(T_TRUE)
            resp = dict_set(resp, "ok", 1)
            resp = dict_set(resp, "trit", T_TRUE)
            resp = dict_set(resp, "deleted", pname)
        }
    }
    return resp
}

// ---------------------------------------------------------------------------
// Register routes
// ---------------------------------------------------------------------------

let _r0 = troute(server, "GET",  "/health",             handle_health)
let _r1 = troute(server, "GET",  "/tpipeline/health",   handle_health)
let _r2 = troute(server, "GET",  "/tpipeline/list",     handle_list)
let _r3 = troute(server, "GET",  "/tpipeline/history",  handle_history)
let _r4 = troute(server, "POST", "/tpipeline/get",      handle_get)
let _r5 = troute(server, "POST", "/tpipeline/run",      handle_run)
let _r6 = troute(server, "POST", "/tpipeline/define",   handle_define)
let _r7 = troute(server, "POST", "/tpipeline/delete",   handle_delete)

