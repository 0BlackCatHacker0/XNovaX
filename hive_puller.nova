// ============================================================
// NovaLang Hive Puller v1.1 -- Navier-Stokes Wave Model Loader
// ============================================================
// Pulls Ollama models using fluid dynamics wave scheduling.
// Runs ENTIRELY inside the Hivemind process -- zero shells, zero windows.
// ============================================================

let PULLED = Trit(1)
let FAILED = Trit(-1)

// --- Target Models ---
let targets = [
    "internlm2:7b",
    "magicoder:7b",
    "samantha-mistral:7b",
    "sqlcoder:7b",
    "stable-code:3b",
    "yarn-llama2:7b",
    "mistrallite:7b",
    "bakllava:7b",
    "wizard-vicuna-uncensored:7b",
    "yarn-mistral:7b",
    "gemma:7b",
    "qwen2:0.5b",
    "qwen2:1.5b",
    "llama3:latest",
    "mistral-nemo:latest",
    "aya:8b",
    "phi3:medium",
    "granite3-dense:8b"
]

// --- Wave Config ---
let wave_size = 3
let wave_delay_sec = 2.0
let total_targets = len(targets)
let pull_Re = hive_reynolds(wave_size, 1.5, 4.0, wave_delay_sec)
print(f"Reynolds: {pull_Re} | Targets: {total_targets}")

let existing = hive_models()
let existing_count = len(existing)
hive_set_total(total_targets)

print("=== NOVALANG HIVE PULLER: ENGAGING ===")

// --- Pull all models (flat loop, no nested blocks) ---
for3 model in targets {
    print(f"  Pulling: {model}")
    hive_pull(model)
    wave_delay(wave_delay_sec)
}

// --- Final Report ---
print("=== PULL COMPLETE ===")
let new_models = hive_models()
let new_count = len(new_models)
let added = new_count - existing_count
print(f"Before: {existing_count} | After: {new_count} | Added: {added}")
print(f"Reynolds: {pull_Re} | Health: P")
