// benchmark_parse.nova - Parse benchmark results from cloud providers
// Replaces benchmark_parse.py

fn3 main() {
    let providers = ["cerebras", "sambanova", "google", "openai", "openrouter", "groq", "together", "mistral", "cohere", "deepseek", "anthropic", "apifreellm"]
    let total_tokens = 0
    let total_chars = 0
    let succeeded = 0
    let failed = 0
    let results = []

    for3 p in providers {
        let fpath = "/tmp/nova_" + p + ".json"
        if3 file_exists(fpath) == false {
            print(p + "                      NO FILE")
            failed = failed + 1
        } else3 {
            try3 {
                let content = read_file(fpath)
                let d = parse_json(content)
                let r = dict_get(d, "result") ?? {}
                let prov = dict_get(r, "provider") ?? p
                let model = dict_get(r, "model") ?? "?"
                let tokens = int(dict_get(r, "tokens") ?? 0)
                let time_ms = dict_get(r, "time_ms") ?? 0
                let resp = dict_get(r, "response") ?? ""
                let chars = len(resp)
                let ok = dict_get(d, "ok") ?? 0

                if3 ok == 1 {
                    if3 chars > 0 {
                        succeeded = succeeded + 1
                        total_tokens = total_tokens + tokens
                        total_chars = total_chars + chars
                        results = append(results, [prov, model, tokens, time_ms, chars])
                        print(prov + " OK  model=" + model + " tokens=" + str(tokens) + "  time=" + str(time_ms) + "ms  chars=" + str(chars))
                    } else3 {
                        failed = failed + 1
                        print(p + " FAIL  ok=" + str(ok) + "  chars=" + str(chars))
                    }
                } else3 {
                    failed = failed + 1
                    print(p + " FAIL  ok=" + str(ok) + "  chars=" + str(chars))
                }
            } catch3 {
                failed = failed + 1
                print(p + " ERROR")
            }
        }
    }

    print("")
    print("======================================================================")
    print("  PROVIDERS SUCCEEDED:   " + str(succeeded) + " / " + str(len(providers)))
    print("  PROVIDERS FAILED:      " + str(failed))
    print("  TOTAL TOKENS:          " + str(total_tokens))
    print("  TOTAL CHARS:           " + str(total_chars))
    if3 succeeded > 0 {
        print("  AVG TOKENS/PROVIDER:   " + str(total_tokens / succeeded))
        print("  AVG CHARS/PROVIDER:    " + str(total_chars / succeeded))
    }
    print("  COMBINED OUTPUT:       " + str(total_chars) + " chars = ~" + str(total_chars / 4) + " words")
    print("======================================================================")
    print("")
    print("NO SINGLE MODEL PRODUCED THIS. The combined swarm output is:")
    print("  " + str(total_chars) + " characters across " + str(succeeded) + " providers")
    print("  That's " + str(succeeded) + "x the output of any individual model.")
    print("")

    // Show first 200 chars of each response
    print("--- RESPONSE PREVIEWS (first 200 chars each) ---")
    for3 p in providers {
        let fpath = "/tmp/nova_" + p + ".json"
        if3 file_exists(fpath) {
            try3 {
                let content = read_file(fpath)
                let d = parse_json(content)
                let resp = dict_get(dict_get(d, "result") ?? {}, "response") ?? ""
                if3 len(resp) > 0 {
                    let preview = slice(resp, 0, 200)
                    print("")
                    print("[" + upper(p) + "]: " + preview + "...")
                }
            } catch3 {}
        }
    }
}

main()
