// ============================================================================
// PROBE PROMPTS -- 10 channels x 3 tiers = 30 probes
// ============================================================================

let PROBE_PROMPTS = {}

// REASON probes
let reason_probes = []
append(reason_probes, {"prompt": "If all cats are animals and some animals are pets, can we conclude all cats are pets?", "signals": ["yes", "logic", "conclusion", "premise", "valid"], "tier": "easy"})
append(reason_probes, {"prompt": "A farmer has a fox, chicken, and grain. He can only carry one across the river at a time. The fox eats the chicken if left alone. The chicken eats the grain. How does he get all three across?", "signals": ["first", "then", "back", "step", "cross", "leave"], "tier": "medium"})
append(reason_probes, {"prompt": "Analyze: If increasing minimum wage causes unemployment, but also reduces poverty, and reducing poverty lowers crime, but unemployment increases crime -- what is the net effect on crime? Consider second-order effects.", "signals": ["trade-off", "net", "depends", "magnitude", "offset", "second-order", "consider"], "tier": "hard"})
dict_set(PROBE_PROMPTS, "REASON", reason_probes)

// MATH probes
let math_probes = []
append(math_probes, {"prompt": "What is 15 * 17?", "signals": ["255"], "tier": "easy"})
append(math_probes, {"prompt": "Find the derivative of f(x) = x^3 * sin(x).", "signals": ["3x^2", "cos", "sin", "product rule", "derivative"], "tier": "medium"})
append(math_probes, {"prompt": "Prove that the sum of the first n odd numbers equals n^2. Use mathematical induction.", "signals": ["base case", "inductive", "hypothesis", "k+1", "assume", "prove", "n^2"], "tier": "hard"})
dict_set(PROBE_PROMPTS, "MATH", math_probes)

// CODE probes
let code_probes = []
append(code_probes, {"prompt": "Write a Python function that checks if a string is a palindrome.", "signals": ["def ", "return", "[::-1]", "reverse", "==", "palindrome"], "tier": "easy"})
append(code_probes, {"prompt": "Implement a binary search function in Python that works on a sorted list. Return the index or -1.", "signals": ["def ", "while", "mid", "left", "right", "return", "//"], "tier": "medium"})
append(code_probes, {"prompt": "Implement a thread-safe LRU cache in Python using OrderedDict and threading locks. Support get() and put() with O(1) complexity.", "signals": ["class", "OrderedDict", "Lock", "def get", "def put", "capacity", "move_to_end"], "tier": "hard"})
dict_set(PROBE_PROMPTS, "CODE", code_probes)

// INSTRUCT probes
let instruct_probes = []
append(instruct_probes, {"prompt": "List 3 steps to make a peanut butter sandwich.", "signals": ["1", "2", "3", "bread", "peanut", "spread"], "tier": "easy"})
append(instruct_probes, {"prompt": "Write step-by-step instructions for setting up SSH key authentication on a Linux server. Include both client and server configuration.", "signals": ["ssh-keygen", "authorized_keys", "chmod", "ssh-copy-id", "config", ".ssh"], "tier": "medium"})
append(instruct_probes, {"prompt": "Create a complete disaster recovery plan for a PostgreSQL database. Include backup strategy, restore procedure, failover process, and testing schedule.", "signals": ["backup", "restore", "pg_dump", "replication", "failover", "WAL", "test", "RTO", "RPO"], "tier": "hard"})
