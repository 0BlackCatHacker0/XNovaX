append(language_probes, {"prompt": "Analyze the rhetorical devices used in Martin Luther King Jr's speech style. Identify at least 4 techniques with examples.", "signals": ["anaphora", "metaphor", "repetition", "parallelism", "allusion", "rhetoric"], "tier": "hard"})
dict_set(PROBE_PROMPTS, "LANGUAGE", language_probes)

// AGENT probes
let agent_probes = []
append(agent_probes, {"prompt": "You are a system administrator. A web server is returning 503 errors. What is your first diagnostic step?", "signals": ["log", "check", "status", "resource", "restart", "memory", "disk"], "tier": "easy"})
append(agent_probes, {"prompt": "You are an AI agent tasked with automating a CI/CD pipeline. Describe your action plan including tools and checkpoints.", "signals": ["git", "build", "test", "deploy", "pipeline", "Docker", "monitor", "rollback"], "tier": "medium"})
