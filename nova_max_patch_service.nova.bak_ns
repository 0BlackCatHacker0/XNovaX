append(fact_probes, {"prompt": "What is the speed of light in meters per second?", "signals": ["299", "792", "458", "3", "10^8", "vacuum"], "tier": "easy"})
append(fact_probes, {"prompt": "Explain the difference between mitosis and meiosis. Include the number of cell divisions and resulting cells.", "signals": ["mitosis", "meiosis", "diploid", "haploid", "two", "four", "division"], "tier": "medium"})
append(fact_probes, {"prompt": "Describe the mechanism of CRISPR-Cas9 gene editing, including guide RNA binding, PAM sequence recognition, and double-strand break repair pathways.", "signals": ["guide RNA", "Cas9", "PAM", "double-strand", "NHEJ", "HDR", "nuclease"], "tier": "hard"})
