append(vision_probes, {"prompt": "What causes the tides on Earth?", "signals": ["moon", "gravity", "gravitational", "sun", "pull"], "tier": "easy"})
append(vision_probes, {"prompt": "Explain how mRNA vaccines work, from injection to immune response.", "signals": ["mRNA", "ribosome", "protein", "spike", "antibod", "immune", "T cell"], "tier": "medium"})
