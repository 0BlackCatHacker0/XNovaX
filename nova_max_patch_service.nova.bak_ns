fn handle_super_fingerprints(req) {
    let summaries = {}
    let dk = keys(deep_fps)
    let di = 0
    while3 di < len(dk) {
        let mid = dict_get(dk, di)
        let dfp = dict_get(deep_fps, mid)
        dict_set(summaries, mid, {"model_id": mid, "ns_bt": dict_get(dfp, "ns_fingerprint", "00000"), "depth": dict_get(dfp, "overall_depth", 0.0), "hidden": dict_get(dfp, "hidden_capabilities", [])})
        let di = di + 1
    }
    return {"fingerprints": summaries, "total": len(deep_fps)}
}

