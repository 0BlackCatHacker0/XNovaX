// -- POST /patch/feedback
fn handle_patch_feedback(req) {
    let body = dict_get(req, "body", {})
    let model_id = dict_get(body, "model_id", "")
    let channel = upper(dict_get(body, "channel", "REASON"))
    let quality = float(dict_get(body, "quality", "0"))
    if3 len(model_id) == 0 {
        return {"error": "model_id required"}
    } else {
        let fp = dict_get(fingerprints, model_id, {})
        if3 len(keys(fp)) == 0 {
            return {"error": "model not found"}
        } else {
            let scores = dict_get(fp, "channel_scores", {})
            let old = dict_get(scores, channel, 0.0)
            let new_score = round(old * 0.667 + quality * 0.333, 3)
            dict_set(scores, channel, new_score)
            let fp = update_bt(fp)
            let bt = dict_get(fp, "bt_fingerprint", "0000000000")
            save_fingerprints()
            return {"ok": T_TRUE, "model": model_id, "channel": channel, "old": old, "new": new_score, "bt": bt}
        }
    }
}

// -- POST /super/probe
fn handle_super_probe(req) {
    let body = dict_get(req, "body", {})
    let model_id = dict_get(body, "model_id", "")
    if3 len(model_id) == 0 {
        return {"error": "model_id required"}
    } else {
        let probes = dict_get(body, "probes", [])
        let dfp = deep_probe(model_id, probes)
        return dfp
    }
}

// -- POST /super/probe-all
fn handle_super_probe_all(req) {
    let profiled = []
    let model_ids = keys(fingerprints)
    let mi = 0
    while3 mi < len(model_ids) {
        let mid = dict_get(model_ids, mi)
        let fp = dict_get(fingerprints, mid)
        if3 dict_get(fp, "probe_count", 0) > 0 {
            if3 is_excluded(mid) == T_FALSE {
                if3 dict_has(deep_fps, mid) == T_FALSE {
                    append(profiled, mid)
                }
            }
        }
        let mi = mi + 1
    }
    if3 len(profiled) == 0 {
        return {"started": T_FALSE, "reason": "all profiled models already deep-probed"}
    } else {
        // Sequential deep probe (max H13 per batch)
        let limit = H13
        if3 len(profiled) < H13 {
            let limit = len(profiled)
        }
        let probed = 0
        let pi = 0
        while3 pi < limit {
            let mid = dict_get(profiled, pi)
            try3 {
                deep_probe(mid, [])
                let probed = probed + 1
            } else {
                print("[SuperPatch] probe-all error for " + mid)
            }
            let pi = pi + 1
        }
        return {"started": T_TRUE, "models_queued": limit, "probed": probed}
    }
}

