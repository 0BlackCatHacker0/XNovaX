dict_set(CHANNEL_ASSIGNMENTS, "FACT", ["llama2:13b", "llama2:7b", "llama3.1", "llama3:", "gemma2:9b", "gemma2:latest", "aya:", "yi:", "internlm2", "vicuna"])
