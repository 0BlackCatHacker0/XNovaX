append(pressure_reason, {"prompt": "A bat and ball cost $1.10 total. The bat costs $1 more than the ball. How much is the ball?", "tier": 3, "signals": ["0.05", "5 cent", "five"]})
append(pressure_reason, {"prompt": "Three boxes labeled 'Apples', 'Oranges', 'Mixed' are ALL mislabeled. You pick one fruit from one box. From which box do you pick, and how do you relabel all three?", "tier": 4, "signals": ["mixed", "label", "one", "pick", "relabel", "deduce"]})
append(pressure_reason, {"prompt": "A king has 1000 bottles of wine, one poisoned. He has 10 prisoners to test. Poison kills in exactly 24h. He has one day. Using binary encoding, how many bottles can he check and what is the strategy?", "tier": 5, "signals": ["binary", "2^10", "1024", "bit", "encode", "combination", "each prisoner"]})
