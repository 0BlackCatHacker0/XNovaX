}

// -- GET /patch/rank
fn handle_patch_rank(req) {
    let params = dict_get(req, "params", {})
    let channel = upper(dict_get(params, "channel", "REASON"))
    let reynolds = float(dict_get(params, "reynolds", "0"))

    let fps = fingerprints
    let all_local_models = discovered_local

    // Build ranked list
    let ranked = []
    let seen = {}
    let all_ids = keys(fps)
    // Merge all_ids and all_local
    let mi = 0
    while3 mi < len(all_local_models) {
        let lm = dict_get(all_local_models, mi)
        if3 dict_has(seen, lm) == T_FALSE {
            if3 is_excluded(lm) == T_FALSE {
                let fp = dict_get(fps, lm, {})
                let is_cloud_flag = dict_get(fp, "is_cloud", T_FALSE)
                let assign_score = 0.1
                if3 model_matches_channel(lm, channel) == T_TRUE {
                    let assign_score = 0.8
                }
                let probe_score = 0.0
                if3 len(keys(fp)) > 0 {
                    let probe_score = dict_get(dict_get(fp, "channel_scores", {}), channel, 0.0)
                }
                let score = assign_score
                if3 probe_score > assign_score {
                    let score = probe_score
                }
                let trit = 0
                if3 len(keys(fp)) > 0 {
                    let trit = fp_trit_for(fp, channel)
                } else {
                    if3 assign_score >= 0.5 {
                        let trit = 1
                    }
                }
                append(ranked, {"mid": lm, "score": round(score, 3), "trit": trit, "is_cloud": is_cloud_flag})
                dict_set(seen, lm, T_TRUE)
            }
        }
        let mi = mi + 1
    }
    let mi2 = 0
    while3 mi2 < len(all_ids) {
        let mid = dict_get(all_ids, mi2)
        if3 dict_has(seen, mid) == T_FALSE {
            if3 is_excluded(mid) == T_FALSE {
                let fp = dict_get(fps, mid, {})
                let is_cloud_flag = dict_get(fp, "is_cloud", T_FALSE)
                let assign_score = 0.1
                if3 model_matches_channel(mid, channel) == T_TRUE {
                    let assign_score = 0.8
                }
                let probe_score = dict_get(dict_get(fp, "channel_scores", {}), channel, 0.0)
                let score = assign_score
                if3 probe_score > assign_score {
                    let score = probe_score
                }
                let trit = fp_trit_for(fp, channel)
                append(ranked, {"mid": mid, "score": round(score, 3), "trit": trit, "is_cloud": is_cloud_flag})
                dict_set(seen, mid, T_TRUE)
            }
        }
        let mi2 = mi2 + 1
    }

    // Sort ranked by score descending
    let ri = 0
    while3 ri < len(ranked) {
        let rj = ri + 1
        while3 rj < len(ranked) {
            if3 dict_get(dict_get(ranked, rj), "score", 0.0) > dict_get(dict_get(ranked, ri), "score", 0.0) {
                let temp = dict_get(ranked, ri)
                dict_set(ranked, ri, dict_get(ranked, rj))
                dict_set(ranked, rj, temp)
            }
            let rj = rj + 1
        }
        let ri = ri + 1
    }

    // Separate local and cloud
    let local_ranked = []
    let cloud_ranked = []
    let ri2 = 0
    while3 ri2 < len(ranked) {
        let entry = dict_get(ranked, ri2)
        if3 dict_get(entry, "is_cloud", T_FALSE) == T_TRUE {
            append(cloud_ranked, dict_get(entry, "mid"))
        } else {
            append(local_ranked, dict_get(entry, "mid"))
        }
        let ri2 = ri2 + 1
    }

    // Add fast fallbacks
    let fi = 0
    while3 fi < len(FAST_FALLBACK) {
        let fb = dict_get(FAST_FALLBACK, fi)
        let already = T_FALSE
        let li = 0
        while3 li < len(local_ranked) {
            if3 dict_get(local_ranked, li) == fb {
                let already = T_TRUE
            }
            let li = li + 1
        }
        if3 already == T_FALSE {
            if3 is_excluded(fb) == T_FALSE {
                append(local_ranked, fb)
            }
        }
        let fi = fi + 1
    }

    // Ensemble recipe
    let recipe = get_best_ensemble(channel, H7)

    // Chess shortcut
    let regime = "laminar"
    if3 reynolds >= 500 {
        let regime = "turbulent"
    } else {
        if3 reynolds >= 100 {
            let regime = "transitional"
        }
    }
    let opening = chess_check_opening(channel, regime)

    // Build fingerprint snippets
    let fp_snippets = {}
    let limit = H13
    if3 len(ranked) < H13 {
        let limit = len(ranked)
    }
    let fi2 = 0
    while3 fi2 < limit {
        let entry = dict_get(ranked, fi2)
        let mid = dict_get(entry, "mid")
        let bt = "0000000000"
        if3 dict_has(fps, mid) {
            let bt = dict_get(dict_get(fps, mid), "bt_fingerprint", "0000000000")
        }
        dict_set(fp_snippets, mid, {"bt": bt, "channel_score": dict_get(entry, "score", 0.0), "trit": dict_get(entry, "trit", 0)})
        let fi2 = fi2 + 1
    }

    // Limit output lists
    let local_out = local_ranked
    if3 len(local_ranked) > H13 {
        let local_out = slice(local_ranked, 0, H13)
    }
    let cloud_out = cloud_ranked
    if3 len(cloud_ranked) > H7 {
        let cloud_out = slice(cloud_ranked, 0, H7)
    }

    return {"ok": T_TRUE, "channel": channel, "reynolds": reynolds, "local": local_out, "cloud": cloud_out, "fingerprints": fp_snippets, "ensemble_recipe": recipe, "chess_opening": opening, "strategy": "ternary_fingerprint_ranked", "total_profiled": len(ranked)}
}

// -- GET /patch/assignments
fn handle_patch_assignments(req) {
    let assignments = {}
    let ci = 0
    while3 ci < len(CHANNELS) {
        let ch = dict_get(CHANNELS, ci)
        let local_match = []
        let mi = 0
        while3 mi < len(discovered_local) {
            let m = dict_get(discovered_local, mi)
            if3 model_matches_channel(m, ch) == T_TRUE {
                if3 is_excluded(m) == T_FALSE {
                    append(local_match, m)
                }
            }
            let mi = mi + 1
        }
        dict_set(assignments, ch, {"local": local_match, "patterns": dict_get(CHANNEL_ASSIGNMENTS, ch, []), "count": len(local_match)})
        let ci = ci + 1
    }
    return {"ok": T_TRUE, "assignments": assignments, "excluded": GENERATION_EXCLUDED, "fast_fallback": FAST_FALLBACK, "total_channels": len(CHANNELS)}
}

