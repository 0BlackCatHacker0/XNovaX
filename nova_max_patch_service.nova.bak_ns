// -- GET /patch/influence
fn handle_patch_influence(req) {
    let fps = fingerprints
    // Territory map
    let territory = {}
    let model_ids = keys(fps)
    let mi = 0
    while3 mi < len(model_ids) {
        let mid = dict_get(model_ids, mi)
        let fp = dict_get(fps, mid)
        if3 dict_get(fp, "probe_count", 0) > 0 {
            let terr = dict_get(fp, "territory", {})
            let terr_trits = []
            let ci = 0
            while3 ci < len(CHANNELS) {
                append(terr_trits, dict_get(terr, dict_get(CHANNELS, ci), 0))
                let ci = ci + 1
            }
            dict_set(territory, mid, {"bt": dict_get(fp, "bt_fingerprint", "0000000000"), "territory": terr, "territory_bt": bt_string(terr_trits)})
        }
        let mi = mi + 1
    }
    let influence = compute_influence(fps)
    {"territory": territory, "influence": influence}
}

// -- GET /patch/services
fn handle_patch_services(req) {
    let services_out = {}
    let sp_keys = keys(SERVICE_PORTS)
    let si = 0
    while3 si < len(sp_keys) {
        let name = dict_get(sp_keys, si)
        let port = dict_get(SERVICE_PORTS, name)
        let trit = dict_get(service_health, name, -1)
        dict_set(services_out, name, {"port": port, "trit": trit, "trit_char": trit_to_char(trit)})
        let si = si + 1
    }
    let alive = 0
    let healthy = 0
    let si2 = 0
    while3 si2 < len(sp_keys) {
        let t = dict_get(service_health, dict_get(sp_keys, si2), -1)
        if3 t >= 0 {
            let alive = alive + 1
        }
        if3 t == 1 {
            let healthy = healthy + 1
        }
        let si2 = si2 + 1
    }
    return {"health_bt": health_bt, "services": services_out, "total": len(SERVICE_PORTS), "alive": alive, "healthy": healthy}
}

