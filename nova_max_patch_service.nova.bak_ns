// -- GET /super/hidden
fn handle_super_hidden(req) {
    let result = {}
    let dk = keys(deep_fps)
    let di = 0
    while3 di < len(dk) {
        let mid = dict_get(dk, di)
        let dfp = dict_get(deep_fps, mid)
        let hidden = dict_get(dfp, "hidden_capabilities", [])
        if3 len(hidden) > 0 {
            dict_set(result, mid, {"ns_bt": dict_get(dfp, "ns_fingerprint", "00000"), "depth": dict_get(dfp, "overall_depth", 0.0), "hidden": hidden})
        }
        let di = di + 1
    }
    return {"hidden": result}
}

// -- GET /super/matrix (Combined MaxPatch + SuperPatch)
fn handle_super_matrix(req) {
    let fps = fingerprints
    let model_ids = keys(fps)
    let sorted_ids = []
    let mi = 0
    while3 mi < len(model_ids) {
        append(sorted_ids, dict_get(model_ids, mi))
        let mi = mi + 1
    }
    // Sort by score desc
    let si = 0
    while3 si < len(sorted_ids) {
        let sj = si + 1
        while3 sj < len(sorted_ids) {
            if3 fp_overall_score(dict_get(fps, dict_get(sorted_ids, sj))) > fp_overall_score(dict_get(fps, dict_get(sorted_ids, si))) {
                let temp = dict_get(sorted_ids, si)
                dict_set(sorted_ids, si, dict_get(sorted_ids, sj))
                dict_set(sorted_ids, sj, temp)
            }
            let sj = sj + 1
        }
        let si = si + 1
    }
    let rows = []
    let limit = 30
    if3 len(sorted_ids) < 30 {
        let limit = len(sorted_ids)
    }
    let ri = 0
    while3 ri < limit {
        let mid = dict_get(sorted_ids, ri)
        let fp = dict_get(fps, mid)
        let row = {"model": mid, "bt": dict_get(fp, "bt_fingerprint", "0000000000"), "overall": fp_overall_score(fp), "vcc_state": dict_get(fp, "vcc_state", "DETECTED")}
        if3 dict_has(deep_fps, mid) {
            let dfp = dict_get(deep_fps, mid)
            dict_set(row, "ns_bt", dict_get(dfp, "ns_fingerprint", "00000"))
            dict_set(row, "depth", dict_get(dfp, "overall_depth", 0.0))
            dict_set(row, "hidden", dict_get(dfp, "hidden_capabilities", []))
        } else {
            dict_set(row, "ns_bt", "")
            dict_set(row, "depth", 0.0)
            dict_set(row, "hidden", [])
        }
        append(rows, row)
        let ri = ri + 1
    }
    return {"channels": CHANNELS, "models": rows, "total": len(fps)}
}

// -- POST /patch/probe
fn handle_patch_probe(req) {
    let body = dict_get(req, "body", {})
    let model_id = dict_get(body, "model_id", "")
    if3 len(model_id) == 0 {
        return {"error": "model_id required"}
    } else {
        let channels = dict_get(body, "channels", [])
        let fp = probe_model(model_id, channels)
        dict_set(fingerprints, model_id, fp)
        dict_set(stats, "probes_completed", dict_get(stats, "probes_completed", 0) + 1)
        save_fingerprints()
        return fp_to_dict(fp)
    }
}

// -- POST /patch/probe-all
fn handle_patch_probe_all(req) {
    // Discover models then probe all unprobed
    discover_models()
    let model_ids = keys(fingerprints)
    let unprobed = []
    let mi = 0
    while3 mi < len(model_ids) {
        let mid = dict_get(model_ids, mi)
        let fp = dict_get(fingerprints, mid)
        if3 dict_get(fp, "probe_count", 0) == 0 {
            append(unprobed, mid)
        }
        let mi = mi + 1
    }
    if3 len(unprobed) == 0 {
        return {"started": T_FALSE, "reason": "all models already profiled", "models_queued": 0}
    } else {
        // Sequential probe (no threading in NovaLang)
        let core_channels = slice(CHANNELS, 0, H5)
        let probed = 0
        let ui = 0
        while3 ui < len(unprobed) {
            let mid = dict_get(unprobed, ui)
            try3 {
                let fp = probe_model(mid, core_channels)
                dict_set(fingerprints, mid, fp)
                dict_set(stats, "probes_completed", dict_get(stats, "probes_completed", 0) + 1)
                let probed = probed + 1
                print("[MaxPatch] Profiled " + mid + ": bt=" + dict_get(fp, "bt_fingerprint", ""))
            } else {
                print("[MaxPatch] Probe failed for " + mid)
            }
            let ui = ui + 1
        }
        generate_patches(fingerprints)
        optimize_ensembles(fingerprints)
        save_fingerprints()
        return {"started": T_TRUE, "models_queued": len(unprobed), "probed": probed, "fast_mode": T_TRUE}
    }
}

// -- POST /patch/optimize
fn handle_patch_optimize(req) {
    optimize_ensembles(fingerprints)
    let patches = generate_patches(fingerprints)
    let total_patches = 0
    let ap_keys = keys(active_patches)
    let ai = 0
    while3 ai < len(ap_keys) {
        let total_patches = total_patches + len(keys(dict_get(active_patches, dict_get(ap_keys, ai), {})))
        let ai = ai + 1
    }
    return {"optimized": T_TRUE, "ensembles": {"channels_with_recipes": len(ensemble_recipes)}, "patches": {"models_patched": len(active_patches), "total_patches": total_patches}}
}

// -- POST /patch/route
fn handle_patch_route(req) {
    let body = dict_get(req, "body", {})
    let prompt = dict_get(body, "prompt", "")
    let channel = dict_get(body, "channel", "REASON")
    let reynolds = float(dict_get(body, "reynolds", "0"))
    if3 len(prompt) == 0 {
        return {"error": "prompt required"}
    } else {
        chess_record_query(channel)
        let regime = "laminar"
        if3 reynolds >= 500 {
            let regime = "turbulent"
        } else {
            if3 reynolds >= 100 {
                let regime = "transitional"
            }
        }
        // Chess opening check
        let opening = chess_check_opening(channel, regime)
        if3 len(opening) > 0 {
            if3 reynolds < 500 {
                let result = query_hivemind(prompt, channel)
                dict_set(result, "strategy", "chess_opening_book")
                dict_set(result, "opening_models", opening)
                let final_result = result
            } else {
                let final_result = {}
        } else {
            let final_result = {}
        }
        if3 len(keys(final_result)) == 0 {
            // Endgame check
            let endgame_model = chess_check_endgame(channel, reynolds)
            if3 len(endgame_model) > 0 {
                let result = query_hivemind(prompt, channel)
                dict_set(result, "strategy", "chess_endgame")
                dict_set(result, "endgame_model", endgame_model)
                let final_result = result
            } else {
                // Standard routing: find best model by channel score
                let fps = fingerprints
                let best_id = ""
                let best_score = 0.0
                let model_ids = keys(fps)
                let mi = 0
                while3 mi < len(model_ids) {
                    let mid = dict_get(model_ids, mi)
                    let fp = dict_get(fps, mid)
                    let score = dict_get(dict_get(fp, "channel_scores", {}), channel, 0.0)
                    if3 score > best_score {
                        let best_id = mid
                        let best_score = score
                    }
                    let mi = mi + 1
                }
                let result = query_hivemind(prompt, channel)
                if3 len(best_id) > 0 {
                    dict_set(result, "patch_info", {"best_model": best_id, "channel_score": best_score, "trit": score_to_trit(best_score), "patched": best_score > 0.667})
                }
                let final_result = result
            }
        }
        return final_result
    }
}

