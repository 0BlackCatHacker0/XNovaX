append(long_probes, {"prompt": "Write a 200-word flash fiction piece that uses an unreliable narrator to reveal a twist ending.", "signals": [], "tier": "hard"})
dict_set(PROBE_PROMPTS, "LONG", long_probes)

// VISION probes
