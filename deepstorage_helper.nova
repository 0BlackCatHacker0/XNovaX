// deepstorage_helper.nova - DeepStorage Helper v3.2
// Replaces deepstorage_helper.py
// Called via nova_run(HELPER, json_args) from NovaLang
// Operations: quantize, quantize_dir, restore, scan, block_hash

let STORE_DIR = "C:/NovaX/data/deepstorage"
let MAX_FILE_BYTES = 536870912  // 512MB

let SKIP_EXTS = [".exe", ".dll", ".sys", ".drv", ".msi", ".bat", ".cmd", ".zip", ".gz", ".bz2", ".xz", ".7z", ".rar", ".tar", ".jpg", ".jpeg", ".png", ".gif", ".mp4", ".mp3", ".wav", ".pyc", ".pyd", ".so", ".deep", ".tzip"]

fn3 has_skip_ext(path) {
    let lpath = lower(path)
    for3 ext in SKIP_EXTS {
        if3 ends_with(lpath, ext) { return3 true }
    }
    return3 false
}

fn3 store_path(original_path) {
    let safe = replace(original_path, "\\", "_")
    safe = replace(safe, "/", "_")
    safe = replace(safe, ":", "_")
    return3 STORE_DIR + "/" + safe + ".tzip"
}

fn3 op_quantize(path) {
    if3 file_exists(path) == false {
        return3 {"ok": false, "error": "File not found: " + path}
    }
    if3 has_skip_ext(path) {
        return3 {"ok": false, "error": "Skipped extension"}
    }

    // Use shell to call the tzip compression via Python (core/tzip dependency)
    let args = to_json({"op": "quantize", "path": path})
    let cmd = "python C:/NovaX/deepstorage_helper.py '" + args + "'"
    try3 {
        let result_str = shell(cmd)
        return3 parse_json(result_str)
    } catch3 {
        return3 {"ok": false, "error": "quantize failed for " + path}
    }
}

fn3 op_quantize_dir(path, max_files) {
    let args = {}
    args = dict_set(args, "op", "quantize_dir")
    args = dict_set(args, "path", path)
    args = dict_set(args, "max_files", max_files)
    let cmd = "python C:/NovaX/deepstorage_helper.py '" + to_json(args) + "'"
    try3 {
        let result_str = shell(cmd)
        return3 parse_json(result_str)
    } catch3 {
        return3 {"ok": false, "error": "quantize_dir failed for " + path}
    }
}

fn3 op_restore(path, output) {
    let args = {}
    args = dict_set(args, "op", "restore")
    args = dict_set(args, "path", path)
    if3 output != null {
        args = dict_set(args, "output", output)
    }
    let cmd = "python C:/NovaX/deepstorage_helper.py '" + to_json(args) + "'"
    try3 {
        let result_str = shell(cmd)
        return3 parse_json(result_str)
    } catch3 {
        return3 {"ok": false, "error": "restore failed for " + path}
    }
}

fn3 op_scan(path) {
    let args = {}
    args = dict_set(args, "op", "scan")
    args = dict_set(args, "path", path)
    let cmd = "python C:/NovaX/deepstorage_helper.py '" + to_json(args) + "'"
    try3 {
        let result_str = shell(cmd)
        return3 parse_json(result_str)
    } catch3 {
        return3 {"ok": false, "error": "scan failed for " + path}
    }
}

fn3 op_block_hash(path) {
    if3 file_exists(path) == false {
        return3 {"ok": false, "error": "File not found: " + path}
    }
    let args = {}
    args = dict_set(args, "op", "block_hash")
    args = dict_set(args, "path", path)
    let cmd = "python C:/NovaX/deepstorage_helper.py '" + to_json(args) + "'"
    try3 {
        let result_str = shell(cmd)
        return3 parse_json(result_str)
    } catch3 {
        return3 {"ok": false, "error": "block_hash failed for " + path}
    }
}

fn3 main() {
    let args = sys_args()
    if3 len(args) < 1 {
        print(to_json({"ok": false, "error": "No args provided"}))
        return3 null
    }

    let payload = {}
    try3 {
        payload = parse_json(args[0])
    } catch3 {
        print(to_json({"ok": false, "error": "JSON parse error"}))
        return3 null
    }

    let op = dict_get(payload, "op") ?? ""
    let result = {"ok": false, "error": "Unknown op: " + op}

    if3 op == "quantize" {
        result = op_quantize(dict_get(payload, "path") ?? "")
    } else3 {
        if3 op == "quantize_dir" {
            result = op_quantize_dir(dict_get(payload, "path") ?? "", dict_get(payload, "max_files") ?? 50)
        } else3 {
            if3 op == "restore" {
                result = op_restore(dict_get(payload, "path") ?? "", dict_get(payload, "output") ?? null)
            } else3 {
                if3 op == "scan" {
                    result = op_scan(dict_get(payload, "path") ?? "")
                } else3 {
                    if3 op == "block_hash" {
                        result = op_block_hash(dict_get(payload, "path") ?? "")
                    }
                }
            }
        }
    }

    print(to_json(result))
}

main()
