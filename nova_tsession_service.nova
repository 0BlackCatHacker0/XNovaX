// NovaX TSession Service v1.0 - Ternary Terminal Session Multiplexer (NovaLang)
// Port 9912: Named terminal sessions, command execution, piping, env management
//
// 7 ternary-native session tools on 3-5-7-13 harmonic constants:
//   1. /tsession/create  -- Create a new named terminal session
//   2. /tsession/exec    -- Execute command in a session
//   3. /tsession/list    -- List all active sessions with state
//   4. /tsession/kill    -- Kill a session by ID
//   5. /tsession/history -- Get command history for a session
//   6. /tsession/pipe    -- Pipe commands in sequence within a session
//   7. /tsession/env     -- Get/set environment variables for a session
//
// N-S Mapping:
//   session_stream   = velocity_field (commands flowing through sessions)
//   cmd_count        = accumulated_flux (total commands run)
//   fail_count       = turbulent_energy (error pressure in a session)
//   Reynolds(session)= fail_count * H5 (session turbulence proxy)
//   RE_LAMINAR=27    = healthy session (few failures)
//   RE_TRANSITION=125= session under moderate pressure
//   RE_TURBULENT=343 = session in trouble (many failures)
//
// Endpoints:
//   GET  /health            -- Health check
//   GET  /tsession/status   -- Service status with session count, total cmds, uptime
//   POST /tsession/create   -- Create a new named session
//   POST /tsession/exec     -- Execute command in a session
//   POST /tsession/list     -- List all active sessions
//   POST /tsession/kill     -- Kill a session by ID
//   POST /tsession/history  -- Get command history for a session
//   POST /tsession/pipe     -- Pipe commands in sequence within a session
//   POST /tsession/env      -- Get/set env vars for a session

// -- Shared Libraries (N-S Flow) --
import3("C:/NovaX/lib/nova_ns_core.nova")
import3("C:/NovaX/lib/nova_stdlib.nova")

let PORT = 9912
let server = tserve(PORT, "TSession v1.0 - Ternary Terminal Session Multiplexer")

// -- 3-5-7-13 Harmonic Constants --
let H3  = 3
let H5  = 5
let H7  = 7
let H13 = 13

// -- Ternary State Constants --
let T_TRUE  =  1
let T_MAYBE =  0
let T_FALSE = -1

// -- Reynolds flow boundaries (N-S) --
let BLOCK_SIZE     = 2187
let RE_LAMINAR     = 27
let RE_TRANSITION  = 125
let RE_TURBULENT   = 343

let TOOLS_COUNT    = 7
let VERSION        = "1.0.0"
let SERVICE_NAME   = "nova-tsession"
let CMD_TIMEOUT    = 13
let MAX_SESSIONS   = 343
let HISTORY_MAX    = 91

// -- Global Stats --
let stat_ops         = 0
let stat_cmds_run    = 0
let stat_trit_true   = 0
let stat_trit_maybe  = 0
let stat_trit_false  = 0
let stat_t0          = time()

// by_tool counters (one per tool)
let by_tool_create   = 0
let by_tool_exec     = 0
let by_tool_list     = 0
let by_tool_kill     = 0
let by_tool_history  = 0
let by_tool_pipe     = 0
let by_tool_env      = 0

// -- Sessions State --
// _sessions: list of session dicts
// Each session: {id, name, shell, cwd, active, created_at,
//                cmd_count, fail_count, last_cmd, last_output,
//                last_trit, history, env_vars}
let _sessions  = []
let _session_seq = 0

// ===========================================================================
// HELPER: trit character for display
// ===========================================================================
fn trit_char(t) {
    if3 t == 1 {
        "+"
    } else t == 0 {
        "~"
    } else {
        "-"
    }
}

// ===========================================================================
// HELPER: balanced ternary string from single trit
// ===========================================================================
fn bt_one(t) {
    if3 t == T_TRUE {
        return "1"
    }
    if3 t == T_MAYBE {
        return "0"
    }
    return "T"
}

// ===========================================================================
// HELPER: record a stat op
// ===========================================================================
fn record_stat(tool_name, trit) {
    stat_ops = stat_ops + 1
    if3 trit == T_TRUE {
        stat_trit_true = stat_trit_true + 1
    }
    if3 trit == T_MAYBE {
        stat_trit_maybe = stat_trit_maybe + 1
    }
    if3 trit == T_FALSE {
        stat_trit_false = stat_trit_false + 1
    }
    if3 tool_name == "create" {
        by_tool_create = by_tool_create + 1
    }
    if3 tool_name == "exec" {
        by_tool_exec = by_tool_exec + 1
    }
    if3 tool_name == "list" {
        by_tool_list = by_tool_list + 1
    }
    if3 tool_name == "kill" {
        by_tool_kill = by_tool_kill + 1
    }
    if3 tool_name == "history" {
        by_tool_history = by_tool_history + 1
    }
    if3 tool_name == "pipe" {
        by_tool_pipe = by_tool_pipe + 1
    }
    if3 tool_name == "env" {
        by_tool_env = by_tool_env + 1
    }
}

// ===========================================================================
// HELPER: flow regime from Reynolds number
// ===========================================================================
fn flow_regime(re_num) {
    if3 re_num < RE_LAMINAR {
        return "laminar"
    }
    if3 re_num < RE_TRANSITION {
        return "transitional"
    }
    if3 re_num < RE_TURBULENT {
        return "turbulent"
    }
    return "chaotic"
}

// ===========================================================================
// HELPER: check dangerous command (returns "" if safe, or error string)
// ===========================================================================
fn check_dangerous(command) {
    let cmd_lc = lower(command)
    if3 contains(cmd_lc, "rm -rf /") {
        return "Blocked dangerous command pattern: rm -rf /"
    }
    if3 contains(cmd_lc, "rm -rf ~") {
        return "Blocked dangerous command pattern: rm -rf ~"
    }
    if3 contains(cmd_lc, "del /s /q c:\\") {
        return "Blocked dangerous command pattern: del /s /q c:\\"
    }
    if3 contains(cmd_lc, "format c:") {
        return "Blocked dangerous command pattern: format c:"
    }
    if3 contains(cmd_lc, "mkfs") {
        return "Blocked dangerous command pattern: mkfs"
    }
    if3 contains(cmd_lc, "dd if=/dev/zero") {
        return "Blocked dangerous command pattern: dd if=/dev/zero"
    }
    if3 contains(cmd_lc, "shutdown") {
        return "Blocked dangerous command pattern: shutdown"
    }
    if3 contains(cmd_lc, "reboot") {
        return "Blocked dangerous command pattern: reboot"
    }
    if3 contains(cmd_lc, "taskkill /f /im explorer") {
        return "Blocked dangerous command pattern: taskkill /f /im explorer"
    }
    if3 contains(cmd_lc, "net user") {
        return "Blocked dangerous command pattern: net user"
    }
    if3 contains(cmd_lc, "reg delete") {
        return "Blocked dangerous command pattern: reg delete"
    }
    return ""
}

// ===========================================================================
// HELPER: find session by ID, returns the session dict or empty dict
// ===========================================================================
fn find_session(session_id) {
    let i = 0
    while3 i < len(_sessions) {
        let sess = dict_get(_sessions, i)
        let sid = dict_get(sess, "id") ?? -1
        if3 sid == session_id {
            return sess
        }
        i = i + 1
    }
    return {}
}

// ===========================================================================
// HELPER: find session index by ID, returns index or -1
// ===========================================================================
fn find_session_idx(session_id) {
    let idx = 0
    while3 idx < len(_sessions) {
        let sess = dict_get(_sessions, idx)
        let sid = dict_get(sess, "id") ?? -1
        if3 sid == session_id {
            return idx
        }
        idx = idx + 1
    }
    return -1
}

// ===========================================================================
// HELPER: session Reynolds number (fail_count * H5)
// ===========================================================================
fn session_reynolds(sess) {
    let fc = dict_get(sess, "fail_count") ?? 0
    let re = fc * H5
    re
}

// ===========================================================================
// HELPER: add entry to session history (ring buffer, max HISTORY_MAX)
// ===========================================================================
fn add_history(sess, entry) {
    let hist = dict_get(sess, "history") ?? []
    hist = append(hist, entry)
    // Trim if over limit
    if3 len(hist) > HISTORY_MAX {
        hist = slice(hist, 1)
    }
    hist
}

// ===========================================================================
// HELPER: build env string for a session's env_vars dict
// Returns a prefix string like "set KEY1=VAL1 & set KEY2=VAL2 & "
// If no env vars, returns ""
// ===========================================================================
fn build_env_prefix(env_vars) {
    let ks = keys(env_vars)
    if3 len(ks) == 0 {
        return ""
    }
    let prefix = ""
    let i = 0
    while3 i < len(ks) {
        let k = dict_get(ks, i)
        let v = dict_get(env_vars, k) ?? ""
        prefix = prefix + "set " + str(k) + "=" + str(v) + " & "
        i = i + 1
    }
    prefix
}

// ===========================================================================
// TOOL 1: POST /tsession/create
// Create a new named terminal session
// Body: {name, shell, cwd}
// ===========================================================================
fn handle_create(body) {
    let name = dict_get(body, "name") ?? ""
    let shell = dict_get(body, "shell") ?? "cmd"
    let cwd = dict_get(body, "cwd") ?? "C:\\NovaX"

    if3 len(name) == 0 { name = "session-" + str(_session_seq + 1)
    }

    // Check max sessions
    if3 len(_sessions) >= MAX_SESSIONS {
        record_stat("create", T_FALSE)
        return {
            "ok": false,
            "error": "Max sessions reached (" + str(MAX_SESSIONS) + ")",
            "trit": T_FALSE,
            "char": bt_one(T_FALSE)
        }
    }

    // Check for duplicate name
    let dup_found = 0
    let di = 0
    while3 di < len(_sessions) {
        let sess = dict_get(_sessions, di)
        let sname = dict_get(sess, "name") ?? ""
        let sactive = dict_get(sess, "active") ?? false
        if3 sname == name {
            if3 sactive == true {
                dup_found = 1
            }
        }
        di = di + 1
    }

    if3 dup_found == 1 {
        record_stat("create", T_FALSE)
        return {
            "ok": false,
            "error": "Session name already exists: " + name,
            "trit": T_FALSE,
            "char": bt_one(T_FALSE)
        }
    }

    _session_seq = _session_seq + 1
    let sid = _session_seq

    let new_sess = {}
    new_sess = dict_set(new_sess, "id", sid)
    new_sess = dict_set(new_sess, "name", name)
    new_sess = dict_set(new_sess, "shell", shell)
    new_sess = dict_set(new_sess, "cwd", cwd)
    new_sess = dict_set(new_sess, "active", true)
    new_sess = dict_set(new_sess, "created_at", time())
    new_sess = dict_set(new_sess, "cmd_count", 0)
    new_sess = dict_set(new_sess, "fail_count", 0)
    new_sess = dict_set(new_sess, "last_cmd", "")
    new_sess = dict_set(new_sess, "last_output", "")
    new_sess = dict_set(new_sess, "last_trit", T_MAYBE)
    new_sess = dict_set(new_sess, "history", [])
    new_sess = dict_set(new_sess, "env_vars", {})

    _sessions = append(_sessions, new_sess)

    record_stat("create", T_TRUE)
    return {
        "ok": true,
        "session_id": sid,
        "name": name,
        "shell": shell,
        "cwd": cwd,
        "trit": T_TRUE,
        "char": bt_one(T_TRUE),
        "runtime": "novalang"
    }
}

// ===========================================================================
// TOOL 2: POST /tsession/exec
// Execute command in a session
// Body: {session_id, command, timeout}
// ===========================================================================
fn handle_exec(body) {
    let session_id = dict_get(body, "session_id") ?? 0
    let command = dict_get(body, "command") ?? ""
    let timeout = dict_get(body, "timeout") ?? CMD_TIMEOUT

    if3 session_id == 0 {
        record_stat("exec", T_FALSE)
        return {
            "ok": false,
            "error": "session_id required",
            "trit": T_FALSE,
            "char": bt_one(T_FALSE)
        }
    }

    if3 len(command) == 0 {
        record_stat("exec", T_FALSE)
        return {
            "ok": false,
            "error": "command required",
            "trit": T_FALSE,
            "char": bt_one(T_FALSE)
        }
    }

    // Safety check
    let danger = check_dangerous(command)
    if3 len(danger) > 0 {
        record_stat("exec", T_FALSE)
        return {
            "ok": false,
            "error": danger,
            "trit": T_FALSE,
            "char": bt_one(T_FALSE)
        }
    }

    // Find session
    let idx = find_session_idx(session_id)
    if3 idx == -1 {
        record_stat("exec", T_FALSE)
        return {
            "ok": false,
            "error": "Session not found: " + str(session_id),
            "trit": T_FALSE,
            "char": bt_one(T_FALSE)
        }
    }

    let sess = dict_get(_sessions, idx)
    let is_active = dict_get(sess, "active") ?? false
    if3 is_active == false {
        record_stat("exec", T_FALSE)
        return {
            "ok": false,
            "error": "Session is not active: " + str(session_id),
            "trit": T_FALSE,
            "char": bt_one(T_FALSE)
        }
    }

    // Build command with cwd and env
    let sess_cwd = dict_get(sess, "cwd") ?? "C:\\NovaX"
    let sess_env = dict_get(sess, "env_vars") ?? {}
    let env_prefix = build_env_prefix(sess_env)

    // Construct full command: cd to cwd, set env, then run
    let full_cmd = "cd /d " + sess_cwd + " & " + env_prefix + command + " 2>&1"

    // Clamp timeout
    if3 timeout < 1 {
        timeout = 1
    }
    if3 timeout > 60 {
        timeout = 60
    }

    // Execute
    let t_start = time()
    let raw_output = nova_run(full_cmd, timeout)
    let t_end = time()
    let elapsed_ms = (t_end - t_start) * 1000

    let output = strip(str(raw_output))

    // Determine trit from output
    let exec_trit = T_TRUE
    let output_lc = lower(output)
    if3 contains(output_lc, "error") {
        exec_trit = T_FALSE
    }
    if3 contains(output_lc, "not recognized") {
        exec_trit = T_FALSE
    }
    if3 contains(output_lc, "not found") {
        exec_trit = T_FALSE
    }
    if3 contains(output_lc, "access denied") {
        exec_trit = T_FALSE
    }
    if3 contains(output_lc, "fatal") {
        exec_trit = T_FALSE
    }
    if3 len(output) == 0 {
        exec_trit = T_MAYBE
    }

    // Update session state in-place via dict_set
    let cmd_count = (dict_get(sess, "cmd_count") ?? 0) + 1
    let fail_count = dict_get(sess, "fail_count") ?? 0
    if3 exec_trit == T_FALSE {
        fail_count = fail_count + 1
    }

    // Build history entry
    let hist_entry = {}
    hist_entry = dict_set(hist_entry, "cmd", command)
    hist_entry = dict_set(hist_entry, "output_len", len(output))
    hist_entry = dict_set(hist_entry, "trit", exec_trit)
    hist_entry = dict_set(hist_entry, "char", bt_one(exec_trit))
    hist_entry = dict_set(hist_entry, "elapsed_ms", elapsed_ms)
    hist_entry = dict_set(hist_entry, "timestamp", time())

    let new_hist = add_history(sess, hist_entry)

    // Update session fields in-place
    sess = dict_set(sess, "cmd_count", cmd_count)
    sess = dict_set(sess, "fail_count", fail_count)
    sess = dict_set(sess, "last_cmd", command)
    sess = dict_set(sess, "last_output", output)
    sess = dict_set(sess, "last_trit", exec_trit)
    sess = dict_set(sess, "history", new_hist)

    stat_cmds_run = stat_cmds_run + 1

    // Session Reynolds
    let re = fail_count * H5
    let regime = flow_regime(re)

    record_stat("exec", exec_trit)
    return {
        "ok": true,
        "session_id": session_id,
        "command": command,
        "output": output,
        "elapsed_ms": elapsed_ms,
        "cmd_count": cmd_count,
        "reynolds": re,
        "regime": regime,
        "trit": exec_trit,
        "char": bt_one(exec_trit),
        "runtime": "novalang"
    }
}

// ===========================================================================
// TOOL 3: POST /tsession/list
// List all active sessions with their state
// ===========================================================================
fn handle_list(body) {
    let session_list = []
    let active_count = 0
    let dead_count = 0
    let total_cmds = 0

    let li = 0
    while3 li < len(_sessions) {
        let sess = dict_get(_sessions, li)
        let is_active = dict_get(sess, "active") ?? false
        let sid = dict_get(sess, "id") ?? 0
        let sname = dict_get(sess, "name") ?? ""
        let sshell = dict_get(sess, "shell") ?? "cmd"
        let scwd = dict_get(sess, "cwd") ?? ""
        let s_cmd_count = dict_get(sess, "cmd_count") ?? 0
        let s_fail_count = dict_get(sess, "fail_count") ?? 0
        let s_last_cmd = dict_get(sess, "last_cmd") ?? ""
        let s_last_trit = dict_get(sess, "last_trit") ?? T_MAYBE
        let s_created = dict_get(sess, "created_at") ?? 0

        total_cmds = total_cmds + s_cmd_count

        let re = s_fail_count * H5
        let regime = flow_regime(re)

        let sess_trit = T_TRUE
        if3 is_active == false {
            sess_trit = T_FALSE
            dead_count = dead_count + 1
        }
        if3 is_active == true {
            active_count = active_count + 1
            if3 s_fail_count > H3 {
                sess_trit = T_MAYBE
            }
            if3 re >= RE_LAMINAR {
                sess_trit = T_FALSE
            }
        }

        let sess_info = {}
        sess_info = dict_set(sess_info, "id", sid)
        sess_info = dict_set(sess_info, "name", sname)
        sess_info = dict_set(sess_info, "shell", sshell)
        sess_info = dict_set(sess_info, "cwd", scwd)
        sess_info = dict_set(sess_info, "active", is_active)
        sess_info = dict_set(sess_info, "cmd_count", s_cmd_count)
        sess_info = dict_set(sess_info, "fail_count", s_fail_count)
        sess_info = dict_set(sess_info, "last_cmd", s_last_cmd)
        sess_info = dict_set(sess_info, "reynolds", re)
        sess_info = dict_set(sess_info, "regime", regime)
        sess_info = dict_set(sess_info, "created_at", s_created)
        sess_info = dict_set(sess_info, "trit", sess_trit)
        sess_info = dict_set(sess_info, "char", bt_one(sess_trit))

        session_list = append(session_list, sess_info)
        li = li + 1
    }

    // Overall trit
    let overall_trit = T_TRUE
    if3 dead_count > 0 {
        overall_trit = T_MAYBE
    }
    if3 active_count == 0 {
        if3 len(_sessions) > 0 {
            overall_trit = T_FALSE
        }
    }

    record_stat("list", overall_trit)
    return {
        "ok": true,
        "sessions": session_list,
        "active_count": active_count,
        "dead_count": dead_count,
        "total_sessions": len(_sessions),
        "total_cmds": total_cmds,
        "trit": overall_trit,
        "char": bt_one(overall_trit),
        "runtime": "novalang"
    }
}

// ===========================================================================
// TOOL 4: POST /tsession/kill
// Kill a session by ID
// Body: {session_id}
// ===========================================================================
fn handle_kill(body) {
    let session_id = dict_get(body, "session_id") ?? 0

    if3 session_id == 0 {
        record_stat("kill", T_FALSE)
        return {
            "ok": false,
            "error": "session_id required",
            "trit": T_FALSE,
            "char": bt_one(T_FALSE)
        }
    }

    let idx = find_session_idx(session_id)
    if3 idx == -1 {
        record_stat("kill", T_FALSE)
        return {
            "ok": false,
            "error": "Session not found: " + str(session_id),
            "trit": T_FALSE,
            "char": bt_one(T_FALSE)
        }
    }

    let sess = dict_get(_sessions, idx)
    let is_active = dict_get(sess, "active") ?? false

    if3 is_active == false {
        record_stat("kill", T_MAYBE)
        return {
            "ok": true,
            "message": "Session already dead: " + str(session_id),
            "session_id": session_id,
            "trit": T_MAYBE,
            "char": bt_one(T_MAYBE)
        }
    }

    // Mark session as inactive in-place
    sess = dict_set(sess, "active", false)

    record_stat("kill", T_TRUE)
    return {
        "ok": true,
        "session_id": session_id,
        "name": dict_get(sess, "name") ?? "",
        "message": "Session killed",
        "trit": T_TRUE,
        "char": bt_one(T_TRUE),
        "runtime": "novalang"
    }
}

// ===========================================================================
// TOOL 5: POST /tsession/history
// Get command history for a session
// Body: {session_id, last_n}
// ===========================================================================
fn handle_history(body) {
    let session_id = dict_get(body, "session_id") ?? 0
    let last_n = dict_get(body, "last_n") ?? HISTORY_MAX

    if3 session_id == 0 {
        record_stat("history", T_FALSE)
        return {
            "ok": false,
            "error": "session_id required",
            "trit": T_FALSE,
            "char": bt_one(T_FALSE)
        }
    }

    let idx = find_session_idx(session_id)
    if3 idx == -1 {
        record_stat("history", T_FALSE)
        return {
            "ok": false,
            "error": "Session not found: " + str(session_id),
            "trit": T_FALSE,
            "char": bt_one(T_FALSE)
        }
    }

    let sess = dict_get(_sessions, idx)
    let hist = dict_get(sess, "history") ?? []
    let total = len(hist)

    // Clamp last_n
    if3 last_n < 1 { last_n = 1
    }
    if3 last_n > total { last_n = total
    }

    // Get last N entries
    let entries = []
    if3 last_n > 0 { start_idx = total - last_n
        if3 start_idx < 0 {
            start_idx = 0
        }
        let hi = start_idx
        while3 hi < total {
            let entry = dict_get(hist, hi)
            entries = append(entries, entry)
            hi = hi + 1
        }
    }

    // Compute success ratio trit
    let hist_trit = T_TRUE
    let fail_entries = 0
    let ei = 0
    while3 ei < len(entries) {
        let e = dict_get(entries, ei)
        let et = dict_get(e, "trit") ?? T_MAYBE
        if3 et == T_FALSE {
            fail_entries = fail_entries + 1
        }
        ei = ei + 1
    }
    if3 fail_entries > 0 {
        hist_trit = T_MAYBE
    }
    let fail_thresh = last_n / H3
    if3 fail_entries > fail_thresh {
        hist_trit = T_FALSE
    }

    record_stat("history", hist_trit)
    return {
        "ok": true,
        "session_id": session_id,
        "name": dict_get(sess, "name") ?? "",
        "total_history": total,
        "returned": len(entries),
        "entries": entries,
        "trit": hist_trit,
        "char": bt_one(hist_trit),
        "runtime": "novalang"
    }
}

// ===========================================================================
// TOOL 6: POST /tsession/pipe
// Pipe output from one command to next in sequence within a session
// Body: {session_id, commands: ["cmd1", "cmd2", ...]}
// Each command is joined with native shell pipe |
// ===========================================================================
fn handle_pipe(body) {
    let session_id = dict_get(body, "session_id") ?? 0
    let commands = dict_get(body, "commands") ?? []

    if3 session_id == 0 {
        record_stat("pipe", T_FALSE)
        return {
            "ok": false,
            "error": "session_id required",
            "trit": T_FALSE,
            "char": bt_one(T_FALSE)
        }
    }

    if3 len(commands) == 0 {
        record_stat("pipe", T_FALSE)
        return {
            "ok": false,
            "error": "commands list required (at least 1 command)",
            "trit": T_FALSE,
            "char": bt_one(T_FALSE)
        }
    }

    let idx = find_session_idx(session_id)
    if3 idx == -1 {
        record_stat("pipe", T_FALSE)
        return {
            "ok": false,
            "error": "Session not found: " + str(session_id),
            "trit": T_FALSE,
            "char": bt_one(T_FALSE)
        }
    }

    let sess = dict_get(_sessions, idx)
    let is_active = dict_get(sess, "active") ?? false
    if3 is_active == false {
        record_stat("pipe", T_FALSE)
        return {
            "ok": false,
            "error": "Session is not active: " + str(session_id),
            "trit": T_FALSE,
            "char": bt_one(T_FALSE)
        }
    }

    let sess_cwd = dict_get(sess, "cwd") ?? "C:\\NovaX"
    let sess_env = dict_get(sess, "env_vars") ?? {}
    let env_prefix = build_env_prefix(sess_env)

    // Build a single piped command string using native shell pipe
    // Safety check each command and join with " | "
    let pipe_str = ""
    let cmd_idx = 0
    while3 cmd_idx < len(commands) {
        let cmd = dict_get(commands, cmd_idx)
        // Safety check each command
        let danger = check_dangerous(cmd)
        if3 len(danger) > 0 {
            record_stat("pipe", T_FALSE)
            return {
                "ok": false,
                "error": danger + " (in command #" + str(cmd_idx + 1) + ")",
                "trit": T_FALSE,
                "char": bt_one(T_FALSE)
            }
        }
        if3 cmd_idx > 0 {
            pipe_str = pipe_str + " | "
        }
        pipe_str = pipe_str + cmd
        cmd_idx = cmd_idx + 1
    }

    let full_cmd = "cd /d " + sess_cwd + " & " + env_prefix + pipe_str + " 2>&1"

    let t_start = time()
    let raw_output = nova_run(full_cmd, CMD_TIMEOUT)
    let t_end = time()
    let elapsed_ms = (t_end - t_start) * 1000

    let output = strip(str(raw_output))

    // Trit from output
    let pipe_trit = T_TRUE
    let output_lc = lower(output)
    if3 contains(output_lc, "error") {
        pipe_trit = T_FALSE
    }
    if3 contains(output_lc, "not recognized") {
        pipe_trit = T_FALSE
    }
    if3 contains(output_lc, "not found") {
        pipe_trit = T_FALSE
    }
    if3 len(output) == 0 {
        pipe_trit = T_MAYBE
    }

    // Update session in-place
    let cmd_count = (dict_get(sess, "cmd_count") ?? 0) + len(commands)
    let fail_count = dict_get(sess, "fail_count") ?? 0
    if3 pipe_trit == T_FALSE {
        fail_count = fail_count + 1
    }

    let hist_entry = {}
    hist_entry = dict_set(hist_entry, "cmd", "pipe: " + pipe_str)
    hist_entry = dict_set(hist_entry, "output_len", len(output))
    hist_entry = dict_set(hist_entry, "trit", pipe_trit)
    hist_entry = dict_set(hist_entry, "char", bt_one(pipe_trit))
    hist_entry = dict_set(hist_entry, "elapsed_ms", elapsed_ms)
    hist_entry = dict_set(hist_entry, "timestamp", time())
    hist_entry = dict_set(hist_entry, "pipe_count", len(commands))

    let new_hist = add_history(sess, hist_entry)

    sess = dict_set(sess, "cmd_count", cmd_count)
    sess = dict_set(sess, "fail_count", fail_count)
    sess = dict_set(sess, "last_cmd", "pipe: " + pipe_str)
    sess = dict_set(sess, "last_output", output)
    sess = dict_set(sess, "last_trit", pipe_trit)
    sess = dict_set(sess, "history", new_hist)

    stat_cmds_run = stat_cmds_run + len(commands)

    record_stat("pipe", pipe_trit)
    return {
        "ok": true,
        "session_id": session_id,
        "commands": commands,
        "pipe_count": len(commands),
        "output": output,
        "elapsed_ms": elapsed_ms,
        "trit": pipe_trit,
        "char": bt_one(pipe_trit),
        "runtime": "novalang"
    }
}

// ===========================================================================
// TOOL 7: POST /tsession/env
// Get/set environment variables for a session
// Body: {session_id, action: "get"|"set", key, value}
// ===========================================================================
fn handle_env(body) {
    let session_id = dict_get(body, "session_id") ?? 0
    let action = dict_get(body, "action") ?? "get"
    let key = dict_get(body, "key") ?? ""
    let value = dict_get(body, "value") ?? ""

    if3 session_id == 0 {
        record_stat("env", T_FALSE)
        return {
            "ok": false,
            "error": "session_id required",
            "trit": T_FALSE,
            "char": bt_one(T_FALSE)
        }
    }

    let idx = find_session_idx(session_id)
    if3 idx == -1 {
        record_stat("env", T_FALSE)
        return {
            "ok": false,
            "error": "Session not found: " + str(session_id),
            "trit": T_FALSE,
            "char": bt_one(T_FALSE)
        }
    }

    let sess = dict_get(_sessions, idx)
    let env_vars = dict_get(sess, "env_vars") ?? {}

    if3 action == "get" {
        // If key specified, return that key; otherwise return all
        if3 len(key) > 0 { val = dict_get(env_vars, key) ?? ""
            let env_trit = T_TRUE
            if3 len(val) == 0 { env_trit = T_MAYBE
            }
            record_stat("env", env_trit)
            return {
                "ok": true,
                "session_id": session_id,
                "action": "get",
                "key": key,
                "value": val,
                "trit": env_trit,
                "char": bt_one(env_trit),
                "runtime": "novalang"
            }
        }
        if3 len(key) == 0 { env_keys = keys(env_vars)
            record_stat("env", T_TRUE)
            return {
                "ok": true,
                "session_id": session_id,
                "action": "get",
                "env_vars": env_vars,
                "count": len(env_keys),
                "trit": T_TRUE,
                "char": bt_one(T_TRUE),
                "runtime": "novalang"
            }
        }
    }

    if3 action == "set" {
        if3 len(key) == 0 {
            record_stat("env", T_FALSE)
            return {
                "ok": false,
                "error": "key required for set action",
                "trit": T_FALSE,
                "char": bt_one(T_FALSE)
            }
        }

        // Set the env var using dict_set
        env_vars = dict_set(env_vars, key, value)

        // Update session env_vars in-place
        sess = dict_set(sess, "env_vars", env_vars)

        record_stat("env", T_TRUE)
        return {
            "ok": true,
            "session_id": session_id,
            "action": "set",
            "key": key,
            "value": value,
            "env_count": len(keys(env_vars)),
            "trit": T_TRUE,
            "char": bt_one(T_TRUE),
            "runtime": "novalang"
        }
    }

    // Unknown action
    record_stat("env", T_FALSE)
    return {
        "ok": false,
        "error": "Unknown action: " + action + " (use get or set)",
        "trit": T_FALSE,
        "char": bt_one(T_FALSE)
    }
}

// ===========================================================================
// GET /health
// ===========================================================================
fn health() {
    let uptime = time() - stat_t0
    let self_trit = T_MAYBE
    if3 uptime > 10 {
        self_trit = T_TRUE
    }
    let resp = ns_health_dict(SERVICE_NAME, VERSION, PORT, {})
    resp = dict_set(resp, "tools", TOOLS_COUNT)
    resp = dict_set(resp, "self_trit", self_trit)
    resp = dict_set(resp, "char", bt_one(self_trit))
    resp = dict_set(resp, "uptime_s", uptime)
    resp = dict_set(resp, "quality", {"strong": stat_trit_true, "partial": stat_trit_maybe, "failed": stat_trit_false})
    return resp
}

// ===========================================================================
// GET /tsession/status
// ===========================================================================
fn tsession_status() {
    let uptime = time() - stat_t0

    // Count active sessions
    let active_count = 0
    let total_cmds = 0
    let total_fails = 0
    let si = 0
    while3 si < len(_sessions) {
        let sess = dict_get(_sessions, si)
        let is_active = dict_get(sess, "active") ?? false
        if3 is_active == true {
            active_count = active_count + 1
        }
        total_cmds = total_cmds + dict_get(sess, "cmd_count") ?? 0
        total_fails = total_fails + dict_get(sess, "fail_count") ?? 0
        si = si + 1
    }

    // Service Reynolds from total fail rate
    let re = total_fails * H5
    if3 re > 999 {
        re = 999
    }
    let regime = flow_regime(re)

    // System trit
    let sys_trit = T_TRUE
    if3 stat_trit_false > stat_trit_true {
        sys_trit = T_FALSE
    }
    if3 stat_trit_false == stat_trit_true {
        sys_trit = T_MAYBE
    }

    let by_tool = {}
    by_tool = dict_set(by_tool, "create", by_tool_create)
    by_tool = dict_set(by_tool, "exec", by_tool_exec)
    by_tool = dict_set(by_tool, "list", by_tool_list)
    by_tool = dict_set(by_tool, "kill", by_tool_kill)
    by_tool = dict_set(by_tool, "history", by_tool_history)
    by_tool = dict_set(by_tool, "pipe", by_tool_pipe)
    by_tool = dict_set(by_tool, "env", by_tool_env)

    return {
        "ok": true,
        "service": SERVICE_NAME,
        "version": VERSION,
        "port": PORT,
        "uptime_s": uptime,
        "total_ops": stat_ops,
        "total_cmds_run": total_cmds,
        "active_sessions": active_count,
        "total_sessions": len(_sessions),
        "by_tool": by_tool,
        "trits": {
            "strong": stat_trit_true,
            "partial": stat_trit_maybe,
            "failed": stat_trit_false
        },
        "reynolds": re,
        "regime": regime,
        "system_trit": sys_trit,
        "system_char": bt_one(sys_trit),
        "harmonics": {"H3": H3, "H5": H5, "H7": H7, "H13": H13},
        "runtime": "novalang",
        "block_size": BLOCK_SIZE
    }
}

// ===========================================================================
// Route registration
// ===========================================================================
troute(server, "GET",  "/health",            "health")
troute(server, "GET",  "/tsession/status",   "tsession_status")
troute(server, "POST", "/tsession/create",   "handle_create")
troute(server, "POST", "/tsession/exec",     "handle_exec")
troute(server, "POST", "/tsession/list",     "handle_list")
troute(server, "POST", "/tsession/kill",     "handle_kill")
troute(server, "POST", "/tsession/history",  "handle_history")
troute(server, "POST", "/tsession/pipe",     "handle_pipe")
troute(server, "POST", "/tsession/env",      "handle_env")

// ===========================================================================
// Startup banner
// ===========================================================================
print("[TSession] NovaX Ternary Terminal Session Multiplexer v" + VERSION + " on port " + str(PORT))
print("[TSession] Runtime: NovaLang | Ternary: TRUE | Tools: " + str(TOOLS_COUNT))
print("[TSession] Harmonics: H3=" + str(H3) + " H5=" + str(H5) + " H7=" + str(H7) + " H13=" + str(H13))
print("[TSession] Re boundaries: laminar<" + str(RE_LAMINAR) + " transition<" + str(RE_TRANSITION) + " turbulent<" + str(RE_TURBULENT))
print("[TSession] Max sessions: " + str(MAX_SESSIONS) + " | History ring: " + str(HISTORY_MAX) + " | Cmd timeout: " + str(CMD_TIMEOUT) + "s")
print("[TSession] Routes: /health, /tsession/status, /tsession/create, /tsession/exec")
print("[TSession]         /tsession/list, /tsession/kill, /tsession/history, /tsession/pipe, /tsession/env")
print("[TSession] Ready -- http://127.0.0.1:" + str(PORT) + "/health")

tstart(server)
