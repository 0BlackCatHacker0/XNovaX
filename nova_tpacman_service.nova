print("[TPacman] Routes: POST /pacman/deploy/rolling, /pacman/validate")
print("[TPacman] Purification Engine: GET /pacman/purity/scan, /status, /locks")
print("[TPacman] Purification Engine: POST /pacman/purity/check, /convert, /lock")
print("[TPacman] Harmonics: H3=" + str(H3) + " H5=" + str(H5) + " H7=" + str(H7) + " H13=" + str(H13))
print("========================================")

tstart(server)
