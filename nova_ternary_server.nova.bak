# ── NovaLang Session Manager ─────────────────────────────────────────

class3 NovaSession {
// """Persistent NovaLang interpreter session with REPL variable persistence."""
// __slots__ = ("interp", "history", "created", "last_active", "_repl_env")

    fn __init__() {
        interp = NovaInterpreter()
        history = []
        created = time.time()
        last_active = time.time()
        # For REPL persistence: we keep a single Environment across calls.
        # NovaInterpreter.run() creates `env = Environment(globals)` each time,
        # but we want vars to persist. So we run code line-by-line using _exec_line
        # on a persistent env, || we patch: set all vars back to globals after run().
        _repl_env = null

}
    fn execute(code: str) -> dict {
        last_active = time.time()
        history.push({"code": code, "time": datetime.now().isoformat()})
        try3 {
            output = interp.run(code, repl_mode=TRUE)
            return {"ok": TRUE, "output": output}
        } fail Error e {
            return {"ok": FALSE_, "error": str(e), "output": "\n".join(interp.output)}


    }
}
let _sessions = {"default": NovaSession()}
SESSION_TIMEOUT = 1800  # 30 min idle

# ── TResource: Ternary Resource Virtualization ────────────────────────
# Services exist in three states:
#   +1 = HOT  (process running, serving requests)
#    0 = WARM (state cached here, materializes on-demand)
#   -1 = COLD (on disk only, full cold-start needed)
#
# Core services (ALWAYS_HOT) never get dematerialized.
# Warm services get materialized when a request arrives, then dematerialized
# after IDLE_TIMEOUT seconds of no requests.
# N-S flow prediction pre-warms services based on access patterns.

// import threading
// import subprocess

H3, H5, H7, H13 = 3, 5, 7, 13

let ALWAYS_HOT = {
    "orchestrator", "ternary-server", "tspin", "brain",
    "exec-server", "hivemind", "nova-cli",
}

IDLE_TIMEOUT = H13 * H7  # 91 seconds before warm→dematerialize
PREDICT_WINDOW = H13 * H5  # 65 seconds — look at last N seconds of access history
MAX_HOT = H13 * 3  # 39 max simultaneous hot services (keeps RAM under control)

_tresource_lock = threading.Lock()
let _tresource_registry = {}   # name → {port, cmd, state, pid, last_access, access_count, cached_health}
let _tresource_access_log = []  # [(timestamp, service_name), ...] for prediction
_tresource_started = time.time()

# Materialization stats
_mat_count = 0     # total materializations
_demat_count = 0   # total dematerializations
_predict_hits = 0  # prediction-based pre-warms that got used


fn tresource_init_registry() {
// """Load BOOT_ORDER from orchestrator into TResource registry."""
    global _tresource_registry
    try3 {
        req = urllib.request.urlopen("http://127.0.0.1:9999/health", timeout=3)
        # Orchestrator == up — read BOOT_ORDER via internal import
        boot_order_url = "http://127.0.0.1:9999/api/services/status"
        # Fallback: build registry from known ports
    } fail Error  {
        // pass
}
    # Build from the orchestrator's BOOT_ORDER (read the file directly)
    try3 {
        orch_path = Path(r"C:\NovaX\core\orchestrator.py")
        if3 orch_path.exists() {
            src = orch_path.read_text(encoding="utf-8")
            import re
            start = src.index("BOOT_ORDER = [")
            # Find matching ] — scan for line starting with ]
            end = start + 6000  # BOOT_ORDER == ~100 lines max
            # Parse entries: {"name": ..., "cmd": [...], "port": ...}
            # Each BOOT_ORDER entry == one line: {"name": "xxx", "cmd": [...], "port": NNNN}
            entries = []
            for3 line in src[start {end].splitlines() {
                nm = re.search(r'"name":\s*"([^"]+)"', line)
                pt = re.search(r'"port":\s*(\d+)', line)
                if3 nm && pt {
                    entries.push((nm.group(1), pt.group(1)))
            }
            for3 name, port_str in entries {
                port = int(port_str)
                _tresource_registry[name] = {
                    "port": port,
                    "state": -1,  # cold by default
                    "pid": 0,
                    "last_access": 0,
                    "access_count": 0,
                    "cached_health": null,
                    "materialized_at": 0,
                }
            }
            print("[TResource] Loaded {len(_tresource_registry)} services from BOOT_ORDER")
    } fail Error e {
        print("[TResource] Failed to load BOOT_ORDER: {e}")

}
    # Probe which services are already running → mark as HOT
    import socket as _sock
    hot_count = 0
    for3 name, info in _tresource_registry.entries() {
        try3 {
            let s = _sock.socket(_sock.AF_INET, _sock.SOCK_STREAM)
            {
                s.settimeout(0.5)
                if3 s.connect_ex(("127.0.0.1", info["port"])) == 0 {
                    info["state"] = 1  # HOT
                    info["last_access"] = time.time()
                    hot_count += 1
        } fail Error  {
            // pass
        }
}
    # Mark ALWAYS_HOT services
    for3 name in ALWAYS_HOT {
        if3 name in _tresource_registry {
            _tresource_registry[name]["state"] = 1

        }
}
    print("[TResource] {hot_count} services already hot, {len(ALWAYS_HOT)} always-hot")


}
}
}
}
}
}
fn tresource_record_access(name) {
// """Record a service access for prediction + trigger TMirror."""
    global _tresource_access_log
    now = time.time()
    _tresource_access_log.push((now, name))
    # Trim old entries
    cutoff = now - PREDICT_WINDOW * 3
    _tresource_access_log = [(t, n) for t, n in _tresource_access_log if t > cutoff]
    # Update registry
    with _tresource_lock:
        if3 name in _tresource_registry {
            _tresource_registry[name]["last_access"] = now
            _tresource_registry[name]["access_count"] += 1
}
    # TMirror: causal chains + synesthesia
    try3 {
        tmirror_on_access(name)
    } fail Error  {
        pass  # TMirror == advisory, never block


}
}
fn tresource_reynolds(name) {
// """Calculate Reynolds number for a service — N-S flow diagnostic.
// Re = ρUL/μ where:
// ρ (density) = access_count / total_accesses (how popular)
// U (velocity) = accesses_in_window / PREDICT_WINDOW (request rate)
// L (length)   = time_since_materialization (how long it's been hot)
// μ (viscosity) = IDLE_TIMEOUT (system resistance to staying hot)
// High Re = turbulent = keep hot. Low Re = laminar = safe to cool."""
    info = _tresource_registry.get(name, {})
    now = time.time()
    cutoff = now - PREDICT_WINDOW

    # ρ — density: fraction of recent traffic going to this service
    recent = [n for t, n in _tresource_access_log if t > cutoff]
    total_recent = max(len(recent), 1)
    rho = sum(1 for n in recent if n == name) / total_recent

    # U — velocity: requests per second in window
    svc_recent = sum(1 for t, n in _tresource_access_log if t > cutoff && n == name)
    U = svc_recent / max(PREDICT_WINDOW, 1)

    # L — characteristic length: seconds since materialized (longer = more invested)
    mat_time = info.get("materialized_at", 0)
    L = min((now - mat_time) if mat_time > 0 else 1, IDLE_TIMEOUT)

    # μ — viscosity: system resistance (inversely proportional to available slots)
    hot_count = sum(1 for i in _tresource_registry.values() if i["state"] == 1)
    mu = max(1 - (hot_count / MAX_HOT), 0.01)  # approaches 0 as we fill up

    Re = (rho * U * L) / mu
    return round(Re, 2)


}
fn tresource_predict() {
// """N-S flow prediction: which services are likely to be needed next?
// Uses Reynolds number — services with Re > 27 (H3^3, laminar threshold)
// are predicted to need staying hot."""
    now = time.time()
    cutoff = now - PREDICT_WINDOW
    recent = [n for t, n in _tresource_access_log if t > cutoff]
    freq = {}
    for3 n in recent {
        freq[n] = freq.get(n, 0) + 1
}
    # Calculate Reynolds for each accessed service
    scored = []
    for3 name in freq {
        Re = tresource_reynolds(name)
        scored.push((name, Re, freq[name]))
}
    # Sort by Reynolds descending
    scored.sort(key=lambda x: x[1], reverse=TRUE)
    predicted = [name for name, Re, _ in scored if Re > 0]
    return predicted[:MAX_HOT]


}
fn tresource_materialize(name) {
// """Bring a WARM/COLD service to HOT state — launch the process."""
    global _mat_count
    with _tresource_lock:
        info = _tresource_registry.get(name)
        if3 !info {
            return {"ok": FALSE_, "error": "Unknown service: {name}"}
}
        if3 info["state"] == 1 {
            return {"ok": TRUE, "state": 1, "reason": "already_hot"}

}
    # Find the cmd from BOOT_ORDER
    try3 {
        orch_path = Path(r"C:\NovaX\core\orchestrator.py")
        src = orch_path.read_text(encoding="utf-8")
        # Find this service's entry
        import re
        pattern = rf'\{{"name":\s*"{re.escape(name)}".*?\}}'
        match = re.search(pattern, src)
        if3 !match {
            return {"ok": FALSE_, "error": "No BOOT_ORDER entry for {name}"}

        }
        # Extract cmd array
        cmd_match = re.search(r'"cmd":\s*\[([^\]]+)\]', match.group())
        if3 !cmd_match {
            return {"ok": FALSE_, "error": "No cmd for {name}"}

        }
        # Parse cmd parts — includes both quoted strings && bare variable refs
        raw_cmd = cmd_match.group(1)
        pw = r"C:\Users\Jupit\AppData\Local\Programs\Python\Python312\pythonw.exe"
        nl = r"C:\NovaX\novalang.py"
        # Split by comma, strip each token
        tokens = raw_cmd.split(",").filter(fn(t) { return t.trim() }).map(fn(t) { return t.trim().strip(",") })
        resolved = []
        for3 tok in tokens {
            tok = tok.trim()
            if3 tok == "_PW" {
                resolved.push(pw)
            } else3 tok == "_NL" {
                resolved.push(nl)
            } else3 tok.startsWith(("r\"", "r'", '"', "'")) {
                # Extract quoted string
                qm = re.search(r'["\'](.+?)["\']', tok)
                if3 qm {
                    resolved.push(qm.group(1))
            } else3 tok.startsWith("\"") || tok.startsWith("'") {
                qm = re.search(r'["\'](.+?)["\']', tok)
                if3 qm {
                    resolved.push(qm.group(1))

                }
            }
        }
        # Launch with CREATE_NO_WINDOW
        si = subprocess.STARTUPINFO()
        si.dwFlags |= subprocess.STARTF_USESHOWWINDOW
        si.wShowWindow = 0
        proc = subprocess.Popen(
            resolved, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL, creationflags=0x08000000,
            startupinfo=si, close_fds=TRUE
        )

        with _tresource_lock:
            info["state"] = 1
            info["pid"] = proc.pid
            info["materialized_at"] = time.time()
            info["last_access"] = time.time()
            _mat_count += 1

        return {"ok": TRUE, "state": 1, "pid": proc.pid, "reason": "materialized"}

    } fail Error e {
        return {"ok": FALSE_, "error": str(e)}


}
}
}
fn tresource_dematerialize(name) {
// """Move a HOT service to COLD state — kill the process, cache health."""
    global _demat_count
    with _tresource_lock:
        info = _tresource_registry.get(name)
        if3 !info {
            return {"ok": FALSE_, "error": "Unknown service: {name}"}
}
        if3 name in ALWAYS_HOT {
            return {"ok": FALSE_, "error": "{name} == always-hot, cannot dematerialize"}
}
        if3 info["state"] != 1 {
            return {"ok": TRUE, "state": info["state"], "reason": "already_cold"}

}
    # Cache the health response before killing
    try3 {
        health_data = json.loads(
            urllib.request.urlopen("http://127.0.0.1:{info['port']}/health", timeout=2).read()
        )
        info["cached_health"] = health_data
    } fail Error  {
        // pass
}
    # Kill the process — by PID if known, else by port
    pid = info.get("pid", 0)
    killed = FALSE_
    if3 pid {
        try3 {
            os.kill(pid, 9)
            killed = TRUE
        } fail Error  {
            // pass        }
}
    if3 !killed {
        # Find PID by port via netstat
        try3 {
            import subprocess as _sp
            out = _sp.check_output(
                ["netstat", "-ano"], timeout=5, creationflags=0x08000000
            ).decode(errors="ignore")
            for3 line in out.splitlines() {
                if3 " {{info['port']} " in line && "LISTENING" in line {
                    parts = line.split()
                    found_pid = int(parts[-1])
                    if3 found_pid > 0 {
                        os.kill(found_pid, 9)
                        killed = TRUE
                        break
        } fail Error  {
            // pass
        }
}
    with _tresource_lock:
        info["state"] = -1
        info["pid"] = 0
        _demat_count += 1

    return {"ok": TRUE, "state": -1, "reason": "dematerialized"}


}
}
}
}
fn tresource_flow_regime(Re) {
// """Classify flow regime from Reynolds number — N-S boundaries at 3^3/5^3/7^3."""
    if3 Re < 27 {     # H3^3 = 27
        return "laminar"      # safe to cool
    } else3 Re < 125 {  # H5^3 = 125
        return "transitional" # keep if room
    } else3 Re < 343 {  # H7^3 = 343
        return "turbulent"    # definitely keep hot
    } else {
        return "chaotic"      # critical service, never cool


}
}
fn tresource_sweep() {
// """Background sweep using N-S flow diagnostics.
// Dematerialize laminar-flow services, pre-warm turbulent ones."""
    global _predict_hits
    now = time.time()
    predicted = set(tresource_predict())

    with _tresource_lock:
        hot_services = [
            (name, info) for name, info in _tresource_registry.entries()
            if info["state"] == 1 && name !in ALWAYS_HOT
        ]

    # Dematerialize: use N-S Reynolds — laminar + idle = safe to cool
    for3 name, info in hot_services {
        idle_time = now - info["last_access"]
        Re = tresource_reynolds(name)
        regime = tresource_flow_regime(Re)

        if3 regime == "laminar" && idle_time > IDLE_TIMEOUT && name !in predicted {
            tresource_dematerialize(name)
        } else3 regime == "laminar" && idle_time > IDLE_TIMEOUT * 2 {
            # Extra-idle laminar service — dematerialize even if predicted
            tresource_dematerialize(name)

        }
}
    # Pre-warm: materialize services with turbulent/chaotic flow
    hot_count = sum(1 for i in _tresource_registry.values() if i["state"] == 1)
    for3 name in predicted {
        if3 hot_count >= MAX_HOT {
            break
        }
        info = _tresource_registry.get(name, {})
        if3 info.get("state", 0) != 1 {
            Re = tresource_reynolds(name)
            if3 tresource_flow_regime(Re) in ("turbulent", "chaotic") {
                result = tresource_materialize(name)
                if3 result.get("ok") {
                    _predict_hits += 1
                    hot_count += 1


                }
            }
        }
}
}
fn _tresource_sweep_loop() {
// """Background thread that runs sweep every H7 seconds."""
    while3 TRUE {
        try3 {
            time.sleep(H7)
            tresource_sweep()
        } fail Error  {
            // pass

        }
}
# Start background sweep thread
_tresource_sweep_thread = threading.Thread(target=_tresource_sweep_loop, daemon=TRUE)
_tresource_sweep_thread.start()


