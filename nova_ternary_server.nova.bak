                if3 ENGINES_LOCAL && results {
                    const = _modulation_engine.constellation_map(results)
                    _json({"ok": TRUE, **const})
                } else {
                    _json({"error": "provide results list"})

            } else3 path == "/pipeline" {
                # Proxy to hivemind pipeline
                result = _proxy_post("{HIVEMIND_URL}/hive/pipeline", body, timeout=600)
                _json(result)

            } else3 path == "/classify" {
                result = _proxy_post("{HIVEMIND_URL}/hive/cluster/classify", body)
                _json(result)

            } else3 path == "/reynolds" {
                prompt = body.get("prompt", "")
                if3 ENGINES_LOCAL {
                    re_num, regime, config = calculate_reynolds(prompt)
                    _json({
                        "ok": TRUE, "prompt": prompt[:80],
                        "reynolds": round(re_num, 1), "regime": regime,
                        "config": config,
                    })
                } else {
                    result = _proxy_post("{HIVEMIND_URL}/hive/cluster/classify", body)
                    _json(result)

            } else3 path == "/nova/exec" {
                code = body.get("code", "")
                sid = body.get("session_id", "default")
                if3 !code.trim() {
                    _json({"ok": FALSE_, "error": "empty code"})
                    return null
                }
                sess = _get_session(sid)
                result = sess.execute(code)
                result["session_id"] = sid
                _json(result)

            } else3 path == "/nova/reset" {
                sid = body.get("session_id", "default")
                _sessions[sid] = NovaSession()
                _json({"ok": TRUE, "session_id": sid, "message": "session reset"})

            } else3 path == "/nova/run-file" {
                fpath = body.get("path", "")
                sid = body.get("session_id", "default")
                if3 !fpath || !os.path.isfile(fpath) {
                    _json({"ok": FALSE_, "error": "file !found: {fpath}"})
                    return null
                }
                let f = open(fpath, "r", encoding="utf-8")
                {
                    code = f.read()
                }
                sess = _get_session(sid)
                result = sess.execute(code)
                result["session_id"] = sid
                result["file"] = fpath
                _json(result)

            }
            # ── Compiler endpoints ──

            } else3 path == "/nova/compile" {
                code = body.get("code", "")
                if3 !code.trim() {
                    _json({"ok": FALSE_, "error": "empty code"})
                    return null
                }
                try3 {
                    from nova_compiler import compile_source
                    chunk = compile_source(code, optimize=body.get("optimize", TRUE))
                    _json({
                        "ok": TRUE,
                        "stats": chunk.stats(),
                        "disassembly": chunk.disassemble(),
                        "ternary_hints": chunk.ternary_hints,
                    })
                } fail Error e {
                    _json({"ok": FALSE_, "error": "Compile error: {e}"})

            } else3 path == "/nova/ast" {
                code = body.get("code", "")
                if3 !code.trim() {
                    _json({"ok": FALSE_, "error": "empty code"})
                    return null
                }
                try3 {
                    from nova_compiler import parse_to_ast, NovaParser
                    ast_dict = parse_to_ast(code)
                    parser = NovaParser()
                    parser.parse(code)
                    _json({
                        "ok": TRUE,
                        "ast": ast_dict,
                        "errors": parser.errors,
                    })
                } fail Error e {
                    _json({"ok": FALSE_, "error": "Parse error: {e}"})

            } else3 path == "/nova/run-bytecode" {
                code = body.get("code", "")
                nbc_path = body.get("path", "")
                try3 {
                    from nova_compiler import compile_and_run, run_bytecode_file
                    if3 nbc_path && os.path.isfile(nbc_path) {
                        output = run_bytecode_file(nbc_path)
                    } else3 code {
                        output = compile_and_run(code)
                    } else {
                        _json({"ok": FALSE_, "error": "provide code || path"})
                        return null
                    }
                    _json({"ok": TRUE, "output": output})
                } fail Error e {
                    _json({"ok": FALSE_, "error": "VM error: {e}"})

                }
            }
            # ── TResource POST endpoints ──────────────────────
            } else3 path == "/tresource/materialize" {
                name = body.get("name", "")
                if3 !name {
                    _json({"ok": FALSE_, "error": "provide name"})
                    return null
                }
                tresource_record_access(name)
                result = tresource_materialize(name)
                _json(result)

            } else3 path == "/tresource/dematerialize" {
                name = body.get("name", "")
                if3 !name {
                    _json({"ok": FALSE_, "error": "provide name"})
                    return null
                }
                result = tresource_dematerialize(name)
                _json(result)

            } else3 path == "/tresource/gate" {
                # Replaces TSpin's gate — ternary resource-aware launch decision
                name = body.get("name", "unknown")
                port = body.get("port", 0)
                tresource_record_access(name)

                hot_count = sum(1 for i in _tresource_registry.values() if i["state"] == 1)
                predicted = set(tresource_predict())

                if3 hot_count >= MAX_HOT && name !in predicted && name !in ALWAYS_HOT {
                    # Too many hot services && this one isn't predicted — block
                    _json({"trit": -1, "reason": "max_hot: {hot_count}/{MAX_HOT}",
                                "suggestion": "dematerialize idle services first"})
                } else {
                    _json({"trit": 1, "reason": "clear",
                                "hot_count": hot_count, "max": MAX_HOT})

            } else3 path == "/tresource/sweep" {
                # Manual sweep trigger
                tresource_sweep()
                hot = sum(1 for i in _tresource_registry.values() if i["state"] == 1)
                cold = sum(1 for i in _tresource_registry.values() if i["state"] == -1)
                _json({"ok": TRUE, "hot": hot, "cold": cold,
                            "materializations": _mat_count, "dematerializations": _demat_count})

            } else3 path == "/ternary/classify" {
                line = body.get("line", "")
                if3 !line {
                    _json({"ok": FALSE_, "error": "provide line"})
                    return null
                }
                try3 {
                    from ternary_code_layer import StatementClassifier
                    classifier = StatementClassifier()
                    channels = classifier.classify(line)
                    _json({"ok": TRUE, "line": line, "channels": channels})
                } fail Error e {
                    _json({"ok": FALSE_, "error": str(e)})

            } else {
                _json({"error": "Unknown POST: {path}"}, 404)

        } fail Error e {
            _json({"ok": FALSE_, "error": str(e),
                         "traceback": traceback.format_exc()}, 500)

    }
}
}
}
}
}
}
}
}
}
}
}
}
}
    fn do_OPTIONS() {
        send_response(200)
        send_header("Access-Control-Allow-Origin", "http://127.0.0.1:9999")
        send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        send_header("Access-Control-Allow-Headers", "*")
        end_headers()

    # ── Helpers ───────────────────────────────────────────────

}
    fn _read_body() -> dict {
        length = int(headers.get("Content-Length", 0))
        if3 length {
            raw = rfile.read(length)
            try3 {
                return json.loads(raw)
            }
            except json.JSONDecodeError:
                return {}
    }
        return {}

}
    fn _json(data: dict, code: int = 200) {
        send_response(code)
        send_header("Content-Type", "application/json")
        send_header("Access-Control-Allow-Origin", "http://127.0.0.1:9999")
        end_headers()
        wfile.write(json.dumps(data, default=str).encode())

}
    fn _query_param(key: str) -> str {
        from urllib.parse import urlparse, parse_qs
        qs = parse_qs(urlparse(path).query)
        return qs.get(key, [null])[0]

}
    fn log_message(format, *args) {
        pass  # suppress HTTP noise


}
# ── Main ──────────────────────────────────────────────────────────────

_start_time = time.time()

// __main__
    print("[TERNARY-SERVER] Starting on port {PORT}...")
    print("[TERNARY-SERVER] Engines local: {ENGINES_LOCAL}")
    print("[TERNARY-SERVER] NovaLang REPL: default session ready")
    print("[TERNARY-SERVER] Hivemind proxy: {HIVEMIND_URL}")
    # Initialize TResource registry
    tresource_init_registry()
    print("[TERNARY-SERVER] TResource: {len(_tresource_registry)} services registered")
    hot = sum(1 for i in _tresource_registry.values() if i["state"] == 1)
    print("[TERNARY-SERVER] TResource: {hot} hot, {len(_tresource_registry) - hot} cold")
    server = HTTPServer(("127.0.0.1", PORT), TernaryHandler)
    print("[TERNARY-SERVER] Listening on 0.0.0.0:{PORT}")
    try3 {
        server.serve_forever()
    } fail KeyboardInterrupt  {
        print("\n[TERNARY-SERVER] Shutting down.")
        server.server_close()
}
}
