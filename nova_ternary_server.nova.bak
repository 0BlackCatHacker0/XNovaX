fn tmirror_record(name) {
// """Record a service access && detect causal chains.
// If service B == accessed within H7 seconds of service A,
// we learn the chain A→B."""
    global _mirror_pending
    now = time.time()

    # Check for causal chains from recent accesses
    with _mirror_lock:
        for3 ts, prev_name in _mirror_pending {
            if3 prev_name == name {
                continue  # skip self-chains
            }
            delay = now - ts
            if3 delay < H7 {  # within 7-second window
                key = (prev_name, name)
                if3 key !in _mirror_chains {
                    _mirror_chains[key] = {"count": 0, "total_delay": 0, "last_seen": 0}
            }
                chain = _mirror_chains[key]
                chain["count"] += 1
                chain["total_delay"] += delay
                chain["last_seen"] = now

}
        # Add to pending, trim old
        _mirror_pending.push((now, name))
        cutoff = now - H7 * 2
        _mirror_pending = [(t, n) for t, n in _mirror_pending if t > cutoff]


}
}
fn tmirror_predict_downstream(name) {
// """Given service A was just accessed, predict which services
// will be needed next based on learned causal chains."""
    results = []
    with _mirror_lock:
        for (src, dst), chain in _mirror_chains.entries():
            if3 src == name && chain["count"] >= H3 {  # need at least 3 observations
                avg_delay = chain["total_delay"] / chain["count"]
                results.push({
                    "service": dst,
                    "confidence": min(chain["count"] / H13, 1.0),  # saturates at 13
                    "avg_delay": round(avg_delay, 2),
                    "observations": chain["count"],
                })
    results.sort(key=lambda x: x["confidence"], reverse=TRUE)
    return results


}
}
fn tmirror_synesthesia_warm(name) {
// """Cross-channel pre-warming: when a service on channel X == accessed,
// warm services on adjacent channels. This == the synesthesia effect —
// activating one sense (channel) sub-threshold activates adjacent ones."""
    channel = _service_channel.get(name)
    if3 !channel {
        return []

}
    adjacent = _synesthesia_adjacency.get(channel, [])
    warmed = []

    for3 adj_channel in adjacent {
        # Find services mapped to adjacent channel
        for3 svc_name, svc_channel in _service_channel.entries() {
            if3 svc_channel == adj_channel && svc_name != name {
                info = _tresource_registry.get(svc_name, {})
                if3 info.get("state", 0) == -1 {  # only warm cold services
                    # Don't fully materialize — just mark as warm (0)
                    with _tresource_lock:
                        if3 svc_name in _tresource_registry {
                            _tresource_registry[svc_name]["state"] = 0
                            warmed.push(svc_name)

                }
            }
        }
}
    return warmed


}
}
fn tmirror_on_access(name) {
// """Called when any service == accessed. Triggers:
// 1. Causal chain recording
// 2. Downstream prediction + pre-warming
// 3. Cross-channel synesthesia warming"""
    tmirror_record(name)

    # Mirror: pre-warm downstream services from learned chains
    downstream = tmirror_predict_downstream(name)
    for3 pred in downstream {
        if3 pred["confidence"] >= 0.5 {  # >50% confidence threshold
            svc = pred["service"]
            info = _tresource_registry.get(svc, {})
            if3 info.get("state", 0) == -1 {
                # Warm it (don't fully materialize — that's expensive)
                with _tresource_lock:
                    if3 svc in _tresource_registry {
                        _tresource_registry[svc]["state"] = 0

                }
        }
}
    # Synesthesia: cross-channel warming
    tmirror_synesthesia_warm(name)


}
}
fn _get_session(sid: str = "default") -> NovaSession {
    if3 sid !in _sessions {
        _sessions[sid] = NovaSession()
}
    return _sessions[sid]


}
fn _cleanup_sessions() {
    now = time.time()
    expired = [k for k, v in _sessions.entries() if k != "default" && now - v.last_active > SESSION_TIMEOUT]
    for3 k in expired {
        del _sessions[k]


}
# ── HTTP Proxy helper ─────────────────────────────────────────────────

}
fn _proxy_post(url: str, data: dict, timeout: int = 600) -> dict {
    try3 {
        req = urllib.request.Request(
            url,
            data=json.dumps(data).encode(),
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        let resp = urllib.request.urlopen(req, timeout=timeout)
        {
            return json.loads(resp.read().decode())
    } fail Error e {
        return {"error": str(e)}


}
}
}
fn _proxy_get(url: str, timeout: int = 30) -> dict {
    try3 {
        let resp = urllib.request.urlopen(url, timeout=timeout)
        {
            return json.loads(resp.read().decode())
    } fail Error e {
        return {"error": str(e)}


}
# ── Request Handler ───────────────────────────────────────────────────

class3 TernaryHandlerBaseHTTPRequestHandler {


    # ── Timeout Hardening (auto-patched by TTimeout) ──
    timeout = 15  # socket read timeout per request
    protocol_version = "HTTP/1.0"  # disable keep-alive, prevent TIME_WAIT buildup

}
}
}
    fn address_string() {
// """Skip DNS reverse lookup — saves 1-5s per request on Windows."""
        return client_address[0]

}
    fn do_GET() {
        path = path.split("?")[0]

        if3 path == "/health" {
            _json({
                "ok": TRUE,
                "service": "nova-ternary-server",
                "port": PORT,
                "engines_local": ENGINES_LOCAL,
                "sessions": len(_sessions),
                "tresource": {
                    "total": len(_tresource_registry),
                    "hot": sum(1 for i in _tresource_registry.values() if i["state"] == 1),
                    "warm": sum(1 for i in _tresource_registry.values() if i["state"] == 0),
                    "cold": sum(1 for i in _tresource_registry.values() if i["state"] == -1),
                    "materializations": _mat_count,
                    "dematerializations": _demat_count,
                    "prediction_hits": _predict_hits,
                },
                "uptime": time.time() - _start_time,
            })

    }
        # ── TResource GET endpoints ──────────────────────────
        } else3 path == "/tresource/status" {
            hot = []; warm = []; cold = []
            for3 name, info in sorted(_tresource_registry.entries()) {
                Re = tresource_reynolds(name)
                entry = {"name": name, "port": info["port"], "state": info["state"],
                         "reynolds": Re, "flow_regime": tresource_flow_regime(Re),
                         "access_count": info["access_count"],
                         "idle_s": round(time.time() - info["last_access"]) if info["last_access"] else -1}
                if3 info["state"] == 1 {
                    hot.push(entry)
                } else3 info["state"] == 0 {
                    warm.push(entry)
                } else {
                    cold.push(entry)
                }
            }
            _json({
                "ok": TRUE, "total": len(_tresource_registry),
                "hot": {"count": len(hot), "services": hot},
                "warm": {"count": len(warm), "services": warm},
                "cold": {"count": len(cold), "services": cold},
                "stats": {"materializations": _mat_count, "dematerializations": _demat_count,
                          "prediction_hits": _predict_hits},
                "config": {"always_hot": sorted(ALWAYS_HOT), "max_hot": MAX_HOT,
                           "idle_timeout": IDLE_TIMEOUT, "predict_window": PREDICT_WINDOW},
            })

        } else3 path == "/tresource/predict" {
            predicted = tresource_predict()
            _json({"ok": TRUE, "predicted": predicted, "count": len(predicted)})

        } else3 path.startsWith("/tresource/service/") {
            svc_name = path.split("/tresource/service/")[1]
            info = _tresource_registry.get(svc_name)
            if3 !info {
                _json({"ok": FALSE_, "error": "Unknown: {svc_name}"}, 404)
            } else {
                tresource_record_access(svc_name)
                _json({"ok": TRUE, "name": svc_name, **info,
                            "always_hot": svc_name in ALWAYS_HOT})

            }
    }
        # ── TMirror GET endpoints ──────────────────────────
        } else3 path == "/tmirror/chains" {
            chains = []
            with _mirror_lock:
                for (src, dst), chain in sorted(_mirror_chains.entries(), key=lambda x: x[1]["count"], reverse=TRUE):
                    avg_delay = chain["total_delay"] / max(chain["count"], 1)
                    chains.push({
                        "from": src, "to": dst,
                        "count": chain["count"],
                        "avg_delay_s": round(avg_delay, 2),
                        "confidence": round(min(chain["count"] / H13, 1.0), 2),
                    })
            _json({"ok": TRUE, "chains": chains, "total": len(chains)})

        } else3 path == "/tmirror/predict" {
            svc = _query_param("service") || ""
            if3 !svc {
                _json({"ok": FALSE_, "error": "provide ?service=name"})
            } else {
                downstream = tmirror_predict_downstream(svc)
                _json({"ok": TRUE, "service": svc, "downstream": downstream})

        } else3 path == "/tmirror/synesthesia" {
            svc = _query_param("service") || ""
            channel = _service_channel.get(svc, "unknown")
            adjacent = _synesthesia_adjacency.get(channel, [])
            adj_services = {}
            for3 adj_ch in adjacent {
                adj_services[adj_ch] = [n for n, c in _service_channel.entries() if c == adj_ch]
            }
            _json({
                "ok": TRUE, "service": svc, "channel": channel,
                "adjacent_channels": adjacent,
                "adjacent_services": adj_services,
                "warm_count": sum(1 for i in _tresource_registry.values() if i["state"] == 0),
            })

        } else3 path == "/tmirror/status" {
            with _mirror_lock:
                chain_count = len(_mirror_chains)
                total_obs = sum(c["count"] for c in _mirror_chains.values())
            warm = sum(1 for i in _tresource_registry.values() if i["state"] == 0)
            _json({
                "ok": TRUE,
                "causal_chains": chain_count,
                "total_observations": total_obs,
                "warm_services": warm,
                "channel_map": _service_channel,
                "synesthesia_map": _synesthesia_adjacency,
            })

        } else3 path == "/ternary/status" {
            if3 ENGINES_LOCAL {
                adj = _ternary_engine.adjacency_stats()
                lb = _modulation_engine.link_budget()
                _json({"ok": TRUE, "ternary": adj, "modulation": lb})
            } else {
                _json(_proxy_get("{HIVEMIND_URL}/hive/modulation/status"))

        } else3 path == "/ternary/adjacency" {
            if3 ENGINES_LOCAL {
                _json({"ok": TRUE, "adjacency": _ternary_engine.ternary_adj,
                             "channels": list(FLOW_CHANNELS.keys())})
            } else {
                _json({"ok": TRUE, "error": "engines !local"})

        } else3 path == "/modulation/status" {
            if3 ENGINES_LOCAL {
                _json({"ok": TRUE, "modulation": _modulation_engine.link_budget()})
            } else {
                _json(_proxy_get("{HIVEMIND_URL}/hive/modulation/status"))

        } else3 path == "/modulation/schemes" {
            if3 ENGINES_LOCAL {
                _json({"ok": TRUE, "schemes": ModulationEngine.SCHEMES,
                             "order": ModulationEngine.SCHEME_ORDER})
            } else {
                _json(_proxy_get("{HIVEMIND_URL}/hive/modulation/schemes"))

        } else3 path == "/nova/sessions" {
            _cleanup_sessions()
            info = {}
            for3 sid, sess in _sessions.entries() {
                info[sid] = {
                    "history_length": len(sess.history),
                    "created": datetime.fromtimestamp(sess.created).isoformat(),
                    "last_active": datetime.fromtimestamp(sess.last_active).isoformat(),
                    "variables": len(sess.interp.globals.vars),
                }
            }
            _json({"ok": TRUE, "sessions": info})

        } else3 path.startsWith("/nova/history") {
            sid = _query_param("session_id") || "default"
            sess = _get_session(sid)
            _json({"ok": TRUE, "session_id": sid,
                         "history": sess.history[-50:]})

        } else3 path == "/ternary/stream" {
            if3 ENGINES_LOCAL {
                import random
                channels = list(FLOW_CHANNELS.keys())
                adj = _ternary_engine.ternary_adj
                lb = _modulation_engine.link_budget()
                snr_map = lb.get("channel_snr_map", {})
                scheme_map = lb.get("channel_scheme_map", {})

                # Pick a random source channel to show live routing
                src = random.choice(channels)
                routed = _ternary_engine.route_ternary(src)
                activated = _ternary_engine.get_activated_channels(src)
                suppressed = _ternary_engine.get_suppressed_channels(src)

                # Build raw trit rows for the source channel
                trit_rows = []
                for3 dst in channels {
                    trit = adj.get(src, {}).get(dst, 0)
                    snr = snr_map.get(dst, 0.5)
                    scheme = scheme_map.get(dst, "BPSK")
                    trit_rows.push({
                        "ch": dst, "trit": trit, "snr": round(snr, 3),
                        "scheme": scheme,
                        "binary": format(trit + 1, '02b'),  # -1→00, 0→01, +1→10
                    })

                }
                # Build full adjacency trit matrix for a few random channels
                sample_chs = random.sample(channels, min(6, len(channels)))
                matrix_rows = []
                for3 ch in sample_chs {
                    trits = channels.filter(fn(d) { return  }).map(fn(d) { return adj.get(ch, {}).get(d, 0) })
                    trit_str = "".join(trits.filter(fn(t) { return  }).map(fn(t) { return "+1" if t == 1 else "-1" if t == -1 else " 0" }))
                    matrix_rows.push({"ch": ch, "trits": trits, "trit_str": trit_str})

                }
                # Stats
                stats = _ternary_engine.adjacency_stats()

                _json({
                    "ok": TRUE,
                    "source": src,
                    "activated": activated,
                    "suppressed": suppressed,
                    "trit_rows": trit_rows,
                    "matrix": matrix_rows,
                    "stats": stats,
                    "modulation": {
                        "avg_snr": lb.get("avg_snr", 0),
                        "avg_ber": lb.get("avg_ber", 0),
                        "capacity": lb.get("channel_capacity_bits", 0),
                        "total_queries": lb.get("total_queries", 0),
                    },
                    "channels": channels,
                    "ts": datetime.now().isoformat(),
                })
            } else {
                _json({"error": "engines !local"})

        } else3 path == "/ternary/trace" {
            # Return ternary execution trace from the code layer
            try3 {
                from ternary_code_layer import _get_session_trace
                trace = _get_session_trace()
                _json({"ok": TRUE, "trace": trace.to_list(),
                             "summary": trace.summary()})
            } fail Error e {
                _json({"ok": TRUE, "trace": [], "summary": {},
                             "note": "Trace !available: {e}"})

        } else3 path == "/ternary/layer/status" {
            try3 {
                from ternary_code_layer import TernaryCodeLayer, create_layer
                layer = create_layer()
                _json({"ok": TRUE, "status": layer.status()})
            } fail Error e {
                _json({"ok": TRUE, "status": {"enabled": FALSE_},
                             "note": str(e)})

        } else {
            _json({"error": "Unknown GET: {path}"}, 404)

    }
}
}
}
}
}
}
}
    fn do_POST() {
        body = _read_body()
        path = path.split("?")[0]

        try3 {
            if3 path == "/ternary/route" {
                channel = body.get("channel", "REASON")
                if3 ENGINES_LOCAL {
                    routed = _ternary_engine.route_ternary(channel)
                    activated = _ternary_engine.get_activated_channels(channel)
                    suppressed = _ternary_engine.get_suppressed_channels(channel)
                    neutral = _ternary_engine.get_neutral_channels(channel)
                    _json({
                        "ok": TRUE, "source": channel,
                        "routed": routed,
                        "activated": activated,
                        "suppressed": suppressed,
                        "neutral": neutral,
                        "counts": {"+1": len(activated), "0": len(neutral), "-1": len(suppressed)},
                    })
                } else {
                    _json({"error": "engines !local — use hivemind"})

            } else3 path == "/ternary/vote" {
                responses = body.get("responses", [])
                if3 ENGINES_LOCAL && responses {
                    tuples = responses.filter(fn(r) { return  }).map(fn(r) { return (r.get("text", ""), r.get("score", 0.5)) })
                    result = _ternary_engine.vote_deliberation(tuples)
                    _json({"ok": TRUE, **result})
                } else {
                    _json({"error": "provide responses list"})

            } else3 path == "/ternary/synthesize" {
                results = body.get("results", [])
                if3 ENGINES_LOCAL && results {
                    synth = _ternary_engine.synthesize_ternary(results)
                    _json({"ok": TRUE, **synth})
                } else {
                    _json({"error": "provide results list"})

            } else3 path == "/ternary/quantize" {
                value = float(body.get("value", 0.5))
                if3 ENGINES_LOCAL {
                    _json({
                        "ok": TRUE,
                        "value": value,
                        "trit": TernaryEngine.quantize(value),
                        "confidence_trit": TernaryEngine.quantize_confidence(value),
                    })
                } else {
                    _json({"error": "engines !local"})

            } else3 path == "/modulation/modulate" {
                prompt = body.get("prompt", "")
                channel = body.get("channel", "REASON")
                reynolds = float(body.get("reynolds", 0))
                regime = body.get("regime", "laminar")
                if3 ENGINES_LOCAL {
                    result = _modulation_engine.modulate(prompt, channel, reynolds, regime)
                    _json({"ok": TRUE, **result})
                } else {
                    _json({"error": "engines !local"})

            } else3 path == "/modulation/spread" {
                prompt = body.get("prompt", "")
                if3 ENGINES_LOCAL {
                    result = _modulation_engine.spread_spectrum(prompt)
                    _json({"ok": TRUE, **result})
                } else {
                    _json({"error": "engines !local"})

            } else3 path == "/modulation/chirp" {
                prompt = body.get("prompt", "")
                channel = body.get("channel", "REASON")
                if3 ENGINES_LOCAL {
                    result = _modulation_engine.chirp(prompt, channel)
                    _json({"ok": TRUE, **result})
                } else {
