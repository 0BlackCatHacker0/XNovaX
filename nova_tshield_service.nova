// ============================================================================
// TShield -- The Invisible Spinner
// NovaX IP Masking + Gateway Cloaking + Reflection Shield + Quantum Defense
// Port 9987 | Ternary Micro-Tool | 3-5-7-13 Harmonics
// ============================================================================
// STATUS: PASSIVE MONITOR STUB — no network-layer interception
// TShield only records advisories in internal state; it is NOT an active
// firewall. See the detailed passive-monitor disclosure below.
// ============================================================================
// STATUS: PASSIVE MONITOR -- does not intercept packets or block IPs at the
//   network layer. TShield only analyzes connections that OTHER services
//   voluntarily report via POST /api/shield/analyze (or call analyze_connection
//   in-process). "Blocked" IPs are recorded in an internal dict (_blocked_ips)
//   that other services may consult -- TShield itself does NOT drop packets,
//   edit iptables/Windows Firewall, or hook into the OS network stack.
//   Endpoints named "block", "lockdown", "rotate", "reflect" update INTERNAL
//   state only. They are accurate advisories, not active countermeasures.
// ============================================================================
// WARNING: sha256() in NovaLang is cascaded FNV-1a, NOT cryptographic SHA-256.
// Fingerprint hashing is used for identification only, not security guarantees.
// ============================================================================
// A shield spins to deflect all incoming threats.
// TShield maintains an invisible protection layer:
//   +1 = CLOAKED   (invisible, all shields active, no signature)
//    0 = DEFLECTING (attack detected, reflecting payload)
//   -1 = EXPOSED    (shield breach, emergency lockdown)
//
// If an attacker somehow penetrates the outer layers, whatever they
// send gets amplified 100x and reflected back, overloading them.
//
// Integration chain: TShield -> TSpin -> TScale -> THunter (quad-guardian)
// ============================================================================

// -- Config --
// -- Shared Libraries (N-S Flow) --
import3("C:/NovaX/lib/nova_ns_core.nova")
import3("C:/NovaX/lib/nova_stdlib.nova")

let VERSION = "2.0"
let PORT = 9987
let SERVICE = "nova-tshield"
let server = tserve(PORT, "TShield NovaLang")

// -- 3-5-7-13 Harmonic Constants --
let BLOCK_SIZE = 2187

// -- Ternary States --
let T_TRUE = 1
let T_FALSE = -1
let T_MAYBE = 0

// -- Shield States --
let CLOAKED = 1
let DEFLECTING = 0
let EXPOSED = -1

// -- Thresholds (3-5-7-13 aligned) --
let SPIN_INTERVAL = H3
let REFLECTION_MULTIPLIER = 100
let MAX_THREAT_LOG = H13 * 10
let CLOAK_ROTATION = H7
let LOCKDOWN_THRESHOLD = H13
let RATE_LIMIT_HIGH = H13 * H5
let RATE_LIMIT_MED = H13 * H3
let PAYLOAD_THRESHOLD = BLOCK_SIZE * H13

// -- Triad Peers (quad-guardian) --
let TRIAD_PEERS = {
    "tspin": "http://127.0.0.1:9970",
    "tscale": "http://127.0.0.1:9986",
    "thunter": "http://127.0.0.1:9988",
    "tgarlic": "http://127.0.0.1:9996"
}

// -- State --
let _shield_state = CLOAKED
let _spin_count = 0
let _threats_detected = 0
let _threats_reflected = 0
let _attacks_blocked = 0
let _threat_log = []
let _blocked_ips = {}
let _reflection_log = []
let _connection_monitor = {}
let _triad_events = []
let _triad_log = []
let _t0 = time()
let _last_rotation_time = time()

let _shield_layers = {
    "ip_mask": true,
    "gateway_cloak": true,
    "port_stealth": true,
    "reflection": true,
    "quantum_noise": true
}

// ============================================================================
// RANDOM HELPERS -- native NovaLang random_int builtin
// ============================================================================

// random_int(lo, hi) is a NovaLang builtin -- no wrapper needed

fn random_choice_3() {
    // Returns one of: 10, 172, 192
    let r = random_int(0, 2)
    if3 r == 0 {
        return 10
    }
    if3 r == 1 {
        return 172
    }
    return 192
}

fn random_trit() {
    // Returns -1, 0, or 1
    let r = random_int(0, 2)
    return r - 1
}

// ============================================================================
// PHANTOM IDENTITY GENERATOR
// ============================================================================

fn generate_phantom_ip() {
    let prefix = random_choice_3()
    let o2 = random_int(0, 255)
    let o3 = random_int(0, 255)
    let o4 = random_int(1, 254)
    if3 prefix == 172 {
        o2 = random_int(16, 31)
    }
    if3 prefix == 192 {
        o2 = 168
    }
    return str(prefix) + "." + str(o2) + "." + str(o3) + "." + str(o4)
}

fn generate_phantom_mac() {
    let hex_chars = "0123456789abcdef"
    let mac = ""
    let i = 0
    while3 i < 6 {
        let byte_val = random_int(0, 255)
        let hi_nib = int(byte_val / 16)
        let lo_nib = byte_val - (hi_nib * 16)
        let pair = slice(hex_chars, hi_nib, hi_nib + 1) + slice(hex_chars, lo_nib, lo_nib + 1)
        if3 i == 0 {
            mac = pair
        } else {
            mac = mac + ":" + pair
        }
        i = i + 1
    }
    return mac
}

fn generate_phantom_gateway() {
    let nets = ["10", "172.16", "192.168"]
    let idx = random_int(0, 2)
    let net = nets[idx]
    let octet = random_int(0, 255)
    return net + "." + str(octet) + ".1"
}

fn fingerprint_hash(data) {
    let h = hash(data, "sha256")
    // Take first H13 chars and convert to ternary trit string
    let trits = ""
    let hex_map = "0123456789abcdef"
    let sub = slice(h, 0, H13)
    let i = 0
    while3 i < len(sub) {
        let c = sub[i]
        // Find hex char index to get its numeric value
        let hex_val = 0
        let j = 0
        while3 j < 16 {
            if3 slice(hex_map, j, j + 1) == c {
                hex_val = j
            }
            j = j + 1
        }
        // mod 3, subtract 1 => -1/0/+1
        let trit_val = (hex_val - int(hex_val / 3) * 3) - 1
        trits = trits + str(trit_val)
        i = i + 1
    }
    return trits
}

// Initialize the first phantom identity
let _current_phantom = {
    "ip": generate_phantom_ip(),
    "mac": generate_phantom_mac(),
    "gateway": generate_phantom_gateway(),
    "fingerprint": fingerprint_hash(str(time())),
    "rotated_at": time()
}

// ============================================================================
// TRIT HELPERS
// ============================================================================

fn shield_label(s) {
    if3 s == 1 {
        return "CLOAKED"
    }
    if3 s == 0 {
        return "DEFLECTING"
    }
    if3 s == -1 {
        return "EXPOSED"
    }
    return "UNKNOWN"
}

fn trit_char(t) {
    if3 t == 1 {
        return "1"
    }
    if3 t == 0 {
        return "0"
    }
    return "T"
}

// ============================================================================
// IDENTITY ROTATION
// ============================================================================

fn rotate_identity() {
    let ts = str(time()) + str(_spin_count)
    _current_phantom = {
        "ip": generate_phantom_ip(),
        "mac": generate_phantom_mac(),
        "gateway": generate_phantom_gateway(),
        "fingerprint": fingerprint_hash(ts),
        "rotated_at": time()
    }
    _last_rotation_time = time()
    return _current_phantom
}

// ============================================================================
// LAZY SPIN -- check if rotation is due (replaces background thread)
// NovaLang has no threading.Thread; instead we check on every
// /health or /shield/status call whether enough time has passed.
// ============================================================================

fn lazy_spin() {
    let now = time()
    let elapsed = now - _last_rotation_time
    let rotation_interval = CLOAK_ROTATION * SPIN_INTERVAL

    // Rotate phantom identity if enough time has passed
    if3 elapsed >= rotation_interval {
        rotate_identity()
        _spin_count = _spin_count + 1
    }

    // Recalculate shield state based on recent threats
    let recent_threats = 0
    let i = 0
    while3 i < len(_threat_log) {
        let entry = _threat_log[i]
        let t = dict_get(entry, "time") ?? 0
        let age = now - t
        if3 age < 60 {
            recent_threats = recent_threats + 1
        }
        i = i + 1
    }

    let prev_state = _shield_state
    if3 recent_threats >= LOCKDOWN_THRESHOLD {
        _shield_state = EXPOSED
    } else {
        if3 recent_threats >= H5 {
            _shield_state = DEFLECTING
        } else { _shield_state = CLOAKED
        }
    }

    // Notify triad on state transitions
    if3 _shield_state != prev_state {
        let from_label = shield_label(prev_state)
        let to_label = shield_label(_shield_state)
        notify_triad("state_changed", {
            "from": from_label,
            "to": to_label,
            "recent_threats": recent_threats
        })
    }

    if3 _shield_state == EXPOSED {
        notify_triad("emergency", {
            "type": "shield_exposed",
            "threats": recent_threats,
            "threshold": LOCKDOWN_THRESHOLD
        })
    }

    // Clean stale connection monitor entries (older than 5 min)
    let stale_ips = []
    let keys_raw = keys(_connection_monitor)
    let k = 0
    while3 k < len(keys_raw) {
        let ip_key = keys_raw[k]
        let timestamps = dict_get(_connection_monitor, ip_key) ?? []
        let all_stale = true
        let j = 0
        while3 j < len(timestamps) {
            let ts_val = timestamps[j]
            if3 now - ts_val < 300 {
                all_stale = false
            }
            j = j + 1
        }
        if3 all_stale == true {
            stale_ips = append(stale_ips, ip_key)
        }
        k = k + 1
    }
    let s = 0
    while3 s < len(stale_ips) {
        _connection_monitor = dict_remove(_connection_monitor, stale_ips[s])
        s = s + 1
    }

    return _shield_state
}

// ============================================================================
// CLOAK STATUS
// ============================================================================

fn get_cloak_status() {
    let layer_keys = keys(_shield_layers)
    let active = 0
    let total = len(layer_keys)
    let i = 0
    while3 i < total {
        let k = layer_keys[i]
        let v = dict_get(_shield_layers, k) ?? false
        if3 v == true {
            active = active + 1
        }
        i = i + 1
    }
    let strength = 0
    if3 total > 0 {
        strength = round(active / total, 2)
    }
    let invisible = false
    if3 active == total {
        invisible = true
    }
    return {
        "layers_active": active,
        "layers_total": total,
        "cloak_strength": strength,
        "layers": _shield_layers,
        "phantom_identity": _current_phantom,
        "invisible": invisible
    }
}

// ============================================================================
// TRIAD COMMUNICATION -- fire-and-forget to TSpin + TScale + THunter
// ============================================================================

fn notify_triad(event_type, data) {
    let payload = json_encode({
        "source": SERVICE,
        "port": PORT,
        "event": event_type,
        "data": data,
        "time": time(),
        "spin": _spin_count
    })

    // Fire-and-forget to each peer via http_post
    let peer_keys = keys(TRIAD_PEERS)
    let i = 0
    while3 i < len(peer_keys) {
        let name = peer_keys[i]
        let url = dict_get(TRIAD_PEERS, name) ?? ""
        let target = url + "/triad/event"
        // Wrap in try-like approach: nova_run with curl to avoid blocking
        let curl_cmd = "curl -s -X POST -H \"Content-Type: application/json\" -d " + "'" + payload + "'" + " " + target + " --connect-timeout 1 --max-time 2 2>&1"
        nova_run(curl_cmd)
        i = i + 1
    }

    // Log outbound
    let entry = {"event": event_type, "data": data, "time": time()}
    _triad_log = append(_triad_log, entry)
    if3 len(_triad_log) > 50 {
        _triad_log = slice(_triad_log, len(_triad_log) - 50, len(_triad_log))
    }
}

fn get_triad_status() {
    let peers = {}
    let peer_keys = keys(TRIAD_PEERS)
    let i = 0
    while3 i < len(peer_keys) {
        let name = peer_keys[i]
        let url = dict_get(TRIAD_PEERS, name) ?? ""
        let health_url = url + "/health"
        let raw = ""
        let cmd = "curl -s " + health_url + " --connect-timeout 1 --max-time 2 2>&1"
        raw = nova_run(cmd)
        let trimmed = trim(raw)
        if3 len(trimmed) > 2 {
            let parsed = json_decode(trimmed)
            if3 parsed != null {
                peers = dict_set(peers, name, parsed)
            } else {
                peers = dict_set(peers, name, {"ok": false, "error": "parse_failed"})
            }
        } else {
            peers = dict_set(peers, name, {"ok": false, "error": "unreachable"})
        }
        i = i + 1
    }
    return peers
}

// ============================================================================
// THREAT ANALYSIS -- analyze incoming connections
// Returns: trit, level, score
// ============================================================================

fn log_threat(ip, port, level, score) {
    let phantom_ip = dict_get(_current_phantom, "ip") ?? "unknown"
    let entry = {
        "ip": ip,
        "port": port,
        "level": level,
        "score": score,
        "time": time(),
        "phantom_at_time": phantom_ip,
        "spin": _spin_count
    }
    _threat_log = append(_threat_log, entry)
    if3 len(_threat_log) > MAX_THREAT_LOG {
        _threat_log = slice(_threat_log, len(_threat_log) - MAX_THREAT_LOG, len(_threat_log))
    }

    // Track per-IP
    let existing = dict_get(_blocked_ips, ip)
    if3 existing == null {
        _blocked_ips = dict_set(_blocked_ips, ip, {
            "count": 1,
            "first_seen": time(),
            "last_seen": time()
        })
    } else {
        let old_count = dict_get(existing, "count") ?? 0
        let first = dict_get(existing, "first_seen") ?? time()
        _blocked_ips = dict_set(_blocked_ips, ip, {
            "count": old_count + 1,
            "first_seen": first,
            "last_seen": time()
        })
    }
}

fn analyze_connection(ip, port, payload_size) {
    let threat_score = 0

    // Check if IP is already blocked
    let blocked_entry = dict_get(_blocked_ips, ip)
    if3 blocked_entry != null {
        let bc = dict_get(blocked_entry, "count") ?? 0
        if3 bc >= LOCKDOWN_THRESHOLD {
            return {"trit": T_FALSE, "level": "blocked_ip", "score": bc}
        }
    }

    // Rate limiting: count connections from same IP in last 60s
    let now = time()
    let existing_ts = dict_get(_connection_monitor, ip) ?? []
    existing_ts = append(existing_ts, now)

    // Filter to last 60 seconds
    let recent = []
    let i = 0
    while3 i < len(existing_ts) {
        let ts = existing_ts[i]
        if3 now - ts < 60 {
            recent = append(recent, ts)
        }
        i = i + 1
    }
    _connection_monitor = dict_set(_connection_monitor, ip, recent)
    let rate = len(recent)

    if3 rate > RATE_LIMIT_HIGH {
        threat_score = threat_score + 3
    } else {
        if3 rate > RATE_LIMIT_MED {
            threat_score = threat_score + 1
        }
    }

    // Large payload = potential buffer overflow
    if3 payload_size > PAYLOAD_THRESHOLD {
        threat_score = threat_score + 2
    }

    // Port scan detection: connection to unusual port
    if3 port > 0 {
        if3 port != 80 {
            if3 port != 443 {
                if3 port != 8080 {
                    if3 port != 8888 {
                        if3 port != 9999 {
                            threat_score = threat_score + 1
                        }
                    }
                }
            }
        }
    }

    // Classify
    if3 threat_score >= 3 {
        _threats_detected = _threats_detected + 1
        log_threat(ip, port, "hostile", threat_score)
        notify_triad("threat_detected", {
            "ip": ip, "port": port, "level": "hostile",
            "score": threat_score
        })
        return {"trit": T_FALSE, "level": "hostile", "score": threat_score}
    }
    if3 threat_score >= 1 {
        _threats_detected = _threats_detected + 1
        log_threat(ip, port, "suspicious", threat_score)
        return {"trit": T_MAYBE, "level": "suspicious", "score": threat_score}
    }
    return {"trit": T_TRUE, "level": "safe", "score": threat_score}
}

// ============================================================================
// REFLECTION SHIELD -- 100x bounce-back
// ============================================================================

fn reflect_attack(ip, payload_size) {
    let reflected_size = payload_size * REFLECTION_MULTIPLIER
    _threats_reflected = _threats_reflected + 1
    _attacks_blocked = _attacks_blocked + 1

    // Block the IP immediately
    let existing = dict_get(_blocked_ips, ip)
    if3 existing == null {
        _blocked_ips = dict_set(_blocked_ips, ip, {
            "count": LOCKDOWN_THRESHOLD,
            "first_seen": time(),
            "last_seen": time()
        })
    } else {
        let first = dict_get(existing, "first_seen") ?? time()
        _blocked_ips = dict_set(_blocked_ips, ip, {
            "count": LOCKDOWN_THRESHOLD,
            "first_seen": first,
            "last_seen": time()
        })
    }

    // Log the reflection
    let phantom_ip = dict_get(_current_phantom, "ip") ?? "unknown"
    let rlog_entry = {
        "ip": ip,
        "original_bytes": payload_size,
        "reflected_bytes": reflected_size,
        "multiplier": REFLECTION_MULTIPLIER,
        "time": time(),
        "phantom_used": phantom_ip,
        "result": "overload_sent"
    }
    _reflection_log = append(_reflection_log, rlog_entry)
    if3 len(_reflection_log) > MAX_THREAT_LOG {
        _reflection_log = slice(_reflection_log, len(_reflection_log) - MAX_THREAT_LOG, len(_reflection_log))
    }

    // Notify triad
    notify_triad("attack_reflected", {
        "ip": ip, "original_bytes": payload_size,
        "reflected_bytes": reflected_size,
        "multiplier": REFLECTION_MULTIPLIER
    })

    let result_msg = "sent " + str(reflected_size) + " bytes back (" + str(REFLECTION_MULTIPLIER) + "x amplification)"

    return {
        "ok": true, "trit": T_TRUE,
        "action": "reflected",
        "original_bytes": payload_size,
        "reflected_bytes": reflected_size,
        "multiplier": REFLECTION_MULTIPLIER,
        "target_ip": ip,
        "result": result_msg
    }
}

// ============================================================================
// QUANTUM NOISE -- inject entropy to defeat pattern analysis (native NovaLang)
// ============================================================================

fn generate_quantum_noise() {
    let size = H7 * H13
    // Generate ternary noise trits natively
    let packed = ""
    let i = 0
    while3 i < size {
        let trit = random_int(0, 2)
        packed = packed + str(trit)
        i = i + 1
    }
    let entropy_hash = slice(hash(packed, "sha256"), 0, 13)
    return {
        "noise_trits": size,
        "entropy_hash": entropy_hash,
        "packed_size": len(packed),
        "pattern_mask": true
    }
}

// ============================================================================
// GET HANDLERS
// ============================================================================

fn handle_health() {
    // Lazy spin: check if rotation is due
    lazy_spin()

    let uptime = round(time() - _t0, 0)
    let cloak_active = true
    let layer_keys = keys(_shield_layers)
    let lk = 0
    while3 lk < len(layer_keys) {
        let k = layer_keys[lk]
        let v = dict_get(_shield_layers, k) ?? false
        if3 v == false {
            cloak_active = false
        }
        lk = lk + 1
    }
    let phantom_ip = dict_get(_current_phantom, "ip") ?? "unknown"
    let sl = shield_label(_shield_state)
    let tc = trit_char(_shield_state)

    let resp = ns_health_dict(SERVICE, VERSION, PORT, {})
    resp = dict_set(resp, "shield_state", _shield_state)
    resp = dict_set(resp, "shield_label", sl)
    resp = dict_set(resp, "self_trit", _shield_state)
    resp = dict_set(resp, "char", tc)
    resp = dict_set(resp, "spins", _spin_count)
    resp = dict_set(resp, "threats_detected", _threats_detected)
    resp = dict_set(resp, "threats_reflected", _threats_reflected)
    resp = dict_set(resp, "attacks_blocked", _attacks_blocked)
    resp = dict_set(resp, "phantom_ip", phantom_ip)
    resp = dict_set(resp, "cloak_active", cloak_active)
    resp = dict_set(resp, "uptime", int(uptime))
    return resp
}

fn handle_shield_status() {
    // Lazy spin: check if rotation is due
    lazy_spin()

    let cloak = get_cloak_status()
    let sl = shield_label(_shield_state)
    let blocked_count = len(keys(_blocked_ips))
    let monitor_count = len(keys(_connection_monitor))

    return {
        "shield_state": sl,
        "trit": _shield_state,
        "spins": _spin_count,
        "threats_detected": _threats_detected,
        "threats_reflected": _threats_reflected,
        "attacks_blocked": _attacks_blocked,
        "blocked_ips": blocked_count,
        "active_monitors": monitor_count,
        "cloak": cloak,
        "reflection_multiplier": REFLECTION_MULTIPLIER
    }
}

fn handle_shield_identity() {
    let age = round(time() - (dict_get(_current_phantom, "rotated_at") ?? time()), 0)
    let rotation_interval = CLOAK_ROTATION * SPIN_INTERVAL
    let next_in = rotation_interval - int(age)
    if3 next_in < 0 {
        next_in = 0
    }
    let total_rotations = 0
    if3 CLOAK_ROTATION > 0 {
        total_rotations = int(_spin_count / CLOAK_ROTATION)
    }
    return {
        "ok": true,
        "trit": _shield_state,
        "phantom": _current_phantom,
        "age_seconds": int(age),
        "next_rotation_in": next_in,
        "total_rotations": total_rotations
    }
}

fn handle_shield_threats() {
    // Return last 50 threats and blocked IPs with count >= H5
    let log_end = len(_threat_log)
    let log_start = log_end - 50
    if3 log_start < 0 {
        log_start = 0
    }
    let recent = slice(_threat_log, log_start, log_end)

    // Filter blocked IPs with count >= H5
    let significant_blocked = {}
    let bkeys = keys(_blocked_ips)
    let i = 0
    while3 i < len(bkeys) {
        let bk = bkeys[i]
        let bv = dict_get(_blocked_ips, bk) ?? {}
        let cnt = dict_get(bv, "count") ?? 0
        if3 cnt >= H5 {
            significant_blocked = dict_set(significant_blocked, bk, bv)
        }
        i = i + 1
    }

    return {
        "ok": true,
        "total_detected": _threats_detected,
        "total_reflected": _threats_reflected,
        "blocked_ips": significant_blocked,
        "recent_threats": recent
    }
}

fn handle_shield_reflections() {
    let log_end = len(_reflection_log)
    let log_start = log_end - 50
    if3 log_start < 0 {
        log_start = 0
    }
    let recent = slice(_reflection_log, log_start, log_end)

    return {
        "ok": true,
        "total_reflected": _threats_reflected,
        "multiplier": REFLECTION_MULTIPLIER,
        "recent": recent
    }
}

fn handle_shield_layers() {
    let layer_keys = keys(_shield_layers)
    let active = 0
    let total = len(layer_keys)
    let i = 0
    while3 i < total {
        let k = layer_keys[i]
        let v = dict_get(_shield_layers, k) ?? false
        if3 v == true {
            active = active + 1
        }
        i = i + 1
    }
    return {
        "ok": true,
        "layers": _shield_layers,
        "active": active,
        "total": total
    }
}

fn handle_shield_noise() {
    let noise = generate_quantum_noise()
    return {"ok": true, "trit": T_TRUE, "noise": noise}
}

fn handle_triad() {
    let peers = get_triad_status()

    let ev_end = len(_triad_events)
    let ev_start = ev_end - 20
    if3 ev_start < 0 {
        ev_start = 0
    }
    let recent_inbound = slice(_triad_events, ev_start, ev_end)

    let sent_end = len(_triad_log)
    let sent_start = sent_end - 20
    if3 sent_start < 0 {
        sent_start = 0
    }
    let recent_outbound = slice(_triad_log, sent_start, sent_end)

    // Check if all peers are healthy
    let peer_keys = keys(peers)
    let all_healthy = true
    let pk = 0
    while3 pk < len(peer_keys) {
        let pname = peer_keys[pk]
        let pdata = dict_get(peers, pname) ?? {}
        let pok = dict_get(pdata, "ok") ?? false
        if3 pok == false {
            all_healthy = false
        }
        pk = pk + 1
    }

    let sl = shield_label(_shield_state)

    return {
        "ok": true,
        "service": SERVICE,
        "self_state": sl,
        "self_trit": _shield_state,
        "peers": peers,
        "events_received": len(_triad_events),
        "events_sent": len(_triad_log),
        "recent_inbound": recent_inbound,
        "recent_outbound": recent_outbound,
        "triad_healthy": all_healthy
    }
}

// ============================================================================
// POST HANDLERS
// ============================================================================

fn handle_shield_analyze(body) {
    let ip = dict_get(body, "ip") ?? "0.0.0.0"
    let port_num = dict_get(body, "port") ?? 0
    let payload = dict_get(body, "payload_size") ?? 0

    let result = analyze_connection(ip, port_num, payload)
    let trit = dict_get(result, "trit") ?? 0
    let level = dict_get(result, "level") ?? "unknown"
    let score = dict_get(result, "score") ?? 0

    let action = "allowed"
    if3 trit == T_FALSE {
        action = "blocked"
    }
    if3 trit == T_MAYBE {
        action = "monitored"
    }

    return {
        "ok": true,
        "trit": trit,
        "level": level,
        "score": score,
        "ip": ip,
        "action": action
    }
}

fn handle_shield_reflect(body) {
    let ip = dict_get(body, "ip") ?? ""
    let payload = dict_get(body, "payload_size") ?? 1024
    if3 ip == "" {
        return {"ok": false, "trit": T_FALSE, "error": "ip required"}
    }
    let result = reflect_attack(ip, payload)
    return result
}

fn handle_shield_block(body) {
    let ip = dict_get(body, "ip") ?? ""
    if3 ip == "" {
        return {"ok": false, "trit": T_FALSE, "error": "ip required"}
    }
    let now = time()
    _blocked_ips = dict_set(_blocked_ips, ip, {
        "count": LOCKDOWN_THRESHOLD + 1,
        "first_seen": now,
        "last_seen": now
    })
    // PASSIVE: recorded in internal dict only -- does NOT touch OS firewall.
    return {
        "ok": true,
        "trit": T_TRUE,
        "blocked": ip,
        "passive": true,
        "note": "recorded in TShield advisory list; not applied to OS firewall"
    }
}

fn handle_shield_unblock(body) {
    let ip = dict_get(body, "ip") ?? ""
    let existed = dict_get(_blocked_ips, ip)
    let was_blocked = false
    if3 existed != null {
        _blocked_ips = dict_remove(_blocked_ips, ip)
        was_blocked = true
    }
    let trit = T_MAYBE
    if3 was_blocked == true {
        trit = T_TRUE
    }
    return {
        "ok": true,
        "trit": trit,
        "unblocked": ip,
        "was_blocked": was_blocked
    }
}

fn handle_shield_rotate(body) {
    let identity = rotate_identity()
    return {
        "ok": true,
        "trit": T_TRUE,
        "new_phantom": identity,
        "msg": "identity rotated"
    }
}

fn handle_shield_layer(body) {
    let layer = dict_get(body, "layer") ?? ""
    let enabled = dict_get(body, "enabled") ?? true

    let layer_keys = keys(_shield_layers)
    let found = false
    let i = 0
    while3 i < len(layer_keys) {
        if3 layer_keys[i] == layer {
            found = true
        }
        i = i + 1
    }

    if3 found == true {
        _shield_layers = dict_set(_shield_layers, layer, enabled)
        return {
            "ok": true,
            "trit": T_TRUE,
            "layer": layer,
            "enabled": enabled,
            "layers": _shield_layers
        }
    }
    return {
        "ok": false,
        "trit": T_FALSE,
        "error": "unknown layer: " + layer,
        "valid_layers": layer_keys
    }
}

fn handle_shield_lockdown(body) {
    // Emergency lockdown -- all layers on, rotate identity, EXPOSED state
    _shield_state = EXPOSED
    let layer_keys = keys(_shield_layers)
    let i = 0
    while3 i < len(layer_keys) {
        _shield_layers = dict_set(_shield_layers, layer_keys[i], true)
        i = i + 1
    }
    rotate_identity()
    return {
        "ok": true,
        "trit": T_FALSE,
        "state": "LOCKDOWN",
        "passive": true,
        "msg": "all shield-layer flags set true + identity rotated (advisory; TShield does not intercept traffic)"
    }
}

fn handle_triad_event(body) {
    let event = dict_get(body, "event") ?? ""
    let source = dict_get(body, "source") ?? "?"

    // Store inbound event
    _triad_events = append(_triad_events, body)
    if3 len(_triad_events) > 100 {
        _triad_events = slice(_triad_events, len(_triad_events) - 100, len(_triad_events))
    }

    let response = {"ok": true, "trit": T_TRUE, "received": event}

    // Handle specific triad events
    if3 event == "zombie_killed" {
        let data = dict_get(body, "data") ?? {}
        let emergency = dict_get(data, "emergency") ?? false
        if3 emergency == true {
            // Emergency kill = possible resource attack, rotate identity
            rotate_identity()
            response = dict_set(response, "identity_rotated", true)
        }
        let sl = shield_label(_shield_state)
        response = dict_set(response, "shield_state", sl)
        return response
    }

    if3 event == "conflict_resolved" {
        // TScale resolved port conflict -- generate noise to mask
        let qn_enabled = dict_get(_shield_layers, "quantum_noise") ?? false
        if3 qn_enabled == true {
            generate_quantum_noise()
        }
        response = dict_set(response, "noise_injected", true)
        return response
    }

    if3 event == "emergency" {
        // Emergency from peer -- go to lockdown mode
        let layer_keys = keys(_shield_layers)
        let i = 0
        while3 i < len(layer_keys) {
            _shield_layers = dict_set(_shield_layers, layer_keys[i], true)
            i = i + 1
        }
        rotate_identity()
        response = dict_set(response, "lockdown_engaged", true)
        response = dict_set(response, "all_layers_active", true)
        return response
    }

    // Generic event -- just acknowledge
    return response
}

