// Fire webhook notification to all registered URLs
}
fn fire_webhooks(pipeline_name, trit, stages, total_ms) {
    if3 len(_webhooks) == 0 {
        return 0
    }
    let payload = json_encode({
        "event": "pipeline_complete",
        "pipeline": pipeline_name,
        "trit": trit,
        "trit_label": "pass",
        "stages": stages,
        "total_ms": total_ms,
        "timestamp": time(),
        "service": SERVICE_NAME
    })
    if3 trit == 0 {
        // update label — can't do it inline due to NovaLang limitation
    }
    if3 trit == -1 {
        // same
    }
    let sent = 0
    for wh in _webhooks {
        let url = dict_get(wh, "url", "")
        if3 url != "" {
            try3 {
                http_post(url, payload)
                let sent = sent + 1
                dict_set(_webhook_stats, "sent", dict_get(_webhook_stats, "sent", 0) + 1)
            } fail {
                dict_set(_webhook_stats, "failed", dict_get(_webhook_stats, "failed", 0) + 1)
                dict_set(_webhook_stats, "last_error", str(_error))
            }
        }
    }
    return sent
}

// POST /tci/webhooks/register {url, label?}
fn handle_webhook_register(body) {
    let url = dict_get(body, "url", "")
    if3 url == "" {
        return {"ok": false, "error": "url required", "trit": -1}
    }

    // Check for duplicates
    for wh in _webhooks {
        if3 dict_get(wh, "url", "") == url {
            return {"ok": false, "error": "webhook already registered", "trit": 0}
        }
    }

    if3 len(_webhooks) >= _webhook_max {
        return {"ok": false, "error": "max webhooks reached (13)", "trit": -1}
    }

    let label = dict_get(body, "label", "webhook-" + str(len(_webhooks) + 1))
    append(_webhooks, {"url": url, "label": label, "registered_at": time()})
    return {"ok": true, "label": label, "total_webhooks": len(_webhooks), "trit": 1}
}

// POST /tci/webhooks/remove {url}
fn handle_webhook_remove(body) {
    let url = dict_get(body, "url", "")
    let new_list = []
    let found = false
    for wh in _webhooks {
        if3 dict_get(wh, "url", "") == url {
            let found = true
        } else {
            append(new_list, wh)
        }
    }
    let _webhooks = new_list
    if3 found == true {
        return {"ok": true, "removed": url, "remaining": len(_webhooks), "trit": 1}
    } else {
        return {"ok": false, "error": "webhook not found", "trit": -1}
    }
}

// GET /tci/webhooks — List registered webhooks + stats
fn handle_webhook_list(req) {
    return {
        "ok": true,
        "webhooks": _webhooks,
        "total": len(_webhooks),
        "max": _webhook_max,
        "stats": _webhook_stats,
        "trit": 1
    }
}

