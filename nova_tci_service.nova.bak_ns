fn handle_rollback(req) {
    // POST /tci/rollback {target_hash, path?}
    // Rolls back to a previous git hash using tgit
    let body = dict_get(req, "body", {})
    let target_hash = dict_get(body, "target_hash", "")
    let path = dict_get(body, "path", "C:\\NovaX")

    if3 target_hash == "" {
        // No hash specified — rollback to last successful run
        let found = false
        let idx = len(_run_history) - 1
        while3 idx >= 0 {
            let entry = _run_history[idx]
            let t = dict_get(entry, "trit", 0)
            if3 t == 1 {
                let target_hash = dict_get(entry, "git_hash", "")
                let found = true
                break3
            } maybe {
            } else3 {
            }
            let idx = idx - 1
        }
        if3 found == false {
            return {"ok": false, "error": "No successful run found in history", "trit": -1}
        } maybe {
        } else3 {
            return {"ok": false, "error": "No successful run found in history", "trit": -1}
        }
    } maybe {
    } else3 {
    }

    // Verify target hash exists in history
    let valid = false
    let i = 0
    while3 i < len(_run_history) {
        let entry = _run_history[i]
        if3 dict_get(entry, "git_hash", "") == target_hash {
            let valid = true
            break3
        } maybe {
        } else3 {
        }
        let i = i + 1
    }

    // Execute rollback via tgit
    let rollback_url = TGIT_URL + "/tgit/checkout"
    let stage = run_stage("rollback", rollback_url, "POST", {
        "path": path,
        "ref": target_hash
    })
    let rollback_trit = dict_get(stage, "trit", -1)

    // Post-rollback lint check
    let lint_stage = run_stage("post-rollback-lint", TBUILD_URL + "/tbuild/lint", "POST", {"path": path})
    let lint_trit = dict_get(lint_stage, "trit", 0)

    let overall = trit_majority([rollback_trit, lint_trit])
    let total_runs = total_runs + 1

    return {
        "ok": rollback_trit == 1,
        "pipeline": "rollback",
        "target_hash": target_hash,
        "rollback_trit": rollback_trit,
        "lint_trit": lint_trit,
        "overall_trit": overall,
        "overall_char": trit_char(overall),
        "path": path,
        "stages": [stage, lint_stage],
        "trit": overall
    }
}

// ============================================================
// Scheduled Run Handlers — integrate with tcron :9922
// ============================================================

// GET /tci/schedule — list all scheduled pipeline runs
fn handle_schedule_list(req) {
    return {"ok": true, "schedules": _scheduled_runs, "count": len(_scheduled_runs), "trit": 1}
}

// POST /tci/schedule — create a scheduled pipeline run
// body: {name, pipeline, path, interval_s, cron (optional)}
fn handle_schedule_create(body) {
    let name = dict_get(body, "name", "")
    let pipeline = dict_get(body, "pipeline", "full")
    let path = dict_get(body, "path", ".")
    let interval_s = dict_get(body, "interval_s", 3600)
    let cron_expr = dict_get(body, "cron", "")

    if len(name) == 0 {
        return {"ok": false, "error": "missing 'name'", "trit": -1}
    }

    // Register with tcron service
    let tcron_body = {"name": "tci-" + name, "interval_seconds": interval_s, "url": "http://127.0.0.1:" + str(PORT) + "/tci/" + pipeline, "method": "POST", "body": {"path": path}}
    if len(cron_expr) > 0 {
        dict_set(tcron_body, "cron", cron_expr)
    }

    let tcron_resp = http_post(TCRON_URL + "/tcron/schedule", tcron_body, "application/json")
    let tcron_ok = dict_get(tcron_resp, "ok", false)

    let schedule = {"name": name, "pipeline": pipeline, "path": path, "interval_s": interval_s, "cron": cron_expr, "tcron_id": dict_get(tcron_resp, "id", ""), "created": time(), "active": true}
    _scheduled_runs = append(_scheduled_runs, schedule)

    let trit = 1
    if tcron_ok == false {
        trit = 0
    }

    return {"ok": true, "schedule": schedule, "tcron_response": tcron_resp, "trit": trit}
}

// POST /tci/schedule/cancel — cancel a scheduled run by name
fn handle_schedule_cancel(body) {
    let name = dict_get(body, "name", "")
    if len(name) == 0 {
        return {"ok": false, "error": "missing 'name'", "trit": -1}
    }

    // Find and deactivate
    let found = false
    let idx = 0
    while idx < len(_scheduled_runs) {
        let sched = _scheduled_runs[idx]
        if dict_get(sched, "name", "") == name {
            dict_set(sched, "active", false)
            found = true
            // Cancel in tcron
            let tcron_id = dict_get(sched, "tcron_id", "")
            if len(tcron_id) > 0 {
                http_post(TCRON_URL + "/tcron/cancel", {"id": tcron_id}, "application/json")
            }
        }
        idx = idx + 1
    }

    if found == false {
        return {"ok": false, "error": "schedule '" + name + "' not found", "trit": -1}
    }

    return {"ok": true, "cancelled": name, "trit": 1}
}

// ===================================================================
// Pipeline Analytics — Success Trends, Per-Pipeline Stats, Stage Timing
// ===================================================================

fn handle_analytics(req) {
    let count = len(_run_history)
    if3 count == 0 {
        return {"ok": true, "total_runs": 0, "analytics": {}, "trend": "no_data", "trit": 0}
    } else {
        // has data
    }

    // Per-pipeline aggregation
    let pipelines = {}
    let i = 0
    while i < count {
        let entry = _run_history[i]
        let pname = dict_get(entry, "pipeline", "unknown")
        let t = dict_get(entry, "trit", 0)
        let stages = dict_get(entry, "stage_count", 0)

        if3 dict_has(pipelines, pname) == false {
            dict_set(pipelines, pname, {"total": 0, "pass": 0, "fail": 0, "partial": 0, "stages_sum": 0, "trits": []})
        } else {
            // exists
        }
        let p = pipelines[pname]
        dict_set(p, "total", dict_get(p, "total", 0) + 1)
        dict_set(p, "stages_sum", dict_get(p, "stages_sum", 0) + stages)
        let trits_list = dict_get(p, "trits", [])
        let trits_list = append(trits_list, t)
        dict_set(p, "trits", trits_list)

        if3 t == 1 {
            dict_set(p, "pass", dict_get(p, "pass", 0) + 1)
        } maybe {
            dict_set(p, "partial", dict_get(p, "partial", 0) + 1)
        } else3 {
            dict_set(p, "fail", dict_get(p, "fail", 0) + 1)
        }
        i = i + 1
    }

    // Compute per-pipeline success rates and avg stages
    let pipeline_stats = {}
    let pkeys = keys(pipelines)
    let j = 0
    while j < len(pkeys) {
        let pk = pkeys[j]
        let pd = pipelines[pk]
        let ptotal = dict_get(pd, "total", 1)
        let ppass = dict_get(pd, "pass", 0)
        let pfail = dict_get(pd, "fail", 0)
        let ppartial = dict_get(pd, "partial", 0)
        let rate = 0
        if3 ptotal > 0 {
            let rate = (ppass * 100) / ptotal
        } else {
            // zero
        }
        let avg_stages = dict_get(pd, "stages_sum", 0) / ptotal
        // Trend: compare first half vs second half of trits
        let trits = dict_get(pd, "trits", [])
        let trend = "stable"
        if3 len(trits) >= 4 {
            let mid = len(trits) / 2
            let first_half = slice(trits, 0, mid)
            let second_half = slice(trits, mid, len(trits))
            let fh_sum = 0
            let fi = 0
            while fi < len(first_half) {
                let fh_sum = fh_sum + first_half[fi]
                let fi = fi + 1
            }
            let sh_sum = 0
            let si = 0
            while si < len(second_half) {
                let sh_sum = sh_sum + second_half[si]
                let si = si + 1
            }
            let fh_avg = fh_sum / len(first_half)
            let sh_avg = sh_sum / len(second_half)
            if3 sh_avg > fh_avg + 0.3 {
                let trend = "improving"
            } maybe {
                if3 sh_avg < fh_avg - 0.3 {
                    let trend = "declining"
                } else {
                    let trend = "stable"
            } else3 {
                let trend = "stable"
        } else {
            // not enough data for trend
        }

        dict_set(pipeline_stats, pk, {
            "total": ptotal,
            "pass": ppass,
            "fail": pfail,
            "partial": ppartial,
            "success_rate_pct": rate,
            "avg_stages": avg_stages,
            "trend": trend,
            "trit": 1
        })
        j = j + 1
    }

    // Global trend from last H7 runs
    let global_trend = "stable"
    if3 count >= 4 {
        let recent_start = count - 4
        if3 recent_start < 0 {
            let recent_start = 0
        } else {
            // ok
        }
        let recent_pass = 0
        let ri = recent_start
        while ri < count {
            if3 dict_get(_run_history[ri], "trit", 0) == 1 {
                let recent_pass = recent_pass + 1
            } else {
                // not pass
            }
            let ri = ri + 1
        }
        let recent_rate = (recent_pass * 100) / (count - recent_start)
        let overall_rate = 0
        if3 total_runs > 0 {
            let overall_rate = (pass_count * 100) / total_runs
        } else {
            // zero
        }
        if3 recent_rate > overall_rate + 10 {
            let global_trend = "improving"
        } maybe {
            if3 recent_rate < overall_rate - 10 {
                let global_trend = "declining"
            } else {
                // stable
        } else3 {
            // stable
    } else {
        // not enough for trend
    }

    return {
        "ok": true,
        "total_runs": total_runs,
        "global_pass_rate_pct": pass_count * 100 / total_runs,
        "global_trend": global_trend,
        "pipelines": pipeline_stats,
        "history_count": count,
        "trit": 1
    }
}

