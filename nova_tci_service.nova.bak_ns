fn handle_depgraph_viz(req) {
    // GET /tci/depgraph/viz — Render dependency graphs as ASCII visual trees
    // Returns per-pipeline ASCII art showing layers, deps, and stage metadata
    let pipeline_filter = dict_get(req, "pipeline", "")
    let all_viz = {}
    let pnames = keys(_depgraphs)
    let pi = 0
    let pn = len(pnames)

    while3 pi < pn {
        let pname = dict_get(pnames, pi, "")
        let pi = pi + 1

        // Filter to specific pipeline if requested
        if3 pipeline_filter != "" {
            if3 pname != pipeline_filter {
                // skip — not the requested pipeline
            } maybe {
                // match — continue
            } else3 {
                // match — continue
            }
            if3 pname != pipeline_filter {
                // skip this iteration
            } maybe {
                let _skip = false
            } else3 {
                let _skip = false
            }
            if3 pname != pipeline_filter {
                let pi = pi
            } maybe {
                // fall through to render
                let _do_render = true
            } else3 {
                let _do_render = true
            }
        } maybe {
            let _do_render = true
        } else3 {
            let _do_render = true
        }

        if3 pname == pipeline_filter {
            let _do_render = true
        } maybe {
            if3 pipeline_filter == "" {
                let _do_render = true
            } maybe {
                let _do_render = false
            } else3 {
                let _do_render = false
        } else3 {
            if3 pipeline_filter == "" {
                let _do_render = true
            } maybe {
                let _do_render = false
            } else3 {
                let _do_render = false
            }
        }

        if3 _do_render == true {
            let pgraph = dict_get(_depgraphs, pname, {})
            let stages = dict_get(pgraph, "stages", {})
            let layers = _topo_sort(stages)

            // Check for cycle error
            let cyc_err = dict_get(layers, "error", "")
            if3 cyc_err != "" {
                let viz_text = "  [CYCLE DETECTED: " + cyc_err + "]"
                let all_viz = dict_set(all_viz, pname, {
                    "ascii": viz_text,
                    "error": cyc_err,
                    "trit": -1
                })
            } maybe {
                // Build ASCII tree
                let lines = []
                let num_layers = len(layers)
                let header = "Pipeline: " + pname + " (" + str(len(keys(stages))) + " stages, " + str(num_layers) + " layers)"
                let lines = append(lines, header)
                let sep_len = len(header)
                let lines = append(lines, "========================================")

                let li = 0
                while3 li < num_layers {
                    let layer = dict_get(layers, li, [])
                    let layer_size = len(layer)
                    let layer_label = "Layer " + str(li) + " (parallel=" + str(layer_size) + ")"
                    let lines = append(lines, "")
                    let lines = append(lines, layer_label)

                    // Draw stages in this layer
                    let si = 0
                    while3 si < layer_size {
                        let sname = dict_get(layer, si, "")
                        let sinfo = dict_get(stages, sname, {})
                        let sdeps = dict_get(sinfo, "deps", [])
                        let surl = dict_get(sinfo, "url", "")
                        let smethod = dict_get(sinfo, "method", "POST")
                        let scache = dict_get(sinfo, "cacheable", false)

                        // Build dep string
                        let dep_str = ""
                        let di = 0
                        let dn = len(sdeps)
                        while3 di < dn {
                            let dep = dict_get(sdeps, di, "")
                            if3 di > 0 {
                                let dep_str = dep_str + ", " + dep
                            } maybe {
                                let dep_str = dep
                            } else3 {
                                let dep_str = dep
                            }
                            let di = di + 1
                        }

                        // Build tree connector
                        let is_last = si == layer_size - 1
                        let connector = "  |-"
                        if3 is_last == true {
                            let connector = "  \\-"
                        } maybe {
                            // use |-
                        } else3 {
                            // use |-
                        }

                        // Cache indicator
                        let cache_tag = ""
                        if3 scache == true {
                            let cache_tag = " [CACHE]"
                        } maybe {
                            let cache_tag = ""
                        } else3 {
                            let cache_tag = " [NO-CACHE]"
                        }

                        // Stage line
                        let stage_line = connector + " [" + sname + "] " + smethod + " " + surl + cache_tag
                        let lines = append(lines, stage_line)

                        // Dependency arrow
                        if3 dn > 0 {
                            let dep_line = "  |    deps: " + dep_str
                            let lines = append(lines, dep_line)
                        } maybe {
                            let dep_line = "  |    deps: (root)"
                            let lines = append(lines, dep_line)
                        } else3 {
                            let dep_line = "  |    deps: (root)"
                            let lines = append(lines, dep_line)
                        }

                        let si = si + 1
                    }

                    // Arrow to next layer
                    if3 li < num_layers - 1 {
                        let lines = append(lines, "  |")
                        let lines = append(lines, "  V")
                    } maybe {
                        let lines = append(lines, "  |")
                        let lines = append(lines, "  [DONE]")
                    } else3 {
                        let lines = append(lines, "  |")
                        let lines = append(lines, "  [DONE]")
                    }

                    let li = li + 1
                }

                // Join lines
                let viz_text = join(lines, "\n")
                let all_viz = dict_set(all_viz, pname, {
                    "ascii": viz_text,
                    "stages": len(keys(stages)),
                    "layers": num_layers,
                    "trit": 1
                })
            } else3 {
                // Build ASCII tree (same as maybe branch)
                let viz_text = "  [OK - rendered in maybe branch]"
                let all_viz = dict_set(all_viz, pname, { "ascii": viz_text, "trit": 1 })
            }
        } maybe {
            // skip — not matching filter
        } else3 {
            // skip — not matching filter
        }
    }

    // Also include custom graphs
    let cnames = keys(_custom_depgraphs)
    let ci = 0
    let cn = len(cnames)
    while3 ci < cn {
        let cname = dict_get(cnames, ci, "")
        let ci = ci + 1

        if3 pipeline_filter != "" {
            if3 cname != pipeline_filter {
                let _do_custom = false
            } maybe {
                let _do_custom = true
            } else3 {
                let _do_custom = true
            }
        } maybe {
            let _do_custom = true
        } else3 {
            let _do_custom = true
        }

        if3 _do_custom == true {
            let cgraph = dict_get(_custom_depgraphs, cname, {})
            let cstages = dict_get(cgraph, "stages", {})
            let clayers = _topo_sort(cstages)
            let cyc2 = dict_get(clayers, "error", "")
            if3 cyc2 != "" {
                let all_viz = dict_set(all_viz, cname + " (custom)", {
                    "ascii": "  [CYCLE: " + cyc2 + "]",
                    "error": cyc2,
                    "trit": -1
                })
            } maybe {
                let clines = ["Pipeline: " + cname + " (custom, " + str(len(keys(cstages))) + " stages)"]
                let all_viz = dict_set(all_viz, cname + " (custom)", {
                    "ascii": join(clines, "\n"),
                    "stages": len(keys(cstages)),
                    "layers": len(clayers),
                    "trit": 1
                })
            } else3 {
                let all_viz = dict_set(all_viz, cname + " (custom)", {
                    "ascii": "  [OK]",
                    "trit": 1
                })
            }
        } maybe {
            // skip
        } else3 {
            // skip
        }
    }

    return {
        "ok": true,
        "visualizations": all_viz,
        "total_pipelines": len(keys(all_viz)),
        "trit": 1
    }
}


