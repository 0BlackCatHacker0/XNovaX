// ===================================================================
// nova_tci_service.nova ? Ternary CI/CD Pipeline Engine
// Port 9927 | Tier 4 Dev Tool | NovaLang native
// Orchestrates: tgit + tbuild + tprofile + tpipeline
// Returns +1 (pass), 0 (partial), -1 (fail) for each stage
// ===================================================================

let PORT = 9927
let SERVICE_NAME = "nova-tci"
let VERSION = "1.0.0"
let H3 = 3
let H5 = 5
let H7 = 7
let H13 = 13
let BLOCK = 2187

// -- Service URLs --
let TGIT_URL     = "http://127.0.0.1:9913"
let TBUILD_URL   = "http://127.0.0.1:9909"
let TPROFILE_URL = "http://127.0.0.1:9980"
let ORCH_URL     = "http://127.0.0.1:9999"
let TCRON_URL    = "http://127.0.0.1:9922"

// -- Pipeline State --
let pipelines = {}
let pipeline_count = 0
let total_runs = 0
let pass_count = 0
let fail_count = 0
let partial_count = 0
let start_time = time() * 1000

// -- Pipeline Cache --
// Key: "pipeline:stage:git_hash" -> cached stage result
// Invalidates automatically when git hash changes
let _stage_cache = {}
let _cache_hits = 0
let _cache_misses = 0

// -- Pipeline Run History (for rollback) --
// Stores last H13 completed pipeline runs with git hash, trit, and timestamp
let _run_history = []
let _history_max = 13

// -- Scheduled Runs --
// Cron-like scheduled pipeline runs via tcron integration
let _scheduled_runs = []

// -- Webhook Notifications --
// Registered URLs that receive POST with pipeline results
let _webhooks = []
let _webhook_stats = {"sent": 0, "failed": 0, "last_error": ""}
let _webhook_max = 13

// ===================================================================
// Ternary CI Stage Runner
// ===================================================================

fn run_stage(name, url, method, payload) {
    let t0 = time() * 1000
    let result = {}
    let result = dict_set(result, "stage", name)
    let result = dict_set(result, "start_ms", t0)

    try3 {
        let resp = {}
        if3 method == "GET" {
            let raw = http_get(url)
            let resp = raw
        } maybe {
            let resp = {}
        } else3 {
            let resp = {}
        }
        if3 method == "POST" {
            let raw = http_post(url, payload)
            let resp = raw
        } maybe {
            let resp = {}
        } else3 {
            let resp = {}
        }

        let elapsed = time() * 1000 - t0
        let result = dict_set(result, "elapsed_ms", elapsed)
        let result = dict_set(result, "response", resp)

        // Determine trit from response
        let ok = dict_get(resp, "ok", false)
        let trit_val = 0
        if3 ok == true {
            let trit_val = 1
        } maybe {
            let trit_val = 0
        } else3 {
            let trit_val = -1
        }

        // Check for errors
        let err = dict_get(resp, "error", "")
        if3 err != "" {
            let trit_val = -1
        } maybe {
            // keep current
        } else3 {
            // keep current
        }

        let result = dict_set(result, "trit", trit_val)
        let result = dict_set(result, "char", trit_char(trit_val))

    } maybe {
        let elapsed = time() * 1000 - t0
        let result = dict_set(result, "elapsed_ms", elapsed)
        let result = dict_set(result, "trit", 0)
        let result = dict_set(result, "char", "~")
        let result = dict_set(result, "error", "stage returned uncertain")
    } fail {
        let elapsed = time() * 1000 - t0
        let result = dict_set(result, "elapsed_ms", elapsed)
        let result = dict_set(result, "trit", -1)
        let result = dict_set(result, "char", "-")
        let result = dict_set(result, "error", "stage failed")
    }

    return result
}

// ===================================================================
// Pipeline Cache: skip unchanged stages on re-run
// ===================================================================

fn get_git_hash(path) {
    // Get current HEAD hash from tgit for cache key
    try3 {
        let resp = http_post(TGIT_URL + "/tgit/log", { "path": path, "count": 1 })
        let ok = dict_get(resp, "ok", false)
        if3 ok == true {
            let commits = dict_get(resp, "commits", [])
            if3 len(commits) > 0 {
                return dict_get(commits[0], "hash", "unknown")
            } maybe {
                return "unknown"
            } else3 {
                return "unknown"
            }
        } maybe {
            return "unknown"
        } else3 {
            return "unknown"
    } fail {
        return "unknown"
    }
}
}

fn cached_run_stage(pipeline, name, url, method, payload, git_hash, use_cache) {
    // Check cache if enabled and hash is known
    if3 use_cache == true {
        if3 git_hash != "unknown" {
            let cache_key = pipeline + ":" + name + ":" + git_hash
            let cached = dict_get(_stage_cache, cache_key, null)
            if3 cached != null {
                // Cache hit: return cached result with cache marker
                let _cache_hits = _cache_hits + 1
                let cached = dict_set(cached, "cached", true)
                let cached = dict_set(cached, "cache_key", cache_key)
                return cached
            } maybe {
                // cache miss, fall through
            } else3 {
                // cache miss, fall through
            }
        } maybe {
            // unknown hash, can't cache
        } else3 {
            // unknown hash, can't cache
        }
    } maybe {
        // caching disabled
    } else3 {
        // caching disabled
    }

    // Cache miss: run the stage
    let _cache_misses = _cache_misses + 1
    let result = run_stage(name, url, method, payload)
    let result = dict_set(result, "cached", false)

    // Store in cache if stage passed (+1) and hash is known
    if3 use_cache == true {
        if3 git_hash != "unknown" {
            let stage_trit = dict_get(result, "trit", 0)
            if3 stage_trit == 1 {
                // Only cache successful stages
                let cache_key = pipeline + ":" + name + ":" + git_hash
                let _stage_cache = dict_set(_stage_cache, cache_key, result)
            } maybe {
                // partial: don't cache
            } else3 {
                // failed: don't cache
            }
        } maybe {
            // unknown hash
        } else3 {
            // unknown hash
        }
    } maybe {
        // disabled
    } else3 {
        // disabled
    }

    return result
}

// ===================================================================
// Pipeline Finalization (fires webhooks after every pipeline)
// ===================================================================
fn finalize_pipeline(result) {
    let name = dict_get(result, "pipeline", "unknown")
    let trit = dict_get(result, "overall_trit", 0)
    let stages = dict_get(result, "stages", [])
    let path = dict_get(result, "path", "C:\\NovaX")
    let git_hash = get_git_hash(path)
    // Record in history for rollback
    let entry = {
        "pipeline": name,
        "trit": trit,
        "trit_char": trit_char(trit),
        "git_hash": git_hash,
        "path": path,
        "stage_count": len(stages),
        "ts": time()
    }
    let _run_history = append(_run_history, entry)
    if3 len(_run_history) > _history_max {
        let _run_history = slice(_run_history, len(_run_history) - _history_max, len(_run_history))
    } maybe {
    } else3 {
    }
    fire_webhooks(name, trit, len(stages), 0)
    return result
}

// ===================================================================
// Pipeline Definitions
// ===================================================================

fn pipeline_lint(req) {
    let body = dict_get(req, "body", {})
    let path = dict_get(body, "path", "C:\\NovaX")
    let use_cache = dict_get(body, "cache", true)
    let git_hash = get_git_hash(path)
    let stages = []

    // Stage 1: Git status (never cached — always check current state)
    let s1 = run_stage("git-status", TGIT_URL + "/tgit/status", "POST", { "path": path })
    let stages = append(stages, s1)

    // Stage 2: Build lint (cached if git hash unchanged)
    let s2 = cached_run_stage("lint", "build-lint", TBUILD_URL + "/tbuild/lint", "POST", { "path": path }, git_hash, use_cache)
    let stages = append(stages, s2)

    // Aggregate
    let trits = []
    let trits = append(trits, dict_get(s1, "trit", 0))
    let trits = append(trits, dict_get(s2, "trit", 0))
    let overall = trit_majority(trits)

    let total_runs = total_runs + 1
    if3 overall == 1 {
        let pass_count = pass_count + 1
    } maybe {
        let partial_count = partial_count + 1
    } else3 {
        let fail_count = fail_count + 1
    }

    return finalize_pipeline({
        "pipeline": "lint",
        "stages": stages,
        "overall_trit": overall,
        "overall_char": trit_char(overall),
        "path": path
    })
}

fn pipeline_build(req) {
    let body = dict_get(req, "body", {})
    let path = dict_get(body, "path", "C:\\NovaX")
    let target = dict_get(body, "target", "python")
    let use_cache = dict_get(body, "cache", true)
    let git_hash = get_git_hash(path)
    let stages = []

    // Stage 1: Check deps (cached)
    let s1 = cached_run_stage("build", "deps-check", TBUILD_URL + "/tbuild/deps", "POST", { "path": path }, git_hash, use_cache)
    let stages = append(stages, s1)

    // Stage 2: Build order (cached)
    let s2 = cached_run_stage("build", "build-order", TBUILD_URL + "/tbuild/order", "POST", { "path": path }, git_hash, use_cache)
    let stages = append(stages, s2)

    // Stage 3: Compile (cached)
    let s3 = cached_run_stage("build", "compile", TBUILD_URL + "/tbuild/compile", "POST", { "path": path, "target": target }, git_hash, use_cache)
    let stages = append(stages, s3)

    // Stage 4: Lint (cached)
    let s4 = cached_run_stage("build", "lint", TBUILD_URL + "/tbuild/lint", "POST", { "path": path }, git_hash, use_cache)
    let stages = append(stages, s4)

    // Aggregate
    let trits = []
    let trits = append(trits, dict_get(s1, "trit", 0))
    let trits = append(trits, dict_get(s2, "trit", 0))
    let trits = append(trits, dict_get(s3, "trit", 0))
    let trits = append(trits, dict_get(s4, "trit", 0))
    let overall = trit_majority(trits)

    let total_runs = total_runs + 1
    if3 overall == 1 {
        let pass_count = pass_count + 1
    } maybe {
        let partial_count = partial_count + 1
    } else3 {
        let fail_count = fail_count + 1
    }

    return finalize_pipeline({
        "pipeline": "build",
        "stages": stages,
        "overall_trit": overall,
        "overall_char": trit_char(overall),
        "path": path,
        "target": target
    })
}

fn pipeline_full(req) {
    let body = dict_get(req, "body", {})
    let path = dict_get(body, "path", "C:\\NovaX")
    let stages = []

    // Stage 1: Git status
    let s1 = run_stage("git-status", TGIT_URL + "/tgit/status", "POST", { "path": path })
    let stages = append(stages, s1)

    // Stage 2: Deps check
    let s2 = run_stage("deps", TBUILD_URL + "/tbuild/deps", "POST", { "path": path })
    let stages = append(stages, s2)

    // Stage 3: Lint
    let s3 = run_stage("lint", TBUILD_URL + "/tbuild/lint", "POST", { "path": path })
    let stages = append(stages, s3)

    // Stage 4: Compile
    let s4 = run_stage("compile", TBUILD_URL + "/tbuild/compile", "POST", { "path": path })
    let stages = append(stages, s4)

    // Stage 5: Profile start
    let s5 = run_stage("profile-start", TPROFILE_URL + "/tprofile/start", "POST", { "label": "ci-run" })
    let stages = append(stages, s5)

    // Stage 6: VCS check
    let s6 = run_stage("vcs-check", TBUILD_URL + "/tbuild/vcs", "POST", { "path": path })
    let stages = append(stages, s6)

    // Stage 7: Profile end
    let s7 = run_stage("profile-end", TPROFILE_URL + "/tprofile/end", "POST", { "label": "ci-run" })
    let stages = append(stages, s7)

    // Aggregate all stage trits
    let trits = []
    let trits = append(trits, dict_get(s1, "trit", 0))
    let trits = append(trits, dict_get(s2, "trit", 0))
    let trits = append(trits, dict_get(s3, "trit", 0))
    let trits = append(trits, dict_get(s4, "trit", 0))
    let trits = append(trits, dict_get(s6, "trit", 0))
    let overall = trit_majority(trits)

    let total_runs = total_runs + 1
    if3 overall == 1 {
        let pass_count = pass_count + 1
    } maybe {
        let partial_count = partial_count + 1
    } else3 {
        let fail_count = fail_count + 1
    }

    return finalize_pipeline({
        "pipeline": "full",
        "stages": stages,
        "stage_count": 7,
        "overall_trit": overall,
        "overall_char": trit_char(overall),
        "path": path
    })
}

fn pipeline_deploy(req) {
    let body = dict_get(req, "body", {})
    let path = dict_get(body, "path", "C:\\NovaX")
    let service = dict_get(body, "service", "")
    let stages = []

    // Stage 1: Pre-deploy lint
    let s1 = run_stage("pre-lint", TBUILD_URL + "/tbuild/lint", "POST", { "path": path })
    let stages = append(stages, s1)

    // Stage 2: Git log (check recent commits)
    let s2 = run_stage("git-log", TGIT_URL + "/tgit/log", "POST", { "path": path, "count": 3 })
    let stages = append(stages, s2)

    // Stage 3: Build diff (check what changed)
    let s3 = run_stage("build-diff", TBUILD_URL + "/tbuild/diff", "POST", { "path": path })
    let stages = append(stages, s3)

    // Stage 4: Service health (if deploying to a service)
    if3 service != "" {
        let svc_url = ORCH_URL + "/health"
        let s4 = run_stage("service-health", svc_url, "GET", {})
        let stages = append(stages, s4)
    } maybe {
        // no service specified
    } else3 {
        // no service specified
    }

    let trits = []
    let trits = append(trits, dict_get(s1, "trit", 0))
    let trits = append(trits, dict_get(s2, "trit", 0))
    let trits = append(trits, dict_get(s3, "trit", 0))
    let overall = trit_majority(trits)

    let total_runs = total_runs + 1
    if3 overall == 1 {
        let pass_count = pass_count + 1
    } maybe {
        let partial_count = partial_count + 1
    } else3 {
        let fail_count = fail_count + 1
    }

    return finalize_pipeline({
        "pipeline": "deploy",
        "stages": stages,
        "overall_trit": overall,
        "overall_char": trit_char(overall),
        "path": path,
        "service": service,
        "deploy_ready": overall == 1
    })
}

fn pipeline_test(req) {
    let body = dict_get(req, "body", {})
    let path = dict_get(body, "path", "C:\\NovaX")
    let pattern = dict_get(body, "pattern", "test_*.nova")
    let use_cache = dict_get(body, "cache", true)
    let git_hash = get_git_hash(path)
    let stages = []

    // Stage 1: Git status (never cached)
    let s1 = run_stage("git-status", TGIT_URL + "/tgit/status", "POST", { "path": path })
    let stages = append(stages, s1)

    // Stage 2: Lint before tests (cached)
    let s2 = cached_run_stage("test", "pre-test-lint", TBUILD_URL + "/tbuild/lint", "POST", { "path": path }, git_hash, use_cache)
    let stages = append(stages, s2)

    // Stage 3: Discover test files via tbuild deps (scans for test_*.nova)
    let test_dir = path + "\\tests"
    let s3 = run_stage("discover-tests", TBUILD_URL + "/tbuild/deps", "POST", { "path": test_dir })
    let stages = append(stages, s3)

    // Stage 4: Execute test runner via exec-server
    // Sends NovaLang test file paths to exec for execution
    let exec_url = "http://127.0.0.1:9877"
    let test_cmd = "python C:\\NovaX\\novalang.py " + test_dir + "\\" + pattern
    let s4 = run_stage("run-tests", exec_url + "/exec", "POST", {
        "command": test_cmd,
        "timeout": 30
    })
    let stages = append(stages, s4)

    // Aggregate
    let trits = []
    let trits = append(trits, dict_get(s1, "trit", 0))
    let trits = append(trits, dict_get(s2, "trit", 0))
    let trits = append(trits, dict_get(s4, "trit", 0))
    let overall = trit_majority(trits)

    let total_runs = total_runs + 1
    if3 overall == 1 {
        let pass_count = pass_count + 1
    } maybe {
        let partial_count = partial_count + 1
    } else3 {
        let fail_count = fail_count + 1
    }

    return finalize_pipeline({
        "pipeline": "test",
        "stages": stages,
        "stage_count": len(stages),
        "overall_trit": overall,
        "overall_char": trit_char(overall),
        "path": path,
        "pattern": pattern
    })
}

fn pipeline_parallel(req) {
    let path = dict_get(req, "path", "C:\\NovaX")
    let stages_def = dict_get(req, "stages", [])
    let t0 = time() * 1000

    // stages_def: array of {name, url, method, payload}
    // All stages run concurrently via http_parallel
    if3 len(stages_def) == 0 {
        return { "ok": false, "error": "stages required", "trit": -1 }
    } maybe {
        // fall through
    } else3 {
        // fall through
    }

    // Cap at H13 stages
    let stage_count = len(stages_def)
    if3 stage_count > H13 {
        let stage_count = H13
    } maybe {
        // keep
    } else3 {
        // keep
    }

    // Build parallel request array
    let requests = []
    let idx = 0
    for item in stages_def {
        if3 idx < H13 {
            let url = dict_get(item, "url", "")
            let method = dict_get(item, "method", "POST")
            let payload = dict_get(item, "payload", {})
            let requests = append(requests, { "url": url, "method": method, "payload": payload })
        } maybe {
            // skip
        } else3 {
            // skip
        }
        let idx = idx + 1
    }

    // Fire all at once
    let responses = http_parallel(requests)

    // Process results
    let stages = []
    let trits = []
    let idx2 = 0
    for resp in responses {
        let def_item = stages_def[idx2]
        let name = dict_get(def_item, "name", "stage-" + str(idx2))
        let ok = dict_get(resp, "ok", false)
        let trit_val = 0
        if3 ok == true {
            let trit_val = 1
        } maybe {
            let trit_val = 0
        } else3 {
            let trit_val = -1
        }
        let err = dict_get(resp, "error", "")
        if3 err != "" {
            let trit_val = -1
        } maybe {
            // keep
        } else3 {
            // keep
        }
        let stage_result = {
            "stage": name,
            "trit": trit_val,
            "char": trit_char(trit_val),
            "response": resp,
            "parallel": true
        }
        let stages = append(stages, stage_result)
        let trits = append(trits, trit_val)
        let idx2 = idx2 + 1
    }

    let elapsed = time() * 1000 - t0
    let overall = trit_majority(trits)

    let total_runs = total_runs + 1
    if3 overall == 1 {
        let pass_count = pass_count + 1
    } maybe {
        let partial_count = partial_count + 1
    } else3 {
        let fail_count = fail_count + 1
    }

    return {
        "pipeline": "parallel",
        "stages": stages,
        "stage_count": len(stages),
        "overall_trit": overall,
        "overall_char": trit_char(overall),
        "elapsed_ms": elapsed,
        "parallel": true,
        "path": path
    }
}

// ===================================================================
// Handlers
// ===================================================================

fn handle_health(req) {
    let uptime_s = (time() * 1000 - start_time) / 1000
    return {
        "ok": true,
        "service": SERVICE_NAME,
        "port": PORT,
        "version": VERSION,
        "ternary": true,
        "runtime": "novalang",
        "pipelines": ["lint", "build", "full", "deploy", "test", "parallel", "templates", "depgraph"],
        "templates": _template_count,
        "cache_entries": len(keys(_stage_cache)),
        "cache_hits": _cache_hits,
        "total_runs": total_runs,
        "pass": pass_count,
        "fail": fail_count,
        "partial": partial_count,
        "uptime_s": uptime_s,
        "harmonics": { "H3": H3, "H5": H5, "H7": H7, "H13": H13, "BLOCK": BLOCK },
        "trit": 1,
        "char": "+"
    }
}

fn handle_cache(req) {
    let entries = keys(_stage_cache)
    let entry_count = len(entries)
    return {
        "ok": true,
        "cache_entries": entry_count,
        "cache_hits": _cache_hits,
        "cache_misses": _cache_misses,
        "hit_rate_pct": 0,
        "keys": entries,
        "trit": 1
    }
}

fn handle_cache_clear(req) {
    let _stage_cache = {}
    let old_hits = _cache_hits
    let old_misses = _cache_misses
    let _cache_hits = 0
    let _cache_misses = 0
    return {
        "ok": true,
        "cleared": true,
        "prev_hits": old_hits,
        "prev_misses": old_misses,
        "trit": 1
    }
}

fn handle_stats(req) {
    let uptime_s = (time() * 1000 - start_time) / 1000
    let rate = 0
    if3 total_runs > 0 {
        let rate = (pass_count * 100) / total_runs
    } maybe {
        // no runs yet
    } else3 {
        // no runs yet
    }
    return {
        "total_runs": total_runs,
        "pass": pass_count,
        "fail": fail_count,
        "partial": partial_count,
        "pass_rate_pct": rate,
        "uptime_s": uptime_s,
        "trit": 1
    }
}

// ===================================================================
// Pipeline Templates — Save/Load Named Presets
// ===================================================================
// Templates store pipeline configs: name, pipeline type, params, stages.
// Capped at H13 templates. Each template has a trit quality score.

let _templates = {}
let _template_count = 0

fn handle_template_save(req) {
    // POST /tci/template/save — Save a pipeline template
    let name = dict_get(req, "name", "")
    let pipeline = dict_get(req, "pipeline", "")
    let stages = dict_get(req, "stages", [])
    let params = dict_get(req, "params", {})
    let description = dict_get(req, "description", "")

    if3 len(name) > 0 {
        if3 len(pipeline) > 0 {
            // Check cap
            if3 _template_count >= 13 {
                // At cap — check if updating existing
                let existing = dict_get(_templates, name, null)
                if3 existing == null {
                    return {
                        "ok": false,
                        "error": "Template limit reached (H13=13). Delete a template first.",
                        "trit": -1
                    }
                }
            }
            let tmpl = {
                "name": name,
                "pipeline": pipeline,
                "stages": stages,
                "params": params,
                "description": description,
                "created_at": time(),
                "run_count": 0,
                "last_trit": 0
            }
            let is_new = dict_get(_templates, name, null) == null
            dict_set(_templates, name, tmpl)
            if3 is_new {
                _template_count = _template_count + 1
            }
            return {
                "ok": true,
                "action": "saved",
                "name": name,
                "pipeline": pipeline,
                "total_templates": _template_count,
                "trit": 1
        } else3 {
            return {"ok": false, "error": "pipeline type required", "trit": -1}
    } else3 {
        return {"ok": false, "error": "template name required", "trit": -1}
    }
}
}
}

fn handle_template_list(req) {
    // GET /tci/templates — List all saved templates
    let tmpl_list = []
    let names = keys(_templates)
    for3 n in names {
        let t = dict_get(_templates, n, {})
        let entry = {
            "name": dict_get(t, "name", ""),
            "pipeline": dict_get(t, "pipeline", ""),
            "description": dict_get(t, "description", ""),
            "run_count": dict_get(t, "run_count", 0),
            "last_trit": dict_get(t, "last_trit", 0)
        }
        tmpl_list = tmpl_list + [entry]
    }
    return {
        "ok": true,
        "templates": tmpl_list,
        "total": _template_count,
        "trit": 1
    }
}

fn handle_template_run(req) {
    // POST /tci/template/run — Run a saved template by name
    let name = dict_get(req, "name", "")
    if3 len(name) == 0 {
        return {"ok": false, "error": "template name required", "trit": -1}
    }
    let tmpl = dict_get(_templates, name, null)
    if3 tmpl == null {
        return {"ok": false, "error": "template not found: " + name, "trit": -1}
    }
    let pipeline = dict_get(tmpl, "pipeline", "")
    let params = dict_get(tmpl, "params", {})
    let stages = dict_get(tmpl, "stages", [])

    // Dispatch to the appropriate pipeline
    let result = {}
    let target = dict_get(req, "target", dict_get(params, "target", "C:\\NovaX"))
    let run_req = {"target": target}

    if3 pipeline == "lint" {
        result = pipeline_lint(run_req)
    } else3 {
        if3 pipeline == "build" {
            result = pipeline_build(run_req)
        } else3 {
            if3 pipeline == "full" {
                result = pipeline_full(run_req)
            } else3 {
                if3 pipeline == "deploy" {
                    result = pipeline_deploy(run_req)
                } else3 {
                    if3 pipeline == "test" {
                        result = pipeline_test(run_req)
                    } else3 {
                        if3 pipeline == "parallel" {
                            let par_req = {"stages": stages}
                            result = pipeline_parallel(par_req)
                        } else3 {
                            result = {"ok": false, "error": "unknown pipeline: " + pipeline, "trit": -1}
                        }
                    }
                }
            }
        }
    }

    // Update template run count and last trit
    let run_trit = dict_get(result, "trit", 0)
    dict_set(tmpl, "run_count", dict_get(tmpl, "run_count", 0) + 1)
    dict_set(tmpl, "last_trit", run_trit)
    dict_set(_templates, name, tmpl)

    return {
        "ok": true,
        "template": name,
        "pipeline": pipeline,
        "result": result,
        "run_count": dict_get(tmpl, "run_count", 0),
        "trit": run_trit
    }
}

fn handle_template_delete(req) {
    // POST /tci/template/delete — Delete a template by name
    let name = dict_get(req, "name", "")
    if3 len(name) == 0 {
        return {"ok": false, "error": "template name required", "trit": -1}
    }
    let tmpl = dict_get(_templates, name, null)
    if3 tmpl == null {
        return {"ok": false, "error": "template not found: " + name, "trit": -1}
    }
    dict_set(_templates, name, null)
    _template_count = _template_count - 1
    return {
        "ok": true,
        "action": "deleted",
        "name": name,
        "remaining": _template_count,
        "trit": 1
    }
}

// ===================================================================
// Pipeline Dependency Graphs
// ===================================================================
// Each pipeline defines stages as nodes with explicit dependencies.
// Stages with no deps (roots) can run in parallel with each other.
// Topo-sort determines execution order; siblings are parallelizable.

let _depgraphs = {
    "lint": {
        "stages": {
            "git-status":  { "deps": [], "url": "/tgit/status",  "method": "POST", "cacheable": false },
            "build-lint":  { "deps": ["git-status"], "url": "/tbuild/lint", "method": "POST", "cacheable": true }
        }
    },
    "build": {
        "stages": {
            "deps-check":  { "deps": [], "url": "/tbuild/deps",     "method": "POST", "cacheable": true },
            "build-order": { "deps": ["deps-check"], "url": "/tbuild/order",   "method": "POST", "cacheable": true },
            "compile":     { "deps": ["build-order"], "url": "/tbuild/compile", "method": "POST", "cacheable": true },
            "lint":        { "deps": ["compile"], "url": "/tbuild/lint",        "method": "POST", "cacheable": true }
        }
    },
    "full": {
        "stages": {
            "git-status":    { "deps": [], "url": "/tgit/status",       "method": "POST", "cacheable": false },
            "deps-check":   { "deps": ["git-status"], "url": "/tbuild/deps",    "method": "POST", "cacheable": true },
            "build-lint":   { "deps": ["git-status"], "url": "/tbuild/lint",     "method": "POST", "cacheable": true },
            "compile":      { "deps": ["deps-check"], "url": "/tbuild/compile",  "method": "POST", "cacheable": true },
            "profile-wrap": { "deps": ["compile"], "url": "/tprofile/snapshot",  "method": "POST", "cacheable": true },
            "post-lint":    { "deps": ["compile"], "url": "/tbuild/lint",        "method": "POST", "cacheable": true },
            "vcs-check":    { "deps": ["profile-wrap", "post-lint"], "url": "/tgit/diff", "method": "POST", "cacheable": false }
        }
    },
    "deploy": {
        "stages": {
            "pre-lint":      { "deps": [], "url": "/tbuild/lint",       "method": "POST", "cacheable": true },
            "git-log":       { "deps": [], "url": "/tgit/log",          "method": "POST", "cacheable": false },
            "build-diff":    { "deps": ["pre-lint", "git-log"], "url": "/tbuild/compile", "method": "POST", "cacheable": true },
            "service-health": { "deps": ["build-diff"], "url": "/api/services/health", "method": "GET", "cacheable": false }
        }
    },
    "test": {
        "stages": {
            "git-status":     { "deps": [], "url": "/tgit/status",       "method": "POST", "cacheable": false },
            "pre-test-lint":  { "deps": ["git-status"], "url": "/tbuild/lint", "method": "POST", "cacheable": true },
            "discover-tests": { "deps": ["pre-test-lint"], "url": "/tbuild/order", "method": "POST", "cacheable": true },
            "run-tests":      { "deps": ["discover-tests"], "url": "/tbuild/compile", "method": "POST", "cacheable": false }
        }
    }
}

// Custom user-defined dependency graphs (capped at H13)
let _custom_depgraphs = {}
let _custom_dg_count = 0

fn _topo_sort(stages) {
    // Kahn's algorithm: produce execution layers (each layer = parallel-safe)
    // Returns list of layers, each layer is a list of stage names
    let stage_keys = keys(stages)
    let in_degree = {}
    let layers = []

    // Calculate in-degree for each stage
    let i = 0
    let n = len(stage_keys)
    while3 i < n {
        let sname = dict_get(stage_keys, i, "")
        let sinfo = dict_get(stages, sname, {})
        let deps = dict_get(sinfo, "deps", [])
        let deg = len(deps)
        let in_degree = dict_set(in_degree, sname, deg)
        let i = i + 1
    }

    // Iteratively find nodes with in_degree 0
    let remaining = n
    while3 remaining > 0 {
        let layer = []
        let lkeys = keys(in_degree)
        let li = 0
        let ln = len(lkeys)
        while3 li < ln {
            let sk = dict_get(lkeys, li, "")
            let dv = dict_get(in_degree, sk, -1)
            if3 dv == 0 {
                let layer = append(layer, sk)
            } maybe {
                // not ready
            } else3 {
                // not ready
            }
            let li = li + 1
        }

        // If no layer found, cycle detected
        if3 len(layer) == 0 {
            return { "error": "cycle detected", "remaining": remaining }
        } maybe {
            // ok
        } else3 {
            // ok
        }

        let layers = append(layers, layer)

        // Remove layer nodes, decrement dependents
        let lai = 0
        let lan = len(layer)
        while3 lai < lan {
            let removed = dict_get(layer, lai, "")
            let in_degree = dict_set(in_degree, removed, -1)
            let remaining = remaining - 1

            // Decrement in-degree of nodes that depend on removed
            let di = 0
            while3 di < n {
                let dn = dict_get(stage_keys, di, "")
                let dinfo = dict_get(stages, dn, {})
                let ddeps = dict_get(dinfo, "deps", [])
                let dj = 0
                let ddn = len(ddeps)
                while3 dj < ddn {
                    let dep_name = dict_get(ddeps, dj, "")
                    if3 dep_name == removed {
                        let old_deg = dict_get(in_degree, dn, 0)
                        let in_degree = dict_set(in_degree, dn, old_deg - 1)
                    } maybe {
                        // not a match
                    } else3 {
                        // not a match
                    }
                    let dj = dj + 1
                }
                let di = di + 1
            }
            let lai = lai + 1
        }
    }
    return layers
}

fn handle_depgraph(req) {
    // GET /tci/depgraph — Return all pipeline dependency graphs + topo layers
    let result = {}
    let pnames = keys(_depgraphs)
    let pi = 0
    let pn = len(pnames)
    while3 pi < pn {
        let pname = dict_get(pnames, pi, "")
        let pgraph = dict_get(_depgraphs, pname, {})
        let pstages = dict_get(pgraph, "stages", {})
        let layers = _topo_sort(pstages)
        let entry = {}
        let entry = dict_set(entry, "stages", pstages)
        let entry = dict_set(entry, "layers", layers)
        let entry = dict_set(entry, "stage_count", len(keys(pstages)))
        let result = dict_set(result, pname, entry)
        let pi = pi + 1
    }

    // Include custom graphs
    let cnames = keys(_custom_depgraphs)
    let ci = 0
    let cn = len(cnames)
    while3 ci < cn {
        let cname = dict_get(cnames, ci, "")
        let cgraph = dict_get(_custom_depgraphs, cname, {})
        let cstages = dict_get(cgraph, "stages", {})
        let clayers = _topo_sort(cstages)
        let centry = {}
        let centry = dict_set(centry, "stages", cstages)
        let centry = dict_set(centry, "layers", clayers)
        let centry = dict_set(centry, "stage_count", len(keys(cstages)))
        let centry = dict_set(centry, "custom", true)
        let result = dict_set(result, cname, centry)
        let ci = ci + 1
    }

    // If viz=true, add ASCII visualization for each pipeline
    let do_viz = dict_get(req, "viz", "")
    if3 do_viz == "true" {
        let viz_map = {}
        let vnames = keys(result)
        let vi = 0
        let vn = len(vnames)
        while3 vi < vn {
            let vname = dict_get(vnames, vi, "")
            let ventry = dict_get(result, vname, {})
            let vstages = dict_get(ventry, "stages", {})
            let vlayers = dict_get(ventry, "layers", [])

            // Build ASCII tree
            let lines = []
            let num_layers = len(vlayers)
            let stage_count = len(keys(vstages))
            let header = "Pipeline: " + vname + " (" + str(stage_count) + " stages, " + str(num_layers) + " layers)"
            let lines = append(lines, header)
            let lines = append(lines, "========================================")

            let li = 0
            while3 li < num_layers {
                let layer = dict_get(vlayers, li, [])
                let layer_size = len(layer)
                let layer_label = "Layer " + str(li) + " (parallel=" + str(layer_size) + ")"
                let lines = append(lines, "")
                let lines = append(lines, layer_label)

                let si = 0
                while3 si < layer_size {
                    let sname = dict_get(layer, si, "")
                    let sinfo = dict_get(vstages, sname, {})
                    let sdeps = dict_get(sinfo, "deps", [])
                    let surl = dict_get(sinfo, "url", "")
                    let smethod = dict_get(sinfo, "method", "POST")
                    let scache = dict_get(sinfo, "cacheable", false)

                    // Dep string
                    let dep_str = ""
                    let di = 0
                    let dn = len(sdeps)
                    while3 di < dn {
                        let dep = dict_get(sdeps, di, "")
                        if3 di > 0 {
                            let dep_str = dep_str + ", " + dep
                        } maybe {
                            let dep_str = dep
                        } else3 {
                            let dep_str = dep
                        }
                        let di = di + 1
                    }

                    // Connector
                    let is_last = si == layer_size - 1
                    let connector = "  |-"
                    if3 is_last == true {
                        let connector = "  \\-"
                    } maybe {
                        // default
                    } else3 {
                        // default
                    }

                    // Cache tag
                    let cache_tag = ""
                    if3 scache == true {
                        let cache_tag = " [CACHE]"
                    } maybe {
                        let cache_tag = ""
                    } else3 {
                        let cache_tag = " [NO-CACHE]"
                    }

                    let stage_line = connector + " [" + sname + "] " + smethod + " " + surl + cache_tag
                    let lines = append(lines, stage_line)

                    if3 dn > 0 {
                        let dep_line = "  |    deps: " + dep_str
                        let lines = append(lines, dep_line)
                    } maybe {
                        let dep_line = "  |    deps: (root)"
                        let lines = append(lines, dep_line)
                    } else3 {
                        let dep_line = "  |    deps: (root)"
                        let lines = append(lines, dep_line)
                    }

                    let si = si + 1
                }

                // Arrow
                if3 li < num_layers - 1 {
                    let lines = append(lines, "  |")
                    let lines = append(lines, "  V")
                } maybe {
                    let lines = append(lines, "  |")
                    let lines = append(lines, "  [DONE]")
                } else3 {
                    let lines = append(lines, "  |")
                    let lines = append(lines, "  [DONE]")
                }

                let li = li + 1
            }

            let viz_text = join(lines, "\n")
            let viz_map = dict_set(viz_map, vname, viz_text)
            let vi = vi + 1
        }

        return {
            "ok": true,
            "pipelines": result,
            "viz": viz_map,
            "builtin_count": pn,
            "custom_count": cn,
            "trit": 1
        }
    } maybe {
        // no viz requested
    } else3 {
        // no viz requested
    }

    return {
        "ok": true,
        "pipelines": result,
        "builtin_count": pn,
        "custom_count": cn,
        "trit": 1
    }
}

fn handle_depgraph_save(req) {
    // POST /tci/depgraph/save — Save a custom dependency graph
    let name = dict_get(req, "name", "")
    let stages = dict_get(req, "stages", {})

    if3 name == "" {
        return { "ok": false, "error": "name required", "trit": -1 }
    } maybe {
        // ok
    } else3 {
        // ok
    }

    if3 len(keys(stages)) == 0 {
        return { "ok": false, "error": "stages required (dict of stage_name -> {deps, url, method})", "trit": -1 }
    } maybe {
        // ok
    } else3 {
        // ok
    }

    if3 _custom_dg_count >= H13 {
        return { "ok": false, "error": "Max H13 custom graphs reached", "trit": -1 }
    } maybe {
        // ok
    } else3 {
        // ok
    }

    // Validate: topo sort must succeed
    let layers = _topo_sort(stages)
    let is_err = dict_get(layers, "error", "")
    if3 is_err != "" {
        return { "ok": false, "error": is_err, "trit": -1 }
    } maybe {
        // ok
    } else3 {
        // ok
    }

    let entry = {}
    let entry = dict_set(entry, "stages", stages)
    let entry = dict_set(entry, "created", time())
    let _custom_depgraphs = dict_set(_custom_depgraphs, name, entry)
    let _custom_dg_count = _custom_dg_count + 1

    return {
        "ok": true,
        "name": name,
        "stage_count": len(keys(stages)),
        "layers": layers,
        "trit": 1
    }
}

fn handle_depgraph_run(req) {
    // POST /tci/depgraph/run — Execute a pipeline by dependency graph
    // Runs layers sequentially; stages within each layer run via http_parallel
    let name = dict_get(req, "pipeline", "")
    let path = dict_get(req, "path", "C:\\NovaX")
    let use_cache = dict_get(req, "cache", true)
    let git_hash = get_git_hash(path)

    // Look up graph: check builtins first, then custom
    let graph = dict_get(_depgraphs, name, {})
    if3 len(keys(graph)) == 0 {
        let graph = dict_get(_custom_depgraphs, name, {})
    } maybe {
        // found in builtins
    } else3 {
        // found in builtins
    }

    let gstages = dict_get(graph, "stages", {})
    if3 len(keys(gstages)) == 0 {
        return { "ok": false, "error": "Pipeline '" + name + "' not found", "trit": -1 }
    } maybe {
        // ok
    } else3 {
        // ok
    }

    let layers = _topo_sort(gstages)
    let is_err = dict_get(layers, "error", "")
    if3 is_err != "" {
        return { "ok": false, "error": "Cycle in pipeline: " + is_err, "trit": -1 }
    } maybe {
        // ok
    } else3 {
        // ok
    }

    // Execute layer by layer
    let all_results = []
    let all_trits = []
    let layer_idx = 0
    let num_layers = len(layers)

    while3 layer_idx < num_layers {
        let layer = dict_get(layers, layer_idx, [])
        let layer_size = len(layer)

        if3 layer_size == 1 {
            // Single stage — run directly
            let sname = dict_get(layer, 0, "")
            let sinfo = dict_get(gstages, sname, {})
            let surl = dict_get(sinfo, "url", "")
            let smethod = dict_get(sinfo, "method", "POST")
            let scacheable = dict_get(sinfo, "cacheable", false)

            // Resolve full URL (prepend service base if relative)
            let full_url = ""
            if3 starts_with(surl, "/tgit") {
                let full_url = TGIT_URL + surl
            } maybe {
                let full_url = ORCH_URL + surl
            } else3 {
                if3 starts_with(surl, "/tbuild") {
                    let full_url = TBUILD_URL + surl
                } maybe {
                    let full_url = ORCH_URL + surl
                } else3 {
                    if3 starts_with(surl, "/tprofile") {
                        let full_url = TPROFILE_URL + surl
                    } maybe {
                        let full_url = ORCH_URL + surl
                    } else3 {
                        let full_url = ORCH_URL + surl
                    }
                }
            }

            let sr = {}
            if3 scacheable == true {
                let sr = cached_run_stage(name, sname, full_url, smethod, { "path": path }, git_hash, use_cache)
            } maybe {
                let sr = run_stage(sname, full_url, smethod, { "path": path })
            } else3 {
                let sr = run_stage(sname, full_url, smethod, { "path": path })
            }

            let all_results = append(all_results, sr)
            let all_trits = append(all_trits, dict_get(sr, "trit", 0))

        } maybe {
            // Multiple stages — run in parallel via http_parallel
            let urls = []
            let methods = []
            let si = 0
            while3 si < layer_size {
                let sn = dict_get(layer, si, "")
                let sinf = dict_get(gstages, sn, {})
                let su = dict_get(sinf, "url", "")
                let sm = dict_get(sinf, "method", "POST")

                let fu = ""
                if3 starts_with(su, "/tgit") {
                    let fu = TGIT_URL + su
                } maybe {
                    let fu = ORCH_URL + su
                } else3 {
                    if3 starts_with(su, "/tbuild") {
                        let fu = TBUILD_URL + su
                    } maybe {
                        let fu = ORCH_URL + su
                    } else3 {
                        if3 starts_with(su, "/tprofile") {
                            let fu = TPROFILE_URL + su
                        } maybe {
                            let fu = ORCH_URL + su
                        } else3 {
                            let fu = ORCH_URL + su
                        }
                    }
                }
                let urls = append(urls, fu)
                let si = si + 1
            }

            // Use http_parallel for concurrent execution
            let parallel_results = http_parallel(urls, { "path": path })

            // Record results
            let pri = 0
            while3 pri < layer_size {
                let psn = dict_get(layer, pri, "")
                let pr = dict_get(parallel_results, pri, {})
                let pr = dict_set(pr, "stage", psn)
                let pr_trit = dict_get(pr, "trit", 0)
                if3 pr_trit == 0 {
                    // Try to determine trit from response
                    let pr_ok = dict_get(pr, "ok", false)
                    if3 pr_ok == true {
                        let pr_trit = 1
                    } maybe {
                        let pr_trit = 0
                    } else3 {
                        let pr_trit = -1
                    }
                } maybe {
                    // trit already set
                } else3 {
                    // trit already set
                }
                let pr = dict_set(pr, "trit", pr_trit)
                let all_results = append(all_results, pr)
                let all_trits = append(all_trits, pr_trit)
                let pri = pri + 1
            }

        } else3 {
            // layer_size == 0 — skip
        }

        let layer_idx = layer_idx + 1
    }

    // Aggregate
    let overall = trit_majority(all_trits)
    let total_runs = total_runs + 1
    if3 overall == 1 {
        let pass_count = pass_count + 1
    } maybe {
        let partial_count = partial_count + 1
    } else3 {
        let fail_count = fail_count + 1
    }

    return {
        "ok": true,
        "pipeline": name,
        "stages": all_results,
        "layers": layers,
        "overall_trit": overall,
        "overall_char": trit_char(overall),
        "path": path,
        "trit": overall
    }
}

