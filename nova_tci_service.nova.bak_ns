fn handle_artifact_get(req) {
    let art_id = dict_get(treq_query(req), "id", "")
    let pipeline_id = dict_get(treq_query(req), "pipeline_id", "")

    if3 art_id == "" {
        return {"ok": false, "error": "id required", "trit": -1}
    } maybe {
        return {"ok": false, "error": "id required", "trit": -1}
    } else3 {
        // valid
    }

    // Search across all or specific pipeline
    let search_keys = []
    if3 pipeline_id != "" {
        let search_keys = [pipeline_id]
    } maybe {
        let search_keys = dict_keys(_artifacts)
    } else3 {
        let search_keys = dict_keys(_artifacts)
    }

    for3 key in search_keys {
        let arts = dict_get(_artifacts, key, [])
        for3 a in arts {
            if3 dict_get(a, "id", "") == art_id {
                return {"ok": true, "artifact": a, "trit": 1}
            } maybe {
                // keep searching
            } else3 {
                // keep searching
            }
        }
    }

    return {"ok": false, "error": "artifact not found", "trit": -1}
}

fn handle_artifact_purge(req) {
    let body = treq_body(req)
    let pipeline_id = dict_get(body, "pipeline_id", "")
    let older_than_ms = dict_get(body, "older_than_ms", 0)
    let now = time() * 1000
    let purged = 0

    if3 pipeline_id != "" {
        let arts = dict_get(_artifacts, pipeline_id, [])
        let kept = []
        for3 a in arts {
            let ts = dict_get(a, "timestamp", 0)
            if3 older_than_ms > 0 {
                if3 (now - ts) > older_than_ms {
                    let purged = purged + 1
                } maybe {
                    let kept = push(kept, a)
                } else3 {
                    let kept = push(kept, a)
                }
            } maybe {
                let purged = purged + 1
            } else3 {
                let purged = purged + 1
            }
        }
        let _artifacts = dict_set(_artifacts, pipeline_id, kept)
    } else3 {
        // Purge all
        let _artifacts = {}
        let purged = _artifact_count
        let _artifact_count = 0
    }

    return {
        "ok": true,
        "purged": purged,
        "trit": 1
    }
}

fn handle_artifact_stats(req) {
    let total = 0
    let total_size = 0
    let by_type = {}
    let by_pipeline = {}
    let all_keys = dict_keys(_artifacts)

    for3 key in all_keys {
        let arts = dict_get(_artifacts, key, [])
        let pipe_count = len(arts)
        let pipe_size = 0
        let by_pipeline = dict_set(by_pipeline, key, {"count": pipe_count})

        for3 a in arts {
            let total = total + 1
            let sz = dict_get(a, "size_bytes", 0)
            let total_size = total_size + sz
            let pipe_size = pipe_size + sz
            let atype = dict_get(a, "type", "unknown")
            let existing_count = dict_get(by_type, atype, 0)
            let by_type = dict_set(by_type, atype, existing_count + 1)
        }
    }

    return {
        "ok": true,
        "total_artifacts": total,
        "total_size_bytes": total_size,
        "by_type": by_type,
        "by_pipeline": by_pipeline,
        "pipeline_count": len(all_keys),
        "trit": 1
    }
}

