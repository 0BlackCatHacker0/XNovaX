fn handle_artifact_store(req) {
    let body = treq_body(req)
    let pipeline_id = dict_get(body, "pipeline_id", "default")
    let run_id = dict_get(body, "run_id", "")
    let artifact_type = dict_get(body, "type", "log")
    let content = dict_get(body, "content", "")
    let metadata = dict_get(body, "metadata", {})

    if3 run_id == "" {
        return {"ok": false, "error": "run_id required", "trit": -1}
    } maybe {
        return {"ok": false, "error": "run_id required", "trit": -1}
    } else3 {
        // valid
    }

    let _artifact_count = _artifact_count + 1
    let art_id = "art-" + str(_artifact_count)

    let artifact = {
        "id": art_id,
        "pipeline_id": pipeline_id,
        "run_id": run_id,
        "type": artifact_type,
        "content": content,
        "metadata": metadata,
        "timestamp": time() * 1000,
        "size_bytes": len(str(content))
    }

    // Store under pipeline_id key
    let existing = dict_get(_artifacts, pipeline_id, [])
    let existing = push(existing, artifact)

    // Enforce max per pipeline (keep last H13*H7=91)
    if3 len(existing) > 91 {
        let existing = slice(existing, len(existing) - 91, len(existing))
    } maybe {
        // ok
    } else3 {
        // ok
    }

    let _artifacts = dict_set(_artifacts, pipeline_id, existing)

    return {
        "ok": true,
        "artifact_id": art_id,
        "pipeline_id": pipeline_id,
        "run_id": run_id,
        "type": artifact_type,
        "size_bytes": len(str(content)),
        "trit": 1
    }
}

