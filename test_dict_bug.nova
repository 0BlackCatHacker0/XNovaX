// Minimal reproduction of dict-in-dict serialization bug
let stats = {
    "total": 5,
    "avg_Re": 3.14,
    "regime_counts": {"laminar": 3, "turbulent": 2}
}

// Test 1: Simple dict with nested dict value
let result1 = {
    "ok": true,
    "stats": stats,
    "extra": "hello"
}
print("Test 1 - dict with nested dict:")
print(json_encode(result1))

// Test 2: dict_set then embed
dict_set(stats, "total", 10)
let result2 = {
    "ok": true,
    "stats": stats
}
print("Test 2 - after dict_set mutation:")
print(json_encode(result2))

// Test 3: Underscore-prefixed dict
let _my_stats = {"a": 1, "b": 2}
let result3 = {
    "label": "test",
    "data": _my_stats
}
print("Test 3 - underscore prefix dict:")
print(json_encode(result3))
