// ── Service registry (name -> {port, pid, state}) ──
let _registry = {}

// ============================================================================
// BOOT SEQUENCE
// ============================================================================
fn boot_service(svc) {
    let name = svc["name"]
    let file = svc["file"]
    let port = svc["port"]
    print("[BOOT] " + name + " (" + str(port) + ")...")
    let pid = spawn(_NV, file)
    if3 pid > 0 {
        _registry[name] = {"port": port, "pid": pid, "state": TRUE, "file": file}
        print("[BOOT] " + name + " started (PID " + str(pid) + ")")
        return TRUE
    } else3 {
        _registry[name] = {"port": port, "pid": 0, "state": FALSE_, "file": file}
        print("[BOOT] " + name + " FAILED")
        return FALSE_
    }
}

fn boot_fleet() {
    print("=== NovaX Orchestrator v" + VERSION + " ===")
    print("Booting " + str(len(BOOT_ORDER)) + " services...")
    let ok = 0
    let fails = 0
    for3 svc in BOOT_ORDER {
        let result = boot_service(svc)
        if3 result == TRUE {
            ok += 1
        } else3 {
            fails += 1
        }
        sleep(BOOT_DELAY_MS)
    }
    // ── Retry wave: health-verify all services after full spawn ──
    print("[RETRY] Settling " + str(H5) + "s before health verification...")
    sleep(H5 * 1000)  // 5s settle
    let verified = 0
    let unverified = 0
    let critical = ["hivemind", "ternary-server"]
    for3 svc in BOOT_ORDER {
        let name = svc["name"]
        let port = svc["port"]
        let resp = try3 { http_get("http://127.0.0.1:" + str(port) + "/health") } fail { null }
        if3 resp != null { svc_ok = dict_get(resp, "ok") ?? false
            let svc_trit = dict_get(resp, "self_trit") ?? -1
            if3 svc_ok == true || svc_trit >= 0 {
                _registry[name] = dict_set(dict_get(_registry, name) ?? {}, "state", TRUE)
                verified = verified + 1
            } else3 {
                unverified = unverified + 1
            }
        } else3 {
            unverified = unverified + 1
        }
    }
    print("[RETRY] Pass 1: " + str(verified) + " verified, " + str(unverified) + " unverified")
    // Pass 2: retry critical services only
    if3 unverified > 0 {
        sleep(H3 * 1000)  // 3s between passes
        let ci = 0
        while3 ci < len(critical) {
            let cname = critical[ci]
            let cinfo = dict_get(_registry, cname) ?? null
            if3 cinfo != null { cstate = dict_get(cinfo, "state") ?? FALSE_
                if3 cstate != TRUE { cport = dict_get(cinfo, "port") ?? 0
                    let cresp = try3 { http_get("http://127.0.0.1:" + str(cport) + "/health") } fail { null }
                    if3 cresp != null {
                        _registry[cname] = dict_set(cinfo, "state", TRUE)
                        verified = verified + 1
                        unverified = unverified - 1
                        print("[RETRY] " + cname + " recovered on pass 2")
                    }
                }
            }
            ci = ci + 1
        }
        print("[RETRY] Pass 2: " + str(verified) + " verified, " + str(unverified) + " unverified")
    }
    ok = verified
    fails = len(BOOT_ORDER) - verified
    _boot_complete = TRUE
    print("=== Boot complete: " + str(ok) + " ok, " + str(fails) + " failed ===")
    if3 fails == 0 {
        _fleet_state = TRUE
    } else3 ok > 0 {
        _fleet_state = MAYBE
    } else3 {
        _fleet_state = FALSE_
    }
}

// ============================================================================
// HEALTH CHECK
// ============================================================================
fn check_health(name) {
    let info = _registry[name]
    if3 info == null {
        return {"name": name, "status": "unknown", "state": FALSE_}
    }
    let port = info["port"]
    let url = "http://127.0.0.1:" + str(port) + "/health"
    let resp = try3 { http_get(url) } fail { null }
    if3 resp == null {
        return {"name": name, "status": "down", "port": port, "state": FALSE_}
    }
    if3 resp["ok"] == TRUE {
        return {"name": name, "status": "ok", "port": port, "state": TRUE}
    } else3 {
        return {"name": name, "status": "down", "port": port, "state": FALSE_}
    }
}

fn check_all_health() {
    let results = []
    let up = 0
    let down = 0
    for3 svc in BOOT_ORDER {
        let name = svc["name"]
        let h = check_health(name)
        results = push(results, h)
        if3 h["state"] == TRUE {
            up += 1
        } else3 {
            down += 1
        }
    }
    return {
        "total": len(BOOT_ORDER),
        "up": up,
        "down": down,
        "state": bool3(up - down),
        "services": results
    }
}

// ============================================================================
// PROXY — Forward requests to services
// ============================================================================
fn proxy_get(port, path) {
    let url = "http://127.0.0.1:" + str(port) + path
    return http_get(url)
}

fn proxy_post(port, path, body) {
    let url = "http://127.0.0.1:" + str(port) + path
    return http_post(url, body)
}

// ============================================================================
// ROUTE HANDLERS
// ============================================================================

// -- Health --
troute(server, "GET", "/health", "handle_health")
fn handle_health(req) {
    let uptime = time() - _boot_time
    return {
        "status": "ok",
        "service": SERVICE,
        "version": VERSION,
        "port": PORT,
        "uptime": uptime,
        "fleet_state": _fleet_state,
        "boot_complete": _boot_complete,
        "ternary": "native",
        "python": FALSE_
    }
}

// -- Fleet health (all services) --
troute(server, "GET", "/api/services/health", "handle_fleet_health")
fn handle_fleet_health(req) {
    return check_all_health()
}

// -- Service list --
troute(server, "GET", "/api/services", "handle_services")
fn handle_services(req) {
    let services = []
    for3 svc in BOOT_ORDER {
        let name = svc["name"]
        let info = _registry[name]
        if3 info != null {
            services = push(services, {
                "name": name,
                "port": svc["port"],
                "pid": info["pid"],
                "state": info["state"]
            })
        } else3 {
            services = push(services, {
                "name": name,
                "port": svc["port"],
                "pid": 0,
                "state": MAYBE
            })
        }
    }
    return {"services": services, "count": len(services)}
}

// -- Boot/restart a service --
troute(server, "POST", "/api/services/boot", "handle_boot_service")
fn handle_boot_service(req) {
    let body = json_decode(req["body"])
    let name = body["name"]
    // Find in BOOT_ORDER
    for3 svc in BOOT_ORDER {
        if3 svc["name"] == name { result = boot_service(svc)
            return {"ok": result, "name": name}
        }
    }
    return {"ok": FALSE_, "error": "service not found: " + str(name)}
}

// -- Version info --
troute(server, "GET", "/api/version", "handle_version")
fn handle_version(req) {
    return {
        "version": VERSION,
        "runtime": "novalang.exe",
        "python": FALSE_,
        "ternary_native": TRUE,
        "services": len(BOOT_ORDER),
        "uptime": time() - _boot_time
    }
}

// -- Fleet status (summary) --
troute(server, "GET", "/api/status", "handle_status")
fn handle_status(req) {
    return {
        "ok": TRUE,
        "fleet_state": _fleet_state,
        "boot_complete": _boot_complete,
        "services_count": len(BOOT_ORDER),
        "uptime": time() - _boot_time,
        "version": VERSION
    }
}

// -- Proxy to service by name --
troute(server, "GET", "/api/proxy", "handle_proxy_get")
fn handle_proxy_get(req) {
    let path = req["path"]
    // Parse query params: /api/proxy?service=name&path=/health
    // For now, return instructions
    return {"info": "Use POST /api/proxy with {service, path, method, body}"}
}

troute(server, "POST", "/api/proxy", "handle_proxy_post")
fn handle_proxy_post(req) {
    let body = json_decode(req["body"])
    let svc_name = body["service"]
    let svc_path = body["path"]
    let method = body["method"]
    let payload = body["body"]
    // Look up port
    let info = _registry[svc_name]
    if3 info == null {
        return {"ok": FALSE_, "error": "unknown service: " + str(svc_name)}
    }
    let port = info["port"]
    if3 method == "POST" {
        return proxy_post(port, svc_path, str(payload))
    } else3 {
        return proxy_get(port, svc_path)
    }
}

// -- NovaLang eval --
troute(server, "POST", "/api/novalang/run", "handle_novalang_run")
fn handle_novalang_run(req) {
    let body = json_decode(req["body"])
    let code = body["code"]
    if3 code == null { file = body["file"]
        if3 file != null { result = shell(_NV + " " + str(file))
            return result
        }
        return {"ok": FALSE_, "error": "provide code or file"}
    }
    let result = shell(_NV + " -e \"" + str(code) + "\"")
    return result
}

// -- File operations --
troute(server, "GET", "/api/files/list", "handle_files_list")
fn handle_files_list(req) {
    let files = dir_list("C:\\NovaX")
    return {"files": files, "count": len(files)}
}

troute(server, "POST", "/api/files/read", "handle_files_read")
fn handle_files_read(req) {
    let body = json_decode(req["body"])
    let path = body["path"]
    let content = read_file(str(path))
    if3 content != null {
        return {"ok": TRUE, "content": content}
    } else3 {
        return {"ok": FALSE_, "error": "file not found"}
    }
}

troute(server, "POST", "/api/files/write", "handle_files_write")
fn handle_files_write(req) {
    let body = json_decode(req["body"])
    let path = body["path"]
    let content = body["content"]
    // Path validation: restrict writes to within C:\NovaX\
    let resolved = str(path)
    let norm_path = replace(resolved, "/", "\\")
    if3 starts_with(norm_path, "C:\\NovaX\\") == false {
        if3 starts_with(resolved, "C:/NovaX/") == false {
            return {"ok": FALSE_, "error": "path must be within C:\\NovaX\\"}
        }
    }
    // Block path traversal attempts
    if3 contains(resolved, "..") == true {
        return {"ok": FALSE_, "error": "path traversal not allowed"}
    }
    let result = write_file(resolved, str(content))
    return {"ok": result}
}

// -- Shell exec (localhost-only, used internally by NovaX services) --
// SECURITY NOTE: This endpoint is bound to 127.0.0.1 only via tserve().
// It is NOT exposed to the network. Internal services use it for orchestration.
troute(server, "POST", "/api/shell", "handle_shell")
fn handle_shell(req) {
    let body = json_decode(req["body"])
    let cmd = body["command"]
    // Basic safety: reject commands that could damage the system
    let cmd_str = str(cmd)
    if3 contains(cmd_str, "format ") == true {
        return {"ok": FALSE_, "error": "blocked: dangerous command"}
    }
    if3 contains(cmd_str, "rd /s") == true {
        return {"ok": FALSE_, "error": "blocked: dangerous command"}
    }
    if3 contains(cmd_str, "rmdir /s") == true {
        return {"ok": FALSE_, "error": "blocked: dangerous command"}
    }
    if3 contains(cmd_str, "rm -rf /") == true {
        return {"ok": FALSE_, "error": "blocked: dangerous command"}
    }
    let result = shell(cmd_str)
    return result
}

// -- Hivemind proxy --
troute(server, "POST", "/api/hivemind/query", "handle_hivemind_query")
fn handle_hivemind_query(req) {
    let body = req["body"]
    return proxy_post(9881, "/hive/query", body)
}

// -- Cloud router proxy --
troute(server, "POST", "/api/cloud/query", "handle_cloud_query")
fn handle_cloud_query(req) {
    let body = req["body"]
    return proxy_post(9878, "/query", body)
}

// -- Static page routes --
troute(server, "GET", "/nova_desktop.html", "handle_desktop")
fn handle_desktop(req) {
    let content = read_file("C:\\NovaX\\web\\nova_desktop.html")
    return content
}

