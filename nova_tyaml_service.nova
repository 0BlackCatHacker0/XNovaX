//
//                     HEALTH & STATUS ENDPOINTS
//
// ===========================================================================
// ===========================================================================


// ===========================================================================
// GET /health -- Standard health check endpoint
// Quick check: verify yq is available — pure NovaLang, zero Python
// ===========================================================================
fn health() {
    // Quick yq availability check
    let yaml_ok = true
    let check_cmd = "C:/NovaX/tools/yq.exe --version"
    let check_output = shell(check_cmd)

    if3 is_error(check_output) {
        yaml_ok = false
    }
    if3 contains(check_output, "yq") == false {
        yaml_ok = false
    }

    let counters = {}
    counters = dict_set(counters, "strong", stat_trit_true)
    counters = dict_set(counters, "partial", stat_trit_maybe)
    counters = dict_set(counters, "failed", stat_trit_false)
    let resp = ns_health_dict(SERVICE_NAME, VERSION, PORT, counters)
    resp = dict_set(resp, "runtime", "novalang")
    resp = dict_set(resp, "tools", TOOLS_COUNT)
    resp = dict_set(resp, "yaml_available", yaml_ok)
    return resp
}


// ===========================================================================
// GET /tyaml/service-status -- Full service status with stats and N-S flow
// ===========================================================================
fn tyaml_service_status() {
    let uptime = time() - stat_t0

    // Service Reynolds from total ops (N-S: config_flow = velocity_field)
    let re = compute_reynolds()
    let regime = flow_regime(re)

    // Schema complexity Reynolds (N-S: schema_complexity = turbulent_energy)
    let schema_re = schema_reynolds(ns_max_depth_seen, ns_total_keys_processed)
    let schema_regime = flow_regime(schema_re)

    // System trit assessment
    let sys_trit = T_TRUE
    if3 stat_trit_false > stat_trit_true {
        sys_trit = T_FALSE
    }
    if3 stat_trit_false == stat_trit_true {
        if3 stat_ops > 0 {
            sys_trit = T_MAYBE
        }
    }

    // Success rate
    let success_rate = 0
    if3 stat_ops > 0 {
        success_rate = int((stat_trit_true * 100) / stat_ops)
    }

    // Build by_tool breakdown
    let by_tool = {}
    by_tool = dict_set(by_tool, "parse", by_tool_parse)
    by_tool = dict_set(by_tool, "validate", by_tool_validate)
    by_tool = dict_set(by_tool, "convert", by_tool_convert)
    by_tool = dict_set(by_tool, "get", by_tool_get)
    by_tool = dict_set(by_tool, "set", by_tool_set)
    by_tool = dict_set(by_tool, "merge", by_tool_merge)
    by_tool = dict_set(by_tool, "keys", by_tool_keys)

    // Build trit distribution
    let trits = {}
    trits = dict_set(trits, "strong", stat_trit_true)
    trits = dict_set(trits, "partial", stat_trit_maybe)
    trits = dict_set(trits, "failed", stat_trit_false)

    // Build N-S flow info
    let ns_flow = {}
    ns_flow = dict_set(ns_flow, "config_flow_reynolds", re)
    ns_flow = dict_set(ns_flow, "config_flow_regime", regime)
    ns_flow = dict_set(ns_flow, "schema_complexity_reynolds", schema_re)
    ns_flow = dict_set(ns_flow, "schema_complexity_regime", schema_regime)
    ns_flow = dict_set(ns_flow, "total_keys_processed", ns_total_keys_processed)
    ns_flow = dict_set(ns_flow, "total_depth_traversed", ns_total_depth_traversed)
    ns_flow = dict_set(ns_flow, "max_depth_seen", ns_max_depth_seen)
    ns_flow = dict_set(ns_flow, "total_merges", ns_total_merges)
    ns_flow = dict_set(ns_flow, "total_conversions", ns_total_conversions)
    ns_flow = dict_set(ns_flow, "total_file_bytes", ns_total_file_bytes)

    // Build harmonics info
    let harmonics = {}
    harmonics = dict_set(harmonics, "H3", H3)
    harmonics = dict_set(harmonics, "H5", H5)
    harmonics = dict_set(harmonics, "H7", H7)
    harmonics = dict_set(harmonics, "H13", H13)
    harmonics = dict_set(harmonics, "BLOCK_SIZE", BLOCK_SIZE)
    harmonics = dict_set(harmonics, "MAX_BODY", MAX_BODY)
    harmonics = dict_set(harmonics, "MAX_DEPTH", MAX_DEPTH)
    harmonics = dict_set(harmonics, "MAX_FILE_BYTES", MAX_FILE_BYTES)

    // Build limits info
    let limits = {}
    limits = dict_set(limits, "max_body_bytes", MAX_BODY)
    limits = dict_set(limits, "max_depth", MAX_DEPTH)
    limits = dict_set(limits, "max_file_bytes", MAX_FILE_BYTES)
    limits = dict_set(limits, "yaml_timeout_s", YAML_TIMEOUT)
    limits = dict_set(limits, "safe_root", SAFE_ROOT)
    limits = dict_set(limits, "temp_dir", TEMP_DIR)

    return {
        "ok": true,
        "service": SERVICE_NAME,
        "version": VERSION,
        "port": PORT,
        "uptime_s": uptime,
        "total_ops": stat_ops,
        "success_rate_pct": success_rate,
        "by_tool": by_tool,
        "trits": trits,
        "ns_flow": ns_flow,
        "reynolds": re,
        "regime": regime,
        "system_trit": sys_trit,
        "system_char": bt_one(sys_trit),
        "system_bt3": bt_three(sys_trit),
        "harmonics": harmonics,
        "limits": limits,
        "runtime": "novalang",
        "block_size": BLOCK_SIZE
    }
}


// ===========================================================================
// Route registration
// ===========================================================================

// Health and status
troute(server, "GET",  "/health",                 "health")
troute(server, "GET",  "/tyaml/service-status",   "tyaml_service_status")

// 7 YAML/JSON/Config tools
troute(server, "POST", "/tyaml/parse",            "handle_parse")
troute(server, "POST", "/tyaml/validate",         "handle_validate")
troute(server, "POST", "/tyaml/convert",          "handle_convert")
troute(server, "POST", "/tyaml/get",              "handle_get")
troute(server, "POST", "/tyaml/set",              "handle_set")
troute(server, "POST", "/tyaml/merge",            "handle_merge")
troute(server, "POST", "/tyaml/keys",             "handle_keys")


