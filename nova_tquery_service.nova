}

// GET /health
fn handle_health(body) {
    let uptime   = round(time() - _t0, 2)

    let resp = ns_health_dict("nova-tquery", "1.0", PORT, {})
    resp = dict_set(resp, "tools", ["sql", "kv", "aggregate", "analyze", "csv", "json-query", "pivot"])
    resp = dict_set(resp, "self_trit", dict_get(resp, "trit") ?? 0)
    resp = dict_set(resp, "char", trit_char(dict_get(resp, "trit") ?? 0))
    resp = dict_set(resp, "uptime", int(uptime))
    resp = dict_set(resp, "total_ops", _ops)
    resp = dict_set(resp, "quality", {
        "strong": _trit_true,
        "partial": _trit_maybe,
        "failed": _trit_false
    })
    return resp
}

// GET /tquery/status
fn handle_status(body) {
    let uptime   = round(time() - _t0, 2)
    let kv_size  = len(keys(_kv))
    return {
        "ok": true, "service": "nova-tquery", "version": "1.0",
        "uptime": int(uptime),
        "total_ops": _ops,
        "queries_by_tool": _tool_counts,
        "kv_size": kv_size, "kv_writes": _kv_write_count,
        "db_path": DB_PATH, "kv_path": KV_PATH,
        "harmonics": {"H3": H3, "H5": H5, "H7": H7, "H13": H13},
        "tools": ["sql", "kv", "aggregate", "analyze", "csv", "json-query", "pivot"],
        "tool_count": TOOLS_COUNT,
        "quality": {
            "strong": _trit_true,
            "partial": _trit_maybe,
            "failed": _trit_false
        },
        "bt": "11011011011"
    }
}

// POST /tquery/clean -- manual KV sweep
fn handle_clean(body) {
    let purged = kv_sweep()
    let _p     = kv_persist()
    return {
        "ok": true, "trit": T_TRUE, "char": "1",
        "purged": purged, "kv_remaining": len(keys(_kv))
    }
}

// ============================================================
// Initialization
// ============================================================

// Load persisted KV data from disk
let _kv_loaded = kv_load()

// ============================================================
// Route Registration
// ============================================================
troute(server, "GET",  "/health",              "handle_health")
troute(server, "GET",  "/tquery/status",       "handle_status")
troute(server, "POST", "/tquery/sql",          "handle_sql")
troute(server, "POST", "/tquery/kv",           "handle_kv")
troute(server, "POST", "/tquery/aggregate",    "handle_aggregate")
troute(server, "POST", "/tquery/analyze",      "handle_analyze")
troute(server, "POST", "/tquery/csv",          "handle_csv")
troute(server, "POST", "/tquery/json-query",   "handle_json_query")
troute(server, "POST", "/tquery/pivot",        "handle_pivot")
troute(server, "POST", "/tquery/clean",        "handle_clean")

