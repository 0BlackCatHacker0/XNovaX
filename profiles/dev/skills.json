  "check_servers": {
    "name": "Check Server Status",
    "category": "system",
    "trigger_phrases": [
      "check servers",
      "server status",
      "are servers running",
      "ping servers"
    ],
    "steps": [
      {
        "driver": "terminal",
        "action": "run_command",
        "params": {
          "cmd": "netstat -ano | findstr :9990 & netstat -ano | findstr :9999 & netstat -ano | findstr :9877 & netstat -ano | findstr :18789"
        }
      }
    ],
    "description": "Checks all NovaX ports for active listeners"
  },
  "fix_openclaw": {
    "name": "Fix OpenClaw Config",
    "category": "system",
    "trigger_phrases": [
      "fix openclaw",
      "openclaw empty",
      "openclaw broken",
      "openclaw invisible"
    ],
    "steps": [
      {
        "driver": "terminal",
        "action": "run_command",
        "params": {
          "cmd": "openclaw upgrade"
        }
      },
      {
        "driver": "terminal",
        "action": "run_command",
        "params": {
          "cmd": "openclaw doctor --fix"
        }
      },
      {
        "driver": "terminal",
        "action": "run_command",
        "params": {
          "cmd": "openclaw gateway restart"
        }
      }
    ],
    "description": "Fixes OpenClaw invisible response bug from The_API_call_succeeded doc"
  },
