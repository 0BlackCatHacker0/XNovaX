{
  "_meta": {"profile": "dev", "description": "Developer workflow shortcuts"},
  "shortcuts": {
    "audit": {"description": "Run code audit on a file", "endpoint": "POST http://127.0.0.1:9938/audit/file", "body": {"file": "$FILE"}},
    "research": {"description": "Deep research query", "endpoint": "POST http://127.0.0.1:9939/research/query", "body": {"topic": "$QUERY"}},
    "migrate": {"description": "Generate v1.4 migration plan", "endpoint": "POST http://127.0.0.1:9939/research/migrate", "body": {"file": "$FILE"}},
    "health": {"description": "Check all services health", "endpoint": "GET http://127.0.0.1:9999/api/services/health"},
    "query": {"description": "Query AI via HiveMind", "endpoint": "POST http://127.0.0.1:9881/hive/query", "body": {"prompt": "$QUERY"}},
    "boot": {"description": "Boot full fleet", "endpoint": "POST http://127.0.0.1:9999/api/boot"}
  }
}
