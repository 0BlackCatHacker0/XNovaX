// N-S FLOW STATE
let _requests = 0
let _errors = 0
let _flow_window = []
let _reynolds = 0

// Reynolds number calculation
fn calculate_reynolds() {
    let density = len(_flow_window)
    let velocity = _requests
    let length = len(BOOT_ORDER)
    let viscosity = _errors + 1
    let re = (density * velocity) / (viscosity * length)
    return re
}

fn get_flow_regime() {
    let re = calculate_reynolds()
    if3 re < RE_LAMINAR { return "laminar" }
    if3 re < RE_TRANSITIONAL { return "transitional" }
    return "turbulent"
}

// Helper: build service entry dict (avoids dict literal in if3)
fn make_svc_entry(n, p, s, t) {
    let r = {}
    r = dict_set(r, "name", n)
    r = dict_set(r, "port", p)
    r = dict_set(r, "status", s)
    r = dict_set(r, "trit", t)
    return r
}

// Helper: build boot result entry
fn make_boot_entry(n, p, s, t, c) {
    let r = {}
    r = dict_set(r, "name", n)
    r = dict_set(r, "port", p)
    r = dict_set(r, "status", s)
    r = dict_set(r, "trit", t)
    r = dict_set(r, "char", c)
    return r
}

// Helper: build error response
fn err_resp(msg) {
    let r = {}
    r = dict_set(r, "ok", 0)
    r = dict_set(r, "error", msg)
    return r
}

// Helper: proxy error response
fn proxy_err(p, pa, st) {
    let r = {}
    r = dict_set(r, "ok", 0)
    r = dict_set(r, "error", "proxy_failed")
    r = dict_set(r, "port", p)
    r = dict_set(r, "path", pa)
    r = dict_set(r, "status", st)
    return r
}

// PROXY FUNCTIONS
fn proxy_get(port, path) {
    let url = "http://127.0.0.1:" + str(port) + path
    let result = try3 { http_get(url) } { {} }
    let status = try3 { dict_get(result, "status") } { 0 }
    if3 status == 200 {
        let body = try3 { dict_get(result, "body") } { "{}" }
        let decoded = try3 { json_decode(body) } { {} }
        return decoded
    }
    _errors = _errors + 1
    let pe = proxy_err(port, path, status)
    return pe
}

fn proxy_post(port, path, data) {
    let url = "http://127.0.0.1:" + str(port) + path
    let result = try3 { http_post(url, json_encode(data)) } { {} }
    let status = try3 { dict_get(result, "status") } { 0 }
    if3 status == 200 {
        let body = try3 { dict_get(result, "body") } { "{}" }
        let decoded = try3 { json_decode(body) } { {} }
        return decoded
    }
    _errors = _errors + 1
    let pe = proxy_err(port, path, status)
    return pe
}

// ROUTE RESOLVER (Chladni pattern matching)
fn resolve_route(path) {
    let prefixes = keys(PROXY_MAP)
    for3 prefix in prefixes {
        if3 starts_with(path, prefix) {
            return dict_get(PROXY_MAP, prefix)
        }
    }
    return 0
}

// HANDLERS

fn handle_root(req) {
    _requests = _requests + 1
    let r = {}
    r = dict_set(r, "status", "NovaX Orchestrator running")
    r = dict_set(r, "version", VERSION)
    r = dict_set(r, "runtime", "novalang")
    r = dict_set(r, "python", 0)
    r = dict_set(r, "trit", 1)
    return r
}

fn handle_health(req) {
    let r = {}
    r = dict_set(r, "ok", 1)
    r = dict_set(r, "service", SERVICE_NAME)
    r = dict_set(r, "version", VERSION)
    r = dict_set(r, "port", PORT)
    r = dict_set(r, "trit", 1)
    r = dict_set(r, "runtime", "novalang")
    r = dict_set(r, "reynolds", _reynolds)
    r = dict_set(r, "regime", get_flow_regime())
    return r
}

fn handle_status(req) {
    _requests = _requests + 1
    let healthy = 0
    let down = 0
    let degraded = 0
    let bt = ""
    let services = []

    for3 svc in BOOT_ORDER {
        let port = dict_get(svc, "port")
        let name = dict_get(svc, "name")
        let h = health3(port)
        if3 h == 1 {
            healthy = healthy + 1
            bt = bt + "1"
            services = append(services, make_svc_entry(name, port, "healthy", 1))
        }
        if3 h == 0 {
            degraded = degraded + 1
            bt = bt + "0"
            services = append(services, make_svc_entry(name, port, "degraded", 0))
        }
        if3 h == -1 {
            down = down + 1
            bt = bt + "T"
            services = append(services, make_svc_entry(name, port, "down", -1))
        }
    }

    // Check non-NovaLang services
    let extra_redis = health3(6379)
    if3 extra_redis == 1 {
        healthy = healthy + 1
        bt = bt + "1"
        services = append(services, make_svc_entry("Redis", 6379, "healthy", 1))
    }
    if3 extra_redis == 0 {
        degraded = degraded + 1
        bt = bt + "0"
        services = append(services, make_svc_entry("Redis", 6379, "degraded", 0))
    }
    if3 extra_redis == -1 {
        down = down + 1
        bt = bt + "T"
        services = append(services, make_svc_entry("Redis", 6379, "down", -1))
    }

    let extra_meili = health3(7700)
    if3 extra_meili == 1 {
        healthy = healthy + 1
        bt = bt + "1"
        services = append(services, make_svc_entry("Meilisearch", 7700, "healthy", 1))
    }
    if3 extra_meili == 0 {
        degraded = degraded + 1
        bt = bt + "0"
        services = append(services, make_svc_entry("Meilisearch", 7700, "degraded", 0))
    }
    if3 extra_meili == -1 {
        down = down + 1
        bt = bt + "T"
        services = append(services, make_svc_entry("Meilisearch", 7700, "down", -1))
    }

    let extra_ollama = health3(11434)
    if3 extra_ollama == 1 {
        healthy = healthy + 1
        bt = bt + "1"
        services = append(services, make_svc_entry("Ollama", 11434, "healthy", 1))
    }
    if3 extra_ollama == 0 {
        degraded = degraded + 1
        bt = bt + "0"
        services = append(services, make_svc_entry("Ollama", 11434, "degraded", 0))
    }
    if3 extra_ollama == -1 {
        down = down + 1
        bt = bt + "T"
        services = append(services, make_svc_entry("Ollama", 11434, "down", -1))
    }

    let extra_orch = health3(9999)
    if3 extra_orch == 1 {
        healthy = healthy + 1
        bt = bt + "1"
        services = append(services, make_svc_entry("orchestrator", 9999, "healthy", 1))
    }
    if3 extra_orch == 0 {
        degraded = degraded + 1
        bt = bt + "0"
        services = append(services, make_svc_entry("orchestrator", 9999, "degraded", 0))
    }
    if3 extra_orch == -1 {
        down = down + 1
        bt = bt + "T"
        services = append(services, make_svc_entry("orchestrator", 9999, "down", -1))
    }

    let overall = 1
    if3 down > H5 { overall = -1 }
    if3 degraded > H3 { overall = 0 }

    _reynolds = calculate_reynolds()

    let resp = {}
    resp = dict_set(resp, "bt", bt)
    resp = dict_set(resp, "healthy", healthy)
    resp = dict_set(resp, "down", down)
    resp = dict_set(resp, "degraded", degraded)
    resp = dict_set(resp, "overall_trit", overall)
    resp = dict_set(resp, "services", services)
    resp = dict_set(resp, "reynolds", _reynolds)
    resp = dict_set(resp, "regime", get_flow_regime())
    return resp
}

fn handle_boot(req) {
    _requests = _requests + 1
    let results = []
    let batch = 0

    for3 svc in BOOT_ORDER {
        let port = dict_get(svc, "port")
        let name = dict_get(svc, "name")
        let file = dict_get(svc, "file")

        let h = health3(port)
        if3 h == 1 {
            results = append(results, make_boot_entry(name, port, "already_running", 1, "1"))
        }
        if3 h != 1 {
            let cmd = "start /b C:/NovaX/novalang.exe C:/NovaX/" + file + " > NUL 2>&1"
            shell(cmd)
            results = append(results, make_boot_entry(name, port, "started", 0, "0"))
            batch = batch + 1
            if3 batch >= H3 {
                shell("timeout /t 2 /nobreak > NUL")
                batch = 0
            }
        }
    }

    let boot_bt = ""
    for3 r in results {
        boot_bt = boot_bt + dict_get(r, "char")
    }

    let resp = {}
    resp = dict_set(resp, "ok", 1)
    resp = dict_set(resp, "boot_bt", boot_bt)
    resp = dict_set(resp, "boot_trit", 1)
    resp = dict_set(resp, "services", results)
    return resp
}

fn handle_think(req) {
    _requests = _requests + 1
    let body = try3 { json_decode(req["body"]) } { req }
    let prompt = try3 { dict_get(body, "prompt") } { "" }
    let provider = try3 { dict_get(body, "provider") } { "cascade" }

    let q = {}
    q = dict_set(q, "prompt", prompt)
    q = dict_set(q, "provider", provider)
    q = dict_set(q, "max_tokens", 2048)
    return proxy_post(9878, "/query", q)
}

fn handle_execute(req) {
    _requests = _requests + 1
    let body = try3 { json_decode(req["body"]) } { req }
    let cmd = try3 { dict_get(body, "command") } { "" }
    if3 len(cmd) == 0 {
        let e = err_resp("no command")
        return e
    }
    return shell(cmd)
}

fn handle_novalang_run(req) {
    _requests = _requests + 1
    let body = try3 { json_decode(req["body"]) } { req }
    let code = try3 { dict_get(body, "code") } { "" }
    if3 len(code) == 0 {
        let e = err_resp("no code")
        return e
    }
    let tmp = "C:/NovaX/tmp_run_" + str(_requests) + ".nova"
    write_file(tmp, code)
    let result = shell("C:/NovaX/novalang.exe " + tmp)
    shell("del " + tmp + " 2>NUL")
    return result
}

fn handle_fs_list(req) {
    let body = try3 { json_decode(req["body"]) } { req }
    let path = try3 { dict_get(body, "path") } { "C:/NovaX" }
    let result = shell("dir /b \"" + path + "\"")
    let stdout = try3 { dict_get(result, "stdout") } { "" }
    let files = split(stdout, "\n")
    let resp = {}
    resp = dict_set(resp, "ok", 1)
    resp = dict_set(resp, "path", path)
    resp = dict_set(resp, "files", files)
    return resp
}

fn handle_fs_read(req) {
    let body = try3 { json_decode(req["body"]) } { req }
    let path = try3 { dict_get(body, "path") } { "" }
    if3 len(path) == 0 {
        let e = err_resp("no path")
        return e
    }
    let content = try3 { read_file(path) } { "" }
    let resp = {}
    resp = dict_set(resp, "ok", 1)
    resp = dict_set(resp, "path", path)
    resp = dict_set(resp, "content", content)
    return resp
}

fn handle_fs_write(req) {
    let body = try3 { json_decode(req["body"]) } { req }
    let path = try3 { dict_get(body, "path") } { "" }
    let content = try3 { dict_get(body, "content") } { "" }
    if3 len(path) == 0 {
        let e = err_resp("no path")
        return e
    }
    write_file(path, content)
    let resp = {}
    resp = dict_set(resp, "ok", 1)
    resp = dict_set(resp, "path", path)
    resp = dict_set(resp, "written", len(content))
    return resp
}

fn handle_system(req) {
    let result = shell("systeminfo")
    let stdout = try3 { dict_get(result, "stdout") } { "" }
    let resp = {}
    resp = dict_set(resp, "ok", 1)
    resp = dict_set(resp, "info", stdout)
    return resp
}

fn handle_processes(req) {
    let result = shell("tasklist")
    let stdout = try3 { dict_get(result, "stdout") } { "" }
    let resp = {}
    resp = dict_set(resp, "ok", 1)
    resp = dict_set(resp, "processes", stdout)
    return resp
}

// UNIVERSAL PROXY (Chladni-routed)
fn handle_api_proxy(req) {
    _requests = _requests + 1
    let path = req["path"]
    let method = req["method"]
    let port = resolve_route(path)

    if3 port == 0 {
        let e = {}
        e = dict_set(e, "ok", 0)
        e = dict_set(e, "error", "unknown route")
        e = dict_set(e, "path", path)
        e = dict_set(e, "trit", -1)
        return e
    }

    // Strip prefix, keep remainder
    let target = "/"
    let pfx = keys(PROXY_MAP)
    for3 p in pfx {
        if3 starts_with(path, p) {
            let rest = replace(path, p, "")
            if3 len(rest) > 0 { target = rest }
        }
    }

    if3 method == "GET" {
        return proxy_get(port, target)
    }

    let body = try3 { json_decode(req["body"]) } { {} }
    return proxy_post(port, target, body)
}

// SERVER
print("=== NOVA ORCHESTRATOR v" + VERSION + " ===")
print("Runtime: Pure NovaLang (zero Python)")
print("Port: " + str(PORT))
print("Services: " + str(len(BOOT_ORDER)))
print("Routes: " + str(len(keys(PROXY_MAP))) + " proxy + 17 direct")
print("N-S Flow: Reynolds routing, 3-5-7-13 harmonics")
print("Concurrency: H7 thread pool tserve")

let server = tserve(PORT, SERVICE_NAME)

troute(server, "GET", "/", "handle_root")
troute(server, "GET", "/health", "handle_health")
troute(server, "GET", "/api/status", "handle_status")
troute(server, "GET", "/api/services/health", "handle_status")
troute(server, "POST", "/api/services/boot", "handle_boot")
troute(server, "POST", "/think", "handle_think")
troute(server, "POST", "/nova/agent", "handle_think")
troute(server, "POST", "/execute", "handle_execute")
troute(server, "POST", "/api/run", "handle_execute")
troute(server, "POST", "/api/exec", "handle_execute")
troute(server, "POST", "/api/execute", "handle_execute")
troute(server, "POST", "/api/novalang/run", "handle_novalang_run")
troute(server, "GET", "/api/fs/list", "handle_fs_list")
troute(server, "POST", "/api/fs/read", "handle_fs_read")
troute(server, "POST", "/api/fs/write", "handle_fs_write")
troute(server, "GET", "/api/system", "handle_system")
troute(server, "GET", "/api/processes", "handle_processes")

// Universal proxy catches all /api/* routes
troute(server, "GET", "/api/*", "handle_api_proxy")
troute(server, "POST", "/api/*", "handle_api_proxy")

print("Orchestrator online. Ternary flow active.")
tstart(server)
