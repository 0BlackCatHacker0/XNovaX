let prompts = [
  "Explain ternary computing and why it is superior to binary",
  "What is the mathematical significance of 3 5 7 and 13",
  "Write a sorting algorithm using ternary comparisons",
  "How do Navier-Stokes equations model fluid dynamics",
  "Explain Reynolds number and flow regime classification",
  "What is AES-256-GCM encryption and how does it work",
  "Design a microservice architecture for an AI OS",
  "Explain knowledge distillation in machine learning",
  "What is balanced ternary notation",
  "How does HMAC-SHA256 provide message authentication",
  "Explain standing waves in physics",
  "What is PBKDF2 and why 100000 iterations",
  "How can 1.2 million AI models be distilled into one"
]

let success = 0
let i = 0

while3 i < len(prompts) {
  let prompt = prompts[i]
  let body = json_encode({"prompt": prompt})
  let headers = {"Content-Type": "application/json"}
  let result = try3 { http_request("http://127.0.0.1:9878/api/v1/query", body, headers, 20000) } fail { {"ok": -1} }
  let resp_body = dict_get(result, "body") ?? ""
  
  if3 len(resp_body) > 10 {
    let parsed = try3 { json_decode(resp_body) } fail { {} }
    let provider = dict_get(parsed, "provider") ?? "unknown"
    let response = dict_get(parsed, "response") ?? ""
    
    if3 len(response) > 3 {
      let entry = json_encode({"prompt": prompt, "response": response, "provider": provider, "model": dict_get(parsed, "model") ?? "", "trit": 1, "id": i + 1})
      write_file("C:/NovaX/data/super_archive/harvest_" + str(i + 1) + ".json", entry)
      success = success + 1
      print("H" + str(i + 1) + ": +1 " + provider + " (" + str(len(response)) + " chars)")
      
      // Also ripple to Tripple
      let ripple_body = json_encode({"provider": provider, "trit": 1, "latency": 0})
      let rh = {"Content-Type": "application/json"}
      let _rip = try3 { http_request("http://127.0.0.1:9881/hive/tripple/ripple", ripple_body, rh, 3000) } fail { {} }
    } else3 {
      print("H" + str(i + 1) + ": -1 empty")
    }
  } else3 {
    print("H" + str(i + 1) + ": -1 no body")
  }
  
  sleep(7000)
  i = i + 1
}

print("")
print("HARVEST: " + str(success) + "/" + str(len(prompts)))
print("Archive: C:/NovaX/data/super_archive/")
