// NovaLang VM Test — ternary-first operations
// Tests: variables, ternary logic, if3, for3, match3, builtins, balanced ternary

// ── Basic Variables ──
let name = "NovaLang VM"
let version = "1.0.0"
print("=== " + name + " v" + version + " ===")

// ── Ternary Constants ──
let t = TRUE
let m = MAYBE
let f = FALSE_
print("Trit values:", t, m, f)

// ── Ternary Logic (bool3, not3, and3, or3) ──
let a = bool3(42)
let b = bool3(0)
let c = bool3(-5)
print("bool3(42):", a, "bool3(0):", b, "bool3(-5):", c)
print("not3(TRUE):", not3(TRUE), "not3(FALSE_):", not3(FALSE_), "not3(MAYBE):", not3(MAYBE))
print("and3(TRUE, MAYBE):", and3(TRUE, MAYBE))
print("or3(FALSE_, MAYBE):", or3(FALSE_, MAYBE))

// ── Arithmetic ──
let x = 7 * 13
let y = 3 + 5
print("7 * 13 =", x, "| 3 + 5 =", y)

// ── if3 Branching ──
let score = 75
if3 score > 90 {
    print("Grade: A")
} else3 score > 70 {
    print("Grade: B")
} else {
    print("Grade: C")
}

// ── for3 Loop ──
let total = 0
for3 i in range(1, 8) {
    total += i
}
print("Sum 1..7 =", total)

// ── match3 Pattern Matching ──
let status = bool3(1)
match3 status {
    +1 => {
        print("Status: POSITIVE (TRUE)")
    }
    0 => {
        print("Status: NEUTRAL (MAYBE)")
    }
    -1 => {
        print("Status: NEGATIVE (FALSE)")
    }
}

// ── Balanced Ternary ──
let encoded = bt_encode(42)
print("bt_encode(42):", encoded)
let decoded = bt_decode(encoded)
print("bt_decode back:", decoded)

// ── 3-5-7-13 Harmonic Constants ──
print("H3:", H3, "H5:", H5, "H7:", H7, "H13:", H13)
print("BLOCK_SIZE (3^7):", BLOCK)

// ── List & Dict ──
let items = [1, 2, 3, 4, 5]
print("List:", items)
print("Length:", len(items))
let config = {"name": "NovaX", "port": 9999, "ternary": TRUE}
print("Dict:", config)

// ── String Operations ──
let greeting = "hello novaX world"
print("Upper:", upper(greeting))
print("Contains 'novaX':", contains(greeting, "novaX"))
let parts = split(greeting, " ")
print("Split:", parts)
print("Join:", join(parts, "-"))

// ── Functions ──
fn fibonacci(n) {
    if3 n <= 1 {
        return n
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}
print("fibonacci(10):", fibonacci(10))

// ── Hash ──
print("hash('NovaX'):", hash("NovaX"))

// ── Type System ──
print("type(42):", type(42))
print("type(TRUE):", type(TRUE))
print("type('hello'):", type("hello"))

print("\n=== ALL TESTS PASSED ===")
