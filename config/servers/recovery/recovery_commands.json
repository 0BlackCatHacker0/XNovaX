{
  "PostgreSQL": {
    "port": 5432,
    "check": "pg_isready -h 127.0.0.1 -p 5432",
    "restart": "net stop postgresql-x64-17 && net start postgresql-x64-17",
    "log": "C:/Program Files/PostgreSQL/17/data/log/",
    "config": "C:/Program Files/PostgreSQL/17/data/postgresql.conf"
  },
  "Redis": {
    "port": 6379,
    "check": "redis-cli ping",
    "restart": "taskkill /F /IM redis-server.exe & C:/NovaX/servers/redis/redis-server.exe --port 6379 --bind 127.0.0.1 --daemonize no",
    "log": "C:\\NovaX\\config\\servers/logs/redis.log",
    "config": "C:\\NovaX\\config\\servers/redis/redis.conf"
  },
  "NATS": {
    "port": 4222,
    "check": "curl -s http://127.0.0.1:8222/varz",
    "restart": "taskkill /F /IM nats-server.exe & C:/NovaX/servers/nats/nats-server-v2.10.24-windows-amd64/nats-server.exe -a 127.0.0.1 -p 4222",
    "log": "C:\\NovaX\\config\\servers/logs/nats.log",
    "config": "C:\\NovaX\\config\\servers/nats/nats.conf"
  },
  "Meilisearch": {
    "port": 7700,
    "check": "curl -s http://127.0.0.1:7700/health",
    "restart": "taskkill /F /IM meilisearch.exe & C:/NovaX/servers/meilisearch/meilisearch.exe --http-addr 127.0.0.1:7700 --db-path C:/NovaX/servers/meilisearch/data.ms",
    "log": "C:\\NovaX\\config\\servers/logs/meilisearch.log",
    "config": "C:\\NovaX\\config\\servers/meilisearch/meilisearch.conf"
  },
  "Mosquitto": {
    "port": 1883,
    "check": "netstat -an | findstr 1883",
    "restart": "net stop mosquitto && net start mosquitto",
    "log": "C:/Program Files/mosquitto/mosquitto.log",
    "config": "C:/Program Files/mosquitto/mosquitto.conf"
  },
  "Caddy": {
    "port": 8080,
    "check": "curl -s http://127.0.0.1:8080/",
    "restart": "taskkill /F /IM caddy.exe & C:/NovaX/servers/caddy/caddy.exe run --config C:/NovaX/config/servers/caddy/Caddyfile",
    "log": "C:\\NovaX\\config\\servers/logs/caddy.log",
    "config": "C:\\NovaX\\config\\servers/caddy/Caddyfile"
  },
  "MinIO": {
    "port": 9000,
    "check": "curl -s http://127.0.0.1:9000/minio/health/live",
    "restart": "taskkill /F /IM minio.exe & set MINIO_ROOT_USER=novax && set MINIO_ROOT_PASSWORD=novax_s3cure && C:/NovaX/servers/minio/minio.exe server C:/NovaX/servers/minio/data --address :9000 --console-address :9001",
    "log": "C:\\NovaX\\config\\servers/logs/minio.log",
    "config": "env: MINIO_ROOT_USER, MINIO_ROOT_PASSWORD"
  },
  "Prometheus": {
    "port": 9090,
    "check": "curl -s http://127.0.0.1:9090/-/healthy",
    "restart": "taskkill /F /IM prometheus.exe & C:/NovaX/servers/prometheus/prometheus.exe --config.file=C:/NovaX/config/servers/prometheus/prometheus.yml",
    "log": "C:\\NovaX\\config\\servers/logs/prometheus.log",
    "config": "C:\\NovaX\\config\\servers/prometheus/prometheus.yml"
  },
  "Grafana": {
    "port": 3000,
    "check": "curl -s http://127.0.0.1:3000/api/health",
    "restart": "taskkill /F /IM grafana.exe & C:/NovaX/servers/grafana/bin/grafana.exe server --homepath C:/NovaX/servers/grafana",
    "log": "C:\\NovaX\\config\\servers/logs/grafana.log",
    "config": "C:/NovaX/servers/grafana/conf/defaults.ini"
  },
  "Gitea": {
    "port": 3001,
    "check": "curl -s http://127.0.0.1:3001/api/v1/version",
    "restart": "taskkill /F /IM gitea.exe & C:/NovaX/servers/gitea/gitea.exe --port 3001",
    "log": "C:\\NovaX\\config\\servers/logs/gitea.log",
    "config": "C:\\NovaX\\config\\servers/gitea/app.ini"
  },
  "Node-RED": {
    "port": 1880,
    "check": "curl -s http://127.0.0.1:1880/",
    "restart": "taskkill /F /IM node.exe /FI \"WINDOWTITLE eq node-red\" & npx node-red -p 1880",
    "log": "C:\\NovaX\\config\\servers/logs/node-red.log",
    "config": "~/.node-red/settings.js"
  },
  "Ollama": {
    "port": 11434,
    "check": "curl -s http://127.0.0.1:11434/api/tags",
    "restart": "ollama serve",
    "log": "~/.ollama/logs/server.log",
    "config": "env: OLLAMA_HOST"
  }
}