{
  "version": "1.0",
  "description": "NovaX Self-Healing Automation Triggers",
  "rules": [
    {
      "event": "port_down",
      "action": "restart",
      "max_retries": 3,
      "cooldown_sec": 30
    },
    {
      "event": "health_fail",
      "action": "restart",
      "max_retries": 3,
      "cooldown_sec": 60
    },
    {
      "event": "process_crash",
      "action": "log_and_restart",
      "max_retries": 5,
      "cooldown_sec": 15
    },
    {
      "event": "config_change",
      "action": "graceful_restart",
      "max_retries": 1,
      "cooldown_sec": 5
    },
    {
      "event": "dependency_missing",
      "action": "auto_install",
      "max_retries": 1,
      "cooldown_sec": 0
    },
    {
      "event": "disk_full_90pct",
      "action": "rotate_logs",
      "max_retries": 1,
      "cooldown_sec": 300
    },
    {
      "event": "memory_high_85pct",
      "action": "alert_and_log",
      "max_retries": 1,
      "cooldown_sec": 120
    }
  ],
  "notification": {
    "method": "novax_ui",
    "escalation": "openclaw_prompt"
  }
}