{
    admin off
    auto_https off
}

# ============================================
# NOVAX UNIFIED GATEWAY - Port 8080
# All services accessible via /service-name/
# ============================================
:8080 {
    # --- Dashboard Home ---
    handle / {
        respond "NovaX Unified Server Gateway - 16 Services Online" 200
    }

    # --- DATABASE LAYER ---
    handle_path /grafana/* {
        reverse_proxy 127.0.0.1:3000
    }
    handle_path /prometheus/* {
        reverse_proxy 127.0.0.1:9090
    }

    # --- SOURCE CONTROL ---
    handle_path /gitea/* {
        reverse_proxy 127.0.0.1:3001
    }

    # --- SEARCH ENGINE ---
    handle_path /search/* {
        reverse_proxy 127.0.0.1:7700
    }

    # --- OBJECT STORAGE ---
    handle_path /minio/* {
        reverse_proxy 127.0.0.1:9000
    }
    handle_path /minio-console/* {
        reverse_proxy 127.0.0.1:9001
    }

    # --- AUTOMATION ---
    handle_path /nodered/* {
        reverse_proxy 127.0.0.1:1880
    }

    # --- AI MODELS ---
    handle_path /ollama/* {
        reverse_proxy 127.0.0.1:11434
    }

    # --- MESSAGING ---
    handle_path /nats/* {
        reverse_proxy 127.0.0.1:8222
    }

    # --- NOVAX CORE ---
    handle_path /novax/* {
        reverse_proxy 127.0.0.1:9999
    }
    handle_path /brain/* {
        reverse_proxy 127.0.0.1:9990
    }

    # --- OPENCLAW ---
    handle_path /openclaw/* {
        reverse_proxy 127.0.0.1:18789
    }

    # --- HEALTH ENDPOINT ---
    handle /health {
        respond "OK" 200
    }

    # --- CORS Headers ---
    header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization"
    }

    log {
        output file C:/NovaX/config/servers/logs/caddy-access.log
        format json
    }
}
