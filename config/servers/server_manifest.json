{
  "version": "1.0",
  "name": "NovaX Unified Server Stack",
  "created": "2026-02-22",
  "dependency_order": [
    "postgresql",
    "redis",
    "nats",
    "meilisearch",
    "ollama",
    "novax-brain",
    "novax-bridge",
    "novax-ws",
    "mosquitto",
    "gitea",
    "minio",
    "prometheus",
    "grafana",
    "caddy",
    "node-red"
  ],
  "services": {
    "postgresql": {
      "port": 5432,
      "binary": "pg_ctl",
      "config": "C:\\NovaX\\config\\servers/postgresql",
      "health": "http://127.0.0.1:5432",
      "health_type": "tcp",
      "log": "C:\\NovaX\\config\\servers/logs/postgresql.log",
      "restart": "pg_ctl restart -D C:/PostgreSQL/data",
      "category": "database",
      "priority": 1
    },
    "redis": {
      "port": 6379,
      "binary": "C:\\NovaX\\servers/redis/redis-server.exe",
      "config": "C:\\NovaX\\config\\servers/redis/redis.conf",
      "health": "http://127.0.0.1:6379",
      "health_type": "tcp",
      "log": "C:\\NovaX\\config\\servers/logs/redis.log",
      "restart_cmd": "C:\\NovaX\\servers/redis/redis-server.exe C:\\NovaX\\config\\servers/redis/redis.conf",
      "category": "cache",
      "priority": 2
    },
    "nats": {
      "port": 4222,
      "monitor_port": 8222,
      "binary": "C:\\NovaX\\servers/nats/nats-server.exe",
      "config": "C:\\NovaX\\config\\servers/nats/nats.conf",
      "health": "http://127.0.0.1:8222/varz",
      "health_type": "http",
      "log": "C:\\NovaX\\config\\servers/logs/nats.log",
      "restart_cmd": "C:\\NovaX\\servers/nats/nats-server.exe -c C:\\NovaX\\config\\servers/nats/nats.conf",
      "category": "messaging",
      "priority": 3
    },
    "meilisearch": {
      "port": 7700,
      "binary": "C:\\NovaX\\servers/meilisearch/meilisearch.exe",
      "config": "C:\\NovaX\\config\\servers/meilisearch/meilisearch.env",
      "health": "http://127.0.0.1:7700/health",
      "health_type": "http",
      "log": "C:\\NovaX\\config\\servers/logs/meilisearch.log",
      "restart_cmd": "C:\\NovaX\\servers/meilisearch/meilisearch.exe --http-addr 127.0.0.1:7700 --db-path C:\\NovaX\\config\\servers/meilisearch/data",
      "category": "search",
      "priority": 4
    },
    "ollama": {
      "port": 11434,
      "binary": "ollama",
      "health": "http://127.0.0.1:11434/api/tags",
      "health_type": "http",
      "log": "C:\\NovaX\\config\\servers/logs/ollama.log",
      "restart_cmd": "ollama serve",
      "category": "ai",
      "priority": 5
    },
    "novax-brain": {
      "port": 9990,
      "binary": "python",
      "health": "http://127.0.0.1:9990/status",
      "health_type": "http",
      "log": "C:\\NovaX\\config\\servers/logs/novax-brain.log",
      "restart_cmd": "C:/NovaX/ai_env/Scripts/python.exe C:/NovaX/novax/main.py",
      "category": "core",
      "priority": 6
    },
    "novax-bridge": {
      "port": 9999,
      "health": "http://127.0.0.1:9999/api/status",
      "health_type": "http",
      "category": "core",
      "priority": 7
    },
    "novax-ws": {
      "port": 9998,
      "health_type": "tcp",
      "category": "core",
      "priority": 8
    },
    "mosquitto": {
      "port": 1883,
      "binary": "C:/Program Files/mosquitto/mosquitto.exe",
      "config": "C:\\NovaX\\config\\servers/mosquitto/mosquitto.conf",
      "health_type": "tcp",
      "log": "C:\\NovaX\\config\\servers/logs/mosquitto.log",
      "restart_cmd": "\"C:/Program Files/mosquitto/mosquitto.exe\" -c C:\\NovaX\\config\\servers/mosquitto/mosquitto.conf",
      "category": "iot",
      "priority": 9
    },
    "gitea": {
      "port": 3001,
      "binary": "C:\\NovaX\\servers/gitea/gitea.exe",
      "config": "C:\\NovaX\\config\\servers/gitea/app.ini",
      "health": "http://127.0.0.1:3001/api/v1/version",
      "health_type": "http",
      "log": "C:\\NovaX\\config\\servers/logs/gitea.log",
      "restart_cmd": "C:\\NovaX\\servers/gitea/gitea.exe --config C:\\NovaX\\config\\servers/gitea/app.ini",
      "category": "devtools",
      "priority": 10
    },
    "minio": {
      "port": 9000,
      "console_port": 9001,
      "binary": "C:\\NovaX\\servers/minio/minio.exe",
      "config": "C:\\NovaX\\config\\servers/minio/minio.env",
      "health": "http://127.0.0.1:9000/minio/health/live",
      "health_type": "http",
      "log": "C:\\NovaX\\config\\servers/logs/minio.log",
      "restart_cmd": "C:\\NovaX\\servers/minio/minio.exe server C:\\NovaX\\config\\servers/minio/data --address :9000 --console-address :9001",
      "category": "storage",
      "priority": 11
    },
    "prometheus": {
      "port": 9090,
      "binary": "C:\\NovaX\\servers/prometheus/prometheus.exe",
      "config": "C:\\NovaX\\config\\servers/prometheus/prometheus.yml",
      "health": "http://127.0.0.1:9090/-/healthy",
      "health_type": "http",
      "log": "C:\\NovaX\\config\\servers/logs/prometheus.log",
      "category": "monitoring",
      "priority": 12
    },
    "grafana": {
      "port": 3000,
      "binary": "C:\\NovaX\\servers/grafana/grafana-v11.5.2/bin/grafana-server.exe",
      "config": "C:\\NovaX\\config\\servers/grafana/grafana.ini",
      "health": "http://127.0.0.1:3000/api/health",
      "health_type": "http",
      "log": "C:\\NovaX\\config\\servers/logs/grafana.log",
      "restart_cmd": "C:\\NovaX\\servers/grafana/grafana-v11.5.2/bin/grafana-server.exe --config C:\\NovaX\\config\\servers/grafana/grafana.ini --homepath C:\\NovaX\\servers/grafana/grafana-v11.5.2",
      "category": "monitoring",
      "priority": 13
    },
    "caddy": {
      "port": 8080,
      "admin_port": 2019,
      "binary": "C:\\NovaX\\servers/caddy/caddy.exe",
      "config": "C:\\NovaX\\config\\servers/caddy/Caddyfile",
      "health": "http://127.0.0.1:8080/health",
      "health_type": "http",
      "log": "C:\\NovaX\\config\\servers/logs/caddy.log",
      "restart_cmd": "C:\\NovaX\\servers/caddy/caddy.exe run --config C:\\NovaX\\config\\servers/caddy/Caddyfile",
      "category": "proxy",
      "priority": 14
    },
    "node-red": {
      "port": 1880,
      "binary": "node-red",
      "health": "http://127.0.0.1:1880",
      "health_type": "http",
      "log": "C:\\NovaX\\config\\servers/logs/node-red.log",
      "restart_cmd": "node-red --port 1880",
      "category": "automation",
      "priority": 15
    }
  },
  "port_map": {
    "5432": "postgresql",
    "6379": "redis",
    "4222": "nats",
    "8222": "nats-monitor",
    "7700": "meilisearch",
    "11434": "ollama",
    "9990": "novax-brain",
    "9999": "novax-bridge",
    "9998": "novax-ws",
    "1883": "mosquitto",
    "3001": "gitea",
    "9000": "minio",
    "9001": "minio-console",
    "9090": "prometheus",
    "3000": "grafana",
    "8080": "caddy",
    "2019": "caddy-admin",
    "1880": "node-red"
  }
}