    let result = handle_logs(body)
    return result
}

fn route_inspect(req) {
    let body = treq_body(req)
    let result = handle_inspect(body)
    return result
}

fn route_compose(req) {
    let body = treq_body(req)
    let result = handle_compose(body)
    return result
}

fn route_exec(req) {
    let body = treq_body(req)
    let result = handle_exec(body)
    return result
}

// ===========================================================================
// GET /health -- Standard health endpoint
// ===========================================================================
fn health() {
    let uptime = time() - stat_t0

    // Check if Docker daemon is accessible
    let docker_alive = check_docker_alive()

    let self_trit = T_MAYBE
    if3 uptime > 10 {
        if3 docker_alive == true {
            self_trit = T_TRUE
        }
        if3 docker_alive == false {
            self_trit = T_MAYBE
        }
    }
    if3 docker_alive == false {
        if3 uptime > 10 {
            self_trit = T_MAYBE
        }
    }

    return {
        "ok": true,
        "service": SERVICE_NAME,
        "port": PORT,
        "version": VERSION,
        "ternary": true,
        "runtime": "novalang",
        "docker_alive": docker_alive,
        "harmonics": {"H3": H3, "H5": H5, "H7": H7, "H13": H13},
        "tools": TOOLS_COUNT,
        "self_trit": self_trit,
        "char": bt_one(self_trit),
        "uptime_s": uptime,
        "quality": {
            "strong": stat_trit_true,
            "partial": stat_trit_maybe,
            "failed": stat_trit_false
        }
    }
}

// ===========================================================================
// GET /tdocker/service-status -- Full service status with stats
// ===========================================================================
fn tdocker_service_status() {
    let uptime = time() - stat_t0

    // Service Reynolds from total false ops
    let re = stat_trit_false * H5
    if3 re > 999 {
        re = 999
    }
    let regime = flow_regime(re)

    // System trit
    let sys_trit = T_TRUE
    if3 stat_trit_false > stat_trit_true {
        sys_trit = T_FALSE
    }
    if3 stat_trit_false == stat_trit_true {
        if3 stat_ops > 0 {
            sys_trit = T_MAYBE
        }
    }

    // Check Docker daemon
    let docker_alive = check_docker_alive()
    if3 docker_alive == false {
        sys_trit = T_MAYBE
    }

    let by_tool = {}
    dict_set(by_tool, "images", by_tool_images)
    dict_set(by_tool, "containers", by_tool_containers)
    dict_set(by_tool, "run", by_tool_run)
    dict_set(by_tool, "stop", by_tool_stop)
    dict_set(by_tool, "build", by_tool_build)
    dict_set(by_tool, "logs", by_tool_logs)
    dict_set(by_tool, "inspect", by_tool_inspect)
    dict_set(by_tool, "compose", by_tool_compose)
    dict_set(by_tool, "exec", by_tool_exec)
    dict_set(by_tool, "push", by_tool_push)
    dict_set(by_tool, "network", by_tool_network)
    dict_set(by_tool, "volume", by_tool_volume)

    // Cached containers
    let cached_containers = keys(_container_cache)

    return {
        "ok": true,
        "service": SERVICE_NAME,
        "version": VERSION,
        "port": PORT,
        "uptime_s": uptime,
        "docker_alive": docker_alive,
        "total_ops": stat_ops,
        "by_tool": by_tool,
        "trits": {
            "strong": stat_trit_true,
            "partial": stat_trit_maybe,
            "failed": stat_trit_false
        },
        "cached_containers": len(cached_containers),
        "reynolds": re,
        "regime": regime,
        "system_trit": sys_trit,
        "system_char": bt_one(sys_trit),
        "harmonics": {"H3": H3, "H5": H5, "H7": H7, "H13": H13},
        "ns_mapping": {
            "container_stream": "velocity_field",
            "resource_pressure": "turbulent_energy",
            "reynolds_formula": "container_ops * H5"
        },
        "runtime": "novalang",
        "block_size": BLOCK_SIZE
    }
}

// ===========================================================================
// TIER 5: /tdocker/push -- Push image to registry
// ===========================================================================
fn handle_push(body) {
    let image = dict_get(body, "image", "")
    let registry = dict_get(body, "registry", "")
    let tag = dict_get(body, "tag", "latest")

    if3 len(image) == 0 {
        record_stat("push", T_FALSE)
        return {
            "ok": false,
            "action": "push",
            "error": "image name required (e.g. myapp:latest)",
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "runtime": "novalang"
        }
    }

    // Build full image reference: registry/image:tag or image:tag
    let full_ref = image
    if3 len(registry) > 0 {
        full_ref = registry + "/" + image
    }
    // Append tag if not already in image name
    if3 contains(full_ref, ":") == false {
        full_ref = full_ref + ":" + tag
    }

    // If registry provided, tag first then push
    let push_output = ""
    if3 len(registry) > 0 {
        let tag_cmd = "docker tag " + image + " " + full_ref + " 2>&1"
        let tag_raw = nova_run(tag_cmd, H13 * H5)
        let tag_out = trim(str(tag_raw))
        if3 is_docker_error(tag_out) == true {
            record_stat("push", T_FALSE)
            return {
                "ok": false,
                "action": "push",
                "image": image,
                "full_ref": full_ref,
                "error": "tag failed: " + tag_out,
                "trit": T_FALSE,
                "char": bt_one(T_FALSE),
                "runtime": "novalang"
            }
        }
    }

    // Execute push (extended timeout -- pushes can be slow)
    let push_cmd = "docker push " + full_ref + " 2>&1"
    let push_timeout = H13 * H13
    let raw = nova_run(push_cmd, push_timeout)
    push_output = trim(str(raw))

    if3 is_docker_error(push_output) == true {
        record_stat("push", T_FALSE)
        return {
            "ok": false,
            "action": "push",
            "image": full_ref,
            "error": push_output,
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "runtime": "novalang"
        }
    }

    // Check for success indicators
    let lc_out = lower(push_output)
    let push_ok = false
    if3 contains(lc_out, "pushed") {
        push_ok = true
    }
    if3 contains(lc_out, "digest:") {
        push_ok = true
    }
    if3 contains(lc_out, "latest:") {
        push_ok = true
    }

    let push_trit = T_MAYBE
    if3 push_ok == true {
        push_trit = T_TRUE
    }

    record_stat("push", push_trit)
    return {
        "ok": true,
        "action": "push",
        "image": full_ref,
        "output": push_output,
        "trit": push_trit,
        "char": bt_one(push_trit),
        "runtime": "novalang"
    }
}

// ===========================================================================
// TIER 5: /tdocker/network -- Docker network management
// ===========================================================================
fn handle_network(body) {
    let action = dict_get(body, "action", "list")
    let name = dict_get(body, "name", "")
    let driver = dict_get(body, "driver", "bridge")
    let container = dict_get(body, "container", "")

    if3 action == "list" {
        let cmd = "docker network ls --format \"{{.ID}}|{{.Name}}|{{.Driver}}|{{.Scope}}\" 2>&1"
        let raw = nova_run(cmd, H13)
        let out = trim(str(raw))
        if3 is_docker_error(out) == true {
            record_stat("network", T_FALSE)
            return {"ok": false, "action": "list", "error": out, "trit": T_FALSE, "char": bt_one(T_FALSE), "runtime": "novalang"}
        }
        let lines = split(out, "\n")
        let networks = []
        let ni = 0
        while3 ni < len(lines) {
            let line = trim(dict_get(lines, ni, ""))
            if3 len(line) > 0 {
                let parts = split(line, "|")
                if3 len(parts) >= 4 {
                    append(networks, {
                        "id": dict_get(parts, 0, ""),
                        "name": dict_get(parts, 1, ""),
                        "driver": dict_get(parts, 2, ""),
                        "scope": dict_get(parts, 3, "")
                    })
                }
            }
            ni = ni + 1
        }
        record_stat("network", T_TRUE)
        return {"ok": true, "action": "list", "networks": networks, "count": len(networks), "trit": T_TRUE, "char": bt_one(T_TRUE), "runtime": "novalang"}
    }

    if3 action == "create" {
        if3 len(name) == 0 {
            record_stat("network", T_FALSE)
            return {"ok": false, "action": "create", "error": "network name required", "trit": T_FALSE, "char": bt_one(T_FALSE), "runtime": "novalang"}
        }
        let cmd = "docker network create --driver " + driver + " " + name + " 2>&1"
        let raw = nova_run(cmd, H13)
        let out = trim(str(raw))
        if3 is_docker_error(out) == true {
            record_stat("network", T_FALSE)
            return {"ok": false, "action": "create", "name": name, "error": out, "trit": T_FALSE, "char": bt_one(T_FALSE), "runtime": "novalang"}
        }
        record_stat("network", T_TRUE)
        return {"ok": true, "action": "create", "name": name, "driver": driver, "network_id": out, "trit": T_TRUE, "char": bt_one(T_TRUE), "runtime": "novalang"}
    }

    if3 action == "remove" {
        if3 len(name) == 0 {
            record_stat("network", T_FALSE)
            return {"ok": false, "action": "remove", "error": "network name required", "trit": T_FALSE, "char": bt_one(T_FALSE), "runtime": "novalang"}
        }
        let cmd = "docker network rm " + name + " 2>&1"
        let raw = nova_run(cmd, H13)
        let out = trim(str(raw))
        if3 is_docker_error(out) == true {
            record_stat("network", T_FALSE)
            return {"ok": false, "action": "remove", "name": name, "error": out, "trit": T_FALSE, "char": bt_one(T_FALSE), "runtime": "novalang"}
        }
        record_stat("network", T_TRUE)
        return {"ok": true, "action": "remove", "name": name, "trit": T_TRUE, "char": bt_one(T_TRUE), "runtime": "novalang"}
    }

    if3 action == "connect" {
        if3 len(name) == 0 {
            record_stat("network", T_FALSE)
            return {"ok": false, "action": "connect", "error": "network name required", "trit": T_FALSE, "char": bt_one(T_FALSE), "runtime": "novalang"}
        }
        if3 len(container) == 0 {
            record_stat("network", T_FALSE)
            return {"ok": false, "action": "connect", "error": "container name required", "trit": T_FALSE, "char": bt_one(T_FALSE), "runtime": "novalang"}
        }
        let cmd = "docker network connect " + name + " " + container + " 2>&1"
        let raw = nova_run(cmd, H13)
        let out = trim(str(raw))
        if3 is_docker_error(out) == true {
            record_stat("network", T_FALSE)
            return {"ok": false, "action": "connect", "network": name, "container": container, "error": out, "trit": T_FALSE, "char": bt_one(T_FALSE), "runtime": "novalang"}
        }
        record_stat("network", T_TRUE)
        return {"ok": true, "action": "connect", "network": name, "container": container, "trit": T_TRUE, "char": bt_one(T_TRUE), "runtime": "novalang"}
    }

    if3 action == "disconnect" {
        if3 len(name) == 0 {
            record_stat("network", T_FALSE)
            return {"ok": false, "action": "disconnect", "error": "network name required", "trit": T_FALSE, "char": bt_one(T_FALSE), "runtime": "novalang"}
        }
        if3 len(container) == 0 {
            record_stat("network", T_FALSE)
            return {"ok": false, "action": "disconnect", "error": "container name required", "trit": T_FALSE, "char": bt_one(T_FALSE), "runtime": "novalang"}
        }
        let cmd = "docker network disconnect " + name + " " + container + " 2>&1"
        let raw = nova_run(cmd, H13)
        let out = trim(str(raw))
        if3 is_docker_error(out) == true {
            record_stat("network", T_FALSE)
            return {"ok": false, "action": "disconnect", "network": name, "container": container, "error": out, "trit": T_FALSE, "char": bt_one(T_FALSE), "runtime": "novalang"}
        }
        record_stat("network", T_TRUE)
        return {"ok": true, "action": "disconnect", "network": name, "container": container, "trit": T_TRUE, "char": bt_one(T_TRUE), "runtime": "novalang"}
    }

    record_stat("network", T_FALSE)
    return {"ok": false, "action": action, "error": "unknown action: use list/create/remove/connect/disconnect", "trit": T_FALSE, "char": bt_one(T_FALSE), "runtime": "novalang"}
}

// ===========================================================================
// TIER 5: /tdocker/volume -- Docker volume management
// ===========================================================================
fn handle_volume(body) {
    let action = dict_get(body, "action", "list")
    let name = dict_get(body, "name", "")
    let driver = dict_get(body, "driver", "local")

    if3 action == "list" {
        let cmd = "docker volume ls --format \"{{.Name}}|{{.Driver}}|{{.Mountpoint}}\" 2>&1"
        let raw = nova_run(cmd, H13)
        let out = trim(str(raw))
        if3 is_docker_error(out) == true {
            record_stat("volume", T_FALSE)
            return {"ok": false, "action": "list", "error": out, "trit": T_FALSE, "char": bt_one(T_FALSE), "runtime": "novalang"}
        }
        let lines = split(out, "\n")
        let volumes = []
        let vi = 0
        while3 vi < len(lines) {
            let line = trim(dict_get(lines, vi, ""))
            if3 len(line) > 0 {
                let parts = split(line, "|")
                if3 len(parts) >= 3 {
                    append(volumes, {
                        "name": dict_get(parts, 0, ""),
                        "driver": dict_get(parts, 1, ""),
                        "mountpoint": dict_get(parts, 2, "")
                    })
                }
            }
            vi = vi + 1
        }
        record_stat("volume", T_TRUE)
        return {"ok": true, "action": "list", "volumes": volumes, "count": len(volumes), "trit": T_TRUE, "char": bt_one(T_TRUE), "runtime": "novalang"}
    }

    if3 action == "create" {
        if3 len(name) == 0 {
            record_stat("volume", T_FALSE)
            return {"ok": false, "action": "create", "error": "volume name required", "trit": T_FALSE, "char": bt_one(T_FALSE), "runtime": "novalang"}
        }
        let cmd = "docker volume create --driver " + driver + " " + name + " 2>&1"
        let raw = nova_run(cmd, H13)
        let out = trim(str(raw))
        if3 is_docker_error(out) == true {
            record_stat("volume", T_FALSE)
            return {"ok": false, "action": "create", "name": name, "error": out, "trit": T_FALSE, "char": bt_one(T_FALSE), "runtime": "novalang"}
        }
        record_stat("volume", T_TRUE)
        return {"ok": true, "action": "create", "name": name, "driver": driver, "trit": T_TRUE, "char": bt_one(T_TRUE), "runtime": "novalang"}
    }

    if3 action == "remove" {
        if3 len(name) == 0 {
            record_stat("volume", T_FALSE)
            return {"ok": false, "action": "remove", "error": "volume name required", "trit": T_FALSE, "char": bt_one(T_FALSE), "runtime": "novalang"}
        }
        let cmd = "docker volume rm " + name + " 2>&1"
        let raw = nova_run(cmd, H13)
        let out = trim(str(raw))
        if3 is_docker_error(out) == true {
            record_stat("volume", T_FALSE)
            return {"ok": false, "action": "remove", "name": name, "error": out, "trit": T_FALSE, "char": bt_one(T_FALSE), "runtime": "novalang"}
        }
        record_stat("volume", T_TRUE)
        return {"ok": true, "action": "remove", "name": name, "trit": T_TRUE, "char": bt_one(T_TRUE), "runtime": "novalang"}
    }

    if3 action == "inspect" {
        if3 len(name) == 0 {
            record_stat("volume", T_FALSE)
            return {"ok": false, "action": "inspect", "error": "volume name required", "trit": T_FALSE, "char": bt_one(T_FALSE), "runtime": "novalang"}
        }
        let cmd = "docker volume inspect " + name + " 2>&1"
        let raw = nova_run(cmd, H13)
        let out = trim(str(raw))
        if3 is_docker_error(out) == true {
            record_stat("volume", T_FALSE)
            return {"ok": false, "action": "inspect", "name": name, "error": out, "trit": T_FALSE, "char": bt_one(T_FALSE), "runtime": "novalang"}
        }
        record_stat("volume", T_TRUE)
        return {"ok": true, "action": "inspect", "name": name, "details": out, "trit": T_TRUE, "char": bt_one(T_TRUE), "runtime": "novalang"}
    }

    if3 action == "prune" {
        let cmd = "docker volume prune -f 2>&1"
        let raw = nova_run(cmd, H13 * H5)
        let out = trim(str(raw))
        if3 is_docker_error(out) == true {
            record_stat("volume", T_FALSE)
            return {"ok": false, "action": "prune", "error": out, "trit": T_FALSE, "char": bt_one(T_FALSE), "runtime": "novalang"}
        }
        record_stat("volume", T_TRUE)
        return {"ok": true, "action": "prune", "output": out, "trit": T_TRUE, "char": bt_one(T_TRUE), "runtime": "novalang"}
    }

    record_stat("volume", T_FALSE)
    return {"ok": false, "action": action, "error": "unknown action: use list/create/remove/inspect/prune", "trit": T_FALSE, "char": bt_one(T_FALSE), "runtime": "novalang"}
}

