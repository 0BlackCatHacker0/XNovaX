troute(server, "POST", "/tdocker/containers",       "handle_containers")
troute(server, "POST", "/tdocker/run",              "handle_run")
troute(server, "POST", "/tdocker/stop",             "handle_stop")
troute(server, "POST", "/tdocker/build",            "handle_build")
troute(server, "POST", "/tdocker/logs",             "handle_logs")
troute(server, "POST", "/tdocker/inspect",          "handle_inspect")
troute(server, "POST", "/tdocker/compose",          "handle_compose")
troute(server, "POST", "/tdocker/exec",             "handle_exec")
troute(server, "POST", "/tdocker/push",             "handle_push")
troute(server, "POST", "/tdocker/network",          "handle_network")
troute(server, "POST", "/tdocker/volume",           "handle_volume")

