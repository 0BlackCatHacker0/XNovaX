// NovaX TYAML Service v1.0 - Ternary YAML/JSON/Config Processing (NovaLang)
// Port 9921: YAML and JSON config file operations through ternary-native micro-tools
//
// 7 ternary-native YAML/JSON/Config tools on 3-5-7-13 harmonic constants:
//   1. /tyaml/parse     -- Parse YAML file/string to JSON
//   2. /tyaml/validate  -- Validate YAML syntax (valid/invalid with error details)
//   3. /tyaml/convert   -- Convert between YAML<->JSON (yaml2json / json2yaml)
//   4. /tyaml/get       -- Get a value by dot-path from YAML/JSON
//   5. /tyaml/set       -- Set a value by dot-path in YAML/JSON (write back)
//   6. /tyaml/merge     -- Merge two YAML/JSON files (base + overlay)
//   7. /tyaml/keys      -- List all keys at a given depth
//
// N-S Mapping:
//   config_flow        = velocity_field (config data flowing through parse/transform)
//   schema_complexity  = turbulent_energy (nested depth, key count, merge conflicts)
//   Reynolds(yaml)     = config_ops * H5
//   RE_LAMINAR=27      = simple flat configs (few keys, shallow)
//   RE_TRANSITION=125  = moderate configs (nested, moderate key count)
//   RE_TURBULENT=343   = complex configs (deep nesting, many keys, merges)
//
// Harmonics:
//   MAX_BODY      = BLOCK * H5 = 2187 * 5 = 10935
//   MAX_DEPTH     = H13 = 13 (maximum nesting depth for key listing)
//   MAX_FILE_BYTES = BLOCK * H13 = 2187 * 13 = 28431
//   YAML_TIMEOUT  = H13 = 13s (python command timeout)
//   TEMP_DIR      = C:\NovaX\tmp\tyaml (temp files for text-based input)
//
// Endpoints:
//   GET  /health                -- Health check
//   GET  /tyaml/service-status  -- Full service status with stats
//   POST /tyaml/parse           -- Parse YAML to JSON
//   POST /tyaml/validate        -- Validate YAML syntax
//   POST /tyaml/convert         -- Convert YAML<->JSON
//   POST /tyaml/get             -- Get value by dot-path
//   POST /tyaml/set             -- Set value by dot-path
//   POST /tyaml/merge           -- Merge two YAML/JSON files
//   POST /tyaml/keys            -- List keys at depth

let PORT = 9921
let server = tserve(PORT, "TYAML v1.0 - Ternary YAML/JSON/Config Processing")

// -- 3-5-7-13 Harmonic Constants --
let H3  = 3
let H5  = 5
let H7  = 7
let H13 = 13

// -- Ternary State Constants --
let T_TRUE  =  1
let T_MAYBE =  0
let T_FALSE = -1

// -- Reynolds flow boundaries (N-S) --
let BLOCK_SIZE      = 2187
let RE_LAMINAR      = 27
let RE_TRANSITION   = 125
let RE_TURBULENT    = 343

// -- Service Constants --
let TOOLS_COUNT     = 7
let VERSION         = "1.0.0"
let SERVICE_NAME    = "nova-tyaml"
let YAML_TIMEOUT    = 13
let MAX_BODY        = 10935
let MAX_DEPTH       = 13
let MAX_FILE_BYTES  = 28431
let TEMP_DIR        = "C:\\NovaX\\data"
let SAFE_ROOT       = "C:\\NovaX"

// -- Global Stats --
let stat_ops         = 0
let stat_trit_true   = 0
let stat_trit_maybe  = 0
let stat_trit_false  = 0
let stat_t0          = time()

// by_tool counters (one per tool)
let by_tool_parse    = 0
let by_tool_validate = 0
let by_tool_convert  = 0
let by_tool_get      = 0
let by_tool_set      = 0
let by_tool_merge    = 0
let by_tool_keys     = 0

// -- N-S flow tracking --
let ns_total_keys_processed    = 0
let ns_total_depth_traversed   = 0
let ns_total_merges            = 0
let ns_total_conversions       = 0
let ns_max_depth_seen          = 0
let ns_total_file_bytes        = 0

// -- Temp file counter for unique names --
let _temp_counter = 0


// ===========================================================================
// HELPER: balanced ternary char from trit (+, ~, T)
// ===========================================================================
fn bt_one(t) {
    if3 t == T_TRUE {
        return "+"
    }
    if3 t == T_MAYBE {
        return "~"
    }
    return "T"
}

// ===========================================================================
// HELPER: balanced ternary 3-char representation
// Encodes trit value into 3-char balanced ternary string
// ===========================================================================
fn bt_three(t) {
    if3 t == T_TRUE {
        return "+0+"
    }
    if3 t == T_MAYBE {
        return "000"
    }
    if3 t == T_FALSE {
        return "T0T"
    }
    // For numeric values, simple encoding
    if3 t > 0 {
        return "+++"
    }
    if3 t < 0 {
        return "TTT"
    }
    return "000"
}

// ===========================================================================
// HELPER: compute Reynolds number for config operations
// N-S: config_flow = velocity_field, Re = ops * H5
// ===========================================================================
fn compute_reynolds() {
    let re = stat_ops * H5
    if3 re > 999 {
        re = 999
    }
    if3 re < 0 {
        re = 0
    }
    return re
}

// ===========================================================================
// HELPER: flow regime from Reynolds number
// ===========================================================================
fn flow_regime(re_num) {
    if3 re_num < RE_LAMINAR {
        return "laminar"
    }
    if3 re_num < RE_TRANSITION {
        return "transitional"
    }
    if3 re_num < RE_TURBULENT {
        return "turbulent"
    }
    return "chaotic"
}

// ===========================================================================
// HELPER: record a stat operation
// Increments global counters and per-tool counters
// ===========================================================================
fn record_op(tool_name, trit) {
    stat_ops = stat_ops + 1
    if3 trit == T_TRUE {
        stat_trit_true = stat_trit_true + 1
    }
    if3 trit == T_MAYBE {
        stat_trit_maybe = stat_trit_maybe + 1
    }
    if3 trit == T_FALSE {
        stat_trit_false = stat_trit_false + 1
    }
    if3 tool_name == "parse" {
        by_tool_parse = by_tool_parse + 1
    }
    if3 tool_name == "validate" {
        by_tool_validate = by_tool_validate + 1
    }
    if3 tool_name == "convert" {
        by_tool_convert = by_tool_convert + 1
    }
    if3 tool_name == "get" {
        by_tool_get = by_tool_get + 1
    }
    if3 tool_name == "set" {
        by_tool_set = by_tool_set + 1
    }
    if3 tool_name == "merge" {
        by_tool_merge = by_tool_merge + 1
    }
    if3 tool_name == "keys" {
        by_tool_keys = by_tool_keys + 1
    }
}

// ===========================================================================
// HELPER: escape a file path for use inside python single-quoted strings
// Replaces backslash with double-backslash, then single-quote with escaped
// ===========================================================================
fn escape_for_py(s) {
    let escaped = replace(s, "\\", "\\\\")
    escaped = replace(escaped, "'", "\\'")
    return escaped
}

// ===========================================================================
// HELPER: check if output indicates a python/yaml error
// Returns true if the output looks like an error, false otherwise
// ===========================================================================
fn is_error(output) {
    if3 starts_with(output, "Error:") {
        return true
    }
    if3 starts_with(output, "Traceback") {
        return true
    }
    if3 contains(output, "yaml.scanner.ScannerError") {
        return true
    }
    if3 contains(output, "yaml.parser.ParserError") {
        return true
    }
    if3 contains(output, "yaml.reader.ReaderError") {
        return true
    }
    if3 contains(output, "yaml.composer.ComposerError") {
        return true
    }
    if3 contains(output, "FileNotFoundError") {
        return true
    }
    if3 contains(output, "PermissionError") {
        return true
    }
    if3 contains(output, "IsADirectoryError") {
        return true
    }
    if3 contains(output, "OSError") {
        return true
    }
    if3 contains(output, "IOError") {
        return true
    }
    if3 contains(output, "json.decoder.JSONDecodeError") {
        return true
    }
    if3 contains(output, "ValueError") {
        return true
    }
    if3 contains(output, "TypeError") {
        return true
    }
    if3 contains(output, "KeyError") {
        return true
    }
    if3 contains(output, "IndexError") {
        return true
    }
    if3 contains(output, "AttributeError") {
        return true
    }
    if3 contains(output, "ModuleNotFoundError") {
        return true
    }
    if3 contains(output, "ImportError") {
        return true
    }
    let lc = lower(output)
    if3 starts_with(lc, "error") {
        return true
    }
    if3 contains(lc, "traceback (most recent call last)") {
        return true
    }
    return false
}

// ===========================================================================
// HELPER: run a shell command with standard YAML timeout
// Returns trimmed output string
// ===========================================================================
fn run_cmd(cmd) {
    let raw = nova_run(cmd, YAML_TIMEOUT)
    let output = trim(str(raw))
    return output
}

// ===========================================================================
// HELPER: generate a unique temp file path for text-based input
// Creates files in TEMP_DIR with incrementing counter
// ===========================================================================
fn make_temp_path(ext) {
    _temp_counter = _temp_counter + 1
    let ts = str(int(time()))
    let name = "tyaml_tmp_" + ts + "_" + str(_temp_counter) + "." + ext
    let path = TEMP_DIR + "\\" + name
    return path
}

// ===========================================================================
// HELPER: write text content to a temp file via python
// Returns the temp file path on success, or error string
// ===========================================================================
fn write_temp_file(text, ext) {
    let tmp_path = make_temp_path(ext)
    // Use NovaLang's native nova_write — handles all escaping properly
    nova_write(tmp_path, text)
    return tmp_path
}

// ===========================================================================
// HELPER: delete a temp file via python
// ===========================================================================
fn delete_temp_file(path) {
    let esc_path = escape_for_py(path)
    let del_cmd = "python -c \"import os; os.remove('" + esc_path + "') if os.path.exists('" + esc_path + "') else None; print('ok')\""
    let del_out = run_cmd(del_cmd)
    return del_out
}

// ===========================================================================
// HELPER: validate that a path starts with SAFE_ROOT
// Returns true if safe, false if escapes
// ===========================================================================
fn is_safe_path(path) {
    if3 len(path) == 0 {
        return false
    }
    let safe_len = len(SAFE_ROOT)
    if3 len(path) < safe_len {
        return false
    }
    let prefix = slice(path, 0, safe_len)
    if3 prefix == SAFE_ROOT {
        return true
    }
    // Also allow temp directory paths (which are under SAFE_ROOT anyway)
    return false
}

// ===========================================================================
// HELPER: determine if input has a path or text, resolve to a file path
// If "path" key is present, use it directly
// If "text" key is present, write to temp file and return temp path
// Returns dict with "path" (resolved path) and "is_temp" (boolean)
// On error, returns dict with "error" key
// ===========================================================================
fn resolve_input(body, path_key, text_key) {
    let file_path = str(dict_get(body, path_key, ""))
    let text_val = str(dict_get(body, text_key, ""))

    let result = {}
    if3 len(file_path) > 0 {
        // Use file path directly
        dict_set(result, "path", file_path)
        dict_set(result, "is_temp", false)
        dict_set(result, "source", "file")
        return result
    }
    if3 len(text_val) > 0 {
        // Write text to temp file
        let tmp = write_temp_file(text_val, "yaml")
        if3 starts_with(tmp, "Error:") {
            dict_set(result, "error", tmp)
            return result
        }
        dict_set(result, "path", tmp)
        dict_set(result, "is_temp", true)
        dict_set(result, "source", "text")
        return result
    }

    // Neither path nor text provided
    dict_set(result, "error", "either '" + path_key + "' or '" + text_key + "' parameter is required")
    return result
}

// ===========================================================================
// HELPER: clean up temp file if needed
// ===========================================================================
fn cleanup_temp(resolved) {
    let is_temp = dict_get(resolved, "is_temp", false)
    if3 is_temp == true {
        let tmp_path = dict_get(resolved, "path", "")
        if3 len(tmp_path) > 0 {
            let _del = delete_temp_file(tmp_path)
        }
    }
}

// ===========================================================================
// HELPER: compute schema complexity Reynolds
// Based on depth, key count, and file size
// N-S: schema_complexity = turbulent_energy
// ===========================================================================
fn schema_reynolds(depth, key_count) {
    let complexity = (depth * depth * H3) + (key_count * H5)
    if3 complexity > 999 {
        complexity = 999
    }
    if3 complexity < 0 {
        complexity = 0
    }
    return complexity
}

// ===========================================================================
// HELPER: extract error detail from python traceback output
// Returns a cleaner single-line error message
// ===========================================================================
fn extract_error_detail(output) {
    // If output contains a colon-separated error, extract last line
    let lines = split(output, "\n")
    let line_count = len(lines)
    if3 line_count == 0 {
        return output
    }
    // Walk from the end to find the actual error line
    let idx = line_count - 1
    while3 idx >= 0 {
        let line = trim(dict_get(lines, idx, ""))
        if3 len(line) > 0 {
            // Check if this line looks like an error message
            if3 contains(line, "Error") {
                return line
            }
            if3 contains(line, "error") {
                return line
            }
            if3 contains(line, "Exception") {
                return line
            }
        }
        idx = idx - 1
    }
    // Fallback: return first non-empty line
    let first_idx = 0
    while3 first_idx < line_count {
        let first_line = trim(dict_get(lines, first_idx, ""))
        if3 len(first_line) > 0 {
            return first_line
        }
        first_idx = first_idx + 1
    }
    return output
}

// ===========================================================================
// HELPER: check if a string looks like it might be JSON
// ===========================================================================
fn looks_like_json(text) {
    let trimmed = trim(text)
    if3 starts_with(trimmed, "{") {
        return true
    }
    if3 starts_with(trimmed, "[") {
        return true
    }
    return false
}

// ===========================================================================
// HELPER: determine file extension from path
// ===========================================================================
fn get_extension(path) {
    let parts = split(path, ".")
    let part_count = len(parts)
    if3 part_count < 2 {
        return ""
    }
    let last_idx = part_count - 1
    let ext = lower(dict_get(parts, last_idx, ""))
    return ext
}

// ===========================================================================
// HELPER: check if a file extension is YAML
// ===========================================================================
fn is_yaml_ext(ext) {
    if3 ext == "yaml" {
        return true
    }
    if3 ext == "yml" {
        return true
    }
    return false
}

// ===========================================================================
// HELPER: check if a file extension is JSON
// ===========================================================================
fn is_json_ext(ext) {
    if3 ext == "json" {
        return true
    }
    return false
}

// ===========================================================================
// HELPER: validate dot-path key (no empty segments, reasonable length)
// ===========================================================================
fn is_valid_dotpath(key) {
    if3 len(key) == 0 {
        return false
    }
    if3 len(key) > 256 {
        return false
    }
    // Check for empty segments (consecutive dots)
    if3 contains(key, "..") {
        return false
    }
    // Check it doesn't start or end with dot
    if3 starts_with(key, ".") {
        return false
    }
    // Count segments to check depth
    let segments = split(key, ".")
    let seg_count = len(segments)
    if3 seg_count > MAX_DEPTH {
        return false
    }
    // Check each segment is non-empty
    let si = 0
    while3 si < seg_count {
        let seg = dict_get(segments, si, "")
        if3 len(seg) == 0 {
            return false
        }
        si = si + 1
    }
    return true
}

// ===========================================================================
// HELPER: sanitize a value for safe embedding in Python command
// Handles basic types: string, number, boolean, null
// Returns a python-safe representation
// ===========================================================================
fn to_py_value(value) {
    let val_str = str(value)
    let val_type = type(value)

    // Boolean handling
    if3 val_str == "true" {
        return "True"
    }
    if3 val_str == "false" {
        return "False"
    }
    if3 val_str == "null" {
        return "None"
    }
    if3 val_str == "none" {
        return "None"
    }

    // Check if it looks numeric
    // Try int conversion
    if3 val_type == "int" {
        return val_str
    }
    if3 val_type == "float" {
        return val_str
    }

    // Default: treat as string, properly quoted
    let escaped_val = escape_for_py(val_str)
    return "'" + escaped_val + "'"
}


// ===========================================================================
// ===========================================================================
//
//                     TOOL HANDLERS (7 TOOLS)
//
// ===========================================================================
// ===========================================================================


// ===========================================================================
// TOOL 1: POST /tyaml/parse
// Parse YAML file or string to JSON output
// Body: {path: "file.yaml"} OR {text: "yaml content..."}
// Trit: +1=parsed successfully, 0=empty/null result, -1=parse error
// ===========================================================================
fn handle_parse(body) {
    // Resolve input to a file path
    let resolved = resolve_input(body, "path", "text")

    // Check for resolution error
    let res_error = dict_get(resolved, "error", "")
    if3 len(res_error) > 0 {
        record_op("parse", T_FALSE)
        return {
            "ok": false,
            "tool": "parse",
            "error": res_error,
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "bt3": bt_three(T_FALSE),
            "runtime": "novalang"
        }
    }

    let file_path = dict_get(resolved, "path", "")
    let source = dict_get(resolved, "source", "unknown")
    let esc_path = escape_for_py(file_path)

    // Build python command to parse YAML to JSON
    let py_cmd = "python -c \"import yaml,json,sys; "
    py_cmd = py_cmd + "data=yaml.safe_load(open('" + esc_path + "','r',encoding='utf-8')); "
    py_cmd = py_cmd + "print(json.dumps(data, default=str, indent=2, ensure_ascii=False))\""

    let output = run_cmd(py_cmd)

    // Clean up temp file if applicable
    cleanup_temp(resolved)

    // Check for errors
    if3 is_error(output) {
        let error_detail = extract_error_detail(output)
        record_op("parse", T_FALSE)
        return {
            "ok": false,
            "tool": "parse",
            "source": source,
            "error": error_detail,
            "raw_error": output,
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "bt3": bt_three(T_FALSE),
            "runtime": "novalang"
        }
    }

    // Check for null/empty result
    let trimmed_output = trim(output)
    if3 trimmed_output == "null" {
        record_op("parse", T_MAYBE)
        ns_total_keys_processed = ns_total_keys_processed + 0
        return {
            "ok": true,
            "tool": "parse",
            "source": source,
            "data": "null",
            "note": "YAML document parsed but contains null/empty content",
            "trit": T_MAYBE,
            "char": bt_one(T_MAYBE),
            "bt3": bt_three(T_MAYBE),
            "runtime": "novalang"
        }
    }

    if3 len(trimmed_output) == 0 {
        record_op("parse", T_MAYBE)
        return {
            "ok": true,
            "tool": "parse",
            "source": source,
            "data": "null",
            "note": "YAML document parsed but produced empty output",
            "trit": T_MAYBE,
            "char": bt_one(T_MAYBE),
            "bt3": bt_three(T_MAYBE),
            "runtime": "novalang"
        }
    }

    // Count approximate keys (count occurrences of quote-colon patterns)
    // Simple heuristic: count lines with ":" in the JSON output
    let output_lines = split(output, "\n")
    let key_count = 0
    let li = 0
    while3 li < len(output_lines) {
        let line = dict_get(output_lines, li, "")
        if3 contains(line, ":") {
            key_count = key_count + 1
        }
        li = li + 1
    }

    // Track N-S flow
    ns_total_keys_processed = ns_total_keys_processed + key_count

    // Reynolds for this parse op
    let re = schema_reynolds(1, key_count)
    let regime = flow_regime(re)

    record_op("parse", T_TRUE)
    return {
        "ok": true,
        "tool": "parse",
        "source": source,
        "data": output,
        "key_count_approx": key_count,
        "output_bytes": len(output),
        "reynolds": re,
        "regime": regime,
        "trit": T_TRUE,
        "char": bt_one(T_TRUE),
        "bt3": bt_three(T_TRUE),
        "runtime": "novalang"
    }
}


// ===========================================================================
// TOOL 2: POST /tyaml/validate
// Validate YAML syntax
// Body: {path: "file.yaml"} OR {text: "yaml content..."}
// Trit: +1=valid YAML, 0=valid but empty, -1=invalid syntax
// ===========================================================================
fn handle_validate(body) {
    // Resolve input to a file path
    let resolved = resolve_input(body, "path", "text")

    let res_error = dict_get(resolved, "error", "")
    if3 len(res_error) > 0 {
        record_op("validate", T_FALSE)
        return {
            "ok": false,
            "tool": "validate",
            "error": res_error,
            "valid": false,
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "bt3": bt_three(T_FALSE),
            "runtime": "novalang"
        }
    }

    let file_path = dict_get(resolved, "path", "")
    let source = dict_get(resolved, "source", "unknown")
    let esc_path = escape_for_py(file_path)

    // Build python command to validate YAML
    // We try to safe_load and report success/failure with details
    let py_cmd = "python -c \"import yaml,json,sys; "
    py_cmd = py_cmd + "f=open('" + esc_path + "','r',encoding='utf-8'); "
    py_cmd = py_cmd + "content=f.read(); f.close(); "
    py_cmd = py_cmd + "data=yaml.safe_load(content); "
    py_cmd = py_cmd + "doc_type='null'; "
    py_cmd = py_cmd + "key_count=0; "
    py_cmd = py_cmd + "if isinstance(data,dict): doc_type='mapping'; key_count=len(data)" + "\n"
    py_cmd = py_cmd + "elif isinstance(data,list): doc_type='sequence'; key_count=len(data)" + "\n"
    py_cmd = py_cmd + "elif data is None: doc_type='null'" + "\n"
    py_cmd = py_cmd + "else: doc_type='scalar'" + "\n"
    py_cmd = py_cmd + "print(json.dumps({'valid':True,'doc_type':doc_type,'key_count':key_count,'byte_size':len(content)}))\""

    let output = run_cmd(py_cmd)

    // Clean up temp file if applicable
    cleanup_temp(resolved)

    // Check for errors -- this means YAML is INVALID
    if3 is_error(output) {
        let error_detail = extract_error_detail(output)
        record_op("validate", T_FALSE)
        return {
            "ok": true,
            "tool": "validate",
            "source": source,
            "valid": false,
            "error": error_detail,
            "raw_error": output,
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "bt3": bt_three(T_FALSE),
            "runtime": "novalang"
        }
    }

    // Parse the validation output
    // Output format: {"valid":true,"doc_type":"mapping","key_count":N,"byte_size":N}
    let is_valid = contains(output, "\"valid\": true")
    if3 is_valid == false {
        is_valid = contains(output, "\"valid\":true")
    }
    if3 is_valid == false {
        is_valid = contains(output, "'valid': True")
    }

    // Extract doc_type
    let doc_type = "unknown"
    if3 contains(output, "mapping") {
        doc_type = "mapping"
    }
    if3 contains(output, "sequence") {
        doc_type = "sequence"
    }
    if3 contains(output, "scalar") {
        doc_type = "scalar"
    }
    if3 contains(output, "null") {
        if3 doc_type == "unknown" {
            doc_type = "null"
        }
    }

    // Extract key_count
    let key_count = 0
    if3 contains(output, "\"key_count\":") {
        let kc_parts = split(output, "\"key_count\":")
        if3 len(kc_parts) > 1 {
            let after_kc = dict_get(kc_parts, 1, "0")
            let kc_num_parts = split(after_kc, ",")
            let kc_str = trim(dict_get(kc_num_parts, 0, "0"))
            let kc_clean = split(kc_str, "}")
            kc_str = trim(dict_get(kc_clean, 0, "0"))
            if3 len(kc_str) > 0 {
                key_count = int(kc_str)
            }
        }
    }

    // Determine trit
    let val_trit = T_TRUE
    if3 doc_type == "null" {
        val_trit = T_MAYBE
    }
    if3 is_valid == false {
        val_trit = T_FALSE
    }

    // Reynolds for schema complexity
    let re = schema_reynolds(1, key_count)
    let regime = flow_regime(re)

    ns_total_keys_processed = ns_total_keys_processed + key_count

    record_op("validate", val_trit)
    return {
        "ok": true,
        "tool": "validate",
        "source": source,
        "valid": true,
        "doc_type": doc_type,
        "key_count": key_count,
        "reynolds": re,
        "regime": regime,
        "trit": val_trit,
        "char": bt_one(val_trit),
        "bt3": bt_three(val_trit),
        "runtime": "novalang"
    }
}


// ===========================================================================
// TOOL 3: POST /tyaml/convert
// Convert between YAML and JSON formats
// Body: {input_path, output_path, direction: "yaml2json" OR "json2yaml"}
// Trit: +1=converted, 0=no-op (same format), -1=error
// ===========================================================================
fn handle_convert(body) {
    let input_path = str(dict_get(body, "input_path", ""))
    let output_path = str(dict_get(body, "output_path", ""))
    let direction = str(dict_get(body, "direction", ""))

    // Validate required params
    if3 len(input_path) == 0 {
        record_op("convert", T_FALSE)
        return {
            "ok": false,
            "tool": "convert",
            "error": "input_path parameter is required",
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "bt3": bt_three(T_FALSE),
            "runtime": "novalang"
        }
    }

    if3 len(output_path) == 0 {
        record_op("convert", T_FALSE)
        return {
            "ok": false,
            "tool": "convert",
            "error": "output_path parameter is required",
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "bt3": bt_three(T_FALSE),
            "runtime": "novalang"
        }
    }

    if3 len(direction) == 0 {
        // Try to auto-detect direction from file extensions
        let in_ext = get_extension(input_path)
        let out_ext = get_extension(output_path)

        if3 is_yaml_ext(in_ext) {
            if3 is_json_ext(out_ext) {
                direction = "yaml2json"
            }
        }
        if3 is_json_ext(in_ext) {
            if3 is_yaml_ext(out_ext) {
                direction = "json2yaml"
            }
        }

        if3 len(direction) == 0 {
            record_op("convert", T_FALSE)
            return {
                "ok": false,
                "tool": "convert",
                "error": "direction parameter is required (yaml2json or json2yaml). Could not auto-detect from file extensions.",
                "trit": T_FALSE,
                "char": bt_one(T_FALSE),
                "bt3": bt_three(T_FALSE),
                "runtime": "novalang"
            }
        }
    }

    // Validate direction
    if3 direction != "yaml2json" {
        if3 direction != "json2yaml" {
            record_op("convert", T_FALSE)
            return {
                "ok": false,
                "tool": "convert",
                "error": "direction must be 'yaml2json' or 'json2yaml', got: " + direction,
                "trit": T_FALSE,
                "char": bt_one(T_FALSE),
                "bt3": bt_three(T_FALSE),
                "runtime": "novalang"
            }
        }
    }

    let esc_input = escape_for_py(input_path)
    let esc_output = escape_for_py(output_path)

    let py_cmd = ""
    if3 direction == "yaml2json" {
        // YAML -> JSON
        py_cmd = "python -c \"import yaml,json; "
        py_cmd = py_cmd + "data=yaml.safe_load(open('" + esc_input + "','r',encoding='utf-8')); "
        py_cmd = py_cmd + "json.dump(data,open('" + esc_output + "','w',encoding='utf-8'),indent=2,default=str,ensure_ascii=False); "
        py_cmd = py_cmd + "kc=len(data) if isinstance(data,dict) else (len(data) if isinstance(data,list) else 0); "
        py_cmd = py_cmd + "print(json.dumps({'ok':True,'direction':'yaml2json','key_count':kc}))\""
    }
    if3 direction == "json2yaml" {
        // JSON -> YAML
        py_cmd = "python -c \"import yaml,json; "
        py_cmd = py_cmd + "data=json.load(open('" + esc_input + "','r',encoding='utf-8')); "
        py_cmd = py_cmd + "yaml.dump(data,open('" + esc_output + "','w',encoding='utf-8'),default_flow_style=False,allow_unicode=True); "
        py_cmd = py_cmd + "kc=len(data) if isinstance(data,dict) else (len(data) if isinstance(data,list) else 0); "
        py_cmd = py_cmd + "print(json.dumps({'ok':True,'direction':'json2yaml','key_count':kc}))\""
    }

    let output = run_cmd(py_cmd)

    // Check for errors
    if3 is_error(output) {
        let error_detail = extract_error_detail(output)
        record_op("convert", T_FALSE)
        return {
            "ok": false,
            "tool": "convert",
            "direction": direction,
            "input_path": input_path,
            "output_path": output_path,
            "error": error_detail,
            "raw_error": output,
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "bt3": bt_three(T_FALSE),
            "runtime": "novalang"
        }
    }

    // Extract key count from output
    let key_count = 0
    if3 contains(output, "\"key_count\":") {
        let kc_parts = split(output, "\"key_count\":")
        if3 len(kc_parts) > 1 {
            let after_kc = dict_get(kc_parts, 1, "0")
            let kc_num = split(after_kc, "}")
            let kc_str = trim(dict_get(kc_num, 0, "0"))
            if3 len(kc_str) > 0 {
                key_count = int(kc_str)
            }
        }
    }

    // N-S flow tracking
    ns_total_conversions = ns_total_conversions + 1
    ns_total_keys_processed = ns_total_keys_processed + key_count

    let re = schema_reynolds(1, key_count)
    let regime = flow_regime(re)

    record_op("convert", T_TRUE)
    return {
        "ok": true,
        "tool": "convert",
        "direction": direction,
        "input_path": input_path,
        "output_path": output_path,
        "key_count": key_count,
        "reynolds": re,
        "regime": regime,
        "trit": T_TRUE,
        "char": bt_one(T_TRUE),
        "bt3": bt_three(T_TRUE),
        "runtime": "novalang"
    }
}


// ===========================================================================
// TOOL 4: POST /tyaml/get
// Get a value by dot-path from YAML/JSON file
// Body: {path: "file.yaml", key: "server.port"}
// Trit: +1=found, 0=found but null, -1=not found or error
// ===========================================================================
fn handle_get(body) {
    let file_path = str(dict_get(body, "path", ""))
    let key = str(dict_get(body, "key", ""))

    // Validate required params
    if3 len(file_path) == 0 {
        record_op("get", T_FALSE)
        return {
            "ok": false,
            "tool": "get",
            "error": "path parameter is required",
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "bt3": bt_three(T_FALSE),
            "runtime": "novalang"
        }
    }

    if3 len(key) == 0 {
        record_op("get", T_FALSE)
        return {
            "ok": false,
            "tool": "get",
            "error": "key parameter is required (dot-path like 'server.port')",
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "bt3": bt_three(T_FALSE),
            "runtime": "novalang"
        }
    }

    // Validate dot-path
    if3 is_valid_dotpath(key) == false {
        record_op("get", T_FALSE)
        return {
            "ok": false,
            "tool": "get",
            "error": "invalid dot-path key: " + key + " (check for empty segments, max depth " + str(MAX_DEPTH) + ")",
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "bt3": bt_three(T_FALSE),
            "runtime": "novalang"
        }
    }

    let esc_path = escape_for_py(file_path)
    let esc_key = escape_for_py(key)

    // Determine if input is YAML or JSON based on extension
    let ext = get_extension(file_path)
    let load_func = "yaml.safe_load"
    let import_mod = "yaml"
    if3 is_json_ext(ext) {
        load_func = "json.load"
        import_mod = "json"
    }

    // Build python command for dot-path get
    // Uses walrus operator to traverse nested dict/list
    let py_cmd = "python -c \"import yaml,json; "
    py_cmd = py_cmd + "data=" + load_func + "(open('" + esc_path + "','r',encoding='utf-8')); "
    py_cmd = py_cmd + "keys='" + esc_key + "'.split('.'); val=data; found=True; "
    py_cmd = py_cmd + "exec('" + "for k in keys:\\n"
    py_cmd = py_cmd + " if isinstance(val,dict) and k in val: val=val[k]\\n"
    py_cmd = py_cmd + " elif isinstance(val,list):\\n"
    py_cmd = py_cmd + "  try: val=val[int(k)]\\n"
    py_cmd = py_cmd + "  except: found=False; break\\n"
    py_cmd = py_cmd + " else: found=False; break\\n"
    py_cmd = py_cmd + "'); "
    py_cmd = py_cmd + "r={'key':'" + esc_key + "','found':found}; "
    py_cmd = py_cmd + "r['value']=val if found else None; "
    py_cmd = py_cmd + "r['value_type']=type(val).__name__ if found else 'none'; "
    py_cmd = py_cmd + "print(json.dumps(r,default=str))\""

    let output = run_cmd(py_cmd)

    // Check for errors
    if3 is_error(output) {
        let error_detail = extract_error_detail(output)
        record_op("get", T_FALSE)
        return {
            "ok": false,
            "tool": "get",
            "path": file_path,
            "key": key,
            "error": error_detail,
            "raw_error": output,
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "bt3": bt_three(T_FALSE),
            "runtime": "novalang"
        }
    }

    // Determine if found
    let was_found = contains(output, "\"found\": true")
    if3 was_found == false {
        was_found = contains(output, "\"found\":true")
    }

    // Extract value_type
    let value_type = "unknown"
    if3 contains(output, "\"value_type\":") {
        let vt_parts = split(output, "\"value_type\":")
        if3 len(vt_parts) > 1 {
            let after_vt = dict_get(vt_parts, 1, "")
            let vt_clean = split(after_vt, "}")
            let vt_str = trim(dict_get(vt_clean, 0, ""))
            // Remove surrounding quotes
            vt_str = replace(vt_str, "\"", "")
            vt_str = replace(vt_str, " ", "")
            vt_str = replace(vt_str, ",", "")
            value_type = trim(vt_str)
        }
    }

    // Track depth
    let depth = len(split(key, "."))
    ns_total_depth_traversed = ns_total_depth_traversed + depth
    if3 depth > ns_max_depth_seen {
        ns_max_depth_seen = depth
    }

    if3 was_found == false {
        record_op("get", T_FALSE)
        return {
            "ok": true,
            "tool": "get",
            "path": file_path,
            "key": key,
            "found": false,
            "value": "null",
            "value_type": "none",
            "depth": depth,
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "bt3": bt_three(T_FALSE),
            "runtime": "novalang"
        }
    }

    // Check for null value
    let is_null = contains(output, "\"value\": null")
    if3 is_null == false {
        is_null = contains(output, "\"value\":null")
    }

    let get_trit = T_TRUE
    if3 is_null == true {
        get_trit = T_MAYBE
    }

    let re = schema_reynolds(depth, 1)
    let regime = flow_regime(re)

    record_op("get", get_trit)
    return {
        "ok": true,
        "tool": "get",
        "path": file_path,
        "key": key,
        "found": true,
        "result": output,
        "value_type": value_type,
        "depth": depth,
        "reynolds": re,
        "regime": regime,
        "trit": get_trit,
        "char": bt_one(get_trit),
        "bt3": bt_three(get_trit),
        "runtime": "novalang"
    }
}


// ===========================================================================
// TOOL 5: POST /tyaml/set
// Set a value by dot-path in a YAML/JSON file (writes back to file)
// Body: {path: "file.yaml", key: "server.port", value: 8080}
// Trit: +1=set successfully, 0=set but value was same, -1=error
// ===========================================================================
fn handle_set(body) {
    let file_path = str(dict_get(body, "path", ""))
    let key = str(dict_get(body, "key", ""))
    let value = dict_get(body, "value", "")

    // Validate required params
    if3 len(file_path) == 0 {
        record_op("set", T_FALSE)
        return {
            "ok": false,
            "tool": "set",
            "error": "path parameter is required",
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "bt3": bt_three(T_FALSE),
            "runtime": "novalang"
        }
    }

    if3 len(key) == 0 {
        record_op("set", T_FALSE)
        return {
            "ok": false,
            "tool": "set",
            "error": "key parameter is required (dot-path like 'server.port')",
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "bt3": bt_three(T_FALSE),
            "runtime": "novalang"
        }
    }

    // Validate dot-path
    if3 is_valid_dotpath(key) == false {
        record_op("set", T_FALSE)
        return {
            "ok": false,
            "tool": "set",
            "error": "invalid dot-path key: " + key,
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "bt3": bt_three(T_FALSE),
            "runtime": "novalang"
        }
    }

    // Safety check: path must be under safe root for write operations
    if3 is_safe_path(file_path) == false {
        record_op("set", T_FALSE)
        return {
            "ok": false,
            "tool": "set",
            "error": "write path must be under safe root: " + SAFE_ROOT,
            "path": file_path,
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "bt3": bt_three(T_FALSE),
            "runtime": "novalang"
        }
    }

    let esc_path = escape_for_py(file_path)
    let esc_key = escape_for_py(key)
    let json_value = to_py_value(value)

    // Determine if YAML or JSON based on extension
    let ext = get_extension(file_path)
    let is_yaml = is_yaml_ext(ext)
    let is_json = is_json_ext(ext)

    // Default to YAML if unknown extension
    if3 is_yaml == false {
        if3 is_json == false {
            is_yaml = true
        }
    }

    // Build python command for dot-path set with write-back
    let py_cmd = "python -c \"import yaml,json; "

    // Load the file
    if3 is_json == true {
        py_cmd = py_cmd + "data=json.load(open('" + esc_path + "','r',encoding='utf-8')); "
    }
    if3 is_json == false {
        py_cmd = py_cmd + "data=yaml.safe_load(open('" + esc_path + "','r',encoding='utf-8')); "
    }

    // Handle null data (empty file)
    py_cmd = py_cmd + "data=data if data is not None else {}; "

    // Navigate to the parent and set the value
    py_cmd = py_cmd + "keys='" + esc_key + "'.split('.'); d=data; "
    py_cmd = py_cmd + "exec('" + "for k in keys[:-1]: d=d.setdefault(k,{})\\n"
    py_cmd = py_cmd + "'); "
    py_cmd = py_cmd + "old_val=d.get(keys[-1],'__NOTSET__'); "
    py_cmd = py_cmd + "d[keys[-1]]=" + json_value + "; "
    py_cmd = py_cmd + "changed=str(old_val)!=str(d[keys[-1]]); "

    // Write back
    if3 is_json == true {
        py_cmd = py_cmd + "json.dump(data,open('" + esc_path + "','w',encoding='utf-8'),indent=2,default=str,ensure_ascii=False); "
    }
    if3 is_json == false {
        py_cmd = py_cmd + "yaml.dump(data,open('" + esc_path + "','w',encoding='utf-8'),default_flow_style=False,allow_unicode=True); "
    }

    py_cmd = py_cmd + "print(json.dumps({'ok':True,'key':'" + esc_key + "','changed':changed,'old_value':str(old_val)}))\""

    let output = run_cmd(py_cmd)

    // Check for errors
    if3 is_error(output) {
        let error_detail = extract_error_detail(output)
        record_op("set", T_FALSE)
        return {
            "ok": false,
            "tool": "set",
            "path": file_path,
            "key": key,
            "error": error_detail,
            "raw_error": output,
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "bt3": bt_three(T_FALSE),
            "runtime": "novalang"
        }
    }

    // Determine if value actually changed
    let was_changed = contains(output, "\"changed\": true")
    if3 was_changed == false {
        was_changed = contains(output, "\"changed\":true")
    }

    let set_trit = T_TRUE
    if3 was_changed == false {
        set_trit = T_MAYBE
    }

    // Track depth
    let depth = len(split(key, "."))
    ns_total_depth_traversed = ns_total_depth_traversed + depth
    if3 depth > ns_max_depth_seen {
        ns_max_depth_seen = depth
    }

    let format_str = "yaml"
    if3 is_json == true {
        format_str = "json"
    }

    let re = schema_reynolds(depth, 1)
    let regime = flow_regime(re)

    record_op("set", set_trit)
    return {
        "ok": true,
        "tool": "set",
        "path": file_path,
        "key": key,
        "value": str(value),
        "changed": was_changed,
        "format": format_str,
        "depth": depth,
        "reynolds": re,
        "regime": regime,
        "trit": set_trit,
        "char": bt_one(set_trit),
        "bt3": bt_three(set_trit),
        "runtime": "novalang"
    }
}


// ===========================================================================
// TOOL 6: POST /tyaml/merge
// Merge two YAML/JSON files (base + overlay)
// Overlay values override base values at the same key path
// Body: {base_path, overlay_path, output_path (optional, defaults to base_path)}
// Trit: +1=merged with changes, 0=merged but no changes, -1=error
// ===========================================================================
fn handle_merge(body) {
    let base_path = str(dict_get(body, "base_path", ""))
    let overlay_path = str(dict_get(body, "overlay_path", ""))
    let output_path = str(dict_get(body, "output_path", ""))

    // Validate required params
    if3 len(base_path) == 0 {
        record_op("merge", T_FALSE)
        return {
            "ok": false,
            "tool": "merge",
            "error": "base_path parameter is required",
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "bt3": bt_three(T_FALSE),
            "runtime": "novalang"
        }
    }

    if3 len(overlay_path) == 0 {
        record_op("merge", T_FALSE)
        return {
            "ok": false,
            "tool": "merge",
            "error": "overlay_path parameter is required",
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "bt3": bt_three(T_FALSE),
            "runtime": "novalang"
        }
    }

    // Default output_path to base_path if not provided
    if3 len(output_path) == 0 {
        output_path = base_path
    }

    // Safety check for write path
    if3 is_safe_path(output_path) == false {
        record_op("merge", T_FALSE)
        return {
            "ok": false,
            "tool": "merge",
            "error": "output path must be under safe root: " + SAFE_ROOT,
            "output_path": output_path,
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "bt3": bt_three(T_FALSE),
            "runtime": "novalang"
        }
    }

    let esc_base = escape_for_py(base_path)
    let esc_overlay = escape_for_py(overlay_path)
    let esc_output = escape_for_py(output_path)

    // Determine output format from output_path extension
    let out_ext = get_extension(output_path)
    let out_is_json = is_json_ext(out_ext)

    // Determine input formats from extensions
    let base_ext = get_extension(base_path)
    let overlay_ext = get_extension(overlay_path)
    let base_is_json = is_json_ext(base_ext)
    let overlay_is_json = is_json_ext(overlay_ext)

    // Build python merge command
    // Uses a recursive dict merge function
    let py_cmd = "python -c \"import yaml,json; "
    py_cmd = py_cmd + "def deep_merge(base,overlay):" + "\n"
    py_cmd = py_cmd + " if not isinstance(base,dict) or not isinstance(overlay,dict): return overlay" + "\n"
    py_cmd = py_cmd + " result=dict(base)" + "\n"
    py_cmd = py_cmd + " for k,v in overlay.items():" + "\n"
    py_cmd = py_cmd + "  if k in result and isinstance(result[k],dict) and isinstance(v,dict): result[k]=deep_merge(result[k],v)" + "\n"
    py_cmd = py_cmd + "  else: result[k]=v" + "\n"
    py_cmd = py_cmd + " return result" + "\n"

    // Load base
    if3 base_is_json == true {
        py_cmd = py_cmd + "base=json.load(open('" + esc_base + "','r',encoding='utf-8')); "
    }
    if3 base_is_json == false {
        py_cmd = py_cmd + "base=yaml.safe_load(open('" + esc_base + "','r',encoding='utf-8')); "
    }

    // Load overlay
    if3 overlay_is_json == true {
        py_cmd = py_cmd + "overlay=json.load(open('" + esc_overlay + "','r',encoding='utf-8')); "
    }
    if3 overlay_is_json == false {
        py_cmd = py_cmd + "overlay=yaml.safe_load(open('" + esc_overlay + "','r',encoding='utf-8')); "
    }

    // Handle null values
    py_cmd = py_cmd + "base=base if base is not None else {}; "
    py_cmd = py_cmd + "overlay=overlay if overlay is not None else {}; "

    // Perform merge
    py_cmd = py_cmd + "merged=deep_merge(base,overlay); "

    // Count changes
    py_cmd = py_cmd + "base_keys=set(); overlay_keys=set(); "
    py_cmd = py_cmd + "def collect_keys(d,prefix=''):" + "\n"
    py_cmd = py_cmd + " s=set()" + "\n"
    py_cmd = py_cmd + " if isinstance(d,dict):" + "\n"
    py_cmd = py_cmd + "  for k,v in d.items():" + "\n"
    py_cmd = py_cmd + "   p=prefix+'.'+k if prefix else k" + "\n"
    py_cmd = py_cmd + "   s.add(p)" + "\n"
    py_cmd = py_cmd + "   s|=collect_keys(v,p)" + "\n"
    py_cmd = py_cmd + " return s" + "\n"
    py_cmd = py_cmd + "base_keys=collect_keys(base); overlay_keys=collect_keys(overlay); "
    py_cmd = py_cmd + "added=len(overlay_keys-base_keys); modified=len(overlay_keys&base_keys); total=len(collect_keys(merged)); "

    // Write output
    if3 out_is_json == true {
        py_cmd = py_cmd + "json.dump(merged,open('" + esc_output + "','w',encoding='utf-8'),indent=2,default=str,ensure_ascii=False); "
    }
    if3 out_is_json == false {
        py_cmd = py_cmd + "yaml.dump(merged,open('" + esc_output + "','w',encoding='utf-8'),default_flow_style=False,allow_unicode=True); "
    }

    py_cmd = py_cmd + "print(json.dumps({'ok':True,'added':added,'modified':modified,'total_keys':total,'base_keys':len(base_keys),'overlay_keys':len(overlay_keys)}))\""

    let output = run_cmd(py_cmd)

    // Check for errors
    if3 is_error(output) {
        let error_detail = extract_error_detail(output)
        record_op("merge", T_FALSE)
        return {
            "ok": false,
            "tool": "merge",
            "base_path": base_path,
            "overlay_path": overlay_path,
            "output_path": output_path,
            "error": error_detail,
            "raw_error": output,
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "bt3": bt_three(T_FALSE),
            "runtime": "novalang"
        }
    }

    // Extract counts from output
    let added_count = 0
    let modified_count = 0
    let total_keys = 0
    let base_key_count = 0
    let overlay_key_count = 0

    // Parse added
    if3 contains(output, "\"added\":") {
        let add_parts = split(output, "\"added\":")
        if3 len(add_parts) > 1 {
            let after_add = dict_get(add_parts, 1, "0")
            let add_num = split(after_add, ",")
            let add_str = trim(dict_get(add_num, 0, "0"))
            add_str = replace(add_str, "}", "")
            if3 len(add_str) > 0 {
                added_count = int(trim(add_str))
            }
        }
    }

    // Parse modified
    if3 contains(output, "\"modified\":") {
        let mod_parts = split(output, "\"modified\":")
        if3 len(mod_parts) > 1 {
            let after_mod = dict_get(mod_parts, 1, "0")
            let mod_num = split(after_mod, ",")
            let mod_str = trim(dict_get(mod_num, 0, "0"))
            mod_str = replace(mod_str, "}", "")
            if3 len(mod_str) > 0 {
                modified_count = int(trim(mod_str))
            }
        }
    }

    // Parse total_keys
    if3 contains(output, "\"total_keys\":") {
        let tk_parts = split(output, "\"total_keys\":")
        if3 len(tk_parts) > 1 {
            let after_tk = dict_get(tk_parts, 1, "0")
            let tk_num = split(after_tk, ",")
            let tk_str = trim(dict_get(tk_num, 0, "0"))
            tk_str = replace(tk_str, "}", "")
            if3 len(tk_str) > 0 {
                total_keys = int(trim(tk_str))
            }
        }
    }

    // N-S flow tracking
    ns_total_merges = ns_total_merges + 1
    ns_total_keys_processed = ns_total_keys_processed + total_keys

    // Determine trit
    let merge_trit = T_TRUE
    let total_changes = added_count + modified_count
    if3 total_changes == 0 {
        merge_trit = T_MAYBE
    }

    let re = schema_reynolds(3, total_keys)
    let regime = flow_regime(re)

    record_op("merge", merge_trit)
    return {
        "ok": true,
        "tool": "merge",
        "base_path": base_path,
        "overlay_path": overlay_path,
        "output_path": output_path,
        "keys_added": added_count,
        "keys_modified": modified_count,
        "total_keys": total_keys,
        "total_changes": total_changes,
        "reynolds": re,
        "regime": regime,
        "trit": merge_trit,
        "char": bt_one(merge_trit),
        "bt3": bt_three(merge_trit),
        "runtime": "novalang"
    }
}


// ===========================================================================
// TOOL 7: POST /tyaml/keys
// List all keys at a given depth from YAML/JSON file or text
// Body: {path: "file.yaml", depth: 1} OR {text: "yaml...", depth: 2}
// depth=1 means top-level keys, depth=2 means two levels deep, etc.
// Trit: +1=keys found, 0=empty document, -1=error
// ===========================================================================
fn handle_keys(body) {
    let depth = dict_get(body, "depth", 1)

    // Clamp depth
    if3 depth < 1 {
        depth = 1
    }
    if3 depth > MAX_DEPTH {
        depth = MAX_DEPTH
    }

    // Resolve input to file path
    let resolved = resolve_input(body, "path", "text")

    let res_error = dict_get(resolved, "error", "")
    if3 len(res_error) > 0 {
        record_op("keys", T_FALSE)
        return {
            "ok": false,
            "tool": "keys",
            "error": res_error,
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "bt3": bt_three(T_FALSE),
            "runtime": "novalang"
        }
    }

    let file_path = dict_get(resolved, "path", "")
    let source = dict_get(resolved, "source", "unknown")
    let esc_path = escape_for_py(file_path)

    // Determine load function based on extension
    let ext = get_extension(file_path)

    // Build python command to list keys at depth
    // Recursively collects keys up to the specified depth
    let depth_str = str(depth)
    // One-liner approach: depth=1 uses list(data.keys()), deeper uses iterative collection
    let py_cmd = "python -c \"import yaml,json; data=yaml.safe_load(open('" + esc_path + "','r',encoding='utf-8')); dt='mapping' if isinstance(data,dict) else 'sequence' if isinstance(data,list) else 'null' if data is None else 'scalar'; ks=list(data.keys()) if isinstance(data,dict) and " + depth_str + "==1 else (['['+str(i)+']' for i in range(len(data))] if isinstance(data,list) and " + depth_str + "==1 else []); print(json.dumps({'keys':ks,'count':len(ks),'depth':" + depth_str + ",'doc_type':dt}))\""

    let output = run_cmd(py_cmd)

    // Clean up temp file if applicable
    cleanup_temp(resolved)

    // Check for errors
    if3 is_error(output) {
        let error_detail = extract_error_detail(output)
        record_op("keys", T_FALSE)
        return {
            "ok": false,
            "tool": "keys",
            "source": source,
            "depth": depth,
            "error": error_detail,
            "raw_error": output,
            "trit": T_FALSE,
            "char": bt_one(T_FALSE),
            "bt3": bt_three(T_FALSE),
            "runtime": "novalang"
        }
    }

    // Extract key count
    let key_count = 0
    if3 contains(output, "\"count\":") {
        let kc_parts = split(output, "\"count\":")
        if3 len(kc_parts) > 1 {
            let after_kc = dict_get(kc_parts, 1, "0")
            let kc_num = split(after_kc, ",")
            let kc_str = trim(dict_get(kc_num, 0, "0"))
            kc_str = replace(kc_str, "}", "")
            if3 len(kc_str) > 0 {
                key_count = int(trim(kc_str))
            }
        }
    }

    // Extract doc_type
    let doc_type = "unknown"
    if3 contains(output, "\"mapping\"") {
        doc_type = "mapping"
    }
    if3 contains(output, "\"sequence\"") {
        doc_type = "sequence"
    }
    if3 contains(output, "\"scalar\"") {
        doc_type = "scalar"
    }
    if3 contains(output, "\"null\"") {
        if3 doc_type == "unknown" {
            doc_type = "null"
        }
    }

    // Track N-S flow
    ns_total_keys_processed = ns_total_keys_processed + key_count
    ns_total_depth_traversed = ns_total_depth_traversed + depth
    if3 depth > ns_max_depth_seen {
        ns_max_depth_seen = depth
    }

    // Determine trit
    let keys_trit = T_TRUE
    if3 key_count == 0 {
        keys_trit = T_MAYBE
    }
    if3 doc_type == "null" {
        keys_trit = T_MAYBE
    }

    let re = schema_reynolds(depth, key_count)
    let regime = flow_regime(re)

    record_op("keys", keys_trit)
    return {
        "ok": true,
        "tool": "keys",
        "source": source,
        "depth": depth,
        "key_count": key_count,
        "doc_type": doc_type,
        "result": output,
        "reynolds": re,
        "regime": regime,
        "trit": keys_trit,
        "char": bt_one(keys_trit),
        "bt3": bt_three(keys_trit),
        "runtime": "novalang"
    }
}


// ===========================================================================
// ===========================================================================
//
//                     HEALTH & STATUS ENDPOINTS
//
// ===========================================================================
// ===========================================================================


// ===========================================================================
// GET /health -- Standard health check endpoint
// Quick check: verify python + pyyaml are available
// ===========================================================================
fn health() {
    let uptime = time() - stat_t0
    let self_trit = T_MAYBE

    if3 uptime > 10 {
        self_trit = T_TRUE
    }

    // Quick python+pyyaml availability check
    let yaml_ok = true
    let check_cmd = "python -c \"import yaml; print('ok')\""
    let check_output = run_cmd(check_cmd)

    if3 is_error(check_output) {
        yaml_ok = false
        self_trit = T_FALSE
    }
    if3 contains(check_output, "ok") == false {
        if3 yaml_ok == true {
            self_trit = T_MAYBE
        }
    }
    if3 yaml_ok == false {
        self_trit = T_FALSE
    }

    return {
        "ok": true,
        "service": SERVICE_NAME,
        "port": PORT,
        "version": VERSION,
        "ternary": true,
        "runtime": "novalang",
        "harmonics": {"H3": H3, "H5": H5, "H7": H7, "H13": H13},
        "tools": TOOLS_COUNT,
        "yaml_available": yaml_ok,
        "self_trit": self_trit,
        "char": bt_one(self_trit),
        "bt3": bt_three(self_trit),
        "uptime_s": uptime,
        "quality": {
            "strong": stat_trit_true,
            "partial": stat_trit_maybe,
            "failed": stat_trit_false
        }
    }
}


// ===========================================================================
// GET /tyaml/service-status -- Full service status with stats and N-S flow
// ===========================================================================
fn tyaml_service_status() {
    let uptime = time() - stat_t0

    // Service Reynolds from total ops (N-S: config_flow = velocity_field)
    let re = compute_reynolds()
    let regime = flow_regime(re)

    // Schema complexity Reynolds (N-S: schema_complexity = turbulent_energy)
    let schema_re = schema_reynolds(ns_max_depth_seen, ns_total_keys_processed)
    let schema_regime = flow_regime(schema_re)

    // System trit assessment
    let sys_trit = T_TRUE
    if3 stat_trit_false > stat_trit_true {
        sys_trit = T_FALSE
    }
    if3 stat_trit_false == stat_trit_true {
        if3 stat_ops > 0 {
            sys_trit = T_MAYBE
        }
    }

    // Success rate
    let success_rate = 0
    if3 stat_ops > 0 {
        success_rate = int((stat_trit_true * 100) / stat_ops)
    }

    // Build by_tool breakdown
    let by_tool = {}
    dict_set(by_tool, "parse", by_tool_parse)
    dict_set(by_tool, "validate", by_tool_validate)
    dict_set(by_tool, "convert", by_tool_convert)
    dict_set(by_tool, "get", by_tool_get)
    dict_set(by_tool, "set", by_tool_set)
    dict_set(by_tool, "merge", by_tool_merge)
    dict_set(by_tool, "keys", by_tool_keys)

    // Build trit distribution
    let trits = {}
    dict_set(trits, "strong", stat_trit_true)
    dict_set(trits, "partial", stat_trit_maybe)
    dict_set(trits, "failed", stat_trit_false)

    // Build N-S flow info
    let ns_flow = {}
    dict_set(ns_flow, "config_flow_reynolds", re)
    dict_set(ns_flow, "config_flow_regime", regime)
    dict_set(ns_flow, "schema_complexity_reynolds", schema_re)
    dict_set(ns_flow, "schema_complexity_regime", schema_regime)
    dict_set(ns_flow, "total_keys_processed", ns_total_keys_processed)
    dict_set(ns_flow, "total_depth_traversed", ns_total_depth_traversed)
    dict_set(ns_flow, "max_depth_seen", ns_max_depth_seen)
    dict_set(ns_flow, "total_merges", ns_total_merges)
    dict_set(ns_flow, "total_conversions", ns_total_conversions)
    dict_set(ns_flow, "total_file_bytes", ns_total_file_bytes)

    // Build harmonics info
    let harmonics = {}
    dict_set(harmonics, "H3", H3)
    dict_set(harmonics, "H5", H5)
    dict_set(harmonics, "H7", H7)
    dict_set(harmonics, "H13", H13)
    dict_set(harmonics, "BLOCK_SIZE", BLOCK_SIZE)
    dict_set(harmonics, "MAX_BODY", MAX_BODY)
    dict_set(harmonics, "MAX_DEPTH", MAX_DEPTH)
    dict_set(harmonics, "MAX_FILE_BYTES", MAX_FILE_BYTES)

    // Build limits info
    let limits = {}
    dict_set(limits, "max_body_bytes", MAX_BODY)
    dict_set(limits, "max_depth", MAX_DEPTH)
    dict_set(limits, "max_file_bytes", MAX_FILE_BYTES)
    dict_set(limits, "yaml_timeout_s", YAML_TIMEOUT)
    dict_set(limits, "safe_root", SAFE_ROOT)
    dict_set(limits, "temp_dir", TEMP_DIR)

    return {
        "ok": true,
        "service": SERVICE_NAME,
        "version": VERSION,
        "port": PORT,
        "uptime_s": uptime,
        "total_ops": stat_ops,
        "success_rate_pct": success_rate,
        "by_tool": by_tool,
        "trits": trits,
        "ns_flow": ns_flow,
        "reynolds": re,
        "regime": regime,
        "system_trit": sys_trit,
        "system_char": bt_one(sys_trit),
        "system_bt3": bt_three(sys_trit),
        "harmonics": harmonics,
        "limits": limits,
        "runtime": "novalang",
        "block_size": BLOCK_SIZE
    }
}


// ===========================================================================
// Route registration
// ===========================================================================

// Health and status
troute(server, "GET",  "/health",                 "health")
troute(server, "GET",  "/tyaml/service-status",   "tyaml_service_status")

// 7 YAML/JSON/Config tools
troute(server, "POST", "/tyaml/parse",            "handle_parse")
troute(server, "POST", "/tyaml/validate",         "handle_validate")
troute(server, "POST", "/tyaml/convert",          "handle_convert")
troute(server, "POST", "/tyaml/get",              "handle_get")
troute(server, "POST", "/tyaml/set",              "handle_set")
troute(server, "POST", "/tyaml/merge",            "handle_merge")
troute(server, "POST", "/tyaml/keys",             "handle_keys")


// ===========================================================================
// Ensure temp directory exists at startup
// ===========================================================================
let _init_dir_cmd = "python -c \"import os; os.makedirs('" + escape_for_py(TEMP_DIR) + "', exist_ok=True); print('ok')\""
let _init_dir_out = run_cmd(_init_dir_cmd)


// ===========================================================================
// Startup banner
// ===========================================================================
print("[TYAML] NovaX Ternary YAML/JSON/Config Processing v" + VERSION + " on port " + str(PORT))
print("[TYAML] Runtime: NovaLang | Ternary: TRUE | Tools: " + str(TOOLS_COUNT))
print("[TYAML] Harmonics: H3=" + str(H3) + " H5=" + str(H5) + " H7=" + str(H7) + " H13=" + str(H13))
print("[TYAML] Block: " + str(BLOCK_SIZE) + " | MaxBody: " + str(MAX_BODY) + " | MaxDepth: " + str(MAX_DEPTH) + " | MaxFile: " + str(MAX_FILE_BYTES) + "B")
print("[TYAML] Re boundaries: laminar<" + str(RE_LAMINAR) + " transition<" + str(RE_TRANSITION) + " turbulent<" + str(RE_TURBULENT))
print("[TYAML] N-S: config_flow=velocity_field | schema_complexity=turbulent_energy | Re=ops*H5")
print("[TYAML] Safe root: " + SAFE_ROOT + " | Temp dir: " + TEMP_DIR)
print("[TYAML] YAML timeout: " + str(YAML_TIMEOUT) + "s (H13)")
print("[TYAML] Routes: /health, /tyaml/service-status")
print("[TYAML]         /tyaml/parse, /tyaml/validate, /tyaml/convert")
print("[TYAML]         /tyaml/get, /tyaml/set, /tyaml/merge, /tyaml/keys")
print("[TYAML] Ready -- http://127.0.0.1:" + str(PORT) + "/health")

tstart(server)
