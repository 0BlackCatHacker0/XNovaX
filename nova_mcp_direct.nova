// NovaX MCP Server — Direct HTTP to NovaX fleet
// Pure NovaLang, no Python dependency. Minimal. Reliable.

let MCP_VERSION = "2024-11-05"
let ORCH = "http://127.0.0.1:9999"
let HIVE = "http://127.0.0.1:9881"
let CLOUD = "http://127.0.0.1:9878"

let TOOLS = [
    {"name": "nova_query", "description": "Query the NovaX hivemind cluster. Uses N-S fluid dynamics to route your query through the optimal number of AI models with full deliberation.", "inputSchema": {"type": "object", "properties": {"prompt": {"type": "string", "description": "The query to send to the hivemind"}, "channel": {"type": "string", "description": "Flow channel (REASON, MATH, CODE, INSTRUCT, FACT, LONG, VISION, LANGUAGE, AGENT, DOMAIN). Auto-detected if omitted."}}, "required": ["prompt"]}},
    {"name": "nova_status", "description": "Get NovaX system status including running services, loaded models, and overall health.", "inputSchema": {"type": "object", "properties": {}}},
    {"name": "nova_tools", "description": "Execute NovaX native tools: read (file), write (file), grep (search), glob (find files), run (command), edit (file). All data flows use TZip ternary compression.", "inputSchema": {"type": "object", "properties": {"tool": {"type": "string", "description": "Which tool to use (read, write, grep, glob, run, edit)"}, "path": {"type": "string", "description": "File/directory path"}, "pattern": {"type": "string", "description": "Search pattern"}, "content": {"type": "string", "description": "Content to write"}, "command": {"type": "string", "description": "Command to run"}, "old": {"type": "string", "description": "Text to replace"}, "new": {"type": "string", "description": "Replacement text"}}, "required": ["tool"]}},
    {"name": "nova_multi", "description": "TMulti tool composition: every tool gains secondary abilities.", "inputSchema": {"type": "object", "properties": {"tool": {"type": "string", "description": "Base tool to compose"}, "mode": {"type": "string", "description": "Composition mode"}, "path": {"type": "string", "description": "File/directory path"}, "pattern": {"type": "string", "description": "Search pattern"}, "command": {"type": "string", "description": "Command to execute"}, "path_b": {"type": "string", "description": "Second file path"}, "content": {"type": "string", "description": "Content"}, "template": {"type": "string", "description": "Template string"}, "old_string": {"type": "string", "description": "Text to replace"}, "new_string": {"type": "string", "description": "Replacement text"}, "glob": {"type": "string", "description": "File glob filter"}}, "required": ["tool", "mode"]}},
    {"name": "nova_hive", "description": "Query a specific AI model or the full hivemind swarm directly.", "inputSchema": {"type": "object", "properties": {"prompt": {"type": "string", "description": "The query"}, "model": {"type": "string", "description": "Specific model name. Uses swarm if omitted."}}, "required": ["prompt"]}},
    {"name": "nova_ttools", "description": "Execute NovaX ternary tools built on 3-5-7-13 harmonic constants.", "inputSchema": {"type": "object", "properties": {"tool": {"type": "string", "description": "Which ternary tool to use"}, "path": {"type": "string", "description": "File path"}, "path_a": {"type": "string", "description": "First file path"}, "path_b": {"type": "string", "description": "Second file path"}, "key": {"type": "string", "description": "Cache key"}, "value": {"type": "string", "description": "Cache value"}, "query": {"type": "string", "description": "Search query"}, "source": {"type": "string", "description": "Source path"}, "dest": {"type": "string", "description": "Destination path"}, "port": {"type": "number", "description": "Port number"}}, "required": ["tool"]}},
    {"name": "nova_deep", "description": "NovaX DeepStorage - N-S flow-routed compression, dedup, and tiered storage.", "inputSchema": {"type": "object", "properties": {"action": {"type": "string", "description": "DeepStorage action"}, "path": {"type": "string", "description": "File or directory path"}, "output": {"type": "string", "description": "Output path"}}, "required": ["action"]}},
    {"name": "nova_vault", "description": "NovaX Vault - TZip ternary compress + AES-256-GCM encryption for files.", "inputSchema": {"type": "object", "properties": {"action": {"type": "string", "description": "Vault action"}, "path": {"type": "string", "description": "File path"}, "password": {"type": "string", "description": "Encryption password"}}, "required": ["action"]}},
    {"name": "nova_cortex", "description": "NovaX Cortex - Desktop AI bridge.", "inputSchema": {"type": "object", "properties": {"action": {"type": "string", "description": "Cortex action"}, "prompt": {"type": "string", "description": "Prompt"}, "rounds": {"type": "number", "description": "Debate rounds"}}, "required": ["action"]}},
    {"name": "nova_cloud", "description": "NovaX Cloud Router - Query specific cloud AI providers.", "inputSchema": {"type": "object", "properties": {"prompt": {"type": "string", "description": "The query"}, "provider": {"type": "string", "description": "Cloud provider"}, "model": {"type": "string", "description": "Specific model name"}}, "required": ["prompt"]}},
    {"name": "nova_tbuffer", "description": "NovaX TBuffer - Ternary Response Membrane.", "inputSchema": {"type": "object", "properties": {"action": {"type": "string", "description": "TBuffer action"}, "prompt": {"type": "string", "description": "Prompt text"}, "response": {"type": "string", "description": "Response text"}, "channel": {"type": "string", "description": "Flow channel"}, "entry_id": {"type": "string", "description": "Entry ID"}, "data": {"type": "string", "description": "Raw data"}}, "required": ["action"]}}
]

// Route table: tool_name -> [method, url]
let ROUTES = {
    "nova_query":   ["POST", HIVE + "/query"],
    "nova_status":  ["GET",  ORCH + "/api/services/health"],
    "nova_tools":   ["POST", ORCH + "/api/tools/execute"],
    "nova_multi":   ["POST", ORCH + "/api/tools/multi"],
    "nova_hive":    ["POST", HIVE + "/query"],
    "nova_ttools":  ["POST", ORCH + "/api/ttools/execute"],
    "nova_deep":    ["POST", ORCH + "/api/deep/execute"],
    "nova_vault":   ["POST", ORCH + "/api/vault/execute"],
    "nova_cortex":  ["POST", ORCH + "/api/cortex/execute"],
    "nova_cloud":   ["POST", CLOUD + "/query"],
    "nova_tbuffer": ["POST", ORCH + "/api/tbuffer/execute"]
}

fn3 send(obj) {
    let line = json_encode(obj)
    print(line)
}

fn3 http_call(method, url, body) {
    try3 {
        if3 method == "GET" {
            let raw = http_get(url)
            return3 json_decode(raw)
        } else3 {
            let raw = http_post(url, json_encode(body))
            return3 json_decode(raw)
        }
    } catch3 {
        return3 {"error": "http_call_failed"}
    }
}

fn3 handle_tool_call(name, args) {
    let route = dict_get(ROUTES, name) ?? null
    if3 route == null {
        return3 {"error": "Unknown tool: " + name}
    }
    let method = route[0]
    let url = route[1]
    if3 method == "GET" {
        return3 http_call("GET", url, {})
    } else3 {
        return3 http_call("POST", url, args)
    }
}

fn3 handle_message(msg) {
    let method = dict_get(msg, "method") ?? ""
    let mid = dict_get(msg, "id") ?? null

    if3 method == "initialize" {
        send({"jsonrpc": "2.0", "id": mid, "result": {
            "protocolVersion": MCP_VERSION,
            "capabilities": {"tools": {}},
            "serverInfo": {"name": "novax", "version": "1.0.0"}
        }})
        return3 null
    }

    if3 method == "notifications/initialized" {
        return3 null
    }

    if3 method == "tools/list" {
        send({"jsonrpc": "2.0", "id": mid, "result": {"tools": TOOLS}})
        return3 null
    }

    if3 method == "tools/call" {
        let params = dict_get(msg, "params") ?? {}
        let name = dict_get(params, "name") ?? ""
        let args = dict_get(params, "arguments") ?? {}
        let result = handle_tool_call(name, args)
        send({"jsonrpc": "2.0", "id": mid, "result": {
            "content": [{"type": "text", "text": json_encode(result)}]
        }})
        return3 null
    }

    if3 method == "ping" {
        send({"jsonrpc": "2.0", "id": mid, "result": {}})
        return3 null
    }

    if3 mid != null {
        send({"jsonrpc": "2.0", "id": mid, "error": {
            "code": -32601, "message": "Method not found: " + method
        }})
    }
}

// Main: read JSON-RPC lines from stdin
fn3 main() {
    while3 true {
        let line = read_line()
        if3 line == null { break }
        let line = trim(line)
        if3 len(line) == 0 { continue }
        try3 {
            let msg = json_decode(line)
            handle_message(msg)
        } catch3 {
            send({"jsonrpc": "2.0", "id": null, "error": {
                "code": -32700, "message": "Parse error"
            }})
        }
    }
}

main()
