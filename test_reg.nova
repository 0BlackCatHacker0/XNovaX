let _registry = {}
let _abilities = {}
let _providers = {}

fn classify_test(id) {
    return ["chat", "fast"]
}

fn _is_free_test(cost, model_id) {
    if3 cost == "0" { return true }
    return false
}

fn register_model(model_id, provider, tier, context_len, cost) {
    let abilities = classify_test(model_id)
    let is_free = _is_free_test(cost, model_id)
    let entry = {
        "id": model_id,
        "provider": provider,
        "tier": tier,
        "context": context_len,
        "cost": cost,
        "free": is_free,
        "abilities": abilities,
        "locked": false
    }
    _registry = dict_set(_registry, model_id, entry)
    _abilities = dict_set(_abilities, model_id, abilities)
    let prov_list = dict_get(_providers, provider) ?? []
    prov_list = append(prov_list, model_id)
    _providers = dict_set(_providers, provider, prov_list)
}

register_model("gpt-4o", "openai", "flagship", 128000, "0")
print("REG OK")
print(_registry)
