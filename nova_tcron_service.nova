troute(server, "POST", "/tcron/cancel",   "route_cancel")
troute(server, "POST", "/tcron/watch",    "route_watch")
troute(server, "POST", "/tcron/task",     "route_task")
troute(server, "POST", "/tcron/run-once", "route_run_once")
troute(server, "POST", "/tcron/chain",    "route_chain")
