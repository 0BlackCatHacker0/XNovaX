{
  "name": "NovaX-LLM-v1-pretrain",
  "type": "ternary_transformer",
  "version": "1.0.0",
  "parameters": "210M",
  "weights": "ternary {-1, 0, +1}",
  "constants": {
    "H3": 3, "H5": 5, "H7": 7, "H13": 13,
    "BLOCK": 2187,
    "RE_LAMINAR": 27, "RE_TRANSITIONAL": 125, "RE_TURBULENT": 343
  },
  "model": {
    "vocab_size": 32768,
    "embedding_dim": 1024,
    "num_layers": 16,
    "num_heads": 16,
    "head_dim": 64,
    "ffn_dim": 2730,
    "max_seq_len": 512,
    "block_size": 512,
    "activation": "ternary_gelu",
    "normalization": "ternary_rmsnorm",
    "position_encoding": "rotary_ternary",
    "dropout": 0.1,
    "weight_format": "trit_packed",
    "gradient_checkpointing": true
  },
  "training": {
    "optimizer": "muon+adamw",
    "learning_rate": 0.0003,
    "warmup_steps": 2000,
    "total_steps": 100000,
    "batch_size": 4,
    "gradient_accumulation": 4,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "checkpoint_interval": 5000,
    "checkpoint_dir": "C:/NovaX/nova_llm/checkpoints",
    "log_file": "C:/NovaX/web/nova_llm_training_log.json",
    "precision": "bf16_compute_ternary_weights",
    "scheduler": "wsd_spectra",
    "label_smoothing": 0.1,
    "z_loss_coeff": 1e-5,
    "round": "8-pretrain",
    "notes": "Pretraining on 888M tokens (FineWeb-Edu + OpenWebMath + Cosmopedia). 100K steps, batch 4 x 4 accum = eff 16, block 512."
  }
}
