fn quota_check(pname) {
    // Returns true if provider has remaining quota, false if exhausted
    let today = str(floor(time() / 86400))
    if3 today != _quota_day {
        // New day: reset all counters
        _quota_day = today
        let prov_names = keys(_quota_usage)
        let i = 0
        while3 i < len(prov_names) {
            let pk = prov_names[i]
            let entry = dict_get(_quota_usage, pk) ?? {}
            entry = dict_set(entry, "requests", 0)
            entry = dict_set(entry, "tokens", 0)
            _quota_usage = dict_set(_quota_usage, pk, entry)
            i = i + 1
        }
    }
    let usage = dict_get(_quota_usage, pname) ?? {}
    let reqs = dict_get(usage, "requests") ?? 0
    let limit_rpd = dict_get(usage, "limit_rpd") ?? 99999
    return reqs < limit_rpd
}

fn quota_record(pname, tokens_used) {
    let usage = dict_get(_quota_usage, pname) ?? {}
    usage = dict_set(usage, "requests", (dict_get(usage, "requests") ?? 0) + 1)
    usage = dict_set(usage, "tokens", (dict_get(usage, "tokens") ?? 0) + tokens_used)
    _quota_usage = dict_set(_quota_usage, pname, usage)
    // Track global token total
    _stats = dict_set(_stats, "total_tokens", (dict_get(_stats, "total_tokens") ?? 0) + tokens_used)
}

// -- Initialize provider registry --
fn init_providers() {
    // Providers and stats are now defined as inline dict literals above
    // (dict_set returns new dict, doesn't mutate — so inline is the only reliable way)
    print("[CLOUD-ROUTER] Providers initialized: " + str(len(_provider_order)) + " registered")
}

// -- Registry sync: pull full model catalog from model-registry :9860 --
let _registry_models = {}
let _registry_abilities = {}
let _registry_synced = false

fn sync_from_registry() {
    let resp = try3 { http_get("http://127.0.0.1:9860/catalog") } fail { {"error": "registry_offline"} }
    let err = dict_get(resp, "error") ?? ""
    if3 err != "" { return {"ok": false, "error": err} }
    let body = dict_get(resp, "body") ?? ""
    let data = try3 { json_decode(body) } fail { {"error": "parse_failed"} }
    let parse_err = dict_get(data, "error") ?? ""
    if3 parse_err != "" { return {"ok": false, "error": parse_err} }
    _registry_models = dict_get(data, "providers") ?? {}
    _registry_abilities = dict_get(data, "abilities") ?? {}
    _registry_synced = true
    let total = dict_get(data, "total") ?? 0
    let locked = dict_get(data, "locked") ?? 0
    print("[CLOUD-ROUTER] Registry sync: " + str(total) + " models, " + str(locked) + " locked, " + str(dict_get(data, "provider_count") ?? 0) + " providers")
    return {"ok": true, "total": total, "locked": locked}
}

fn get_registry_models_for(provider_name) {
    let result = []
    let prov_keys = keys(_registry_models)
    let i = 0
    while3 i < len(prov_keys) {
        let pk = try3 { prov_keys[i] } fail { "" }
        if3 contains(lower(pk), lower(provider_name)) == true { let models = dict_get(_registry_models, pk) ?? []
            let j = 0
            while3 j < len(models) {
                let m = try3 { models[j] } fail { {} }
                result = append(result, dict_get(m, "id") ?? "")
                j = j + 1
            }
        }
        i = i + 1
    }
    return result
}

// -- Trit helpers --
fn trit_char(t) {
    if3 t == 1 {
        return "1"
    } else3 t == 0 {
        return "0"
    } else3 {
        return "T"
    }
}

fn provider_trit(p) {
    let enabled = dict_get(p, "enabled") ?? false
    let has_key = dict_get(p, "has_key") ?? false
    if3 enabled == true {
        if3 has_key == true {
            return 1
        } else3 {
            return 0
        }
    } else3 {
        return -1
    }
}

// -- Count enabled providers --
fn count_enabled() {
    let count = 0
    let i = 0
    while3 i < len(_provider_order) {
        let pname = _provider_order[i]
        let p = dict_get(_providers, pname) ?? {}
        let enabled = dict_get(p, "enabled") ?? false
        // NOTE: let inside if3 creates scope-local — but while3 re-evaluates each iteration
        // Using while3's re-eval: count increments persist because while3 re-reads 'count'
        if3 enabled == true { count = count + 1
        }
        i = i + 1
    }
    return count
}

// -- Try query to a specific provider --
// Helper: pick model (avoids if3 scoping issue with variable reassignment)
fn pick_model(override, default_m) {
    if3 len(override) > 0 { return override }
    return default_m
}

// Dead provider cache: skip providers that failed recently (avoid 30s timeout hangs)
let _dead_providers = {}

fn _mark_dead(pname) {
    _dead_providers = dict_set(_dead_providers, pname, time())
}

fn _is_dead(pname) {
    let died_at = dict_get(_dead_providers, pname) ?? 0
    if3 died_at == 0 { return 0 }
    let elapsed = time() - died_at
    if3 elapsed > 300 { return 0 }
    return 1
}

fn try_provider(pname, prompt, model_override) {
    let p = dict_get(_providers, pname) ?? {}
    let enabled = dict_get(p, "enabled") ?? false
    if3 enabled != true {
        return {"ok": false, "trit": -1, "reason": "disabled"}
    }

    // Skip providers that failed recently (avoid 30s connection timeout)
    let dead_check = _is_dead(pname)
    if3 dead_check == 1 {
        return {"ok": false, "trit": -1, "reason": "recently_dead", "provider": pname}
    }

    let endpoint = dict_get(p, "endpoint") ?? ""
    let default_model = dict_get(p, "model") ?? ""
    let model = pick_model(model_override, default_model)

    // -- Local providers: quick health check first (1s timeout via try3) --
    let ptype = dict_get(p, "type") ?? ""
    if3 ptype == "local" {
        if3 pname == "novax-prime" {
            let health_check = try3 { http_get("http://127.0.0.1:9869/health") } fail { null }
            if3 health_check == null {
                _mark_dead(pname)
                return {"ok": false, "trit": -1, "reason": "unreachable", "provider": pname}
            }
        }
        if3 pname == "ollama" {
            let health_check = try3 { http_get("http://127.0.0.1:11434/api/tags") } fail { null }
            if3 health_check == null {
                _mark_dead(pname)
                return {"ok": false, "trit": -1, "reason": "unreachable", "provider": pname}
            }
        }
        if3 pname == "cortex" {
            let health_check = try3 { http_get("http://127.0.0.1:9896/health") } fail { null }
            if3 health_check == null {
                _mark_dead(pname)
                return {"ok": false, "trit": -1, "reason": "unreachable", "provider": pname}
            }
        }
    }

    // -- Ollama: direct HTTP --
    if3 pname == "ollama" {
        let body_str = "{\"model\":\"" + model + "\",\"prompt\":\"" + replace(prompt, "\"", "\\\"") + "\",\"stream\":false}"
        let result = try3 { http_post(endpoint, body_str) } fail { {"error": "ollama_unreachable"} }
        let err = dict_get(result, "error") ?? ""
        if3 err != "" {
            _mark_dead(pname)
            return {"ok": false, "trit": -1, "reason": err, "provider": pname}
        }
        return {"ok": true, "trit": 1, "result": result, "provider": pname}
    }

    // -- Cortex: direct HTTP --
    if3 pname == "cortex" {
        let body_str = json_encode({"prompt": prompt, "source": "cloud-router"})
        let result = try3 { http_post(endpoint, body_str) } fail { {"error": "cortex_unreachable"} }
        let err = dict_get(result, "error") ?? ""
        if3 err != "" {
            _mark_dead(pname)
            return {"ok": false, "trit": -1, "reason": err, "provider": pname}
        }
        return {"ok": true, "trit": 1, "result": result, "provider": pname}
    }

    // -- Cloud providers: pure NovaLang --
    let result = cloud_call(pname, model, prompt, "")
    let ok = dict_get(result, "ok") ?? false
    if3 ok == false { let err = dict_get(result, "error") ?? "cloud_call_failed"
        return {"ok": false, "trit": -1, "reason": err, "provider": pname}
    }
    let resp = dict_get(result, "response") ?? ""
    // Swarm fix: reject empty responses — provider returned ok but no actual content
    if3 len(resp) == 0 {
        return {"ok": false, "trit": -1, "reason": "empty_response", "provider": pname, "model": model}
    }
    let ms = dict_get(result, "time_ms") ?? 0
    let tok = dict_get(result, "tokens") ?? 0
    return {"ok": true, "trit": 1, "result": result, "response": resp, "provider": pname, "model": model, "time_ms": ms, "tokens": tok}
}

// -- Build resonance-ranked provider order from Tripple --
fn _tripple_ranked_order() {
    let ranked = tripple_rank_providers(_tripple)
    let order = []
    let i = 0
    while3 i < len(ranked) {
        let entry = ranked[i]
        order = append(order, dict_get(entry, "name") ?? "")
        i = i + 1
    }
    return order
}

// -- Classify prompt into Go territory and get best model --
// PURE NOVALANG — no Python subprocess
fn _go_classify(prompt) {
    let data = try3 { classify_prompt_with_model(prompt) } fail { null }
    if3 data == null { return _go_default() }
    return data
}

fn _go_default() {
    return {"territory": "chat", "provider": "", "model": "", "max_tokens": 8192}
}

// ============================================================
// DOMAIN-AWARE MODEL ROUTING (Tripple Resonance: 1081 harvest samples)
// ============================================================
// Classifies prompts into 10 domains via keyword matching, then
// reorders the provider cascade so the BEST provider for that
// domain is tried first. Falls back to REASON if no keywords match.
//
// N-S Mapping: domain = channel_selector (routes flow into optimal pipe)
// 3-5-7-13: 10 domains ~ H3+H7 boundary, 3 providers per domain tier

// -- Keyword lists per domain --
let _DOMAIN_KEYWORDS = {
    "MATH": ["equation", "calculate", "solve", "derivative", "integral", "algebra", "geometry", "proof", "theorem", "mathematical"],
    "CODE": ["function", "code", "program", "debug", "error", "compile", "script", "algorithm", "syntax", "api", "class", "variable"],
    "LONG": ["poem", "story", "write", "creative", "essay", "narrative", "chapter", "fiction", "lyrics", "compose", "describe in detail"],
    "VISION": ["image", "picture", "photo", "screenshot", "diagram", "visual", "see", "look at"],
    "LANGUAGE": ["translate", "translation", "spanish", "french", "german", "chinese", "japanese", "language"],
    "FACT": ["what is", "who is", "when did", "where is", "define", "explain", "history of"],
    "AGENT": ["plan", "execute", "build", "create", "implement", "deploy", "automate"],
    "INSTRUCT": ["how to", "steps to", "guide", "tutorial", "instructions"],
    "REASON": ["why", "analyze", "compare", "evaluate", "think about", "consider", "logic"]
}

// -- Domain -> optimal provider cascade (from Tripple-optimized routing, 2026-03-19) --
// Cerebras hosts Qwen 235B + Llama 70B, Sambanova hosts Llama 70B
// OpenRouter routes free models: qwen3-coder, hermes-3-405b, nemotron-3-super, qwen3-next-80b
let _DOMAIN_PROVIDERS = {
    "MATH":     ["cerebras_direct", "sambanova_direct", "deepseek"],
    "CODE":     ["cerebras_direct", "openrouter", "github_models"],
    "LONG":     ["sambanova_direct", "openrouter", "cerebras_direct"],
    "FACT":     ["google_ai_studio", "cerebras_direct", "openrouter"],
    "REASON":   ["cerebras_direct", "openrouter", "anthropic"],
    "LANGUAGE": ["mistral_direct", "openrouter", "google_ai_studio"],
    "AGENT":    ["anthropic", "cerebras_direct", "openai"],
    "INSTRUCT": ["cerebras_direct", "sambanova_direct", "google_ai_studio"],
    "VISION":   ["openai", "google_ai_studio", "anthropic"],
    "DOMAIN":   ["cerebras_direct", "google_ai_studio", "openai"]
}

// -- Domain -> OpenRouter model overrides (used when cascade hits "openrouter") --
let _DOMAIN_OPENROUTER_MODELS = {
    "CODE":     "qwen/qwen3-coder:free",
    "LONG":     "nousresearch/hermes-3-llama-3.1-405b:free",
    "FACT":     "nvidia/nemotron-3-super-120b-a12b:free",
    "REASON":   "nousresearch/hermes-3-llama-3.1-405b:free",
    "LANGUAGE": "qwen/qwen3-next-80b-a3b-instruct:free"
}

// -- classify_domain: keyword-match prompt into one of 10 domains --
// Scans prompt (lowercased) for keyword hits per domain.
// Domain with most hits wins. Ties broken by scan order. Default: REASON.
fn classify_domain(prompt) {
    let lp = lower(prompt)
    let domains = ["MATH", "CODE", "LONG", "VISION", "LANGUAGE", "FACT", "AGENT", "INSTRUCT", "REASON"]
    let best_domain = "REASON"
    let best_hits = 0
    let di = 0
    while3 di < len(domains) {
        let domain = domains[di]
        let kws = dict_get(_DOMAIN_KEYWORDS, domain) ?? []
        let hits = 0
        let ki = 0
        while3 ki < len(kws) {
            let kw = kws[ki]
            if3 contains(lp, kw) == true {
                hits = hits + 1
            }
            ki = ki + 1
        }
        if3 hits > best_hits {
            best_hits = hits
            best_domain = domain
        }
        di = di + 1
    }
    // Extra check: if prompt starts with a number or has digits with operators, boost MATH
    if3 best_hits == 0 {
        // No keyword matched — check for numeric patterns
        if3 contains(lp, "+") == true { if3 contains(lp, "=") == true { best_domain = "MATH" } }
        if3 contains(lp, "*") == true { best_domain = "MATH" }
        if3 contains(lp, "/") == true { if3 contains(lp, "divide") == true { best_domain = "MATH" } }
    }
    return best_domain
}

// -- domain_provider_order: returns reordered cascade for a domain --
// Puts the 3 best providers for the domain at the front, then appends
// all remaining providers from _provider_order (deduped).
fn domain_provider_order(domain) {
    let top3 = dict_get(_DOMAIN_PROVIDERS, domain) ?? ["cerebras_direct", "openai", "anthropic"]
    let result = []
    // Add top-3 domain providers first
    let ti = 0
    while3 ti < len(top3) {
        result = append(result, top3[ti])
        ti = ti + 1
    }
    // Append remaining providers from _provider_order (skip duplicates)
    let ri = 0
    while3 ri < len(_provider_order) {
        let pname = _provider_order[ri]
        let already = false
        let ci = 0
        while3 ci < len(result) {
            if3 result[ci] == pname { already = true }
            ci = ci + 1
        }
        if3 already != true {
            result = append(result, pname)
        }
        ri = ri + 1
    }
    return result
}

// -- Model Selector Integration (dynamic model selection via :9931) --
let SELECTOR_URL = "http://127.0.0.1:9931"
let _selector_alive = false

fn _selector_get_order(prompt, domain) {
    // Query the model selector for best providers for this domain
    // Returns provider order list or empty list on failure
    let body = json_encode({"prompt": prompt, "domain": domain, "top_n": 5})
    let resp = try3 { http_post(SELECTOR_URL + "/select/best", body) } fail { null }
    if3 resp == null { return [] }
    let resp_body = dict_get(resp, "body") ?? ""
    let data = try3 { json_decode(resp_body) } fail { {} }
    let ok = dict_get(data, "ok") ?? false
    if3 ok != true { return [] }
    let models = dict_get(data, "models") ?? []
    if3 len(models) == 0 { return [] }
    // Extract unique provider names in ranked order
    let order = []
    let seen = {}
    let si = 0
    while3 si < len(models) {
        let m = models[si]
        let prov = dict_get(m, "router_provider") ?? ""
        if3 prov != "" {
            let already = dict_get(seen, prov) ?? false
            if3 already != true {
                order = append(order, prov)
                seen = dict_set(seen, prov, true)
            }
        }
        si = si + 1
    }
    return order
}

fn _selector_learn(model_key, domain, trit) {
    // Report result back to model selector for reinforcement learning
    let body = json_encode({"model": model_key, "domain": domain, "score": trit})
    try3 { http_post(SELECTOR_URL + "/select/learn", body) } fail { null }
}

// -- Cascade query through providers by priority --
fn cascade_query(prompt, preferred, model_override) {
    let cascade_depth = 0

    // Go engine: classify prompt territory and get optimal model
    let _go = _go_classify(prompt)
    let _go_territory = dict_get(_go, "territory") ?? "chat"
    let _go_max_tokens = dict_get(_go, "max_tokens") ?? 8192

    // If no model override and Go engine has a recommendation, use it
    if3 model_override == "" {
        let _go_model = dict_get(_go, "model") ?? ""
        let _go_provider = dict_get(_go, "provider") ?? ""
        if3 _go_model != "" {
            if3 preferred == "" { preferred = _go_provider }
            model_override = _go_model
        }
    }

    // Domain-aware routing: classify prompt and get optimal provider order
    let _domain = classify_domain(prompt)
    let _domain_order = domain_provider_order(_domain)

    // Dynamic Model Selector: override cascade order with learned rankings
    // Queries :9931 for best providers based on Tripple resonance scores
    // Falls back to static domain routing if selector is unavailable
    let _selector_order = _selector_get_order(prompt, _domain)
    if3 len(_selector_order) > 0 {
        // Selector returned ranked providers — build full cascade with selector leads
        let _dynamic_order = []
        let _dyn_seen = {}
        // Add selector-ranked providers first
        let _di = 0
        while3 _di < len(_selector_order) {
            _dynamic_order = append(_dynamic_order, _selector_order[_di])
            _dyn_seen = dict_set(_dyn_seen, _selector_order[_di], true)
            _di = _di + 1
        }
        // Append remaining from static domain order (deduped)
        let _ri = 0
        while3 _ri < len(_domain_order) {
            let _rp = _domain_order[_ri]
            let _already = dict_get(_dyn_seen, _rp) ?? false
            if3 _already != true {
                _dynamic_order = append(_dynamic_order, _rp)
                _dyn_seen = dict_set(_dyn_seen, _rp, true)
            }
            _ri = _ri + 1
        }
        _domain_order = _dynamic_order
        _selector_alive = true
        print("[CLOUD-ROUTER] Selector override: " + str(len(_selector_order)) + " dynamic leads for domain " + _domain)
    } else3 {
        print("[CLOUD-ROUTER] Selector: offline or no data — using static domain routing")
    }

    print("[CLOUD-ROUTER] Domain classified: " + _domain + " | top providers: " + str(dict_get(_DOMAIN_PROVIDERS, _domain) ?? []))

    // Tripple: update regime at cascade start
    _tripple = tripple_outer(_tripple)

    // Mirror: reflect the intended model override for ability discovery (trit=0: neutral/discovery)
    if3 model_override != "" { let _ov_prov = preferred
        if3 _ov_prov == "" { _ov_prov = "cascade" }
        _tripple = tripple_mirror_reflect(_tripple, _ov_prov, model_override, 0, 0)
    }

    // If preferred provider specified, try it first (with quota check)
    if3 preferred != "" { let has_quota = quota_check(preferred)
        if3 has_quota == true { let t0 = time()
        let attempt = try_provider(preferred, prompt, model_override)
        let elapsed_ms = floor((time() - t0) * 1000)
        let ok = dict_get(attempt, "ok") ?? false
        if3 ok == true {
            quota_record(preferred, dict_get(attempt, "tokens") ?? 0)
            _tripple = tripple_ripple(_tripple, preferred, 1, elapsed_ms)
            _tripple = go_place_stone(_tripple, preferred, _go_territory, 1)
            let _mir_model = dict_get(attempt, "model") ?? model_override
            _tripple = go_record_result(_tripple, preferred, _mir_model, _go_territory, 1)
            _tripple = tripple_mirror_reflect(_tripple, preferred, _mir_model, 1, elapsed_ms)
            // Chladni: place model on skill plate
            let _pref_abilities = _mirror_classify_model(_mir_model)
            let _pref_sr = dict_get((dict_get((dict_get(_tripple, "providers") ?? {}), preferred) ?? {}), "success_rate") ?? 500
            _tripple = chladni_place_model(_tripple, _mir_model, preferred, _pref_sr, _pref_abilities)
            attempt = dict_set(attempt, "go_territory", _go_territory)
            attempt = dict_set(attempt, "go_max_tokens", _go_max_tokens)
            attempt = dict_set(attempt, "domain", _domain)
            // Selector: learn from success (preferred provider)
            if3 _selector_alive == true { _selector_learn(preferred + "/" + _mir_model, _domain, 1) }
            return attempt
        }
        _tripple = tripple_ripple(_tripple, preferred, -1, elapsed_ms)
        _tripple = go_place_stone(_tripple, preferred, _go_territory, -1)
        let _pref_p = dict_get(_providers, preferred) ?? {}
        let _mir_model = dict_get(attempt, "model") ?? (dict_get(_pref_p, "model") ?? preferred)
        _tripple = go_record_result(_tripple, preferred, _mir_model, _go_territory, -1)
        _tripple = tripple_mirror_reflect(_tripple, preferred, _mir_model, -1, elapsed_ms)
        // (model_override already reflected at cascade start)
        cascade_depth = cascade_depth + 1
        }
    }

    // Build cascade order: domain-aware order first, then Tripple resonance, then static fallback
    // Domain routing takes priority — puts best-for-domain providers at front
    let ranked_order = _tripple_ranked_order()
    let use_order = _domain_order
    if3 len(ranked_order) > 0 {
        // Tripple has data — but domain top-3 still lead, remaining follow Tripple ranking
        // (domain_provider_order already front-loaded the top-3, rest follows _provider_order)
        // Keep domain order as-is since it already encodes the harvest data
        use_order = _domain_order
    }

    // Cascade through providers in resonance-ranked order
    let i = 0
    while3 i < len(use_order) {
        let pname = use_order[i]
        // Skip if already tried as preferred
        if3 pname != preferred {
            if3 cascade_depth < MAX_CASCADE { let p = dict_get(_providers, pname) ?? {}
                let enabled = dict_get(p, "enabled") ?? false
                let has_quota = quota_check(pname)
                if3 enabled == true { if3 has_quota == true { let t0 = time()
                    // Tripple-optimized: inject domain-specific model for OpenRouter cascade
                    let _cascade_model = ""
                    if3 pname == "openrouter" {
                        _cascade_model = dict_get(_DOMAIN_OPENROUTER_MODELS, _domain) ?? ""
                    }
                    let attempt = try_provider(pname, prompt, _cascade_model)
                    let elapsed_ms = floor((time() - t0) * 1000)
                    let ok = dict_get(attempt, "ok") ?? false
                    if3 ok == true {
                        quota_record(pname, dict_get(attempt, "tokens") ?? 0)
                        // Tripple: ripple success
                        _tripple = tripple_ripple(_tripple, pname, 1, elapsed_ms)
                        _tripple = go_place_stone(_tripple, pname, _go_territory, 1)
                        let _mir_model = dict_get(attempt, "model") ?? ""
                        _tripple = go_record_result(_tripple, pname, _mir_model, _go_territory, 1)
                        _tripple = tripple_mirror_reflect(_tripple, pname, _mir_model, 1, elapsed_ms)
                        // Chladni: place model on skill plate
                        let _prov_data = dict_get(_providers, pname) ?? {}
                        let _mir_abilities = _mirror_classify_model(_mir_model)
                        let _succ_rate = dict_get((dict_get((dict_get(_tripple, "providers") ?? {}), pname) ?? {}), "success_rate") ?? 500
                        _tripple = chladni_place_model(_tripple, _mir_model, pname, _succ_rate, _mir_abilities)
                        attempt = dict_set(attempt, "cascade_depth", cascade_depth + 1)
                        attempt = dict_set(attempt, "go_territory", _go_territory)
                        attempt = dict_set(attempt, "go_max_tokens", _go_max_tokens)
                        attempt = dict_set(attempt, "domain", _domain)
                        if3 cascade_depth > 0 {
                            _stats = dict_set(_stats, "cascades", (dict_get(_stats, "cascades") ?? 0) + 1)
                        }
                        // Selector: learn from cascade success
                        if3 _selector_alive == true { _selector_learn(pname + "/" + _mir_model, _domain, 1) }
                        return attempt
                    }
                    _tripple = tripple_ripple(_tripple, pname, -1, elapsed_ms)
                    _tripple = go_place_stone(_tripple, pname, _go_territory, -1)
                    let _mir_model = dict_get(attempt, "model") ?? (dict_get(p, "model") ?? pname)
                    _tripple = go_record_result(_tripple, pname, _mir_model, _go_territory, -1)
                    _tripple = tripple_mirror_reflect(_tripple, pname, _mir_model, -1, elapsed_ms)
                    // Selector: learn from cascade failure
                    if3 _selector_alive == true { _selector_learn(pname + "/" + _mir_model, _domain, -1) }
                    cascade_depth = cascade_depth + 1
                }
                }
            }
        }
        i = i + 1
    }

    // All providers failed
    return {"ok": false, "trit": -1, "error": "all_providers_failed", "cascade_depth": cascade_depth, "domain": _domain}
}

// ============================================================
// ROUTE HANDLERS
// ============================================================

// -- POST /api/v1/query and /query --
fn handle_query(req) {
    let body = try3 { json_decode(req["body"]) } fail { req }
    let prompt = dict_get(body, "prompt") ?? (dict_get(req, "prompt") ?? "")
    if3 prompt == "" {
        return {"ok": false, "error": "missing prompt", "trit": -1}
    }

    let preferred = dict_get(body, "provider") ?? (dict_get(req, "provider") ?? "")
    let model = dict_get(body, "model") ?? (dict_get(req, "model") ?? "")

    let result = cascade_query(prompt, preferred, model)
    // Auto-control: Go engine evaluates and tunes after every query
    _auto_control()
    let ok = dict_get(result, "ok") ?? false

    if3 ok == true {
        _stats = dict_set(_stats, "total_queries", (dict_get(_stats, "total_queries") ?? 0) + 1)
        _stats = dict_set(_stats, "successful", (dict_get(_stats, "successful") ?? 0) + 1)
        _last_query_time = time()
        let provider_used = dict_get(result, "provider") ?? "unknown"
        let depth = dict_get(result, "cascade_depth") ?? 0
        // FIX: helper avoids if3 scoping bug
        let trit = flow_trit_from_depth(depth)
        let _qr = dict_set({"ok": true, "trit": trit}, "char", trit_char(trit))
        _qr = dict_set(_qr, "provider", provider_used)
        _qr = dict_set(_qr, "cascade_depth", depth)
        _qr = dict_set(_qr, "result", dict_get(result, "result") ?? {})
        _qr = dict_set(_qr, "territory", dict_get(result, "go_territory") ?? "chat")
        _qr = dict_set(_qr, "domain", dict_get(result, "domain") ?? "REASON")
        _qr = dict_set(_qr, "model", dict_get(result, "model") ?? "")
        _qr = dict_set(_qr, "ternary", true)
        // Report to Tripple — live resonance update
        let _rip = try3 { http_post("http://127.0.0.1:9881/hive/tripple/ripple", {"provider": provider_used, "trit": 1, "latency": depth * 1000, "domain": dict_get(result, "domain") ?? "REASON"}) } fail { null }
        return _qr
    } else3 {
        _stats = dict_set(_stats, "total_queries", (dict_get(_stats, "total_queries") ?? 0) + 1)
        _stats = dict_set(_stats, "failed", (dict_get(_stats, "failed") ?? 0) + 1)
        // Report failure to Tripple
        let _rip2 = try3 { http_post("http://127.0.0.1:9881/hive/tripple/ripple", {"provider": "cascade_failed", "trit": -1, "latency": 30000, "domain": dict_get(result, "domain") ?? "REASON"}) } fail { null }
        return {
            "ok": false,
            "trit": -1,
            "char": "T",
            "error": dict_get(result, "error") ?? "cascade_failed",
            "cascade_depth": dict_get(result, "cascade_depth") ?? 0,
            "domain": dict_get(result, "domain") ?? "REASON",
            "ternary": true
        }
    }
}

// -- Helper: extract user prompt from browser proxy request --
// Handles: messages array (Anthropic/OpenAI), raw prompt field
fn _bp_get_prompt(body) {
    // Try messages array first (last user message)
    let messages = dict_get(body, "messages") ?? []
    let mcount = len(messages)
    if3 mcount > 0 {
        // Get last message - usually the user prompt
        let last_msg = messages[mcount - 1]
        let role = dict_get(last_msg, "role") ?? ""
        if3 role == "user" {
            return dict_get(last_msg, "content") ?? ""
        }
    }
    // Fallback: raw prompt
    return dict_get(body, "prompt") ?? ""
}

// -- Helper: build proxy response dict via dict_set chain --
fn _bp_build_response(response_text, provider, model, depth, domain) {
    let cb = [{"type": "text", "text": response_text}]
    let r = {"type": "message", "role": "assistant", "trit": 1}
    r = dict_set(r, "id", "novax-proxy")
    r = dict_set(r, "content", cb)
    r = dict_set(r, "model", model)
    r = dict_set(r, "stop_reason", "end_turn")
    r = dict_set(r, "_novax", true)
    r = dict_set(r, "_novax_provider", provider)
    r = dict_set(r, "_novax_cascade_depth", depth)
    r = dict_set(r, "_novax_domain", domain)
    r = dict_set(r, "_novax_free", true)
    return r
}

// Browser proxy shared secret (simple auth to prevent any-page abuse)
let _BP_TOKEN = "novax-bp-" + to_str(time())

// -- GET /api/v1/browser-proxy/token --
// Extension fetches this once at startup to get the shared secret.
// Only accessible from localhost (tserve binds 0.0.0.0 but this is fine
// since the token is only valid for this session).
fn handle_browser_proxy_token(req) {
    return {"token": _BP_TOKEN, "trit": 1}
}

// -- POST /api/v1/browser-proxy --
// Accepts OpenAI/Anthropic chat format from Brave extension.
// Routes through cascade (free tiers first), returns Anthropic Messages format.
fn handle_browser_proxy(req) {
    // Auth check: require shared token
    let headers = dict_get(req, "headers") ?? {}
    let req_token = dict_get(headers, "x-novax-token") ?? ""
    if3 req_token != _BP_TOKEN {
        return {"id": "novax-err", "type": "error", "trit": -1, "error": "unauthorized"}
    }

    let body = try3 { json_decode(req["body"]) } { req }
    let prompt = _bp_get_prompt(body)

    if3 prompt == "" {
        return {"id": "novax-err", "type": "error", "trit": -1, "error": "no prompt"}
    }

    // Route through cascade
    let result = cascade_query(prompt, "", "")
    _auto_control()

    let ok = dict_get(result, "ok") ?? false
    if3 ok != true {
        let err = dict_get(result, "error") ?? "cascade_failed"
        return {"id": "novax-err", "type": "error", "trit": -1, "error": err}
    }

    // Extract response
    let response_text = dict_get(result, "response") ?? ""
    if3 response_text == "" {
        let inner = dict_get(result, "result") ?? {}
        response_text = dict_get(inner, "response") ?? ""
    }
    // Reject empty responses
    if3 response_text == "" {
        return {"id": "novax-err", "type": "error", "trit": -1, "error": "empty_response"}
    }
    let provider = dict_get(result, "provider") ?? "unknown"
    let model = dict_get(result, "model") ?? ""
    let depth = dict_get(result, "cascade_depth") ?? 0
    let domain = dict_get(result, "domain") ?? "REASON"

    _stats = dict_set(_stats, "total_queries", (dict_get(_stats, "total_queries") ?? 0) + 1)
    _stats = dict_set(_stats, "successful", (dict_get(_stats, "successful") ?? 0) + 1)

    return _bp_build_response(response_text, provider, model, depth, domain)
}

// -- GET /api/v1/providers --
fn handle_providers(req) {
    let provider_list = []
    let total_models = 0
    let i = 0
    while3 i < len(_provider_order) {
        let pname = _provider_order[i]
        let p = dict_get(_providers, pname) ?? {}
        let ps = dict_get(_provider_stats, pname) ?? {}
        let trit = provider_trit(p)
        let reg_models = get_registry_models_for(pname)
        total_models = total_models + len(reg_models)
        provider_list = append(provider_list, {"name": pname, "tier": dict_get(p, "tier") ?? 0, "priority": dict_get(p, "priority") ?? 99, "enabled": dict_get(p, "enabled") ?? false, "has_key": dict_get(p, "has_key") ?? false, "model": dict_get(p, "model") ?? "", "type": dict_get(p, "type") ?? "", "seal": dict_get(p, "seal") ?? 0, "quality": dict_get(p, "quality") ?? 0, "trit": trit, "char": trit_char(trit), "queries": dict_get(ps, "queries") ?? 0, "success": dict_get(ps, "success") ?? 0, "fail": dict_get(ps, "fail") ?? 0, "models": reg_models, "model_count": len(reg_models)})
        i = i + 1
    }
    return {"ok": true, "trit": 1, "providers": provider_list, "count": len(_provider_order), "enabled": count_enabled(), "total_models": total_models, "registry_synced": _registry_synced, "abilities": _registry_abilities, "ternary": true}
}

// -- GET /api/v1/seals --
fn handle_seals(req) {
    let seals = {}
    let i = 0
    while3 i < len(_provider_order) {
        let pname = _provider_order[i]
        let p = dict_get(_providers, pname) ?? {}
        // FIX: dict_set() returns NEW dict — must reassign
        seals = dict_set(seals, pname, {
            "seal": dict_get(p, "seal") ?? 0,
            "max_seal": QUALITY_BASE,
            "quality": dict_get(p, "quality") ?? 0,
            "tier": dict_get(p, "tier") ?? 0,
            "trit": provider_trit(p)
        })
        i = i + 1
    }
    return {"ok": true, "trit": 1, "seals": seals, "quality_base": QUALITY_BASE, "ternary": true}
}

// -- Helpers for reynolds (avoid if3 scoping bugs) --
fn calc_reynolds(total_q, failed, cascades) {
    if3 total_q > 0 {
        return (failed * 100 / total_q) + (cascades * 100 / total_q)
    }
    return 0
}
fn reynolds_flow(re) {
    if3 re > 125 { return "turbulent" }
    if3 re > 27 { return "transitional" }
    return "laminar"
}
fn flow_trit(state) {
    if3 state == "turbulent" { return -1 }
    if3 state == "transitional" { return 0 }
    return 1
}
fn flow_trit_from_depth(depth) {
    if3 depth > 0 { return 0 }
    return 1
}

// -- GET /api/v1/reynolds --
fn handle_reynolds(req) {
    let total_q = dict_get(_stats, "total_queries") ?? 0
    let success = dict_get(_stats, "successful") ?? 0
    let failed = dict_get(_stats, "failed") ?? 0
    let cascades = dict_get(_stats, "cascades") ?? 0

    // Reynolds number analogy: low = laminar (queries flowing smoothly)
    // high = turbulent (lots of cascades/failures)
    // FIX: used helpers to avoid if3 scoping bugs
    let reynolds = calc_reynolds(total_q, failed, cascades)
    let flow_state = reynolds_flow(reynolds)
    let trit = flow_trit(flow_state)

    return {
        "ok": true,
        "trit": trit,
        "reynolds": reynolds,
        "flow_state": flow_state,
        "boundaries": {"laminar": 27, "transitional": 125, "turbulent": 343},
        "total_queries": total_q,
        "successful": success,
        "failed": failed,
        "cascades": cascades,
        "harmonic_boundaries": "H3^3=27 / H5^3=125 / H7^3=343",
        "ternary": true
    }
}

// -- Helpers for quality (avoid if3 scoping bugs) --
fn calc_success_rate(queries, success) {
    if3 queries > 0 { return success * 100 / queries }
    return 0.0
}
fn safe_div(a, b) {
    if3 b > 0 { return a / b }
    return 0.0
}

// -- GET /api/v1/quality --
fn handle_quality(req) {
    let quality_map = {}
    let total_quality = 0.0
    let enabled_count = 0
    let i = 0
    while3 i < len(_provider_order) {
        let pname = _provider_order[i]
        let p = dict_get(_providers, pname) ?? {}
        let q = dict_get(p, "quality") ?? 0
        let ps = dict_get(_provider_stats, pname) ?? {}
        let queries = dict_get(ps, "queries") ?? 0
        let success = dict_get(ps, "success") ?? 0
        // FIX: helper avoids if3 scoping bug with success_rate
        let success_rate = calc_success_rate(queries, success)
        // FIX: dict_set() returns NEW dict — must reassign
        quality_map = dict_set(quality_map, pname, {
            "base_quality": q,
            "success_rate": success_rate,
            "queries": queries,
            "trit": provider_trit(p)
        })
        let enabled = dict_get(p, "enabled") ?? false
        // NOTE: let inside if3 creates scope-local, but while3 re-reads on next iter
        if3 enabled == true { total_quality = total_quality + q
            enabled_count = enabled_count + 1
        }
        i = i + 1
    }
    // FIX: helper avoids if3 scoping bug with avg_quality
    let avg_quality = safe_div(total_quality, enabled_count)
    return {
        "ok": true,
        "trit": 1,
        "quality": quality_map,
        "avg_quality": avg_quality,
        "enabled_providers": enabled_count,
        "quality_base": QUALITY_BASE,
        "ternary": true
    }
}

// -- GET /api/v1/cloud --
fn handle_cloud(req) {
    let key_status = {}
    let configured = 0
    let i = 0
    while3 i < len(_provider_order) {
        let pname = _provider_order[i]
        let p = dict_get(_providers, pname) ?? {}
        let has_key = dict_get(p, "has_key") ?? false
        let tier = dict_get(p, "tier") ?? 0
        // FIX: dict_set() returns NEW dict — must reassign
        key_status = dict_set(key_status, pname, {"has_key": has_key, "tier": tier, "type": dict_get(p, "type") ?? ""})
        if3 has_key == true { configured = configured + 1
        }
        i = i + 1
    }
    return {
        "ok": true,
        "trit": 1,
        "cloud_keys": key_status,
        "configured": configured,
        "total_providers": len(_provider_order),
        "hivemind_url": HIVEMIND_URL,
        "ollama_url": OLLAMA_URL,
        "ternary": true
    }
}

// -- POST /api/v1/bind --
fn handle_bind(req) {
    let pname = dict_get(req, "provider") ?? ""
    if3 pname == "" {
        return {"ok": false, "trit": -1, "error": "missing provider name"}
    }

    let has_provider = dict_get(_providers, pname) ?? "NOT_FOUND"
    if3 has_provider == "NOT_FOUND" {
        return {"ok": false, "trit": -1, "error": "unknown provider: " + pname}
    }

    let p = dict_get(_providers, pname) ?? {}
    let enable = dict_get(req, "enabled") ?? true
    p = dict_set(p, "enabled", enable)

    let new_key = dict_get(req, "has_key") ?? ""
    if3 new_key != "" {
        p = dict_set(p, "has_key", true)
    }

    let new_model = dict_get(req, "model") ?? ""
    if3 new_model != "" {
        p = dict_set(p, "model", new_model)
    }

    _providers = dict_set(_providers, pname, p)

    // Track bound providers
    if3 enable == true { let already = false
        let bi = 0
        while3 bi < len(_bound_providers) {
            if3 _bound_providers[bi] == pname { already = true
            }
            bi = bi + 1
        }
        if3 already != true {
            _bound_providers = append(_bound_providers, pname)
        }
    }

    return {
        "ok": true,
        "trit": 1,
        "provider": pname,
        "enabled": enable,
        "model": dict_get(p, "model") ?? "",
        "bound_count": len(_bound_providers),
        "ternary": true
    }
}

// -- POST /api/v1/transfer --
fn handle_transfer(req) {
    let prompt = dict_get(req, "prompt") ?? ""
    let from_provider = dict_get(req, "from") ?? ""
    let to_provider = dict_get(req, "to") ?? ""

    if3 prompt == "" {
        return {"ok": false, "trit": -1, "error": "missing prompt"}
    }
    if3 to_provider == "" {
        return {"ok": false, "trit": -1, "error": "missing target provider (to)"}
    }

    let result = try_provider(to_provider, prompt, "")
    let ok = dict_get(result, "ok") ?? false
    if3 ok == true {
        _stats = dict_set(_stats, "transfers", (dict_get(_stats, "transfers") ?? 0) + 1)
        return {
            "ok": true,
            "trit": 1,
            "from": from_provider,
            "to": to_provider,
            "result": dict_get(result, "result") ?? {},
            "ternary": true
        }
    } else3 {
        return {
            "ok": false,
            "trit": -1,
            "from": from_provider,
            "to": to_provider,
            "error": dict_get(result, "reason") ?? "transfer_failed",
            "ternary": true
        }
    }
}

// -- GET /api/v1/health3 --
fn handle_health3(req) {
    let total_q = dict_get(_stats, "total_queries") ?? 0
    let success = dict_get(_stats, "successful") ?? 0
    let enabled = count_enabled()

    let trit = 1
    if3 enabled < H3 { trit = 0
    }
    if3 enabled == 0 { trit = -1
    }
    if3 total_q > H13 { let fail_pct = (dict_get(_stats, "failed") ?? 0) * 100 / total_q
        if3 fail_pct > 50 { trit = -1
        } else3 fail_pct > 25 {
            trit = 0
        }
    }

    return {
        "ok": true,
        "trit": trit,
        "char": trit_char(trit),
        "service": SERVICE_NAME,
        "version": VERSION,
        "enabled_providers": enabled,
        "total_providers": len(_provider_order),
        "total_queries": total_q,
        "successful": success,
        "ternary": true,
        "runtime": "novalang",
        "harmonics": {"H3": H3, "H5": H5, "H7": H7, "H13": H13}
    }
}

// -- GET /health --
fn handle_health(req) {
    let enabled = count_enabled()
    let total_q = dict_get(_stats, "total_queries") ?? 0
    let resp = ns_health_dict(SERVICE_NAME, VERSION, PORT, {})
    resp = dict_set(resp, "runtime", "novalang")
    resp = dict_set(resp, "queries", total_q)
    resp = dict_set(resp, "successful", dict_get(_stats, "successful") ?? 0)
    resp = dict_set(resp, "failed", dict_get(_stats, "failed") ?? 0)
    resp = dict_set(resp, "cascades", dict_get(_stats, "cascades") ?? 0)
    resp = dict_set(resp, "transfers", dict_get(_stats, "transfers") ?? 0)
    resp = dict_set(resp, "total_tokens", dict_get(_stats, "total_tokens") ?? 0)
    resp = dict_set(resp, "providers", len(_provider_order))
    resp = dict_set(resp, "enabled_providers", enabled)
    resp = dict_set(resp, "bound_providers", len(_bound_providers))
    resp = dict_set(resp, "stub", false)
    return resp
}

// -- GET /status --
