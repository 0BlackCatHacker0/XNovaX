// Auto-control: runs go_strategic_control every RESONANCE_CYCLE (2187ms)
// Falls back to lightweight tripple_resonance_check between cycles
fn _should_run_control() {
    let last_ctrl = dict_get(_tripple, "go_last_control") ?? 0
    let elapsed = (time() - last_ctrl) * 1000
    if3 elapsed > RESONANCE_CYCLE { return 1 }
    return 0
}

fn _run_strategic() {
    let report = go_strategic_control(_tripple)
    _tripple = dict_get(report, "state")
    return 1
}

fn _run_resonance() {
    _tripple = tripple_resonance_check(_tripple)
    return 0
}

fn _auto_control() {
    let do_full = _should_run_control()
    if3 do_full == 1 { return _run_strategic() }
    return _run_resonance()
}

// -- GET /tripple/status --
fn _go_status_fields(base) {
    base = dict_set(base, "go_ctrl_runs", dict_get(_tripple, "go_control_runs") ?? 0)
    base = dict_set(base, "go_last_ctrl", dict_get(_tripple, "go_last_control") ?? 0)
    base = dict_set(base, "go_stones", dict_get(_tripple, "go_total_moves") ?? 0)
    base = dict_set(base, "go_score", dict_get(_tripple, "go_score") ?? 0)
    return base
}

fn handle_tripple_status(req) {
    _auto_control()
    _tripple = tripple_pacman_run(_tripple)
    _tripple = tripple_mirror_auto_advance(_tripple)
    let base = tripple_status(_tripple)
    base = dict_set(base, "test_field", 42)
    return base
}

// -- GET /tripple/wave --
fn handle_tripple_wave(req) {
    _auto_control()
    return tripple_standing_wave(_tripple)
}

// -- GET /tripple/prime --
fn handle_tripple_prime(req) {
    _auto_control()
    return tripple_prime_state(_tripple)
}

// -- POST /tripple/ripple --
fn _err_missing_provider() {
    return {"ok": 0, "trit": -1, "error": "missing provider"}
}

fn handle_tripple_ripple(req) {
    let body = try3 { json_decode(req["body"]) } fail { req }
    let provider = dict_get(body, "provider") ?? ""
    let trit = dict_get(body, "trit") ?? 0
    let latency_ms = dict_get(body, "latency_ms") ?? 100
    let territory = dict_get(body, "territory") ?? "chat"
    if3 provider == "" {
        return _err_missing_provider()
    }
    _tripple = tripple_ripple(_tripple, provider, trit, latency_ms)
    // Go engine: place stone on the territory board (yin-yang integration)
    _tripple = go_place_stone(_tripple, provider, territory, trit)
    // Auto-control: evaluate and tune after ripple injection
    _auto_control()
    return {"ok": 1, "trit": 1, "provider": provider, "injected_trit": trit, "latency_ms": latency_ms}
}

// -- GET /tripple/history --
fn handle_tripple_history(req) {
    let hist = dict_get(_tripple, "resonance_history") ?? []
    let score = dict_get(_tripple, "resonance_score") ?? 0
    let locked = dict_get(_tripple, "prime_locked") ?? 0
    return {"ok": 1, "trit": 1, "resonance_history": hist, "current_score": score, "prime_locked": locked, "history_length": len(hist)}
}

// -- GET /tripple/go -- Go engine board evaluation
fn handle_tripple_go(req) {
    let eval_result = go_evaluate(_tripple)
    return {"ok": 1, "trit": 1, "go": eval_result}
}

// -- GET /tripple/strategy -- Combined chess+go yin-yang status
fn handle_tripple_strategy(req) {
    let strat = strategy_status(_tripple)
    return {"ok": 1, "trit": 1, "strategy": strat}
}

// -- GET /tripple/go/recommend -- Go expansion recommendations
fn handle_tripple_go_recommend(req) {
    let recs = go_recommend_expansion(_tripple)
    return {"ok": 1, "trit": 1, "recommendations": recs, "count": len(recs)}
}

// -- POST /tripple/go/control -- Run strategic control loop (brain)
// This is the thermostat: Go evaluates territory, then ACTS on it.
// Tunes Tripple frequencies, Hivemind modulation, and fleet scaling.
fn handle_tripple_go_control(req) {
    let report = go_strategic_control(_tripple)
    let new_state = dict_get(report, "state") ?? _tripple
    let runs_in_state = dict_get(new_state, "go_control_runs") ?? -99
    print("[Go Control] runs_in_state=" + str(runs_in_state))
    _tripple = new_state
    let runs_in_global = dict_get(_tripple, "go_control_runs") ?? -88
    print("[Go Control] runs_in_global=" + str(runs_in_global))
    return {"ok": 1, "trit": 1, "control": report}
}

// -- POST /tripple/go/place -- Manually place a Go stone
fn _place_result(provider, territory, trit) {
    let r = dict_set({"ok": 1, "trit": 1, "placed": 1}, "provider", provider)
    r = dict_set(r, "territory", territory)
    r = dict_set(r, "stone_trit", trit)
    return r
}

fn handle_tripple_go_place(req) {
    let body = try3 { json_decode(req["body"]) } fail { req }
    let provider = dict_get(body, "provider") ?? ""
    let territory = dict_get(body, "territory") ?? ""
    let trit = dict_get(body, "trit") ?? 1
    _tripple = go_place_stone(_tripple, provider, territory, trit)
    return _place_result(provider, territory, trit)
}

fn handle_tripple_go_pieces(req) {
    let total = dict_get(_tripple, "go_pieces_count") ?? 0
    let bt = dict_get(_tripple, "go_pieces_by_territory") ?? null
    return {"ok": 1, "total_pieces": total, "by_territory": bt}
}

fn handle_tripple_go_best(req) {
    // PURE NOVALANG — no Python subprocess
    let data = try3 { go_best() } fail { null }
    if3 data != null { return data }
    return {"ok": 0, "trit": -1}
}

// -- GET /tripple/mirror/status --
fn handle_tripple_mirror_status(req) {
    return tripple_mirror_status(_tripple)
}

// -- POST /tripple/mirror/mode --
fn handle_tripple_mirror_mode(req) {
    let body = try3 { json_decode(req["body"]) } fail { req }
    let mode = dict_get(body, "mode") ?? 0
    _tripple = tripple_mirror_set_mode(_tripple, mode)
    let mode_name = "PASSIVE"
    if3 mode == 1 { mode_name = "ACTIVE" }
    if3 mode == -1 { mode_name = "OFF" }
    return {"ok": true, "trit": 1, "mirror_mode": mode_name, "mode_trit": mode}
}

// -- GET /tripple/pacman/status --
fn handle_tripple_pacman_status(req) {
    _tripple = tripple_pacman_run(_tripple)
    let base = tripple_pacman_status(_tripple)
    // Merge with expanded registry if available
    // PURE NOVALANG — no Python subprocess
    let reg = try3 { pacman_stats() } fail { null }
    if3 reg != null {
        base = dict_set(base, "total_skills", dict_get(reg, "total_skills") ?? 0)
        base = dict_set(base, "total_abilities", dict_get(reg, "total_abilities") ?? 0)
        base = dict_set(base, "total_features", dict_get(reg, "total_features") ?? 0)
        base = dict_set(base, "ready_abilities", dict_get(reg, "ready_abilities") ?? 0)
        base = dict_set(base, "active_features", dict_get(reg, "active_features") ?? 0)
        base = dict_set(base, "all_locked", 1)
        base = dict_set(base, "skill_categories", dict_get(reg, "skill_categories") ?? {})
        base = dict_set(base, "skill_territories", dict_get(reg, "skill_territories") ?? {})
    }
    return base
}

// -- POST /tripple/pacman/discover --
fn handle_tripple_pacman_discover(req) {
    // PURE NOVALANG — no Python subprocess
    // Note: mega_discover is complex (840 lines Python). For now, call pacman_stats()
    // as a fallback until full mega_discover is ported to NovaLang.
    let data = try3 { pacman_stats() } fail { null }
    if3 data != null {
        data = dict_set(data, "source", "pure_novalang")
        return data
    }
    return {"ok": 0, "trit": -1, "error": "discovery failed"}
}

// -- POST /tripple/pacman/boot_lock --
fn handle_tripple_pacman_boot_lock(req) {
    // PURE NOVALANG — no Python subprocess
    // Boot lock sequence: discover → inject → lock all
    let discover_data = try3 { discover_all_models() } fail { null }
    let inject_data = try3 { boot_inject_list() } fail { null }
    let inject_models = dict_get(inject_data, "models") ?? []
    let inject_result = tripple_mirror_bulk_inject(_tripple, inject_models)
    _tripple = dict_get(inject_result, "state")
    let lock_result = tripple_mirror_force_lock_all(_tripple)
    _tripple = dict_get(lock_result, "state")
    let locked_count = dict_get(lock_result, "total_locked") ?? 0
    return {"ok": 1, "trit": 1, "locked": locked_count, "source": "pure_novalang"}
}

// -- GET /tripple/advance/status --
fn handle_tripple_advance_status(req) {
    _tripple = tripple_mirror_auto_advance(_tripple)
    return tripple_mirror_advance_status(_tripple)
}

// -- POST /tripple/mirror/bulk_inject --
// Body: {"models": [{"id": "openai/gpt-4o", "provider": "openai"}, ...]}
fn handle_tripple_bulk_inject(req) {
    let body = try3 { json_decode(req["body"]) } fail { req }
    let models_list = dict_get(body, "models") ?? []
    let result = tripple_mirror_bulk_inject(_tripple, models_list)
    _tripple = dict_get(result, "state")
    // Run pacman + auto-control after bulk inject
    _tripple = tripple_pacman_run(_tripple)
    _auto_control()
    return {
        "ok": 1,
        "trit": 1,
        "injected": dict_get(result, "injected") ?? 0,
        "skipped": dict_get(result, "skipped") ?? 0,
        "total_mirror": dict_get(result, "total") ?? 0,
        "abilities": dict_get(_tripple, "mirror_abilities") ?? {},
        "unique_abilities": len(keys(dict_get(_tripple, "mirror_abilities") ?? {})),
        "resonance_score": dict_get(_tripple, "resonance_score") ?? 0
    }
}

// -- POST /tripple/mirror/force_lock_all --
// Permanently locks every model in the mirror
fn handle_tripple_force_lock_all(req) {
    let result = tripple_mirror_force_lock_all(_tripple)
    _tripple = dict_get(result, "state")
    return {
        "ok": true,
        "trit": 1,
        "new_locks": dict_get(result, "new_locks") ?? 0,
        "total_locked": dict_get(result, "total_locked") ?? 0,
        "advance_pct": 100,
        "status": "ALL MODELS PERMANENTLY LOCKED"
    }
}

