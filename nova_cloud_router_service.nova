        "service": SERVICE_NAME,
        "version": VERSION,
        "port": PORT,
        "providers": _provider_order,
        "enabled": enabled,
        "total": len(_provider_order),
        "trit": 1,
        "ternary": true,
        "runtime": "novalang"
    }
}

