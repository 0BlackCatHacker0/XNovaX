// -- GET /tripple/chladni/status --
fn handle_chladni_status(req) {
    let status = chladni_status(_tripple)
    status = dict_set(status, "ok", 1)
    status = dict_set(status, "trit", 1)
    return status
}

// -- GET /tripple/chladni/domains --
fn handle_chladni_domains(req) {
    let domains = dict_get(_tripple, "chladni_domains") ?? {}
    let matrix = dict_get(_tripple, "chladni_skill_matrix") ?? {}
    let result = {"ok": 1, "trit": 1}
    result = dict_set(result, "domains", domains)
    result = dict_set(result, "skill_matrix", matrix)
    result = dict_set(result, "total_placed", dict_get(_tripple, "chladni_total_placed") ?? 0)
    return result
}

// -- POST /tripple/chladni/route --
// Body: {"prompt": "..."}
fn handle_chladni_route(req) {
    let body = try3 { json_decode(req["body"]) } fail { req }
    let prompt = dict_get(body, "prompt") ?? ""
    if3 prompt == "" { return {"ok": false, "error": "missing prompt"} }
    let route = chladni_route(_tripple, prompt)
    route = dict_set(route, "ok", 1)
    route = dict_set(route, "trit", 1)
    return route
}

// -- GET /tripple/chladni/crosslinks?model=xxx --
fn handle_chladni_crosslinks(req) {
    let model_id = dict_get(req, "model") ?? ""
    if3 model_id == "" { return {"ok": false, "error": "missing model param"} }
    let links = chladni_find_crosslinks(_tripple, model_id)
    return {"ok": 1, "trit": 1, "model": model_id, "crosslinks": links, "count": len(links)}
}

// Debug: test try_provider directly AND test shell()
fn handle_debug_try(req) {
    let body = try3 { json_decode(req["body"]) } fail { req }
    let pname = dict_get(body, "provider") ?? "ollama"
    let prompt = dict_get(body, "prompt") ?? "test"
    let model = dict_get(body, "model") ?? ""
    // Direct cloud_call test (pure NovaLang, no Python)
    let direct = cloud_call(pname, model, prompt, "")
    let result = try_provider(pname, prompt, model)
    return {"debug": true, "try_result": result, "direct_call": direct}
}
troute(server, "POST", "/debug/try", "handle_debug_try")

fn handle_sync_registry(req) {
    return sync_from_registry()
}
troute(server, "POST", "/api/v1/sync", "handle_sync_registry")

tstart(server)
