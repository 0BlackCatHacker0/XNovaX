// -- GET /api/v1/quota --
fn _empty() { return {} }

fn _quota_entry(reqs, tokens, limit_rpd, limit_tpd, remaining, pct_str) {
    let e = _empty()
    e = dict_set(e, "requests", reqs)
    e = dict_set(e, "tokens", tokens)
    e = dict_set(e, "limit_rpd", limit_rpd)
    e = dict_set(e, "limit_tpd", limit_tpd)
    e = dict_set(e, "remaining", remaining)
    e = dict_set(e, "pct_used", pct_str)
    return e
}

fn _safe_usage(pk) {
    let u = dict_get(_quota_usage, pk) ?? _empty()
    return u
}

fn handle_quota(req) {
    let result = _empty()
    let prov_names = keys(_quota_usage)
    let i = 0
    while3 i < len(prov_names) {
        let pk = prov_names[i]
        let usage = _safe_usage(pk)
        let reqs = dict_get(usage, "requests") ?? 0
        let tokens = dict_get(usage, "tokens") ?? 0
        let limit_rpd = dict_get(usage, "limit_rpd") ?? 99999
        let limit_tpd = dict_get(usage, "limit_tpd") ?? 99999999
        let remaining = limit_rpd - reqs
        let pct_str = str(floor((reqs * 100) / limit_rpd))
        let entry = _quota_entry(reqs, tokens, limit_rpd, limit_tpd, remaining, pct_str)
        result = dict_set(result, pk, entry)
        i = i + 1
    }
    let r = _empty()
    r = dict_set(r, "ok", 1)
    r = dict_set(r, "trit", 1)
    r = dict_set(r, "quota", result)
    r = dict_set(r, "day", _quota_day)
    r = dict_set(r, "ternary", 1)
    return r
}

