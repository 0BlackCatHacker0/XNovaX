let H3  = 3
let H5  = 5
let H7  = 7
let BLOCK = 2187

// -- Ternary state symbols --
let T_TRUE  =  1
let T_MAYBE =  0
let T_FALSE = -1

// -- Reynolds boundaries --
let RE_LAMINAR    = 27
let RE_TRANSITION = 125
let RE_TURBULENT  = 343

// -- Derived harmonic constants --
// ALPHA_EMA = 1/H3 = 0.333 (harmonic EMA blend factor)
let ALPHA_EMA = 0.333
// TRIT_HIGH = 2/H3 = 0.667 (ternary thirds upper boundary)
let TRIT_HIGH = 0.667
// TRIT_LOW = 1/H3 = 0.333 (ternary thirds lower boundary)
let TRIT_LOW = 0.333
// TRADE_TERRITORY_GAP = H3 = 3 trit territory advantage needed
let TRADE_TERRITORY_GAP = 3

