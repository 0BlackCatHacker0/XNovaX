troute(server, "GET",  "/loop/deliberations",  "loop_deliberations")
troute(server, "GET",  "/loop/tasks",          "loop_tasks")
troute(server, "GET",  "/loop/self-heal",      "loop_self_heal")
troute(server, "GET",  "/loop/optimizer",      "loop_optimizer")
troute(server, "POST", "/loop/dispatch",       "handle_dispatch")
troute(server, "POST", "/loop/deliberate",     "handle_deliberate")
troute(server, "POST", "/loop/heal",           "handle_heal")
troute(server, "POST", "/loop/optimize",       "handle_optimize")
troute(server, "POST", "/loop/toggle",         "handle_toggle")
troute(server, "POST", "/loop/anomaly",        "handle_anomaly")
troute(server, "POST", "/closed_loop/tick",    "handle_tick")

