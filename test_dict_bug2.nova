// More targeted tests
let inner = {"a": 1, "b": 2}
print("inner type check:")
print(inner)
print(type(inner))

// Test json_encode on a flat dict
print("flat dict json_encode:")
print(json_encode({"x": 1, "y": 2}))

// Test json_encode on nested dict
print("nested dict json_encode:")
print(json_encode({"outer": inner}))

// Test what the dict literal actually builds
let d = {"key": inner}
print("d keys:")
print(keys(d))
print("d['key']:")
print(dict_get(d, "key") ?? "MISSING")
print("type of d['key']:")
print(type(dict_get(d, "key") ?? "MISSING"))
