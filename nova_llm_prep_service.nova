// Nova LLM Prep Service v2.0 — Full Provider Ecosystem Training Pipeline
// Port 9929 | Micro-tool pattern | 3-5-7-13 harmonics
// Harvests from 588 cloud + 102 local + 509,882 HuggingFace models across 24 providers
// Tripple resonance scoring → super archive → ternary training data
// Bridges: HiveMind(9881) + CloudRouter(9878) + TBuffer(9886) + Orchestrator(9999)

import3("lib/nova_ns_core.nova")
import3("lib/nova_stdlib.nova")

