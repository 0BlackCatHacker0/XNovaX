// ── HTTP helpers ──
fn safe_post(url, data) {
  let resp = try3 { http_post(url, data) } fail { {"ok": false, "body": "{}"} }
  let raw_body = dict_get(resp, "body") ?? "{}"
  let parsed = try3 { json_decode(raw_body) } fail { {"ok": false, "error": "parse_failed"} }
  return parsed
}

fn safe_get(url) {
  let resp = try3 { http_get(url) } fail { {"ok": false, "body": "{}"} }
  let raw_body = dict_get(resp, "body") ?? "{}"
  let parsed = try3 { json_decode(raw_body) } fail { {"ok": false, "error": "parse_failed"} }
  return parsed
}

// ── Recursive directory walker ──
fn walk_dir(base_path, ext_filter) {
  let results = []
  let entries = try3 { dir_list(base_path) } fail { [] }
  let i = 0
  while3 (i < len(entries)) {
    let name = entries[i]
    let full = base_path + "/" + name
    if3 (is_dir(full) == 1) {
      let skip = false
      if3 (name == "node_modules") { skip = true } else { }
      if3 (name == ".git") { skip = true } else { }
      if3 (name == "target") { skip = true } else { }
      if3 (name == "__pycache__") { skip = true } else { }
      if3 (skip == false) {
        let sub = walk_dir(full, ext_filter)
        let si = 0
        while3 (si < len(sub)) {
          results = append(results, sub[si])
          si = si + 1
        }
      } else { }
    } else {
      if3 (ext_filter == "") {
        results = append(results, full)
      } else {
        if3 (ends_with(lower(name), ext_filter) == true) {
          results = append(results, full)
        } else { }
      }
    }
    i = i + 1
  }
  return results
}

// ── Ternary token ID generator ──
fn to_balanced_ternary(n) {
  if3 (n == 0) { return "0" } else { }
  let result = ""
  let val = n
  if3 (val < 0) { val = 0 - val } else { }
  while3 (val > 0) {
    let rem = val % 3
    val = floor(val / 3)
    if3 (rem == 0) { result = "0" + result } else { }
    if3 (rem == 1) { result = "+" + result } else { }
    if3 (rem == 2) {
      result = "-" + result
      val = val + 1
    } else { }
  }
  if3 (n < 0) { result = "~" + result } else { }
  return result
}

// ── 3-5-7-13 Harmonic Chunking ──
fn harmonic_chunk(text) {
  let harmonics = [3, 5, 7, 13]
  let chunks = []
  let pos = 0
  let hi = 0
  let text_len = len(text)
  while3 (pos < text_len) {
    let chunk_size = harmonics[hi % 4]
    let end_pos = pos + chunk_size
    if3 (end_pos > text_len) { end_pos = text_len } else { }
    let chunk = slice(text, pos, end_pos)
    if3 (len(chunk) > 0) {
      chunks = append(chunks, chunk)
    } else { }
    pos = end_pos
    hi = hi + 1
  }
  return chunks
}

// ── Generate timestamp string ──
fn timestamp_id() {
  let t = time_ms()
  let ts = str(t)
  return ts
}

// ── Read super archive entries from disk ──
fn read_archive_entries() {
  let all_entries = []
  let files = try3 { dir_list(SUPER_ARCHIVE) } fail { [] }
  let fi = 0
  while3 (fi < len(files)) {
    let fname = files[fi]
    if3 (ends_with(fname, ".json") == true) {
      let fpath = SUPER_ARCHIVE + "/" + fname
      let content = try3 { read_file(fpath) } fail { "" }
      if3 (content != "") {
        let entry = try3 { json_decode(content) } fail { {} }
        let has_prompt = dict_get(entry, "prompt") ?? ""
        if3 (has_prompt != "") {
          all_entries = append(all_entries, entry)
        } else { }
      } else { }
    } else { }
    fi = fi + 1
  }
  return all_entries
}

// ── Save a single archive entry to disk ──
fn save_archive_entry(entry) {
  let tid = timestamp_id()
  let domain = dict_get(entry, "domain") ?? "unknown"
  let fname = domain + "_" + tid + ".json"
  let fpath = SUPER_ARCHIVE + "/" + fname
  let data = json_encode(entry)
  let ok = try3 { write_file(fpath, data) } fail { -1 }
  return ok
}

// ── Query a single prompt through HiveMind ──
fn query_hivemind(prompt, domain) {
  let payload = json_encode({"prompt": prompt, "channel": domain, "collect_all": true})
  let start = time_ms()
  let resp = safe_post(HIVEMIND + "/hive/query", payload)
  let elapsed = time_ms() - start
  let response_text = dict_get(resp, "response") ?? (dict_get(resp, "text") ?? "")
  let model = dict_get(resp, "model") ?? "hivemind-swarm"
  let provider = dict_get(resp, "provider") ?? "hivemind"
  let result = {
    "provider": provider,
    "model": model,
    "text": response_text,
    "trit": "+1",
    "latency": elapsed,
    "resonance_score": 0
  }
  return result
}

// ── Query a single prompt through Cloud Router ──
fn query_cloud_router(prompt, domain) {
  let payload = json_encode({"prompt": prompt, "channel": domain})
  let start = time_ms()
  let resp = safe_post(CLOUD_ROUTER + "/api/v1/query", payload)
  let elapsed = time_ms() - start
  let response_text = dict_get(resp, "response") ?? (dict_get(resp, "text") ?? "")
  let model = dict_get(resp, "model") ?? "cloud-cascade"
  let provider = dict_get(resp, "provider") ?? "cloud-router"
  let result = {
    "provider": provider,
    "model": model,
    "text": response_text,
    "trit": "+1",
    "latency": elapsed,
    "resonance_score": 0
  }
  return result
}

// ── Score a response using Tripple resonance ──
fn score_response(prompt, response_text) {
  if3 (response_text == "") { return 0 } else { }
  let payload = json_encode({"prompt": prompt, "response": response_text})
  let resp = safe_post(HIVEMIND + "/hive/tripple/ripple", payload)
  let score = dict_get(resp, "resonance") ?? (dict_get(resp, "score") ?? 0)
  if3 (type(score) == "string") {
    score = try3 { to_num(score) } fail { 0 }
  } else { }
  return score
}

// ── Fire a single prompt through all providers and collect scored responses ──
fn harvest_single_prompt(prompt, domain) {
  print("[harvest] Firing prompt through providers: " + slice(prompt, 0, 60) + "...")
  let responses = []

  // 1. HiveMind query (hits multiple local + cloud models)
  let hive_resp = query_hivemind(prompt, domain)
  let hive_text = dict_get(hive_resp, "text") ?? ""
  if3 (hive_text != "") {
    let hive_score = score_response(prompt, hive_text)
    hive_resp = dict_set(hive_resp, "resonance_score", hive_score)
    responses = append(responses, hive_resp)
  } else { }

  // 2. Cloud Router cascade (hits all 24 providers)
  let cloud_resp = query_cloud_router(prompt, domain)
  let cloud_text = dict_get(cloud_resp, "text") ?? ""
  if3 (cloud_text != "") {
    let cloud_score = score_response(prompt, cloud_text)
    cloud_resp = dict_set(cloud_resp, "resonance_score", cloud_score)
    responses = append(responses, cloud_resp)
  } else { }

  // 3. Direct provider queries for diversity
  let direct_providers = [
    {"name": "openai", "endpoint": CLOUD_ROUTER + "/api/v1/query"},
    {"name": "anthropic", "endpoint": CLOUD_ROUTER + "/api/v1/query"},
    {"name": "google", "endpoint": CLOUD_ROUTER + "/api/v1/query"},
    {"name": "mistral", "endpoint": CLOUD_ROUTER + "/api/v1/query"},
    {"name": "groq", "endpoint": CLOUD_ROUTER + "/api/v1/query"},
    {"name": "deepseek", "endpoint": CLOUD_ROUTER + "/api/v1/query"},
    {"name": "cohere", "endpoint": CLOUD_ROUTER + "/api/v1/query"},
    {"name": "together", "endpoint": CLOUD_ROUTER + "/api/v1/query"},
    {"name": "openrouter", "endpoint": CLOUD_ROUTER + "/api/v1/query"}
  ]
  let pi = 0
  while3 (pi < len(direct_providers)) {
    let prov = direct_providers[pi]
    let prov_name = dict_get(prov, "name") ?? "unknown"
    let prov_endpoint = dict_get(prov, "endpoint") ?? ""
    let prov_payload = json_encode({"prompt": prompt, "provider": prov_name, "channel": domain})
    let prov_start = time_ms()
    let prov_resp = safe_post(prov_endpoint, prov_payload)
    let prov_elapsed = time_ms() - prov_start
    let prov_text = dict_get(prov_resp, "response") ?? (dict_get(prov_resp, "text") ?? "")
    if3 (prov_text != "") {
      let prov_score = score_response(prompt, prov_text)
      let prov_model = dict_get(prov_resp, "model") ?? prov_name
      let prov_entry = {
        "provider": prov_name,
        "model": prov_model,
        "text": prov_text,
        "trit": "+1",
        "latency": prov_elapsed,
        "resonance_score": prov_score
      }
      responses = append(responses, prov_entry)
    } else { }
    pi = pi + 1
  }

  // Find best response by resonance score
  let best_response = ""
  let best_score = -1
  let best_provider = ""
  let ri = 0
  while3 (ri < len(responses)) {
    let r = responses[ri]
    let r_score = dict_get(r, "resonance_score") ?? 0
    if3 (r_score > best_score) {
      best_score = r_score
      best_response = dict_get(r, "text") ?? ""
      best_provider = dict_get(r, "provider") ?? ""
    } else { }
    ri = ri + 1
  }

  // Build archive entry
  let entry = {
    "prompt": prompt,
    "domain": domain,
    "responses": responses,
    "best_response": best_response,
    "best_provider": best_provider,
    "best_score": best_score,
    "response_count": len(responses),
    "harvested_at": timestamp_id()
  }

  // Save to super archive
  let save_ok = save_archive_entry(entry)
  print("[harvest] Saved: " + str(len(responses)) + " responses, best=" + best_provider + " score=" + str(best_score))
  return entry
}

// ══════════════════════════════════════════════
// MICRO-TOOL 1: GET /health
// ══════════════════════════════════════════════
fn handle_health(req) {
  let h = ns_health_dict(_port, "nova-llm-prep", _version)
  let archive_files = try3 { dir_list(SUPER_ARCHIVE) } fail { [] }
  let archive_count = 0
  let afi = 0
  while3 (afi < len(archive_files)) {
    let afname = archive_files[afi]
    if3 (ends_with(afname, ".json") == true) {
      archive_count = archive_count + 1
    } else { }
    afi = afi + 1
  }
  let training_exists = try3 { is_file(TRAINING_DIR + "/training_data.json") } fail { 0 }
  h = dict_set(h, "archive_entries", archive_count)
  h = dict_set(h, "training_data_ready", training_exists)
  h = dict_set(h, "seed_domains", len(keys(SEED_PROMPTS)))
  h = dict_set(h, "seed_prompts_total", 130)
  h = dict_set(h, "providers", "588 cloud + 102 local + 509882 HuggingFace across 24 providers")
  return h
}

// ══════════════════════════════════════════════
// MICRO-TOOL 2: POST /llm/harvest-providers
// Fire training prompts through ALL providers simultaneously
// Body: {"prompts": [...], "domain": "REASON"} or omit for seed prompts
// ══════════════════════════════════════════════
fn handle_harvest_providers(req) {
  ns_record(1, 0)
  let body = try3 { json_decode(dict_get(req, "body") ?? "{}") } fail { {} }
  let custom_prompts = dict_get(body, "prompts") ?? []
  let target_domain = dict_get(body, "domain") ?? "all"
  let max_per_domain = dict_get(body, "max_per_domain") ?? 13

  let prompts_to_fire = []

  // If custom prompts provided, use those
  if3 (len(custom_prompts) > 0) {
    let cpi = 0
    while3 (cpi < len(custom_prompts)) {
      let cp = custom_prompts[cpi]
      let cp_entry = {"prompt": cp, "domain": target_domain}
      prompts_to_fire = append(prompts_to_fire, cp_entry)
      cpi = cpi + 1
    }
  } else {
    // Use seed prompts — either a specific domain or all
    let domains = keys(SEED_PROMPTS)
    let di = 0
    while3 (di < len(domains)) {
      let dname = domains[di]
      let use_domain = false
      if3 (target_domain == "all") { use_domain = true } else { }
      if3 (target_domain == dname) { use_domain = true } else { }
      if3 (use_domain == true) {
        let domain_prompts = dict_get(SEED_PROMPTS, dname) ?? []
        let dpi = 0
        let dcount = 0
        while3 (dpi < len(domain_prompts)) {
          if3 (dcount < max_per_domain) {
            let dp_entry = {"prompt": domain_prompts[dpi], "domain": dname}
            prompts_to_fire = append(prompts_to_fire, dp_entry)
            dcount = dcount + 1
          } else { }
          dpi = dpi + 1
        }
      } else { }
      di = di + 1
    }
  }

  print("[harvest-providers] Firing " + str(len(prompts_to_fire)) + " prompts through provider ecosystem...")

  let total_responses = 0
  let total_entries = 0
  let results = []

  let pi = 0
  while3 (pi < len(prompts_to_fire)) {
    let pentry = prompts_to_fire[pi]
    let prompt = dict_get(pentry, "prompt") ?? ""
    let domain = dict_get(pentry, "domain") ?? "REASON"
    if3 (prompt != "") {
      let entry = harvest_single_prompt(prompt, domain)
      let resp_count = dict_get(entry, "response_count") ?? 0
      total_responses = total_responses + resp_count
      total_entries = total_entries + 1
      let summary = {
        "prompt": slice(prompt, 0, 80),
        "domain": domain,
        "responses": resp_count,
        "best_provider": dict_get(entry, "best_provider") ?? "",
        "best_score": dict_get(entry, "best_score") ?? 0
      }
      results = append(results, summary)
    } else { }
    pi = pi + 1
  }

  print("[harvest-providers] Complete: " + str(total_entries) + " prompts, " + str(total_responses) + " total responses")

  return {
    "ok": true,
    "prompts_fired": total_entries,
    "total_responses": total_responses,
    "archive_path": SUPER_ARCHIVE,
    "results": results
  }
}

// ══════════════════════════════════════════════
// MICRO-TOOL 3: POST /llm/harvest-bulk
// Accept a list of training prompts and fire them ALL
// Body: {"prompts": [...], "providers": "all"}
// ══════════════════════════════════════════════
fn handle_harvest_bulk(req) {
  ns_record(1, 0)
  let body = try3 { json_decode(dict_get(req, "body") ?? "{}") } fail { {} }
  let prompts = dict_get(body, "prompts") ?? []
  let providers_mode = dict_get(body, "providers") ?? "all"
  let domain = dict_get(body, "domain") ?? "GENERAL"

  if3 (len(prompts) == 0) {
    return {"ok": false, "error": "no_prompts", "hint": "POST {prompts: ['What is...', 'How do you...'], providers: 'all'}"}
  } else { }

  print("[harvest-bulk] Processing " + str(len(prompts)) + " prompts, providers=" + providers_mode)

  let total_responses = 0
  let total_entries = 0
  let results = []

  let pi = 0
  while3 (pi < len(prompts)) {
    let prompt = prompts[pi]
    if3 (prompt != "") {
      let entry = harvest_single_prompt(prompt, domain)
      let resp_count = dict_get(entry, "response_count") ?? 0
      total_responses = total_responses + resp_count
      total_entries = total_entries + 1
      let summary = {
        "prompt": slice(prompt, 0, 80),
        "responses": resp_count,
        "best_provider": dict_get(entry, "best_provider") ?? "",
        "best_score": dict_get(entry, "best_score") ?? 0
      }
      results = append(results, summary)
    } else { }
    pi = pi + 1
  }

  print("[harvest-bulk] Complete: " + str(total_entries) + " prompts, " + str(total_responses) + " responses collected")

  return {
    "ok": true,
    "prompts_processed": total_entries,
    "total_responses": total_responses,
    "providers_mode": providers_mode,
    "archive_path": SUPER_ARCHIVE,
    "results": results
  }
}

// ══════════════════════════════════════════════
// MICRO-TOOL 4: POST /llm/generate-training-set
// Convert super archive into ternary training data
// ══════════════════════════════════════════════
fn handle_generate_training_set(req) {
  ns_record(1, 0)
  print("[generate-training-set] Reading super archive...")

  let entries = read_archive_entries()
  if3 (len(entries) == 0) {
    return {"ok": false, "error": "empty_archive", "hint": "Run POST /llm/harvest-providers first to populate the archive"}
  } else { }

  print("[generate-training-set] Found " + str(len(entries)) + " archive entries")

  // Extract best response for each entry → training pairs
  let training_pairs = []
  let total_chars = 0
  let ei = 0
  while3 (ei < len(entries)) {
    let entry = entries[ei]
    let prompt = dict_get(entry, "prompt") ?? ""
    let best = dict_get(entry, "best_response") ?? ""
    let domain = dict_get(entry, "domain") ?? "unknown"
    let score = dict_get(entry, "best_score") ?? 0

    if3 (prompt != "") {
      if3 (best != "") {
        // Tokenize prompt and response using harmonic chunking
        let prompt_chunks = harmonic_chunk(prompt)
        let response_chunks = harmonic_chunk(best)

        let pair = {
          "prompt": prompt,
          "response": best,
          "domain": domain,
          "resonance_score": score,
          "prompt_tokens": len(prompt_chunks),
          "response_tokens": len(response_chunks)
        }
        training_pairs = append(training_pairs, pair)
        total_chars = total_chars + len(prompt) + len(best)
      } else { }
    } else { }
    ei = ei + 1
  }

  // Build ternary vocabulary from all training text
  print("[generate-training-set] Building ternary vocabulary...")
  let all_text = ""
  let ti = 0
  while3 (ti < len(training_pairs)) {
    let tp = training_pairs[ti]
    let p = dict_get(tp, "prompt") ?? ""
    let r = dict_get(tp, "response") ?? ""
    all_text = all_text + p + " " + r + " "
    ti = ti + 1
  }

  let all_chunks = harmonic_chunk(all_text)
  let vocab = {}
  let next_id = 1
  let ci = 0
  while3 (ci < len(all_chunks)) {
    let chunk = all_chunks[ci]
    let existing = dict_get(vocab, chunk) ?? ""
    if3 (existing == "") {
      let tid = to_balanced_ternary(next_id)
      vocab = dict_set(vocab, chunk, tid)
      next_id = next_id + 1
    } else { }
    ci = ci + 1
  }

  let vocab_size = len(keys(vocab))
  let total_tokens = len(all_chunks)

  // Build output data structure
  let training_data = {
    "version": "2.0.0",
    "generated_at": timestamp_id(),
    "encoding": "balanced_ternary_3-5-7-13",
    "total_pairs": len(training_pairs),
    "vocab_size": vocab_size,
    "total_tokens": total_tokens,
    "total_chars": total_chars,
    "pairs": training_pairs,
    "vocab_sample": {}
  }

  // Add first 13 vocab entries as sample
  let vkeys = keys(vocab)
  let vsi = 0
  let vocab_sample = {}
  let vs_limit = 13
  if3 (len(vkeys) < vs_limit) { vs_limit = len(vkeys) } else { }
  while3 (vsi < vs_limit) {
    let vk = vkeys[vsi]
    let vv = dict_get(vocab, vk) ?? ""
    vocab_sample = dict_set(vocab_sample, vk, vv)
    vsi = vsi + 1
  }
  training_data = dict_set(training_data, "vocab_sample", vocab_sample)

  // Write training data
  let output_path = TRAINING_DIR + "/training_data.json"
  let output_json = json_encode(training_data)
  let write_ok = try3 { write_file(output_path, output_json) } fail { -1 }

  print("[generate-training-set] Written " + str(len(training_pairs)) + " pairs, vocab=" + str(vocab_size) + " tokens=" + str(total_tokens))

  return {
    "ok": true,
    "training_pairs": len(training_pairs),
    "vocab_size": vocab_size,
    "total_tokens": total_tokens,
    "total_chars": total_chars,
    "output": output_path,
    "write_status": write_ok,
    "encoding": "balanced_ternary_3-5-7-13"
  }
}

// ══════════════════════════════════════════════
// MICRO-TOOL 5: GET /llm/archive-stats
// Show super archive status
// ══════════════════════════════════════════════
fn handle_archive_stats(req) {
  let entries = read_archive_entries()
  let total_entries = len(entries)

  if3 (total_entries == 0) {
    return {
      "ok": true,
      "total_entries": 0,
      "status": "empty",
      "hint": "Run POST /llm/harvest-providers to populate the archive"
    }
  } else { }

  // Aggregate stats
  let unique_prompts = {}
  let provider_counts = {}
  let unique_models = {}
  let total_responses = 0
  let total_score = 0
  let score_count = 0
  let total_chars = 0
  let domain_counts = {}

  let ei = 0
  while3 (ei < len(entries)) {
    let entry = entries[ei]
    let prompt = dict_get(entry, "prompt") ?? ""
    let domain = dict_get(entry, "domain") ?? "unknown"
    let responses = dict_get(entry, "responses") ?? []
    let best_score = dict_get(entry, "best_score") ?? 0

    // Track unique prompts
    if3 (prompt != "") {
      let prompt_key = slice(prompt, 0, 50)
      unique_prompts = dict_set(unique_prompts, prompt_key, 1)
    } else { }

    // Track domains
    let dc = dict_get(domain_counts, domain) ?? 0
    dc = dc + 1
    domain_counts = dict_set(domain_counts, domain, dc)

    // Track scores
    if3 (best_score > 0) {
      total_score = total_score + best_score
      score_count = score_count + 1
    } else { }

    // Track per-response stats
    let ri = 0
    while3 (ri < len(responses)) {
      let r = responses[ri]
      let rprov = dict_get(r, "provider") ?? "unknown"
      let rmodel = dict_get(r, "model") ?? "unknown"
      let rtext = dict_get(r, "text") ?? ""

      // Provider counts
      let pc = dict_get(provider_counts, rprov) ?? 0
      pc = pc + 1
      provider_counts = dict_set(provider_counts, rprov, pc)

      // Unique models
      unique_models = dict_set(unique_models, rmodel, 1)

      // Chars
      total_chars = total_chars + len(rtext)
      total_responses = total_responses + 1
      ri = ri + 1
    }

    ei = ei + 1
  }

  let avg_score = 0
  if3 (score_count > 0) {
    avg_score = floor(total_score / score_count * 100) / 100
  } else { }

  // Estimate token count and training time
  let est_tokens = floor(total_chars / 4)
  // Rough estimate: 1B param model at ~1000 tokens/sec training throughput
  let est_train_hours = floor(est_tokens / 3600000 * 100) / 100

  return {
    "ok": true,
    "total_entries": total_entries,
    "total_responses": total_responses,
    "unique_prompts": len(keys(unique_prompts)),
    "unique_models": len(keys(unique_models)),
    "providers_hit": provider_counts,
    "domain_breakdown": domain_counts,
    "average_resonance_score": avg_score,
    "corpus_chars": total_chars,
    "estimated_tokens": est_tokens,
    "estimated_training_hours_1B": est_train_hours,
    "archive_path": SUPER_ARCHIVE
  }
}

// ══════════════════════════════════════════════
// MICRO-TOOL 6: POST /llm/train-micro
// Start a micro-training run (config + validation)
// ══════════════════════════════════════════════
fn handle_train_micro(req) {
  ns_record(1, 0)
  let training_path = TRAINING_DIR + "/training_data.json"
  let training_content = try3 { read_file(training_path) } fail { "" }

  if3 (training_content == "") {
    return {"ok": false, "error": "no_training_data", "hint": "Run POST /llm/generate-training-set first"}
  } else { }

  let training_data = try3 { json_decode(training_content) } fail { {} }
  let pairs = dict_get(training_data, "pairs") ?? []
  let vocab_size = dict_get(training_data, "vocab_size") ?? 0
  let total_tokens = dict_get(training_data, "total_tokens") ?? 0

  if3 (len(pairs) == 0) {
    return {"ok": false, "error": "empty_training_data", "hint": "Training data has no pairs. Run harvest and generate-training-set."}
  } else { }

  print("[train-micro] Validating training data: " + str(len(pairs)) + " pairs")

  // Validate data quality
  let valid_pairs = 0
  let invalid_pairs = 0
  let total_prompt_len = 0
  let total_response_len = 0
  let domain_dist = {}

  let vi = 0
  while3 (vi < len(pairs)) {
    let pair = pairs[vi]
    let pp = dict_get(pair, "prompt") ?? ""
    let pr = dict_get(pair, "response") ?? ""
    let pd = dict_get(pair, "domain") ?? "unknown"

    if3 (len(pp) > 10) {
      if3 (len(pr) > 20) {
        valid_pairs = valid_pairs + 1
        total_prompt_len = total_prompt_len + len(pp)
        total_response_len = total_response_len + len(pr)
        let dd = dict_get(domain_dist, pd) ?? 0
        dd = dd + 1
        domain_dist = dict_set(domain_dist, pd, dd)
      } else {
        invalid_pairs = invalid_pairs + 1
      }
    } else {
      invalid_pairs = invalid_pairs + 1
    }
    vi = vi + 1
  }

  // Model size estimation for 1B params
  // BitNet: 1.58 bits per weight, so 1B params = ~198 MB
  let model_size_mb = floor(1000000000 * 1.58 / 8 / 1048576)
  let avg_prompt_len = 0
  let avg_response_len = 0
  if3 (valid_pairs > 0) {
    avg_prompt_len = floor(total_prompt_len / valid_pairs)
    avg_response_len = floor(total_response_len / valid_pairs)
  } else { }

  // Build training config
  let train_config = {
    "model_name": "novax-llm-v1",
    "architecture": "BitNet-1.58b-ternary",
    "target_params": "1B",
    "encoding": "balanced_ternary_3-5-7-13",
    "block_size": 2187,
    "vocab_size": vocab_size,
    "training_pairs": valid_pairs,
    "total_tokens": total_tokens,
    "quantization": "ternary_1.58bit",
    "harmonic_constants": [3, 5, 7, 13]
  }

  // Save config
  let config_path = TRAINING_DIR + "/train_config.json"
  let config_json = json_encode(train_config)
  let config_ok = try3 { write_file(config_path, config_json) } fail { -1 }

  print("[train-micro] Config saved. Ready for training: " + str(valid_pairs) + " valid pairs")

  return {
    "ok": true,
    "status": "validated_and_configured",
    "total_pairs": len(pairs),
    "valid_pairs": valid_pairs,
    "invalid_pairs": invalid_pairs,
    "vocab_size": vocab_size,
    "total_tokens": total_tokens,
    "avg_prompt_length": avg_prompt_len,
    "avg_response_length": avg_response_len,
    "domain_distribution": domain_dist,
    "model_config": train_config,
    "estimated_model_size_mb": model_size_mb,
    "config_path": config_path,
    "next_step": "BitNet training via quantizer service (coming soon)"
  }
}

// ══════════════════════════════════════════════
// SERVER: 7 micro-tools on port 9929
// ══════════════════════════════════════════════
let server = tserve(9929, "nova-llm-prep")
troute(server, "GET",  "/health",                   "handle_health")
troute(server, "POST", "/llm/harvest-providers",     "handle_harvest_providers")
troute(server, "POST", "/llm/harvest-bulk",          "handle_harvest_bulk")
troute(server, "POST", "/llm/generate-training-set", "handle_generate_training_set")
troute(server, "GET",  "/llm/archive-stats",         "handle_archive_stats")
troute(server, "POST", "/llm/train-micro",           "handle_train_micro")

print("Nova LLM Prep v" + _version + " | Port " + str(_port))
print("7 micro-tools: health, harvest-providers, harvest-bulk, generate-training-set, archive-stats, train-micro")
print("Bridges: HiveMind :9881 + Cloud Router :9878 + TBuffer :9886")
print("Seed prompts: 130 (13 x 10 domains) | 3-5-7-13 ternary tokenizer")
print("Provider ecosystem: 588 cloud + 102 local + 509,882 HuggingFace across 24 providers")
tstart(server)
