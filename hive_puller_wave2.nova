// ============================================================
// NovaLang Hive Puller v2.0 -- Wave 2: Maximum Swarm Expansion
// ============================================================
// Pulls 39 additional models -- ordered smallest to largest.
// Runs ENTIRELY inside the Hivemind process -- zero shells, zero windows.
// ============================================================

let PULLED = Trit(1)
let FAILED = Trit(-1)

// --- Wave 2 Targets (small -> large) ---
let targets = [
    "smollm2:135m",
    "smollm2:360m",
    "qwen2.5:0.5b",
    "tinyllama:1.1b",
    "qwen2.5-coder:1.5b",
    "granite3.1-dense:2b",
    "llama3.2:3b",
    "qwen2.5-coder:3b",
    "phi3.5:latest",
    "moondream:latest",
    "llava-phi3:latest",
    "openhermes:7b",
    "neural-chat:7b",
    "dolphin-mistral:7b",
    "starling-lm:latest",
    "codeqwen:7b",
    "deepseek-coder:6.7b",
    "starcoder2:7b",
    "qwen2.5-coder:7b",
    "deepseek-r1:7b",
    "wizard-math:7b",
    "meditron:7b",
    "medllama2:latest",
    "llama2:7b",
    "dolphin-llama3:8b",
    "deepseek-r1:8b",
    "phi3:mini-128k",
    "mistral:7b-instruct",
    "llama3.1:8b",
    "gemma2:9b",
    "granite3.1-dense:8b",
    "llava:13b",
    "codellama:13b",
    "llama2:13b",
    "vicuna:13b",
    "wizard-vicuna-uncensored:13b",
    "aya:35b",
    "nous-hermes2-mixtral:8x7b",
    "dolphin-mixtral:8x7b"
]

// --- Wave Config ---
let wave_size = 3
let wave_delay_sec = 2.0
let total_targets = len(targets)
let pull_Re = hive_reynolds(wave_size, 1.5, 4.0, wave_delay_sec)
print(f"Wave 2 Reynolds: {pull_Re} | Targets: {total_targets}")

let existing = hive_models()
let existing_count = len(existing)
hive_set_total(total_targets)

print("=== NOVALANG HIVE PULLER WAVE 2: ENGAGING ===")

// --- Pull all models (flat loop, no nested blocks) ---
for3 model in targets {
    print(f"  Pulling: {model}")
    hive_pull(model)
    wave_delay(wave_delay_sec)
}

// --- Final Report ---
print("=== WAVE 2 PULL COMPLETE ===")
let new_models = hive_models()
let new_count = len(new_models)
let added = new_count - existing_count
print(f"Before: {existing_count} | After: {new_count} | Added: {added}")
print(f"Reynolds: {pull_Re} | Health: P")
