                "hwnd": get_hwnd("claude")
            },
            "gpt": {
                "available": get_hwnd("gpt") > 0,
                "hwnd": get_hwnd("gpt")
            }
        },
        "bridge_active": bridge_active(),
        "capabilities": ["query", "script", "image", "file"],
        "commands": [
            "new_chat", "type", "submit", "click",
            "select_model", "select_session", "copy_response",
            "read_chat", "app_state", "focus"
        ]
    }
}

// ============================================================
// POST /cortex/hivemind/open_sidebar
// ============================================================
fn handle_hivemind_open_sidebar(body) {
    let target = dict_get(body, "target", "gpt")
    let cmd_id = enqueue_command("click", target, {"name": "Open sidebar"})

    let deadline = time() + H7 * H3
    let result = {}
    while3 time() < deadline {
        if dict_has(_cmd_results, cmd_id) {
            let result = dict_get(_cmd_results, cmd_id, {})
            dict_del(_cmd_results, cmd_id)
            return {"ok": true, "result": result}
        }
        let _w = nova_run("python -c \"import time;time.sleep(0.3)\"")
    }

    // Fallback: try Close sidebar (toggle)
    let cmd_id2 = enqueue_command("click", target, {"name": "Close sidebar"})
    let deadline2 = time() + H7 * H3
    let result2 = {}
    while3 time() < deadline2 {
        if dict_has(_cmd_results, cmd_id2) {
            let result2 = dict_get(_cmd_results, cmd_id2, {})
            dict_del(_cmd_results, cmd_id2)
            return {"ok": true, "result": result2}
        }
        let _w = nova_run("python -c \"import time;time.sleep(0.3)\"")
    }

    return {"ok": true, "result": {}}
}

