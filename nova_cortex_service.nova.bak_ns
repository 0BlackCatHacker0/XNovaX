// ============================================================
// POST /cortex/action
// ============================================================
fn handle_action(body) {
    let target = dict_get(body, "target", "claude")
    let action = dict_get(body, "action", "")
    let params = dict_get(body, "params", {})

    // Route through bridge if active
    if bridge_active() == true {
        let bridge_action = action
        if action == "new-chat" {
            let bridge_action = "new_chat"
        }
        if action == "select-session" {
            let bridge_action = "select_session"
        }
        let cmd_id = enqueue_command(bridge_action, target, params)

        // Simple poll for result (no threading)
        let deadline = time() + H7 * H3
        let result = {}
        while3 time() < deadline {
            if dict_has(_cmd_results, cmd_id) {
                let result = dict_get(_cmd_results, cmd_id, {})
                dict_del(_cmd_results, cmd_id)
                return result
            }
            // Small busy wait -- nova_run("python -c \"import time;time.sleep(0.3)\"")
            let _w = nova_run("python -c \"import time;time.sleep(0.3)\"")
        }
        return {"ok": false, "error": "Bridge timeout"}
    }

    // Direct UIA fallback via helper
    let hwnd = get_hwnd(target)
    if hwnd == 0 {
        return {"ok": false, "error": target + " window not found"}
    }

    if action == "new-chat" {
        let result = call_helper("click_element", {"hwnd": hwnd, "name": "New"})
        dict_set(result, "action", "new-chat")
        return result
    }
    if action == "select-session" {
        let sess_name = dict_get(params, "name", "")
        let result = call_helper("click_element", {"hwnd": hwnd, "name": sess_name})
        dict_set(result, "action", "select-session")
        dict_set(result, "name", sess_name)
        return result
    }
    if action == "click" {
        let click_name = dict_get(params, "name", "")
        let result = call_helper("click_element", {"hwnd": hwnd, "name": click_name})
        dict_set(result, "action", "click")
        dict_set(result, "name", click_name)
        return result
    }

    return {"ok": false, "error": "Unknown action: " + action}
}

// ============================================================
// POST /cortex/live/update -- accept snapshot from bridge
// ============================================================
fn handle_live_update(body) {
    let target = dict_get(body, "target", "claude")
    let snapshot = dict_get(body, "snapshot", {"elements": [], "total": 0})
    let messages = dict_get(body, "messages", [])

    if3 target == "claude" {
        let _live_claude_snapshot = snapshot
        let _live_claude_messages = messages
        let _live_claude_ts = time()
        let _live_claude_from_bridge = true
    } else target == "gpt" {
        let _live_gpt_snapshot = snapshot
        let _live_gpt_messages = messages
        let _live_gpt_ts = time()
        let _live_gpt_from_bridge = true
    } else {
        return {"ok": false, "error": "Unknown target: " + target}
    }

    return {
        "ok": true,
        "target": target,
        "cached": true,
        "elements": dict_get(snapshot, "total", 0),
        "messages": len(messages)
    }
}

// ============================================================
// POST /cortex/hint -- accept externally-discovered HWNDs
// ============================================================
fn handle_hint(body) {
    let results = {}
    let c_hwnd = dict_get(body, "claude_hwnd", 0)
    let g_hwnd = dict_get(body, "gpt_hwnd", 0)

    if int(c_hwnd) > 0 {
        let _claude_hwnd = int(c_hwnd)
        dict_set(results, "claude", {"ok": true, "hwnd": _claude_hwnd})
    }
    if int(g_hwnd) > 0 {
        let _gpt_hwnd = int(g_hwnd)
        dict_set(results, "gpt", {"ok": true, "hwnd": _gpt_hwnd})
    }

    return {"ok": true, "hints": results}
}

// ============================================================
// POST /cortex/command -- enqueue command for bridge
// ============================================================
fn handle_command(body) {
    let action = dict_get(body, "action", "")
    let target = dict_get(body, "target", "claude")
    if len(action) == 0 {
        return {"ok": false, "error": "No action specified"}
    }

    // Build params from body excluding action/target
    let params = {}
    let body_keys = keys(body)
    let ki = 0
    while3 ki < len(body_keys) {
        let k = dict_get(body_keys, ki)
        if k != "action" {
            if k != "target" {
                if k != "wait" {
                    if k != "timeout" {
                        dict_set(params, k, dict_get(body, k, ""))
                    }
                }
            }
        }
        let ki = ki + 1
    }

    let cmd_id = enqueue_command(action, target, params)

    // Optionally wait for result
    let wait = dict_get(body, "wait", false)
    if wait == true {
        let wait_timeout = int(dict_get(body, "timeout", H13))
        let deadline = time() + wait_timeout
        while3 time() < deadline {
            if dict_has(_cmd_results, cmd_id) {
                let result = dict_get(_cmd_results, cmd_id, {})
                dict_del(_cmd_results, cmd_id)
                return {"ok": true, "cmd_id": cmd_id, "result": result}
            }
            let _w = nova_run("python -c \"import time;time.sleep(0.3)\"")
        }
        return {"ok": true, "cmd_id": cmd_id, "result": null, "timeout": true}
    }

    return {"ok": true, "cmd_id": cmd_id, "queued": true}
}

// ============================================================
// POST /cortex/command/result -- bridge posts execution results
// ============================================================
fn handle_command_result(body) {
    let cmd_id = dict_get(body, "cmd_id", "")
    let result = dict_get(body, "result", {})
    if len(cmd_id) > 0 {
        dict_set(_cmd_results, cmd_id, result)
        return {"ok": true, "cmd_id": cmd_id, "stored": true}
    }
    return {"ok": false, "error": "No cmd_id"}
}

// ============================================================
// POST /cortex/bridge/interact -- type + submit via bridge
// ============================================================
fn handle_bridge_interact(body) {
    let target = dict_get(body, "target", "claude")
    let text = dict_get(body, "text", "")
    if len(text) == 0 {
        let text = dict_get(body, "prompt", "")
    }
    if len(text) == 0 {
        return {"ok": false, "error": "No text/prompt"}
    }

    let type_id = enqueue_command("type", target, {"text": text})
    let submit_id = enqueue_command("submit", target, {})
    return {
        "ok": true,
        "type_cmd": type_id,
        "submit_cmd": submit_id,
        "mode": "bridge"
    }
}

// ============================================================
// POST /cortex/hivemind/task -- autonomous interaction
// ============================================================
fn handle_hivemind_task(body) {
    let target = dict_get(body, "target", "gpt")
    let prompt = dict_get(body, "prompt", "")
    if len(prompt) == 0 {
        let prompt = dict_get(body, "text", "")
    }
    let task_type = dict_get(body, "task_type", "query")
    let new_chat = dict_get(body, "new_chat", true)
    let wait_time = int(dict_get(body, "wait_time", 30))

    if len(prompt) == 0 {
        return {"ok": false, "error": "No prompt provided"}
    }

    // Check target is available
    let hwnd = get_hwnd(target)
    if hwnd == 0 {
        return {"ok": false, "error": target + " not available (no hwnd)"}
    }

    // Get baseline message count
    let baseline_count = 0
    if3 target == "claude" {
        let baseline_count = len(_live_claude_messages)
    } else {
        let baseline_count = len(_live_gpt_messages)
    }

    let steps = []

    // Step 1: Create new chat if requested
    if new_chat == true {
        let cmd_id = enqueue_command("new_chat", target, {})
        // Wait for result
        let deadline = time() + H7 * H3
        let step_result = {}
        while3 time() < deadline {
            if dict_has(_cmd_results, cmd_id) {
                let step_result = dict_get(_cmd_results, cmd_id, {})
                dict_del(_cmd_results, cmd_id)
            }
            let _w = nova_run("python -c \"import time;time.sleep(0.3)\"")
        }
        append(steps, {"step": "new_chat", "result": step_result})
        // Wait for chat to open
        let _w = nova_run("python -c \"import time;time.sleep(1.5)\"")
    }

    // Step 2: Type the prompt
    let type_id = enqueue_command("type", target, {"text": prompt})
    let type_deadline = time() + H7 * H3
    let type_result = {}
    while3 time() < type_deadline {
        if dict_has(_cmd_results, type_id) {
            let type_result = dict_get(_cmd_results, type_id, {})
            dict_del(_cmd_results, type_id)
        }
        let _w = nova_run("python -c \"import time;time.sleep(0.3)\"")
    }
    append(steps, {"step": "type", "result": type_result})
    let _w = nova_run("python -c \"import time;time.sleep(0.5)\"")

    // Step 3: Submit (press Enter)
    let submit_id = enqueue_command("submit", target, {})
    let sub_deadline = time() + H7 * H3
    let submit_result = {}
    while3 time() < sub_deadline {
        if dict_has(_cmd_results, submit_id) {
            let submit_result = dict_get(_cmd_results, submit_id, {})
            dict_del(_cmd_results, submit_id)
        }
        let _w = nova_run("python -c \"import time;time.sleep(0.3)\"")
    }
    append(steps, {"step": "submit", "result": submit_result})

    // Step 4: Wait for response (poll cache for new messages)
    let response_deadline = time() + wait_time
    let response_text = ""
    let response_msg_count = 0
    let settled_count = 0
    let last_count = 0
    let task_start = time()

    while3 time() < response_deadline {
        // Poll every H3=3 seconds
        let _w = nova_run("python -c \"import time;time.sleep(3)\"")
        let current_count = 0
        if3 target == "claude" {
            let current_count = len(_live_claude_messages)
        } else {
            let current_count = len(_live_gpt_messages)
        }

        if current_count > baseline_count {
            if current_count == last_count {
                let settled_count = settled_count + 1
                if settled_count >= 2 {
                    // Response is complete -- extract new messages
                    let all_msgs = []
                    if3 target == "claude" {
                        let all_msgs = _live_claude_messages
                    } else {
                        let all_msgs = _live_gpt_messages
                    }
                    let new_msgs = slice(all_msgs, baseline_count, current_count)
                    let resp_parts = []
                    let mi = 0
                    while3 mi < len(new_msgs) {
                        let m = dict_get(new_msgs, mi)
                        let mt = dict_get(m, "text", "")
                        if len(mt) > 0 {
                            append(resp_parts, mt)
                        }
                        let mi = mi + 1
                    }
                    let response_text = join(resp_parts, "\n")
                    let response_msg_count = len(new_msgs)
            } else {
                let settled_count = 0
            }
            let last_count = current_count
        }
    }

    // Build result
    let task_ok = len(response_text) > 0
    let task_result = {
        "ok": task_ok,
        "target": target,
        "task_type": task_type,
        "prompt": prompt,
        "response": response_text,
        "response_messages": response_msg_count,
        "steps": steps,
        "wait_time_used": round(time() - task_start, 1)
    }

    // Update stats
    if3 task_ok == true {
        if target == "claude" {
            let _claude_queries = _claude_queries + 1
        }
        if target == "gpt" {
            let _gpt_queries = _gpt_queries + 1
        }
        let _trits_strong = _trits_strong + 1
        let _total_queries = _total_queries + 1
    } else {
        let _trits_failed = _trits_failed + 1
        let _total_queries = _total_queries + 1
        dict_set(task_result, "error", "No response captured within timeout")
    }

    return task_result
}

