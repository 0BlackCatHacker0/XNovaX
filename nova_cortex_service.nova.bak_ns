// ============================================================
// Helper: get structured app state for a target
// ============================================================
fn get_app_state(target) {
    let hwnd = get_hwnd(target)

    // Try direct UIA via helper
    try3 {
        let state = call_helper("app_state", {"target": target, "hwnd": hwnd})
        let total_els = dict_get(state, "total_elements", 0)
        if total_els > 0 {
            dict_set(state, "ok", true)
            dict_set(state, "target", target)
            dict_set(state, "source", "uia_direct")
            return state
    } else {
        // fall through to cache
    }

    // Fall back to bridge cache
    let cache_snap = {}
    let cache_ts = 0
    let cache_from = false
    if3 target == "claude" {
        let cache_snap = _live_claude_snapshot
        let cache_ts = _live_claude_ts
        let cache_from = _live_claude_from_bridge
    } else {
        let cache_snap = _live_gpt_snapshot
        let cache_ts = _live_gpt_ts
        let cache_from = _live_gpt_from_bridge
    }

    if cache_from == true {
        if cache_ts > 0 {
            let els = dict_get(cache_snap, "elements", [])
            let state = {
                "model": "",
                "current_session": "",
                "sessions": [],
                "tabs": [],
                "buttons": [],
                "total_elements": len(els),
                "ok": true,
                "target": target,
                "source": "bridge_cache"
            }
            // Parse elements for model, sessions, buttons
            let ei = 0
            while3 ei < len(els) {
                let el = dict_get(els, ei)
                let name = dict_get(el, "name", "")
                let ct = dict_get(el, "type", 0)
                let bounds = dict_get(el, "bounds", [0, 0, 0, 0])
                let depth = dict_get(el, "depth", 0)
                let el_id = dict_get(el, "id", "")

                if len(name) > 0 {
                    let nl = lower(trim(name))

                    // Model detection (button type = 50000)
                    let cur_model = dict_get(state, "model", "")
                    if len(cur_model) == 0 {
                        if ct == 50000 {
                            if contains(nl, "model selector") {
                                if contains(nl, "current model is ") {
                                    let parts = split(name, "current model is ")
                                    let cur_model_name = trim(dict_get(parts, len(parts) - 1))
                                    dict_set(state, "model", cur_model_name)
                                }
                            }
                        }
                    }

                    // Tab items (50013)
                    if ct == 50013 {
                        let tabs = dict_get(state, "tabs", [])
                        append(tabs, name)
                        dict_set(state, "tabs", tabs)
                    }

                    // Sessions: buttons or hyperlinks with depth >= 11
                    if ct == 50000 {
                        if depth >= 11 {
                            if len(name) > 5 {
                                let clean = split(name, " Open conversation options")
                                let clean_name = trim(dict_get(clean, 0))
                                if len(clean_name) > 3 {
                                    let sessions = dict_get(state, "sessions", [])
                                    append(sessions, {"name": clean_name, "id": el_id})
                                    dict_set(state, "sessions", sessions)
                                }
                            }
                        }
                    }
                    if ct == 50005 {
                        if depth >= 11 {
                            if len(name) > 5 {
                                let sessions = dict_get(state, "sessions", [])
                                append(sessions, {"name": name, "id": el_id})
                                dict_set(state, "sessions", sessions)
                            }
                        }
                    }

                    // Buttons
                    if ct == 50000 {
                        if len(name) > 0 {
                            let buttons = dict_get(state, "buttons", [])
                            append(buttons, {"name": name, "id": el_id})
                            dict_set(state, "buttons", buttons)
                        }
                    }
                }

                let ei = ei + 1
            }
            return state
        }
    }

    return {
        "ok": false,
        "error": "No UIA data available",
        "model": "",
        "sessions": [],
        "buttons": []
    }
}

// ============================================================
// POST /cortex/claude
// ============================================================
}
fn handle_claude(body) {
    let prompt = dict_get(body, "prompt", "")
    if len(prompt) == 0 {
        return {"error": "prompt required"}
    }
    let timeout = int(dict_get(body, "timeout", 90))
    let result = query_bridge("claude", prompt, timeout)
    let trit = cortex_trit(result)
    record_trit(trit)
    dict_set(result, "trit", trit)
    dict_set(result, "char", trit_char(trit))
    return result
}

