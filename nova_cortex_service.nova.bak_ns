fn handle_bridge_status(body) {
    return {
        "bridge_active": bridge_active(),
        "cache_claude_ts": _live_claude_ts,
        "cache_gpt_ts": _live_gpt_ts,
        "cache_claude_from_bridge": _live_claude_from_bridge,
        "cache_gpt_from_bridge": _live_gpt_from_bridge,
        "pending_commands": len(_cmd_queue),
        "results_cached": len(keys(_cmd_results))
    }
}

