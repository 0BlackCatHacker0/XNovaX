// ============================================================================
// Route handler: POST /tbalance/pool/update
// Body: {"name": "...", "targets": [...], "strategy": "..."} (targets/strategy optional)
// ============================================================================
fn handle_pool_update(req) {
    let body = dict_get(req, "body")
    let name = str(dict_get(body, "name"))

    if3 (len(name) == 0) {
        let resp = {}
        let resp = dict_set(resp, "ok", 0)
        let resp = dict_set(resp, "trit", T_FALSE)
        let resp = dict_set(resp, "error", "pool name required")
        resp
    } () {
        if3 (dict_has(_pools, name) == 0) {
            let resp = {}
            let resp = dict_set(resp, "ok", 0)
            let resp = dict_set(resp, "trit", T_FALSE)
            let resp = dict_set(resp, "error", "pool not found")
            resp
        } () {
            let pool = dict_get(_pools, name)

            // Update strategy if provided in body
            let has_strategy = dict_has(body, "strategy")
            if3 (has_strategy == 1) {
                let new_strat = lower(str(dict_get(body, "strategy")))
                if3 (is_valid_strategy(new_strat) == 0) {
                    let resp = {}
                    let resp = dict_set(resp, "ok", 0)
                    let resp = dict_set(resp, "trit", T_FALSE)
                    let resp = dict_set(resp, "error", "invalid strategy")
                    let resp = dict_set(resp, "valid_strategies", "weighted,least_conn,reynolds")
                    resp
                } () {
                    let pool = dict_set(pool, "strategy", new_strat)
                    // Continue to target update below (re-enter handler via inline logic)
                    let has_targets = dict_has(body, "targets")
                    if3 (has_targets == 1) {
                        let raw_targets = dict_get(body, "targets")
                        let rt_len = len(raw_targets)
                        if3 (rt_len > MAX_TARGETS_PER_POOL) {
                            let resp = {}
                            let resp = dict_set(resp, "ok", 0)
                            let resp = dict_set(resp, "trit", T_FALSE)
                            let resp = dict_set(resp, "error", "too many targets")
                            let resp = dict_set(resp, "max", MAX_TARGETS_PER_POOL)
                            resp
                        } () {
                            let targets = []
                            let idx = 0
                            while3 (idx < rt_len) {
                                let rt = dict_get(raw_targets, idx)
                                let url = str(dict_get(rt, "url"))
                                let weight = int(dict_get(rt, "weight"))
                                if3 (len(url) > 0) {
                                    let nt = new_target(url, weight)
                                    let targets = append(targets, nt)
                                } () {
                                    let targets = targets
                                } () {
                                    let targets = targets
                                }
                                let idx = idx + 1
                            }
                            let final_count = len(targets)
                            if3 (final_count == 0) {
                                let resp = {}
                                let resp = dict_set(resp, "ok", 0)
                                let resp = dict_set(resp, "trit", T_FALSE)
                                let resp = dict_set(resp, "error", "no valid targets in update")
                                resp
                            } () {
                                let pool = dict_set(pool, "targets", json_encode(targets))
                                let pool = dict_set(pool, "rr_counter", 0)
                                let pool = dict_set(pool, "updated_at", time())
                                let _pools = dict_set(_pools, name, pool)
                                let strat_now = dict_get(pool, "strategy")
                                let resp = {}
                                let resp = dict_set(resp, "ok", 1)
                                let resp = dict_set(resp, "trit", T_TRUE)
                                let resp = dict_set(resp, "pool", name)
                                let resp = dict_set(resp, "strategy", strat_now)
                                let resp = dict_set(resp, "target_count", final_count)
                                resp
                            } () {
                                let resp = {}
                                let resp = dict_set(resp, "ok", 0)
                                let resp = dict_set(resp, "trit", T_FALSE)
                                let resp = dict_set(resp, "error", "no valid targets in update")
                                resp
                            }
                        } () {
                            let resp = {}
                            let resp = dict_set(resp, "ok", 0)
                            let resp = dict_set(resp, "trit", T_FALSE)
                            let resp = dict_set(resp, "error", "too many targets")
                            resp
                        }
                    } () {
                        // No targets update, just strategy update
                        let pool = dict_set(pool, "updated_at", time())
                        let _pools = dict_set(_pools, name, pool)
                        let strat_now = dict_get(pool, "strategy")
                        let tgts_json = dict_get(pool, "targets")
                        let tgts_list = json_decode(tgts_json)
                        let tcount = len(tgts_list)
                        let resp = {}
                        let resp = dict_set(resp, "ok", 1)
                        let resp = dict_set(resp, "trit", T_TRUE)
                        let resp = dict_set(resp, "pool", name)
                        let resp = dict_set(resp, "strategy", strat_now)
                        let resp = dict_set(resp, "target_count", tcount)
                        resp
                    } () {
                        let resp = {}
                        let resp = dict_set(resp, "ok", 0)
                        let resp = dict_set(resp, "trit", T_FALSE)
                        let resp = dict_set(resp, "error", "target update check failed")
                        resp
                    }
                } () {
                    let resp = {}
                    let resp = dict_set(resp, "ok", 0)
                    let resp = dict_set(resp, "trit", T_FALSE)
                    let resp = dict_set(resp, "error", "invalid strategy")
                    resp
                }
            } () {
                // No strategy update: only update targets if provided
                let has_targets = dict_has(body, "targets")
                if3 (has_targets == 1) {
                    let raw_targets = dict_get(body, "targets")
                    let rt_len = len(raw_targets)
                    if3 (rt_len > MAX_TARGETS_PER_POOL) {
                        let resp = {}
                        let resp = dict_set(resp, "ok", 0)
                        let resp = dict_set(resp, "trit", T_FALSE)
                        let resp = dict_set(resp, "error", "too many targets")
                        let resp = dict_set(resp, "max", MAX_TARGETS_PER_POOL)
                        resp
                    } () {
                        let targets = []
                        let idx = 0
                        while3 (idx < rt_len) {
                            let rt = dict_get(raw_targets, idx)
                            let url = str(dict_get(rt, "url"))
                            let weight = int(dict_get(rt, "weight"))
                            if3 (len(url) > 0) {
                                let nt = new_target(url, weight)
                                let targets = append(targets, nt)
                            } () {
                                let targets = targets
                            } () {
                                let targets = targets
                            }
                            let idx = idx + 1
                        }
                        let final_count = len(targets)
                        if3 (final_count == 0) {
                            let resp = {}
                            let resp = dict_set(resp, "ok", 0)
                            let resp = dict_set(resp, "trit", T_FALSE)
                            let resp = dict_set(resp, "error", "no valid targets in update")
                            resp
                        } () {
                            let pool = dict_set(pool, "targets", json_encode(targets))
                            let pool = dict_set(pool, "rr_counter", 0)
                            let pool = dict_set(pool, "updated_at", time())
                            let _pools = dict_set(_pools, name, pool)
                            let strat_now = dict_get(pool, "strategy")
                            let resp = {}
                            let resp = dict_set(resp, "ok", 1)
                            let resp = dict_set(resp, "trit", T_TRUE)
                            let resp = dict_set(resp, "pool", name)
                            let resp = dict_set(resp, "strategy", strat_now)
                            let resp = dict_set(resp, "target_count", final_count)
                            resp
                        } () {
                            let resp = {}
                            let resp = dict_set(resp, "ok", 0)
                            let resp = dict_set(resp, "trit", T_FALSE)
                            let resp = dict_set(resp, "error", "no valid targets in update")
                            resp
                        }
                    } () {
                        let resp = {}
                        let resp = dict_set(resp, "ok", 0)
                        let resp = dict_set(resp, "trit", T_FALSE)
                        let resp = dict_set(resp, "error", "too many targets")
                        resp
                    }
                } () {
                    // Nothing to update: just touch updated_at
                    let pool = dict_set(pool, "updated_at", time())
                    let _pools = dict_set(_pools, name, pool)
                    let strat_now = dict_get(pool, "strategy")
                    let tgts_json = dict_get(pool, "targets")
                    let tgts_list = json_decode(tgts_json)
                    let tcount = len(tgts_list)
                    let resp = {}
                    let resp = dict_set(resp, "ok", 1)
                    let resp = dict_set(resp, "trit", T_TRUE)
                    let resp = dict_set(resp, "pool", name)
                    let resp = dict_set(resp, "strategy", strat_now)
                    let resp = dict_set(resp, "target_count", tcount)
                    resp
                } () {
                    let resp = {}
                    let resp = dict_set(resp, "ok", 0)
                    let resp = dict_set(resp, "trit", T_FALSE)
                    let resp = dict_set(resp, "error", "target update check failed")
                    resp
                }
            } () {
                let resp = {}
                let resp = dict_set(resp, "ok", 0)
                let resp = dict_set(resp, "trit", T_FALSE)
                let resp = dict_set(resp, "error", "strategy check failed")
                resp
            }
        } () {
            let resp = {}
            let resp = dict_set(resp, "ok", 0)
            let resp = dict_set(resp, "trit", T_FALSE)
            let resp = dict_set(resp, "error", "pool not found")
            resp
        }
    } () {
        let resp = {}
        let resp = dict_set(resp, "ok", 0)
        let resp = dict_set(resp, "trit", T_FALSE)
        let resp = dict_set(resp, "error", "pool name required")
        return resp
    }
}

// ============================================================================
// Route handler: GET /tbalance/pool/get
// Body or query: {"pool": "name"}
// (Dynamic path /tbalance/pool/<name> not supported in NovaLang tserve;
//  use query param pool=name or POST body {"pool":"name"})
// ============================================================================
fn handle_pool_get(req) {
    let body = dict_get(req, "body")
    let pool_name = str(dict_get(body, "pool"))

    if3 (len(pool_name) == 0) {
        let resp = {}
        let resp = dict_set(resp, "ok", 0)
        let resp = dict_set(resp, "trit", T_FALSE)
        let resp = dict_set(resp, "error", "pool name required")
        resp
    } () {
        if3 (dict_has(_pools, pool_name) == 0) {
            let resp = {}
            let resp = dict_set(resp, "ok", 0)
            let resp = dict_set(resp, "trit", T_FALSE)
            let resp = dict_set(resp, "error", "pool not found")
            resp
        } () {
            let pool = dict_get(_pools, pool_name)
            let targets_json = dict_get(pool, "targets")
            let targets = json_decode(targets_json)
            let n = len(targets)

            // Build targets_info list
            let targets_info = []
            let idx = 0
            while3 (idx < n) {
                let tgt = dict_get(targets, idx)
                let re = target_reynolds(tgt)
                let regime = flow_regime(re)
                let avail = is_target_available(tgt)
                let tinfo = {}
                let tinfo = dict_set(tinfo, "url", dict_get(tgt, "url"))
                let tinfo = dict_set(tinfo, "weight", dict_get(tgt, "weight"))
                let tinfo = dict_set(tinfo, "active_connections", dict_get(tgt, "active_connections"))
                let tinfo = dict_set(tinfo, "total_requests", dict_get(tgt, "total_requests"))
                let tinfo = dict_set(tinfo, "total_successes", dict_get(tgt, "total_successes"))
                let tinfo = dict_set(tinfo, "total_failures", dict_get(tgt, "total_failures"))
                let tinfo = dict_set(tinfo, "avg_latency_ms", round(dict_get(tgt, "avg_latency_ms"), 2))
                let tinfo = dict_set(tinfo, "consecutive_failures", dict_get(tgt, "consecutive_failures"))
                let tinfo = dict_set(tinfo, "circuit_open", dict_get(tgt, "circuit_open"))
                let tinfo = dict_set(tinfo, "reynolds", re)
                let tinfo = dict_set(tinfo, "flow_regime", regime)
                let tinfo = dict_set(tinfo, "available", avail)
                let targets_info = append(targets_info, tinfo)
                let idx = idx + 1
            }

            let resp = {}
            let resp = dict_set(resp, "ok", 1)
            let resp = dict_set(resp, "trit", T_TRUE)
            let resp = dict_set(resp, "pool", pool_name)
            let resp = dict_set(resp, "strategy", dict_get(pool, "strategy"))
            let resp = dict_set(resp, "total_routed", dict_get(pool, "total_routed"))
            let resp = dict_set(resp, "target_count", n)
            let resp = dict_set(resp, "targets", targets_info)
            let resp = dict_set(resp, "created_at", dict_get(pool, "created_at"))
            let resp = dict_set(resp, "updated_at", dict_get(pool, "updated_at"))
            resp
        } () {
            let resp = {}
            let resp = dict_set(resp, "ok", 0)
            let resp = dict_set(resp, "trit", T_FALSE)
            let resp = dict_set(resp, "error", "pool existence check failed")
            resp
        }
    } () {
        let resp = {}
        let resp = dict_set(resp, "ok", 0)
        let resp = dict_set(resp, "trit", T_FALSE)
        let resp = dict_set(resp, "error", "pool name required")
        return resp
    }
}

// ============================================================================
// Route handler: GET /tbalance/pools
// ============================================================================
fn handle_pools(req) {
    let pool_names = keys(_pools)
    let pool_count = len(pool_names)
    let pools_info = []
    let pidx = 0
    while3 (pidx < pool_count) {
        let pname = dict_get(pool_names, pidx)
        let pool = dict_get(_pools, pname)
        let targets_json = dict_get(pool, "targets")
        let targets = json_decode(targets_json)
        let total = len(targets)
        let available = count_available(targets)
        let open_count = total - available
        let pinfo = {}
        let pinfo = dict_set(pinfo, "name", pname)
        let pinfo = dict_set(pinfo, "strategy", dict_get(pool, "strategy"))
        let pinfo = dict_set(pinfo, "target_count", total)
        let pinfo = dict_set(pinfo, "available_targets", available)
        let pinfo = dict_set(pinfo, "circuit_open_targets", open_count)
        let pinfo = dict_set(pinfo, "total_routed", dict_get(pool, "total_routed"))
        let pools_info = append(pools_info, pinfo)
        let pidx = pidx + 1
    }
    let resp = {}
    let resp = dict_set(resp, "ok", 1)
    let resp = dict_set(resp, "trit", T_TRUE)
    let resp = dict_set(resp, "pool_count", pool_count)
    let resp = dict_set(resp, "max_pools", MAX_POOLS)
    let resp = dict_set(resp, "pools", pools_info)
    return resp
}

// ============================================================================
// Route handler: POST /tbalance/report
// Body: {"pool": "...", "target": "...", "latency_ms": N, "success": 1|0}
// ============================================================================
fn handle_report(req) {
    let body = dict_get(req, "body")
    let pool_name = str(dict_get(body, "pool"))
    let target_url = str(dict_get(body, "target"))
    let latency_ms = float(dict_get(body, "latency_ms"))
    let success = int(dict_get(body, "success"))

    if3 (len(pool_name) == 0) {
        let resp = {}
        let resp = dict_set(resp, "ok", 0)
        let resp = dict_set(resp, "trit", T_FALSE)
        let resp = dict_set(resp, "error", "pool name required")
        resp
    } () {
        if3 (len(target_url) == 0) {
            let resp = {}
            let resp = dict_set(resp, "ok", 0)
            let resp = dict_set(resp, "trit", T_FALSE)
            let resp = dict_set(resp, "error", "target URL required")
            resp
        } () {
            if3 (dict_has(_pools, pool_name) == 0) {
                let resp = {}
                let resp = dict_set(resp, "ok", 0)
                let resp = dict_set(resp, "trit", T_FALSE)
                let resp = dict_set(resp, "error", "pool not found")
                resp
            } () {
                let pool = dict_get(_pools, pool_name)
                let targets_json = dict_get(pool, "targets")
                let targets = json_decode(targets_json)
                let tidx = find_target_idx(targets, target_url)

                if3 (tidx < 0) {
                    let resp = {}
                    let resp = dict_set(resp, "ok", 0)
                    let resp = dict_set(resp, "trit", T_FALSE)
                    let resp = dict_set(resp, "error", "target not found in pool")
                    resp
                } () {
                    let target = dict_get(targets, tidx)

                    // Decrement active connections
                    let conns = dict_get(target, "active_connections")
                    if3 (conns > 0) {
                        let target = dict_set(target, "active_connections", conns - 1)
                    } () {
                        let target = target
                    } () {
                        let target = target
                    }

                    // Update latency tracking
                    if3 (latency_ms > 0.0) {
                        let lsum = dict_get(target, "latency_sum")
                        let lcount = dict_get(target, "latency_count")
                        let lsum = lsum + latency_ms
                        let lcount = lcount + 1
                        let avg = lsum / lcount
                        let target = dict_set(target, "latency_sum", lsum)
                        let target = dict_set(target, "latency_count", lcount)
                        let target = dict_set(target, "avg_latency_ms", avg)
                    } () {
                        let target = target
                    } () {
                        let target = target
                    }

                    // Increment global reports
                    let reps = dict_get(_global_stats, "total_reports")
                    let _global_stats = dict_set(_global_stats, "total_reports", reps + 1)

                    // Handle success vs failure
                    if3 (success == 1) {
                        let target = dict_set(target, "total_successes", dict_get(target, "total_successes") + 1)
                        // Close circuit if it was open (probe succeeded)
                        let was_open = dict_get(target, "circuit_open")
                        if3 (was_open == 1) {
                            let target = close_circuit(target)
                        } () {
                            let target = dict_set(target, "consecutive_failures", 0)
                        } () {
                            let target = target
                        }
                        // Persist
                        let new_targets_json = update_target_at(targets_json, tidx, target)
                        let pool = dict_set(pool, "targets", new_targets_json)
                        let _pools = dict_set(_pools, pool_name, pool)
                        let avg_lat = round(dict_get(target, "avg_latency_ms"), 2)
                        let resp = {}
                        let resp = dict_set(resp, "ok", 1)
                        let resp = dict_set(resp, "trit", T_TRUE)
                        let resp = dict_set(resp, "pool", pool_name)
                        let resp = dict_set(resp, "target", target_url)
                        let resp = dict_set(resp, "circuit_state", "CLOSED")
                        let resp = dict_set(resp, "avg_latency_ms", avg_lat)
                        resp
                    } () {
                        let target = dict_set(target, "total_failures", dict_get(target, "total_failures") + 1)
                        let consec = dict_get(target, "consecutive_failures") + 1
                        let target = dict_set(target, "consecutive_failures", consec)
                        let circuit_state = "CLOSED"
                        let trit_val = T_MAYBE
                        if3 (consec >= CIRCUIT_FAILURES) {
                            let target = open_circuit(target)
                            let circuit_state = "OPEN"
                            let trit_val = T_FALSE
                        } () {
                            let circuit_state = "CLOSED"
                            let trit_val = T_MAYBE
                        } () {
                            let circuit_state = "CLOSED"
                            let trit_val = T_MAYBE
                        }
                        // Persist
                        let new_targets_json = update_target_at(targets_json, tidx, target)
                        let pool = dict_set(pool, "targets", new_targets_json)
                        let _pools = dict_set(_pools, pool_name, pool)
                        let resp = {}
                        let resp = dict_set(resp, "ok", 1)
                        let resp = dict_set(resp, "trit", trit_val)
                        let resp = dict_set(resp, "pool", pool_name)
                        let resp = dict_set(resp, "target", target_url)
                        let resp = dict_set(resp, "circuit_state", circuit_state)
                        let resp = dict_set(resp, "consecutive_failures", consec)
                        let resp = dict_set(resp, "threshold", CIRCUIT_FAILURES)
                        let resp = dict_set(resp, "cooldown_s", CIRCUIT_COOLDOWN)
                        resp
                    } () {
                        let resp = {}
                        let resp = dict_set(resp, "ok", 0)
                        let resp = dict_set(resp, "trit", T_FALSE)
                        let resp = dict_set(resp, "error", "success flag must be 1 or 0")
                        resp
                    }
                } () {
                    let resp = {}
                    let resp = dict_set(resp, "ok", 0)
                    let resp = dict_set(resp, "trit", T_FALSE)
                    let resp = dict_set(resp, "error", "target index check failed")
                    resp
                }
            } () {
                let resp = {}
                let resp = dict_set(resp, "ok", 0)
                let resp = dict_set(resp, "trit", T_FALSE)
                let resp = dict_set(resp, "error", "pool not found")
                resp
            }
        } () {
            let resp = {}
            let resp = dict_set(resp, "ok", 0)
            let resp = dict_set(resp, "trit", T_FALSE)
            let resp = dict_set(resp, "error", "target URL required")
            resp
        }
    } () {
        let resp = {}
        let resp = dict_set(resp, "ok", 0)
        let resp = dict_set(resp, "trit", T_FALSE)
        let resp = dict_set(resp, "error", "pool name required")
        return resp
    }
}

// ============================================================================
// Route handler: GET /tbalance/stats
// ============================================================================
fn handle_stats(req) {
    let pool_names = keys(_pools)
    let pool_count = len(pool_names)
    let per_pool = {}
    let hot_targets = []
    let pidx = 0

    while3 (pidx < pool_count) {
        let pname = dict_get(pool_names, pidx)
        let pool = dict_get(_pools, pname)
        let targets_json = dict_get(pool, "targets")
        let targets = json_decode(targets_json)
        let n = len(targets)

        let pool_active = 0
        let pool_total = 0
        let pool_failures = 0
        let tidx = 0

        while3 (tidx < n) {
            let tgt = dict_get(targets, tidx)
            let re = target_reynolds(tgt)
            let tconns = dict_get(tgt, "active_connections")
            let treqs = dict_get(tgt, "total_requests")
            let tfails = dict_get(tgt, "total_failures")
            let pool_active = pool_active + tconns
            let pool_total = pool_total + treqs
            let pool_failures = pool_failures + tfails

            // Hot target: Reynolds >= RE_TRN(125) or active_conns >= H7(7)
            if3 (re >= RE_TRN) {
                let hinfo = {}
                let hinfo = dict_set(hinfo, "pool", pname)
                let hinfo = dict_set(hinfo, "url", dict_get(tgt, "url"))
                let hinfo = dict_set(hinfo, "reynolds", re)
                let hinfo = dict_set(hinfo, "flow_regime", flow_regime(re))
                let hinfo = dict_set(hinfo, "active_connections", tconns)
                let hinfo = dict_set(hinfo, "circuit_open", dict_get(tgt, "circuit_open"))
                let hot_targets = append(hot_targets, hinfo)
            } (tconns >= H7) {
                let hinfo = {}
                let hinfo = dict_set(hinfo, "pool", pname)
                let hinfo = dict_set(hinfo, "url", dict_get(tgt, "url"))
                let hinfo = dict_set(hinfo, "reynolds", re)
                let hinfo = dict_set(hinfo, "flow_regime", flow_regime(re))
                let hinfo = dict_set(hinfo, "active_connections", tconns)
                let hinfo = dict_set(hinfo, "circuit_open", dict_get(tgt, "circuit_open"))
                let hot_targets = append(hot_targets, hinfo)
            } () {
                let hot_targets = hot_targets
            }
            let tidx = tidx + 1
        }

        let pstats = {}
        let pstats = dict_set(pstats, "strategy", dict_get(pool, "strategy"))
        let pstats = dict_set(pstats, "targets", n)
        let pstats = dict_set(pstats, "active_connections", pool_active)
        let pstats = dict_set(pstats, "total_requests", pool_total)
        let pstats = dict_set(pstats, "total_failures", pool_failures)
        let pstats = dict_set(pstats, "total_routed", dict_get(pool, "total_routed"))
        let per_pool = dict_set(per_pool, pname, pstats)
        let pidx = pidx + 1
    }

    let total_routed = dict_get(_global_stats, "total_routed")
    let total_reports = dict_get(_global_stats, "total_reports")
    let total_opens = dict_get(_global_stats, "total_circuit_opens")

    // Limit hot_targets to top H13 (13) entries
    let ht_count = len(hot_targets)
    let ht_limit = H13
    if3 (ht_count > ht_limit) {
        let hot_targets = slice(hot_targets, 0, ht_limit)
    } () {
        let hot_targets = hot_targets
    } () {
        let hot_targets = hot_targets
    }

    let resp = {}
    let resp = dict_set(resp, "ok", 1)
    let resp = dict_set(resp, "trit", T_TRUE)
    let resp = dict_set(resp, "total_routed", total_routed)
    let resp = dict_set(resp, "total_reports", total_reports)
    let resp = dict_set(resp, "total_circuit_opens", total_opens)
    let resp = dict_set(resp, "pool_count", pool_count)
    let resp = dict_set(resp, "per_pool", per_pool)
    let resp = dict_set(resp, "hot_targets", hot_targets)
    return resp
}

// ============================================================================
// Default pool initialization
// ============================================================================
fn init_default_pools() {
    // -- ollama-models: base Ollama endpoints (least_conn) --
    let t_ol_gen = new_target("http://127.0.0.1:11434/api/generate", 1)
    let t_ol_chat = new_target("http://127.0.0.1:11434/api/chat", 1)
    let t_ol_emb = new_target("http://127.0.0.1:11434/api/embeddings", 1)
    let ollama_targets = []
    let ollama_targets = append(ollama_targets, t_ol_gen)
    let ollama_targets = append(ollama_targets, t_ol_chat)
    let ollama_targets = append(ollama_targets, t_ol_emb)
    let pool_ollama = new_pool("ollama-models", json_encode(ollama_targets), "least_conn")
    let _pools = dict_set(_pools, "ollama-models", pool_ollama)

    // -- cloud-providers: cloud-router + hivemind + novacore (weighted) --
    let t_cloud = new_target("http://127.0.0.1:9878/cloud/query", 3)
    let t_hive = new_target("http://127.0.0.1:9881/hive/query", 2)
    let t_core = new_target("http://127.0.0.1:9890/health", 1)
    let cloud_targets = []
    let cloud_targets = append(cloud_targets, t_cloud)
    let cloud_targets = append(cloud_targets, t_hive)
    let cloud_targets = append(cloud_targets, t_core)
    let pool_cloud = new_pool("cloud-providers", json_encode(cloud_targets), "weighted")
    let _pools = dict_set(_pools, "cloud-providers", pool_cloud)

    // -- storage: deepstorage + vault + tbuffer (reynolds) --
    let t_deep = new_target("http://127.0.0.1:9883/health", 2)
    let t_vault = new_target("http://127.0.0.1:9884/health", 1)
    let t_tbuf = new_target("http://127.0.0.1:9886/tbuffer/query", 2)
    let storage_targets = []
    let storage_targets = append(storage_targets, t_deep)
    let storage_targets = append(storage_targets, t_vault)
    let storage_targets = append(storage_targets, t_tbuf)
    let pool_storage = new_pool("storage", json_encode(storage_targets), "reynolds")
    let _pools = dict_set(_pools, "storage", pool_storage)

    1
}

// ============================================================================
// Register routes
// ============================================================================
troute(server, "GET",  "/health",               handle_health_simple)
troute(server, "GET",  "/tbalance/health",       handle_tbalance_health)
troute(server, "POST", "/tbalance/route",        handle_route)
troute(server, "POST", "/tbalance/pool/create",  handle_pool_create)
troute(server, "POST", "/tbalance/pool/update",  handle_pool_update)
troute(server, "GET",  "/tbalance/pool/get",     handle_pool_get)
troute(server, "GET",  "/tbalance/pools",        handle_pools)
troute(server, "POST", "/tbalance/report",       handle_report)
troute(server, "GET",  "/tbalance/stats",        handle_stats)

// ============================================================================
// Initialize default pools
// ============================================================================
let _init = init_default_pools()

// ============================================================================
// Startup banner
// ============================================================================
print("[TBalance] Initializing default pools...")
print("[TBalance]   pool 'ollama-models': 3 targets, strategy=least_conn")
print("[TBalance]   pool 'cloud-providers': 3 targets, strategy=weighted")
print("[TBalance]   pool 'storage': 3 targets, strategy=reynolds")
print("[TLight] nova-tbalance v1.0.0 on 127.0.0.1:9984 | ternary=true | harmonics=3-5-7-13")
print("[TBalance] Routes: GET /health /tbalance/health /tbalance/pool/get /tbalance/pools /tbalance/stats")
print("[TBalance] Routes: POST /tbalance/route /tbalance/pool/create /tbalance/pool/update /tbalance/report")
print("[TBalance] MAX_POOLS=39 MAX_TARGETS_PER_POOL=91 CIRCUIT_FAILURES=3 CIRCUIT_COOLDOWN=13s")
print("[TBalance] T_TRUE=1 T_MAYBE=0 T_FALSE=-1 | H3=3 H5=5 H7=7 H13=13 BLOCK=2187")

// ============================================================================
// Start server
// ============================================================================
tstart(server)
