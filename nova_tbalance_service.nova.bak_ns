                                let _pools = dict_set(_pools, name, pool)
                                let resp = {}
                                let resp = dict_set(resp, "ok", 1)
                                let resp = dict_set(resp, "trit", T_TRUE)
                                let resp = dict_set(resp, "action", "created")
                                let resp = dict_set(resp, "pool", name)
                                let resp = dict_set(resp, "strategy", strategy)
                                let resp = dict_set(resp, "target_count", final_count)
                                resp
                            } () {
                                let resp = {}
                                let resp = dict_set(resp, "ok", 0)
                                let resp = dict_set(resp, "trit", T_FALSE)
                                let resp = dict_set(resp, "error", "no valid targets provided")
                                resp
                            }
                        } () {
                            let resp = {}
                            let resp = dict_set(resp, "ok", 0)
                            let resp = dict_set(resp, "trit", T_FALSE)
                            let resp = dict_set(resp, "error", "max pools reached")
                            resp
                        }
                    } () {
                        // Pool already exists: update it
                        let targets = []
                        let idx = 0
                        while3 (idx < rt_len) {
                            let rt = dict_get(raw_targets, idx)
                            let url = str(dict_get(rt, "url"))
                            let weight = int(dict_get(rt, "weight"))
                            if3 (len(url) > 0) {
                                let nt = new_target(url, weight)
                                let targets = append(targets, nt)
                            } () {
                                let targets = targets
                            } () {
                                let targets = targets
                            }
