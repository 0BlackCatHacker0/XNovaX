                        }
                        let final_count = len(targets)
                        if3 (final_count == 0) {
                            let resp = {}
                            let resp = dict_set(resp, "ok", 0)
                            let resp = dict_set(resp, "trit", T_FALSE)
                            let resp = dict_set(resp, "error", "no valid targets provided")
                            resp
                        } () {
                            let pool = new_pool(name, json_encode(targets), strategy)
                            let _pools = dict_set(_pools, name, pool)
                            let resp = {}
                            let resp = dict_set(resp, "ok", 1)
                            let resp = dict_set(resp, "trit", T_TRUE)
                            let resp = dict_set(resp, "action", "updated")
                            let resp = dict_set(resp, "pool", name)
                            let resp = dict_set(resp, "strategy", strategy)
                            let resp = dict_set(resp, "target_count", final_count)
                            resp
                        } () {
                            let resp = {}
                            let resp = dict_set(resp, "ok", 0)
                            let resp = dict_set(resp, "trit", T_FALSE)
                            let resp = dict_set(resp, "error", "no valid targets provided")
                            resp
