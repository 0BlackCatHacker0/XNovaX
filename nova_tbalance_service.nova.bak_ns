// nova_tbalance_service.nova
// NovaX TBalance -- Ternary Load Balancer
// Port 9984
//
// Distributes requests across service instances and model pools.
// Weighted round-robin, least-connections, and Reynolds-aware routing.
// Prevents any single target from being overwhelmed.
//
// Strategies:
//   weighted   -- round-robin with per-target weights
//   least_conn -- route to target with fewest active connections
//   reynolds   -- route to target with lowest Reynolds number (prefer laminar)
//
// Endpoints:
//   GET  /health               -- standard tlight health
//   GET  /tbalance/health      -- alias with extended pool stats
//   POST /tbalance/route       -- pick best target from a pool
//   POST /tbalance/pool/create -- create a new pool with targets
//   POST /tbalance/pool/update -- update targets in an existing pool
//   GET  /tbalance/pool/get    -- pool status (pass pool name in body)
//   GET  /tbalance/pools       -- list all pools
//   POST /tbalance/report      -- feedback (latency, success) for adaptive routing
//   GET  /tbalance/stats       -- total routed, per-pool stats, hot targets
//
// 3-5-7-13 Harmonic Constants:
//   H3=3 ternary base, H5=5 TZip pack, H7=7 composition, H13=13 carrier frame
//   MAX_POOLS        = H13 * H3 = 39
//   MAX_TARGETS      = H13 * H7 = 91
//   CIRCUIT_FAILURES = H3       =  3 consecutive failures -> open breaker
//   CIRCUIT_COOLDOWN = H13      = 13 seconds before retry

// ============================================================================
// Server bootstrap
// ============================================================================
let PORT = 9984
let server = tserve(PORT, "nova-tbalance")

// ============================================================================
// Constants
// ============================================================================
let VERSION = "1.0.0"
let SERVICE_NAME = "nova-tbalance"

// Harmonic constants
let H3 = 3
let H5 = 5
let H7 = 7
let H13 = 13
let BLOCK = 2187

// Derived limits
let MAX_POOLS = 39
let MAX_TARGETS_PER_POOL = 91
let CIRCUIT_FAILURES = 3
let CIRCUIT_COOLDOWN = 13
let MAX_BODY = 6561
let STATS_WINDOW = 3600

// Reynolds regime boundaries (3^3=27, 5^3=125, 7^3=343)
let RE_LAM = 27
let RE_TRN = 125
let RE_TUR = 343

// Ternary truth values
let T_TRUE = 1
let T_MAYBE = 0
let T_FALSE = -1

// Valid strategy names
let STRATEGY_WEIGHTED = "weighted"
let STRATEGY_LEAST_CONN = "least_conn"
let STRATEGY_REYNOLDS = "reynolds"

// ============================================================================
// Global state
// ============================================================================

// _pools is a dict: pool_name -> pool_dict encoded as json string
// We store pools as a flat dict-of-dicts pattern using json_encode/decode
// Each pool entry key: pool name, value: json-encoded pool object
let _pools = {}

// Global counters stored as a dict
let _global_stats = {}
let _global_stats = dict_set(_global_stats, "total_routed", 0)
let _global_stats = dict_set(_global_stats, "total_reports", 0)
let _global_stats = dict_set(_global_stats, "total_circuit_opens", 0)

// ============================================================================
// Helper: clamp integer between lo and hi
// ============================================================================
fn clamp_int(val, lo, hi) {
    let v = int(val)
    let result = v
    if3 (v < lo) {
        let result = lo
    } (v > hi) {
        let result = hi
    } () {
        let result = v
    }
    result
}

// ============================================================================
// Helper: compute Reynolds number for a target
// A target dict has key "ops_times" storing a json-encoded list of timestamps
// We count how many timestamps are within the last 60 seconds
// ============================================================================
fn target_reynolds(target) {
    let now = time()
    let ops_json = dict_get(target, "ops_times")
    let ops = json_decode(ops_json)
    let count = 0
    let idx = 0
    let n = len(ops)
    while3 (idx < n) {
        let t = dict_get(ops, idx)
        let age = now - t
        if3 (age < 60) {
            let count = count + 1
        } () {
            let count = count
        } () {
            let count = count
        }
        let idx = idx + 1
    }
    count
}

// ============================================================================
// Helper: determine flow regime string from Reynolds number
// ============================================================================
fn flow_regime(re) {
    let regime = "turbulent"
    if3 (re < RE_LAM) {
        let regime = "laminar"
    } (re < RE_TRN) {
        let regime = "transitional"
    } () {
        let regime = "turbulent"
    }
    regime
}

// ============================================================================
// Helper: check if a target is available
// circuit_open=0 means closed, circuit_open=1 means open
// cooldown expires after CIRCUIT_COOLDOWN seconds -> allow probe
// ============================================================================
fn is_target_available(target) {
    let circuit_open = dict_get(target, "circuit_open")
    let available = T_FALSE
    if3 (circuit_open == 0) {
        let available = T_TRUE
    } () {
        let opened_at = dict_get(target, "circuit_opened_at")
        let elapsed = time() - opened_at
        if3 (elapsed >= CIRCUIT_COOLDOWN) {
            let available = T_TRUE
        } () {
            let available = T_FALSE
        } () {
            let available = T_FALSE
        }
    } () {
        let available = T_FALSE
    }
    available
}

// ============================================================================
// Helper: build a fresh target dict
// weight clamped to 1..100
// ops_times is a json-encoded empty list
// ============================================================================
fn new_target(url, weight) {
    let w = clamp_int(weight, 1, 100)
    let t = {}
    let t = dict_set(t, "url", url)
    let t = dict_set(t, "weight", w)
    let t = dict_set(t, "active_connections", 0)
    let t = dict_set(t, "total_requests", 0)
    let t = dict_set(t, "total_successes", 0)
    let t = dict_set(t, "total_failures", 0)
    let t = dict_set(t, "consecutive_failures", 0)
    let t = dict_set(t, "avg_latency_ms", 0.0)
    let t = dict_set(t, "latency_sum", 0.0)
    let t = dict_set(t, "latency_count", 0)
    let t = dict_set(t, "circuit_open", 0)
    let t = dict_set(t, "circuit_opened_at", 0.0)
    let t = dict_set(t, "ops_times", json_encode([]))
    let t = dict_set(t, "created_at", time())
    t
}

// ============================================================================
// Helper: build a fresh pool dict
// targets_json is a json-encoded list of target dicts
// ============================================================================
fn new_pool(name, targets_json, strategy) {
    let p = {}
    let p = dict_set(p, "name", name)
    let p = dict_set(p, "strategy", strategy)
    let p = dict_set(p, "targets", targets_json)
    let p = dict_set(p, "rr_counter", 0)
    let p = dict_set(p, "total_routed", 0)
    let p = dict_set(p, "created_at", time())
    let p = dict_set(p, "updated_at", time())
    p
}

// ============================================================================
// Helper: open circuit breaker on a target dict, return modified target
// Also increments global circuit opens counter
// ============================================================================
fn open_circuit(target) {
    let t = dict_set(target, "circuit_open", 1)
    let t = dict_set(t, "circuit_opened_at", time())
    let opens = dict_get(_global_stats, "total_circuit_opens")
    let _global_stats = dict_set(_global_stats, "total_circuit_opens", opens + 1)
    t
}

// ============================================================================
// Helper: close circuit breaker on a target dict, return modified target
// ============================================================================
fn close_circuit(target) {
    let t = dict_set(target, "circuit_open", 0)
    let t = dict_set(t, "consecutive_failures", 0)
    t
}

// ============================================================================
// Strategy: weighted round-robin
// Returns selected target dict or an error marker dict
// Uses pool rr_counter mod total_weight to pick target
// ============================================================================
fn select_weighted(pool) {
    let targets_json = dict_get(pool, "targets")
    let targets = json_decode(targets_json)
    let n = len(targets)

    // Collect available targets and compute total weight
    let available = []
    let total_weight = 0
    let idx = 0
    while3 (idx < n) {
        let tgt = dict_get(targets, idx)
        let avail = is_target_available(tgt)
        if3 (avail == T_TRUE) {
            let available = append(available, tgt)
            let w = dict_get(tgt, "weight")
            let total_weight = total_weight + w
        } () {
            let total_weight = total_weight
        } () {
            let total_weight = total_weight
        }
        let idx = idx + 1
    }

    let na = len(available)
    // No available targets
    if3 (na == 0) {
        let none_marker = {}
        let none_marker = dict_set(none_marker, "_none", 1)
        none_marker
    } () {
        // All weights zero: return first
        if3 (total_weight == 0) {
            dict_get(available, 0)
        } () {
            let rr = dict_get(pool, "rr_counter")
            let counter = rr - (total_weight * int(rr / total_weight))
            let selected = dict_get(available, 0)
            let cumulative = 0
            let aidx = 0
            let found = 0
            while3 (aidx < na) {
                if3 (found == 0) {
                    let tgt2 = dict_get(available, aidx)
                    let w2 = dict_get(tgt2, "weight")
                    let cumulative = cumulative + w2
                    if3 (counter < cumulative) {
                        let selected = tgt2
                        let found = 1
                    } () {
                        let found = found
                    } () {
                        let found = found
                    }
                } () {
                    let found = found
                } () {
                    let found = found
                }
                let aidx = aidx + 1
            }
            selected
        } () {
            dict_get(available, 0)
        }
    } () {
        let none_marker = {}
        let none_marker = dict_set(none_marker, "_none", 1)
        none_marker
    }
}

// ============================================================================
// Strategy: least connections
// Returns target with fewest active_connections; tie-break by avg_latency_ms
// ============================================================================
fn select_least_conn(pool) {
    let targets_json = dict_get(pool, "targets")
    let targets = json_decode(targets_json)
    let n = len(targets)
    let best = {}
    let best = dict_set(best, "_none", 1)
    let best_conns = 999999
    let best_latency = 999999.0
    let idx = 0
    while3 (idx < n) {
        let tgt = dict_get(targets, idx)
        let avail = is_target_available(tgt)
        if3 (avail == T_TRUE) {
            let conns = dict_get(tgt, "active_connections")
            let lat = dict_get(tgt, "avg_latency_ms")
            if3 (conns < best_conns) {
                let best = tgt
                let best_conns = conns
                let best_latency = lat
            } (conns == best_conns) {
                if3 (lat < best_latency) {
                    let best = tgt
                    let best_latency = lat
                } () {
                    let best = best
                } () {
                    let best = best
                }
            } () {
                let best = best
            }
        } () {
            let best = best
        } () {
            let best = best
        }
        let idx = idx + 1
    }
    best
}

// ============================================================================
// Strategy: Reynolds-aware routing
// Prefer target with lowest Reynolds number (laminar flow)
// Tie-break: fewest active connections, then lowest latency
// ============================================================================
fn select_reynolds(pool) {
    let targets_json = dict_get(pool, "targets")
    let targets = json_decode(targets_json)
    let n = len(targets)
    let best = {}
    let best = dict_set(best, "_none", 1)
    let best_re = 999999
    let best_conns = 999999
    let best_latency = 999999.0
    let idx = 0
    while3 (idx < n) {
        let tgt = dict_get(targets, idx)
        let avail = is_target_available(tgt)
        if3 (avail == T_TRUE) {
            let re = target_reynolds(tgt)
            let conns = dict_get(tgt, "active_connections")
            let lat = dict_get(tgt, "avg_latency_ms")
            if3 (re < best_re) {
                let best = tgt
                let best_re = re
                let best_conns = conns
                let best_latency = lat
            } (re == best_re) {
                if3 (conns < best_conns) {
                    let best = tgt
                    let best_conns = conns
                    let best_latency = lat
                } (conns == best_conns) {
                    if3 (lat < best_latency) {
                        let best = tgt
                        let best_latency = lat
                    } () {
                        let best = best
                    } () {
                        let best = best
                    }
                } () {
                    let best = best
                }
            } () {
                let best = best
            }
        } () {
            let best = best
        } () {
            let best = best
        }
        let idx = idx + 1
    }
    best
}

// ============================================================================
// Helper: apply strategy to pool, return best target dict
// ============================================================================
fn apply_strategy(pool) {
    let strategy = dict_get(pool, "strategy")
    let result = {}
    let result = dict_set(result, "_none", 1)
    if3 (strategy == STRATEGY_WEIGHTED) {
        let result = select_weighted(pool)
    } (strategy == STRATEGY_LEAST_CONN) {
        let result = select_least_conn(pool)
    } (strategy == STRATEGY_REYNOLDS) {
        let result = select_reynolds(pool)
    } () {
        // Default to weighted for unknown strategy
        let result = select_weighted(pool)
    }
    result
}

// ============================================================================
// Helper: is_valid_strategy
// ============================================================================
fn is_valid_strategy(s) {
    let valid = 0
    if3 (s == STRATEGY_WEIGHTED) {
        let valid = 1
    } (s == STRATEGY_LEAST_CONN) {
        let valid = 1
    } (s == STRATEGY_REYNOLDS) {
        let valid = 1
    } () {
        let valid = 0
    }
    valid
}

// ============================================================================
// Helper: count available targets in a targets list (json-decoded)
// ============================================================================
fn count_available(targets) {
    let n = len(targets)
    let count = 0
    let idx = 0
    while3 (idx < n) {
        let tgt = dict_get(targets, idx)
        let avail = is_target_available(tgt)
        if3 (avail == T_TRUE) {
            let count = count + 1
        } () {
            let count = count
        } () {
            let count = count
        }
        let idx = idx + 1
    }
    count
}

// ============================================================================
// Helper: find target index in list by url
// Returns -1 if not found
// ============================================================================
fn find_target_idx(targets, url) {
    let n = len(targets)
    let found_idx = -1
    let idx = 0
    while3 (idx < n) {
        let tgt = dict_get(targets, idx)
        let turl = dict_get(tgt, "url")
        if3 (turl == url) {
            let found_idx = idx
        } () {
            let found_idx = found_idx
        } () {
            let found_idx = found_idx
        }
        let idx = idx + 1
    }
    found_idx
}

// ============================================================================
// Helper: update a single target inside a targets list at a given index
// Returns updated json-encoded targets list
// ============================================================================
fn update_target_at(targets_json, idx, new_target) {
    let targets = json_decode(targets_json)
    let n = len(targets)
    let new_list = []
    let i = 0
    while3 (i < n) {
        if3 (i == idx) {
            let new_list = append(new_list, new_target)
        } () {
            let existing = dict_get(targets, i)
            let new_list = append(new_list, existing)
        } () {
            let existing = dict_get(targets, i)
            let new_list = append(new_list, existing)
        }
        let i = i + 1
    }
    json_encode(new_list)
}

// ============================================================================
// Helper: append ops_time to a target's ops_times list (bounded by STATS_WINDOW)
// We keep only the most recent STATS_WINDOW entries (1 hour = 3600 entries max)
// Returns updated target dict
// ============================================================================
fn target_append_op(target, ts) {
    let ops_json = dict_get(target, "ops_times")
    let ops = json_decode(ops_json)
    let ops = append(ops, ts)
    let n = len(ops)
    // Trim if over STATS_WINDOW
    if3 (n > STATS_WINDOW) {
        let ops = slice(ops, n - STATS_WINDOW, n)
    } () {
        let ops = ops
    } () {
        let ops = ops
    }
    dict_set(target, "ops_times", json_encode(ops))
}

// ============================================================================
// Route handler: GET /health  (simple health)
// ============================================================================
fn handle_health_simple(req) {
    let resp = {}
    let resp = dict_set(resp, "ok", 1)
    let resp = dict_set(resp, "trit", T_TRUE)
    let resp = dict_set(resp, "service", SERVICE_NAME)
    let resp = dict_set(resp, "port", PORT)
    let resp = dict_set(resp, "version", VERSION)
    return resp
}

// ============================================================================
// Route handler: GET /tbalance/health
// ============================================================================
fn handle_tbalance_health(req) {
    let pool_names = keys(_pools)
    let pool_count = len(pool_names)

    // Count all targets across all pools
    let total_targets = 0
    let pidx = 0
    while3 (pidx < pool_count) {
        let pname = dict_get(pool_names, pidx)
        let pool = dict_get(_pools, pname)
        let targets_json = dict_get(pool, "targets")
        let targets = json_decode(targets_json)
        let total_targets = total_targets + len(targets)
        let pidx = pidx + 1
    }

    let total_routed = dict_get(_global_stats, "total_routed")
    let total_opens = dict_get(_global_stats, "total_circuit_opens")

    let resp = {}
    let resp = dict_set(resp, "ok", 1)
    let resp = dict_set(resp, "trit", T_TRUE)
    let resp = dict_set(resp, "service", SERVICE_NAME)
    let resp = dict_set(resp, "port", PORT)
    let resp = dict_set(resp, "version", VERSION)
    let resp = dict_set(resp, "ternary", 1)
    let resp = dict_set(resp, "pools", pool_count)
    let resp = dict_set(resp, "targets", total_targets)
    let resp = dict_set(resp, "total_routed", total_routed)
    let resp = dict_set(resp, "circuit_opens", total_opens)
    let resp = dict_set(resp, "max_pools", MAX_POOLS)
    let resp = dict_set(resp, "max_targets_per_pool", MAX_TARGETS_PER_POOL)
    let resp = dict_set(resp, "harmonics_h3", H3)
    let resp = dict_set(resp, "harmonics_h5", H5)
    let resp = dict_set(resp, "harmonics_h7", H7)
    let resp = dict_set(resp, "harmonics_h13", H13)
    return resp
}

// ============================================================================
// Route handler: POST /tbalance/route
// Body: {"pool": "name", "request": {...}}
// ============================================================================
fn handle_route(req) {
    let body = dict_get(req, "body")
    let pool_name = dict_get(body, "pool")
    let pn = str(pool_name)

    // Validate pool name
    if3 (len(pn) == 0) {
        let resp = {}
        let resp = dict_set(resp, "ok", 0)
        let resp = dict_set(resp, "trit", T_FALSE)
        let resp = dict_set(resp, "error", "pool name required")
        resp
    } () {
        if3 (dict_has(_pools, pn) == 0) {
            let resp = {}
            let resp = dict_set(resp, "ok", 0)
            let resp = dict_set(resp, "trit", T_FALSE)
            let resp = dict_set(resp, "error", "pool not found")
            let resp = dict_set(resp, "pool", pn)
            resp
        } () {
            let pool = dict_get(_pools, pn)
            let strategy = dict_get(pool, "strategy")

            // Increment rr_counter before selection for weighted strategy
            let rr = dict_get(pool, "rr_counter")
            let pool = dict_set(pool, "rr_counter", rr + 1)

            let target = apply_strategy(pool)
            let is_none = dict_get(target, "_none")

            if3 (is_none == 1) {
                let tcount_json = dict_get(pool, "targets")
                let tcount_list = json_decode(tcount_json)
                let tcount = len(tcount_list)
                let resp = {}
                let resp = dict_set(resp, "ok", 0)
                let resp = dict_set(resp, "trit", T_FALSE)
                let resp = dict_set(resp, "error", "no available targets (all circuits open)")
                let resp = dict_set(resp, "pool", pn)
                let resp = dict_set(resp, "strategy", strategy)
                let resp = dict_set(resp, "target_count", tcount)
                resp
            } () {
                // Update target state: increment active_connections, total_requests, ops_times
                let conns = dict_get(target, "active_connections")
                let treqs = dict_get(target, "total_requests")
                let target = dict_set(target, "active_connections", conns + 1)
                let target = dict_set(target, "total_requests", treqs + 1)
                let target = target_append_op(target, time())

                // Update pool targets list with modified target
                let targets_json = dict_get(pool, "targets")
                let targets = json_decode(targets_json)
                let turl = dict_get(target, "url")
                let tidx = find_target_idx(targets, turl)
                let new_targets_json = update_target_at(targets_json, tidx, target)
                let pool = dict_set(pool, "targets", new_targets_json)

                // Increment pool and global routed counters
                let prouted = dict_get(pool, "total_routed")
                let pool = dict_set(pool, "total_routed", prouted + 1)
                let grouted = dict_get(_global_stats, "total_routed")
                let _global_stats = dict_set(_global_stats, "total_routed", grouted + 1)

                // Persist updated pool
                let _pools = dict_set(_pools, pn, pool)

                // Compute Reynolds and regime for response
                let re = target_reynolds(target)
                let regime = flow_regime(re)

                // Determine if this is a probe call (circuit was open)
                let circuit_open = dict_get(target, "circuit_open")
                let trit_val = T_TRUE
                if3 (circuit_open == 1) {
                    let trit_val = T_MAYBE
                } () {
                    let trit_val = T_TRUE
                } () {
                    let trit_val = T_TRUE
                }

                let tweight = dict_get(target, "weight")
                let tconns = dict_get(target, "active_connections")
                let pool_tr = dict_get(pool, "total_routed")

                let resp = {}
                let resp = dict_set(resp, "ok", 1)
                let resp = dict_set(resp, "trit", trit_val)
                let resp = dict_set(resp, "pool", pn)
                let resp = dict_set(resp, "strategy", strategy)
                let resp = dict_set(resp, "target_url", turl)
                let resp = dict_set(resp, "target_weight", tweight)
                let resp = dict_set(resp, "active_connections", tconns)
                let resp = dict_set(resp, "reynolds", re)
                let resp = dict_set(resp, "flow_regime", regime)
                let resp = dict_set(resp, "is_probe", circuit_open)
                let resp = dict_set(resp, "pool_total_routed", pool_tr)
                resp
            } () {
                let resp = {}
                let resp = dict_set(resp, "ok", 0)
                let resp = dict_set(resp, "trit", T_FALSE)
                let resp = dict_set(resp, "error", "strategy selection failed")
                resp
            }
        } () {
            let resp = {}
            let resp = dict_set(resp, "ok", 0)
            let resp = dict_set(resp, "trit", T_FALSE)
            let resp = dict_set(resp, "error", "internal error checking pool")
            resp
        }
    } () {
        let resp = {}
        let resp = dict_set(resp, "ok", 0)
        let resp = dict_set(resp, "trit", T_FALSE)
        let resp = dict_set(resp, "error", "pool name required")
        return resp
    }
}

// ============================================================================
// Route handler: POST /tbalance/pool/create
// Body: {"name": "...", "targets": [...], "strategy": "..."}
// ============================================================================
fn handle_pool_create(req) {
    let body = dict_get(req, "body")
    let name = str(dict_get(body, "name"))
    let strategy = lower(str(dict_get(body, "strategy")))
    let raw_targets = dict_get(body, "targets")

    // Validate name
    if3 (len(name) == 0) {
        let resp = {}
        let resp = dict_set(resp, "ok", 0)
        let resp = dict_set(resp, "trit", T_FALSE)
        let resp = dict_set(resp, "error", "pool name required")
        resp
    } () {
        // Validate strategy
        if3 (is_valid_strategy(strategy) == 0) {
            let resp = {}
            let resp = dict_set(resp, "ok", 0)
            let resp = dict_set(resp, "trit", T_FALSE)
            let resp = dict_set(resp, "error", "invalid strategy")
            let resp = dict_set(resp, "valid_strategies", "weighted,least_conn,reynolds")
            resp
        } () {
            // Validate targets list present
            let rt_len = len(raw_targets)
            if3 (rt_len == 0) {
                let resp = {}
                let resp = dict_set(resp, "ok", 0)
                let resp = dict_set(resp, "trit", T_FALSE)
                let resp = dict_set(resp, "error", "targets list required (non-empty)")
                resp
            } () {
                // Validate max targets
                if3 (rt_len > MAX_TARGETS_PER_POOL) {
                    let resp = {}
                    let resp = dict_set(resp, "ok", 0)
                    let resp = dict_set(resp, "trit", T_FALSE)
                    let resp = dict_set(resp, "error", "too many targets")
                    let resp = dict_set(resp, "max", MAX_TARGETS_PER_POOL)
                    resp
                } () {
                    // Check pool limit for new pools
                    let already_exists = dict_has(_pools, name)
                    let pool_count = len(keys(_pools))
                    if3 (already_exists == 0) {
                        if3 (pool_count >= MAX_POOLS) {
                            let resp = {}
                            let resp = dict_set(resp, "ok", 0)
                            let resp = dict_set(resp, "trit", T_FALSE)
                            let resp = dict_set(resp, "error", "max pools reached")
                            let resp = dict_set(resp, "max", MAX_POOLS)
                            resp
