    dict_set(registry, "orchestrator",  {"port": 9999, "endpoints": ["/health", "/api/services/health"], "health_status": 0, "health_detail": "not checked yet", "last_check": 0, "registered_at": 0, "dynamic": false, "route_count": 0})
    dict_set(registry, "hivemind",      {"port": 9881, "endpoints": ["/health", "/hive/query", "/hive/status"],  "health_status": 0, "health_detail": "not checked yet", "last_check": 0, "registered_at": 0, "dynamic": false, "route_count": 0})
    dict_set(registry, "cloud-router",  {"port": 9878, "endpoints": ["/health", "/cloud/query"],                 "health_status": 0, "health_detail": "not checked yet", "last_check": 0, "registered_at": 0, "dynamic": false, "route_count": 0})
