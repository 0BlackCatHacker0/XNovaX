// Nova TRouter v1.0 - Ternary API Gateway/Router (NovaLang port)
// Port 9963: Smart API gateway that routes requests to the right NovaX service
//            based on intent classification. Clients no longer need to know
//            individual service ports; they ask TRouter and it proxies.
//
// Features:
//   - Intent-based routing (keyword classification -> best service)
//   - Explicit proxy mode (name a service + path, TRouter forwards)
//   - Dynamic service registration (services announce themselves)
//   - Service topology / dependency graph
//   - On-demand health sweep via POST /trouter/sweep (no background thread)
//   - Reynolds flow regime tracking per-service
//
// N-S Mapping:
//   request_flow    = velocity_field (requests flowing through the gateway)
//   alive_services  = laminar_particles (stable, reachable)
//   dead_services   = turbulent_particles (unreachable, chaotic)
//   Re < H3^3 (27)  = laminar  (healthy gateway, most services up)
//   Re > H7^3 (343) = turbulent (many dead services, degraded routing)
//
// 3-5-7-13 Harmonic Constants:
//   H3=3 ternary base  H5=5 TZip pack  H7=7 composition  H13=13 carrier
//   Health timeout     = H3 seconds
//   Sweep interval     = H13 seconds (informational, sweep is on-demand)
//   Proxy timeout      = H13*2 + H3 + 1 = 30 seconds
//   Max retries        = H3
//   Max services       = H13*H13 = 169

let PORT = 9963
let server = tserve(PORT, "TRouter v1.0 - Ternary API Gateway")

// -- 3-5-7-13 Harmonic Constants --
let H3  = 3
let H5  = 5
let H7  = 7
let H13 = 13

// -- Derived Constants --
let PROXY_TIMEOUT   = 30    // H13*2 + H3 + 1 = 30 seconds
let HEALTH_TIMEOUT  = 3     // H3: connection timeout for health checks
let SWEEP_INTERVAL  = 13    // H13: informational, sweep is on-demand here
let MAX_SERVICES    = 169   // H13*H13: maximum registered services
let MAX_PROXY_BODY  = 10935 // BLOCK*H5 = 2187*5
let RE_LAMINAR      = 27    // H3^3: stable gateway boundary
let RE_TURBULENT    = 343   // H7^3: critical turbulence boundary

// -- Ternary State Values --
let T_TRUE  =  1
let T_MAYBE =  0
let T_FALSE = -1

// -- Service Registry --
// Each entry: {port, endpoints, health_status, health_detail, last_check,
//              registered_at, dynamic, route_count}
// health_status: 1=ALIVE, 0=DEGRADED/UNKNOWN, -1=DEAD
let registry = {}

// -- Route Log (last 169 routes for analytics) --
let route_log = []
let route_log_max = 169

// -- Global Stats --
let total_routes    = 0
let total_proxies   = 0
let total_sweeps    = 0
let total_registers = 0

// -- Service Dependency Graph (static) --
let dep_hivemind    = ["cloud-router", "tbuffer", "tcache"]
let dep_cloudrouter = []
let dep_orchestrator = ["hivemind", "cloud-router", "twatch"]
let dep_novacore    = ["hivemind", "cloud-router"]
let dep_twatch      = []
let dep_tbus        = []
let dep_tresilience = ["twatch", "tbus"]
let dep_deepstorage = ["tzip"]
let dep_vault       = ["tzip"]
let dep_tsecurity   = ["tauth"]
let dep_tquery      = ["tcache"]
let dep_tlog        = []
let dep_tconfig     = []
let dep_tcache      = []
let dep_tscheduler  = ["tbus"]
let dep_tbuffer     = ["tcache"]
let dep_tnet        = []
let dep_trouter     = ["twatch"]

// ============================================================================
// Registry Initialisation
// ============================================================================

