// Nova TLight v2.0 - Lightweight Ternary Service (NovaLang)
// Port 9924: Lightweight health/status endpoint
//
// Routes:
//   GET  /health  -- Health check

// -- Shared Libraries (N-S Flow) --
import3("C:/NovaX/lib/nova_ns_core.nova")
import3("C:/NovaX/lib/nova_stdlib.nova")

let PORT = 9931
let SERVICE_NAME = "nova-tlight"
let VERSION = "2.0"
let _t0 = time()

let server = tserve(PORT, "Nova TLight")

fn handle_health(req) {
    let uptime = round(time() - _t0, 1)
    let self_trit = T_MAYBE
    if3 uptime > 10 { self_trit = T_TRUE
    }
    let resp = ns_health_dict(SERVICE_NAME, VERSION, PORT, {})
    resp = dict_set(resp, "self_trit", self_trit)
    resp = dict_set(resp, "char", trit_char(self_trit))
    resp = dict_set(resp, "uptime_s", uptime)
    return resp
}

// ── Routes ──
troute(server, "GET", "/health", "handle_health")

print("[TLight] NovaLang TLight v" + VERSION + " on port " + str(PORT))
tstart(server)