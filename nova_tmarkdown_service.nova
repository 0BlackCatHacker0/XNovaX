print("[TMarkdown] Routes: /health, /tmarkdown/service-status")
print("[TMarkdown]         /tmarkdown/render, /tmarkdown/toc, /tmarkdown/links")
print("[TMarkdown]         /tmarkdown/stats, /tmarkdown/convert")
print("[TMarkdown]         /tmarkdown/validate, /tmarkdown/extract")
