// NovaX TMarkdown Service v1.0 - Ternary Markdown Processing (NovaLang)
// Port 9920: Markdown operations through ternary-native micro-tools
//
// 7 ternary-native markdown tools on 3-5-7-13 harmonic constants:
//   1. /tmarkdown/render   -- Render markdown to HTML (text OR path)
//   2. /tmarkdown/toc      -- Extract table of contents / heading structure (text OR path)
//   3. /tmarkdown/links    -- Extract all links from markdown (text OR path)
//   4. /tmarkdown/stats    -- Word count, heading count, link count, code block count (text OR path)
//   5. /tmarkdown/convert  -- Convert markdown file to HTML file (input_path, output_path)
//   6. /tmarkdown/validate -- Check markdown for common issues (text OR path)
//   7. /tmarkdown/extract  -- Extract specific sections by heading (text OR path, heading)
//
// N-S Mapping:
//   document_flow     = velocity_field (markdown content being processed)
//   parse_complexity  = turbulent_energy (document structural complexity)
//   Reynolds(md)      = doc_ops * H5
//   RE_LAMINAR=27     = small doc (few headings, short text)
//   RE_TRANSITION=125 = medium doc (moderate structure)
//   RE_TURBULENT=343  = large doc (complex structure, many headings/links)
//
// Endpoints:
//   GET  /health                    -- Health check
//   GET  /tmarkdown/service-status  -- Full service status with stats
//   POST /tmarkdown/render          -- Render markdown to HTML
//   POST /tmarkdown/toc             -- Extract table of contents
//   POST /tmarkdown/links           -- Extract all links
//   POST /tmarkdown/stats           -- Document statistics
//   POST /tmarkdown/convert         -- Convert md file to HTML file
//   POST /tmarkdown/validate        -- Validate markdown
//   POST /tmarkdown/extract         -- Extract section by heading

// -- Shared Libraries (N-S Flow) --
import3("C:/NovaX/lib/nova_ns_core.nova")
import3("C:/NovaX/lib/nova_stdlib.nova")

let PORT = 9920
let server = tserve(PORT, "TMarkdown v1.0 - Ternary Markdown Processing")

// -- 3-5-7-13 Harmonic Constants --
let H3  = 3
let H5  = 5
let H7  = 7

// -- Ternary State Constants --
let T_TRUE  =  1
let T_MAYBE =  0
let T_FALSE = -1

// -- Reynolds flow boundaries (N-S) --
let BLOCK_SIZE     = 2187
let RE_LAMINAR     = 27
let RE_TRANSITION  = 125
let RE_TURBULENT   = 343

let TOOLS_COUNT    = 7
let VERSION        = "1.0.0"
let SERVICE_NAME   = "nova-tmarkdown"
let MD_TIMEOUT     = 13
let TMP_DIR        = "C:\\NovaX\\data"

// -- Global Stats --
let stat_ops         = 0
let stat_trit_true   = 0
let stat_trit_maybe  = 0
let stat_trit_false  = 0
let stat_t0          = time()

// by_tool counters (one per tool)
let by_tool_render   = 0
let by_tool_toc      = 0
let by_tool_links    = 0
let by_tool_stats    = 0
let by_tool_convert  = 0
let by_tool_validate = 0
let by_tool_extract  = 0

// -- N-S flow tracking --
let ns_total_chars_in  = 0
let ns_total_chars_out = 0
let ns_max_reynolds    = 0

// ===========================================================================
// HELPER: balanced ternary char from trit
// ===========================================================================
fn bt_one(t) {
    if3 t == T_TRUE {
        return "+"
    }
    if3 t == T_MAYBE {
        return "~"
    }
    return "T"
}

// ===========================================================================
// HELPER: 3-char balanced ternary from integer
// Maps small integers to a 3-trit balanced ternary string
// ===========================================================================
fn bt_three(n) {
    let result = ""
    let val = n
    let i = 0
    while3 i < 3 {
        let rem = val % 3
        if3 rem == 0 {
            result = "0" + result
        }
        if3 rem == 1 {
            result = "+" + result
            val = val - 1
        }
        if3 rem == 2 {
            result = "T" + result
            val = val + 1
        }
        val = val / 3
        i = i + 1
    }
    return result
}

// ===========================================================================
// HELPER: record a stat op
// ===========================================================================
fn record_op(tool_name, trit) {
    stat_ops = stat_ops + 1
    if3 trit == T_TRUE {
        stat_trit_true = stat_trit_true + 1
    }
    if3 trit == T_MAYBE {
        stat_trit_maybe = stat_trit_maybe + 1
    }
    if3 trit == T_FALSE {
        stat_trit_false = stat_trit_false + 1
    }
    if3 tool_name == "render" {
        by_tool_render = by_tool_render + 1
    }
    if3 tool_name == "toc" {
        by_tool_toc = by_tool_toc + 1
    }
    if3 tool_name == "links" {
        by_tool_links = by_tool_links + 1
    }
    if3 tool_name == "stats" {
        by_tool_stats = by_tool_stats + 1
    }
    if3 tool_name == "convert" {
        by_tool_convert = by_tool_convert + 1
    }
    if3 tool_name == "validate" {
        by_tool_validate = by_tool_validate + 1
    }
    if3 tool_name == "extract" {
        by_tool_extract = by_tool_extract + 1
    }
}

// ===========================================================================
// HELPER: flow regime from Reynolds number
// ===========================================================================
fn flow_regime(re_num) {
    if3 re_num < RE_LAMINAR {
        return "laminar"
    }
    if3 re_num < RE_TRANSITION {
        return "transitional"
    }
    if3 re_num < RE_TURBULENT {
        return "turbulent"
    }
    return "chaotic"
}

// ===========================================================================
// HELPER: compute Reynolds number from document metrics
// N-S: parse_complexity = turbulent_energy
// Reynolds = (char_count / BLOCK_SIZE) * H5
// ===========================================================================
fn compute_reynolds(char_count) {
    let re = (char_count / BLOCK_SIZE) * H5
    if3 re > 999 {
        re = 999
    }
    if3 re < 0 {
        re = 0
    }
    return re
}

// ===========================================================================
// HELPER: run a shell command with standard timeout
// Returns trimmed output string
// ===========================================================================
fn run_md(cmd) {
    let raw = nova_run(cmd, MD_TIMEOUT)
    let output = trim(str(raw))
    return output
}

// ===========================================================================
// HELPER: check if output indicates an error
// ===========================================================================
fn is_error(output) {
    let lc = lower(output)
    if3 contains(lc, "traceback") {
        return true
    }
    if3 contains(lc, "error:") {
        return true
    }
    if3 contains(lc, "exception") {
        return true
    }
    if3 contains(lc, "no such file") {
        return true
    }
    if3 contains(lc, "filenotfounderror") {
        return true
    }
    if3 contains(lc, "modulenotfounderror") {
        return true
    }
    if3 contains(lc, "permission denied") {
        return true
    }
    if3 contains(lc, "oserror") {
        return true
    }
    if3 contains(lc, "ioerror") {
        return true
    }
    if3 contains(lc, "syntaxerror") {
        return true
    }
    return false
}

// ===========================================================================
// HELPER: escape a file path for use inside python single-quoted strings
// Replace backslash with double backslash, then escape single quotes
// ===========================================================================
fn escape_for_py(s) {
    let escaped = replace(s, "\\", "\\\\")
    escaped = replace(escaped, "'", "\\'")
    return escaped
}

// ===========================================================================
// HELPER: generate a unique temp file path for markdown content
// ===========================================================================
fn tmp_md_path() {
    let ts = str(int(time() * 1000))
    let path = TMP_DIR + "\\tmp_md_" + ts + ".md"
    return path
}

// ===========================================================================
// HELPER: generate a unique temp file path for python output
// ===========================================================================
fn tmp_out_path() {
    let ts = str(int(time() * 1000))
    let path = TMP_DIR + "\\tmp_mdout_" + ts + ".txt"
    return path
}

// ===========================================================================
// HELPER: write text content to a temp file via python
// Returns the path on success, or "" on error
// ===========================================================================
fn write_temp_file(text, fpath) {
    // Use NovaLang's native nova_write — handles all escaping properly
    let result = nova_write(fpath, text)
    return fpath
}

// ===========================================================================
// HELPER: clean up a temp file
// ===========================================================================
fn cleanup_temp(fpath) {
    // Pure NovaLang: shell del (zero Python)
    let win_path = replace(fpath, "/", "\\")
    shell("del /q \"" + win_path + "\" 2>NUL")
}

// ===========================================================================
// HELPER: read file content size via python
// ===========================================================================
fn get_file_size(fpath) {
    // Pure NovaLang: shell for (zero Python)
    let win_path = replace(fpath, "/", "\\")
    let r = shell("for %I in (\"" + win_path + "\") do @echo %~zI")
    let sz = try3 { to_int(trim(dict_get(r, "stdout"))) } { 0 }
    return sz
}

// ===========================================================================
// HELPER: resolve markdown source -- returns path to file to process
// If body has 'path', validates and returns it
// If body has 'text', writes to temp file and returns temp path
// Returns a dict with: path, is_temp, error
// ===========================================================================
fn resolve_md_source(body) {
    let result = {}
    let path_val = dict_get(body, "path") ?? ""
    let text_val = dict_get(body, "text") ?? ""

    // Check path first (file-based input takes priority)
    if3 len(path_val) > 0 {
        // Validate file exists
        // Pure NovaLang: shell if exist (zero Python)
        let win_check = replace(path_val, "/", "\\")
        let check_r = shell("if exist \"" + win_check + "\" (echo exists) else (echo missing)")
        let check_result = try3 { trim(dict_get(check_r, "stdout")) } { "missing" }
        if3 contains(check_result, "missing") {
            result = dict_set(result, "path", "")
            result = dict_set(result, "is_temp", false)
            result = dict_set(result, "error", "File not found: " + path_val)
            return result
        }
        if3 is_error(check_result) {
            result = dict_set(result, "path", "")
            result = dict_set(result, "is_temp", false)
            result = dict_set(result, "error", "Cannot access file: " + path_val)
            return result
        }
        result = dict_set(result, "path", path_val)
        result = dict_set(result, "is_temp", false)
        result = dict_set(result, "error", "")
        return result
    }

    // Fall back to text-based input
    if3 len(text_val) > 0 { tmp = tmp_md_path()
        // Use NovaLang's native nova_write — handles all escaping properly
        nova_write(tmp, text_val)
        result = dict_set(result, "path", tmp)
        result = dict_set(result, "is_temp", true)
        result = dict_set(result, "error", "")
        return result
    }

    // Neither path nor text provided
    result = dict_set(result, "path", "")
    result = dict_set(result, "is_temp", false)
    result = dict_set(result, "error", "Either 'text' or 'path' parameter is required")
    return result
}

// ===========================================================================
// HELPER: track N-S flow metrics
// ===========================================================================
fn track_ns_flow(chars_in, chars_out) {
    ns_total_chars_in = ns_total_chars_in + chars_in
    ns_total_chars_out = ns_total_chars_out + chars_out
    let re = compute_reynolds(chars_in)
    if3 re > ns_max_reynolds {
        ns_max_reynolds = re
    }
}

// ===========================================================================
// HELPER: build standard error response
// ===========================================================================
fn error_response(tool_name, error_msg) {
    record_op(tool_name, T_FALSE)
    return {
        "ok": false,
        "error": error_msg,
        "tool": tool_name,
        "trit": T_FALSE,
        "char": bt_one(T_FALSE),
        "bt3": bt_three(T_FALSE),
        "runtime": "novalang"
    }
}


// ===========================================================================
// ===========================================================================
// TOOL 1: POST /tmarkdown/render
// Render markdown text to HTML
// Body: {text: "# Hello", path: "file.md"}
// Uses Python markdown library with extensions: tables, fenced_code, toc
// Trit: +1=rendered successfully, 0=empty input, -1=error
// ===========================================================================
// ===========================================================================
fn handle_render(body) {
    // Resolve markdown source (path or text)
    let source = resolve_md_source(body)
    let src_path = dict_get(source, "path") ?? ""
    let is_temp = dict_get(source, "is_temp") ?? false
    let src_error = dict_get(source, "error") ?? ""

    // Check for resolution error
    if3 len(src_error) > 0 {
        return error_response("render", src_error)
    }

    if3 len(src_path) == 0 {
        return error_response("render", "No markdown source provided")
    }

    // Pure NovaLang: use tmarkdown.nova render micro-tool (zero Python)
    let esc_src = replace(src_path, "\\", "/")
    let render_cmd = "C:/NovaX/novalang.exe C:/NovaX/tools/tmarkdown.nova render \"" + esc_src + "\""
    let render_raw = nova_run(render_cmd)

    // Check for execution error
    if3 is_error(render_raw) {
        if3 is_temp == true {
            cleanup_temp(src_path)
        }
        return error_response("render", "Markdown render failed: " + str(render_raw))
    }

    let render_result = json_decode(trim(render_raw))
    let html_output = dict_get(render_result, "html") ?? ""
    let input_len = dict_get(render_result, "input_len") ?? 0
    let output_len = dict_get(render_result, "output_len") ?? 0

    // Cleanup temp files
    if3 is_temp == true {
        cleanup_temp(src_path)
    }

    // Determine trit
    let render_trit = T_TRUE
    if3 output_len == 0 {
        render_trit = T_MAYBE
    }

    // N-S flow tracking
    let re = compute_reynolds(input_len)
    let regime = flow_regime(re)
    track_ns_flow(input_len, output_len)

    record_op("render", render_trit)
    return {
        "ok": true,
        "html": html_output,
        "input_chars": input_len,
        "output_chars": output_len,
        "compression_ratio": output_len,
        "extensions": ["tables", "fenced_code", "toc", "codehilite", "nl2br", "sane_lists"],
        "reynolds": re,
        "regime": regime,
        "trit": render_trit,
        "char": bt_one(render_trit),
        "bt3": bt_three(render_trit),
        "runtime": "novalang"
    }
}


// ===========================================================================
// ===========================================================================
// TOOL 2: POST /tmarkdown/toc
// Extract table of contents / heading structure from markdown
// Body: {text: "# Hello\n## World", path: "file.md"}
// Returns list of headings with level, text, and id (slug)
// Trit: +1=headings found, 0=no headings, -1=error
// ===========================================================================
// ===========================================================================
fn handle_toc(body) {
    // Resolve markdown source
    let source = resolve_md_source(body)
    let src_path = dict_get(source, "path") ?? ""
    let is_temp = dict_get(source, "is_temp") ?? false
    let src_error = dict_get(source, "error") ?? ""

    if3 len(src_error) > 0 {
        return error_response("toc", src_error)
    }

    if3 len(src_path) == 0 {
        return error_response("toc", "No markdown source provided")
    }

    // Pure NovaLang: use tmarkdown.nova toc micro-tool (zero Python)
    let esc_src = replace(src_path, "\\", "/")
    let toc_cmd = "C:/NovaX/novalang.exe C:/NovaX/tools/tmarkdown.nova toc \"" + esc_src + "\""
    let toc_raw = nova_run(toc_cmd)

    if3 is_error(toc_raw) {
        if3 is_temp == true { cleanup_temp(src_path) }
        return error_response("toc", "TOC extraction failed: " + str(toc_raw))
    }

    let toc_result = json_decode(trim(toc_raw))
    let headings_list = dict_get(toc_result, "headings") ?? []
    let heading_count = dict_get(toc_result, "count") ?? 0

    // Compute max_depth and input_len
    let max_depth = 0
    let idx2 = 0
    while3 idx2 < len(headings_list) {
        let hh = dict_get(headings_list, idx2) ?? {}
        let hl = dict_get(hh, "level") ?? 0
        if3 hl > max_depth { max_depth = hl }
        idx2 = idx2 + 1
    }
    let input_len = get_file_size(src_path)

    // Cleanup
    if3 is_temp == true { cleanup_temp(src_path) }

    // Determine trit
    let toc_trit = T_TRUE
    if3 heading_count == 0 {
        toc_trit = T_MAYBE
    }

    // N-S flow
    let re = compute_reynolds(input_len)
    let regime = flow_regime(re)
    track_ns_flow(input_len, heading_count * 50)

    // Build level distribution
    let level_dist = {}
    let idx = 0
    while3 idx < len(headings_list) {
        let h = dict_get(headings_list, idx) ?? {}
        let lvl = dict_get(h, "level") ?? 0
        let lvl_key = "h" + str(lvl)
        let cur = dict_get(level_dist, lvl_key) ?? 0
        level_dist = dict_set(level_dist, lvl_key, cur + 1)
        idx = idx + 1
    }

    record_op("toc", toc_trit)
    return {
        "ok": true,
        "headings": headings_list,
        "count": heading_count,
        "max_depth": max_depth,
        "level_distribution": level_dist,
        "input_chars": input_len,
        "reynolds": re,
        "regime": regime,
        "trit": toc_trit,
        "char": bt_one(toc_trit),
        "bt3": bt_three(toc_trit),
        "runtime": "novalang"
    }
}


// ===========================================================================
// ===========================================================================
// TOOL 3: POST /tmarkdown/links
// Extract all links from markdown content
// Body: {text: "[link](url)", path: "file.md"}
// Returns list of links with text, url, and type (inline, reference, autolink)
// Trit: +1=links found, 0=no links, -1=error
// ===========================================================================
// ===========================================================================
fn handle_links(body) {
    // Resolve markdown source
    let source = resolve_md_source(body)
    let src_path = dict_get(source, "path") ?? ""
    let is_temp = dict_get(source, "is_temp") ?? false
    let src_error = dict_get(source, "error") ?? ""

    if3 len(src_error) > 0 {
        return error_response("links", src_error)
    }

    if3 len(src_path) == 0 {
        return error_response("links", "No markdown source provided")
    }

    // Pure NovaLang: use tmarkdown.nova links micro-tool (zero Python)
    let esc_src = replace(src_path, "\\", "/")
    let links_cmd = "C:/NovaX/novalang.exe C:/NovaX/tools/tmarkdown.nova links \"" + esc_src + "\""
    let links_raw = nova_run(links_cmd)

    if3 is_error(links_raw) {
        if3 is_temp == true { cleanup_temp(src_path) }
        return error_response("links", "Link extraction failed: " + str(links_raw))
    }

    let links_result = json_decode(trim(links_raw))
    let links_list = dict_get(links_result, "links") ?? []
    let link_count = dict_get(links_result, "count") ?? 0
    let type_counts = {}
    let domains_list = []
    let input_len = get_file_size(src_path)

    // Build type counts and domains from extracted links
    let li = 0
    while3 li < len(links_list) {
        let lnk = dict_get(links_list, li) ?? {}
        let ltype = "inline"
        let prev_tc = try3 { dict_get(type_counts, ltype) } { 0 }
        type_counts = dict_set(type_counts, ltype, prev_tc + 1)
        li = li + 1
    }

    // Cleanup
    if3 is_temp == true { cleanup_temp(src_path) }

    // Determine trit
    let links_trit = T_TRUE
    if3 link_count == 0 {
        links_trit = T_MAYBE
    }

    // N-S flow
    let re = compute_reynolds(input_len)
    let regime = flow_regime(re)
    track_ns_flow(input_len, link_count * 100)

    record_op("links", links_trit)
    return {
        "ok": true,
        "links": links_list,
        "count": link_count,
        "type_counts": type_counts,
        "unique_domains": domains_list,
        "input_chars": input_len,
        "reynolds": re,
        "regime": regime,
        "trit": links_trit,
        "char": bt_one(links_trit),
        "bt3": bt_three(links_trit),
        "runtime": "novalang"
    }
}


// ===========================================================================
// ===========================================================================
// TOOL 4: POST /tmarkdown/stats
// Document statistics: word count, heading count, link count, code block count
// Body: {text: "# Hello", path: "file.md"}
// Returns comprehensive document statistics
// Trit: +1=non-trivial doc, 0=trivial/empty, -1=error
// ===========================================================================
// ===========================================================================
fn handle_stats(body) {
    // Resolve markdown source
    let source = resolve_md_source(body)
    let src_path = dict_get(source, "path") ?? ""
    let is_temp = dict_get(source, "is_temp") ?? false
    let src_error = dict_get(source, "error") ?? ""

    if3 len(src_error) > 0 {
        return error_response("stats", src_error)
    }

    if3 len(src_path) == 0 {
        return error_response("stats", "No markdown source provided")
    }

    // Pure NovaLang: use tmarkdown.nova stats micro-tool (zero Python)
    let esc_src = replace(src_path, "\\", "/")
    let stats_cmd = "C:/NovaX/novalang.exe C:/NovaX/tools/tmarkdown.nova stats \"" + esc_src + "\""
    let stats_raw = nova_run(stats_cmd)

    if3 is_error(stats_raw) {
        if3 is_temp == true { cleanup_temp(src_path) }
        return error_response("stats", "Stats extraction failed: " + str(stats_raw))
    }

    let stats_data = json_decode(trim(stats_raw))

    // Extract key values for trit and reynolds
    let word_count = dict_get(stats_data, "words") ?? 0
    let char_count = dict_get(stats_data, "characters") ?? 0
    let total_headings = dict_get(stats_data, "headings") ?? 0
    let total_links = dict_get(stats_data, "links") ?? 0
    let code_blocks = dict_get(stats_data, "code_blocks") ?? 0
    let reading_time = dict_get(stats_data, "reading_time_min") ?? 0

    // Map to expected output keys
    stats_data = dict_set(stats_data, "word_count", word_count)
    stats_data = dict_set(stats_data, "char_count", char_count)
    stats_data = dict_set(stats_data, "total_headings", total_headings)
    stats_data = dict_set(stats_data, "total_links", total_links)
    stats_data = dict_set(stats_data, "reading_time_min", reading_time)

    // Cleanup
    if3 is_temp == true { cleanup_temp(src_path) }

    // Determine trit: +1 if substantial doc (>= H13 words), 0 if trivial, -1 if empty
    let stats_trit = T_TRUE
    if3 word_count < H13 {
        stats_trit = T_MAYBE
    }
    if3 word_count == 0 {
        stats_trit = T_FALSE
    }

    // N-S flow
    let re = compute_reynolds(char_count)
    let regime = flow_regime(re)
    track_ns_flow(char_count, 0)

    // Complexity score: weighted sum of structural elements
    let complexity = total_headings * H3 + total_links * H5 + code_blocks * H7

    record_op("stats", stats_trit)

    // Merge stats_data into response
    stats_data = dict_set(stats_data, "ok", true)
    stats_data = dict_set(stats_data, "complexity_score", complexity)
    stats_data = dict_set(stats_data, "reynolds", re)
    stats_data = dict_set(stats_data, "regime", regime)
    stats_data = dict_set(stats_data, "trit", stats_trit)
    stats_data = dict_set(stats_data, "char", bt_one(stats_trit))
    stats_data = dict_set(stats_data, "bt3", bt_three(stats_trit))
    stats_data = dict_set(stats_data, "runtime", "novalang")
    return stats_data
}


// ===========================================================================
// ===========================================================================
// TOOL 5: POST /tmarkdown/convert
// Convert a markdown file to an HTML file
// Body: {input_path: "doc.md", output_path: "doc.html"}
// Writes rendered HTML to output_path with optional CSS styling
// Trit: +1=converted successfully, 0=empty output, -1=error
// ===========================================================================
// ===========================================================================
fn handle_convert(body) {
    let input_path = dict_get(body, "input_path") ?? ""
    let output_path = dict_get(body, "output_path") ?? ""
    let include_css = dict_get(body, "include_css") ?? true
    let title = dict_get(body, "title") ?? ""

    // Validate paths
    if3 len(input_path) == 0 {
        return error_response("convert", "input_path parameter is required")
    }

    if3 len(output_path) == 0 {
        return error_response("convert", "output_path parameter is required")
    }

    // Check input file exists (pure NovaLang, zero Python)
    let win_ip = replace(input_path, "/", "\\")
    let check_r = shell("if exist \"" + win_ip + "\" (echo exists) else (echo missing)")
    let check_result = try3 { trim(dict_get(check_r, "stdout")) } { "missing" }
    if3 contains(check_result, "missing") {
        return error_response("convert", "Input file not found: " + input_path)
    }
    if3 is_error(check_result) {
        return error_response("convert", "Cannot access input file: " + input_path)
    }

    let eop = escape_for_py(output_path)

    // Build CSS block if requested
    let css_block = ""
    if3 include_css == true {
        css_block = "<style>body{font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial,sans-serif;max-width:900px;margin:0 auto;padding:2rem;line-height:1.6;color:#24292f;background:#0d1117;color:#c9d1d9}h1,h2,h3,h4,h5,h6{margin-top:1.5em;margin-bottom:0.5em;color:#58a6ff}a{color:#58a6ff}code{background:#161b22;padding:0.2em 0.4em;border-radius:3px;font-size:85%}pre{background:#161b22;padding:1em;border-radius:6px;overflow-x:auto}pre code{background:none;padding:0}blockquote{border-left:4px solid #30363d;margin:0;padding:0.5em 1em;color:#8b949e}table{border-collapse:collapse;width:100%}th,td{border:1px solid #30363d;padding:8px 12px}th{background:#161b22}img{max-width:100%}hr{border:none;border-top:1px solid #30363d}</style>"
    }

    // Build title
    let html_title = "Document"
    if3 len(title) > 0 {
        html_title = title
    }

    // Pure NovaLang: use tmarkdown.nova render then write HTML file (zero Python)
    let esc_ip = replace(input_path, "\\", "/")
    let render_cmd2 = "C:/NovaX/novalang.exe C:/NovaX/tools/tmarkdown.nova render \"" + esc_ip + "\""
    let render_raw2 = nova_run(render_cmd2)

    if3 is_error(render_raw2) {
        return error_response("convert", "Conversion failed: " + str(render_raw2))
    }

    let render_r2 = json_decode(trim(render_raw2))
    let html_body = dict_get(render_r2, "html") ?? ""
    let input_len = dict_get(render_r2, "input_len") ?? 0

    // Build full HTML document
    let full_html = "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>" + html_title + "</title>" + css_block + "</head><body>" + html_body + "</body></html>"
    let output_len = len(full_html)

    // Write output file
    nova_write(output_path, full_html)

    // Determine trit
    let convert_trit = T_TRUE
    if3 output_len == 0 {
        convert_trit = T_MAYBE
    }

    // N-S flow
    let re = compute_reynolds(input_len)
    let regime = flow_regime(re)
    track_ns_flow(input_len, output_len)

    // Verify output file was created
    let file_size = get_file_size(output_path)

    record_op("convert", convert_trit)
    return {
        "ok": true,
        "input_path": input_path,
        "output_path": output_path,
        "input_chars": input_len,
        "output_chars": output_len,
        "output_file_size": file_size,
        "include_css": include_css,
        "title": html_title,
        "extensions": ["tables", "fenced_code", "toc", "codehilite", "nl2br", "sane_lists"],
        "reynolds": re,
        "regime": regime,
        "trit": convert_trit,
        "char": bt_one(convert_trit),
        "bt3": bt_three(convert_trit),
        "runtime": "novalang"
    }
}


// ===========================================================================
// ===========================================================================
// TOOL 6: POST /tmarkdown/validate
// Check markdown for common issues
// Body: {text: "# Hello", path: "file.md"}
// Validates: heading hierarchy, broken links syntax, trailing whitespace,
//   missing blank lines, inconsistent list markers, etc.
// Trit: +1=valid (no issues), 0=warnings only, -1=errors found
// ===========================================================================
// ===========================================================================
fn handle_validate(body) {
    // Resolve markdown source
    let source = resolve_md_source(body)
    let src_path = dict_get(source, "path") ?? ""
    let is_temp = dict_get(source, "is_temp") ?? false
    let src_error = dict_get(source, "error") ?? ""

    if3 len(src_error) > 0 {
        return error_response("validate", src_error)
    }

    if3 len(src_path) == 0 {
        return error_response("validate", "No markdown source provided")
    }

    // Pure NovaLang: use tmarkdown.nova validate micro-tool (zero Python)
    let esc_src_v = replace(src_path, "\\", "/")
    let validate_cmd = "C:/NovaX/novalang.exe C:/NovaX/tools/tmarkdown.nova validate \"" + esc_src_v + "\""
    let validate_raw = nova_run(validate_cmd)
    if3 is_error(validate_raw) {
        if3 is_temp == true { cleanup_temp(src_path) }
        return error_response("validate", "Validation failed: " + str(validate_raw))
    }

    let val_result = json_decode(trim(validate_raw))
    let issues_list = dict_get(val_result, "issues") ?? []
    let total_issues = dict_get(val_result, "issue_count") ?? 0
    let input_len = get_file_size(src_path)
    let total_lines = 0

    // Count warnings vs errors from issues
    let warnings_count = 0
    let errors_count = 0
    let vi = 0
    while3 vi < len(issues_list) {
        let iss = dict_get(issues_list, vi) ?? {}
        let itype = dict_get(iss, "type") ?? ""
        if3 itype == "heading_no_space" { errors_count = errors_count + 1 }
        else3 { warnings_count = warnings_count + 1 }
        vi = vi + 1
    }

    // Cleanup
    if3 is_temp == true { cleanup_temp(src_path) }

    // Determine trit: +1=valid, 0=warnings only, -1=errors found
    let validate_trit = T_TRUE
    if3 warnings_count > 0 {
        validate_trit = T_MAYBE
    }
    if3 errors_count > 0 {
        validate_trit = T_FALSE
    }

    // N-S flow
    let re = compute_reynolds(input_len)
    let regime = flow_regime(re)
    track_ns_flow(input_len, total_issues * 50)

    // Quality score: 100 - (errors * H7) - (warnings * H3), min 0
    let quality_score = 100 - (errors_count * H7) - (warnings_count * H3)
    if3 quality_score < 0 {
        quality_score = 0
    }

    record_op("validate", validate_trit)
    return {
        "ok": true,
        "valid": errors_count == 0,
        "issues": issues_list,
        "warnings": warnings_count,
        "errors": errors_count,
        "total_issues": total_issues,
        "quality_score": quality_score,
        "total_lines": total_lines,
        "input_chars": input_len,
        "rules_checked": ["MD001", "MD002", "MD004", "MD009", "MD012", "MD013", "MD022", "MD024", "MD039", "MD047"],
        "reynolds": re,
        "regime": regime,
        "trit": validate_trit,
        "char": bt_one(validate_trit),
        "bt3": bt_three(validate_trit),
        "runtime": "novalang"
    }
}


// ===========================================================================
// ===========================================================================
// TOOL 7: POST /tmarkdown/extract
// Extract specific sections by heading from markdown
// Body: {text: "...", path: "file.md", heading: "Installation"}
// Returns the content under the matching heading until the next heading
// of same or higher level
// Trit: +1=section found, 0=heading not found, -1=error
// ===========================================================================
// ===========================================================================
fn handle_extract(body) {
    // Resolve markdown source
    let source = resolve_md_source(body)
    let src_path = dict_get(source, "path") ?? ""
    let is_temp = dict_get(source, "is_temp") ?? false
    let src_error = dict_get(source, "error") ?? ""

    if3 len(src_error) > 0 {
        return error_response("extract", src_error)
    }

    if3 len(src_path) == 0 {
        return error_response("extract", "No markdown source provided")
    }

    let heading = dict_get(body, "heading") ?? ""
    if3 len(heading) == 0 {
        if3 is_temp == true {
            cleanup_temp(src_path)
        }
        return error_response("extract", "heading parameter is required")
    }

    // Pure NovaLang: use tmarkdown.nova extract micro-tool (zero Python)
    let esc_src_e = replace(src_path, "\\", "/")
    let extract_cmd = "C:/NovaX/novalang.exe C:/NovaX/tools/tmarkdown.nova extract \"" + esc_src_e + "\" \"" + heading + "\""
    let extract_raw = nova_run(extract_cmd)

    if3 is_error(extract_raw) {
        if3 is_temp == true { cleanup_temp(src_path) }
        return error_response("extract", "Section extraction failed: " + str(extract_raw))
    }

    let ext_result = json_decode(trim(extract_raw))
    let found = dict_get(ext_result, "found") ?? false
    let section_text = dict_get(ext_result, "text") ?? ""
    let section_lines = dict_get(ext_result, "lines") ?? 0
    let section_chars = len(section_text)
    let heading_level = 0
    let start_line = 0
    let end_line = 0
    let sub_headings = 0
    let total_matches = 0
    let input_len = get_file_size(src_path)
    if3 found == true { total_matches = 1 }

    // Cleanup
    if3 is_temp == true { cleanup_temp(src_path) }

    // Determine trit: +1=found, 0=not found, -1 handled above
    let extract_trit = T_TRUE
    if3 found == false {
        extract_trit = T_MAYBE
    }

    // N-S flow
    let re = compute_reynolds(input_len)
    let regime = flow_regime(re)
    track_ns_flow(input_len, section_chars)

    record_op("extract", extract_trit)
    return {
        "ok": true,
        "found": found,
        "heading": heading,
        "heading_level": heading_level,
        "section": section_text,
        "start_line": start_line,
        "end_line": end_line,
        "section_lines": section_lines,
        "section_chars": section_chars,
        "sub_headings": sub_headings,
        "total_matches": total_matches,
        "input_chars": input_len,
        "reynolds": re,
        "regime": regime,
        "trit": extract_trit,
        "char": bt_one(extract_trit),
        "bt3": bt_three(extract_trit),
        "runtime": "novalang"
    }
}


// ===========================================================================
// ===========================================================================
// GET /health -- Standard health endpoint
// ===========================================================================
// ===========================================================================
fn handle_health(body) {
    let uptime = time() - stat_t0
    let self_trit = T_MAYBE
    if3 uptime > 10 {
        self_trit = T_TRUE
    }

    // Check tmarkdown.nova micro-tool availability (pure NovaLang, zero Python)
    let md_probe = shell("C:/NovaX/novalang.exe C:/NovaX/tools/tmarkdown.nova stats C:/NovaX/nova_tmarkdown_service.nova")
    let md_available = true
    let md_version = "novalang-native"
    if3 contains(md_probe, "error") {
        md_available = false
        md_version = "tmarkdown.nova unavailable"
        self_trit = T_FALSE
    }

    let counters = {"strong": stat_trit_true, "partial": stat_trit_maybe, "failed": stat_trit_false}
    let resp = ns_health_dict(SERVICE_NAME, VERSION, PORT, counters)
    resp = dict_set(resp, "tools", TOOLS_COUNT)
    resp = dict_set(resp, "markdown_version", md_version)
    resp = dict_set(resp, "markdown_available", md_available)
    resp = dict_set(resp, "self_trit", self_trit)
    resp = dict_set(resp, "char", bt_one(self_trit))
    resp = dict_set(resp, "bt3", bt_three(self_trit))
    resp = dict_set(resp, "uptime_s", uptime)
    return resp
}


// ===========================================================================
// ===========================================================================
// GET /tmarkdown/service-status -- Full service status with stats
// ===========================================================================
// ===========================================================================
fn handle_status(body) {
    let uptime = time() - stat_t0

    // Service Reynolds from total false ops
    let re = stat_trit_false * H5
    if3 re > 999 {
        re = 999
    }
    let regime = flow_regime(re)

    // System trit
    let sys_trit = T_TRUE
    if3 stat_trit_false > stat_trit_true {
        sys_trit = T_FALSE
    }
    if3 stat_trit_false == stat_trit_true {
        if3 stat_ops > 0 {
            sys_trit = T_MAYBE
        }
    }

    let by_tool = {}
    by_tool = dict_set(by_tool, "render", by_tool_render)
    by_tool = dict_set(by_tool, "toc", by_tool_toc)
    by_tool = dict_set(by_tool, "links", by_tool_links)
    by_tool = dict_set(by_tool, "stats", by_tool_stats)
    by_tool = dict_set(by_tool, "convert", by_tool_convert)
    by_tool = dict_set(by_tool, "validate", by_tool_validate)
    by_tool = dict_set(by_tool, "extract", by_tool_extract)

    // Check tmarkdown.nova micro-tool (pure NovaLang, zero Python)
    let md_probe2 = shell("C:/NovaX/novalang.exe C:/NovaX/tools/tmarkdown.nova stats C:/NovaX/nova_tmarkdown_service.nova")
    let md_ok = true
    let md_version = "novalang-native"
    if3 contains(md_probe2, "error") {
        md_ok = false
        md_version = "tmarkdown.nova unavailable"
    }

    // Native NovaLang tmarkdown supports these features
    let extensions = ["headings", "fenced_code", "lists", "blockquotes", "inline_format", "links"]

    // N-S flow summary
    let ns_flow = {}
    ns_flow = dict_set(ns_flow, "total_chars_in", ns_total_chars_in)
    ns_flow = dict_set(ns_flow, "total_chars_out", ns_total_chars_out)
    ns_flow = dict_set(ns_flow, "max_reynolds", ns_max_reynolds)
    ns_flow = dict_set(ns_flow, "max_regime", flow_regime(ns_max_reynolds))

    // Compression ratio
    let compression = 0
    if3 ns_total_chars_in > 0 {
        compression = ns_total_chars_out / ns_total_chars_in
    }
    ns_flow = dict_set(ns_flow, "avg_compression", compression)

    return {
        "ok": true,
        "service": SERVICE_NAME,
        "version": VERSION,
        "port": PORT,
        "uptime_s": uptime,
        "total_ops": stat_ops,
        "by_tool": by_tool,
        "trits": {
            "strong": stat_trit_true,
            "partial": stat_trit_maybe,
            "failed": stat_trit_false
        },
        "markdown_version": md_version,
        "markdown_available": md_ok,
        "extensions": extensions,
        "ns_flow": ns_flow,
        "reynolds": re,
        "regime": regime,
        "system_trit": sys_trit,
        "system_char": bt_one(sys_trit),
        "system_bt3": bt_three(sys_trit),
        "harmonics": {"H3": H3, "H5": H5, "H7": H7, "H13": H13},
        "reynolds_boundaries": {
            "laminar": RE_LAMINAR,
            "transition": RE_TRANSITION,
            "turbulent": RE_TURBULENT
        },
        "ns_mapping": {
            "document_flow": "velocity_field",
            "parse_complexity": "turbulent_energy"
        },
        "runtime": "novalang",
        "block_size": BLOCK_SIZE
    }
}


// ===========================================================================
// Route registration
// ===========================================================================
troute(server, "GET",  "/health",                    "handle_health")
troute(server, "GET",  "/tmarkdown/service-status",  "handle_status")
troute(server, "POST", "/tmarkdown/render",          "handle_render")
troute(server, "POST", "/tmarkdown/toc",             "handle_toc")
troute(server, "POST", "/tmarkdown/links",           "handle_links")
troute(server, "POST", "/tmarkdown/stats",           "handle_stats")
troute(server, "POST", "/tmarkdown/convert",         "handle_convert")
troute(server, "POST", "/tmarkdown/validate",        "handle_validate")
troute(server, "POST", "/tmarkdown/extract",         "handle_extract")

