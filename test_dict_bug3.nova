let inner = {"a": 1, "b": 2}

// Single line - works
let r1 = {"ok": true, "stats": inner, "x": 3}
print("single line:")
print(json_encode(r1))

// Multi line - fails?
let r2 = {
    "ok": true,
    "stats": inner,
    "x": 3
}
print("multi line:")
print(json_encode(r2))

// Multi line no nested dict - control
let r3 = {
    "ok": true,
    "stats": "hello",
    "x": 3
}
print("multi line no nesting:")
print(json_encode(r3))
