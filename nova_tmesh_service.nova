// Nova TMesh v1.0 - Ternary Service Mesh (N-S Wiring Layer)
// Port 9951: Connects ALL services into a unified nervous system
// Routes requests through TBus, TBuffer, TCircuit, TRate, TWatch etc.
//
// N-S Mapping:
//   request_flow = velocity_field through mesh
//   TBuffer = pressure_term (cache smooths turbulence)
//   TCircuit = viscosity_term (dampens failure cascades)
//   TRate = Reynolds_boundary (flow control)
//   TBus = vorticity (event propagation)
//   pipeline_stages = Navier-Stokes integration steps
//
// 3-5-7-13 Harmonics:
//   3 = ternary trit states
//   5 = TZip 5-layer cache
//   7 = 7-tier service mesh
//   13 = pipeline vector dimensions

// -- Shared Libraries (N-S Flow) --
import3("C:/NovaX/lib/nova_ns_core.nova")
import3("C:/NovaX/lib/nova_stdlib.nova")

let PORT = 9951
let server = tserve(PORT, "TMesh v1.0 - Ternary Service Mesh")

// -- 3-5-7-13 Harmonic Constants --

// -- Service Registry -- the nervous system map --
// Infrastructure (core)
let SVC_ORCHESTRATOR_URL = "http://127.0.0.1:9999"
let SVC_HIVEMIND_URL     = "http://127.0.0.1:9881"
let SVC_CLOUD_ROUTER_URL = "http://127.0.0.1:9878"
let SVC_SENTINEL_URL     = "http://127.0.0.1:9876"
let SVC_NEXUS_URL        = "http://127.0.0.1:9882"
let SVC_WEBSOCKET_URL    = "http://127.0.0.1:9998"
// Intelligence
let SVC_TSHELL_URL       = "http://127.0.0.1:9890"
let SVC_TEMBED_URL       = "http://127.0.0.1:9924"
let SVC_TCLASSIFY_URL    = "http://127.0.0.1:9921"
// Infrastructure layer
let SVC_TBUFFER_URL      = "http://127.0.0.1:9886"
let SVC_TBUS_URL         = "http://127.0.0.1:9945"
let SVC_TCIRCUIT_URL     = "http://127.0.0.1:9948"
let SVC_TRATE_URL        = "http://127.0.0.1:9949"
let SVC_TWATCH_URL       = "http://127.0.0.1:9950"
// Storage
let SVC_DEEPSTORAGE_URL  = "http://127.0.0.1:9883"
let SVC_VAULT_URL        = "http://127.0.0.1:9884"
let SVC_TZIP_URL         = "http://127.0.0.1:9885"
// Security & Network
let SVC_TSECURITY_URL    = "http://127.0.0.1:9888"
let SVC_TNET_URL         = "http://127.0.0.1:9889"
// Voice
let SVC_STT_URL          = "http://127.0.0.1:9875"
let SVC_TTS_URL          = "http://127.0.0.1:9874"

// -- Ternary States --
let TRUE  = 1
let MAYBE = 0
let FALSE = -1

// -- Stats --
let total_requests = 0
let total_ok = 0
let total_errors = 0
let total_cache_hits = 0
let mesh_log_count = 0
let last_query_ms = 0

// -- Mesh event log (recent 50 as flat list of strings) --
let event_log = []
let MAX_LOG = 50

// -- Record mesh event --
fn log_event(source, target, action, trit) {
    let entry = str(time()) + "|" + source + "->" + target + "|" + action + "|" + str(trit)
    event_log = append(event_log, entry)
    mesh_log_count = mesh_log_count + 1
    // Trim to MAX_LOG (keep last 50)
    let n = len(event_log)
    if3 n > MAX_LOG {
        let event_log = slice(event_log, n - MAX_LOG, n)
    }
}

// --------------------------------------------------------------------------
// ROUTE HANDLER -- POST /mesh/route
// Simple direct routing: POST a prompt to a named service
// --------------------------------------------------------------------------
fn mesh_route(body) {
    let service = dict_get(body, "service") ?? "hivemind"
    let prompt  = dict_get(body, "prompt") ?? ""
    let channel = dict_get(body, "channel") ?? "auto"

    if3 len(str(prompt)) == 0 {
        return {"ok": false, "trit": FALSE, "error": "prompt required"}
    }

    let t0 = time()

    // Resolve service URL
    let svc_url = ""
    if3 service == "hivemind" { svc_url = SVC_HIVEMIND_URL
    } else service == "cloud_router" { svc_url = SVC_CLOUD_ROUTER_URL
    } else service == "tshell" { svc_url = SVC_TSHELL_URL
    } else service == "tclassify" { svc_url = SVC_TCLASSIFY_URL
    } else service == "tembed" { svc_url = SVC_TEMBED_URL
    } else service == "tbuffer" { svc_url = SVC_TBUFFER_URL
    } else service == "tbus" { svc_url = SVC_TBUS_URL
    } else service == "tcircuit" { svc_url = SVC_TCIRCUIT_URL
    } else service == "trate" { svc_url = SVC_TRATE_URL
    } else service == "deepstorage" { svc_url = SVC_DEEPSTORAGE_URL
    } else {
        return {"ok": false, "trit": FALSE, "error": "unknown service: " + str(service)}
    }

    // Send request to service
    let payload = {"prompt": str(prompt), "channel": str(channel), "text": str(prompt)}
    let result = http_post(svc_url + "/hive/query", payload)

    let response = dict_get(result, "merged_response") ?? ""
    if3 len(str(response)) == 0 {
        let response = dict_get(result, "response") ?? ""
    }

    let elapsed = round((time() - t0) * 1000)
    let last_query_ms = elapsed
    total_requests = total_requests + 1

    let trit = TRUE
    if3 len(str(response)) == 0 {
        let trit = FALSE
        total_errors = total_errors + 1
    }
    if3 len(str(response)) > 0 {
        total_ok = total_ok + 1
    }

    log_event("tmesh", str(service), "route", trit)

    return {
        "ok": true,
        "trit": trit,
        "service": service,
        "response": response,
        "channel": channel,
        "time_ms": elapsed,
        "ternary": true,
        "runtime": "novalang"
    }
}

// --------------------------------------------------------------------------
// QUERY PIPELINE -- POST /tmesh/query
// Smart pipeline: TBuffer cache -> TClassify -> TCircuit -> TRate -> AI -> store
// --------------------------------------------------------------------------
fn tmesh_query(body) {
    let prompt     = dict_get(body, "prompt") ?? ""
    let channel    = dict_get(body, "channel") ?? "auto"
    let skip_cache = dict_get(body, "skip_cache") ?? false

    if3 len(str(prompt)) == 0 {
        return {"ok": false, "trit": FALSE, "error": "prompt required"}
    }

    let t0 = time()
    let pipeline = []
    total_requests = total_requests + 1

    // -- Step 1: TBuffer Cache Check --
    if3 skip_cache == false { cache_payload = {"prompt": str(prompt), "threshold": 0.90}
        let cache_result  = http_post(SVC_TBUFFER_URL + "/tbuffer/query", cache_payload)
        let cache_trit    = dict_get(cache_result, "trit") ?? FALSE

        if3 cache_trit == TRUE {
            // Cache HIT -- return immediately
            let cached_response = dict_get(cache_result, "response") ?? ""
            log_event("tmesh", "tbuffer", "cache_hit", TRUE)
            pipeline = append(pipeline, {"step": "cache", "result": "HIT", "trit": TRUE})
            total_cache_hits = total_cache_hits + 1
            total_ok = total_ok + 1
            let elapsed = round((time() - t0) * 1000)
            let last_query_ms = elapsed
            return {
                "ok": true,
                "trit": TRUE,
                "source": "cache",
                "response": cached_response,
                "pipeline": pipeline,
                "time_ms": elapsed,
                "ternary": true,
                "runtime": "novalang"
            }
        }
        pipeline = append(pipeline, {"step": "cache", "result": "MISS", "trit": cache_trit})
    } else {
        pipeline = append(pipeline, {"step": "cache", "result": "SKIP", "trit": MAYBE})
    }

    // -- Step 2: TClassify Intent --
    let classify_payload = {"text": str(prompt)}
    let intent_result    = http_post(SVC_TCLASSIFY_URL + "/tclass/intent", classify_payload)
    let intent           = dict_get(intent_result, "intent") ?? "statement"
    let intent_trit      = dict_get(intent_result, "trit") ?? MAYBE
    pipeline = append(pipeline, {"step": "classify", "intent": intent, "trit": intent_trit})

    // -- Step 3: TEmbed for semantic vector --
    let embed_payload = {"text": str(prompt), "store": true}
    let embed_result  = http_post(SVC_TEMBED_URL + "/tembed/encode", embed_payload)
    let embed_dims    = dict_get(embed_result, "dimensions") ?? 0
    let embed_trit    = dict_get(embed_result, "trit") ?? MAYBE
    pipeline = append(pipeline, {"step": "embed", "dimensions": embed_dims, "trit": embed_trit})

    // -- Step 4: TCircuit Breaker Check --
    let target_service   = "hivemind"
    let circuit_payload  = {"service_name": target_service}
    let circuit_result   = http_post(SVC_TCIRCUIT_URL + "/tcircuit/check", circuit_payload)
    let circuit_state    = dict_get(circuit_result, "state") ?? "UNKNOWN"
    let circuit_trit     = dict_get(circuit_result, "trit") ?? MAYBE
    pipeline = append(pipeline, {"step": "circuit", "target": target_service, "state": circuit_state, "trit": circuit_trit})

    if3 circuit_trit == FALSE {
        // Circuit OPEN -- fail fast
        log_event("tmesh", "tcircuit", "circuit_open", FALSE)
        let retry_in = dict_get(circuit_result, "retry_in") ?? H13
        total_errors = total_errors + 1
        return {
            "ok": false,
            "trit": FALSE,
            "source": "circuit_breaker",
            "error": "hivemind circuit is OPEN",
            "retry_in": retry_in,
            "pipeline": pipeline,
            "ternary": true,
            "runtime": "novalang"
        }
    } else circuit_trit == MAYBE {
        // Circuit HALF-OPEN -- proceed with caution
        pipeline = append(pipeline, {"step": "circuit_warn", "trit": MAYBE})
    } else {
        // Circuit CLOSED -- all good
        pipeline = append(pipeline, {"step": "circuit_ok", "trit": TRUE})
    }

    // -- Step 5: TRate Limit Check --
    let rate_key     = "tmesh_hivemind"
    let rate_payload = {"key": rate_key, "cost": 1}
    let rate_result  = http_post(SVC_TRATE_URL + "/trate/check", rate_payload)
    let rate_action  = dict_get(rate_result, "action") ?? "DENY"
    let rate_trit    = dict_get(rate_result, "trit") ?? FALSE
    pipeline = append(pipeline, {"step": "rate", "action": rate_action, "trit": rate_trit})

    if3 rate_trit == FALSE {
        log_event("tmesh", "trate", "rate_denied", FALSE)
        let retry_in = dict_get(rate_result, "retry_in") ?? 1
        total_errors = total_errors + 1
        return {
            "ok": false,
            "trit": FALSE,
            "source": "rate_limiter",
            "error": "Rate limit exceeded",
            "retry_in": retry_in,
            "pipeline": pipeline,
            "ternary": true,
            "runtime": "novalang"
    } else {
        pipeline = append(pipeline, {"step": "rate_ok", "trit": TRUE})
    }

    // -- Step 6: Route to Hivemind --
    let route_payload = {"prompt": str(prompt)}
    if3 str(channel) != "auto" { route_payload = {"prompt": str(prompt), "channel": str(channel)}
    } else { route_payload = {"prompt": str(prompt)}
    }
    let ai_result = http_post(SVC_HIVEMIND_URL + "/hive/query", route_payload)

    let response_text = dict_get(ai_result, "merged_response") ?? ""
    if3 len(str(response_text)) == 0 {
        let response_text = dict_get(ai_result, "response") ?? ""
    }

    let models_queried   = dict_get(ai_result, "models_queried") ?? 0
    let models_responded = dict_get(ai_result, "models_responded") ?? 0

    // Determine AI trit from response length
    let ai_trit = FALSE
    if3 len(str(response_text)) > 0 {
        let ai_trit = MAYBE
    }
    if3 len(str(response_text)) > 50 {
        let ai_trit = TRUE
    }

    append(pipeline, {
        "step": "route",
        "target": target_service,
        "trit": ai_trit,
        "models_queried": models_queried,
        "models_responded": models_responded
    })

    // Report circuit outcome
    let circuit_report_success = false
    if3 ai_trit != FALSE { circuit_report_success = true
    } else { circuit_report_success = false
    }
    let circuit_report = http_post(SVC_TCIRCUIT_URL + "/tcircuit/report",
        {"service_name": target_service, "success": circuit_report_success})
    log_event("tmesh", "hivemind", "query", ai_trit)

    // -- Step 7: Cache the result --
    if3 ai_trit != FALSE {
        if3 len(str(response_text)) > 0 {
            let store_payload = {
                "prompt": str(prompt),
                "response": str(response_text),
                "channel": str(channel)
            }
            let store_result = http_post(SVC_TBUFFER_URL + "/tbuffer/store", store_payload)
            pipeline = append(pipeline, {"step": "cache_store", "trit": TRUE})
    } else {
        pipeline = append(pipeline, {"step": "cache_store", "trit": MAYBE})
    }

    // -- Step 8: Publish Event on TBus --
    let resp_len = len(str(response_text))
    let bus_priority = 0
    if3 ai_trit == TRUE { bus_priority = 1
    } else { bus_priority = 0
    }
    let bus_payload = {
        "topic": "mesh.query",
        "data": {
            "intent": str(intent),
            "channel": str(channel),
            "response_len": resp_len,
            "trit": ai_trit
        },
        "priority": bus_priority
    }
    let bus_result = http_post(SVC_TBUS_URL + "/tbus/publish", bus_payload)
    log_event("tmesh", "tbus", "publish", TRUE)

    let elapsed = round((time() - t0) * 1000)
    let last_query_ms = elapsed

    if3 ai_trit == FALSE {
        total_errors = total_errors + 1
    } else {
        total_ok = total_ok + 1
    }

    return {
        "ok": true,
        "trit": ai_trit,
        "source": target_service,
        "response": response_text,
        "intent": intent,
        "channel": channel,
        "pipeline": pipeline,
        "time_ms": elapsed,
        "ternary": true,
        "runtime": "novalang"
    }
}

// --------------------------------------------------------------------------
// COLLABORATE -- POST /tmesh/collaborate
// Send a task to multiple named services sequentially, merge best result
// --------------------------------------------------------------------------
}
}
fn tmesh_collaborate(body) {
    let task       = dict_get(body, "task") ?? ""
    let services   = dict_get(body, "services") ?? []
    let merge_mode = dict_get(body, "merge") ?? "best"

    if3 len(str(task)) == 0 {
        return {"ok": false, "trit": FALSE, "error": "task required"}
    }

    // Default to hivemind if no services listed
    let svc_list = services
    if3 len(svc_list) == 0 {
        let svc_list = ["hivemind"]
    }

    let results     = []
    let ok_count    = 0
    let best_text   = ""
    let best_len    = 0

    // Query each service sequentially (NovaLang has no threads)
    let i = 0
    let n = len(svc_list)
    while3 i < n {
        let svc_name = svc_list[i]
        let svc_url  = ""

        // Resolve URL
        if3 svc_name == "hivemind" { svc_url = SVC_HIVEMIND_URL
        } else svc_name == "cloud_router" { svc_url = SVC_CLOUD_ROUTER_URL
        } else svc_name == "tshell" { svc_url = SVC_TSHELL_URL
        } else svc_name == "tclassify" { svc_url = SVC_TCLASSIFY_URL
        } else svc_name == "tembed" { svc_url = SVC_TEMBED_URL
        } else {
            // Unknown service -- skip
            results = append(results, {"service": str(svc_name), "ok": false, "error": "unknown service"})
            i = i + 1
            // NovaLang while3 re-checks condition
        }

        if3 len(str(svc_url)) > 0 {
            let svc_payload = {"prompt": str(task), "text": str(task)}

            // Try /hive/query first, fall back to /api/query
            let r = http_post(svc_url + "/hive/query", svc_payload)
            let r_resp = dict_get(r, "merged_response") ?? ""
            if3 len(str(r_resp)) == 0 {
                let r_resp = dict_get(r, "response") ?? ""
            }

            if3 len(str(r_resp)) == 0 {
                let r2 = http_post(svc_url + "/api/query", svc_payload)
                let r_resp = dict_get(r2, "merged_response") ?? ""
                if3 len(str(r_resp)) == 0 {
                    let r_resp = dict_get(r2, "response") ?? ""
                }
            }

            let entry_trit = FALSE
            if3 len(str(r_resp)) > 0 {
                let entry_trit = TRUE
                let ok_count   = ok_count + 1
                // Track best (longest) response
                if3 len(str(r_resp)) > best_len {
                    let best_len  = len(str(r_resp))
                    let best_text = str(r_resp)
                }
            }

            results = append(results, {"service": str(svc_name), "ok": true, "trit": entry_trit, "response": r_resp})
        }

        i = i + 1
    }

    // Merge results
    let merged_out = best_text
    if3 merge_mode == "all" {
        // Concatenate all ok responses
        let merged_out = ""
        let j = 0
        let rn = len(results)
        while3 j < rn {
            let entry = results[j]
            let entry_resp = dict_get(entry, "response") ?? ""
            if3 len(str(entry_resp)) > 0 {
                let merged_out = str(merged_out) + "[" + str(dict_get(entry, "service") ?? "") + "]: " + str(entry_resp) + "\n"
            }
            j = j + 1
    } else { merged_out = best_text
    }

    // Publish collaboration event on TBus
    let bus_collab = {
        "topic": "mesh.collaborate",
        "data": {
            "task_len": len(str(task)),
            "services_count": n,
            "responded": ok_count
        }
    }
    let bus_collab_result = http_post(SVC_TBUS_URL + "/tbus/publish", bus_collab)
    log_event("tmesh", "tbus", "collaborate", TRUE)

    let final_trit = FALSE
    if3 ok_count > 0 {
        let final_trit = TRUE
    }

    total_requests = total_requests + 1
    if3 final_trit == TRUE {
        total_ok = total_ok + 1
    } else {
        total_errors = total_errors + 1
    }

    return {
        "ok": true,
        "trit": final_trit,
        "merged": merged_out,
        "results": results,
        "responded": ok_count,
        "total": n,
        "ternary": true,
        "runtime": "novalang"
    }
}

// --------------------------------------------------------------------------
// HEALTH -- GET /tmesh/health
// Check all registered services for liveness
// --------------------------------------------------------------------------
}
fn tmesh_health() {
    // Check each service in order, build results list
    let svc_names = [
        "orchestrator", "hivemind", "cloud_router", "sentinel", "nexus",
        "websocket", "tshell", "tembed", "tclassify", "tbuffer",
        "tbus", "tcircuit", "trate", "twatch", "deepstorage",
        "vault", "tzip", "tsecurity", "tnet", "stt", "tts"
    ]
    let svc_urls = [
        SVC_ORCHESTRATOR_URL, SVC_HIVEMIND_URL, SVC_CLOUD_ROUTER_URL,
        SVC_SENTINEL_URL, SVC_NEXUS_URL, SVC_WEBSOCKET_URL,
        SVC_TSHELL_URL, SVC_TEMBED_URL, SVC_TCLASSIFY_URL,
        SVC_TBUFFER_URL, SVC_TBUS_URL, SVC_TCIRCUIT_URL,
        SVC_TRATE_URL, SVC_TWATCH_URL, SVC_DEEPSTORAGE_URL,
        SVC_VAULT_URL, SVC_TZIP_URL, SVC_TSECURITY_URL,
        SVC_TNET_URL, SVC_STT_URL, SVC_TTS_URL
    ]

    let results  = {}
    let alive    = 0
    let total    = len(svc_names)
    let i        = 0

    while3 i < total {
        let name    = svc_names[i]
        let url     = svc_urls[i]
        let t0      = time()
        let health  = http_get(url + "/health")
        let elapsed = round((time() - t0) * 1000)

        // Detect liveness from any known health field
        let is_ok   = false
        let h_ok    = dict_get(health, "ok") ?? false
        let h_tern  = dict_get(health, "ternary") ?? false
        let h_port  = dict_get(health, "port") ?? -1
        let h_ver   = dict_get(health, "version") ?? ""

        if3 h_ok == true { is_ok = true
        } else h_tern == true { is_ok = true
        } else h_port > 0 { is_ok = true
        } else len(str(h_ver)) > 0 { is_ok = true
        } else { is_ok = false
        }

        let svc_trit = FALSE
        if3 is_ok {
            let svc_trit = TRUE
            let alive    = alive + 1
        }

        let version = dict_get(health, "version") ?? "?"
        results = dict_set(results, str(name), {
            "url":     str(url),
            "alive":   is_ok,
            "trit":    svc_trit,
            "ms":      elapsed,
            "version": str(version)
        })

        i = i + 1
    }

    // Overall mesh trit using N-S 70% threshold (H7/H13 boundary)
    let pct = 0
    if3 total > 0 {
        let pct = round(alive * 100 / total)
    }

    let overall = FALSE
    if3 alive == total { overall = TRUE
    } else pct >= 70 { overall = MAYBE
    } else { overall = FALSE
    }

    return {
        "ok": true,
        "trit": overall,
        "alive": alive,
        "total": total,
        "health_pct": pct,
        "services": results,
        "ternary": true,
        "runtime": "novalang"
    }
}

// --------------------------------------------------------------------------
// DISCOVER -- GET /tmesh/discover
// Return the service registry (discovery endpoint)
// --------------------------------------------------------------------------
fn tmesh_discover() {
    let registry = {
        "orchestrator":  {"url": SVC_ORCHESTRATOR_URL, "tier": "core"},
        "hivemind":      {"url": SVC_HIVEMIND_URL,     "tier": "core"},
        "cloud_router":  {"url": SVC_CLOUD_ROUTER_URL, "tier": "core"},
        "sentinel":      {"url": SVC_SENTINEL_URL,     "tier": "core"},
        "nexus":         {"url": SVC_NEXUS_URL,         "tier": "core"},
        "websocket":     {"url": SVC_WEBSOCKET_URL,    "tier": "core"},
        "tshell":        {"url": SVC_TSHELL_URL,       "tier": "intel"},
        "tembed":        {"url": SVC_TEMBED_URL,        "tier": "intel"},
        "tclassify":     {"url": SVC_TCLASSIFY_URL,    "tier": "intel"},
        "tbuffer":       {"url": SVC_TBUFFER_URL,       "tier": "infra"},
        "tbus":          {"url": SVC_TBUS_URL,          "tier": "infra"},
        "tcircuit":      {"url": SVC_TCIRCUIT_URL,      "tier": "infra"},
        "trate":         {"url": SVC_TRATE_URL,         "tier": "infra"},
        "twatch":        {"url": SVC_TWATCH_URL,        "tier": "infra"},
        "deepstorage":   {"url": SVC_DEEPSTORAGE_URL,  "tier": "storage"},
        "vault":         {"url": SVC_VAULT_URL,         "tier": "storage"},
        "tzip":          {"url": SVC_TZIP_URL,          "tier": "storage"},
        "tsecurity":     {"url": SVC_TSECURITY_URL,    "tier": "security"},
        "tnet":          {"url": SVC_TNET_URL,          "tier": "network"},
        "stt":           {"url": SVC_STT_URL,           "tier": "voice"},
        "tts":           {"url": SVC_TTS_URL,           "tier": "voice"}
    }
    return {
        "ok": true,
        "trit": TRUE,
        "service_count": 21,
        "registry": registry,
        "ternary": true,
        "runtime": "novalang"
    }
}

// --------------------------------------------------------------------------
// TOPOLOGY -- GET /tmesh/topology
// Service graph: nodes + edges for visualization
// --------------------------------------------------------------------------
fn tmesh_topology() {
    let nodes = [
        {"id": "orchestrator", "tier": "core",     "url": SVC_ORCHESTRATOR_URL},
        {"id": "hivemind",     "tier": "core",     "url": SVC_HIVEMIND_URL},
        {"id": "cloud_router", "tier": "core",     "url": SVC_CLOUD_ROUTER_URL},
        {"id": "sentinel",     "tier": "core",     "url": SVC_SENTINEL_URL},
        {"id": "nexus",        "tier": "core",     "url": SVC_NEXUS_URL},
        {"id": "tshell",       "tier": "intel",    "url": SVC_TSHELL_URL},
        {"id": "tembed",       "tier": "intel",    "url": SVC_TEMBED_URL},
        {"id": "tclassify",    "tier": "intel",    "url": SVC_TCLASSIFY_URL},
        {"id": "tbuffer",      "tier": "infra",    "url": SVC_TBUFFER_URL},
        {"id": "tbus",         "tier": "infra",    "url": SVC_TBUS_URL},
        {"id": "tcircuit",     "tier": "infra",    "url": SVC_TCIRCUIT_URL},
        {"id": "trate",        "tier": "infra",    "url": SVC_TRATE_URL},
        {"id": "twatch",       "tier": "infra",    "url": SVC_TWATCH_URL},
        {"id": "deepstorage",  "tier": "storage",  "url": SVC_DEEPSTORAGE_URL},
        {"id": "vault",        "tier": "storage",  "url": SVC_VAULT_URL},
        {"id": "tzip",         "tier": "storage",  "url": SVC_TZIP_URL},
        {"id": "tsecurity",    "tier": "security", "url": SVC_TSECURITY_URL},
        {"id": "tnet",         "tier": "network",  "url": SVC_TNET_URL},
        {"id": "stt",          "tier": "voice",    "url": SVC_STT_URL},
        {"id": "tts",          "tier": "voice",    "url": SVC_TTS_URL}
    ]
    let edges = [
        {"source": "tmesh",    "target": "tbuffer",    "label": "cache"},
        {"source": "tmesh",    "target": "tclassify",  "label": "classify"},
        {"source": "tmesh",    "target": "tembed",     "label": "embed"},
        {"source": "tmesh",    "target": "tcircuit",   "label": "protect"},
        {"source": "tmesh",    "target": "trate",      "label": "throttle"},
        {"source": "tmesh",    "target": "hivemind",   "label": "query"},
        {"source": "tmesh",    "target": "tbus",       "label": "publish"},
        {"source": "tmesh",    "target": "deepstorage","label": "archive"},
        {"source": "hivemind", "target": "cloud_router","label": "route"},
        {"source": "hivemind", "target": "tshell",     "label": "crossval"},
        {"source": "sentinel", "target": "twatch",     "label": "monitor"},
        {"source": "twatch",   "target": "tbuffer",    "label": "restart"},
        {"source": "twatch",   "target": "tbus",       "label": "restart"}
    ]
    return {
        "ok": true,
        "trit": TRUE,
        "nodes": nodes,
        "edges": edges,
        "node_count": len(nodes),
        "edge_count": len(edges),
        "ternary": true,
        "runtime": "novalang"
    }
}

// --------------------------------------------------------------------------
// EVENTS -- GET /tmesh/events
// Return recent mesh event log
// --------------------------------------------------------------------------
fn tmesh_events() {
    let n       = len(event_log)
    let start   = 0
    if3 n > 50 {
        let start = n - 50
    }
    let recent = slice(event_log, start, n)
    return {
        "ok": true,
        "trit": TRUE,
        "events": recent,
        "total_logged": mesh_log_count,
        "ternary": true,
        "runtime": "novalang"
    }
}

// --------------------------------------------------------------------------
// STATUS -- GET /tmesh/status
// Full mesh status with stats
// --------------------------------------------------------------------------
fn tmesh_status() {
    let cache_pct = 0
    if3 total_requests > 0 {
        let cache_pct = round(total_cache_hits * 100 / total_requests)
    }
    let ok_pct = 0
    if3 total_requests > 0 {
        let ok_pct = round(total_ok * 100 / total_requests)
    }
    return {
        "ok": true,
        "trit": TRUE,
        "service": "tmesh",
        "port": PORT,
        "version": "1.0",
        "ternary": true,
        "runtime": "novalang",
        "stats": {
            "total_requests": total_requests,
            "total_ok": total_ok,
            "total_errors": total_errors,
            "total_cache_hits": total_cache_hits,
            "cache_hit_pct": cache_pct,
            "ok_pct": ok_pct,
            "last_query_ms": last_query_ms
        },
        "harmonics": {"H3": H3, "H5": H5, "H7": H7, "H13": H13},
        "registered_services": 21,
        "recent_events": mesh_log_count
    }
}

// --------------------------------------------------------------------------
// HEALTH -- GET /health
// Standard NovaX health endpoint
// --------------------------------------------------------------------------
fn health() {
    let resp = ns_health_dict("tmesh", "1.0", PORT, {})
    return resp
}

// -- Register routes --
troute(server, "GET",  "/health",           "health")
troute(server, "GET",  "/tmesh/health",     "tmesh_health")
troute(server, "GET",  "/tmesh/status",     "tmesh_status")
troute(server, "GET",  "/tmesh/events",     "tmesh_events")
troute(server, "GET",  "/tmesh/topology",   "tmesh_topology")
troute(server, "GET",  "/tmesh/discover",   "tmesh_discover")
troute(server, "POST", "/mesh/route",       "mesh_route")
troute(server, "POST", "/tmesh/query",      "tmesh_query")
troute(server, "POST", "/tmesh/collaborate","tmesh_collaborate")

print("[TMesh] NovaLang TMesh v1.0 - Ternary Service Mesh")
print("[TMesh] Port: " + str(PORT) + " | Runtime: NovaLang | Ternary: TRUE")
print("[TMesh] Registered services: 21 across 7 tiers")
print("[TMesh] Routes: /health, /tmesh/health, /tmesh/status, /tmesh/events")
print("[TMesh] Routes: /tmesh/topology, /tmesh/discover")
print("[TMesh] Routes: POST /mesh/route, /tmesh/query, /tmesh/collaborate")
print("[TMesh] N-S Mapping: TBuffer=pressure, TCircuit=viscosity, TRate=Reynolds, TBus=vorticity")
print("[TMesh] Harmonics: H3=" + str(H3) + " H5=" + str(H5) + " H7=" + str(H7) + " H13=" + str(H13))

tstart(server)
