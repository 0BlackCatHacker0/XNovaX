// ================================================================
// TShell: Filesystem Watcher Tick (on-demand, no threading)
// ================================================================

// Scan a single directory listing via nova_run, fingerprint new files
fn watcher_scan_dir(dirpath, depth) {
    if3 depth > _config_max_depth {
        return 0
    } else {
        // proceed with scan
    }

    // List files via cmd /c dir /b /a-d
    let file_listing = ""
    try3 {
        let file_listing = nova_run("cmd /c dir /b /a-d \"" + dirpath + "\" 2>nul")
    } else {
        return 0
    }

    let files = split(trim(file_listing), "\n")
    let fi = 0
    let indexed_count = 0
    while3 fi < len(files) {
        let fname = trim(dict_get(files, fi))
        if3 len(fname) > 0 {
            // Skip hidden files (starting with .)
            if3 starts_with(fname, ".") {
                // skip hidden
            } else { fpath = dirpath + "/" + fname
                // Check if already indexed and unchanged
                let existing = dict_get(_ternary_index, fpath) ?? {}
                if3 len(keys(existing)) == 0 {
                    // Not indexed yet -- fingerprint it
                    try3 {
                        let fp = fingerprint_file(fpath)
                        let fsize = dict_get(fp, "size") ?? 0
                        if3 fsize > 0 {
                            if3 fsize <= _config_max_file_size {
                                index_add(fpath, fp)
                                indexed_count = indexed_count + 1
                                _watcher_files_indexed = _watcher_files_indexed + 1

                                // Auto-compress check
                                if3 _config_auto_compress == T_TRUE {
                                    ext = get_ext(fpath)
                                    if3 should_skip_compress(ext) == T_FALSE {
                                        if3 fsize >= 1024 {
                                            // Delegate compression to tzip service
                                            try3 {
                                                let comp_body = json_encode(dict_set(dict_set({}, "path", fpath), "output", TSHELL_DIR + "/compressed"))
                                                let comp_result = http_post("http://127.0.0.1:9885/tzip/compress", comp_body)
                                                // Could update fp with compressed info here
                                            } else {
                                                // compress delegate failed, skip
                                        } else {
                                            // too small to compress
                                    } else {
                                        // skip already-compressed format
                                } else {
                                    // auto-compress disabled
                            } else {
                                // file too large
                        } else {
                            // empty file
                    } else {
                        // fingerprint failed
                } else {
                    // already indexed
        } else {
            // empty line
        }
        fi = fi + 1
    }

    // Recurse into subdirectories
    let dir_listing = ""
    try3 {
        let dir_listing = nova_run("cmd /c dir /b /ad \"" + dirpath + "\" 2>nul")
    } else {
        // no subdirs
    }

    if3 len(trim(dir_listing)) > 0 {
        dirs = split(trim(dir_listing), "\n")
        let di = 0
        while3 di < len(dirs) {
            let dname = lower(trim(dict_get(dirs, di)))
            if3 len(dname) > 0 {
                // Skip certain directories
                if3 dname == ".git" {
                    // skip
                } else dname == "node_modules" {
                    // skip
                } else dname == "__pycache__" {
                    // skip
                } else dname == ".claude" {
                    // skip
                } else dname == "tshell" {
                    // skip
                } else dname == ".vs" {
                    // skip
                } else dname == "venv" {
                    // skip
                } else dname == "env" {
                    // skip
                } else { subdir = dirpath + "/" + trim(dict_get(dirs, di))
                    let sub_count = watcher_scan_dir(subdir, depth + 1)
                    indexed_count = indexed_count + sub_count
            } else {
                // empty dir name
            }
            di = di + 1
    } else {
        // no subdirs to recurse
    }

    return indexed_count
}

// Full watcher tick -- scans all watch dirs
}
}
}
}
}
}
}
}
}
}
}
fn watcher_tick() {
    let total_indexed = 0
    let wi = 0
    while3 wi < len(_config_watch_dirs) {
        let watch_dir = dict_get(_config_watch_dirs, wi)
        let count = watcher_scan_dir(watch_dir, 0)
        total_indexed = total_indexed + count
        wi = wi + 1
    }
    _watcher_scan_count = _watcher_scan_count + 1
    _tshell_stats_scans = _tshell_stats_scans + 1
    // Save index after each scan
    index_save()
    return total_indexed
}

// ================================================================
// System Monitor (via nova_run wmic commands)
// ================================================================

fn system_disk_info() {
    let result = {}
    try3 {
        let raw = nova_run("cmd /c wmic logicaldisk where \"DeviceID='C:'\" get FreeSpace,Size /format:csv 2>nul")
        let lines = split(trim(raw), "\n")
        // CSV output: Node,FreeSpace,Size
        if3 len(lines) >= 2 {
            data_line = trim(dict_get(lines, len(lines) - 1))
            let parts = split(data_line, ",")
            if3 len(parts) >= 3 {
                free = int(trim(dict_get(parts, 1)))
                let total = int(trim(dict_get(parts, 2)))
                let used = total - free
                let pct = 0
                if3 total > 0 {
                    pct = round(used / total * 1000) / 10
                } else {
                    // avoid division by zero
                }
                result = dict_set(result, "total", total)
                result = dict_set(result, "used", used)
                result = dict_set(result, "free", free)
                result = dict_set(result, "total_hr", human_size(total))
                result = dict_set(result, "used_hr", human_size(used))
                result = dict_set(result, "free_hr", human_size(free))
                result = dict_set(result, "percent", pct)
            } else {
                // parse failed
        } else {
            // no data
    } else {
        // wmic failed
    }
    return result
}
}
}

fn system_ram_info() {
    let result = {}
    try3 {
        let raw = nova_run("cmd /c wmic os get TotalVisibleMemorySize,FreePhysicalMemory /format:csv 2>nul")
        let lines = split(trim(raw), "\n")
        if3 len(lines) >= 2 {
            data_line = trim(dict_get(lines, len(lines) - 1))
            let parts = split(data_line, ",")
            if3 len(parts) >= 3 {
                free_kb = int(trim(dict_get(parts, 1)))
                let total_kb = int(trim(dict_get(parts, 2)))
                let used_kb = total_kb - free_kb
                let total_b = total_kb * 1024
                let used_b = used_kb * 1024
                let free_b = free_kb * 1024
                let pct = 0
                if3 total_kb > 0 {
                    pct = round(used_kb / total_kb * 1000) / 10
                } else {
                    // avoid division by zero
                }
                result = dict_set(result, "total", total_b)
                result = dict_set(result, "used", used_b)
                result = dict_set(result, "free", free_b)
                result = dict_set(result, "total_hr", human_size(total_b))
                result = dict_set(result, "used_hr", human_size(used_b))
                result = dict_set(result, "free_hr", human_size(free_b))
                result = dict_set(result, "percent", pct)
            } else {
                // parse failed
        } else {
            // no data
    } else {
        // wmic failed
    }
    return result
}
}
}

fn system_gpu_info() {
    let result = {}
    try3 {
        let raw = nova_run("cmd /c nvidia-smi --query-gpu=name,memory.total,memory.used,memory.free,utilization.gpu --format=csv,noheader,nounits 2>nul")
        let trimmed = trim(raw)
        if3 len(trimmed) > 0 {
            parts = split(trimmed, ",")
            if3 len(parts) >= 5 {
                gpu_name = trim(dict_get(parts, 0))
                let total_mb = int(trim(dict_get(parts, 1)))
                let used_mb = int(trim(dict_get(parts, 2)))
                let free_mb = int(trim(dict_get(parts, 3)))
                let util = int(trim(dict_get(parts, 4)))
                let pct = 0
                if3 total_mb > 0 {
                    pct = round(used_mb / total_mb * 1000) / 10
                } else {
                    // avoid division by zero
                }
                result = dict_set(result, "name", gpu_name)
                result = dict_set(result, "vram_total", total_mb * 1048576)
                result = dict_set(result, "vram_used", used_mb * 1048576)
                result = dict_set(result, "vram_free", free_mb * 1048576)
                result = dict_set(result, "vram_total_hr", str(total_mb) + " MB")
                result = dict_set(result, "vram_used_hr", str(used_mb) + " MB")
                result = dict_set(result, "vram_free_hr", str(free_mb) + " MB")
                result = dict_set(result, "utilization", util)
                result = dict_set(result, "percent", pct)
            } else {
                // not enough fields
        } else {
            // nvidia-smi returned empty
    } else {
        // nvidia-smi not available
    }
    return result
}
}
}

fn system_snapshot() {
    let snap = {}
    snap = dict_set(snap, "ts", time())
    snap = dict_set(snap, "disk", system_disk_info())
    snap = dict_set(snap, "ram", system_ram_info())
    snap = dict_set(snap, "gpu", system_gpu_info())
    // Record in history (cap at 60)
    _sys_history = append(_sys_history, snap)
    if3 len(_sys_history) > 60 {
        _sys_history = slice(_sys_history, len(_sys_history) - 60, len(_sys_history))
    } else {
        // under limit
    }
    return snap
}

// -- Ternary system state: 25-trit word representing channel health --
fn ternary_system_state() {
    let snap = system_snapshot()
    let disk_pct = dict_get(dict_get(snap, "disk", {}), "percent") ?? 50
    let ram_pct = dict_get(dict_get(snap, "ram", {}), "percent") ?? 50
    let gpu_pct = dict_get(dict_get(snap, "gpu", {}), "percent") ?? 50

    // Map percentages to trits
    let disk_trit = T_TRUE
    if3 disk_pct >= 90 {
        disk_trit = T_FALSE
    } else disk_pct >= 70 { disk_trit = T_MAYBE
    } else {
        // healthy
    }

    let ram_trit = T_TRUE
    if3 ram_pct >= 85 {
        ram_trit = T_FALSE
    } else ram_pct >= 70 { ram_trit = T_MAYBE
    } else {
        // healthy
    }

    let gpu_trit = T_TRUE
    if3 gpu_pct >= 90 {
        gpu_trit = T_FALSE
    } else gpu_pct >= 70 { gpu_trit = T_MAYBE
    } else {
        // healthy
    }

    // Build per-channel trit map
    let trits = {}
    let ci = 0
    let healthy = 0
    let stressed = 0
    let neutral = 0
    let trit_string = ""
    while3 ci < len(FLOW_CHANNELS) {
        let ch = dict_get(FLOW_CHANNELS, ci)
        let ch_trit = T_TRUE
        // CPU/RAM bound channels
        if3 ch == "REASON" {
            ch_trit = ram_trit
        } else ch == "MATH" { ch_trit = ram_trit
        } else ch == "CODE" { ch_trit = ram_trit
        } else ch == "INSTRUCT" { ch_trit = ram_trit
        } else ch == "LONG" { ch_trit = ram_trit
        } else ch == "VISION" { ch_trit = gpu_trit
        } else ch == "AGENT" { ch_trit = gpu_trit
        } else ch == "GAME" { ch_trit = gpu_trit
        } else ch == "CREATIVE" { ch_trit = gpu_trit
        } else ch == "RETRIEVAL" { ch_trit = disk_trit
        } else ch == "KNOWLEDGE" { ch_trit = disk_trit
        } else ch == "FACT" { ch_trit = disk_trit
        } else ch == "SUMMARY" { ch_trit = disk_trit
        } else { ch_trit = T_TRUE
        }
        trits = dict_set(trits, ch, ch_trit)
        trit_string = trit_string + tchar(ch_trit)

        if3 ch_trit == T_TRUE {
            healthy = healthy + 1
        } else ch_trit == T_MAYBE { neutral = neutral + 1
        } else { stressed = stressed + 1
        }
        ci = ci + 1
    }

    let state = {}
    state = dict_set(state, "trits", trits)
    state = dict_set(state, "trit_string", trit_string)
    state = dict_set(state, "snapshot", snap)
    state = dict_set(state, "healthy", healthy)
    state = dict_set(state, "stressed", stressed)
    state = dict_set(state, "neutral", neutral)
    return state
}

// ================================================================
// TShell: Full Engine Status
// ================================================================

fn engine_status() {
    let sys_state = ternary_system_state()
    let idx_stats = index_stats()
    let uptime = 0
    if3 _engine_running == T_TRUE {
        uptime = round(time() - _start_time)
    } else {
        // not running
    }
    let watcher_stats = {}
    watcher_stats = dict_set(watcher_stats, "files_indexed", _watcher_files_indexed)
    watcher_stats = dict_set(watcher_stats, "files_compressed", _watcher_files_compressed)
    watcher_stats = dict_set(watcher_stats, "bytes_saved", _watcher_bytes_saved)
    watcher_stats = dict_set(watcher_stats, "bytes_saved_hr", human_size(_watcher_bytes_saved))
    watcher_stats = dict_set(watcher_stats, "scan_count", _watcher_scan_count)

    let sys_info = {}
    sys_info = dict_set(sys_info, "trit_string", dict_get(sys_state, "trit_string") ?? "")
    sys_info = dict_set(sys_info, "healthy", dict_get(sys_state, "healthy") ?? 0)
    sys_info = dict_set(sys_info, "stressed", dict_get(sys_state, "stressed") ?? 0)
    let snap = dict_get(sys_state, "snapshot") ?? {}
    sys_info = dict_set(sys_info, "disk", dict_get(snap, "disk") ?? {})
    sys_info = dict_set(sys_info, "ram", dict_get(snap, "ram") ?? {})
    sys_info = dict_set(sys_info, "gpu", dict_get(snap, "gpu") ?? {})

    let cfg_info = {}
    cfg_info = dict_set(cfg_info, "watch_dirs", _config_watch_dirs)
    cfg_info = dict_set(cfg_info, "auto_compress", _config_auto_compress)
    cfg_info = dict_set(cfg_info, "scan_interval", _config_scan_interval)

    let status = {}
    status = dict_set(status, "enabled", _engine_enabled)
    status = dict_set(status, "running", _engine_running)
    status = dict_set(status, "uptime", uptime)
    status = dict_set(status, "index", idx_stats)
    status = dict_set(status, "watcher", watcher_stats)
    status = dict_set(status, "system", sys_info)
    status = dict_set(status, "config", cfg_info)
    return status
}

// ================================================================
// NovaXCore: Command Safety Classifier
// ================================================================

fn classify_cmd_safety(cmd) {
    let cl = lower(trim(cmd))
    // Check dangerous first (most restrictive wins)
    let di = 0
    while3 di < len(DANGEROUS_CMDS) {
        let d = dict_get(DANGEROUS_CMDS, di)
        if3 starts_with(cl, d) {
            return T_FALSE
        } else {
            if3 contains(cl, d) {
                return T_FALSE
            } else {
                // continue
            }
        }
        di = di + 1
    }
    // Check uncertain
    let ui = 0
    while3 ui < len(UNCERTAIN_CMDS) {
        let u = dict_get(UNCERTAIN_CMDS, ui)
        if3 starts_with(cl, u) {
            return T_MAYBE
        } else {
            if3 contains(cl, u) {
                return T_MAYBE
            } else {
                // continue
            }
        }
        ui = ui + 1
    }
    // Check safe
    let si = 0
    while3 si < len(SAFE_CMDS) {
        let s = dict_get(SAFE_CMDS, si)
        if3 starts_with(cl, s) {
            return T_TRUE
        } else {
            if3 contains(cl, s) {
                return T_TRUE
            } else {
                // continue
            }
        }
        si = si + 1
    }
    // Unknown -> uncertain
    return T_MAYBE
}

// ================================================================
// NovaXCore: N-S Reynolds Prompt Router
// ================================================================

fn prompt_reynolds(prompt) {
    if3 len(trim(prompt)) == 0 {
        return {"Re": 0.0, "regime": "laminar", "trit": T_TRUE}
    } else {
        // proceed with analysis
    }

    let text = trim(prompt)
    let words = split(text, " ")
    let word_count = len(words)

    // -- Explicit directives override (check first) --
    let tl = lower(text)
    if3 starts_with(tl, "/local") {
        return {"Re": 1.0, "regime": "laminar", "trit": T_TRUE}
    } else starts_with(tl, "/ollama") {
        return {"Re": 1.0, "regime": "laminar", "trit": T_TRUE}
    } else starts_with(tl, "/llama") {
        return {"Re": 1.0, "regime": "laminar", "trit": T_TRUE}
    } else starts_with(tl, "/claude") {
        return {"Re": 400.0, "regime": "chaotic", "trit": T_FALSE}
    } else starts_with(tl, "/hivemind") {
        return {"Re": 400.0, "regime": "chaotic", "trit": T_FALSE}
    } else starts_with(tl, "/scatter") {
        return {"Re": 400.0, "regime": "chaotic", "trit": T_FALSE}
    } else {
        // no explicit directive, calculate Re
    }

    // -- rho: technical density --
    let rho = 1.0

    // Code pattern detection (use contains, not char-by-char)
    let code_hits = 0
    if3 contains(tl, "function ") {
        code_hits = code_hits + 1
    } else {
        // no
    }
    if3 contains(tl, "def ") {
        code_hits = code_hits + 1
    } else {
        // no
    }
    if3 contains(tl, "class ") {
        code_hits = code_hits + 1
    } else {
        // no
    }
    if3 contains(tl, "import ") {
        code_hits = code_hits + 1
    } else {
        // no
    }
    if3 contains(tl, "async ") {
        code_hits = code_hits + 1
    } else {
        // no
    }
    if3 contains(tl, "return ") {
        code_hits = code_hits + 1
    } else {
        // no
    }
    if3 contains(text, "```") {
        code_hits = code_hits + 2
        rho = rho + H5
    } else {
        // no code blocks
    }

    // Tech keywords (loop-based scan)
    let tech_kw = ["api", "docker", "kubernetes", "deploy", "server", "database", "sql", "algorithm", "architecture", "refactor", "debug", "analyze", "xrpl", "blockchain", "nova", "ternary", "reynolds", "navier", "python", "javascript", "rust", "java", "html", "css", "react", "nextjs", "flask", "node", "implement", "optimize", "integrate"]
    let tki = 0
    let tech_hits = 0
    while3 tki < len(tech_kw) {
        if3 contains(tl, tech_kw[tki]) {
            tech_hits = tech_hits + 1
        } else {
            // no match
        }
        tki = tki + 1
    }

    // Action verbs
    let action_kw = ["write", "create", "build", "design", "implement", "fix", "debug", "analyze", "explain", "compare", "evaluate", "refactor", "optimize", "deploy", "configure", "migrate", "transform", "parse", "validate"]
    let aki = 0
    let action_hits = 0
    while3 aki < len(action_kw) {
        if3 contains(tl, action_kw[aki]) {
            action_hits = action_hits + 1
        } else {
            // no match
        }
        aki = aki + 1
    }

    rho = rho + code_hits * H3 + tech_hits * 2.0 + action_hits * 1.5

    // Multi-task indicators
    let multi_kw = ["also", "and then", "additionally", "moreover", "plus"]
    let mki = 0
    let multi_hits = 0
    while3 mki < len(multi_kw) {
        if3 contains(tl, multi_kw[mki]) {
            multi_hits = multi_hits + 1
        } else {
            // no match
        }
        mki = mki + 1
    }
    rho = rho + multi_hits * 0.8

    // -- v: velocity (average word length / H3) --
    let total_wlen = 0
    let wi = 0
    while3 wi < word_count {
        total_wlen = total_wlen + len(words[wi])
        wi = wi + 1
    }
    let avg_wl = total_wlen / max(word_count, 1)
    let v = avg_wl / H3
    // Boost for code-like characters
    if3 contains(text, "(") {
        v = v * 1.5
    } else contains(text, "{") {
        v = v * 1.5
    } else contains(text, "=") { v = v * 1.5
    } else contains(text, "->") { v = v * 1.5
    } else {
        // no syntax boost
    }

    // -- L: length complexity proxy (0-10) --
    let text_len = len(text)
    if3 text_len > 2000 {
        text_len = 2000
    } else {
        // keep actual length
    }
    let L = text_len / 200.0

    // -- mu: viscosity (use contains for sentence detection) --
    let sent = 0
    if3 contains(text, ".") {
        sent = sent + 1
    } else {
        // none
    }
    if3 contains(text, "?") {
        sent = sent + 1
    } else {
        // none
    }
    if3 contains(text, "!") {
        sent = sent + 1
    } else {
        // none
    }
    if3 contains(text, ";") {
        sent = sent + 1
    } else {
        // none
    }
    let wps = word_count / max(sent, 1)
    let mu = wps / 15.0
    if3 mu < 0.15 {
        mu = 0.15
    } else mu > 2.0 { mu = 2.0
    } else {
        // in range
    }
    // Short prompts get extra viscosity
    if3 word_count < H5 {
        mu = mu * 2.0
    } else {
        // normal viscosity
    }

    // -- Reynolds number --
    let Re = (rho * v * L) / mu
    let Re_r = round(Re * 100) / 100

    // -- Classify by harmonic boundaries --
    if3 Re >= RE_TURBULENT {
        return {"Re": Re_r, "regime": "chaotic", "trit": T_FALSE}
    } else Re >= RE_TRANS {
        return {"Re": Re_r, "regime": "turbulent", "trit": T_FALSE}
    } else Re >= RE_LAMINAR {
        return {"Re": Re_r, "regime": "transitional", "trit": T_MAYBE}
    } else {
        return {"Re": Re_r, "regime": "laminar", "trit": T_TRUE}
    }
}

// ================================================================
// Flow Profile Cache (per-model N-S data from hivemind)
// ================================================================

let _flow_profiles = {}
let _flow_profiles_ts = 0
let _FLOW_PROFILE_TTL = 30

fn refresh_flow_profiles() {
    let now = time()
    let age = now - _flow_profiles_ts
    if3 age < _FLOW_PROFILE_TTL {
        return _flow_profiles
    } else {
        // cache stale, refresh
    }
    try3 {
        let raw = http_get("http://127.0.0.1:9881/hive/flow/profiles")
        let data = json_decode(raw)
        let ok = dict_get(data, "ok") ?? false
        if3 ok == true {
            _flow_profiles = dict_get(data, "profiles") ?? {}
            _flow_profiles_ts = now
        } else {
            // bad response, keep stale cache
    } else {
        // hivemind unreachable, keep stale cache
    }
    return _flow_profiles
}
}

fn select_best_local_model(regime) {
    let profs = refresh_flow_profiles()
    let best_name = "llama3"
    let best_score = -1
    let keys = dict_keys(profs)
    let ki = 0
    while3 ki < len(keys) {
        let name = dict_get(keys, ki) ?? ""
        let p = dict_get(profs, name) ?? {}
        let lat = dict_get(p, "avg_latency_ms") ?? 9999
        let qual = dict_get(p, "avg_quality") ?? 0
        let re_val = dict_get(p, "Re") ?? 0
        let queries = dict_get(p, "queries") ?? 0
        let capped_q = queries
        if3 capped_q > 50 {
            capped_q = 50
        } else {
            // keep
        }
        let safe_lat = lat
        if3 safe_lat < 1 {
            safe_lat = 1
        } else {
            // keep
        }
        let score = 0
        if3 regime == "laminar" {
            // Low latency + decent quality
            let score = (1000 / safe_lat) + qual * 10 + capped_q * 0.1
        } else {
            // Transitional: quality + Re
            let score = qual * 100 + re_val * 0.5 + (100 / safe_lat)
        }
        if3 score > best_score {
            best_score = score
            let best_name = name
        } else {
            // keep current best
        }
        ki = ki + 1
    }
    return best_name
}

fn select_hivemind_models(max_count) {
    let profs = refresh_flow_profiles()
    let scored = []
    let keys = dict_keys(profs)
    let ki = 0
    while3 ki < len(keys) {
        let name = dict_get(keys, ki) ?? ""
        let p = dict_get(profs, name) ?? {}
        let qual = dict_get(p, "avg_quality") ?? 0
        let re_val = dict_get(p, "Re") ?? 0
        let lat = dict_get(p, "avg_latency_ms") ?? 9999
        let safe_lat = lat / 1000
        if3 safe_lat < 0.1 {
            safe_lat = 0.1
        } else {
            // keep
        }
        let score = (qual * 50 + re_val * 0.3) / safe_lat
        scored = append(scored, {"name": name, "score": score})
        ki = ki + 1
    }
    // Simple selection sort for top N
    let selected = []
    let si = 0
    while3 si < max_count {
        if3 si >= len(scored) {
            // no more candidates
            return selected
        } else {
            // find max
        }
        let best_idx = 0
        let best_s = -1
        let bi = 0
        while3 bi < len(scored) {
            let item = scored[bi]
            let s = dict_get(item, "score") ?? 0
            if3 s > best_s {
                best_s = s
                let best_idx = bi
            } else {
                // keep
            }
            bi = bi + 1
        }
        let winner = scored[best_idx]
        selected = append(selected, dict_get(winner, "name") ?? "")
        // Mark as used by zeroing score
        winner = dict_set(winner, "score", -999)
        scored = dict_set(scored, best_idx, winner)
        si = si + 1
    }
    return selected
}

// ================================================================
// N-S Regime-Aware Timeout Scaling
// ================================================================
// Laminar:       H3 * H3 =  9s  (fast local model, predictable)
// Transitional:  H7 * H3 = 21s  (hivemind coordination overhead)
// Turbulent:     H13 * H3 = 39s (cloud API variable latency)
// Chaotic:       H13 * H5 = 65s (multi-provider scatter, worst-case)

let _timeout_stats = {}
_timeout_stats = dict_set(_timeout_stats, "laminar_calls", 0)
_timeout_stats = dict_set(_timeout_stats, "transitional_calls", 0)
_timeout_stats = dict_set(_timeout_stats, "turbulent_calls", 0)
_timeout_stats = dict_set(_timeout_stats, "chaotic_calls", 0)
_timeout_stats = dict_set(_timeout_stats, "timeout_failures", 0)

fn regime_timeout(regime) {
    if3 regime == "laminar" {
        _timeout_stats = dict_set(_timeout_stats, "laminar_calls", (dict_get(_timeout_stats, "laminar_calls") ?? 0) + 1)
        return H3 * H3
    } else regime == "transitional" { _timeout_stats = dict_set(_timeout_stats, "transitional_calls", (dict_get(_timeout_stats, "transitional_calls") ?? 0) + 1)
        return H7 * H3
    } else regime == "turbulent" { _timeout_stats = dict_set(_timeout_stats, "turbulent_calls", (dict_get(_timeout_stats, "turbulent_calls") ?? 0) + 1)
        return H13 * H3
    } else {
        // chaotic
        _timeout_stats = dict_set(_timeout_stats, "chaotic_calls", (dict_get(_timeout_stats, "chaotic_calls") ?? 0) + 1)
        return H13 * H5
    }
}

// ================================================================
// NovaXCore: Route to Backend (flow-profile-aware)
// ================================================================

fn route_to_backend(Re, regime, trit, prompt) {
    let t0 = time()
    let timeout_s = regime_timeout(regime)

    // Laminar -> select best local model via flow profiles
    if3 trit == T_TRUE {
        best_model = select_best_local_model("laminar")
        try3 {
            let payload = json_encode({"model": best_model, "prompt": prompt, "stream": false})
            let resp = http_post("http://127.0.0.1:11434/api/generate", payload, timeout_s)
            let data = json_decode(resp)
            let dur = round((time() - t0) * 1000)
            return {"text": dict_get(data, "response") ?? "", "model": dict_get(data, "model") ?? best_model, "source": "ollama", "Re": Re, "regime": regime, "trit": trit, "profile_selected": best_model, "duration_ms": dur, "timeout_s": timeout_s}
        } else {
            // Ollama failed, fall through to hivemind
    } else {
        // not laminar
    }

    // Transitional -> hivemind with profile-guided model selection
    if3 trit == T_MAYBE {
        preferred = select_hivemind_models(H7)
        try3 {
            let hive_payload = {"prompt": prompt, "channel": "auto", "max_models": H7}
            if3 len(preferred) > 0 {
                hive_payload = dict_set(hive_payload, "preferred_models", preferred)
            } else {
                // no preferences, let hivemind choose
            }
            let payload = json_encode(hive_payload)
            let resp = http_post("http://127.0.0.1:9881/hive/query", payload, timeout_s)
            let data = json_decode(resp)
            let dur = round((time() - t0) * 1000)
            let text_val = dict_get(data, "merged_response") ?? dict_get(data, "response") ?? dict_get(data, "text") ?? ""
            return {"text": text_val, "model": dict_get(data, "model") ?? "hivemind", "source": "hivemind", "Re": Re, "regime": regime, "trit": trit, "models_queried": dict_get(data, "models_queried") ?? 0, "profile_preferred": preferred, "duration_ms": dur, "timeout_s": timeout_s}
        } else {
            // hivemind failed, fall through to cloud
    } else {
        // not transitional
    }

    // Turbulent/Chaotic -> cloud router
    try3 {
        let payload = json_encode({"prompt": prompt, "provider": "auto"})
        let resp = http_post("http://127.0.0.1:9878/cloud/query", payload, timeout_s)
        let data = json_decode(resp)
        let dur = round((time() - t0) * 1000)
        let text_val = dict_get(data, "response") ?? dict_get(data, "text") ?? ""
        return {"text": text_val, "model": dict_get(data, "model") ?? "cloud", "source": "cloud-router", "Re": Re, "regime": regime, "trit": trit, "duration_ms": dur, "timeout_s": timeout_s}
    } else { _timeout_stats = dict_set(_timeout_stats, "timeout_failures", (dict_get(_timeout_stats, "timeout_failures") ?? 0) + 1)
        let dur = round((time() - t0) * 1000)
        return {"text": "All backends unreachable", "source": "none", "Re": Re, "regime": regime, "trit": trit, "error": true, "duration_ms": dur, "timeout_s": timeout_s}
    }
}

// ================================================================
// NovaXCore: Execute OS Command with Ternary Safety Gate
// ================================================================
}
}

fn core_exec(cmd, force, timeout_val) {
    let safety = classify_cmd_safety(cmd)

    // Block dangerous commands unless forced
    if3 safety == T_FALSE {
        if3 force == T_TRUE {
            // forced override
        } else force == true {
            // also accept boolean true
        } else { _core_stat_blocked = _core_stat_blocked + 1
            core_record("exec", cmd, T_FALSE, "BLOCKED: dangerous command")
            return {"trit": T_FALSE, "safety": T_FALSE, "blocked": true, "reason": "Dangerous command -- pass force=true to override", "cmd": cmd}
    } else {
        // not dangerous
    }

    _core_stat_exec = _core_stat_exec + 1
    try3 {
        let output = nova_run(cmd)
        let trit = T_TRUE
        if3 len(trim(output)) == 0 {
            trit = T_MAYBE
        } else {
            // has output = success
        }
        // Cap output at 5000 chars
        let stdout_val = output
        if3 len(output) > 5000 {
            stdout_val = slice(output, 0, 5000)
        } else {
            // keep full output
        }
        core_record("exec", cmd, trit, slice(output, 0, 200))
        return {"trit": trit, "safety": safety, "exit_code": 0, "stdout": stdout_val, "stderr": "", "cmd": cmd}
    } else {
        core_record("exec", cmd, T_FALSE, "execution failed")
        return {"trit": T_FALSE, "safety": safety, "error": "execution failed", "cmd": cmd}
    }
}

// ================================================================
// NovaXCore: Route (classify only)
// ================================================================
}

fn core_route(prompt) {
    _core_stat_route = _core_stat_route + 1
    let result = prompt_reynolds(prompt)
    let Re = dict_get(result, "Re") ?? 0
    let regime = dict_get(result, "regime") ?? "laminar"
    let trit = dict_get(result, "trit") ?? T_TRUE

    // Tripple: regime-aware routing — check if resonance suggests different target
    _tripple = tripple_outer(_tripple)
    let tripple_regime = dict_get(_tripple, "regime") ?? "laminar"
    let prime_locked = dict_get(_tripple, "prime_locked") ?? false

    let target = "local/ollama"
    if3 trit == T_MAYBE {
        target = "hivemind/balanced"
    } else trit == T_FALSE { target = "cloud/claude"
    } else {
        // laminar
    }

    core_record("route", slice(prompt, 0, 80), trit, "Re=" + str(Re) + " " + regime + " tripple=" + tripple_regime)
    prompt_re_record(prompt, Re, regime, trit, "route")
    return {"Re": Re, "regime": regime, "trit": trit, "target": target, "prompt_len": len(prompt), "tripple_regime": tripple_regime, "prime_locked": prime_locked}
}

// ================================================================
// NovaXCore: Query (route + execute)
// ================================================================

fn core_query(prompt, force_target) {
    _core_stat_query = _core_stat_query + 1
    let t0 = time()
    let result = prompt_reynolds(prompt)
    let Re = dict_get(result, "Re") ?? 0
    let regime = dict_get(result, "regime") ?? "laminar"
    let trit = dict_get(result, "trit") ?? T_TRUE

    // Force override
    if3 force_target == "local" {
        trit = T_TRUE
    } else force_target == "hivemind" { trit = T_MAYBE
    } else force_target == "cloud" { trit = T_FALSE
    } else force_target == "claude" { trit = T_FALSE
    } else {
        // no override
    }

    // Tripple: update regime awareness
    _tripple = tripple_outer(_tripple)

    let query_result = route_to_backend(Re, regime, trit, prompt)
    let source = dict_get(query_result, "source") ?? "?"
    let ok = dict_get(query_result, "ok") ?? false
    let latency = time() - t0

    // Tripple: fire ripple based on query outcome
    let provider_key = "local_ollama"
    if3 trit == T_MAYBE {
        provider_key = "hivemind"
    } else trit == T_FALSE { provider_key = "cloud_router"
    } else {
        // local
    }
    let ripple_trit = -1
    if3 ok == true { ripple_trit = 1 }
    _tripple = tripple_ripple(_tripple, provider_key, ripple_trit, latency)
    _tripple = tripple_resonance_check(_tripple)

    core_record("query", slice(prompt, 0, 80), trit, "-> " + source)
    prompt_re_record(prompt, Re, regime, trit, "query")
    return query_result
}

// ================================================================
// NovaXCore: Consensus (multi-model voting)
// ================================================================
// Send same prompt to N models via hivemind, score each response,
// vote on best using ternary quality scoring.

fn core_consensus(prompt, n_models, timeout_val) {
    _core_stat_consensus = _core_stat_consensus + 1
    let t0 = time()

    // Clamp n_models to [2, H13]
    if3 n_models < 2 {
        n_models = 2
    } else n_models > H13 { n_models = H13
    } else {
        // in range
    }

    if3 timeout_val == 0 {
        timeout_val = H13 * H5
    } else {
        // user provided
    }

    // Fan out via hivemind (wrapped in try3 for timeout safety)
    let hive_payload = {"prompt": prompt, "channel": "auto", "max_models": n_models, "return_all": true}
    let hive_resp = {}
    try3 {
        let hive_resp = http_post("http://127.0.0.1:9881/hive/query", hive_payload, timeout_val)
    } fail {
        core_record("consensus", slice(prompt, 0, 60), T_FALSE, "hivemind timeout/error: " + str(_error))
        return {"ok": false, "error": "Hivemind unreachable or timed out: " + str(_error), "trit": T_FALSE}
    } uncertain {
        // partial — use what we got
    }

    let raw = dict_get(hive_resp, "all_responses") ?? []
    if3 len(raw) == 0 {
        raw = dict_get(hive_resp, "responses") ?? []
    } else {
        // got all_responses
    }

    // If still empty, wrap merged response
    if3 len(raw) == 0 {
        merged = dict_get(hive_resp, "merged_response") ?? dict_get(hive_resp, "response") ?? ""
        if3 len(str(merged)) > 0 {
            raw = [{"model": dict_get(hive_resp, "model") ?? "hivemind", "response": merged, "ok": true, "time_ms": 0}]
        } else {
            core_record("consensus", slice(prompt, 0, 60), T_FALSE, "no responses")
            return {"ok": false, "error": "No model responses received", "trit": T_FALSE}
    } else {
        // have responses
    }

    // Score each response
    let votes = []
    let i = 0
    while3 i < len(raw) {
        let r = raw[i]
        i = i + 1
        let model_name = dict_get(r, "model") ?? "?"
        let resp_ok = dict_get(r, "ok") ?? false
        let resp_text = str(dict_get(r, "response") ?? "")

        if3 resp_ok == false {
            votes = votes + [{"model": model_name, "trit": T_FALSE, "score": 0, "reason": "failed", "response_len": 0}]
        } else len(resp_text) == 0 { votes = votes + [{"model": model_name, "trit": T_FALSE, "score": 0, "reason": "empty", "response_len": 0}]
        } else {
            // Score this response
            let words = split(resp_text, " ")
            let word_count = len(words)

            // Length quality scoring
            let len_score = 0.5
            if3 word_count < H5 {
                len_score = 0.2
            } else word_count < H13 { len_score = 0.5
            } else word_count < H13 * H7 { len_score = 1.0
            } else { len_score = 0.8
            }

            // Density: unique words ratio
            let unique_count = len(unique(words))
            let density_raw = float(unique_count) / float(max(word_count, 1))
            let density_score = min(density_raw * 1.5, 1.0)

            // Coherence: prompt keyword overlap
            let prompt_words = split(lower(prompt), " ")
            let overlap = 0
            let j = 0
            while3 j < len(prompt_words) {
                let pw = prompt_words[j]
                j = j + 1
                if3 contains(lower(resp_text), pw) {
                    overlap = overlap + 1
                } else {
                    // no match
                }
            } done3 {
                // done checking
            }
            let coherence_score = min(float(overlap) / float(max(len(prompt_words), 1)), 1.0)

            // Combined quality
            let quality = density_score * 0.4 + len_score * 0.3 + coherence_score * 0.3

            // Trit classification
            let vote_trit = T_MAYBE
            if3 quality > 0.667 {
                vote_trit = T_TRUE
            } else quality > 0.333 { vote_trit = T_MAYBE
            } else { vote_trit = T_FALSE
            }

            let time_ms = dict_get(r, "time_ms") ?? 0
            votes = votes + [{"model": model_name, "trit": vote_trit, "score": round(quality, 3), "density": round(density_score, 3), "length": round(len_score, 3), "coherence": round(coherence_score, 3), "response_len": word_count, "time_ms": time_ms}]
        }
    } done3 {
        // scoring complete
    }

    // Consensus vote via trit_majority
    let trits = []
    let k = 0
    while3 k < len(votes) {
        trits = trits + [dict_get(votes[k], "trit") ?? 0]
        k = k + 1
    } done3 {
        // collected trits
    }
    let consensus_trit = trit_majority(trits)

    // Find best response (highest score)
    let best_model = ""
    let best_score = -1
    let best_text = ""
    let m = 0
    while3 m < len(votes) {
        let v_score = dict_get(votes[m], "score") ?? 0
        if3 v_score > best_score {
            best_score = v_score
            let best_model = dict_get(votes[m], "model") ?? "?"
        } else {
            // not best
        }
        m = m + 1
    } done3 {
        // found best
    }

    // Get best response text
    let b = 0
    while3 b < len(raw) {
        if3 dict_get(raw[b], "model") ?? "" == best_model {
            best_text = str(dict_get(raw[b], "response") ?? "")
        } else {
            // not this one
        }
        b = b + 1
    } done3 {
        // found text
    }

    let elapsed_ms = int((time() - t0) * 1000)
    let consensus_char = "0"
    if3 consensus_trit == T_TRUE {
        consensus_char = "+"
    } else consensus_trit == T_FALSE { consensus_char = "-"
    } else { consensus_char = "0"
    }

    core_record("consensus", slice(prompt, 0, 60), consensus_trit, str(len(votes)) + " models, best=" + best_model)

    return {"ok": true, "consensus_trit": consensus_trit, "consensus_char": consensus_char, "best_model": best_model, "best_score": best_score, "best_response": best_text, "models_queried": len(votes), "votes": votes, "duration_ms": elapsed_ms, "trit": consensus_trit}
}
}

fn handle_core_consensus(req) {
    let prompt = dict_get(req, "prompt") ?? ""
    if3 len(prompt) == 0 {
        return {"error": "prompt required", "status": 400}
    } else {
        // proceed
    }
    let n_models = dict_get(req, "n_models") ?? dict_get(req, "n") ?? H5
    let timeout_val = dict_get(req, "timeout") ?? 0
    return core_consensus(prompt, n_models, timeout_val)
}

// ================================================================
// NovaXCore: Pipe (chain commands with ternary gates)
// ================================================================

fn core_pipe(commands) {
    _core_stat_pipe = _core_stat_pipe + 1
    let results = []
    let i = 0
    let aborted = T_FALSE
    let abort_at = -1
    while3 i < len(commands) {
        if3 aborted == T_FALSE {
            cmd = dict_get(commands, i)
            let r = core_exec(cmd, T_FALSE, 30)
            results = append(results, r)
            if3 dict_get(r, "trit") ?? 0 == T_FALSE {
                aborted = T_TRUE
                let abort_at = i
                core_record("pipe", "ABORT at step " + str(i) + ": " + slice(cmd, 0, 40), T_FALSE, "chain broken")
            } else {
                // continue chain
        } else {
            // already aborted
        }
        i = i + 1
    }

    if3 aborted == T_TRUE {
        return {"trit": T_FALSE, "completed": abort_at, "total": len(commands), "results": results, "aborted_at": abort_at}
    } else {
        // Check if all succeeded
        let all_ok = T_TRUE
        let ri = 0
        while3 ri < len(results) {
            if3 dict_get(dict_get(results, ri), "trit") ?? 0 != T_TRUE {
                all_ok = T_MAYBE
            } else {
                // ok
            }
            ri = ri + 1
        }
        core_record("pipe", str(len(commands)) + " commands", all_ok, "chain complete")
        return {"trit": all_ok, "completed": len(commands), "total": len(commands), "results": results}
    }
}

// ================================================================
// NovaXCore: Prompt Rewriting (N-S Laminarizer)
// Simplify/clarify prompts before routing to reduce Re
// ================================================================

let _rewrite_count = 0
}

fn prompt_rewrite(prompt) {
    _rewrite_count = _rewrite_count + 1
    let text = trim(prompt)
    let original_len = len(text)
    let changes = []

    // Get original Re for comparison
    let orig_re = prompt_reynolds(text)
    let orig_Re = dict_get(orig_re, "Re") ?? 0
    let orig_regime = dict_get(orig_re, "regime") ?? "laminar"

    // Rule 1: Strip filler phrases (reduces word count → lower Re)
    let rewritten = text
    let fillers = ["please ", "can you ", "could you ", "would you ", "i want you to ", "i need you to ", "i would like you to ", "kindly ", "just ", "basically ", "actually ", "literally ", "sort of ", "kind of "]
    let fi = 0
    while3 fi < len(fillers) {
        let filler = fillers[fi]
        let tl = lower(rewritten)
        if3 starts_with(tl, filler) {
            rewritten = slice(rewritten, len(filler), len(rewritten))
            let rewritten = trim(rewritten)
            changes = append(changes, "removed leading '" + filler + "'")
        } else {
            // no match
        }
        fi = fi + 1
    }

    // Rule 2: Capitalize first letter after rewrite
    if3 len(rewritten) > 0 {
        first = upper(slice(rewritten, 0, 1))
        let rest = slice(rewritten, 1, len(rewritten))
        let rewritten = first + rest
    } else {
        // empty
    }

    // Rule 3: Strip trailing filler
    let tl = lower(rewritten)
    if3 ends_with(tl, " please") {
        rewritten = slice(rewritten, 0, len(rewritten) - 7)
        let rewritten = trim(rewritten)
        changes = append(changes, "removed trailing 'please'")
    } else ends_with(tl, " thanks") { rewritten = slice(rewritten, 0, len(rewritten) - 7)
        let rewritten = trim(rewritten)
        changes = append(changes, "removed trailing 'thanks'")
    } else {
        // no trailing filler
    }

    // Rule 4: Collapse multiple spaces
    if3 contains(rewritten, "  ") {
        rewritten = replace(rewritten, "  ", " ")
        changes = append(changes, "collapsed double spaces")
    } else {
        // clean
    }

    // Rule 5: Strip "I have a question about " prefix
    let tl = lower(rewritten)
    if3 starts_with(tl, "i have a question about ") {
        rewritten = slice(rewritten, 24, len(rewritten))
        let rewritten = trim(rewritten)
        if3 len(rewritten) > 0 {
            first = upper(slice(rewritten, 0, 1))
            let rest = slice(rewritten, 1, len(rewritten))
            let rewritten = first + rest
        } else {
            // empty
        }
        changes = append(changes, "removed 'I have a question about'")
    } else {
        // no match
    }

    // Get new Re
    let new_re = prompt_reynolds(rewritten)
    let new_Re = dict_get(new_re, "Re") ?? 0
    let new_regime = dict_get(new_re, "regime") ?? "laminar"
    let Re_delta = orig_Re - new_Re

    return {
        "ok": true,
        "original": text,
        "rewritten": rewritten,
        "original_len": original_len,
        "rewritten_len": len(rewritten),
        "changes": changes,
        "change_count": len(changes),
        "original_Re": orig_Re,
        "original_regime": orig_regime,
        "rewritten_Re": new_Re,
        "rewritten_regime": new_regime,
        "Re_delta": Re_delta,
        "laminarized": new_Re < orig_Re,
        "trit": 1
    }
}

fn handle_core_rewrite(req) {
    let prompt = dict_get(req, "prompt") ?? ""
    if3 len(trim(prompt)) == 0 {
        return {"ok": false, "error": "prompt required", "trit": -1}
    } else {
        // proceed
    }
    return prompt_rewrite(prompt)
}

fn prompt_analyze(prompt) {
    // Detailed N-S factor breakdown for prompt debugging
    let text = trim(prompt)
    if3 len(text) == 0 {
        return { "ok": false, "error": "empty prompt", "trit": -1 }
    } else {
        // proceed
    }

    let words = split(text, " ")
    let word_count = len(words)
    let tl = lower(text)

    // === rho: density factors ===
    let code_hits = 0
    if3 contains(tl, "function ") { code_hits = code_hits + 1 } else { }
    if3 contains(tl, "def ") { code_hits = code_hits + 1 } else { }
    if3 contains(tl, "class ") { code_hits = code_hits + 1 } else { }
    if3 contains(tl, "import ") { code_hits = code_hits + 1 } else { }
    if3 contains(tl, "async ") { code_hits = code_hits + 1 } else { }
    if3 contains(tl, "return ") { code_hits = code_hits + 1 } else { }
    let has_code_block = contains(text, "```")

    let tech_kw = ["api", "docker", "kubernetes", "deploy", "server", "database", "sql", "algorithm", "architecture", "refactor", "debug", "analyze", "python", "javascript", "rust", "implement", "optimize"]
    let tki = 0
    let tech_hits = 0
    let tech_matched = []
    while3 tki < len(tech_kw) {
        let kw = tech_kw[tki]
        if3 contains(tl, kw) {
            tech_hits = tech_hits + 1
            tech_matched = append(tech_matched, kw)
        } else { }
        tki = tki + 1
    }

    let action_kw = ["write", "create", "build", "design", "implement", "fix", "debug", "analyze", "explain", "compare", "refactor", "optimize", "deploy", "validate"]
    let aki = 0
    let action_hits = 0
    let action_matched = []
    while3 aki < len(action_kw) {
        let kw = action_kw[aki]
        if3 contains(tl, kw) {
            action_hits = action_hits + 1
            action_matched = append(action_matched, kw)
        } else { }
        aki = aki + 1
    }

    let multi_kw = ["also", "and then", "additionally", "moreover", "plus"]
    let mki = 0
    let multi_hits = 0
    while3 mki < len(multi_kw) {
        if3 contains(tl, multi_kw[mki]) { multi_hits = multi_hits + 1 } else { }
        mki = mki + 1
    }

    let rho_base = 1.0
    let rho_code = code_hits * H3
    let rho_code_block = 0
    if3 has_code_block { rho_code_block = H5 } else { }
    let rho_tech = tech_hits * 2.0
    let rho_action = action_hits * 1.5
    let rho_multi = multi_hits * 0.8
    let rho = rho_base + rho_code + rho_code_block + rho_tech + rho_action + rho_multi

    // === v: velocity ===
    let total_wlen = 0
    let wi = 0
    while3 wi < word_count {
        total_wlen = total_wlen + len(words[wi])
        wi = wi + 1
    }
    let avg_wl = total_wlen / max(word_count, 1)
    let v_base = avg_wl / H3
    let v_syntax = 1.0
    if3 contains(text, "(") { v_syntax = 1.5 } else contains(text, "{") { v_syntax = 1.5 } else contains(text, "=") { v_syntax = 1.5 } else { }
    let v = v_base * v_syntax

    // === L: length ===
    let text_len = len(text)
    let L = min(text_len, 2000) / 200.0

    // === mu: viscosity ===
    let sent = 0
    if3 contains(text, ".") { sent = sent + 1 } else { }
    if3 contains(text, "?") { sent = sent + 1 } else { }
    if3 contains(text, "!") { sent = sent + 1 } else { }
    if3 contains(text, ";") { sent = sent + 1 } else { }
    let wps = word_count / max(sent, 1)
    let mu = max(min(wps / 15.0, 2.0), 0.15)
    let mu_short = 1.0
    if3 word_count < H5 { mu_short = 2.0 } else { }
    let mu_final = mu * mu_short

    // === Re ===
    let Re = (rho * v * L) / mu_final
    let Re_r = round(Re * 100) / 100

    // Regime
    let regime = "laminar"
    if3 Re >= RE_TURBULENT { regime = "chaotic" } else Re >= RE_TRANS { regime = "turbulent" } else Re >= RE_LAMINAR { regime = "transitional" } else { }

    // Dominant factor analysis
    let factors = [
        { "name": "density (rho)", "value": round(rho * 100) / 100, "contribution_pct": 0 },
        { "name": "velocity (v)", "value": round(v * 100) / 100, "contribution_pct": 0 },
        { "name": "length (L)", "value": round(L * 100) / 100, "contribution_pct": 0 },
        { "name": "viscosity (mu)", "value": round(mu_final * 100) / 100, "contribution_pct": 0 }
    ]

    // Contribution: how much each factor contributes
    // Re = rho * v * L / mu => each numerator factor proportional
    let numerator = rho * v * L
    if3 numerator > 0 {
        factors = [
            { "name": "density (rho)", "value": round(rho * 100) / 100, "contribution_pct": round(rho / numerator * Re * 100) },
            { "name": "velocity (v)", "value": round(v * 100) / 100, "contribution_pct": round(v / numerator * Re * 100) },
            { "name": "length (L)", "value": round(L * 100) / 100, "contribution_pct": round(L / numerator * Re * 100) },
            { "name": "viscosity (mu)", "value": round(mu_final * 100) / 100, "contribution_pct": 0, "note": "denominator (lower = more turbulent)" }
        ]
    } else { }

    return {
        "ok": true,
        "prompt_preview": slice(text, 0, 80),
        "word_count": word_count,
        "char_count": len(text),
        "Re": Re_r,
        "regime": regime,
        "factors": {
            "rho": { "total": round(rho * 100) / 100, "base": rho_base, "code_patterns": rho_code, "code_blocks": rho_code_block, "tech_keywords": rho_tech, "action_verbs": rho_action, "multi_task": rho_multi },
            "v": { "total": round(v * 100) / 100, "avg_word_len": round(avg_wl * 10) / 10, "base": round(v_base * 100) / 100, "syntax_mult": v_syntax },
            "L": { "total": round(L * 100) / 100, "char_count": len(text), "capped_at": 2000 },
            "mu": { "total": round(mu_final * 100) / 100, "sentences": sent, "words_per_sentence": round(wps * 10) / 10, "base": round(mu * 100) / 100, "short_prompt_mult": mu_short }
        },
        "factor_summary": factors,
        "matched_keywords": { "code_patterns": code_hits, "tech": tech_matched, "action": action_matched, "multi_task": multi_hits },
        "formula": "Re = (rho * v * L) / mu = (" + str(round(rho * 100) / 100) + " * " + str(round(v * 100) / 100) + " * " + str(round(L * 100) / 100) + ") / " + str(round(mu_final * 100) / 100) + " = " + str(Re_r),
        "boundaries": { "laminar": "< " + str(RE_LAMINAR), "transitional": str(RE_LAMINAR) + "-" + str(RE_TRANS), "turbulent": str(RE_TRANS) + "-" + str(RE_TURBULENT), "chaotic": "> " + str(RE_TURBULENT) },
        "trit": 1
    }
}

fn handle_core_analyze(req) {
    let prompt = dict_get(req, "prompt") ?? ""
    if3 len(trim(prompt)) == 0 {
        return {"ok": false, "error": "prompt required", "trit": -1}
    } else {
        // proceed
    }
    let result = prompt_analyze(prompt)
    let Re = dict_get(result, "Re") ?? 0
    let regime = dict_get(result, "regime") ?? "laminar"
    let trit = dict_get(result, "trit") ?? 0
    prompt_re_record(prompt, Re, regime, trit, "analyze")
    return result
}

// ================================================================
// NovaXCore: Env (read env var with safety filter)
// ================================================================

fn core_env(key_name) {
    let uk = upper(key_name)
    let blocked_patterns = ["PASSWORD", "SECRET", "TOKEN", "KEY", "CREDENTIAL", "AUTH"]
    let bi = 0
    let is_blocked = T_FALSE
    while3 bi < len(blocked_patterns) {
        if3 contains(uk, dict_get(blocked_patterns, bi)) {
            is_blocked = T_TRUE
        } else {
            // not this pattern
        }
        bi = bi + 1
    }

    if3 is_blocked == T_TRUE {
        return {"trit": T_FALSE, "key": key_name, "blocked": true, "reason": "Env var name matches blocked pattern"}
    } else {
        // safe to read
    }

    // Read via nova_run
    try3 {
        let val = nova_run("cmd /c echo %" + key_name + "%")
        let val = trim(val)
        if3 val == "%" + key_name + "%" {
            // Not set (Windows echoes the raw %VAR% if not defined)
            return {"trit": T_MAYBE, "key": key_name, "value": "", "reason": "not set"}
        } else {
            return {"trit": T_TRUE, "key": key_name, "value": val}
    } else {
        return {"trit": T_FALSE, "key": key_name, "error": "could not read env var"}
    }
}

// ================================================================
// NovaXCore: Proc (process management)
// ================================================================
}

fn core_proc(action, proc_name) {
    if3 action == "list" {
        r = core_exec("tasklist /FO CSV /NH", T_TRUE, 30)
        if3 dict_get(r, "trit") ?? 0 >= 0 {
            stdout = dict_get(r, "stdout") ?? ""
            let lines = split(trim(stdout), "\n")
            let procs = []
            let li = 0
            let count = 0
            while3 li < len(lines) {
                if3 li < 100 {
                    line = trim(dict_get(lines, li))
                    if3 len(line) > 0 {
                        parts = split(replace(line, "\"", ""), ","))
                        if3 len(parts) >= 2 {
                            proc_entry = {}
                            proc_entry = dict_set(proc_entry, "name", trim(dict_get(parts, 0)))
                            proc_entry = dict_set(proc_entry, "pid", trim(dict_get(parts, 1)))
                            if3 count < 50 {
                                procs = append(procs, proc_entry)
                            } else {
                                // cap at 50
                            }
                            count = count + 1
                        } else {
                            // not enough parts
                    } else {
                        // empty line
                } else {
                    // past 100 line cap
                }
                li = li + 1
            }
            return {"trit": T_TRUE, "count": count, "processes": procs}
        } else {
            return {"trit": T_MAYBE, "error": "could not list processes"}
        }
    } else action == "find" {
        if3 len(proc_name) > 0 {
            r = core_exec("tasklist /FI \"IMAGENAME eq " + proc_name + "\" /FO CSV /NH", T_TRUE, 30)
            if3 dict_get(r, "trit") ?? 0 >= 0 {
                return {"trit": T_TRUE, "stdout": dict_get(r, "stdout") ?? ""}
            } else {
                return {"trit": T_FALSE, "error": "not found"}
        } else {
            return {"trit": T_MAYBE, "error": "name required for find action"}
    } else {
        return {"trit": T_MAYBE, "error": "unknown action: " + str(action)}
    }
}

// ================================================================
// NovaXCore: Net (HTTP request with ternary firewall)
// ================================================================
}
}
}
}

fn core_net(url, method_name, timeout_val) {
    // Block dangerous hosts
    let blocked_hosts = ["169.254.169.254", "metadata.google", "metadata.aws"]
    let bhi = 0
    let host_blocked = T_FALSE
    while3 bhi < len(blocked_hosts) {
        if3 contains(url, dict_get(blocked_hosts, bhi)) {
            host_blocked = T_TRUE
        } else {
            // not this host
        }
        bhi = bhi + 1
    }

    if3 host_blocked == T_TRUE {
        return {"trit": T_FALSE, "blocked": true, "reason": "blocked host"}
    } else {
        // host is allowed
    }

    // Validate scheme
    if3 starts_with(url, "http://") {
        // ok
    } else starts_with(url, "https://") {
        // ok
    } else {
        return {"trit": T_FALSE, "blocked": true, "reason": "invalid scheme"}
    }

    try3 {
        let resp = http_get(url)
        let body = resp
        if3 len(body) > 5000 {
            body = slice(body, 0, 5000)
        } else {
            // keep full body
        }
        return {"trit": T_TRUE, "status": 200, "url": url, "size": len(resp), "body": body}
    } else {
        return {"trit": T_FALSE, "url": url, "error": "request failed"}
    }
}

