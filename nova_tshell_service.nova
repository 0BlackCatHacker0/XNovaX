    }
    let force = dict_get(req, "force") ?? T_FALSE
    let timeout_val = dict_get(req, "timeout") ?? 30
    return core_exec(cmd, force, timeout_val)
}

fn handle_core_timeouts(req) {
    return {
        "ok": true,
        "timeouts": {
            "laminar_s": H3 * H3,
            "transitional_s": H7 * H3,
            "turbulent_s": H13 * H3,
            "chaotic_s": H13 * H5
        },
        "harmonics_used": {
            "laminar": "H3 * H3 = " + str(H3 * H3),
            "transitional": "H7 * H3 = " + str(H7 * H3),
            "turbulent": "H13 * H3 = " + str(H13 * H3),
            "chaotic": "H13 * H5 = " + str(H13 * H5)
        },
        "stats": _timeout_stats,
        "trit": 1
    }
}

fn handle_core_reynolds_explain(req) {
    let prompt = dict_get(req, "prompt") ?? "test prompt"
    let text = trim(prompt)
    let words = split(text, " ")
    let word_count = len(words)

    // -- rho (simplified: skip char-by-char, use contains) --
    let rho = 1.0
    let tech_kw = ["api", "docker", "kubernetes", "deploy", "server", "database", "sql", "algorithm", "architecture", "refactor", "debug", "analyze", "python", "javascript", "rust", "flask", "implement", "optimize"]
    let tki = 0
    let tech_hits = 0
    while3 tki < len(tech_kw) {
        if3 contains(lower(text), tech_kw[tki]) {
            tech_hits = tech_hits + 1
        } else {
            // no match
        }
        tki = tki + 1
    }

    let action_kw = ["write", "create", "build", "design", "implement", "fix", "debug", "analyze", "explain", "compare"]
    let aki = 0
    let action_hits = 0
    while3 aki < len(action_kw) {
        if3 contains(lower(text), action_kw[aki]) {
            action_hits = action_hits + 1
        } else {
            // no match
        }
        aki = aki + 1
    }

    let code_hits = 0
    if3 contains(lower(text), "function ") {
        code_hits = code_hits + 1
    } else {
        // no
    }
    if3 contains(lower(text), "def ") {
        code_hits = code_hits + 1
    } else {
        // no
    }
    if3 contains(lower(text), "class ") {
        code_hits = code_hits + 1
    } else {
        // no
    }
    if3 contains(text, "```") {
        code_hits = code_hits + 2
        rho = rho + H5
    } else {
        // no code blocks
    }

    rho = rho + code_hits * H3 + tech_hits * 2.0 + action_hits * 1.5

    // -- v: velocity --
    let total_wlen = 0
    let wi = 0
    while3 wi < word_count {
        total_wlen = total_wlen + len(words[wi])
        wi = wi + 1
    }
    let avg_wl = total_wlen / max(word_count, 1)
    let v = avg_wl / H3
    if3 contains(text, "(") {
        v = v * 1.5
    } else contains(text, "{") {
        v = v * 1.5
    } else contains(text, "=") { v = v * 1.5
    } else {
        // no boost
    }

    // -- L: length --
    let tl = len(text)
    if3 tl > 2000 {
        tl = 2000
    } else {
        // keep
    }
    let L = tl / 200.0

    // -- mu: viscosity (use contains not charloop) --
    let sent = 0
    if3 contains(text, ".") {
        sent = sent + 1
    } else {
        // none
    }
    if3 contains(text, "?") {
        sent = sent + 1
    } else {
        // none
    }
    if3 contains(text, "!") {
        sent = sent + 1
    } else {
        // none
    }
    let wps = word_count / max(sent, 1)
    let mu = wps / 15.0
    if3 mu < 0.15 {
        mu = 0.15
    } else mu > 2.0 { mu = 2.0
    } else {
        // ok
    }
    if3 word_count < H5 {
        mu = mu * 2.0
    } else {
        // normal
    }

    // -- Reynolds --
    let Re = (rho * v * L) / mu
    let Re_r = round(Re * 100) / 100

    // -- Classify --
    let regime = "laminar"
    let trit = T_TRUE
    if3 Re >= RE_TURBULENT {
        regime = "chaotic"
        let trit = T_FALSE
    } else Re >= RE_TRANS { regime = "turbulent"
        let trit = T_FALSE
    } else Re >= RE_LAMINAR { regime = "transitional"
        let trit = T_MAYBE
    } else {
        // laminar
    }

    return {
        "debug": true,
        "prompt_len": len(text),
        "word_count": word_count,
        "rho": rho,
        "v": v,
        "L": L,
        "mu": mu,
        "Re": Re_r,
        "regime": regime,
        "trit": trit,
        "tech_hits": tech_hits,
        "action_hits": action_hits,
        "code_hits": code_hits
    }
}

