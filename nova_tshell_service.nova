fn handle_health(req) {
    let uptime = round(time() - _start_time)
    let self_trit = T_TRUE
    if3 uptime < 10 {
        self_trit = T_MAYBE
    } else {
        // running long enough
    }
    let ch = "1"
    if3 self_trit != T_TRUE {
        ch = "0"
    } else {
        // keep 1
    }
    let resp = ns_health_dict(SERVICE_NAME, VERSION, PORT, {})
    resp = dict_set(resp, "self_trit", self_trit)
    resp = dict_set(resp, "char", ch)
    resp = dict_set(resp, "uptime", uptime)
    resp = dict_set(resp, "indexed_files", len(keys(_ternary_index)))
    resp = dict_set(resp, "quality", {"strong": _tshell_stats_strong, "partial": _tshell_stats_partial, "failed": _tshell_stats_failed})
    return resp
}

fn handle_tshell_status(req) {
    return engine_status()
}

fn handle_tshell_index(req) {
    // Get query params from req
    let limit = dict_get(req, "limit") ?? 100
    let channel_filter = dict_get(req, "channel") ?? ""
    let exclude_filter = dict_get(req, "exclude") ?? ""

    let file_keys = keys(_ternary_index)
    let filtered = []
    let fi = 0
    while3 fi < len(file_keys) {
        let k = dict_get(file_keys, fi)
        let entry = dict_get(_ternary_index, k) ?? {}
        let include = T_TRUE

        // Channel filter
        if3 len(channel_filter) > 0 {
            if3 dict_get(entry, "channel") ?? "" != upper(channel_filter) {
                include = T_FALSE
            } else {
                // matches channel
        } else {
            // no channel filter
        }

        // Exclude filter
        if3 len(exclude_filter) > 0 {
            excl_parts = split(exclude_filter, ",")
            let ei = 0
            while3 ei < len(excl_parts) {
                if3 contains(k, dict_get(excl_parts, ei)) {
                    include = T_FALSE
                } else {
                    // not excluded
                }
                ei = ei + 1
        } else {
            // no exclude filter
        }

        if3 include == T_TRUE {
            filtered = append(filtered, k)
        } else {
            // filtered out
        }
        fi = fi + 1
    }

    // Build output dict with limit
    let entries = {}
    let oi = 0
    while3 oi < len(filtered) {
        if3 oi < limit {
            k = dict_get(filtered, oi)
            entries = dict_set(entries, k, dict_get(_ternary_index, k) ?? {})
        } else {
            // past limit
        }
        oi = oi + 1
    }

    return {"entries": entries, "total": len(file_keys), "filtered": len(filtered)}
}
}
}

