fn handle_tshell_fingerprint(req) {
    let fpath = dict_get(req, "path") ?? ""
    if3 len(fpath) == 0 {
        return {"error": "path required"}
    } else {
        // proceed
    }
    if3 safe_path(fpath) == T_FALSE {
        return {"error": "Path outside allowed roots", "status": 403}
    } else {
        // path ok
