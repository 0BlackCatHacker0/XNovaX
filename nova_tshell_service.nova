fn handle_tshell_scan(req) {
    let count = watcher_tick()
    return {"scanning": true, "dirs": _config_watch_dirs, "files_indexed": count}
}

fn handle_tshell_compress(req) {
    let target = dict_get(req, "path") ?? ""
    if3 len(target) == 0 {
        return {"error": "path required", "status": 400}
    } else {
        // proceed
    }
    if3 safe_path(target) == T_FALSE {
        return {"error": "Path outside allowed roots", "status": 403}
    } else {
        // path ok
    }
    // Delegate compression to tzip service
    try3 {
        let payload = json_encode({"path": target})
        let resp = http_post("http://127.0.0.1:9885/tzip/compress", payload)
        let result = json_decode(resp)
        return result
    } else {
        return {"error": "tzip service unavailable"}
    }
}

fn handle_tshell_decompress(req) {
    let target = dict_get(req, "path") ?? ""
    let out = dict_get(req, "output") ?? ""
    if3 len(target) == 0 {
        return {"error": "path required", "status": 400}
    } else {
        // proceed
    }
    if3 safe_path(target) == T_FALSE {
        return {"error": "Path outside allowed roots", "status": 403}
    } else {
        // path ok
    }
    if3 len(out) > 0 {
        if3 safe_path(out) == T_FALSE {
            return {"error": "Output path outside allowed roots", "status": 403}
        } else {
            // output path ok
    } else {
        // no output path
    }
    // Delegate decompression to tzip service
    try3 {
        let payload = json_encode({"path": target, "output": out})
        let resp = http_post("http://127.0.0.1:9885/tzip/decompress", payload)
        let result = json_decode(resp)
        return result
    } else {
        return {"error": "tzip service unavailable"}
    }
}
}

fn handle_tshell_watch(req) {
    let new_dir = dict_get(req, "directory") ?? ""
    if3 len(new_dir) == 0 {
        return {"error": "valid directory required", "status": 400}
    } else {
        // proceed
    }
    if3 safe_path(new_dir) == T_FALSE {
        return {"error": "Path outside allowed roots", "status": 403}
    } else {
        // path ok
    }
    // Check if already in watch list
    let already = T_FALSE
    let wi = 0
    while3 wi < len(_config_watch_dirs) {
        if3 dict_get(_config_watch_dirs, wi) == new_dir {
            already = T_TRUE
        } else {
            // not this one
        }
        wi = wi + 1
    }
    if3 already == T_FALSE {
        _config_watch_dirs = append(_config_watch_dirs, new_dir)
        save_config()
    } else {
        // already watching
    }
    return {"added": new_dir, "watch_dirs": _config_watch_dirs}
}

fn handle_tshell_unwatch(req) {
    let rm_dir = dict_get(req, "directory") ?? ""
    let new_list = []
    let wi = 0
    while3 wi < len(_config_watch_dirs) {
        let d = dict_get(_config_watch_dirs, wi)
        if3 d != rm_dir {
            new_list = append(new_list, d)
        } else {
            // remove this one
        }
        wi = wi + 1
    }
    _config_watch_dirs = new_list
    save_config()
    return {"watch_dirs": _config_watch_dirs}
}

fn handle_tshell_toggle(req) {
    if3 _engine_enabled == T_TRUE {
        _engine_enabled = T_FALSE
    } else { _engine_enabled = T_TRUE
    }
    return {"enabled": _engine_enabled}
}

fn handle_tshell_toggle_compress(req) {
    if3 _config_auto_compress == T_TRUE {
        _config_auto_compress = T_FALSE
    } else { _config_auto_compress = T_TRUE
    }
    save_config()
    return {"auto_compress": _config_auto_compress}
}

fn handle_tshell_config_post(req) {
    if3 dict_has(req, "scan_interval") {
        _config_scan_interval = dict_get(req, "scan_interval")
    } else {
        // no change
    }
    if3 dict_has(req, "max_depth") {
        _config_max_depth = dict_get(req, "max_depth")
    } else {
        // no change
    }
    if3 dict_has(req, "max_file_size") {
        _config_max_file_size = dict_get(req, "max_file_size")
    } else {
        // no change
    }
    if3 dict_has(req, "auto_compress") {
        _config_auto_compress = dict_get(req, "auto_compress")
    } else {
        // no change
    }
    if3 dict_has(req, "monitor_interval") {
        _config_monitor_interval = dict_get(req, "monitor_interval")
    } else {
        // no change
    }
    save_config()
    return get_config_dict()
}

fn handle_tshell_watch_tick(req) {
    // On-demand watcher tick (replaces threading)
    let count = watcher_tick()
    return {"trit": T_TRUE, "tick": "complete", "files_indexed": count, "scan_count": _watcher_scan_count}
}

fn handle_core_exec(req) {
    let cmd = dict_get(req, "command") ?? dict_get(req, "cmd") ?? ""
    if3 len(cmd) == 0 {
        return {"error": "command required", "status": 400}
    } else {
