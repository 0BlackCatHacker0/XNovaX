    let fp = index_get(fpath)
    if3 len(keys(fp)) > 0 {
        return fp
    } else {
        return {"error": "not indexed", "status": 404}
    }
}

fn handle_core_status_get(req) {
    let cs = core_status()
    let result = {"service": "NovaXCore", "version": "1.0", "ternary": true, "replaces": "OpenClaw"}
    result = dict_set(result, "stats", dict_get(cs, "stats") ?? {})
    result = dict_set(result, "history_len", dict_get(cs, "history_len") ?? 0)
    result = dict_set(result, "last_5", dict_get(cs, "last_5") ?? [])
    return result
}

