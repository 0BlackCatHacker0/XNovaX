// ================================================================
// Tripple Module Handlers (resonance sensor for NovaXCore)
// ================================================================

fn handle_core_tripple_status(req) {
    _tripple = tripple_outer(_tripple)
    _tripple = tripple_resonance_check(_tripple)
    let status = tripple_status(_tripple)
    let result = {"ok": true, "trit": 1, "service": "novacore"}
    result = dict_set(result, "resonance_score", dict_get(status, "resonance_score") ?? 0)
    result = dict_set(result, "regime", dict_get(status, "regime") ?? "laminar")
    result = dict_set(result, "prime_locked", dict_get(status, "prime_locked") ?? false)
    result = dict_set(result, "hyper_locked", dict_get(status, "hyper_locked") ?? false)
    result = dict_set(result, "total_ripples", dict_get(status, "total_ripples") ?? 0)
    result = dict_set(result, "providers", dict_get(status, "providers") ?? {})
    result = dict_set(result, "formula", dict_get(status, "formula") ?? {})
    return result
}

fn handle_core_tripple_wave(req) {
    let wave = tripple_standing_wave(_tripple)
    return {"ok": true, "trit": 1, "wave": wave}
}

fn handle_core_tripple_mirror(req) {
    let mirror = tripple_mirror_status(_tripple)
    return {"ok": true, "trit": 1, "mirror": mirror}
}

fn handle_core_tripple_ripple(req) {
    let body = try3 { json_decode(req["body"]) } fail { req }
    let provider = dict_get(body, "provider") ?? "local_ollama"
    let trit = dict_get(body, "trit") ?? 1
    let latency = dict_get(body, "latency_ms") ?? 100
    _tripple = tripple_ripple(_tripple, provider, trit, latency)
    _tripple = tripple_resonance_check(_tripple)
    let score = dict_get(_tripple, "resonance_score") ?? 0
    return {"ok": true, "trit": 1, "provider": provider, "ripple_trit": trit, "resonance_score": score}
}

