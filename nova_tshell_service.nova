    let limit = dict_get(req, "limit") ?? 20
    return {"history": core_get_history(limit)}
}

fn handle_core_flow_profiles(req) {
    let profs = refresh_flow_profiles()
    let age = time() - _flow_profiles_ts
    let best_local = select_best_local_model("laminar")
    let best_hive = select_hivemind_models(H5)
    return {
        "ok": true,
        "profiles": profs,
        "total": len(dict_keys(profs)),
        "cache_age_s": round(age),
        "ttl_s": _FLOW_PROFILE_TTL,
        "best_local": best_local,
        "best_transitional": best_hive,
        "trit": T_TRUE,
        "runtime": "novalang"
    }
}

