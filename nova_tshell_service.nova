// ================================================================
// Helper Functions
// ================================================================

// -- Human-readable file size --
fn human_size(n) {
    if3 abs(n) < 1024 {
        return str(round(n * 10) / 10) + " B"
    } else abs(n) < 1048576 {
        return str(round(n / 1024 * 10) / 10) + " KB"
    } else abs(n) < 1073741824 {
        return str(round(n / 1048576 * 10) / 10) + " MB"
    } else abs(n) < 1099511627776 {
        return str(round(n / 1073741824 * 10) / 10) + " GB"
    } else {
        return str(round(n / 1099511627776 * 10) / 10) + " TB"
    }
}

// -- Check if path is within safe roots --
fn safe_path(p) {
    let pl = lower(replace(p, "\\", "/"))
    let i = 0
    let found = T_FALSE
    while3 i < len(SAFE_ROOTS) {
        let root = lower(dict_get(SAFE_ROOTS, i))
        if3 starts_with(pl, root) {
            found = T_TRUE
        } else {
            // not this root
        }
        i = i + 1
    }
    return found
}

// -- Get file extension from path --
fn get_ext(path) {
    let parts = split(path, ".")
    if3 len(parts) < 2 {
        return ""
    } else {
        return "." + lower(dict_get(parts, len(parts) - 1))
    }
}

// -- Get file channel from extension --
fn get_channel(ext) {
    if3 dict_has(FILE_CHANNEL_MAP, ext) {
        return dict_get(FILE_CHANNEL_MAP, ext) ?? "DOMAIN"
    } else {
        return "DOMAIN"
    }
}

// -- Check if extension should skip compression --
fn should_skip_compress(ext) {
    let i = 0
    while3 i < len(SKIP_COMPRESS) {
        if3 dict_get(SKIP_COMPRESS, i) == ext {
            return T_TRUE
        } else {
            // continue
        }
        i = i + 1
    }
    return T_FALSE
}

// -- Trit character for display --
fn tchar(t) {
    if3 t == T_TRUE {
        return "P"
    } else t == T_MAYBE {
        return "Z"
    } else {
        return "N"
    }
}

// -- Record core history entry (cap at 100) --
fn core_record(op, cmd, trit, detail) {
    let entry = {}
    entry = dict_set(entry, "op", op)
    entry = dict_set(entry, "cmd", cmd)
    entry = dict_set(entry, "trit", trit)
    entry = dict_set(entry, "detail", detail)
    entry = dict_set(entry, "ts", time())
    _core_history = append(_core_history, entry)
    if3 len(_core_history) > 100 {
        _core_history = slice(_core_history, len(_core_history) - 100, len(_core_history))
    } else {
        // under limit
    }
}

// -- Record prompt Re into history for trend tracking --
fn prompt_re_record(prompt, Re, regime, trit, source) {
    let preview = slice(str(prompt), 0, 60)
    let entry = {
        "ts": time(),
        "prompt_preview": preview,
        "Re": Re,
        "regime": regime,
        "trit": trit,
        "source": source
    }
    _prompt_re_history = append(_prompt_re_history, entry)
    // Cap at H13*H7 = 91
    if3 len(_prompt_re_history) > 91 {
        _prompt_re_history = slice(_prompt_re_history, len(_prompt_re_history) - 91, len(_prompt_re_history))
    }
    // Update rolling stats
    let total = (dict_get(_prompt_re_stats, "total") ?? 0) + 1
    _prompt_re_stats = dict_set(_prompt_re_stats, "total", total)
    let cur_avg = dict_get(_prompt_re_stats, "avg_Re") ?? 0
    // Exponential moving average (alpha = 1/H3)
    let new_avg = cur_avg * (1 - 1/3) + Re * (1/3)
    _prompt_re_stats = dict_set(_prompt_re_stats, "avg_Re", round(new_avg * 100) / 100)
    if3 Re > dict_get(_prompt_re_stats, "max_Re") ?? 0 {
        _prompt_re_stats = dict_set(_prompt_re_stats, "max_Re", round(Re * 100) / 100)
    }
    if3 Re < dict_get(_prompt_re_stats, "min_Re") ?? 9999 {
        _prompt_re_stats = dict_set(_prompt_re_stats, "min_Re", round(Re * 100) / 100)
    }
    // Update regime counts
    let rc = dict_get(_prompt_re_stats, "regime_counts") ?? {}
    let cur = dict_get(rc, regime) ?? 0
    rc = dict_set(rc, regime, cur + 1)
    _prompt_re_stats = dict_set(_prompt_re_stats, "regime_counts", rc)
}

fn handle_prompt_history(req) {
    // GET /core/prompt-history — Return prompt Re history + trend analysis
    let limit = dict_get(req, "limit") ?? 50
    let hist = _prompt_re_history
    let total = len(hist)
    if3 total > limit {
        hist = slice(hist, total - limit, total)
    }

    // Compute trend: compare avg of recent H7 vs all
    let trend = "stable"
    let trend_trit = 0
    if3 total >= 7 {
        let recent = slice(_prompt_re_history, total - 7, total)
        let recent_sum = 0
        for3 r in recent {
            recent_sum = recent_sum + dict_get(r, "Re") ?? 0
        }
        let recent_avg = recent_sum / 7
        let overall_avg = dict_get(_prompt_re_stats, "avg_Re") ?? 0
        if3 recent_avg > overall_avg * 1.2 {
            trend = "increasing"
            let trend_trit = 1
        } else3 {
            if3 recent_avg < overall_avg * 0.8 {
                trend = "decreasing"
                let trend_trit = -1
            }
        }
    }

    return {
        "ok": true,
        "history": hist,
        "total_logged": total,
        "stats": _prompt_re_stats,
        "trend": trend,
        "trend_trit": trend_trit,
        "trit": 1
    }
}

// ================================================================
// POST /core/prompt-history/search — Search prompt Re history
// Filters: keyword (in prompt_preview), regime, min_re, max_re, source, trit
// ================================================================
fn handle_prompt_history_search(body) {
    let keyword = dict_get(body, "keyword") ?? ""
    let regime_filter = dict_get(body, "regime") ?? ""
    let min_re = dict_get(body, "min_re") ?? -1
    let max_re = dict_get(body, "max_re") ?? 99999
    let source_filter = dict_get(body, "source") ?? ""
    let trit_filter = dict_get(body, "trit") ?? null
    let limit = dict_get(body, "limit") ?? 50

    let results = []
    let scanned = 0
    for3 entry in _prompt_re_history {
        scanned = scanned + 1
        let matched = true

        // Keyword filter (case-insensitive via contains on lowered)
        if3 keyword != "" {
            let preview = dict_get(entry, "prompt_preview") ?? ""
            if3 contains(lower(preview), lower(keyword)) == false {
                matched = false
            }
        }

        // Regime filter
        if3 matched == true {
            if3 regime_filter != "" {
                if3 dict_get(entry, "regime") ?? "" != regime_filter {
                    matched = false
                }
            }
        }

        // Re range filter
        if3 matched == true {
            let re_val = dict_get(entry, "Re") ?? 0
            if3 re_val < min_re {
                matched = false
            }
            if3 re_val > max_re {
                matched = false
            }
        }

        // Source filter
        if3 matched == true {
            if3 source_filter != "" {
                if3 dict_get(entry, "source") ?? "" != source_filter {
                    matched = false
                }
            }
        }

        // Trit filter
        if3 matched == true {
            if3 trit_filter != null {
                if3 dict_get(entry, "trit") ?? 0 != trit_filter {
                    matched = false
                }
            }
        }

        if3 matched == true {
            results = append(results, entry)
        }
    }

    // Apply limit
    let total_matched = len(results)
    if3 total_matched > limit {
        results = slice(results, total_matched - limit, total_matched)
    }

    // Trit: +1 found matches, 0 searched but empty, -1 no history
    let trit = 0
    if3 len(_prompt_re_history) == 0 {
        trit = -1
    }
    if3 total_matched > 0 {
        trit = 1
    }

    return {
        "ok": true,
        "results": results,
        "total_matched": total_matched,
        "total_scanned": scanned,
        "filters": {
            "keyword": keyword,
            "regime": regime_filter,
            "min_re": min_re,
            "max_re": max_re,
            "source": source_filter,
            "trit": trit_filter
        },
        "trit": trit
    }
}

// ================================================================
// TShell: Fingerprint a File
// ================================================================

fn fingerprint_file(path) {
    let fp = {}
    fp = dict_set(fp, "path", path)
    fp = dict_set(fp, "indexed_at", time())
    fp = dict_set(fp, "size", 0)
    fp = dict_set(fp, "compressed_size", 0)
    fp = dict_set(fp, "compressed", T_FALSE)
    fp = dict_set(fp, "tzip_path", "")
    fp = dict_set(fp, "access_count", 0)

    // Get file size via nova_run
    let stat_result = nova_run("cmd /c if exist \"" + path + "\" (for %I in (\"" + path + "\") do @echo %~zI) else (echo 0)")
    let fsize = int(trim(stat_result))
    fp = dict_set(fp, "size", fsize)

    // Get file extension and channel
    let ext = get_ext(path)
    let channel = get_channel(ext)
    fp = dict_set(fp, "channel", channel)

    // SHA-256 hash via nova_run
    let hash_cmd = "cmd /c certutil -hashfile \"" + path + "\" SHA256 2>nul"
    let hash_result = nova_run(hash_cmd)
    let hash_lines = split(hash_result, "\n")
    if3 len(hash_lines) >= 2 {
        let sha = trim(replace(dict_get(hash_lines, 1), " ", ""))
        fp = dict_set(fp, "sha256", sha)
    } else { fp = dict_set(fp, "sha256", "")
    }

    // Trit hash -- first 25 trits from sha256 hex chars
    // Each hex char (0-f) mapped to trit: 0-5=N, 6-9=Z, a-f=P
    let sha_val = dict_get(fp, "sha256") ?? ""
    let trit_hash = ""
    let ti = 0
    while3 ti < 25 {
        if3 ti < len(sha_val) {
            let ch = lower(slice(sha_val, ti, ti + 1))
            // Simple mapping: digits 0-4 -> N, 5-9 -> Z, a-f -> P
            if3 ch == "0" {
                trit_hash = trit_hash + "N"
            } else ch == "1" { trit_hash = trit_hash + "N"
            } else ch == "2" { trit_hash = trit_hash + "N"
            } else ch == "3" { trit_hash = trit_hash + "N"
            } else ch == "4" { trit_hash = trit_hash + "N"
            } else ch == "5" { trit_hash = trit_hash + "Z"
            } else ch == "6" { trit_hash = trit_hash + "Z"
            } else ch == "7" { trit_hash = trit_hash + "Z"
            } else ch == "8" { trit_hash = trit_hash + "Z"
            } else ch == "9" { trit_hash = trit_hash + "Z"
            } else { trit_hash = trit_hash + "P"
        } else { trit_hash = trit_hash + "Z"
        }
        ti = ti + 1
    }
    fp = dict_set(fp, "trit_hash", trit_hash)

    // Ratio helper
    if3 fsize > 0 {
        comp_size = dict_get(fp, "compressed_size") ?? 0
        let ratio_val = round(comp_size / fsize * 1000) / 10
        fp = dict_set(fp, "ratio", str(ratio_val) + "%")
    } else { fp = dict_set(fp, "ratio", "0%")
    }

    // Short sha for display
    if3 len(sha_val) > 16 {
        fp = dict_set(fp, "sha256_short", slice(sha_val, 0, 16) + "...")
    } else { fp = dict_set(fp, "sha256_short", sha_val)
    }

    _tshell_stats_fingerprints = _tshell_stats_fingerprints + 1
    return fp
}

// ================================================================
// TShell: Index Operations
// ================================================================
}

fn index_add(path, fp) {
    _ternary_index = dict_set(_ternary_index, path, fp)
}

fn index_remove(path) {
    if3 dict_has(_ternary_index, path) {
        _ternary_index = dict_del(_ternary_index, path)
    } else {
        // not in index
    }
}

fn index_get(path) {
    return dict_get(_ternary_index, path) ?? {}
}

fn index_stats() {
    let file_keys = keys(_ternary_index)
    let total_files = len(file_keys)
    let total_size = 0
    let compressed_count = 0
    let compressed_size = 0
    let by_channel = {}
    let ki = 0
    while3 ki < total_files {
        let k = dict_get(file_keys, ki)
        let entry = dict_get(_ternary_index, k) ?? {}
        let esize = dict_get(entry, "size") ?? 0
        total_size = total_size + esize
        if3 dict_get(entry, "compressed") ?? T_FALSE == T_TRUE {
            compressed_count = compressed_count + 1
            compressed_size = compressed_size + dict_get(entry, "compressed_size") ?? 0
        } else {
            // not compressed
        }
        let ch = dict_get(entry, "channel") ?? "DOMAIN"
        if3 dict_has(by_channel, ch) {
            ch_data = dict_get(by_channel, ch)
            ch_data = dict_set(ch_data, "count", (dict_get(ch_data, "count") ?? 0) + 1)
            ch_data = dict_set(ch_data, "size", (dict_get(ch_data, "size") ?? 0) + esize)
            by_channel = dict_set(by_channel, ch, ch_data)
        } else { ch_data = {}
            ch_data = dict_set(ch_data, "count", 1)
            ch_data = dict_set(ch_data, "size", esize)
            by_channel = dict_set(by_channel, ch, ch_data)
        }
        ki = ki + 1
    }
    let result = {}
    result = dict_set(result, "total_files", total_files)
    result = dict_set(result, "total_size", total_size)
    result = dict_set(result, "total_size_hr", human_size(total_size))
    result = dict_set(result, "compressed_files", compressed_count)
    result = dict_set(result, "compressed_size", compressed_size)
    result = dict_set(result, "compressed_size_hr", human_size(compressed_size))
    result = dict_set(result, "by_channel", by_channel)
    return result
}

// -- Save index to disk --
fn index_save() {
    let data = json_encode(_ternary_index)
    nova_write(INDEX_FILE, data)
}

// -- Load index from disk --
fn index_load() {
    try3 {
        let raw = nova_read(INDEX_FILE)
        if3 len(raw) > 2 {
            _ternary_index = json_decode(raw)
            print("[TShell] Loaded index from disk")
        } else {
            // empty or missing file
    } else {
        print("[TShell] No existing index file found")
    }
}

