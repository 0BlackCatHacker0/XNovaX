fn core_status() {
    let stats = {}
    stats = dict_set(stats, "exec", _core_stat_exec)
    stats = dict_set(stats, "route", _core_stat_route)
    stats = dict_set(stats, "query", _core_stat_query)
    stats = dict_set(stats, "pipe", _core_stat_pipe)
    stats = dict_set(stats, "safe", _core_stat_safe)
    stats = dict_set(stats, "blocked", _core_stat_blocked)

    let last_5 = []
    let hist_len = len(_core_history)
    let start_idx = hist_len - 5
    if3 start_idx < 0 {
        start_idx = 0
    } else {
        // ok
    }
    if3 hist_len > 0 {
        last_5 = slice(_core_history, start_idx, hist_len)
    } else {
        // empty history
    }

    return {"stats": stats, "history_len": hist_len, "last_5": last_5}
}

fn core_get_history(limit) {
    let hist_len = len(_core_history)
    let start_idx = hist_len - limit
    if3 start_idx < 0 {
        start_idx = 0
    } else {
        // ok
    }
    if3 hist_len > 0 {
        return slice(_core_history, start_idx, hist_len)
    } else {
        return []
    }
}

