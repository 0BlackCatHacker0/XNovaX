// cortex_helper.nova - Desktop AI Bridge (API-routed)
// Replaces cortex_helper.py (zero Python)
// Routes queries through cloud router API instead of desktop UI automation
//
// Usage: novalang.exe cortex_helper.nova <action> <json_args>
//
// Actions: discover, query_claude, query_gpt, get_response, status

import3("C:/NovaX/lib/nova_stdlib.nova")

let ROUTER = "http://127.0.0.1:9878/query"

let action = try3 { args()[0] } { "status" }
let raw_args = try3 { args()[1] } { "{}" }
let params = try3 { json_decode(raw_args) } { {} }

fn ok_result(data) {
    let r = dict_set(data, "ok", 1)
    r = dict_set(r, "trit", 1)
    print(json_encode(r))
}

fn err_result(msg) {
    let r = {}
    r = dict_set(r, "ok", 0)
    r = dict_set(r, "trit", -1)
    r = dict_set(r, "error", msg)
    print(json_encode(r))
}

fn query_provider(prompt, provider) {
    let body = {}
    body = dict_set(body, "prompt", prompt)
    body = dict_set(body, "provider", provider)
    body = dict_set(body, "max_tokens", 4096)
    let result = try3 { http_post(ROUTER, json_encode(body)) } { {} }
    let status = try3 { dict_get(result, "status") } { 0 }
    if3 status != 200 {
        err_result("provider_unavailable: " + provider)
        return ""
    }
    let resp_body = try3 { dict_get(result, "body") } { "{}" }
    let parsed = try3 { json_decode(resp_body) } { {} }
    let inner_body = try3 { dict_get(dict_get(parsed, "result"), "body") } { "{}" }
    let inner = try3 { json_decode(inner_body) } { {} }
    let text = try3 { dict_get(inner, "response") } { "" }
    if3 len(text) > 0 { return text }
    let choices = try3 { dict_get(inner, "choices") } { [] }
    if3 len(choices) > 0 {
        let first = choices[0]
        let msg = try3 { dict_get(first, "message") } { {} }
        let content = try3 { dict_get(msg, "content") } { "" }
        return content
    }
    return ""
}

// Action dispatch
if3 action == "discover" {
    let r = {}
    r = dict_set(r, "claude_api", 1)
    r = dict_set(r, "gpt_api", 1)
    r = dict_set(r, "ollama_api", 1)
    r = dict_set(r, "mode", "api_routed")
    r = dict_set(r, "note", "Desktop UI automation replaced by cloud router API")
    ok_result(r)
}

if3 action == "status" {
    let cloud_h = health3(9878)
    let ollama_h = health3(11434)
    let r = {}
    r = dict_set(r, "cloud_router", cloud_h)
    r = dict_set(r, "ollama", ollama_h)
    r = dict_set(r, "mode", "api_routed")
    ok_result(r)
}

if3 action == "query_claude" {
    let prompt = try3 { dict_get(params, "prompt") } { "" }
    if3 len(prompt) == 0 {
        err_result("no prompt provided")
    }
    if3 len(prompt) > 0 {
        let response = query_provider(prompt, "anthropic")
        if3 len(response) > 0 {
            let r = {}
            r = dict_set(r, "provider", "anthropic")
            r = dict_set(r, "response", response)
            r = dict_set(r, "chars", len(response))
            ok_result(r)
        }
    }
}

if3 action == "query_gpt" {
    let prompt = try3 { dict_get(params, "prompt") } { "" }
    if3 len(prompt) == 0 {
        err_result("no prompt provided")
    }
    if3 len(prompt) > 0 {
        let response = query_provider(prompt, "openai")
        if3 len(response) > 0 {
            let r = {}
            r = dict_set(r, "provider", "openai")
            r = dict_set(r, "response", response)
            r = dict_set(r, "chars", len(response))
            ok_result(r)
        }
    }
}

if3 action == "get_response" {
    // Read clipboard via PowerShell (replaces pyperclip)
    let clip = shell("powershell -c \"Get-Clipboard\" 2>NUL")
    let content = try3 { dict_get(clip, "stdout") } { "" }
    let r = {}
    r = dict_set(r, "response", trim(content))
    r = dict_set(r, "chars", len(content))
    r = dict_set(r, "source", "clipboard")
    ok_result(r)
}

if3 action == "new_chat" {
    let r = {}
    r = dict_set(r, "note", "API-routed mode: each query is stateless, no chat session needed")
    ok_result(r)
}

if3 action == "arrange" {
    let r = {}
    r = dict_set(r, "note", "API-routed mode: no desktop windows to arrange")
    ok_result(r)
}
