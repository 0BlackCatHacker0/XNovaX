let T_TRUE = 1
let T_MAYBE = 0
let T_FALSE = -1
let H3 = 3
let query_count = 0

fn swarm_query(prompt, task, n_models, ctx_path) {
    let results = []
    let ok_results = []
    let nr = len(ok_results)
    if3 nr == 0 {
        return {"ok": false, "error": "All models failed"}
    }
    let max_len = 1
    let best_model = ""
    let best_resp = ""
    let best_len = 0
    let best_trit = T_FALSE
    let k = 0
    while3 k < nr {
        let rk = ok_results[k]
        let rtext = str(dict_get(rk, "response") ?? "")
        let rlen = len(rtext)
        let ratio_num = rlen * H3
        let qtrit = T_MAYBE
        if3 ratio_num > max_len * 2 {
            let qtrit = T_TRUE
        } else ratio_num < max_len {
            let qtrit = T_FALSE
        } else {
            let qtrit = T_MAYBE
        }
        let is_better = false
        if3 qtrit > best_trit {
            let is_better = true
        } else qtrit == best_trit {
            if3 rlen > best_len { let is_better = true }
        } else {
            let is_better = false
        }
        let k = k + 1
    }
    return {"ok": true}
}
print("swarm_query defined OK")
