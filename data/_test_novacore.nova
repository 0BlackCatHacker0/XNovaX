// Quick test: verify NovaCore client library works
import3("C:/NovaX/lib/nova_ns_core.nova")
import3("C:/NovaX/lib/nova_stdlib.nova")
import3("C:/NovaX/lib/nova_novacore.nova")

print("=== NovaCore Integration Test ===")

// Test 1: Health check
print("\n[TEST 1] NovaCore Health")
let h = novacore_health()
print("  Router: " + str(dict_get(h, "router") ?? 0))
print("  Fractal: " + str(dict_get(h, "fractal") ?? 0))
print("  HiveMind: " + str(dict_get(h, "hivemind") ?? 0))
print("  Total up: " + str(dict_get(h, "total_up") ?? 0))

// Test 2: Chladni route
print("\n[TEST 2] Chladni Route")
let r = novacore_route("Write a Python web scraper with async support")
print("  Result: " + str(r))

// Test 3: Fractal split
print("\n[TEST 3] Fractal Split")
let s = novacore_fractal_split("Analyze market trends and build a trading algorithm")
print("  Domains: " + str(dict_get(s, "count") ?? 0) + " sub-tasks")

// Test 4: Smart query
print("\n[TEST 4] Smart Query")
let q = novacore_smart_query("What is 2+2?")
let ok = dict_get(q, "ok") ?? -1
print("  ok=" + str(ok))

// Test 5: Fractal status
print("\n[TEST 5] Fractal Engine Status")
let fs = novacore_fractal_status()
print("  Max splits: " + str(dict_get(fs, "max_splits") ?? 0))
print("  Max rounds: " + str(dict_get(fs, "max_rounds") ?? 0))
print("  Domains: " + str(dict_get(fs, "domain_count") ?? 0))

print("\n=== All NovaCore Tests Complete ===")
