let PORT = 19999
print("Creating server on port " + str(PORT))
let server = tserve(PORT, "Test Service")
print("Server ID: " + str(server))

fn handle_health(req)
    return '{"status":"ok","state":1}'
end

troute(server, "GET", "/health", handle_health)
print("Route registered, calling tstart...")
tstart(server)
print("Server stopped")
