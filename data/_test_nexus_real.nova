let start_ts = 0

// --------------------------------------------------------------------------
// HELPER: connection trit for a URL
// Returns T_TRUE(1)=fast, T_MAYBE(0)=slow-or-partial, T_FALSE(-1)=down
// We use http_get as the liveness probe; trit based on whether response has data.
// --------------------------------------------------------------------------
print("PAST VARS, entering fn connection_trit...")
fn connection_trit(url) {
    let resp = http_get(url + "/health")
    let ok   = dict_get(resp, "ok") ?? false
    let port = dict_get(resp, "port") ?? -1
    let ver  = dict_get(resp, "version") ?? ""
    if3 ok == true {
        return T_TRUE
    } else port > 0 {
        return T_MAYBE
    } else len(str(ver)) > 0 {
        return T_MAYBE
    } else {
        return T_FALSE
    }
}
print("PAST connection_trit, entering bt_string...")
fn bt_string(t0, t1, t2, t3, t4, t5, t6) {
    let s = ""
    let s = s + str(t0)
    let s = s + str(t1)
    let s = s + str(t2)
    let s = s + str(t3)
    let s = s + str(t4)
    let s = s + str(t5)
    let s = s + str(t6)
    return s
}

// --------------------------------------------------------------------------
// HELPER: trit char for display
// --------------------------------------------------------------------------
fn trit_char(t) {
    if3 t == T_TRUE {
        return "1"
    } else t == T_MAYBE {
        return "0"
    } else {
        return "T"
    }
}

