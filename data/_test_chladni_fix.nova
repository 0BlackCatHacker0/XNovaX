import3("C:/NovaX/lib/nova_ns_core.nova")
import3("C:/NovaX/lib/nova_stdlib.nova")
import3("C:/NovaX/lib/nova_tripple.nova")

print("=== Chladni Fix Verification ===")

let models = ["novax-qwen2.5-coder:latest", "gpt-4o-mini", "claude-sonnet-4", "llama-3.3-70b", "deepseek-r1", "gemini-2.5-pro"]
let domain_names = ["code", "reasoning", "chat", "search", "vision", "system", "fast", "flagship", "specialist"]

let mi = 0
while3 mi < len(models) {
    let pos = _model_plate_position(models[mi], 500)
    let x = dict_get(pos, "x") ?? 0
    let y = dict_get(pos, "y") ?? 0

    let skills = chladni_skill_resonance(models[mi], 500)
    let total = 0
    let best_s = 0
    let best_i = 0
    let si = 0
    while3 si < 9 {
        let s = dict_get(skills, str(si)) ?? 0
        total = total + s
        if3 s > best_s {
            best_s = s
            best_i = si
        }
        si = si + 1
    }
    let domain = domain_names[best_i]
    print(models[mi] + " -> x=" + str(x) + " y=" + str(y) + " | domain=" + domain + " strength=" + str(best_s) + " total=" + str(total))
    mi = mi + 1
}

print("\n=== Fix Verified ===")
