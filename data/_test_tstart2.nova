let PORT = 19999
print("1. Creating server")
let server = tserve(PORT, "Test Service")
print("2. Server: " + str(server))

fn handle_health(req)
    return '{"status":"ok","state":1}'
end

print("3. Function defined")
let route_result = troute(server, "GET", "/health", "handle_health")
print("4. Route result: " + str(route_result))
print("5. Starting server...")
tstart(server)
