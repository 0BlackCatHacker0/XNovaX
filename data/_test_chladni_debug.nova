import3("C:/NovaX/lib/nova_ns_core.nova")
import3("C:/NovaX/lib/nova_stdlib.nova")
import3("C:/NovaX/lib/nova_tripple.nova")

print("=== Chladni Debug ===")

// Test sin_approx
print("\n[SIN_APPROX TEST]")
let angles = [0, 785, 1571, 2356, 3142, 4712, 6283]
let labels = ["0", "pi/4", "pi/2", "3pi/4", "pi", "3pi/2", "2pi"]
let i = 0
while3 i < len(angles) {
    let s = _sin_approx(angles[i])
    print("  sin(" + labels[i] + ") = " + str(s) + " (expected: " + str(i) + ")")
    i = i + 1
}

// Test eigenmode at various positions
print("\n[EIGENMODE TEST] mode (1,3) at various (x,y)")
let positions = [
    {"x": 250, "y": 250},
    {"x": 500, "y": 500},
    {"x": 333, "y": 667},
    {"x": 100, "y": 900},
    {"x": 750, "y": 250}
]
let pi = 0
while3 pi < len(positions) {
    let p = positions[pi]
    let x = dict_get(p, "x") ?? 0
    let y = dict_get(p, "y") ?? 0
    let z = chladni_eigenmode(1, 3, x, y)
    print("  z(1,3, " + str(x) + ", " + str(y) + ") = " + str(z))
    pi = pi + 1
}

// Test model plate position for known model
print("\n[PLATE POSITION TEST]")
let models = ["novax-qwen2.5-coder:latest", "gpt-4o-mini", "claude-sonnet-4", "llama-3.3-70b"]
let mi = 0
while3 mi < len(models) {
    let pos = _model_plate_position(models[mi], 500)
    let x = dict_get(pos, "x") ?? 0
    let y = dict_get(pos, "y") ?? 0
    print("  " + models[mi] + " -> x=" + str(x) + " y=" + str(y))

    // Test resonance for this model
    let skills = chladni_skill_resonance(models[mi], 500)
    let total = 0
    let si = 0
    let best_s = 0
    let best_i = 0
    while3 si < 9 {
        let s = dict_get(skills, str(si)) ?? 0
        total = total + s
        if3 s > best_s { best_s = s; best_i = si }
        si = si + 1
    }
    print("    total_resonance=" + str(total) + " best_domain_idx=" + str(best_i) + " best_strength=" + str(best_s))
    mi = mi + 1
}

print("\n=== Debug Complete ===")
