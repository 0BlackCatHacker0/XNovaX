// NOVA SWARM MAX — Pure NovaLang, All Providers
// Usage: novalang.exe nova_swarm_max.nova

import3("C:/NovaX/lib/nova_stdlib.nova")

let ROUTER = "http://127.0.0.1:9878/query"
let OUT = "C:/NovaX/swarm_upgrades"
shell("mkdir " + OUT + " 2>NUL")

let CTX = "NovaX: AI OS, 111 services, 29 providers, 510K models. NovaLang: ternary Rust VM, if3/match3/try3/while3. dict_set returns NEW dict (reassign!), append returns NEW list. try3 { } { fallback }. http_post(url, json_encode(body)). tserve(PORT,NAME) with troute(). Arch: Orchestrator(:9999)->CloudRouter(:9878)->Hivemind(:9881). N-S Reynolds 3-5-7-13 harmonics. Write production NovaLang code."

let TASKS = [
    "router-enhance: Improve Cloud Router provider selection using Chladni patterns and Reynolds scoring. Write NovaLang.",
    "hive-token-max: Token maximizer using Kolmogorov cascade decomposition. Write NovaLang.",
    "fractal-depth: Enhance Fractal Engine with adaptive Reynolds depth. Write NovaLang.",
    "swarm-consensus: Swarm consensus with ternary fingerprints and bt voting. Write NovaLang.",
    "self-heal: Self-healing mesh for 111 services with health3(). Write NovaLang.",
    "vm-optimize: Rust VM optimization HAMT and async tserve. Write Rust code.",
    "tripple-enhance: Tripple search with Chladni 9 eigenmodes. Write NovaLang.",
    "event-system: Event bus with ternary event classification. Write NovaLang.",
    "security-harden: Ternary rate-limiting and bt request signing. Write NovaLang.",
    "perf-benchmark: Benchmark all providers with Reynolds scoring. Write NovaLang.",
    "knowledge-graph: Service+provider+model graph with ternary edges. Write NovaLang.",
    "swarm-codegen: Swarm code generator with ternary voting. Write NovaLang.",
    "stdlib-enhance: Add graph3 crypto3 stream3 cluster3 to stdlib. Write NovaLang."
]

let PROVIDERS = [
    "ollama", "openai", "anthropic", "google",
    "cerebras_direct", "sambanova_direct", "google_ai_studio",
    "openrouter", "mistral", "groq", "deepseek",
    "cohere", "together", "cortex", "novax-prime"
]

let total_hits = 0
let total_fails = 0

fn extract_text(parsed) {
    let r = try3 { dict_get(parsed, "result") } { {} }
    let inner_str = try3 { dict_get(r, "body") } { "{}" }
    let inner = try3 { json_decode(inner_str) } { {} }
    let text = try3 { dict_get(inner, "response") } { "" }
    if3 len(text) > 5 { return text }
    // Try OpenAI choices format
    let choices = try3 { dict_get(inner, "choices") } { [] }
    if3 len(choices) > 0 {
        let first = choices[0]
        let msg = try3 { dict_get(first, "message") } { {} }
        let content = try3 { dict_get(msg, "content") } { "" }
        return content
    }
    ""
}

fn fire(task_desc, provider, task_id) {
    let body = {}
    body = dict_set(body, "prompt", CTX + "\n\nTASK: " + task_desc)
    body = dict_set(body, "provider", provider)
    body = dict_set(body, "max_tokens", 2048)

    let result = try3 { http_post(ROUTER, json_encode(body)) } { {} }
    let status = try3 { dict_get(result, "status") } { 0 }

    if3 status == 0 {
        print("  FAIL " + task_id + " | " + provider + ": no response")
        return -1
    }

    let resp_body = try3 { dict_get(result, "body") } { "{}" }
    let parsed = try3 { json_decode(resp_body) } { {} }
    let ok = try3 { dict_get(parsed, "ok") } { 0 }

    if3 ok == 0 {
        print("  MISS " + task_id + " | " + provider + ": not ok")
        return 0
    }

    let text = extract_text(parsed)
    let tlen = len(text)

    if3 tlen > 50 {
        let save = {}
        save = dict_set(save, "task", task_id)
        save = dict_set(save, "provider", provider)
        save = dict_set(save, "chars", tlen)
        save = dict_set(save, "text", text)
        write_file(OUT + "/" + task_id + "_" + provider + ".json", json_encode(save))
        print("  HIT  " + task_id + " | " + provider + ": " + str(tlen) + " chars")
        return 1
    }

    print("  MISS " + task_id + " | " + provider + ": short (" + str(tlen) + ")")
    return 0
}

print("=" * 65)
print("NOVA SWARM MAX — PURE NOVALANG, ALL PROVIDERS")
print("Tasks: " + str(len(TASKS)) + " | Providers: " + str(len(PROVIDERS)))
print("=" * 65)

let tidx = 0
for3 task_desc in TASKS {
    let parts = split(task_desc, ":")
    let task_id = trim(parts[0])
    tidx = tidx + 1
    print("\n--- Task " + str(tidx) + "/" + str(len(TASKS)) + ": " + task_id + " ---")

    for3 provider in PROVIDERS {
        let r = fire(task_desc, provider, task_id)
        if3 r == 1 { total_hits = total_hits + 1 }
        if3 r == -1 { total_fails = total_fails + 1 }
    }
}

print("\n" + "=" * 65)
print("SWARM MAX COMPLETE")
print("Hits:  " + str(total_hits))
print("Fails: " + str(total_fails))
print("Files: " + OUT + "/")
print("=" * 65)
