// ============================================================================
// metrics3.nova — Ternary Metrics & Telemetry Collector
// ============================================================================
// Tracks counters, gauges, histograms with ternary health signals:
//   +1 = metrics within normal bounds
//    0 = metrics approaching thresholds
//   -1 = metrics exceeded critical thresholds
//
// Uses v1.4 features: ??, default params, in operator
// ============================================================================

fn metrics3_new(name = "metrics") {
    return {
        "name": name,
        "counters": {},
        "gauges": {},
        "histograms": {},
        "created_at": time_ms()
    }
}

fn metrics3_inc(m, counter_name, amount = 1) {
    let counters = dict_get(m, "counters") ?? {}
    let current = dict_get(counters, counter_name) ?? 0
    counters = dict_set(counters, counter_name, current + amount)
    let result = deep_clone(m)
    result = dict_set(result, "counters", counters)
    return result
}

fn metrics3_gauge_set(m, gauge_name, value) {
    let gauges = dict_get(m, "gauges") ?? {}
    gauges = dict_set(gauges, gauge_name, {"value": value, "ts": time_ms()})
    let result = deep_clone(m)
    result = dict_set(result, "gauges", gauges)
    return result
}

fn metrics3_gauge_get(m, gauge_name) {
    let gauges = dict_get(m, "gauges") ?? {}
    let g = dict_get(gauges, gauge_name)
    if3 g == null { return null }
    return dict_get(g, "value") ?? null
}

fn metrics3_histogram_record(m, hist_name, value) {
    let histograms = dict_get(m, "histograms") ?? {}
    let hist = dict_get(histograms, hist_name) ?? {"values": [], "count": 0, "sum": 0, "min": 999999, "max": -999999}
    let values = dict_get(hist, "values") ?? []
    // Keep last 100 values (sliding window)
    if3 len(values) >= 100 {
        values = drop(values, 1)
    }
    values = append(values, value)
    let count = (dict_get(hist, "count") ?? 0) + 1
    let sum = (dict_get(hist, "sum") ?? 0) + value
    let mn = dict_get(hist, "min") ?? 999999
    let mx = dict_get(hist, "max") ?? -999999
    if3 value < mn { mn = value }
    if3 value > mx { mx = value }
    hist = dict_set(hist, "values", values)
    hist = dict_set(hist, "count", count)
    hist = dict_set(hist, "sum", sum)
    hist = dict_set(hist, "min", mn)
    hist = dict_set(hist, "max", mx)
    histograms = dict_set(histograms, hist_name, hist)
    let result = deep_clone(m)
    result = dict_set(result, "histograms", histograms)
    return result
}

fn metrics3_histogram_avg(m, hist_name) {
    let histograms = dict_get(m, "histograms") ?? {}
    let hist = dict_get(histograms, hist_name)
    if3 hist == null { return 0 }
    let count = dict_get(hist, "count") ?? 0
    if3 count == 0 { return 0 }
    let sum = dict_get(hist, "sum") ?? 0
    return sum / count
}

fn metrics3_histogram_p95(m, hist_name) {
    let histograms = dict_get(m, "histograms") ?? {}
    let hist = dict_get(histograms, hist_name)
    if3 hist == null { return 0 }
    let values = dict_get(hist, "values") ?? []
    if3 len(values) == 0 { return 0 }
    let sorted = sort(values)
    let idx = (len(sorted) * 95) / 100
    if3 idx >= len(sorted) { idx = len(sorted) - 1 }
    return sorted[idx]
}

fn metrics3_report(m) {
    return {
        "name": dict_get(m, "name") ?? "metrics",
        "counters": dict_get(m, "counters") ?? {},
        "gauges": dict_get(m, "gauges") ?? {},
        "uptime_ms": time_ms() - (dict_get(m, "created_at") ?? 0)
    }
}
