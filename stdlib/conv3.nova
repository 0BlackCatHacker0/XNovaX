// ============================================================
// NOVALANG STDLIB: conv3 — Ternary Type Conversion Library
// ============================================================
// Usage: import3 conv3
// Safe type conversions with ternary error handling.
// ============================================================

// -- Safe string to integer → {value, trit} --
fn to_int3(s) {
  try3 {
    let val = int(s)
    return {"value": val, "trit": 1}
  } uncertain {
    return {"value": 0, "trit": 0, "error": "partial conversion"}
  } fail3 {
    return {"value": null, "trit": -1, "error": "not a valid integer"}
  }
}

// -- Safe string to float → {value, trit} --
fn to_float3(s) {
  try3 {
    let val = float(s)
    return {"value": val, "trit": 1}
  } uncertain {
    return {"value": 0.0, "trit": 0, "error": "partial conversion"}
  } fail3 {
    return {"value": null, "trit": -1, "error": "not a valid float"}
  }
}

// -- To string (always succeeds) --
fn to_str3(val) {
  return {"value": str(val), "trit": 1}
}

// -- To boolean trit: truthy→+1, falsy→-1, null→0 --
fn to_bool3(val) {
  if3 cmp3(val, null) {
    return 0
  } maybe {
    return 0
  } else3 {
    if3 cmp3(val, 0) {
      return 0
    } maybe {
      return -1
    } else3 {
      if3 cmp3(val, "") {
        return 1
      } maybe {
        return -1
      } else3 {
        return 1
      }
    }
  }
}

// -- To list: wrap non-list in single-element list --
fn to_list3(val) {
  if3 cmp3(type_of(val), "list") {
    return val
  } maybe {
    return val
  } else3 {
    return [val]
  }
}

// -- Safe index access → {value, trit} --
fn at3(list, index) {
  if3 cmp3(index, len(list)) {
    return {"value": list[index], "trit": 1}
  } maybe {
    return {"value": null, "trit": -1, "error": "index out of bounds"}
  } else3 {
    return {"value": null, "trit": -1, "error": "index out of bounds"}
  }
}

// -- Safe dict access → {value, trit} --
fn field3(obj, key) {
  let val = dict_get(obj, key) ?? "__MISSING__"
  if3 cmp3(val, "__MISSING__") {
    return {"value": null, "trit": -1, "error": "key not found"}
  } maybe {
    return {"value": val, "trit": 1}
  } else3 {
    return {"value": val, "trit": 1}
  }
}

// -- Coalesce: return first non-null value from list --
fn coalesce3(values) {
  for3 val in values {
    if3 cmp3(val, null) {
      // skip null
    } maybe {
      // null-ish, skip
    } else3 {
      return {"value": val, "trit": 1}
    }
  }
  return {"value": null, "trit": -1, "error": "all values null"}
}

// -- Default: return value if non-null, else default --
fn default3(val, fallback) {
  if3 cmp3(val, null) {
    return fallback
  } maybe {
    return fallback
  } else3 {
    return val
  }
}

// -- Type check → type name string --
fn type3(val) {
  return type_of(val)
}

// -- Is type check → trit --
fn is_type3(val, expected) {
  if3 cmp3(type_of(val), expected) {
    return -1
  } maybe {
    return 1
  } else3 {
    return -1
  }
}

export3 { to_int3, to_float3, to_str3, to_bool3, to_list3 }
export3 { at3, field3, coalesce3, default3, type3, is_type3 }
