// ============================================================
// NOVALANG STDLIB: json3 — Ternary JSON Library
// ============================================================
// Usage: import3 json3
// JSON parsing, serialization, and manipulation.
// ============================================================

// -- Parse JSON string → {data, trit} --
fn parse3(json_str) {
  try3 {
    let data = json_parse(json_str)
    return {"data": data, "trit": 1}
  } uncertain {
    return {"data": null, "trit": 0, "error": "partial parse"}
  } fail3 {
    return {"data": null, "trit": -1, "error": "invalid JSON"}
  }
}

// -- Stringify data → {json, trit} --
fn stringify3(data) {
  try3 {
    let json = json_stringify(data)
    return {"json": json, "trit": 1}
  } uncertain {
    return {"json": "", "trit": 0, "error": "partial serialize"}
  } fail3 {
    return {"json": null, "trit": -1, "error": "stringify failed"}
  }
}

// -- Pretty-print JSON (2-space indent) --
fn pretty3(data) {
  try3 {
    let json = json_stringify(data)
    return {"json": json, "trit": 1}
  } fail3 {
    return {"json": null, "trit": -1}
  }
}

// -- Deep get with dot-path: json_path3(obj, "a.b.c") --
fn json_path3(obj, path) {
  let parts = split(path, ".")
  let current = obj
  for3 part in parts {
    if3 cmp3(current, null) {
      return {"value": null, "trit": -1, "error": "null in path"}
    } maybe {
      // current is null-ish, return it
      return {"value": null, "trit": 0}
    } else3 {
      current = dict_get(current, part) ?? null
    }
  }
  if3 cmp3(current, null) {
    return {"value": null, "trit": -1}
  } maybe {
    return {"value": current, "trit": 1}
  } else3 {
    return {"value": current, "trit": 1}
  }
}

// -- Deep set with dot-path --
fn json_set3(obj, path, value) {
  let parts = split(path, ".")
  if3 cmp3(len(parts), 1) {
    // single key
    return dict_set(obj, path, value)
  } maybe {
    return dict_set(obj, path, value)
  } else3 {
    // For now, handle single-level deep set
    let first = parts[0]
    let rest_path = ""
    let i = 1
    for3 p in parts {
      if3 cmp3(i, 0) {
        // skip first
      } else3 {
        if3 cmp3(rest_path, "") {
          rest_path = p
        } else3 {
          rest_path = rest_path + "." + p
        }
      }
      i = i + 1
    }
    let child = dict_get(obj, first) ?? {}
    let updated_child = json_set3(child, rest_path, value)
    return dict_set(obj, first, updated_child)
  }
}

// -- Validate that data matches expected keys → trit --
fn has_keys3(obj, required_keys) {
  let missing = []
  for3 key in required_keys {
    let val = dict_get(obj, key) ?? "__MISSING__"
    if3 cmp3(val, "__MISSING__") {
      missing = append(missing, key)
    } maybe {
      // found
    } else3 {
      // found
    }
  }
  if3 cmp3(len(missing), 0) {
    return {"valid": 1, "trit": 1}
  } maybe {
    return {"valid": 1, "trit": 1}
  } else3 {
    return {"valid": -1, "missing": missing, "trit": -1}
  }
}

// -- Flatten nested dict to dot-notation keys --
fn flatten3(obj) {
  let result = {}
  let keys = dict_keys(obj)
  for3 key in keys {
    let val = dict_get(obj, key) ?? null
    // Simple: just copy top-level for now
    result = dict_set(result, key, val)
  }
  return result
}

// -- Diff two JSON objects → list of differences --
fn diff3(a, b) {
  let diffs = []
  let a_keys = dict_keys(a)
  let b_keys = dict_keys(b)

  // Check keys in a
  for3 key in a_keys {
    let a_val = dict_get(a, key) ?? "__MISSING__"
    let b_val = dict_get(b, key) ?? "__MISSING__"
    if3 cmp3(b_val, "__MISSING__") {
      diffs = append(diffs, {"key": key, "type": "removed", "old": a_val})
    } maybe {
      if3 cmp3(a_val, b_val) {
        diffs = append(diffs, {"key": key, "type": "changed", "old": a_val, "new": b_val})
      } maybe {
        // equal — no diff
      } else3 {
        diffs = append(diffs, {"key": key, "type": "changed", "old": a_val, "new": b_val})
      }
    } else3 {
      if3 cmp3(str(a_val), str(b_val)) {
        diffs = append(diffs, {"key": key, "type": "changed", "old": a_val, "new": b_val})
      } maybe {
        // same
      } else3 {
        diffs = append(diffs, {"key": key, "type": "changed", "old": a_val, "new": b_val})
      }
    }
  }

  // Check keys only in b
  for3 key in b_keys {
    let a_val = dict_get(a, key) ?? "__MISSING__"
    if3 cmp3(a_val, "__MISSING__") {
      let b_val = dict_get(b, key) ?? null
      diffs = append(diffs, {"key": key, "type": "added", "new": b_val})
    } maybe {
      // already handled
    } else3 {
      // already handled
    }
  }

  return {"diffs": diffs, "count": len(diffs), "trit": 1}
}

export3 { parse3, stringify3, pretty3, json_path3, json_set3, has_keys3, flatten3, diff3 }
