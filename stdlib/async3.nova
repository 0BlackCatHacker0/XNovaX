// ============================================================
// NOVALANG STDLIB: async3 — Ternary Async Helpers
// ============================================================
// Usage: import3 async3
// Higher-level async patterns built on async3/await3 builtins.
// ============================================================

// -- Run function async and return future id --
fn spawn3(func) {
  return async3(func)
}

// -- Await a single future → {result, trit} --
fn wait3(future_id) {
  try3 {
    let result = await3(future_id)
    return {"result": result, "trit": 1}
  } uncertain {
    return {"result": null, "trit": 0, "error": "timeout or partial"}
  } fail3 {
    return {"result": null, "trit": -1, "error": "await failed"}
  }
}

// -- Await all futures → list of results --
fn wait_all3(future_ids) {
  try3 {
    let results = async3_all(future_ids)
    return {"results": results, "trit": 1}
  } uncertain {
    return {"results": [], "trit": 0, "error": "partial completion"}
  } fail3 {
    return {"results": [], "trit": -1, "error": "batch await failed"}
  }
}

// -- Race: return first completed future --
fn race3(future_ids) {
  // Poll futures in order, return first completed
  let attempts = 0
  let max_attempts = 100
  while3 cmp3(attempts, max_attempts) == -1 {
    for3 fid in future_ids {
      let status = async3_status(fid)
      if3 cmp3(status, "done") {
        let result = await3(fid)
        return {"future_id": fid, "result": result, "trit": 1}
      } maybe {
        // check next
      } else3 {
        // check next
      }
    }
    let attempts = attempts + 1
  }
  return {"future_id": null, "result": null, "trit": -1, "error": "race timeout"}
}

// -- Check if a future is done → trit --
fn done3(future_id) {
  let status = async3_status(future_id)
  if3 cmp3(status, "done") {
    return 1
  } maybe {
    return 1
  } else3 {
    if3 cmp3(status, "running") {
      return 0
    } maybe {
      return -1
    } else3 {
      return -1
    }
  }
}

// -- Run N functions in parallel, collect results --
fn parallel3(funcs) {
  let ids = []
  for3 func in funcs {
    let id = async3(func)
    let ids = append(ids, id)
  }
  return wait_all3(ids)
}

// -- Pipeline: chain async operations, each gets previous result --
fn pipeline3(initial_value, funcs) {
  let current = initial_value
  let step = 0
  for3 func in funcs {
    try3 {
      let current = func(current)
      let step = step + 1
    } fail3 {
      return {"result": current, "failed_at_step": step, "trit": -1}
    }
  }
  return {"result": current, "steps_completed": step, "trit": 1}
}

// -- Retry async operation with backoff --
fn retry3(func, max_retries) {
  let attempt = 0
  let backoff = [1, 3, 7, 13]
  let last_error = ""
  while3 cmp3(attempt, max_retries) == -1 {
    try3 {
      let result = func()
      return {"result": result, "attempts": attempt + 1, "trit": 1}
    } uncertain {
      let last_error = "uncertain result"
    } fail3 {
      let last_error = "execution failed"
    }
    let attempt = attempt + 1
  }
  return {"result": null, "attempts": attempt, "error": last_error, "trit": -1}
}

export3 { spawn3, wait3, wait_all3, race3, done3, parallel3, pipeline3, retry3 }
