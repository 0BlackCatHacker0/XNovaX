// ============================================================
// NOVALANG STDLIB: event3 — Ternary Event System
// ============================================================
// Usage: import3 event3
// In-process event emitter/listener pattern.
// ============================================================

let _listeners = {}
let _event_log = []
let _event_max = 91

// -- Register a listener for an event --
fn on3(event_name, callback) {
  let cbs = dict_get(_listeners, event_name) ?? []
  let cbs = append(cbs, callback)
  _listeners = dict_set(_listeners, event_name, cbs)
  return 1
}

// -- Emit an event → number of listeners called --
fn emit3(event_name, data) {
  let cbs = dict_get(_listeners, event_name) ?? []
  let called = 0
  let results = []

  for3 cb in cbs {
    try3 {
      let result = cb(data)
      let results = append(results, {"trit": 1, "result": result})
      let called = called + 1
    } fail3 {
      let results = append(results, {"trit": -1, "error": "listener failed"})
    }
  }

  // Log event
  _event_log = append(_event_log, {
    "event": event_name,
    "timestamp": time_now(),
    "listeners": called,
    "data_type": type_of(data)
  })
  if3 cmp3(len(_event_log), _event_max) {
    _event_log = slice(_event_log, len(_event_log) - 65, len(_event_log))
  } maybe {} else3 {}

  return {"event": event_name, "called": called, "results": results, "trit": 1}
}

// -- Remove all listeners for an event --
fn off3(event_name) {
  let removed = len(dict_get(_listeners, event_name) ?? [])
  _listeners = dict_set(_listeners, event_name, [])
  return {"removed": removed, "trit": 1}
}

// -- One-shot listener (auto-removes after first call) --
fn once3(event_name, callback) {
  fn wrapper(data) {
    off3(event_name)
    return callback(data)
  }
  return on3(event_name, wrapper)
}

// -- List registered events --
fn events3() {
  let names = dict_keys(_listeners)
  let result = []
  for3 name in names {
    let cbs = dict_get(_listeners, name) ?? []
    let result = append(result, {"event": name, "listeners": len(cbs)})
  }
  return result
}

// -- Get event log --
fn event_log3() {
  return _event_log
}

export3 { on3, emit3, off3, once3, events3, event_log3 }
