// ============================================================
// NOVALANG STDLIB: test3 — Lightweight Test Helpers
// ============================================================
// Usage: import3 test3
// Quick test utilities. For full framework, use tests/test_framework.nova.
// ============================================================

let _test_count = 0
let _test_pass = 0
let _test_fail = 0
let _test_warn = 0

// -- Run a single test → trit --
fn test3(name, func) {
  _test_count = _test_count + 1
  try3 {
    let result = func()
    if3 result {
      _test_pass = _test_pass + 1
      print3("[PASS] " + name)
      return 1
    } maybe {
      _test_warn = _test_warn + 1
      print3("[WARN] " + name)
      return 0
    } else3 {
      _test_fail = _test_fail + 1
      print3("[FAIL] " + name)
      return -1
    }
  } fail3 {
    _test_fail = _test_fail + 1
    print3("[FAIL] " + name + " (exception)")
    return -1
  }
}

// -- Assert equality --
fn eq3(actual, expected, msg) {
  if3 cmp3(str(actual), str(expected)) {
    print3("  FAIL: " + msg + " — expected " + str(expected) + ", got " + str(actual))
    return -1
  } maybe {
    return 1
  } else3 {
    print3("  FAIL: " + msg + " — expected " + str(expected) + ", got " + str(actual))
    return -1
  }
}

// -- Assert not equal --
fn neq3(actual, not_expected, msg) {
  if3 cmp3(str(actual), str(not_expected)) {
    return 1
  } maybe {
    print3("  FAIL: " + msg + " — should not equal " + str(not_expected))
    return -1
  } else3 {
    return 1
  }
}

// -- Assert truthy (trit == 1) --
fn ok3(value, msg) {
  if3 value {
    return 1
  } maybe {
    print3("  WARN: " + msg + " — got maybe")
    return 0
  } else3 {
    print3("  FAIL: " + msg + " — got falsy")
    return -1
  }
}

// -- Assert trit value exactly --
fn trit3(actual, expected_trit, msg) {
  if3 cmp3(actual, expected_trit) {
    print3("  FAIL: " + msg + " — expected trit " + str(expected_trit) + ", got " + str(actual))
    return -1
  } maybe {
    return 1
  } else3 {
    print3("  FAIL: " + msg + " — expected trit " + str(expected_trit) + ", got " + str(actual))
    return -1
  }
}

// -- Assert greater than --
fn gt3(actual, threshold, msg) {
  if3 cmp3(actual, threshold) {
    return -1
  } maybe {
    print3("  FAIL: " + msg + " — " + str(actual) + " not > " + str(threshold))
    return -1
  } else3 {
    return 1
  }
}

// -- Assert less than --
fn lt3(actual, threshold, msg) {
  if3 cmp3(actual, threshold) {
    return 1
  } maybe {
    print3("  FAIL: " + msg + " — " + str(actual) + " not < " + str(threshold))
    return -1
  } else3 {
    return -1
  }
}

// -- Assert contains substring --
fn has3(haystack, needle, msg) {
  if3 cmp3(contains(str(haystack), str(needle)), 1) {
    print3("  FAIL: " + msg + " — does not contain " + str(needle))
    return -1
  } maybe {
    return 1
  } else3 {
    print3("  FAIL: " + msg + " — does not contain " + str(needle))
    return -1
  }
}

// -- Print test summary --
fn summary3() {
  print3("=== Test Summary ===")
  print3("Total: " + str(_test_count))
  print3("Pass:  " + str(_test_pass))
  print3("Warn:  " + str(_test_warn))
  print3("Fail:  " + str(_test_fail))
  if3 cmp3(_test_fail, 0) {
    return {"total": _test_count, "pass": _test_pass, "warn": _test_warn, "fail": _test_fail, "trit": -1}
  } maybe {
    if3 cmp3(_test_warn, 0) {
      return {"total": _test_count, "pass": _test_pass, "warn": _test_warn, "fail": 0, "trit": 1}
    } maybe {
      return {"total": _test_count, "pass": _test_pass, "warn": 0, "fail": 0, "trit": 1}
    } else3 {
      return {"total": _test_count, "pass": _test_pass, "warn": _test_warn, "fail": 0, "trit": 0}
    }
  } else3 {
    if3 cmp3(_test_warn, 0) {
      return {"total": _test_count, "pass": _test_pass, "warn": _test_warn, "fail": 0, "trit": 0}
    } maybe {
      return {"total": _test_count, "pass": _test_pass, "warn": 0, "fail": 0, "trit": 1}
    } else3 {
      return {"total": _test_count, "pass": _test_pass, "warn": _test_warn, "fail": 0, "trit": 0}
    }
  }
}

export3 { test3, eq3, neq3, ok3, trit3, gt3, lt3, has3, summary3 }
