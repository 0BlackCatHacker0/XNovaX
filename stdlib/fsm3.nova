// ============================================================
// NOVALANG STDLIB: fsm3 — Ternary Finite State Machine
// ============================================================
// Usage: import3 fsm3
// Balanced ternary FSM framework: 3-way branching, Moore/Mealy
// modes, trit-vector state encoding, 37% fewer states than
// binary equivalent.
//
// State IDs are integers (balanced ternary decoded).
// Inputs are trits: -1, 0, +1.
// Outputs are trits: -1 (fail), 0 (neutral), +1 (success).
// ============================================================

import3 trit3
import3 time3

// -- Encode integer to balanced ternary trit vector --
// Returns list of trits, length = num_trits
fn to_trits3(value, num_trits) {
  let trits = []
  let v = value
  let i = 0
  while3 cmp3(i, num_trits) == -1 {
    let remainder = v % 3
    if3 cmp3(remainder, 2) {
      if3 cmp3(remainder, -1) {
        if3 cmp3(remainder, -2) {
          // remainder == -2 → trit = +1, carry -1
          let trits = append(trits, 1)
          let v = (v + 2) / 3
        } maybe {
          // remainder == -1 → trit = -1, carry 0... wait
          // Balanced ternary: we work with mod then adjust
          let trits = append(trits, remainder)
          let v = (v - remainder) / 3
        } else3 {
          let trits = append(trits, remainder)
          let v = (v - remainder) / 3
        }
      } maybe {
        // remainder == -1
        let trits = append(trits, -1)
        let v = (v + 1) / 3
      } else3 {
        // remainder == 0 or 1
        let trits = append(trits, remainder)
        let v = (v - remainder) / 3
      }
    } maybe {
      // remainder == 2 → trit = -1, carry +1
      let trits = append(trits, -1)
      let v = (v + 1) / 3
    } else3 {
      // remainder > 2 shouldn't happen in balanced ternary range
      let trits = append(trits, 0)
      let v = v / 3
    }
    let i = i + 1
  }
  return trits
}

// -- Decode trit vector to integer --
fn from_trits3(trits) {
  let value = 0
  let power = 1
  let i = 0
  while3 cmp3(i, len(trits)) == -1 {
    let value = value + (trits[i] * power)
    let power = power * 3
    let i = i + 1
  }
  return value
}

// -- Create a new TFSM --
// mode: "moore" or "mealy"
// num_trits: number of trits for state encoding (2=9 states, 3=27 states)
fn tfsm_new3(name, mode, num_trits) {
  return {
    "name": name,
    "mode": mode,
    "num_trits": num_trits,
    "max_states": pow3(3, num_trits),
    "states": {},
    "transitions": {},
    "outputs_moore": {},
    "outputs_mealy": {},
    "current": 0,
    "history": [],
    "history_max": 243
  }
}

// -- Simple integer power --
fn pow3(base, exp) {
  let result = 1
  let i = 0
  while3 cmp3(i, exp) == -1 {
    let result = result * base
    let i = i + 1
  }
  return result
}

// -- Add a state to the FSM --
// output: trit output for Moore mode (-1, 0, +1)
fn tfsm_add_state3(fsm, state_id, label, output) {
  let states = dict_get(fsm, "states") ?? {}
  let key = str(state_id)
  let states = dict_set(states, key, {
    "id": state_id,
    "label": label,
    "output": output
  })
  let fsm = dict_set(fsm, "states", states)

  // Set Moore output
  let outputs = dict_get(fsm, "outputs_moore") ?? {}
  let outputs = dict_set(outputs, key, output)
  let fsm = dict_set(fsm, "outputs_moore", outputs)

  return fsm
}

// -- Add a transition --
// from_state: state ID, input: trit (-1/0/+1), to_state: state ID
// mealy_output: output for Mealy mode (optional, defaults to 0)
fn tfsm_add_transition3(fsm, from_state, input, to_state, mealy_output) {
  let transitions = dict_get(fsm, "transitions") ?? {}
  let from_key = str(from_state)
  let state_trans = dict_get(transitions, from_key) ?? {}

  let input_key = str(input)
  let state_trans = dict_set(state_trans, input_key, to_state)
  let transitions = dict_set(transitions, from_key, state_trans)
  let fsm = dict_set(fsm, "transitions", transitions)

  // Mealy output
  let mealy = dict_get(fsm, "outputs_mealy") ?? {}
  let mealy_key = from_key + ":" + input_key
  let mealy = dict_set(mealy, mealy_key, mealy_output)
  let fsm = dict_set(fsm, "outputs_mealy", mealy)

  return fsm
}

// -- Set current state --
fn tfsm_set_state3(fsm, state_id) {
  return dict_set(fsm, "current", state_id)
}

// -- Get current state info --
fn tfsm_current3(fsm) {
  let current = dict_get(fsm, "current") ?? 0
  let states = dict_get(fsm, "states") ?? {}
  let key = str(current)
  let state_def = dict_get(states, key, {"id": current, "label": "UNKNOWN", "output": 0})
  return state_def
}

// -- Step the FSM: apply input trit, return {from, to, input, output} --
fn tfsm_step3(fsm, input) {
  let current = dict_get(fsm, "current") ?? 0
  let from_key = str(current)
  let input_key = str(input)

  // Look up transition
  let transitions = dict_get(fsm, "transitions") ?? {}
  let state_trans = dict_get(transitions, from_key) ?? {}
  let next_state = dict_get(state_trans, input_key) ?? current

  // Determine output
  let mode = dict_get(fsm, "mode") ?? "moore"
  let output = 0
  if3 cmp3(mode, "mealy") {
    // Mealy: output from transition
    let mealy = dict_get(fsm, "outputs_mealy") ?? {}
    let mealy_key = from_key + ":" + input_key
    let output = dict_get(mealy, mealy_key) ?? 0
  } maybe {
    // Moore: output from destination state
    let outputs = dict_get(fsm, "outputs_moore") ?? {}
    let to_key = str(next_state)
    let output = dict_get(outputs, to_key) ?? 0
  } else3 {
    let outputs = dict_get(fsm, "outputs_moore") ?? {}
    let to_key = str(next_state)
    let output = dict_get(outputs, to_key) ?? 0
  }

  // Build transition record
  let record = {
    "from": current,
    "to": next_state,
    "input": input,
    "output": output,
    "timestamp": time_now()
  }

  // Update FSM state
  let fsm = dict_set(fsm, "current", next_state)

  // Append to history (bounded)
  let history = dict_get(fsm, "history") ?? []
  let history = append(history, record)
  let max_h = dict_get(fsm, "history_max") ?? 243
  if3 cmp3(len(history), max_h) {
    // trim
  } maybe {
    let history = slice(history, len(history) - 91, len(history))
  } else3 {
    let history = slice(history, len(history) - 91, len(history))
  }
  let fsm = dict_set(fsm, "history", history)

  return {"fsm": fsm, "record": record}
}

// -- Run a sequence of inputs, return list of transition records --
fn tfsm_run3(fsm, inputs) {
  let records = []
  let machine = fsm
  for3 input in inputs {
    let result = tfsm_step3(machine, input)
    let machine = result["fsm"]
    let records = append(records, result["record"])
  }
  return {"fsm": machine, "records": records}
}

// -- Get current output trit --
fn tfsm_output3(fsm) {
  let current = dict_get(fsm, "current") ?? 0
  let mode = dict_get(fsm, "mode") ?? "moore"
  let outputs = dict_get(fsm, "outputs_moore") ?? {}
  let key = str(current)
  return dict_get(outputs, key) ?? 0
}

// -- Get state label for a state ID --
fn tfsm_label3(fsm, state_id) {
  let states = dict_get(fsm, "states") ?? {}
  let key = str(state_id)
  let state_def = dict_get(states, key) ?? {"label": "UNKNOWN"}
  return state_def["label"]
}

// -- Get transition history --
fn tfsm_history3(fsm) {
  return dict_get(fsm, "history") ?? []
}

// -- Validate FSM completeness: every state has 3 transitions --
fn tfsm_validate3(fsm) {
  let states = dict_get(fsm, "states") ?? {}
  let transitions = dict_get(fsm, "transitions") ?? {}
  let state_keys = dict_keys(states)
  let missing = []
  let complete = 1

  for3 key in state_keys {
    let state_trans = dict_get(transitions, key) ?? {}
    let has_neg = dict_get(state_trans, "-1") ?? "NONE"
    let has_zero = dict_get(state_trans, "0") ?? "NONE"
    let has_pos = dict_get(state_trans, "1") ?? "NONE"

    if3 cmp3(has_neg, "NONE") {
      // has it
    } maybe {
      let missing = append(missing, key + ":-1")
      let complete = -1
    } else3 {
      // has it
    }
    if3 cmp3(has_zero, "NONE") {
    } maybe {
      let missing = append(missing, key + ":0")
      let complete = -1
    } else3 {
    }
    if3 cmp3(has_pos, "NONE") {
    } maybe {
      let missing = append(missing, key + ":+1")
      let complete = -1
    } else3 {
    }
  }

  return {
    "trit": complete,
    "total_states": len(state_keys),
    "total_transitions": len(state_keys) * 3,
    "missing": missing
  }
}

// -- State encoding efficiency comparison --
fn tfsm_efficiency3(num_states) {
  // Binary bits needed
  let binary_bits = 1
  let binary_capacity = 2
  while3 cmp3(binary_capacity, num_states) == -1 {
    let binary_bits = binary_bits + 1
    let binary_capacity = binary_capacity * 2
  }

  // Ternary trits needed
  let ternary_trits = 1
  let ternary_capacity = 3
  while3 cmp3(ternary_capacity, num_states) == -1 {
    let ternary_trits = ternary_trits + 1
    let ternary_capacity = ternary_capacity * 3
  }

  // Transition table sizes
  let binary_transitions = num_states * 2
  let ternary_transitions = num_states * 3

  // But ternary needs fewer states for same behavior space
  // because each state branches 3 ways instead of 2
  let ternary_equivalent_states = ternary_capacity
  let binary_equivalent_states = binary_capacity

  let savings_pct = ((binary_bits - ternary_trits) * 100) / binary_bits

  return {
    "num_states": num_states,
    "binary_bits": binary_bits,
    "binary_capacity": binary_capacity,
    "binary_waste": binary_capacity - num_states,
    "ternary_trits": ternary_trits,
    "ternary_capacity": ternary_capacity,
    "ternary_waste": ternary_capacity - num_states,
    "encoding_savings_pct": savings_pct,
    "binary_transitions": binary_transitions,
    "ternary_transitions": ternary_transitions,
    "trit": 1
  }
}

// ============================================================
// PREBUILT: NovaX Service Lifecycle TFSM (2-trit, 9 states)
// ============================================================

// -- Create the canonical NovaX service lifecycle FSM --
fn tfsm_service_lifecycle3() {
  let fsm = tfsm_new3("NovaX-Service-Lifecycle", "moore", 2)

  // 9 states: from -4 (FATAL) to +4 (PEAK)
  // Output trit = health class: -1=unhealthy, 0=transitional, +1=healthy
  let fsm = tfsm_add_state3(fsm, -4, "FATAL",         -1)
  let fsm = tfsm_add_state3(fsm, -3, "ERROR",         -1)
  let fsm = tfsm_add_state3(fsm, -2, "DEGRADED",      -1)
  let fsm = tfsm_add_state3(fsm, -1, "SHUTTING_DOWN",   0)
  let fsm = tfsm_add_state3(fsm,  0, "IDLE",            0)
  let fsm = tfsm_add_state3(fsm,  1, "BOOTING",         0)
  let fsm = tfsm_add_state3(fsm,  2, "WARM_STANDBY",    1)
  let fsm = tfsm_add_state3(fsm,  3, "ACTIVE",          1)
  let fsm = tfsm_add_state3(fsm,  4, "PEAK",            1)

  // Transition table: [from_state, input, to_state]
  // Input -1 = failure signal, 0 = neutral/tick, +1 = success signal

  // FATAL: only +1 can begin recovery
  let fsm = tfsm_add_transition3(fsm, -4, -1, -4, -1)
  let fsm = tfsm_add_transition3(fsm, -4,  0, -4,  0)
  let fsm = tfsm_add_transition3(fsm, -4,  1, -3,  0)

  // ERROR: fail→FATAL, neutral holds, success→DEGRADED
  let fsm = tfsm_add_transition3(fsm, -3, -1, -4, -1)
  let fsm = tfsm_add_transition3(fsm, -3,  0, -3,  0)
  let fsm = tfsm_add_transition3(fsm, -3,  1, -2,  0)

  // DEGRADED: fail→ERROR, neutral holds, success→IDLE
  let fsm = tfsm_add_transition3(fsm, -2, -1, -3, -1)
  let fsm = tfsm_add_transition3(fsm, -2,  0, -2,  0)
  let fsm = tfsm_add_transition3(fsm, -2,  1,  0,  1)

  // SHUTTING_DOWN: fail→ERROR, neutral→IDLE, success→IDLE
  let fsm = tfsm_add_transition3(fsm, -1, -1, -3, -1)
  let fsm = tfsm_add_transition3(fsm, -1,  0,  0,  0)
  let fsm = tfsm_add_transition3(fsm, -1,  1,  0,  1)

  // IDLE: fail→SHUTTING_DOWN, neutral holds, success→BOOTING
  let fsm = tfsm_add_transition3(fsm,  0, -1, -1,  0)
  let fsm = tfsm_add_transition3(fsm,  0,  0,  0,  0)
  let fsm = tfsm_add_transition3(fsm,  0,  1,  1,  1)

  // BOOTING: fail→ERROR, neutral→IDLE, success→WARM_STANDBY
  let fsm = tfsm_add_transition3(fsm,  1, -1, -3, -1)
  let fsm = tfsm_add_transition3(fsm,  1,  0,  0,  0)
  let fsm = tfsm_add_transition3(fsm,  1,  1,  2,  1)

  // WARM_STANDBY: fail→DEGRADED, neutral→IDLE, success→ACTIVE
  let fsm = tfsm_add_transition3(fsm,  2, -1, -2, -1)
  let fsm = tfsm_add_transition3(fsm,  2,  0,  0,  0)
  let fsm = tfsm_add_transition3(fsm,  2,  1,  3,  1)

  // ACTIVE: fail→DEGRADED, neutral→WARM_STANDBY, success→PEAK
  let fsm = tfsm_add_transition3(fsm,  3, -1, -2, -1)
  let fsm = tfsm_add_transition3(fsm,  3,  0,  2,  0)
  let fsm = tfsm_add_transition3(fsm,  3,  1,  4,  1)

  // PEAK: fail→ACTIVE, neutral→ACTIVE, success stays PEAK
  let fsm = tfsm_add_transition3(fsm,  4, -1,  3, -1)
  let fsm = tfsm_add_transition3(fsm,  4,  0,  3,  0)
  let fsm = tfsm_add_transition3(fsm,  4,  1,  4,  1)

  // Start at IDLE
  let fsm = tfsm_set_state3(fsm, 0)

  return fsm
}

// -- Get health class label from output trit --
fn tfsm_health_label3(output) {
  if3 cmp3(output, 0) {
    return "UNHEALTHY"
  } maybe {
    return "TRANSITIONAL"
  } else3 {
    return "HEALTHY"
  }
}

export3 { to_trits3, from_trits3, pow3 }
export3 { tfsm_new3, tfsm_add_state3, tfsm_add_transition3, tfsm_set_state3 }
export3 { tfsm_current3, tfsm_step3, tfsm_run3, tfsm_output3 }
export3 { tfsm_label3, tfsm_history3, tfsm_validate3, tfsm_efficiency3 }
export3 { tfsm_service_lifecycle3, tfsm_health_label3 }
