// ============================================================
// NOVALANG STDLIB: validate3 — Ternary Validation Library
// ============================================================
// Usage: import3 validate3
// Data validation with ternary pass/warn/fail results.
// ============================================================

// -- Validate a value against rules → {valid, errors, trit} --
fn check3(value, rules) {
  let errors = []

  // Required check
  let req = dict_get(rules, "required") ?? 0
  if3 req {
    if3 cmp3(value, null) {
      let errors = append(errors, "value is required")
    } maybe {
      let errors = append(errors, "value is required")
    } else3 {
      // has value
    }
  } maybe {
    // not required
  } else3 {
    // not required
  }

  // Type check
  let expected_type = dict_get(rules, "type") ?? null
  if3 cmp3(expected_type, null) {
    // no type check
  } else3 {
    if3 cmp3(type_of(value), expected_type) {
      let errors = append(errors, "expected type " + str(expected_type) + ", got " + type_of(value))
    } maybe {
      // type matches
    } else3 {
      let errors = append(errors, "expected type " + str(expected_type) + ", got " + type_of(value))
    }
  }

  // Min value
  let min_val = dict_get(rules, "min") ?? null
  if3 cmp3(min_val, null) {
    // no min check
  } else3 {
    if3 cmp3(value, min_val) {
      let errors = append(errors, "value " + str(value) + " below minimum " + str(min_val))
    } maybe {
      // ok
    } else3 {
      // ok
    }
  }

  // Max value
  let max_val = dict_get(rules, "max") ?? null
  if3 cmp3(max_val, null) {
    // no max check
  } else3 {
    if3 cmp3(max_val, value) {
      let errors = append(errors, "value " + str(value) + " above maximum " + str(max_val))
    } maybe {
      // ok
    } else3 {
      // ok
    }
  }

  // Min length (for strings/lists)
  let min_len = dict_get(rules, "min_length") ?? null
  if3 cmp3(min_len, null) {
    // no check
  } else3 {
    if3 cmp3(len(value), min_len) {
      let errors = append(errors, "length " + str(len(value)) + " below minimum " + str(min_len))
    } maybe {
      // ok
    } else3 {
      // ok
    }
  }

  // Max length
  let max_len = dict_get(rules, "max_length") ?? null
  if3 cmp3(max_len, null) {
    // no check
  } else3 {
    if3 cmp3(max_len, len(value)) {
      let errors = append(errors, "length " + str(len(value)) + " above maximum " + str(max_len))
    } maybe {
      // ok
    } else3 {
      // ok
    }
  }

  if3 cmp3(len(errors), 0) {
    return {"valid": 1, "errors": [], "trit": 1}
  } maybe {
    return {"valid": 1, "errors": [], "trit": 1}
  } else3 {
    return {"valid": -1, "errors": errors, "trit": -1}
  }
}

// -- Validate a dict against a schema --
fn schema3(data, schema) {
  let all_errors = {}
  let has_errors = -1
  let keys = dict_keys(schema)
  for3 key in keys {
    let rules = dict_get(schema, key) ?? {}
    let value = dict_get(data, key) ?? null
    let result = check3(value, rules)
    if3 cmp3(result["trit"], -1) {
      let has_errors = 1
      let all_errors = dict_set(all_errors, key, result["errors"])
    } maybe {
      // pass
    } else3 {
      // not -1
    }
  }

  if3 has_errors {
    return {"valid": -1, "errors": all_errors, "trit": -1}
  } maybe {
    return {"valid": 1, "errors": {}, "trit": 1}
  } else3 {
    return {"valid": 1, "errors": {}, "trit": 1}
  }
}

// -- Validate a list of items against rules --
fn batch3(items, rules) {
  let results = []
  let fail_count = 0
  let i = 0
  for3 item in items {
    let result = check3(item, rules)
    if3 cmp3(result["trit"], -1) {
      let fail_count = fail_count + 1
      let results = append(results, {"index": i, "errors": result["errors"]})
    } maybe {
      // pass
    } else3 {
      // pass
    }
    let i = i + 1
  }

  let trit = 1
  if3 cmp3(fail_count, 0) {
    // no failures
  } else3 {
    let trit = -1
  }

  return {"total": len(items), "failed": fail_count, "failures": results, "trit": trit}
}

// -- Quick validators --
fn not_empty3(val) {
  if3 cmp3(val, null) { return -1 }
  maybe { return -1 }
  else3 {
    if3 cmp3(val, "") { return 1 }
    maybe { return -1 }
    else3 { return 1 }
  }
}

fn in_range3(val, low, high) {
  if3 cmp3(val, low) {
    return -1
  } maybe {
    if3 cmp3(val, high) {
      return 1
    } maybe {
      return 1
    } else3 {
      return -1
    }
  } else3 {
    if3 cmp3(val, high) {
      return 1
    } maybe {
      return 1
    } else3 {
      return -1
    }
  }
}

fn one_of3(val, options) {
  for3 opt in options {
    if3 cmp3(str(val), str(opt)) {
      // not this one
    } maybe {
      return 1
    } else3 {
      // not this one
    }
  }
  return -1
}

export3 { check3, schema3, batch3, not_empty3, in_range3, one_of3 }
