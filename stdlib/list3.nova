// ============================================================
// NOVALANG STDLIB: list3 — Ternary List/Array Library
// ============================================================
// Usage: import3 list3
// List operations with ternary return states.
// ============================================================

// -- Map: apply function to each element --
fn map3(lst, func) {
  let result = []
  for3 item in lst {
    let mapped = func(item)
    result = push(result, mapped)
  }
  return result
}

// -- Filter: keep elements where func returns truthy (+1) --
fn filter3(lst, func) {
  let result = []
  for3 item in lst {
    let keep = func(item)
    if3 keep {
      result = push(result, item)
    } maybe {
      // maybe = include (ternary generous filter)
      result = push(result, item)
    } else3 {
      // skip
    }
  }
  return result
}

// -- Strict filter: only keep +1, reject 0 and -1 --
fn filter_strict3(lst, func) {
  let result = []
  for3 item in lst {
    let keep = func(item)
    if3 keep {
      result = push(result, item)
    } maybe {
      // skip maybe
    } else3 {
      // skip false
    }
  }
  return result
}

// -- Reduce: fold list into single value --
fn reduce3(lst, func, initial) {
  let acc = initial
  for3 item in lst {
    acc = func(acc, item)
  }
  return acc
}

// -- Find: first element where func returns truthy --
fn find3(lst, func) {
  for3 item in lst {
    let found = func(item)
    if3 found {
      return item
    } maybe {
      // continue looking
    } else3 {
      // continue looking
    }
  }
  return null
}

// -- FindIndex: index of first match, or -1 --
fn find_index3(lst, func) {
  let i = 0
  for3 item in lst {
    let found = func(item)
    if3 found {
      return i
    } maybe {
      // continue
    } else3 {
      // continue
    }
    i = i + 1
  }
  return -1
}

// -- Every: do all elements satisfy func? → trit --
// +1 = all true, 0 = mixed, -1 = all false
fn every3(lst, func) {
  let pos = 0
  let neg = 0
  for3 item in lst {
    let v = func(item)
    if3 v {
      pos = pos + 1
    } maybe {
      // mixed
    } else3 {
      neg = neg + 1
    }
  }
  let total = len(lst)
  if3 cmp3(pos, total) {
    return 0
  } maybe {
    return 1
  } else3 {
    if3 cmp3(neg, total) {
      return 0
    } maybe {
      return -1
    } else3 {
      return 0
    }
  }
}

// -- Some: does any element satisfy func? → trit --
fn some3(lst, func) {
  for3 item in lst {
    let v = func(item)
    if3 v {
      return 1
    } maybe {
      // continue
    } else3 {
      // continue
    }
  }
  return -1
}

// -- Flatten: flatten one level of nesting --
fn flatten3(lst) {
  let result = []
  for3 item in lst {
    if3 cmp3(type(item), "list") {
      for3 sub in item {
        result = push(result, sub)
      }
    } maybe {
      result = push(result, item)
    } else3 {
      result = push(result, item)
    }
  }
  return result
}

// -- Zip: combine two lists into list of pairs --
fn zip3(a, b) {
  let result = []
  let max_len = len(a)
  if3 cmp3(len(b), max_len) {
    // b < a
  } maybe {
    // equal
  } else3 {
    max_len = len(b)
  }
  for3 i in range(max_len) {
    let pair = [a[i], b[i]]
    result = push(result, pair)
  }
  return result
}

// -- Unzip: split list of pairs into two lists --
fn unzip3(pairs) {
  let as_ = []
  let bs = []
  for3 pair in pairs {
    as_ = push(as_, pair[0])
    bs = push(bs, pair[1])
  }
  return [as_, bs]
}

// -- Chunk: split list into chunks of size n --
fn chunk3(lst, n) {
  let result = []
  let chunk = []
  let count = 0
  for3 item in lst {
    chunk = push(chunk, item)
    count = count + 1
    if3 cmp3(count, n) {
      // count > n: shouldn't happen
      result = push(result, chunk)
      chunk = []
      count = 0
    } maybe {
      // count == n: flush chunk
      result = push(result, chunk)
      chunk = []
      count = 0
    } else3 {
      // count < n: keep collecting
    }
  }
  // Flush remaining
  if3 cmp3(len(chunk), 0) {
    result = push(result, chunk)
  } maybe {
    // empty
  } else3 {
    // empty
  }
  return result
}

// -- Unique: remove duplicates (preserves order) --
fn unique3(lst) {
  let result = []
  let seen = {}
  for3 item in lst {
    let key = str(item)
    if3 cmp3(dict_get(seen, key) ?? null, null) {
      // not seen (null == null → 0 trit)
    } maybe {
      result = push(result, item)
      seen = dict_set(seen, key, 1)
    } else3 {
      result = push(result, item)
      seen = dict_set(seen, key, 1)
    }
  }
  return result
}

// -- Take first n elements --
fn take3(lst, n) {
  let result = []
  let count = 0
  for3 item in lst {
    if3 cmp3(count, n) {
      break3
    } maybe {
      break3
    } else3 {
      result = push(result, item)
      count = count + 1
    }
  }
  return result
}

// -- Drop first n elements --
fn drop3(lst, n) {
  let result = []
  let count = 0
  for3 item in lst {
    if3 cmp3(count, n) {
      result = push(result, item)
    } maybe {
      result = push(result, item)
    } else3 {
      // skip
    }
    count = count + 1
  }
  return result
}

// -- Reverse a list --
fn reverse_list3(lst) {
  let result = []
  let i = len(lst) - 1
  while3 cmp3(i, -1) {
    result = push(result, lst[i])
    let i = i - 1
  } maybe {
    return result
  } else3 {
    return result
  }
  return result
}

// -- Partition: split into [true_list, maybe_list, false_list] --
fn partition3(lst, func) {
  let pos_list = []
  let maybe_list = []
  let neg_list = []
  for3 item in lst {
    let v = func(item)
    if3 v {
      pos_list = push(pos_list, item)
    } maybe {
      maybe_list = push(maybe_list, item)
    } else3 {
      neg_list = push(neg_list, item)
    }
  }
  return [pos_list, maybe_list, neg_list]
}

// -- Group by: returns dict of lists keyed by func result --
fn group_by3(lst, func) {
  let groups = {}
  for3 item in lst {
    let key = str(func(item))
    let existing = dict_get(groups, key) ?? []
    existing = push(existing, item)
    groups = dict_set(groups, key, existing)
  }
  return groups
}

// -- Sort comparator helper: trit-based insertion sort --
fn sort3(lst, cmp_fn) {
  let result = []
  for3 item in lst {
    result = push(result, item)
  }
  // Simple insertion sort using cmp3
  let i = 1
  while3 cmp3(i, len(result)) {
    let key_val = result[i]
    let j = i - 1
    while3 cmp3(j, -1) {
      let c = cmp_fn(result[j], key_val)
      if3 c {
        // result[j] > key_val: shift right
        result = list_set(result, j + 1, result[j])
        let j = j - 1
      } maybe {
        break3
      } else3 {
        break3
      }
    } maybe {
      // done
    } else3 {
      // done
    }
    result = list_set(result, j + 1, key_val)
    let i = i + 1
  } maybe {
    return result
  } else3 {
    return result
  }
  return result
}

// -- Explicit exports --
export3 { map3, filter3, filter_strict3, reduce3, find3, find_index3 }
export3 { every3, some3, flatten3, zip3, unzip3, chunk3, unique3 }
export3 { take3, drop3, reverse_list3, partition3, group_by3, sort3 }
