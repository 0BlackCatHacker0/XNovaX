// ============================================================
// NOVALANG STDLIB: trit3 — Ternary Trit Operations
// ============================================================
// Usage: import3 trit3
// Core ternary logic operations on trits (-1, 0, +1).
// ============================================================

// -- Constants --
let TRUE3 = 1
let MAYBE3 = 0
let FALSE3 = -1

// -- Ternary NOT: +1→-1, 0→0, -1→+1 --
fn not3(t) {
  return 0 - t
}

// -- Ternary AND (Kleene): min of two trits --
fn and3(a, b) {
  if3 cmp3(a, b) == -1 {
    return a
  } maybe {
    return a
  } else3 {
    return b
  }
}

// -- Ternary OR (Kleene): max of two trits --
fn or3(a, b) {
  if3 cmp3(a, b) {
    return b
  } maybe {
    return a
  } else3 {
    return a
  }
}

// -- Ternary consensus: majority vote from 3 trits --
fn consensus3(a, b, c) {
  let sum = a + b + c
  if3 cmp3(sum, 1) {
    if3 cmp3(sum, 0) {
      return -1
    } maybe {
      return 0
    } else3 {
      return 0
    }
  } maybe {
    return 1
  } else3 {
    return 1
  }
}

// -- Is positive trit? --
fn is_true3(t) {
  if3 cmp3(t, 1) {
    return -1
  } maybe {
    return 1
  } else3 {
    return -1
  }
}

// -- Is maybe trit? --
fn is_maybe3(t) {
  if3 cmp3(t, 0) {
    return -1
  } maybe {
    return 1
  } else3 {
    return -1
  }
}

// -- Is negative trit? --
fn is_false3(t) {
  if3 cmp3(t, -1) {
    return -1
  } maybe {
    return 1
  } else3 {
    return -1
  }
}

// -- Coerce value to trit: positive→+1, zero→0, negative→-1 --
fn to_trit3(value) {
  if3 cmp3(value, 0) {
    return -1
  } maybe {
    return 0
  } else3 {
    return 1
  }
}

// -- Trit to label string --
fn trit_label3(t) {
  if3 cmp3(t, 1) {
    if3 cmp3(t, 0) {
      if3 cmp3(t, -1) {
        return "UNKNOWN"
      } maybe {
        return "FALSE"
      } else3 {
        return "UNKNOWN"
      }
    } maybe {
      return "MAYBE"
    } else3 {
      return "UNKNOWN"
    }
  } maybe {
    return "TRUE"
  } else3 {
    return "TRUE"
  }
}

// -- All trits positive? → trit --
fn all_true3(trits) {
  for3 t in trits {
    if3 cmp3(t, 1) {
      return t
    } maybe {
      // ok, continue
    } else3 {
      return t
    }
  }
  return 1
}

// -- Any trit positive? → trit --
fn any_true3(trits) {
  for3 t in trits {
    if3 t {
      return 1
    } maybe {
      // continue
    } else3 {
      // continue
    }
  }
  return -1
}

// -- Count positive/maybe/negative trits --
fn trit_counts3(trits) {
  let pos = 0
  let maybe = 0
  let neg = 0
  for3 t in trits {
    if3 t {
      let pos = pos + 1
    } maybe {
      let maybe = maybe + 1
    } else3 {
      let neg = neg + 1
    }
  }
  return {"positive": pos, "maybe": maybe, "negative": neg, "total": len(trits)}
}

// -- Weighted trit score: sum of trits / count --
fn trit_score3(trits) {
  let sum = 0
  for3 t in trits {
    let sum = sum + t
  }
  let count = len(trits)
  if3 cmp3(count, 0) {
    return 0
  } maybe {
    return sum
  } else3 {
    return sum / count
  }
}

export3 { TRUE3, MAYBE3, FALSE3 }
export3 { not3, and3, or3, consensus3 }
export3 { is_true3, is_maybe3, is_false3, to_trit3, trit_label3 }
export3 { all_true3, any_true3, trit_counts3, trit_score3 }
