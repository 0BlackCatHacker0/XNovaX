// ============================================================
// NOVALANG STDLIB: io3 — Ternary I/O Library
// ============================================================
// Usage: import3 io3
// File and network I/O with ternary states.
// ============================================================

// -- Read entire file → {content, trit} --
fn read_file3(path) {
  try3 {
    let content = http_get("file:///" + path)
    return {"content": content, "trit": 1}
  } uncertain {
    return {"content": "", "trit": 0, "error": "partial read"}
  } fail3 {
    return {"content": null, "trit": -1, "error": "file not found or unreadable"}
  }
}

// -- Write file via nova_tools --
fn write_file3(path, content) {
  try3 {
    let resp = http_post("http://127.0.0.1:9891/write", {"path": path, "content": content})
    return {"trit": 1, "path": path}
  } uncertain {
    return {"trit": 0, "error": "partial write"}
  } fail3 {
    return {"trit": -1, "error": "write failed"}
  }
}

// -- HTTP GET with ternary result --
fn fetch3(url) {
  try3 {
    let resp = http_get(url)
    return {"data": resp, "trit": 1}
  } uncertain {
    return {"data": null, "trit": 0, "error": "timeout or partial"}
  } fail3 {
    return {"data": null, "trit": -1, "error": "fetch failed"}
  }
}

// -- HTTP POST with ternary result --
fn post3(url, body) {
  try3 {
    let resp = http_post(url, body)
    return {"data": resp, "trit": 1}
  } uncertain {
    return {"data": null, "trit": 0, "error": "timeout or partial"}
  } fail3 {
    return {"data": null, "trit": -1, "error": "post failed"}
  }
}

// -- Query a NovaX service by port --
fn service_call3(port, path, body) {
  let url = "http://127.0.0.1:" + str(port) + path
  try3 {
    let resp = http_post(url, body)
    return {"data": resp, "trit": 1}
  } uncertain {
    return {"data": null, "trit": 0, "error": "service degraded"}
  } fail3 {
    return {"data": null, "trit": -1, "error": "service unreachable"}
  }
}

// -- Check service health → trit --
fn ping3(port) {
  let url = "http://127.0.0.1:" + str(port) + "/health"
  try3 {
    let resp = http_get(url)
    return 1
  } uncertain {
    return 0
  } fail3 {
    return -1
  }
}

// -- Log to console --
fn log3(level, msg) {
  print("[" + level + "] " + msg)
  return 1
}

export3 { read_file3, write_file3, fetch3, post3, service_call3, ping3, log3 }
