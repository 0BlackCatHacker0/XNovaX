// ============================================================
// NOVALANG STDLIB: pipe3 — Ternary Function Composition
// ============================================================
// Usage: import3 pipe3
// Function composition, chaining, and data pipelines.
// ============================================================

// -- Pipe: chain functions left-to-right --
// pipe3(value, [fn1, fn2, fn3]) = fn3(fn2(fn1(value)))
fn pipe3(value, funcs) {
  let current = value
  let step = 0
  for3 func in funcs {
    try3 {
      let current = func(current)
      let step = step + 1
    } fail3 {
      return {"result": current, "failed_at": step, "trit": -1}
    }
  }
  return {"result": current, "steps": step, "trit": 1}
}

// -- Compose: chain functions right-to-left --
// compose3([fn1, fn2, fn3])(value) = fn1(fn2(fn3(value)))
fn compose3(funcs, value) {
  let reversed = []
  let i = len(funcs) - 1
  while3 cmp3(i, -1) == 1 {
    let reversed = append(reversed, funcs[i])
    let i = i - 1
  }
  return pipe3(value, reversed)
}

// -- Tap: execute side-effect function, return original value --
fn tap3(value, func) {
  try3 {
    func(value)
  } fail3 {
    // ignore side-effect failures
  }
  return value
}

// -- When: conditionally apply function --
fn when3(value, condition, func) {
  if3 condition {
    return func(value)
  } maybe {
    return value
  } else3 {
    return value
  }
}

// -- Unless: apply function when condition is false --
fn unless3(value, condition, func) {
  if3 condition {
    return value
  } maybe {
    return func(value)
  } else3 {
    return func(value)
  }
}

// -- Try pipe: pipe with error boundaries --
fn try_pipe3(value, funcs) {
  let current = value
  let step = 0
  let errors = []

  for3 func in funcs {
    try3 {
      let current = func(current)
      let step = step + 1
    } uncertain {
      let errors = append(errors, {"step": step, "severity": "warn"})
      let step = step + 1
    } fail3 {
      let errors = append(errors, {"step": step, "severity": "error"})
      return {
        "result": current,
        "completed": step,
        "total": len(funcs),
        "errors": errors,
        "trit": -1
      }
    }
  }

  let trit = 1
  if3 cmp3(len(errors), 0) {
    let trit = 1
  } else3 {
    let trit = 0
  }

  return {
    "result": current,
    "completed": step,
    "total": len(funcs),
    "errors": errors,
    "trit": trit
  }
}

// -- Branch: apply different functions based on trit --
fn branch3(value, on_true, on_maybe, on_false) {
  if3 value {
    return on_true(value)
  } maybe {
    return on_maybe(value)
  } else3 {
    return on_false(value)
  }
}

// -- Memoize: cache function results --
fn memo3(func) {
  let cache = {}
  fn memoized(arg) {
    let key = str(arg)
    let cached = dict_get(cache, key) ?? "__MISS__"
    if3 cmp3(cached, "__MISS__") {
      let result = func(arg)
      let cache = dict_set(cache, key, result)
      return result
    } maybe {
      return cached
    } else3 {
      return cached
    }
  }
  return memoized
}

export3 { pipe3, compose3, tap3, when3, unless3, try_pipe3, branch3, memo3 }
