// ============================================================
// NOVALANG STDLIB: dict3 — Ternary Dictionary Library
// ============================================================
// Usage: import3 dict3
// ============================================================

// -- Get with default, returns trit-aware result --
fn dget3(d, key, default_val) {
  let val = dict_get(d, key) ?? null
  if3 cmp3(val, null) {
    return default_val
  } maybe {
    return default_val
  } else3 {
    return val
  }
}

// -- Check if key exists → trit --
fn has_key3(d, key) {
  let val = dict_get(d, key) ?? "__MISSING__"
  if3 cmp3(val, "__MISSING__") {
    return -1
  } maybe {
    return 1
  } else3 {
    return 1
  }
}

// -- Get all keys as list --
fn keys3(d) {
  return dict_keys(d)
}

// -- Get all values as list --
fn values3(d) {
  return dict_values(d)
}

// -- Merge two dicts (b overwrites a) --
fn merge3(a, b) {
  let result = a
  let b_keys = dict_keys(b)
  for3 key in b_keys {
    result = dict_set(result, key, dict_get(b, key) ?? null)
  }
  return result
}

// -- Pick: select only specified keys --
fn pick3(d, key_list) {
  let result = {}
  for3 key in key_list {
    let val = dict_get(d, key) ?? "__MISSING__"
    if3 cmp3(val, "__MISSING__") {
      // skip missing
    } maybe {
      result = dict_set(result, key, val)
    } else3 {
      result = dict_set(result, key, val)
    }
  }
  return result
}

// -- Omit: remove specified keys --
fn omit3(d, key_list) {
  let result = {}
  let all_keys = dict_keys(d)
  for3 key in all_keys {
    let should_omit = -1
    for3 omit_key in key_list {
      if3 cmp3(key, omit_key) {
        // not equal
      } maybe {
        should_omit = 1
      } else3 {
        // not equal
      }
    }
    if3 should_omit {
      // skip
    } maybe {
      result = dict_set(result, key, dict_get(d, key) ?? null)
    } else3 {
      result = dict_set(result, key, dict_get(d, key) ?? null)
    }
  }
  return result
}

// -- Map values: apply func to each value --
fn map_values3(d, func) {
  let result = {}
  let all_keys = dict_keys(d)
  for3 key in all_keys {
    let val = dict_get(d, key) ?? null
    result = dict_set(result, key, func(val))
  }
  return result
}

// -- Filter entries: keep where func(key, value) is truthy --
fn filter_dict3(d, func) {
  let result = {}
  let all_keys = dict_keys(d)
  for3 key in all_keys {
    let val = dict_get(d, key) ?? null
    let keep = func(key, val)
    if3 keep {
      result = dict_set(result, key, val)
    } maybe {
      result = dict_set(result, key, val)
    } else3 {
      // skip
    }
  }
  return result
}

// -- Invert: swap keys and values --
fn invert3(d) {
  let result = {}
  let all_keys = dict_keys(d)
  for3 key in all_keys {
    let val = str(dict_get(d, key) ?? null)
    result = dict_set(result, val, key)
  }
  return result
}

// -- Size of dict → count of keys --
fn dict_size3(d) {
  return len(dict_keys(d))
}

// -- Is dict empty? → trit --
fn dict_empty3(d) {
  if3 cmp3(dict_size3(d), 0) {
    return -1
  } maybe {
    return 1
  } else3 {
    return 1
  }
}

export3 { dget3, has_key3, keys3, values3, merge3, pick3, omit3 }
export3 { map_values3, filter_dict3, invert3, dict_size3, dict_empty3 }
