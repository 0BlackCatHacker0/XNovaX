// ============================================================
// NOVALANG STDLIB: time3 — Ternary Time Library
// ============================================================
// Usage: import3 time3
// Time, duration, and scheduling utilities.
// ============================================================

// -- Current timestamp (seconds since epoch) --
fn now3() {
  return time_now()
}

// -- Current timestamp in milliseconds --
fn now_ms3() {
  return floor(time_now() * 1000)
}

// -- Sleep for N seconds --
fn sleep3(seconds) {
  let start = time_now()
  // Busy-wait loop (NovaLang doesn't have native sleep yet)
  while3 cmp3(time_now() - start, seconds) == -1 {
    // waiting
  }
  return 1
}

// -- Measure execution time of a function → {result, elapsed_ms, trit} --
fn timed3(func) {
  let start = time_now()
  try3 {
    let result = func()
    let elapsed = floor((time_now() - start) * 1000)
    return {"result": result, "elapsed_ms": elapsed, "trit": 1}
  } uncertain {
    let elapsed = floor((time_now() - start) * 1000)
    return {"result": null, "elapsed_ms": elapsed, "trit": 0}
  } fail3 {
    let elapsed = floor((time_now() - start) * 1000)
    return {"result": null, "elapsed_ms": elapsed, "trit": -1}
  }
}

// -- Format seconds to human-readable duration --
fn duration3(seconds) {
  let s = floor(seconds)
  if3 cmp3(s, 60) == -1 {
    return str(s) + "s"
  } maybe {
    return "1m 0s"
  } else3 {
    if3 cmp3(s, 3600) == -1 {
      let m = floor(s / 60)
      let rem = s - m * 60
      return str(m) + "m " + str(rem) + "s"
    } maybe {
      return "1h 0m 0s"
    } else3 {
      let h = floor(s / 3600)
      let rem = s - h * 3600
      let m = floor(rem / 60)
      let rem2 = rem - m * 60
      return str(h) + "h " + str(m) + "m " + str(rem2) + "s"
    }
  }
}

// -- Calculate elapsed time since a timestamp --
fn elapsed3(start_time) {
  return time_now() - start_time
}

// -- Check if a duration has passed since start → trit --
fn expired3(start_time, duration_seconds) {
  let elapsed = time_now() - start_time
  if3 cmp3(elapsed, duration_seconds) {
    return -1
  } maybe {
    return 1
  } else3 {
    return 1
  }
}

// -- Simple rate limiter: check if enough time has passed --
fn rate_check3(last_time, min_interval) {
  let elapsed = time_now() - last_time
  if3 cmp3(elapsed, min_interval) {
    return -1
  } maybe {
    return 1
  } else3 {
    return 1
  }
}

// -- Timestamp to ISO-ish string (approximate) --
fn timestamp_str3(ts) {
  return "T+" + str(floor(ts)) + "s"
}

// -- Cooldown tracker: returns {allowed, remaining, trit} --
fn cooldown3(last_action_time, cooldown_seconds) {
  let elapsed = time_now() - last_action_time
  let remaining = cooldown_seconds - elapsed
  if3 cmp3(remaining, 0) {
    return {"allowed": 1, "remaining": 0, "trit": 1}
  } maybe {
    return {"allowed": 1, "remaining": 0, "trit": 1}
  } else3 {
    return {"allowed": -1, "remaining": floor(remaining), "trit": -1}
  }
}

export3 { now3, now_ms3, sleep3, timed3, duration3, elapsed3, expired3 }
export3 { rate_check3, timestamp_str3, cooldown3 }
