// ============================================================================
// cache3.nova — Ternary LRU Cache with TTL
// ============================================================================
// In-memory key-value cache with ternary state:
//   +1 = cache hit (value found and not expired)
//    0 = cache miss (key not found)
//   -1 = cache expired (key found but TTL exceeded)
//
// Uses v1.4 features: ??, default params, in operator
// 3-5-7-13 Harmonics: default max_size=H13*H3(39), ttl=H13*1000(13s)
// ============================================================================

fn cache3_new(name = "cache", max_size = 39, ttl_ms = 13000) {
    return {
        "name": name,
        "max_size": max_size,
        "ttl_ms": ttl_ms,
        "entries": {},
        "order": [],
        "hits": 0,
        "misses": 0,
        "evictions": 0
    }
}

fn cache3_set(cache, key, value) {
    let entries = dict_get(cache, "entries") ?? {}
    let order = dict_get(cache, "order") ?? []
    let max_s = dict_get(cache, "max_size") ?? 39
    let now = time_ms()

    let entry = {"value": value, "ts": now}
    entries = dict_set(entries, key, entry)

    // Update access order — remove old position, add to end
    let new_order = []
    let i = 0
    while3 i < len(order) {
        if3 order[i] != key {
            new_order = append(new_order, order[i])
        }
        i = i + 1
    }
    new_order = append(new_order, key)

    // Evict if over capacity (remove oldest)
    let evictions = dict_get(cache, "evictions") ?? 0
    while3 len(new_order) > max_s {
        let oldest = new_order[0]
        new_order = drop(new_order, 1)
        entries = dict_remove(entries, oldest)
        evictions = evictions + 1
    }

    let result = deep_clone(cache)
    result = dict_set(result, "entries", entries)
    result = dict_set(result, "order", new_order)
    result = dict_set(result, "evictions", evictions)
    return result
}

fn cache3_get(cache, key) {
    let entries = dict_get(cache, "entries") ?? {}
    let ttl = dict_get(cache, "ttl_ms") ?? 13000
    let now = time_ms()

    let entry = dict_get(entries, key)
    if3 entry == null {
        let misses = (dict_get(cache, "misses") ?? 0) + 1
        let result = dict_set(deep_clone(cache), "misses", misses)
        return {"cache": result, "trit": 0, "value": null, "status": "miss"}
    }

    let ts = dict_get(entry, "ts") ?? 0
    if3 (now - ts) > ttl {
        let misses = (dict_get(cache, "misses") ?? 0) + 1
        let result = dict_set(deep_clone(cache), "misses", misses)
        return {"cache": result, "trit": -1, "value": null, "status": "expired"}
    }

    // Hit — update access order
    let hits = (dict_get(cache, "hits") ?? 0) + 1
    let result = dict_set(deep_clone(cache), "hits", hits)
    return {"cache": result, "trit": 1, "value": dict_get(entry, "value"), "status": "hit"}
}

fn cache3_invalidate(cache, key) {
    let entries = dict_get(cache, "entries") ?? {}
    let order = dict_get(cache, "order") ?? []
    entries = dict_remove(entries, key)
    let new_order = []
    let i = 0
    while3 i < len(order) {
        if3 order[i] != key {
            new_order = append(new_order, order[i])
        }
        i = i + 1
    }
    let result = deep_clone(cache)
    result = dict_set(result, "entries", entries)
    result = dict_set(result, "order", new_order)
    return result
}

fn cache3_clear(cache) {
    let result = deep_clone(cache)
    result = dict_set(result, "entries", {})
    result = dict_set(result, "order", [])
    return result
}

fn cache3_stats(cache) {
    let hits = dict_get(cache, "hits") ?? 0
    let misses = dict_get(cache, "misses") ?? 0
    let total = hits + misses
    let hit_rate = 0
    if3 total > 0 { hit_rate = (hits * 100) / total }
    let entries = dict_get(cache, "entries") ?? {}
    let size = len(dict_keys(entries))
    return {
        "name": dict_get(cache, "name") ?? "cache",
        "size": size,
        "max_size": dict_get(cache, "max_size") ?? 39,
        "hits": hits,
        "misses": misses,
        "hit_rate_pct": hit_rate,
        "evictions": dict_get(cache, "evictions") ?? 0,
        "ttl_ms": dict_get(cache, "ttl_ms") ?? 13000
    }
}
