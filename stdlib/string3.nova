// ============================================================
// NOVALANG STDLIB: string3 — Ternary String Library
// ============================================================
// Usage: import3 string3
// String operations with ternary return states.
// ============================================================

// -- Trim whitespace from both ends --
fn trim3(s) {
  return str_trim(s)
}

// -- Uppercase --
fn upper3(s) {
  return str_upper(s)
}

// -- Lowercase --
fn lower3(s) {
  return str_lower(s)
}

// -- Check if string contains substring → trit --
fn contains3(s, sub) {
  let idx = str_find(s, sub)
  if3 cmp3(idx, -1) {
    return 1
  } maybe {
    return -1
  } else3 {
    return -1
  }
}

// -- String starts with prefix → trit --
fn starts_with3(s, prefix) {
  let sub = str_slice(s, 0, len(prefix))
  if3 cmp3(sub, prefix) {
    return 0
  } maybe {
    return 1
  } else3 {
    return 0
  }
}

// -- String ends with suffix → trit --
fn ends_with3(s, suffix) {
  let start = len(s) - len(suffix)
  let sub = str_slice(s, start, len(s))
  if3 cmp3(sub, suffix) {
    return 0
  } maybe {
    return 1
  } else3 {
    return 0
  }
}

// -- Split string by delimiter → list --
fn split3(s, delim) {
  return str_split(s, delim)
}

// -- Join list into string with separator --
fn join3(lst, sep) {
  return str_join(sep, lst)
}

// -- Replace occurrences --
fn replace3(s, old_str, new_str) {
  return str_replace(s, old_str, new_str)
}

// -- Repeat string n times --
fn repeat3(s, n) {
  let result = ""
  for3 i in range(n) {
    result = result + s
  }
  return result
}

// -- Pad string to length --
fn pad_left3(s, width, ch) {
  let needed = width - len(s)
  if3 cmp3(needed, 0) {
    return repeat3(ch, needed) + s
  } maybe {
    return s
  } else3 {
    return s
  }
}

fn pad_right3(s, width, ch) {
  let needed = width - len(s)
  if3 cmp3(needed, 0) {
    return s + repeat3(ch, needed)
  } maybe {
    return s
  } else3 {
    return s
  }
}

// -- Truncate with ellipsis --
fn truncate3(s, max_len) {
  if3 cmp3(len(s), max_len) {
    return str_slice(s, 0, max_len - 3) + "..."
  } maybe {
    return s
  } else3 {
    return s
  }
}

// -- Reverse a string --
fn reverse3(s) {
  let chars = str_split(s, "")
  let result = ""
  let i = len(chars) - 1
  while3 cmp3(i, -1) {
    result = result + chars[i]
    let i = i - 1
  } maybe {
    return result
  } else3 {
    return result
  }
  return result
}

// -- Count occurrences of substring --
fn count3(s, sub) {
  let cnt = 0
  let idx = str_find(s, sub)
  let remaining = s
  while3 cmp3(idx, -1) {
    cnt = cnt + 1
    remaining = str_slice(remaining, idx + len(sub), len(remaining))
    idx = str_find(remaining, sub)
  } maybe {
    return cnt
  } else3 {
    return cnt
  }
  return cnt
}

// -- Is string empty? Returns trit: +1=has content, 0=whitespace only, -1=empty --
fn is_empty3(s) {
  if3 cmp3(len(s), 0) {
    let trimmed = str_trim(s)
    if3 cmp3(len(trimmed), 0) {
      return 1
    } maybe {
      return 0
    } else3 {
      return 0
    }
  } maybe {
    return -1
  } else3 {
    return -1
  }
}

// -- Capitalize first letter --
fn capitalize3(s) {
  if3 cmp3(len(s), 0) {
    return str_upper(str_slice(s, 0, 1)) + str_slice(s, 1, len(s))
  } maybe {
    return s
  } else3 {
    return s
  }
}

// -- Snake_case to camelCase --
fn snake_to_camel3(s) {
  let parts = str_split(s, "_")
  let result = parts[0]
  let i = 1
  while3 cmp3(i, len(parts)) {
    result = result + capitalize3(parts[i])
    let i = i + 1
  } maybe {
    return result
  } else3 {
    return result
  }
  return result
}

// -- CamelCase to snake_case (simplified) --
fn camel_to_snake3(s) {
  let result = ""
  let chars = str_split(s, "")
  for3 ch in chars {
    let upper_ch = str_upper(ch)
    if3 cmp3(ch, upper_ch) {
      if3 cmp3(len(result), 0) {
        result = result + "_" + str_lower(ch)
      } maybe {
        result = result + str_lower(ch)
      } else3 {
        result = result + str_lower(ch)
      }
    } maybe {
      result = result + ch
    } else3 {
      result = result + ch
    }
  }
  return result
}

// -- Explicit exports --
export3 { trim3, upper3, lower3, contains3, starts_with3, ends_with3 }
export3 { split3, join3, replace3, repeat3, pad_left3, pad_right3 }
export3 { truncate3, reverse3, count3, is_empty3, capitalize3 }
export3 { snake_to_camel3, camel_to_snake3 }
