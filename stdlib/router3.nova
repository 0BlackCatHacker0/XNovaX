// ============================================================================
// router3.nova — Ternary HTTP Router Pattern Matcher
// ============================================================================
// Route matching engine with ternary results:
//   +1 = route matched, handler found
//    0 = partial match (prefix matched but not exact)
//   -1 = no match
//
// Uses v1.4 features: ??, default params, in operator
// ============================================================================

fn router3_new(name = "router") {
    return {
        "name": name,
        "routes": [],
        "not_found_handler": null,
        "middleware": [],
        "total_matches": 0,
        "total_misses": 0
    }
}

fn router3_add(router, method, path, handler_name) {
    let routes = dict_get(router, "routes") ?? []
    let route = {
        "method": upper(method),
        "path": path,
        "handler": handler_name,
        "hits": 0
    }
    routes = append(routes, route)
    let result = deep_clone(router)
    result = dict_set(result, "routes", routes)
    return result
}

fn router3_add_middleware(router, middleware_name) {
    let mw = dict_get(router, "middleware") ?? []
    mw = append(mw, middleware_name)
    let result = deep_clone(router)
    result = dict_set(result, "middleware", mw)
    return result
}

fn router3_match(router, method, path) {
    let routes = dict_get(router, "routes") ?? []
    let m = upper(method)
    let best_match = null
    let partial = null

    let i = 0
    while3 i < len(routes) {
        let route = routes[i]
        let r_method = dict_get(route, "method") ?? ""
        let r_path = dict_get(route, "path") ?? ""

        if3 r_method == m {
            if3 r_path == path {
                // Exact match
                best_match = route
                i = len(routes)
            }
            // Check prefix match
            if3 best_match == null {
                if3 starts_with(path, r_path) {
                    partial = route
                }
            }
        }
        i = i + 1
    }

    if3 best_match != null {
        let matches = (dict_get(router, "total_matches") ?? 0) + 1
        return {"trit": 1, "route": best_match, "handler": dict_get(best_match, "handler")}
    }
    if3 partial != null {
        return {"trit": 0, "route": partial, "handler": dict_get(partial, "handler"), "partial": 1}
    }
    let misses = (dict_get(router, "total_misses") ?? 0) + 1
    return {"trit": -1, "route": null, "handler": dict_get(router, "not_found_handler")}
}

fn router3_stats(router) {
    let routes = dict_get(router, "routes") ?? []
    return {
        "name": dict_get(router, "name") ?? "router",
        "route_count": len(routes),
        "middleware_count": len(dict_get(router, "middleware") ?? []),
        "total_matches": dict_get(router, "total_matches") ?? 0,
        "total_misses": dict_get(router, "total_misses") ?? 0
    }
}
