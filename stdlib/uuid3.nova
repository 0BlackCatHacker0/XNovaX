// ============================================================================
// uuid3.nova — Ternary UUID Generator
// ============================================================================
// Generates unique identifiers using ternary-native encoding:
//   Standard UUID v4 (random) + ternary-encoded variant
//   TernaryID: 27-trit ID using 3-5-7-13 harmonic structure
//
// Uses v1.4 features: ??, default params
// ============================================================================

fn uuid3_rand_int(max_val) {
    // random() returns float 0..1 — multiply and floor for integer range
    return floor(random(0, 1) * max_val)
}

fn uuid3_v4() {
    // Generate UUID v4 using random bytes
    let hex_chars = "0123456789abcdef"
    let parts = ["", "", "", "", ""]
    let lengths = [8, 4, 4, 4, 12]
    let i = 0
    while3 i < 5 {
        let part = ""
        let j = 0
        while3 j < lengths[i] {
            let r = uuid3_rand_int(16)
            part = part + char_at(hex_chars, r)
            j = j + 1
        }
        parts[i] = part
        i = i + 1
    }
    // Set version (4) and variant bits
    let seg3 = "4" + substr(parts[2], 1)
    let variant_char = char_at("89ab", uuid3_rand_int(4))
    let seg4 = variant_char + substr(parts[3], 1)
    return parts[0] + "-" + parts[1] + "-" + seg3 + "-" + seg4 + "-" + parts[4]
}

fn uuid3_ternary(prefix = "NX") {
    // Generate a ternary-native ID: PREFIX-TTTTT-TTTTT-TTTTT
    // Each T is a balanced ternary digit mapped to char
    let trit_chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz0123456789"
    let seg1 = ""
    let seg2 = ""
    let seg3 = ""
    let i = 0
    while3 i < 5 {
        seg1 = seg1 + char_at(trit_chars, uuid3_rand_int(len(trit_chars)))
        seg2 = seg2 + char_at(trit_chars, uuid3_rand_int(len(trit_chars)))
        seg3 = seg3 + char_at(trit_chars, uuid3_rand_int(len(trit_chars)))
        i = i + 1
    }
    return prefix + "-" + seg1 + "-" + seg2 + "-" + seg3
}

fn uuid3_short() {
    // Generate a compact 8-char ID for quick references
    let chars = "0123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz"
    let id = ""
    let i = 0
    while3 i < 8 {
        id = id + char_at(chars, uuid3_rand_int(len(chars)))
        i = i + 1
    }
    return id
}

fn uuid3_timestamp() {
    // Timestamp-prefixed ID: ensures sortability
    let ts = timestamp()
    let short = uuid3_short()
    return to_str(ts) + "-" + short
}
