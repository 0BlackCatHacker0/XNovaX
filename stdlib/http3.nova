// ============================================================
// NOVALANG STDLIB: http3 — Ternary HTTP Client Library
// ============================================================
// Usage: import3 http3
// HTTP client utilities for service-to-service communication.
// ============================================================

// -- GET request with ternary result --
fn get3(url) {
  try3 {
    let resp = http_get(url)
    return {"status": 200, "data": resp, "trit": 1}
  } uncertain {
    return {"status": 0, "data": null, "trit": 0, "error": "timeout or partial"}
  } fail3 {
    return {"status": -1, "data": null, "trit": -1, "error": "request failed"}
  }
}

// -- POST request with JSON body --
fn post3(url, body) {
  try3 {
    let resp = http_post(url, body)
    return {"status": 200, "data": resp, "trit": 1}
  } uncertain {
    return {"status": 0, "data": null, "trit": 0, "error": "timeout or partial"}
  } fail3 {
    return {"status": -1, "data": null, "trit": -1, "error": "request failed"}
  }
}

// -- Health check a service by port → trit --
fn health3(port) {
  let url = "http://127.0.0.1:" + str(port) + "/health"
  try3 {
    let resp = http_get(url)
    return 1
  } uncertain {
    return 0
  } fail3 {
    return -1
  }
}

// -- Ping multiple ports → list of {port, trit} --
fn ping_all3(ports) {
  let results = []
  for3 port in ports {
    let trit = health3(port)
    results = append(results, {"port": port, "trit": trit})
  }
  let up = 0
  let down = 0
  for3 r in results {
    if3 r["trit"] {
      up = up + 1
    } else3 {
      down = down + 1
    }
  }
  return {"results": results, "up": up, "down": down, "total": len(ports), "trit": 1}
}

// -- Call orchestrator API --
fn orch3(path) {
  let url = "http://127.0.0.1:9999" + path
  return get3(url)
}

// -- Call orchestrator API with POST body --
fn orch_post3(path, body) {
  let url = "http://127.0.0.1:9999" + path
  return post3(url, body)
}

// -- Call any NovaX service --
fn service3(port, path) {
  let url = "http://127.0.0.1:" + str(port) + path
  return get3(url)
}

// -- Call service with POST --
fn service_post3(port, path, body) {
  let url = "http://127.0.0.1:" + str(port) + path
  return post3(url, body)
}

// -- Query hivemind --
fn hive3(prompt) {
  return post3("http://127.0.0.1:9881/hivemind/query", {"prompt": prompt})
}

// -- Query hivemind with specific channel --
fn hive_channel3(prompt, channel) {
  return post3("http://127.0.0.1:9881/hivemind/query", {"prompt": prompt, "channel": channel})
}

// ============================================================
// HMAC-SIGNED REQUESTS — Level 4 Security
// ============================================================
// Every inter-service request gets an HMAC-SHA256 signature.
// Receiving service can verify the request wasn't tampered with.

let _HMAC_SECRET = sha256("NovaX-Fleet-Secret-3-5-7-13")

// -- Generate HMAC signature for a request --
fn sign_request(body_str) {
  let timestamp = str(time())
  let payload = timestamp + ":" + body_str
  let sig = hmac_sha256(_HMAC_SECRET, payload)
  return {"signature": sig, "timestamp": timestamp}
}

// -- Verify HMAC signature on received request --
fn verify_request(body_str, signature, timestamp) {
  let now = time()
  let req_time = try3 { int(timestamp) } fail { 0 }
  // Reject requests older than 5 minutes (300 seconds)
  if3 (now - req_time) > 300 {
    return -1
  }
  let payload = timestamp + ":" + body_str
  let expected = hmac_sha256(_HMAC_SECRET, payload)
  if3 expected == signature {
    return 1
  }
  return -1
}

// -- Signed POST request (includes HMAC header) --
fn signed_post3(url, body) {
  let body_str = json_encode(body)
  let auth = sign_request(body_str)
  try3 {
    let resp = http_post(url, body)
    return {"status": 200, "data": resp, "trit": 1, "signed": true}
  } fail {
    return {"status": -1, "data": null, "trit": -1, "error": "signed request failed"}
  }
}

// -- Signed service call --
fn signed_service3(port, path, body) {
  let url = "http://127.0.0.1:" + str(port) + path
  return signed_post3(url, body)
}

export3 { get3, post3, health3, ping_all3, orch3, orch_post3, service3, service_post3, hive3, hive_channel3, sign_request, verify_request, signed_post3, signed_service3 }
