// ============================================================================
// semaphore3.nova — Ternary Semaphore for Concurrency Control
// ============================================================================
// Counting semaphore with ternary state:
//   +1 = permits available, work can proceed
//    0 = permits low, approaching saturation
//   -1 = no permits, must wait
//
// Uses v1.4 features: ??, default params
// 3-5-7-13 Harmonics: default permits=H7(7)
// ============================================================================

fn sem3_new(name = "sem", permits = 7) {
    return {
        "name": name,
        "max_permits": permits,
        "available": permits,
        "waiters": 0,
        "total_acquires": 0,
        "total_releases": 0,
        "total_waits": 0
    }
}

fn sem3_acquire(sem, count = 1) {
    let avail = dict_get(sem, "available") ?? 0
    let result = deep_clone(sem)

    if3 avail >= count {
        result = dict_set(result, "available", avail - count)
        let acq = (dict_get(sem, "total_acquires") ?? 0) + 1
        result = dict_set(result, "total_acquires", acq)
        return {"sem": result, "trit": 1, "acquired": count}
    }

    // Not enough permits
    let waits = (dict_get(sem, "total_waits") ?? 0) + 1
    let waiters = (dict_get(sem, "waiters") ?? 0) + 1
    result = dict_set(result, "total_waits", waits)
    result = dict_set(result, "waiters", waiters)
    return {"sem": result, "trit": -1, "acquired": 0}
}

fn sem3_release(sem, count = 1) {
    let avail = dict_get(sem, "available") ?? 0
    let max_p = dict_get(sem, "max_permits") ?? 7
    let new_avail = avail + count
    if3 new_avail > max_p { new_avail = max_p }
    let result = deep_clone(sem)
    result = dict_set(result, "available", new_avail)
    let rel = (dict_get(sem, "total_releases") ?? 0) + 1
    result = dict_set(result, "total_releases", rel)
    // Wake waiters
    let waiters = dict_get(result, "waiters") ?? 0
    if3 waiters > 0 {
        let wake = count
        if3 wake > waiters { wake = waiters }
        result = dict_set(result, "waiters", waiters - wake)
    }
    return {"sem": result, "trit": 1}
}

fn sem3_health(sem) {
    let avail = dict_get(sem, "available") ?? 0
    let max_p = dict_get(sem, "max_permits") ?? 7
    let threshold = max_p / 3
    if3 avail > threshold { return 1 }
    if3 avail > 0 { return 0 }
    return -1
}

fn sem3_stats(sem) {
    let health = sem3_health(sem)
    let state = "available"
    if3 health == 0 { state = "low" }
    if3 health == -1 { state = "exhausted" }
    return {
        "name": dict_get(sem, "name") ?? "sem",
        "state": state,
        "trit": health,
        "available": dict_get(sem, "available") ?? 0,
        "max_permits": dict_get(sem, "max_permits") ?? 7,
        "waiters": dict_get(sem, "waiters") ?? 0,
        "total_acquires": dict_get(sem, "total_acquires") ?? 0,
        "total_releases": dict_get(sem, "total_releases") ?? 0,
        "total_waits": dict_get(sem, "total_waits") ?? 0
    }
}
