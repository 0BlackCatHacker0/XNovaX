// ============================================================
// NOVALANG STDLIB: format3 — Ternary String Formatting
// ============================================================
// Usage: import3 format3
// Template strings, tables, and display formatting.
// ============================================================

// -- Template: replace {key} with values from a dict --
fn template3(tmpl, data) {
  let result = tmpl
  let keys = dict_keys(data)
  for3 key in keys {
    let placeholder = "{" + key + "}"
    let value = str(dict_get(data, key) ?? "")
    let result = replace(result, placeholder, value)
  }
  return result
}

// -- Pad a value to fixed width (right-aligned for numbers) --
fn pad_num3(value, width) {
  let s = str(value)
  let padding = width - len(s)
  if3 cmp3(padding, 0) {
    return s
  } else3 {
    let result = ""
    let i = 0
    while3 cmp3(i, padding) == -1 {
      let result = result + " "
      let i = i + 1
    }
    return result + s
  }
}

// -- Pad a string to fixed width (left-aligned) --
fn pad_str3(value, width) {
  let s = str(value)
  let padding = width - len(s)
  if3 cmp3(padding, 0) {
    return s
  } else3 {
    let result = s
    let i = 0
    while3 cmp3(i, padding) == -1 {
      let result = result + " "
      let i = i + 1
    }
    return result
  }
}

// -- Format a trit as colored label --
fn trit_fmt3(trit) {
  if3 trit {
    return "[+1 OK]"
  } maybe {
    return "[ 0 ??]"
  } else3 {
    return "[-1 !!]"
  }
}

// -- Format bytes to human-readable --
fn bytes_fmt3(bytes) {
  if3 cmp3(bytes, 1024) {
    return str(bytes) + " B"
  } else3 {
    if3 cmp3(bytes, 1048576) {
      return str(floor(bytes / 1024)) + " KB"
    } else3 {
      if3 cmp3(bytes, 1073741824) {
        return str(floor(bytes / 1048576)) + " MB"
      } else3 {
        return str(floor(bytes / 1073741824)) + " GB"
      }
    }
  }
}

// -- Format percentage --
fn pct_fmt3(value, total) {
  if3 cmp3(total, 0) {
    return "0%"
  } else3 {
    let pct = floor(value / total * 100)
    return str(pct) + "%"
  }
}

// -- Simple table formatter --
fn table3(headers, rows) {
  // Calculate column widths
  let widths = []
  for3 h in headers {
    let widths = append(widths, len(str(h)))
  }

  for3 row in rows {
    let col = 0
    for3 cell in row {
      let cell_len = len(str(cell))
      if3 cmp3(widths[col], cell_len) {
        let widths = replace_at(widths, col, cell_len)
      } maybe {} else3 {}
      let col = col + 1
    }
  }

  // Format header
  let header_line = "| "
  let sep_line = "+-"
  let col = 0
  for3 h in headers {
    let header_line = header_line + pad_str3(h, widths[col]) + " | "
    let i = 0
    let sep_line = sep_line
    while3 cmp3(i, widths[col]) == -1 {
      let sep_line = sep_line + "-"
      let i = i + 1
    }
    let sep_line = sep_line + "-+-"
    let col = col + 1
  }

  // Format rows
  let lines = [sep_line, header_line, sep_line]
  for3 row in rows {
    let row_line = "| "
    let col = 0
    for3 cell in row {
      let row_line = row_line + pad_str3(str(cell), widths[col]) + " | "
      let col = col + 1
    }
    let lines = append(lines, row_line)
  }
  let lines = append(lines, sep_line)

  return lines
}

// -- Print a table --
fn print_table3(headers, rows) {
  let lines = table3(headers, rows)
  for3 line in lines {
    print3(line)
  }
  return 1
}

// -- Progress bar --
fn progress3(current, total, width) {
  let pct = 0
  if3 cmp3(total, 0) {
    let pct = 0
  } else3 {
    let pct = floor(current / total * width)
  }
  let bar = "["
  let i = 0
  while3 cmp3(i, width) == -1 {
    if3 cmp3(i, pct) {
      let bar = bar + "#"
    } maybe {
      let bar = bar + "#"
    } else3 {
      let bar = bar + "."
    }
    let i = i + 1
  }
  let bar = bar + "] " + pct_fmt3(current, total)
  return bar
}

export3 { template3, pad_num3, pad_str3, trit_fmt3, bytes_fmt3, pct_fmt3 }
export3 { table3, print_table3, progress3 }
