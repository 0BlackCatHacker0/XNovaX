// ============================================================
// NOVALANG STDLIB: math3 — Ternary Mathematics Library
// ============================================================
// Usage: import3 math3
// All functions return ternary-aware results with trit fields.
// Constants use 3-5-7-13 harmonics.
// ============================================================

// -- Constants --
let PI = 3.141592653589793
let TAU = 6.283185307179586
let E = 2.718281828459045
let PHI = 1.618033988749895
let SQRT2 = 1.4142135623730951
let SQRT3 = 1.7320508075688772
let LN2 = 0.6931471805599453
let LN10 = 2.302585092994046
let H3 = 3
let H5 = 5
let H7 = 7
let H13 = 13
let BLOCK = 2187

// -- Absolute value (ternary: negative→positive, zero stays, positive stays) --
fn abs3(x) {
  if3 cmp3(x, 0) {
    return x
  } maybe {
    return 0
  } else3 {
    return 0 - x
  }
}

// -- Sign function → returns trit: +1, 0, or -1 --
fn sign3(x) {
  return cmp3(x, 0)
}

// -- Clamp value to range --
fn clamp3(x, lo, hi) {
  if3 cmp3(x, lo) {
    if3 cmp3(x, hi) {
      return hi
    } maybe {
      return hi
    } else3 {
      return x
    }
  } maybe {
    return lo
  } else3 {
    return lo
  }
}

// -- Min/Max for two values --
fn min3(a, b) {
  if3 cmp3(a, b) {
    return b
  } maybe {
    return a
  } else3 {
    return a
  }
}

fn max3(a, b) {
  if3 cmp3(a, b) {
    return a
  } maybe {
    return a
  } else3 {
    return b
  }
}

// -- Min/Max for lists --
fn min_list3(lst) {
  let result = lst[0]
  for3 item in lst {
    if3 cmp3(item, result) {
      // item > result, skip
    } maybe {
      // equal, skip
    } else3 {
      let result = item
    }
  }
  return result
}

fn max_list3(lst) {
  let result = lst[0]
  for3 item in lst {
    if3 cmp3(item, result) {
      let result = item
    } maybe {
      // equal, skip
    } else3 {
      // item < result, skip
    }
  }
  return result
}

// -- Sum of a list --
fn sum3(lst) {
  let total = 0
  for3 item in lst {
    let total = total + item
  }
  return total
}

// -- Average --
fn avg3(lst) {
  let s = sum3(lst)
  return s / len(lst)
}

// -- Floor division (integer part) --
fn floor3(x) {
  let i = int(x)
  if3 cmp3(i, x) {
    return i - 1
  } maybe {
    return i
  } else3 {
    return i
  }
}

// -- Ceiling --
fn ceil3(x) {
  let i = int(x)
  if3 cmp3(i, x) {
    return i
  } maybe {
    return i
  } else3 {
    return i + 1
  }
}

// -- Power (integer exponent) --
fn pow3(base, exp) {
  if3 cmp3(exp, 0) {
    let result = 1
    for3 i in range(exp) {
      let result = result * base
    }
    return result
  } maybe {
    return 1
  } else3 {
    return 0
  }
}

// -- Factorial --
fn factorial3(n) {
  if3 cmp3(n, 1) {
    let result = 1
    for3 i in range(n) {
      let result = result * (i + 1)
    }
    return result
  } maybe {
    return 1
  } else3 {
    return 1
  }
}

// -- GCD (Euclidean) --
fn gcd3(a, b) {
  let x = abs3(a)
  let y = abs3(b)
  while3 cmp3(y, 0) {
    let temp = y
    let y = x % y
    let x = temp
  } maybe {
    return x
  } else3 {
    return x
  }
  return x
}

// -- LCM --
fn lcm3(a, b) {
  let g = gcd3(a, b)
  if3 cmp3(g, 0) {
    return abs3(a * b) / g
  } maybe {
    return 0
  } else3 {
    return 0
  }
}

// -- Map a value from one range to another --
fn map_range3(x, in_lo, in_hi, out_lo, out_hi) {
  let ratio = (x - in_lo) / (in_hi - in_lo)
  return out_lo + ratio * (out_hi - out_lo)
}

// -- Lerp (linear interpolation) --
fn lerp3(a, b, t) {
  return a + (b - a) * t
}

// -- Distance between two values --
fn dist3(a, b) {
  return abs3(b - a)
}

// -- Ternary rounding: round to nearest multiple of step --
fn round3(x, step) {
  return floor3(x / step + 0.5) * step
}

// -- Is value within range? Returns trit: +1=inside, 0=on boundary, -1=outside --
fn in_range3(x, lo, hi) {
  if3 cmp3(x, lo) {
    if3 cmp3(x, hi) {
      return -1
    } maybe {
      return 0
    } else3 {
      return 1
    }
  } maybe {
    return 0
  } else3 {
    return -1
  }
}

// -- Explicit exports --
export3 { PI, TAU, E, PHI, SQRT2, SQRT3, LN2, LN10, H3, H5, H7, H13, BLOCK }
export3 { abs3, sign3, clamp3, min3, max3, min_list3, max_list3 }
export3 { sum3, avg3, floor3, ceil3, pow3, factorial3, gcd3, lcm3 }
export3 { map_range3, lerp3, dist3, round3, in_range3 }
