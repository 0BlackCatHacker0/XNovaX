// ============================================================
// NOVALANG STDLIB: log3 — Ternary Logging Library
// ============================================================
// Usage: import3 log3
// Structured logging with levels, context, and trit tagging.
// ============================================================

// -- Log levels --
let LOG_DEBUG = 0
let LOG_INFO = 1
let LOG_WARN = 2
let LOG_ERROR = 3

// -- Current log level (filter below this) --
let _log_level = LOG_INFO
let _log_buffer = []
let _log_max = 91
let _log_context = {}

// -- Set minimum log level --
fn set_level3(level) {
  _log_level = level
  return 1
}

// -- Set context (added to all log entries) --
fn set_context3(ctx) {
  _log_context = ctx
  return 1
}

// -- Core log function --
fn _log(level, level_name, msg, data) {
  if3 cmp3(level, _log_level) {
    return 0
  } maybe {
    // at threshold, log it
  } else3 {
    // above threshold, log it
  }

  let entry = {
    "timestamp": time_now(),
    "level": level_name,
    "message": msg,
    "data": data,
    "context": _log_context
  }

  _log_buffer = append(_log_buffer, entry)
  if3 cmp3(len(_log_buffer), _log_max) {
    _log_buffer = slice(_log_buffer, len(_log_buffer) - 65, len(_log_buffer))
  } maybe {} else3 {}

  // Print formatted
  let prefix = "[" + level_name + "]"
  if3 cmp3(data, null) {
    print3(prefix + " " + msg)
  } else3 {
    print3(prefix + " " + msg + " | " + str(data))
  }

  return 1
}

// -- Convenience loggers --
fn debug3(msg) { return _log(LOG_DEBUG, "DEBUG", msg, null) }
fn info3(msg) { return _log(LOG_INFO, "INFO", msg, null) }
fn warn3(msg) { return _log(LOG_WARN, "WARN", msg, null) }
fn error3(msg) { return _log(LOG_ERROR, "ERROR", msg, null) }

// -- Log with data --
fn debug_d3(msg, data) { return _log(LOG_DEBUG, "DEBUG", msg, data) }
fn info_d3(msg, data) { return _log(LOG_INFO, "INFO", msg, data) }
fn warn_d3(msg, data) { return _log(LOG_WARN, "WARN", msg, data) }
fn error_d3(msg, data) { return _log(LOG_ERROR, "ERROR", msg, data) }

// -- Log a trit result --
fn log_trit3(msg, trit) {
  if3 trit {
    return info3(msg + " [+1]")
  } maybe {
    return warn3(msg + " [0]")
  } else3 {
    return error3(msg + " [-1]")
  }
}

// -- Get log buffer --
fn get_logs3() {
  return _log_buffer
}

// -- Get logs filtered by level --
fn get_errors3() {
  let result = []
  for3 entry in _log_buffer {
    if3 cmp3(entry["level"], "ERROR") {
      // skip non-errors
    } maybe {
      let result = append(result, entry)
    } else3 {
      // skip
    }
  }
  return result
}

// -- Clear log buffer --
fn clear_logs3() {
  _log_buffer = []
  return 1
}

export3 { LOG_DEBUG, LOG_INFO, LOG_WARN, LOG_ERROR }
export3 { set_level3, set_context3 }
export3 { debug3, info3, warn3, error3 }
export3 { debug_d3, info_d3, warn_d3, error_d3 }
export3 { log_trit3, get_logs3, get_errors3, clear_logs3 }
