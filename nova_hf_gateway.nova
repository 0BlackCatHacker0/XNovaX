// ═══════════════════════════════════════════════════════════════════
// nova_hf_gateway.nova — HuggingFace Gateway v1.0.0
// ═══════════════════════════════════════════════════════════════════
// Routes to ANY of 509,882 HuggingFace models.
// No cost. No API key. Pure ternary routing.
//
// Every model gets a trit. The system decides.
// POST /hf/call     — call any model by ID
// POST /hf/swarm    — fan out to multiple models
// POST /hf/discover — discover models by pipeline
// GET  /hf/stats    — trit stats across all tested models
// GET  /hf/pipelines — list all 33 pipeline categories
// ═══════════════════════════════════════════════════════════════════

import3 "C:\\NovaX\\lib\\nova_stdlib.nova"
import3 "C:\\NovaX\\lib\\nova_http_utils.nova"
import3 "C:\\NovaX\\lib\\nova_ns_core.nova"
import3 "C:\\NovaX\\lib\\nova_hf.nova"

let PORT = 9969
let _ns = ns_init_counters()

fn handle_health(req) {
    let stats = hf_trit_stats()
    return ns_health_dict("nova_hf_gateway", "1.0.0", PORT, _ns)
}

// ── POST /hf/call — Call any model by ID ──
// Body: {"model": "microsoft/DialoGPT-medium", "inputs": "Hello!"}
fn handle_call(req) {
    _ns = ns_record(_ns, 0, 0)
    let body = parse_body(req)
    let model = dict_get(body, "model") ?? ""
    let inputs = dict_get(body, "inputs") ?? ""

    if3 len(model) == 0 {
        return json_ok({"trit": -1, "error": "missing model ID"})
    }
    if3 len(inputs) == 0 {
        return json_ok({"trit": -1, "error": "missing inputs"})
    }

    let result = hf_call(model, inputs)
    return json_ok(result)
}

// ── POST /hf/generate — Text generation shorthand ──
fn handle_generate(req) {
    _ns = ns_record(_ns, 0, 0)
    let body = parse_body(req)
    let model = dict_get(body, "model") ?? "bigscience/bloom-560m"
    let prompt = dict_get(body, "prompt") ?? dict_get(body, "inputs") ?? ""

    if3 len(prompt) == 0 {
        return json_ok({"trit": -1, "error": "missing prompt"})
    }

    let result = hf_generate(model, prompt)
    return json_ok(result)
}

// ── POST /hf/classify — Text classification ──
fn handle_classify(req) {
    _ns = ns_record(_ns, 0, 0)
    let body = parse_body(req)
    let model = dict_get(body, "model") ?? "distilbert-base-uncased-finetuned-sst-2-english"
    let text = dict_get(body, "text") ?? dict_get(body, "inputs") ?? ""

    let result = hf_classify(model, text)
    return json_ok(result)
}

// ── POST /hf/summarize — Text summarization ──
fn handle_summarize(req) {
    _ns = ns_record(_ns, 0, 0)
    let body = parse_body(req)
    let model = dict_get(body, "model") ?? "facebook/bart-large-cnn"
    let text = dict_get(body, "text") ?? dict_get(body, "inputs") ?? ""

    let result = hf_summarize(model, text)
    return json_ok(result)
}

// ── POST /hf/translate — Translation ──
fn handle_translate(req) {
    _ns = ns_record(_ns, 0, 0)
    let body = parse_body(req)
    let model = dict_get(body, "model") ?? "Helsinki-NLP/opus-mt-en-fr"
    let text = dict_get(body, "text") ?? dict_get(body, "inputs") ?? ""

    let result = hf_translate(model, text)
    return json_ok(result)
}

// ── POST /hf/embed — Embeddings ──
fn handle_embed(req) {
    _ns = ns_record(_ns, 0, 0)
    let body = parse_body(req)
    let model = dict_get(body, "model") ?? "sentence-transformers/all-MiniLM-L6-v2"
    let text = dict_get(body, "text") ?? dict_get(body, "inputs") ?? ""

    let result = hf_embed(model, text)
    return json_ok(result)
}

// ── POST /hf/qa — Question answering ──
fn handle_qa(req) {
    _ns = ns_record(_ns, 0, 0)
    let body = parse_body(req)
    let model = dict_get(body, "model") ?? "deepset/roberta-base-squad2"
    let question = dict_get(body, "question") ?? ""
    let context = dict_get(body, "context") ?? ""

    let result = hf_qa(model, question, context)
    return json_ok(result)
}

// ── POST /hf/swarm — Fan out to multiple models ──
// Body: {"models": ["model1", "model2", ...], "inputs": "prompt"}
fn handle_swarm(req) {
    _ns = ns_record(_ns, 0, 0)
    let body = parse_body(req)
    let models = dict_get(body, "models") ?? []
    let inputs = dict_get(body, "inputs") ?? ""

    if3 len(models) == 0 {
        return json_ok({"trit": -1, "error": "missing models list"})
    }

    let result = hf_swarm(models, inputs)
    return json_ok(result)
}

// ── POST /hf/discover — Discover models by pipeline ──
// Body: {"pipeline": "text-generation", "limit": 20}
fn handle_discover(req) {
    _ns = ns_record(_ns, 0, 0)
    let body = parse_body(req)
    let pipeline = dict_get(body, "pipeline") ?? "text-generation"
    let limit = to_num(dict_get(body, "limit") ?? 20)

    let result = hf_discover(pipeline, limit)
    return json_ok(result)
}

// ── GET /hf/stats — Trit statistics ──
fn handle_stats(req) {
    let stats = hf_trit_stats()
    let total = hf_total_models()
    return json_ok({
        "trit": 1,
        "total_hf_models": total,
        "pipelines": len(dict_keys(HF_PIPELINES)),
        "tested": dict_get(stats, "tested") ?? 0,
        "active": dict_get(stats, "active") ?? 0,
        "potential": dict_get(stats, "potential") ?? 0,
        "failed": dict_get(stats, "failed") ?? 0,
        "untested": total - dict_get(stats, "tested") ?? 0
    })
}

// ── GET /hf/pipelines — List all pipeline categories ──
fn handle_pipelines(req) {
    let pipe_keys = dict_keys(HF_PIPELINES)
    let pipes = []
    let total = 0
    for3 i in range(len(pipe_keys)) {
        let k = pipe_keys[i]
        let count = dict_get(HF_PIPELINES, k) ?? 0
        total = total + count
        pipes = append(pipes, {
            "pipeline": k,
            "models": count,
            "trit": 0
        })
    }
    return json_ok({
        "trit": 1,
        "pipelines": pipes,
        "total_pipelines": len(pipe_keys),
        "total_models": total
    })
}

// ── Routes ──
let server = tserve(PORT, "nova_hf_gateway")

troute(server, "GET",  "/health",       "handle_health")
troute(server, "POST", "/hf/call",      "handle_call")
troute(server, "POST", "/hf/generate",  "handle_generate")
troute(server, "POST", "/hf/classify",  "handle_classify")
troute(server, "POST", "/hf/summarize", "handle_summarize")
troute(server, "POST", "/hf/translate", "handle_translate")
troute(server, "POST", "/hf/embed",     "handle_embed")
troute(server, "POST", "/hf/qa",        "handle_qa")
troute(server, "POST", "/hf/swarm",     "handle_swarm")
troute(server, "POST", "/hf/discover",  "handle_discover")
troute(server, "GET",  "/hf/stats",     "handle_stats")
troute(server, "GET",  "/hf/pipelines", "handle_pipelines")

print(join(["[hf_gateway] HuggingFace Gateway on port ", to_str(PORT)], ""))
print(join(["[hf_gateway] ", to_str(hf_total_models()), " models | 33 pipelines | No cost. No key. Pure ternary."], ""))

tstart(server)
