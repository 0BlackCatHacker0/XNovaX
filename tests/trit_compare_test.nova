let t1 = cmp3(1, 5)
print("cmp3(1,5): " + str(t1))
print("cmp3(1,5) == -1: " + str(t1 == -1))
let t2 = cmp3(5, 1)
print("cmp3(5,1): " + str(t2))
print("cmp3(5,1) == -1: " + str(t2 == -1))
let t3 = cmp3(3, 3)
print("cmp3(3,3): " + str(t3))
print("cmp3(3,3) == -1: " + str(t3 == -1))

// Test if3 with == comparison
if3 cmp3(1, 5) == -1 {
  print("if3 cmp3(1,5)==-1: entered else3 branch (correct for <)")
}
print("done")
