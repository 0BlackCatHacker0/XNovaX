print("type_of(42): " + str(type_of(42)))
print("type_of(3.14): " + str(type_of(3.14)))
print("type_of('hi'): " + str(type_of("hi")))
print("type_of([1,2]): " + str(type_of([1,2])))
print("type_of({a:1}): " + str(type_of({"a":1})))
print("type_of(null): " + str(type_of(null)))
print("type_of(true): " + str(type_of(true)))
