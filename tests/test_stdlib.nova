// ============================================================
// NOVAX STDLIB TEST SUITE
// ============================================================
// Tests for all 13 stdlib modules.
// Run: python novalang.py tests/test_stdlib.nova
// ============================================================

import3 "tests/test_framework.nova" { test3, assert3, assert_eq3, assert_neq3, assert_trit3, assert_gt3, assert_lt3, suite3, report3, report3_multi, H3, H5, H7, H13 }

// ============================================================
// GROUP 1: math3 (13 tests)
// ============================================================
import3 math3

fn test_math_abs() {
  assert_eq3(abs3(-5), 5, "abs(-5) = 5")
  assert_eq3(abs3(5), 5, "abs(5) = 5")
  assert_eq3(abs3(0), 0, "abs(0) = 0")
}

fn test_math_sign() {
  assert_eq3(sign3(42), 1, "sign(42) = 1")
  assert_eq3(sign3(-7), -1, "sign(-7) = -1")
  assert_eq3(sign3(0), 0, "sign(0) = 0")
}

fn test_math_clamp() {
  assert_eq3(clamp3(15, 0, 10), 10, "clamp 15 to [0,10]")
  assert_eq3(clamp3(-5, 0, 10), 0, "clamp -5 to [0,10]")
  assert_eq3(clamp3(5, 0, 10), 5, "clamp 5 in [0,10]")
}

fn test_math_min_max() {
  assert_eq3(min3(3, 7), 3, "min(3,7)")
  assert_eq3(max3(3, 7), 7, "max(3,7)")
}

fn test_math_sum_avg() {
  assert_eq3(sum3([1, 2, 3, 4, 5]), 15, "sum [1..5]")
  assert_eq3(avg3([10, 20, 30]), 20, "avg [10,20,30]")
}

fn test_math_pow() {
  assert_eq3(pow3(2, 10), 1024, "2^10")
  assert_eq3(pow3(3, 5), 243, "3^5 = H5 block")
}

fn test_math_factorial() {
  assert_eq3(factorial3(5), 120, "5!")
  assert_eq3(factorial3(0), 1, "0!")
}

fn test_math_gcd_lcm() {
  assert_eq3(gcd3(12, 8), 4, "gcd(12,8)")
  assert_eq3(lcm3(4, 6), 12, "lcm(4,6)")
}

fn test_math_floor_ceil() {
  assert_eq3(floor3(3.7), 3, "floor(3.7)")
  assert_eq3(ceil3(3.2), 4, "ceil(3.2)")
}

fn test_math_lerp() {
  assert_eq3(lerp3(0, 100, 0.5), 50, "lerp 50%")
  assert_eq3(lerp3(0, 10, 0), 0, "lerp 0%")
}

fn test_math_in_range() {
  assert_trit3(in_range3(5, 0, 10), 1, "5 in [0,10]")
  assert_trit3(in_range3(15, 0, 10), -1, "15 not in [0,10]")
}

fn test_math_constants() {
  assert_gt3(PI, 3.14, "PI > 3.14")
  assert_lt3(PI, 3.15, "PI < 3.15")
  assert_eq3(H3, 3, "H3 = 3")
  assert_eq3(H13, 13, "H13 = 13")
  assert_eq3(BLOCK, 2187, "BLOCK = 3^7")
}

fn test_math_round() {
  assert_eq3(round3(3.7), 4, "round(3.7)")
  assert_eq3(round3(3.2), 3, "round(3.2)")
}

let math_results = suite3("Math3 Stdlib", [
  test_math_abs, test_math_sign, test_math_clamp, test_math_min_max,
  test_math_sum_avg, test_math_pow, test_math_factorial, test_math_gcd_lcm,
  test_math_floor_ceil, test_math_lerp, test_math_in_range, test_math_constants,
  test_math_round
])

// ============================================================
// GROUP 2: string3 (7 tests)
// ============================================================
import3 string3

fn test_str_trim() {
  assert_eq3(trim3("  hello  "), "hello", "trim spaces")
}

fn test_str_case() {
  assert_eq3(upper3("hello"), "HELLO", "upper")
  assert_eq3(lower3("HELLO"), "hello", "lower")
}

fn test_str_contains() {
  assert_trit3(contains3("hello world", "world"), 1, "contains world")
  assert_trit3(contains3("hello", "xyz"), -1, "not contains xyz")
}

fn test_str_split_join() {
  let parts = split3("a,b,c", ",")
  assert_eq3(len(parts), 3, "split produces 3 parts")
  assert_eq3(join3(["x", "y", "z"], "-"), "x-y-z", "join with dash")
}

fn test_str_replace() {
  assert_eq3(replace3("hello world", "world", "nova"), "hello nova", "replace")
}

fn test_str_repeat() {
  assert_eq3(repeat3("ab", 3), "ababab", "repeat 3x")
}

fn test_str_empty() {
  assert_trit3(is_empty3(""), 1, "empty string")
  assert_trit3(is_empty3("x"), -1, "non-empty string")
}

let string_results = suite3("String3 Stdlib", [
  test_str_trim, test_str_case, test_str_contains,
  test_str_split_join, test_str_replace, test_str_repeat, test_str_empty
])

// ============================================================
// GROUP 3: list3 (7 tests)
// ============================================================
import3 list3

fn test_list_map() {
  fn double(x) { return x * 2 }
  let result = map3([1, 2, 3], double)
  assert_eq3(result[0], 2, "map double [0]")
  assert_eq3(result[2], 6, "map double [2]")
}

fn test_list_filter() {
  fn positive(x) { return x }
  let result = filter3([1, -1, 0, 1, -1], positive)
  assert_eq3(len(result), 2, "filter positive count")
}

fn test_list_reduce() {
  fn add(a, b) { return a + b }
  assert_eq3(reduce3([1, 2, 3, 4], add, 0), 10, "reduce sum")
}

fn test_list_find() {
  fn is_seven(x) { return cmp3(x, 7) }
  let result = find3([3, 5, 7, 9], is_seven)
  assert_eq3(result["value"], 7, "find 7")
}

fn test_list_flatten() {
  let result = flatten3([[1, 2], [3, 4], [5]])
  assert_eq3(len(result), 5, "flatten 5 elements")
}

fn test_list_unique() {
  let result = unique3([1, 2, 2, 3, 3, 3])
  assert_eq3(len(result), 3, "unique 3 elements")
}

fn test_list_chunk() {
  let result = chunk3([1, 2, 3, 4, 5], 2)
  assert_eq3(len(result), 3, "chunk into 3 groups")
}

let list_results = suite3("List3 Stdlib", [
  test_list_map, test_list_filter, test_list_reduce,
  test_list_find, test_list_flatten, test_list_unique, test_list_chunk
])

// ============================================================
// GROUP 4: trit3 (7 tests)
// ============================================================
import3 trit3

fn test_trit_not() {
  assert_eq3(not3(1), -1, "not(+1) = -1")
  assert_eq3(not3(-1), 1, "not(-1) = +1")
  assert_eq3(not3(0), 0, "not(0) = 0")
}

fn test_trit_and_or() {
  assert_eq3(and3(1, -1), -1, "and(+1,-1) = -1")
  assert_eq3(or3(1, -1), 1, "or(+1,-1) = +1")
}

fn test_trit_consensus() {
  assert_eq3(consensus3(1, 1, -1), 1, "2 vs 1 = majority")
  assert_eq3(consensus3(-1, -1, 1), -1, "2 neg vs 1 pos")
}

fn test_trit_checks() {
  assert_trit3(is_true3(1), 1, "1 is true")
  assert_trit3(is_maybe3(0), 1, "0 is maybe")
  assert_trit3(is_false3(-1), 1, "-1 is false")
}

fn test_trit_to() {
  assert_eq3(to_trit3(42), 1, "positive → +1")
  assert_eq3(to_trit3(0), 0, "zero → 0")
  assert_eq3(to_trit3(-7), -1, "negative → -1")
}

fn test_trit_counts() {
  let c = trit_counts3([1, 1, 0, -1, 1])
  assert_eq3(c["positive"], 3, "3 positive")
  assert_eq3(c["negative"], 1, "1 negative")
  assert_eq3(c["maybe"], 1, "1 maybe")
}

fn test_trit_all_any() {
  assert_trit3(all_true3([1, 1, 1]), 1, "all true")
  assert_trit3(all_true3([1, 0, 1]), 0, "not all true")
  assert_trit3(any_true3([-1, -1, 1]), 1, "any true")
  assert_trit3(any_true3([-1, -1, -1]), -1, "none true")
}

let trit_results = suite3("Trit3 Stdlib", [
  test_trit_not, test_trit_and_or, test_trit_consensus,
  test_trit_checks, test_trit_to, test_trit_counts, test_trit_all_any
])

// ============================================================
// GROUP 5: dict3 (5 tests)
// ============================================================
import3 dict3

fn test_dict_get() {
  let d = {"a": 1, "b": 2}
  assert_eq3(dget3(d, "a", 0), 1, "get existing key")
  assert_eq3(dget3(d, "z", 99), 99, "get missing key default")
}

fn test_dict_has_key() {
  let d = {"x": 10}
  assert_trit3(has_key3(d, "x"), 1, "has key x")
  assert_trit3(has_key3(d, "y"), -1, "no key y")
}

fn test_dict_merge() {
  let a = {"x": 1, "y": 2}
  let b = {"y": 3, "z": 4}
  let m = merge3(a, b)
  assert_eq3(dget3(m, "y", 0), 3, "merge overwrites")
  assert_eq3(dget3(m, "z", 0), 4, "merge adds")
}

fn test_dict_pick_omit() {
  let d = {"a": 1, "b": 2, "c": 3}
  let p = pick3(d, ["a", "c"])
  assert_eq3(dict_size3(p), 2, "pick 2 keys")
}

fn test_dict_size() {
  let d = {"a": 1, "b": 2, "c": 3}
  assert_eq3(dict_size3(d), 3, "size = 3")
  assert_trit3(dict_empty3(d), -1, "not empty")
  assert_trit3(dict_empty3({}), 1, "empty dict")
}

let dict_results = suite3("Dict3 Stdlib", [
  test_dict_get, test_dict_has_key, test_dict_merge, test_dict_pick_omit, test_dict_size
])

// ============================================================
// FINAL REPORT
// ============================================================
report3_multi([math_results, string_results, list_results, trit_results, dict_results])
