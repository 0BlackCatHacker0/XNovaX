let a = str(3)
let b = str(3)
print("a=" + a + " b=" + b)
let c = cmp3(a, b)
print("cmp3(str(3), str(3)): " + str(c))
if3 c {
  print("TRUE branch")
} maybe {
  print("MAYBE branch")
} else3 {
  print("ELSE3 branch")
}

// Try == instead
if3 a == b {
  print("== TRUE branch")
} maybe {
  print("== MAYBE branch")
} else3 {
  print("== ELSE3 branch")
}
