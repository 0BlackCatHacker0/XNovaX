// ============================================================
// NovaLang Stdlib Comprehensive Test Suite v2
// Tests 13 testable stdlib modules (io3/http3/async3/test3 need services)
// ============================================================

let _total = 0
let _pass = 0
let _fail = 0
let _errors = []

fn check_eq(name, actual, expected) {
  _total = _total + 1
  if3 str(actual) == str(expected) {
    _pass = _pass + 1
    print("[PASS] " + name)
    return 1
  } else3 {
    _fail = _fail + 1
    _errors = push(_errors, name + ": exp=[" + str(expected) + "] got=[" + str(actual) + "]")
    print("[FAIL] " + name + " exp=[" + str(expected) + "] got=[" + str(actual) + "]")
    return -1
  }
}

// ============================================================
// MODULE 1: math3 (22 fns + 13 constants)
// ============================================================
import3("C:/NovaX/stdlib/math3.nova")
print("=== math3 ===")
check_eq("m3.PI", str(PI), str(3.141592653589793))
check_eq("m3.H3", H3, 3)
check_eq("m3.BLOCK", BLOCK, 2187)
check_eq("m3.abs3(5)", abs3(5), 5)
check_eq("m3.abs3(-5)", abs3(-5), 5)
check_eq("m3.abs3(0)", abs3(0), 0)
check_eq("m3.sign3(10)", sign3(10), 1)
check_eq("m3.sign3(0)", sign3(0), 0)
check_eq("m3.sign3(-10)", sign3(-10), -1)
check_eq("m3.clamp3(5,0,10)", clamp3(5, 0, 10), 5)
check_eq("m3.clamp3(-5,0,10)", clamp3(-5, 0, 10), 0)
check_eq("m3.clamp3(15,0,10)", clamp3(15, 0, 10), 10)
check_eq("m3.min3(3,7)", min3(3, 7), 3)
check_eq("m3.max3(3,7)", max3(3, 7), 7)
check_eq("m3.min_list3", min_list3([5, 2, 8, 1]), 1)
check_eq("m3.max_list3", max_list3([5, 2, 8, 1]), 8)
check_eq("m3.sum3", sum3([1, 2, 3, 4]), 10)
check_eq("m3.avg3", avg3([2, 4, 6]), 4)
check_eq("m3.floor3(3.7)", floor3(3.7), 3)
check_eq("m3.ceil3(3.2)", ceil3(3.2), 4)
check_eq("m3.pow3(2,3)", pow3(2, 3), 8)
check_eq("m3.pow3(3,0)", pow3(3, 0), 1)
check_eq("m3.factorial3(5)", factorial3(5), 120)
check_eq("m3.factorial3(0)", factorial3(0), 1)
check_eq("m3.gcd3(12,8)", gcd3(12, 8), 4)
check_eq("m3.lcm3(4,6)", lcm3(4, 6), 12)
check_eq("m3.map_range3", map_range3(5, 0, 10, 0, 100), 50)
check_eq("m3.lerp3", lerp3(0, 10, 0.5), 5)
check_eq("m3.dist3", dist3(3, 7), 4)
check_eq("m3.round3(7,5)", round3(7, 5), 5)
check_eq("m3.round3(8,5)", round3(8, 5), 10)
check_eq("m3.in_range3(5,0,10)", in_range3(5, 0, 10), 1)
check_eq("m3.in_range3(-1,0,10)", in_range3(-1, 0, 10), -1)

// ============================================================
// MODULE 2: string3 (17 fns)
// ============================================================
import3("C:/NovaX/stdlib/string3.nova")
print("=== string3 ===")
check_eq("s3.trim3", trim3("  hi  "), "hi")
check_eq("s3.upper3", upper3("hello"), "HELLO")
check_eq("s3.lower3", lower3("HELLO"), "hello")
check_eq("s3.contains3 yes", contains3("hello world", "world"), 1)
check_eq("s3.contains3 no", contains3("hello", "xyz"), -1)
check_eq("s3.starts_with3 yes", starts_with3("hello", "hel"), 1)
check_eq("s3.starts_with3 no", starts_with3("hello", "xyz"), 0)
check_eq("s3.ends_with3 yes", ends_with3("hello", "llo"), 1)
check_eq("s3.ends_with3 no", ends_with3("hello", "xyz"), 0)
let sp = split3("a,b,c", ",")
check_eq("s3.split3 len", len(sp), 3)
check_eq("s3.join3", join3(["a", "b", "c"], "-"), "a-b-c")
check_eq("s3.replace3", replace3("hello", "l", "r"), "herro")
check_eq("s3.repeat3", repeat3("ab", 3), "ababab")
check_eq("s3.pad_left3", pad_left3("hi", 5, "*"), "***hi")
check_eq("s3.pad_right3", pad_right3("hi", 5, "*"), "hi***")
check_eq("s3.truncate3 long", truncate3("hello world", 8), "hello...")
check_eq("s3.truncate3 short", truncate3("hi", 8), "hi")
check_eq("s3.reverse3", reverse3("hello"), "olleh")
check_eq("s3.count3", count3("abcabc", "a"), 2)
check_eq("s3.is_empty3 content", is_empty3("hello"), 1)
check_eq("s3.is_empty3 empty", is_empty3(""), -1)
check_eq("s3.capitalize3", capitalize3("hello"), "Hello")
check_eq("s3.snake_to_camel3", snake_to_camel3("hello_world"), "helloWorld")
check_eq("s3.camel_to_snake3", camel_to_snake3("helloWorld"), "hello_world")

// ============================================================
// MODULE 3: list3 (18 fns)
// ============================================================
import3("C:/NovaX/stdlib/list3.nova")
print("=== list3 ===")
fn double(x) { return x * 2 }
let lm = map3([1, 2, 3], double)
check_eq("l3.map3[0]", lm[0], 2)
check_eq("l3.map3[2]", lm[2], 6)
fn is_pos(x) { if3 cmp3(x, 0) { return 1 } maybe { return 0 } else3 { return -1 } }
let lf = filter3([1, -1, 2, -2], is_pos)
check_eq("l3.filter3 len", len(lf), 2)
let lfs = filter_strict3([1, -1, 2, -2], is_pos)
check_eq("l3.filter_strict3", len(lfs), 2)
fn add_fn(a, b) { return a + b }
check_eq("l3.reduce3", reduce3([1, 2, 3, 4], add_fn, 0), 10)
fn eq5(x) { if3 cmp3(x, 5) { return -1 } maybe { return 1 } else3 { return -1 } }
check_eq("l3.find3", find3([1, 3, 5, 7], eq5), 5)
check_eq("l3.find_index3", find_index3([1, 3, 5, 7], eq5), 2)
check_eq("l3.some3", some3([1, 3, 5], is_pos), 1)
check_eq("l3.flatten3", len(flatten3([[1, 2], [3, 4]])), 4)
check_eq("l3.zip3 len", len(zip3([1, 2], [3, 4])), 2)
let tk = take3([1, 2, 3, 4, 5], 3)
check_eq("l3.take3 len", len(tk), 3)
check_eq("l3.take3[2]", tk[2], 3)
let dr = drop3([1, 2, 3, 4, 5], 2)
check_eq("l3.drop3 len", len(dr), 3)
check_eq("l3.drop3[0]", dr[0], 3)
let rv = reverse_list3([1, 2, 3])
check_eq("l3.reverse[0]", rv[0], 3)
check_eq("l3.reverse[2]", rv[2], 1)
check_eq("l3.chunk3 len", len(chunk3([1, 2, 3, 4], 2)), 2)

// ============================================================
// MODULE 4: dict3 (11 fns)
// ============================================================
import3("C:/NovaX/stdlib/dict3.nova")
print("=== dict3 ===")
let td = {"a": 1, "b": 2, "c": 3}
check_eq("d3.dget3 exist", dget3(td, "a", 0), 1)
check_eq("d3.dget3 miss", dget3(td, "z", 99), 99)
check_eq("d3.has_key3 yes", has_key3(td, "a"), 1)
check_eq("d3.has_key3 no", has_key3(td, "z"), -1)
check_eq("d3.keys3 len", len(keys3(td)), 3)
check_eq("d3.values3 len", len(values3(td)), 3)
check_eq("d3.merge3 len", len(keys3(merge3({"a": 1}, {"b": 2}))), 2)
check_eq("d3.pick3 len", len(keys3(pick3(td, ["a", "c"]))), 2)
check_eq("d3.omit3 len", len(keys3(omit3(td, ["b"]))), 2)
let mvd = map_values3({"x": 2, "y": 3}, double)
check_eq("d3.map_values3", dget3(mvd, "x", 0), 4)
let ivd = invert3({"a": "1", "b": "2"})
check_eq("d3.invert3", dget3(ivd, "1", ""), "a")
check_eq("d3.dict_size3", dict_size3(td), 3)
check_eq("d3.dict_empty3 yes", dict_empty3({}), 1)
check_eq("d3.dict_empty3 no", dict_empty3(td), -1)

// ============================================================
// MODULE 5: trit3 (14 fns + 3 constants)
// ============================================================
import3("C:/NovaX/stdlib/trit3.nova")
print("=== trit3 ===")
check_eq("t3.TRUE3", TRUE3, 1)
check_eq("t3.MAYBE3", MAYBE3, 0)
check_eq("t3.FALSE3", FALSE3, -1)
check_eq("t3.not3(1)", not3(1), -1)
check_eq("t3.not3(0)", not3(0), 0)
check_eq("t3.not3(-1)", not3(-1), 1)
check_eq("t3.and3(1,1)", and3(1, 1), 1)
check_eq("t3.and3(1,-1)", and3(1, -1), -1)
check_eq("t3.or3(1,-1)", or3(1, -1), 1)
check_eq("t3.or3(-1,-1)", or3(-1, -1), -1)
check_eq("t3.consensus3(1,1,1)", consensus3(1, 1, 1), 1)
check_eq("t3.consensus3(-1,-1,-1)", consensus3(-1, -1, -1), -1)
check_eq("t3.consensus3(1,0,-1)", consensus3(1, 0, -1), 0)
check_eq("t3.is_true3(1)", is_true3(1), 1)
check_eq("t3.is_true3(0)", is_true3(0), -1)
check_eq("t3.is_maybe3(0)", is_maybe3(0), 1)
check_eq("t3.is_false3(-1)", is_false3(-1), 1)
check_eq("t3.to_trit3(42)", to_trit3(42), 1)
check_eq("t3.to_trit3(0)", to_trit3(0), 0)
check_eq("t3.to_trit3(-5)", to_trit3(-5), -1)
check_eq("t3.trit_label3(1)", trit_label3(1), "TRUE")
check_eq("t3.trit_label3(0)", trit_label3(0), "MAYBE")
check_eq("t3.trit_label3(-1)", trit_label3(-1), "FALSE")
check_eq("t3.all_true3", all_true3([1, 1, 1]), 1)
check_eq("t3.any_true3 yes", any_true3([-1, 0, 1]), 1)
check_eq("t3.any_true3 no", any_true3([-1, -1]), -1)
let tc = trit_counts3([1, 0, -1, 1])
check_eq("t3.counts.pos", tc["positive"], 2)
check_eq("t3.counts.maybe", tc["maybe"], 1)
check_eq("t3.counts.neg", tc["negative"], 1)

// ============================================================
// MODULE 6: conv3 (11 fns)
// ============================================================
import3("C:/NovaX/stdlib/conv3.nova")
print("=== conv3 ===")
let ci = to_int3("42")
check_eq("c3.to_int3 val", ci["value"], 42)
check_eq("c3.to_int3 trit", ci["trit"], 1)
let cf = to_float3("3.14")
check_eq("c3.to_float3 trit", cf["trit"], 1)
let cs = to_str3(42)
check_eq("c3.to_str3", cs["value"], "42")
check_eq("c3.to_bool3(null)", to_bool3(null), 0)
check_eq("c3.to_bool3(0)", to_bool3(0), -1)
check_eq("c3.default3 null", default3(null, "fb"), "fb")
check_eq("c3.default3 val", default3(5, "fb"), 5)
check_eq("c3.type3(42)", type3(42), "int")
check_eq("c3.type3(str)", type3("hi"), "str")
check_eq("c3.is_type3 y", is_type3(42, "int"), 1)
check_eq("c3.is_type3 n", is_type3(42, "str"), -1)

// ============================================================
// MODULE 7: validate3 (6 fns)
// ============================================================
import3("C:/NovaX/stdlib/validate3.nova")
print("=== validate3 ===")
let v1 = check3(42, {"min": 0, "max": 100})
check_eq("v3.check3 valid", v1["trit"], 1)
let v2 = check3(-5, {"min": 0, "max": 100})
check_eq("v3.check3 invalid", v2["trit"], -1)
check_eq("v3.not_empty3 yes", not_empty3("hi"), 1)
check_eq("v3.not_empty3 no", not_empty3(""), -1)
check_eq("v3.one_of3 yes", one_of3("b", ["a", "b", "c"]), 1)
check_eq("v3.one_of3 no", one_of3("z", ["a", "b", "c"]), -1)

// ============================================================
// MODULE 8: pipe3 (8 fns)
// ============================================================
import3("C:/NovaX/stdlib/pipe3.nova")
print("=== pipe3 ===")
fn add1(x) { return x + 1 }
fn times2(x) { return x * 2 }
let pr = pipe3(5, [add1, times2])
check_eq("p3.pipe3 result", pr["result"], 12)
check_eq("p3.pipe3 trit", pr["trit"], 1)
check_eq("p3.tap3", tap3(42, add1), 42)
check_eq("p3.when3 t", when3(5, 1, double), 10)
check_eq("p3.when3 f", when3(5, -1, double), 5)
check_eq("p3.unless3 t", unless3(5, 1, double), 5)
check_eq("p3.unless3 f", unless3(5, -1, double), 10)

// ============================================================
// MODULE 9: format3 (9 fns)
// ============================================================
import3("C:/NovaX/stdlib/format3.nova")
print("=== format3 ===")
check_eq("f3.template3", template3("Hello {name}!", {"name": "Nova"}), "Hello Nova!")
check_eq("f3.pad_num3", pad_num3(42, 6), "    42")
check_eq("f3.pad_str3", pad_str3("hi", 6), "hi    ")
check_eq("f3.trit_fmt3(1)", trit_fmt3(1), "[+1 OK]")
check_eq("f3.trit_fmt3(0)", trit_fmt3(0), "[ 0 ??]")
check_eq("f3.trit_fmt3(-1)", trit_fmt3(-1), "[-1 !!]")
check_eq("f3.bytes_fmt3(500)", bytes_fmt3(500), "500 B")
check_eq("f3.bytes_fmt3(2048)", bytes_fmt3(2048), "2 KB")
check_eq("f3.pct_fmt3(25,100)", pct_fmt3(25, 100), "25%")
check_eq("f3.pct_fmt3(0,0)", pct_fmt3(0, 0), "0%")

// ============================================================
// MODULE 10: json3 (8 fns)
// ============================================================
import3("C:/NovaX/stdlib/json3.nova")
print("=== json3 ===")
let jp = parse3("{\"a\":1}")
check_eq("j3.parse3 trit", jp["trit"], 1)
let jst = stringify3({"x": 42})
check_eq("j3.stringify3 trit", jst["trit"], 1)
let jpath = json_path3({"a": {"b": 99}}, "a.b")
check_eq("j3.json_path3", jpath["value"], 99)
let jset = json_set3({"a": 1}, "b", 2)
check_eq("j3.json_set3", dget3(jset, "b", 0), 2)
let hk = has_keys3({"a": 1, "b": 2}, ["a", "b"])
check_eq("j3.has_keys3 ok", hk["trit"], 1)
let hk2 = has_keys3({"a": 1}, ["a", "b"])
check_eq("j3.has_keys3 miss", hk2["trit"], -1)
let jd = diff3({"a": 1}, {"a": 2})
check_eq("j3.diff3 count>0", cmp3(jd["count"], 0), 1)

// ============================================================
// MODULE 11: time3 (10 fns)
// ============================================================
import3("C:/NovaX/stdlib/time3.nova")
print("=== time3 ===")
let tn = now3()
check_eq("ti3.now3>0", cmp3(tn, 0), 1)
let tnms = now_ms3()
check_eq("ti3.now_ms3>0", cmp3(tnms, 0), 1)
check_eq("ti3.duration3(30)", duration3(30), "30s")
check_eq("ti3.duration3(90)", duration3(90), "1m 30s")
check_eq("ti3.duration3(3700)", duration3(3700), "1h 1m 40s")
let tss = timestamp_str3(12345)
check_eq("ti3.timestamp_str3", starts_with3(tss, "T+"), 1)

// ============================================================
// MODULE 12: log3 (12 fns + 4 constants)
// ============================================================
import3("C:/NovaX/stdlib/log3.nova")
print("=== log3 ===")
check_eq("lg3.LOG_DEBUG", LOG_DEBUG, 0)
check_eq("lg3.LOG_INFO", LOG_INFO, 1)
check_eq("lg3.set_level3", set_level3(0), 1)
check_eq("lg3.info3", info3("test"), 1)
check_eq("lg3.warn3", warn3("test"), 1)
check_eq("lg3.error3", error3("test"), 1)
let logs = get_logs3()
check_eq("lg3.get_logs3", cmp3(len(logs), 0), 1)
check_eq("lg3.clear_logs3", clear_logs3(), 1)
check_eq("lg3.after clear", len(get_logs3()), 0)

// ============================================================
// MODULE 13: event3 (6 fns)
// ============================================================
import3("C:/NovaX/stdlib/event3.nova")
print("=== event3 ===")
fn evt_handler(data) { return data }
on3("test_evt", evt_handler)
let em = emit3("test_evt", "hello")
check_eq("e3.emit3 called", em["called"], 1)
check_eq("e3.emit3 trit", em["trit"], 1)
let evts = events3()
check_eq("e3.events3 has", cmp3(len(evts), 0), 1)
let ofr = off3("test_evt")
check_eq("e3.off3 trit", ofr["trit"], 1)

