print("")
print("=============================================")
print("STDLIB FULL TEST SUMMARY")
print("=============================================")
print("Total:  " + str(_total))
print("Pass:   " + str(_pass))
print("Fail:   " + str(_fail))
print("=============================================")
if3 cmp3(_fail, 0) {
  print("RESULT: SOME TESTS FAILED")
  for3 e in _errors {
    print("  ERR: " + e)
  }
} maybe {
  print("RESULT: ALL TESTS PASSED!")
} else3 {
  print("RESULT: ALL TESTS PASSED!")
}
