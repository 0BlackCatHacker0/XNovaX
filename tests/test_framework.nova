// ============================================================
// NOVAX INTEGRATION TEST FRAMEWORK v1.0
// ============================================================
// Ternary-native test runner for the NovaX ecosystem.
// Every test returns a trit: +1=pass, 0=warn/partial, -1=fail.
// Uses 3-5-7-13 harmonic constants throughout.
//
// Usage:
//   import3 "tests/test_framework.nova" { test3, assert3, assert_eq3, assert_trit3, suite3, report3 }
//
//   let results = suite3("My Suite", [my_test_1, my_test_2, ...])
//   report3(results)
// ============================================================

// -- 3-5-7-13 Harmonic Constants --
let H3 = 3
let H5 = 5
let H7 = 7
let H13 = 13
let BLOCK_SIZE = 2187

// -- Framework version --
let FRAMEWORK_VERSION = "1.0.0"

// ============================================================
// ASSERT PRIMITIVES
// ============================================================

// assert3(condition, message)
// If condition is falsy (0, false, null, "", []), throw with message.
// Returns +1 on success.
fn assert3(condition, message) {
  if3 condition {
    return 1
  } maybe {
    assert(false)
  } else3 {
    assert(false)
  }
}

// assert_eq3(actual, expected, msg)
// Assert strict equality. On failure, includes actual vs expected in error.
fn assert_eq3(actual, expected, msg) {
  let are_equal = actual == expected
  if3 are_equal {
    return 1
  } maybe {
    let detail = msg + " | expected: " + str(expected) + ", got: " + str(actual)
    assert(false)
  } else3 {
    let detail = msg + " | expected: " + str(expected) + ", got: " + str(actual)
    assert(false)
  }
}

// assert_neq3(actual, unexpected, msg)
// Assert values are NOT equal.
fn assert_neq3(actual, unexpected, msg) {
  let are_equal = actual == unexpected
  if3 are_equal {
    let detail = msg + " | should not equal: " + str(unexpected)
    assert(false)
  } maybe {
    return 1
  } else3 {
    return 1
  }
}

// assert_trit3(value, expected_trit, msg)
// Assert that a value, when constrained to trit, matches expected (-1, 0, or +1).
fn assert_trit3(value, expected_trit, msg) {
  let t = trit(value)
  let e = trit(expected_trit)
  let match = t == e
  if3 match {
    return 1
  } maybe {
    let detail = msg + " | expected trit: " + "unknown error" + ", got: " + str(t)
    assert(false)
  } else3 {
    let detail = msg + " | expected trit: " + "unknown error" + ", got: " + str(t)
    assert(false)
  }
}

// assert_gt3(a, b, msg) -- assert a > b
fn assert_gt3(a, b, msg) {
  let c = cmp3(a, b)
  if3 c {
    return 1
  } maybe {
    let detail = msg + " | expected " + str(a) + " > " + str(b)
    assert(false)
  } else3 {
    let detail = msg + " | expected " + str(a) + " > " + str(b)
    assert(false)
  }
}

// assert_lt3(a, b, msg) -- assert a < b
fn assert_lt3(a, b, msg) {
  let c = cmp3(a, b)
  if3 c {
    let detail = msg + " | expected " + str(a) + " < " + str(b)
    assert(false)
  } maybe {
    let detail = msg + " | expected " + str(a) + " < " + str(b)
    assert(false)
  } else3 {
    return 1
  }
}

// assert_contains3(haystack, needle, msg) -- assert string contains substring
fn assert_contains3(haystack, needle, msg) {
  let found = contains(str(haystack), str(needle))
  if3 found {
    return 1
  } maybe {
    let detail = msg + " | '" + str(haystack) + "' does not contain '" + str(needle) + "'"
    assert(false)
  } else3 {
    let detail = msg + " | '" + str(haystack) + "' does not contain '" + str(needle) + "'"
    assert(false)
  }
}

// assert_len3(collection, expected_len, msg) -- assert length equals expected
fn assert_len3(collection, expected_len, msg) {
  let actual_len = len(collection)
  let match = actual_len == expected_len
  if3 match {
    return 1
  } maybe {
    let detail = msg + " | expected len: " + str(expected_len) + ", got: " + str(actual_len)
    assert(false)
  } else3 {
    let detail = msg + " | expected len: " + str(expected_len) + ", got: " + str(actual_len)
    assert(false)
  }
}

// assert_type3(value, expected_type, msg) -- assert type name matches
fn assert_type3(value, expected_type, msg) {
  let actual_type = type(value)
  let match = actual_type == expected_type
  if3 match {
    return 1
  } maybe {
    let detail = msg + " | expected type: " + expected_type + ", got: " + actual_type
    assert(false)
  } else3 {
    let detail = msg + " | expected type: " + expected_type + ", got: " + actual_type
    assert(false)
  }
}

// ============================================================
// TEST RUNNER
// ============================================================

// test3(name, test_fn)
// Run a single test function, catch errors, return result dict.
// Returns: {name, trit, message, elapsed_ms}
//   trit: +1=pass, 0=warn, -1=fail
fn test3(name, test_fn) {
  let t_start = time()
  let result = {"name": name, "trit": 0, "message": "", "elapsed_ms": 0}
  try3 {
    let rv = test_fn()
    let t_end = time()
    let elapsed = (t_end - t_start) * 1000
    let result = {"name": name, "trit": 1, "message": "pass", "elapsed_ms": elapsed}
    return result
  } uncertain {
    let t_end = time()
    let elapsed = (t_end - t_start) * 1000
    let result = {"name": name, "trit": 0, "message": "uncertain", "elapsed_ms": elapsed}
    return result
  } fail3 {
    let t_end = time()
    let elapsed = (t_end - t_start) * 1000
    let err_msg = _error
    let result = {"name": name, "trit": -1, "message": str(err_msg), "elapsed_ms": elapsed}
    return result
  }
  return result
}

// ============================================================
// TEST SUITE
// ============================================================

// suite3(name, tests)
// Run a list of test functions. Each test_fn should call assert3 internally.
// Returns: {name, results, pass_count, warn_count, fail_count, total, trit, elapsed_ms}
fn suite3(name, tests) {
  let results = []
  let pass_count = 0
  let warn_count = 0
  let fail_count = 0
  let suite_start = time()

  for3 test_entry in tests {
    let test_name = test_entry[0]
    let test_fn = test_entry[1]
    let r = test3(test_name, test_fn)

    // Classify result by trit
    let t = r["trit"]
    let is_pass = t == 1
    let is_warn = t == 0
    if3 is_pass {
      let pass_count = pass_count + 1
    } maybe {
      // is_warn path (trit == 0 can go here)
    } else3 {
      // check if warn or fail
    }
    // Secondary check for warn vs fail
    if3 is_warn {
      let warn_count = warn_count + 1
    } else3 {
      // neither pass nor warn = fail
      let is_fail = t == -1
      if3 is_fail {
        let fail_count = fail_count + 1
      } else3 {
        // fallback
      }
    }

    append(results, r)

    // Print per-test result
    let trit_sym = "?"
    let is_p = t == 1
    if3 is_p {
      let trit_sym = "+1"
    } else3 {
      let is_w = t == 0
      if3 is_w {
        let trit_sym = " 0"
      } else3 {
        let trit_sym = "-1"
      }
    }
    print("  [" + trit_sym + "] " + test_name + " (" + str(round(r["elapsed_ms"], 1)) + "ms)")

    // Print failure details
    let is_fail_detail = t == -1
    if3 is_fail_detail {
      print("       FAIL: " + str(r["message"]))
    } else3 {
      // no detail needed
    }
  }

  let suite_end = time()
  let suite_elapsed = (suite_end - suite_start) * 1000
  let total = len(tests)

  // Determine overall suite trit
  // +1 = all pass, 0 = some warn/partial, -1 = any fail
  let suite_trit = 1
  let has_fail = fail_count > 0
  if3 has_fail {
    let suite_trit = -1
  } else3 {
    let has_warn = warn_count > 0
    if3 has_warn {
      let suite_trit = 0
    } else3 {
      let suite_trit = 1
    }
  }

  let summary = {
    "name": name,
    "results": results,
    "pass_count": pass_count,
    "warn_count": warn_count,
    "fail_count": fail_count,
    "total": total,
    "trit": suite_trit,
    "elapsed_ms": suite_elapsed
  }

  return summary
}

// ============================================================
// REPORT FORMATTER
// ============================================================

// report3(results)
// Takes a suite summary (or list of suite summaries) and prints a formatted report.
// Uses 3-5-7-13 harmonic formatting.
fn report3(suite_result) {
  let name = suite_result["name"]
  let total = suite_result["total"]
  let pc = suite_result["pass_count"]
  let wc = suite_result["warn_count"]
  let fc = suite_result["fail_count"]
  let elapsed = suite_result["elapsed_ms"]
  let st = suite_result["trit"]

  print("")
  print("================================================================")
  print("  NOVAX TEST REPORT: " + name)
  print("================================================================")
  print("")
  print("  " + str(total) + " tests: " + str(pc) + " pass (+1), " + str(wc) + " warn (0), " + str(fc) + " fail (-1)")
  print("")

  // Trit bar: visual representation
  let bar = "  ["
  let i = 0
  for3 r in suite_result["results"] {
    let t = r["trit"]
    let is_p = t == 1
    if3 is_p {
      let bar = bar + "1"
    } else3 {
      let is_w = t == 0
      if3 is_w {
        let bar = bar + "0"
      } else3 {
        let bar = bar + "T"
      }
    }
    let i = i + 1
  }
  let bar = bar + "]"
  print(bar)
  print("")

  // Suite verdict
  let verdict = "UNKNOWN"
  let is_pass = st == 1
  if3 is_pass {
    let verdict = "ALL PASS (+1)"
  } else3 {
    let is_warn = st == 0
    if3 is_warn {
      let verdict = "PARTIAL (0)"
    } else3 {
      let verdict = "FAILURES (-1)"
    }
  }
  print("  Verdict: " + verdict)
  print("  Elapsed: " + str(round(elapsed, 1)) + "ms")
  print("  H13 alignment: " + str(total) + " tests / " + str(H13) + " = " + str(total / H13))
  print("================================================================")
  print("")

  return st
}

// report3_multi(suite_results)
// Takes a list of suite summaries and prints a combined report.
fn report3_multi(suite_results) {
  let total_pass = 0
  let total_warn = 0
  let total_fail = 0
  let total_tests = 0
  let overall_trit = 1

  print("")
  print("================================================================")
  print("  NOVAX INTEGRATION TEST REPORT")
  print("  Framework v" + FRAMEWORK_VERSION + " | 3-5-7-13 Harmonics")
  print("================================================================")

  for3 suite in suite_results {
    let name = suite["name"]
    let pc = suite["pass_count"]
    let wc = suite["warn_count"]
    let fc = suite["fail_count"]
    let st = suite["trit"]
    let total = suite["total"]

    let trit_sym = "+1"
    let is_p = st == 1
    if3 is_p {
      let trit_sym = "+1"
    } else3 {
      let is_w = st == 0
      if3 is_w {
        let trit_sym = " 0"
      } else3 {
        let trit_sym = "-1"
      }
    }

    print("  [" + trit_sym + "] " + name + ": " + str(pc) + "/" + str(total) + " pass, " + str(wc) + " warn, " + str(fc) + " fail")

    let total_pass = total_pass + pc
    let total_warn = total_warn + wc
    let total_fail = total_fail + fc
    let total_tests = total_tests + total

    // Downgrade overall trit
    let has_fail = fc > 0
    if3 has_fail {
      let overall_trit = -1
    } else3 {
      let has_warn = wc > 0
      if3 has_warn {
        let only_if_not_fail = overall_trit == 1
        if3 only_if_not_fail {
          let overall_trit = 0
        } else3 {
          // keep -1
        }
      } else3 {
        // keep current
      }
    }
  }

  print("")
  print("  TOTAL: " + str(total_tests) + " tests: " + str(total_pass) + " pass (+1), " + str(total_warn) + " warn (0), " + str(total_fail) + " fail (-1)")

  let verdict = "UNKNOWN"
  let is_pass = overall_trit == 1
  if3 is_pass {
    let verdict = "ALL SUITES PASS (+1)"
  } else3 {
    let is_warn = overall_trit == 0
    if3 is_warn {
      let verdict = "PARTIAL (0)"
    } else3 {
      let verdict = "FAILURES DETECTED (-1)"
    }
  }

  print("  Overall: " + verdict)
  print("================================================================")
  print("")

  return overall_trit
}

// ============================================================
// EXPORTS
// ============================================================
export3 { H3, H5, H7, H13, BLOCK_SIZE, FRAMEWORK_VERSION }
export3 { assert3, assert_eq3, assert_neq3, assert_trit3 }
export3 { assert_gt3, assert_lt3, assert_contains3, assert_len3, assert_type3 }
export3 { test3, suite3, report3, report3_multi }
