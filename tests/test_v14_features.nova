// NovaLang v1.4 Feature Tests
// Tests all new language features and builtins
// Run: novalang tests/test_v14_features.nova

print("=== NovaLang v1.4 Feature Tests ===")
print("")

// ═══════════════════════════════════════
// LANGUAGE FEATURES
// ═══════════════════════════════════════

// TEST 1: Null Coalescing (??)
let a = null
let b = a ?? "default"
print(f"[TEST] null ?? 'default' = {b} (expect default)")
let c = 42
let d = c ?? 99
print(f"[TEST] 42 ?? 99 = {d} (expect 42)")
let e = null ?? null ?? "found"
print(f"[TEST] null ?? null ?? 'found' = {e} (expect found)")

// TEST 2: Range Operator (..)
let nums = 1..5
print(f"[TEST] 1..5 = {nums} (expect [1, 2, 3, 4])")
let big = 0..3
print(f"[TEST] 0..3 = {big} (expect [0, 1, 2])")

// TEST 3: Spread Operator (...)
let x = [1, 2, 3]
let y = [4, 5, 6]
let combined = [...x, ...y]
print(f"[TEST] [...x, ...y] = {combined} (expect [1, 2, 3, 4, 5, 6])")

let prefix = [0]
let all = [...prefix, ...x, 99]
print(f"[TEST] [...prefix, ...x, 99] = {all} (expect [0, 1, 2, 3, 99])")

// TEST 4: Dict Spread
let base = {"a": 1, "b": 2}
let extra = {"b": 3, "c": 4}
let merged = {...base, ...extra}
print(f"[TEST] dict spread merge = {merged}")

// TEST 5: In Operator
let fruits = ["apple", "banana", "cherry"]
let has_banana = "banana" in fruits
let has_grape = "grape" in fruits
print(f"[TEST] 'banana' in fruits = {has_banana} (expect TRUE)")
print(f"[TEST] 'grape' in fruits = {has_grape} (expect FALSE)")

let data = {"name": "Nova", "ver": 1.4}
let has_name = "name" in data
print(f"[TEST] 'name' in dict = {has_name} (expect TRUE)")

let has_sub = "ova" in "NovaLang"
print(f"[TEST] 'ova' in 'NovaLang' = {has_sub} (expect TRUE)")

// TEST 6: Default Parameters
fn greet(name, greeting = "Hello") {
    return f"{greeting}, {name}!"
}
print(f"[TEST] greet('World') = {greet('World')} (expect Hello, World!)")
print(f"[TEST] greet('Nova', 'Hey') = {greet('Nova', 'Hey')} (expect Hey, Nova!)")

fn calc(a, b = 10, c = 100) {
    return a + b + c
}
print(f"[TEST] calc(1) = {calc(1)} (expect 111)")
print(f"[TEST] calc(1, 2) = {calc(1, 2)} (expect 103)")
print(f"[TEST] calc(1, 2, 3) = {calc(1, 2, 3)} (expect 6)")

// TEST 7: List Destructuring
let [first, second, third] = [10, 20, 30]
print(f"[TEST] let [a,b,c] = [10,20,30] → a={first}, b={second}, c={third}")

let coords = [3.14, 2.71, 1.41]
let [px, py, pz] = coords
print(f"[TEST] destructure coords → x={px}, y={py}, z={pz}")

// TEST 8: Lambda with Default Params
let multiply = fn(a, b = 2) { return a * b }
print(f"[TEST] lambda multiply(5) = {multiply(5)} (expect 10)")
print(f"[TEST] lambda multiply(5, 3) = {multiply(5, 3)} (expect 15)")

print("")
print("═══════════════════════════════════════")
print("BUILTIN FUNCTIONS")
print("═══════════════════════════════════════")
print("")

// ── Type Checking ──
print(f"[TEST] is_int(42) = {is_int(42)} (expect TRUE)")
print(f"[TEST] is_float(3.14) = {is_float(3.14)} (expect TRUE)")
print(f"[TEST] is_str('hello') = {is_str('hello')} (expect TRUE)")
print(f"[TEST] is_list([1,2]) = {is_list([1, 2])} (expect TRUE)")
let empty_dict = dict()
print(f"[TEST] is_dict(dict()) = {is_dict(empty_dict)} (expect TRUE)")
print(f"[TEST] is_null(null) = {is_null(null)} (expect TRUE)")
print(f"[TEST] is_trit(TRUE) = {is_trit(TRUE)} (expect TRUE)")
print(f"[TEST] is_number('42') = {is_number('42')} (expect TRUE)")
print(f"[TEST] is_empty('') = {is_empty('')} (expect TRUE)")
print(f"[TEST] is_empty([]) = {is_empty([])} (expect TRUE)")

// ── Collection Power ──
let items = [1, 2, 2, 3, 3, 3]
print(f"[TEST] unique([1,2,2,3,3,3]) = {unique(items)}")
print(f"[TEST] count([1,2,2,3,3,3], 3) = {count(items, 3)} (expect 3)")
print(f"[TEST] every([1, 2, 3]) = {every([1, 2, 3])} (expect TRUE)")
print(f"[TEST] some([0, 0, 1]) = {some([0, 0, 1])} (expect TRUE)")
print(f"[TEST] none([0, 0, 0]) = {none([0, 0, 0])} (expect TRUE)")

let chunked = chunk([1,2,3,4,5,6], 2)
print(f"[TEST] chunk([1..6], 2) = {chunked}")

let taken = take([10,20,30,40,50], 3)
print(f"[TEST] take([10..50], 3) = {taken} (expect [10,20,30])")

let dropped = drop([10,20,30,40,50], 2)
print(f"[TEST] drop([10..50], 2) = {dropped} (expect [30,40,50])")

print(f"[TEST] first([7,8,9]) = {first([7, 8, 9])} (expect 7)")
print(f"[TEST] last([7,8,9]) = {last([7, 8, 9])} (expect 9)")

let sparse = [1, null, 0, "hello", null]
print(f"[TEST] compact([1,null,0,'hello',null]) = {compact(sparse)}")

// ── String Power ──
print(f"[TEST] substr('NovaLang', 4) = {substr('NovaLang', 4)} (expect Lang)")
print(f"[TEST] substr('NovaLang', 0, 4) = {substr('NovaLang', 0, 4)} (expect Nova)")
print(f"[TEST] char_at('Nova', 2) = {char_at('Nova', 2)} (expect v)")
print(f"[TEST] trim_start('  hello') = '{trim_start('  hello')}' (expect 'hello')")
print(f"[TEST] trim_end('hello  ') = '{trim_end('hello  ')}' (expect 'hello')")
print(f"[TEST] capitalize('hello world') = {capitalize('hello world')}")
print(f"[TEST] title_case('hello world') = {title_case('hello world')}")
print(f"[TEST] is_alpha('abc') = {is_alpha('abc')} (expect TRUE)")
print(f"[TEST] is_digit('123') = {is_digit('123')} (expect TRUE)")
print(f"[TEST] str_count('banana', 'na') = {str_count('banana', 'na')} (expect 2)")
print(f"[TEST] str_reverse('Nova') = {str_reverse('Nova')} (expect avoN)")

// ── Math Power ──
print(f"[TEST] clamp(15, 0, 10) = {clamp(15, 0, 10)} (expect 10)")
print(f"[TEST] clamp(-5, 0, 10) = {clamp(-5, 0, 10)} (expect 0)")
print(f"[TEST] sign(42) = {sign(42)} (expect TRUE/+1)")
print(f"[TEST] sign(-7) = {sign(-7)} (expect FALSE/-1)")
print(f"[TEST] sign(0) = {sign(0)} (expect MAYBE/0)")
print(f"[TEST] lerp(0, 100, 0.5) = {lerp(0, 100, 0.5)} (expect 50)")
print(f"[TEST] factorial(5) = {factorial(5)} (expect 120)")
print(f"[TEST] gcd(12, 8) = {gcd(12, 8)} (expect 4)")
print(f"[TEST] lcm(4, 6) = {lcm(4, 6)} (expect 12)")

// ── Conversion ──
print(f"[TEST] hex(255) = {hex(255)} (expect 0xff)")
print(f"[TEST] oct(8) = {oct(8)} (expect 0o10)")
print(f"[TEST] bin(10) = {bin(10)} (expect 0b1010)")
print(f"[TEST] parse_int('ff', 16) = {parse_int('ff', 16)} (expect 255)")

// ── Date/Time ──
let today = date_now()
print(f"[TEST] date_now() = {today}")
let ts = timestamp()
print(f"[TEST] timestamp() = {ts}")

// ── Group By (advanced) ──
let people = [
    {"name": "Alice", "dept": "eng"},
    {"name": "Bob", "dept": "eng"},
    {"name": "Carol", "dept": "sales"}
]
let grouped = group_by(people, "dept")
print(f"[TEST] group_by(people, 'dept') = {grouped}")

let names = pluck(people, "name")
print(f"[TEST] pluck(people, 'name') = {names}")

print("")
print("=== All v1.4 tests complete ===")
