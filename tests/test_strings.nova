// test_strings.nova — Tests string builtins
// Expected: exit 0 (all pass)

let pass = 0
let total = 0

// trim
total = total + 1
if3 trim("  hello  ") == "hello" { pass = pass + 1 } else { print("FAIL: trim") }

// split
total = total + 1
let parts = split("a,b,c", ",")
if3 len(parts) == 3 { pass = pass + 1 } else { print("FAIL: split len = " + str(len(parts))) }

// join
total = total + 1
let joined = join(["x", "y", "z"], "-")
if3 joined == "x-y-z" { pass = pass + 1 } else { print("FAIL: join = " + joined) }

// starts_with / ends_with
total = total + 1
if3 starts_with("hello world", "hello") { pass = pass + 1 } else { print("FAIL: starts_with") }

total = total + 1
if3 ends_with("hello world", "world") { pass = pass + 1 } else { print("FAIL: ends_with") }

// contains
total = total + 1
if3 contains("hello world", "lo wo") { pass = pass + 1 } else { print("FAIL: contains") }

// replace
total = total + 1
let r = replace("aabbcc", "bb", "XX")
if3 r == "aaXXcc" { pass = pass + 1 } else { print("FAIL: replace = " + r) }

// len
total = total + 1
if3 len("hello") == 5 { pass = pass + 1 } else { print("FAIL: len(hello) != 5") }

// str conversion
total = total + 1
if3 str(42) == "42" { pass = pass + 1 } else { print("FAIL: str(42)") }

print("STRINGS: " + str(pass) + "/" + str(total) + " passed")
