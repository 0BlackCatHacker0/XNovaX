// ── extends3 Ternary Inheritance Test ──

// Test 1: Basic inheritance — child inherits parent fields and methods
class3 Animal {
    let name = "unknown"
    let legs = 0

    fn init3(name, legs) {
        self.name = name
        self.legs = legs
    }

    fn speak() {
        return "..."
    }

    fn describe() {
        return self.name + " has " + str(self.legs) + " legs"
    }
}

class3 Dog extends Animal {
    let breed = "mixed"

    fn init3(name, breed) {
        self.name = name
        self.legs = 4
        self.breed = breed
    }

    fn speak() {
        return "Woof!"
    }

    fn full_desc() {
        return self.name + " (" + self.breed + ")"
    }
}

// Test parent class
let a = Animal("Cat", 4)
assert(a.name == "Cat")
assert(a.legs == 4)
assert(a.speak() == "...")
print("PASS: parent class works")

// Test child inherits parent method
let d = Dog("Rex", "Shepherd")
assert(d.name == "Rex")
assert(d.legs == 4)
assert(d.breed == "Shepherd")
print("PASS: child fields")

// Test method override
assert(d.speak() == "Woof!")
print("PASS: method override")

// Test inherited method
let desc = d.describe()
print("describe = " + desc)
assert(desc == "Rex has 4 legs")
print("PASS: inherited method from parent")

// Test child-only method
assert(d.full_desc() == "Rex (Shepherd)")
print("PASS: child-only method")

// Test _class3_trit
assert(d._class3_trit == 1)
print("PASS: _class3_trit = +1")

// Test 2: super.method() call
class3 Base {
    let value = 0

    fn init3(v) {
        self.value = v
    }

    fn compute() {
        return self.value * 2
    }
}

class3 Extended extends Base {
    fn init3(v) {
        self.value = v
    }

    fn compute() {
        let base_result = super.compute()
        return base_result + 10
    }
}

let e = Extended(5)
assert(e.value == 5)
let r = e.compute()
print("extended compute = " + str(r))
assert(r == 20)
print("PASS: super.method() call")

// Test 3: Multi-level inheritance
class3 Shape {
    let sides = 0

    fn init3(s) {
        self.sides = s
    }

    fn kind() {
        return "shape"
    }
}

class3 Polygon extends Shape {
    let regular = 0

    fn init3(s, reg) {
        self.sides = s
        self.regular = reg
    }

    fn kind() {
        return "polygon"
    }
}

class3 Triangle extends Polygon {
    fn init3() {
        self.sides = 3
        self.regular = 1
    }

    fn kind() {
        return "triangle"
    }
}

let t = Triangle()
assert(t.sides == 3)
assert(t.regular == 1)
assert(t.kind() == "triangle")
print("PASS: multi-level inheritance")

// Test 4: Parent without init3, child with init3
class3 Config {
    let debug = 0
    let verbose = 0
}

class3 AppConfig extends Config {
    let app_name = ""

    fn init3(name) {
        self.app_name = name
        self.debug = 1
    }
}

let cfg = AppConfig("NovaX")
assert(cfg.app_name == "NovaX")
assert(cfg.debug == 1)
assert(cfg.verbose == 0)
print("PASS: parent no-init3, child with init3")

print("=== ALL extends3 TESTS PASSED ===")
