// test_collections.nova — Tests list and dict operations
// Expected: exit 0 (all pass)

let pass = 0
let total = 0

// List creation and append
total = total + 1
let lst = [1, 2, 3]
if3 len(lst) == 3 { pass = pass + 1 } else { print("FAIL: list len") }

total = total + 1
let lst2 = append(lst, 4)
if3 len(lst2) == 4 { pass = pass + 1 } else { print("FAIL: append len") }

// List indexing
total = total + 1
if3 lst[0] == 1 { pass = pass + 1 } else { print("FAIL: lst[0]") }

total = total + 1
if3 lst[2] == 3 { pass = pass + 1 } else { print("FAIL: lst[2]") }

// Dict operations
total = total + 1
let d = dict_set({}, "name", "nova")
let name = dict_get(d, "name") ?? ""
if3 name == "nova" { pass = pass + 1 } else { print("FAIL: dict_get = " + name) }

total = total + 1
let d2 = dict_set(d, "version", "1.2")
let v = dict_get(d2, "version") ?? ""
if3 v == "1.2" { pass = pass + 1 } else { print("FAIL: dict version") }

// JSON roundtrip
total = total + 1
let obj = dict_set({}, "key", "value")
let encoded = json_encode(obj)
let decoded = json_decode(encoded)
let val = dict_get(decoded, "key") ?? ""
if3 val == "value" { pass = pass + 1 } else { print("FAIL: json roundtrip = " + val) }

// Range
total = total + 1
let r = range(0, 5)
if3 len(r) == 5 { pass = pass + 1 } else { print("FAIL: range len = " + str(len(r))) }

print("COLLECTIONS: " + str(pass) + "/" + str(total) + " passed")
