// NovaLang v1.3 Feature Tests
// Tests all 13 new enhancements

print("=== NovaLang v1.3 Feature Tests ===")
print("")

/*
  TEST 1: Block Comments
  This is a block comment! If you see this test passing,
  block comments work correctly.
*/
print("[PASS] Block comments work")

// TEST 2: Ternary Number Literals
let t1 = 0t+       // +1 = 1
let t2 = 0t+-      // +1*3 + -1 = 2
let t3 = 0t+0-     // +1*9 + 0*3 + -1 = 8
let t4 = 0t+--     // +1*9 + -1*3 + -1 = 5
print(f"[TEST] 0t+ = {t1} (expect 1)")
print(f"[TEST] 0t+- = {t2} (expect 2)")
print(f"[TEST] 0t+0- = {t3} (expect 8)")
print(f"[TEST] 0t+-- = {t4} (expect 5)")

// TEST 3: F-String Interpolation
let name = "Nova"
let version = 1.3
print(f"[TEST] Hello from {name} v{version}!")

// TEST 4: Lambda / Anonymous Functions
let double = fn(x) { return x * 2 }
let result = double(21)
print(f"[TEST] Lambda double(21) = {result} (expect 42)")

let add = fn(a, b) { return a + b }
print(f"[TEST] Lambda add(3, 4) = {add(3, 4)} (expect 7)")

// TEST 5: Pipe Operator
fn square(x) {
    return x * x
}
fn add_one(x) {
    return x + 1
}
let piped = 5 |> square |> add_one
print(f"[TEST] 5 |> square |> add_one = {piped} (expect 26)")

// TEST 6: Error Capture in try3/catch3(e)
try3 {
    let bad = 1 / 0  // this returns null, not an error
    print("[INFO] Division by zero returns null (not an error)")
} catch3(e) {
    print(f"[TEST] Caught error: {e}")
}

// TEST 7: Modulo-Assign
let x = 17
x %= 5
print(f"[TEST] 17 %= 5 = {x} (expect 2)")

// TEST 8: Bitwise Operators
print(f"[TEST] bit_and(0xFF, 0x0F) = {bit_and(255, 15)} (expect 15)")
print(f"[TEST] bit_or(0xF0, 0x0F) = {bit_or(240, 15)} (expect 255)")
print(f"[TEST] bit_xor(0xFF, 0x0F) = {bit_xor(255, 15)} (expect 240)")
print(f"[TEST] bit_shl(1, 8) = {bit_shl(1, 8)} (expect 256)")
print(f"[TEST] bit_shr(256, 4) = {bit_shr(256, 4)} (expect 16)")

// TEST 9: Assertions
assert(1 == 1, "basic equality")
assert_eq(42, 42, "forty-two equals itself")
print("[PASS] Assertions work")

// TEST 10: Char Code Operations
print(f"[TEST] char_code('A') = {char_code('A')} (expect 65)")
print(f"[TEST] from_char_code(78) = {from_char_code(78)} (expect N)")

// TEST 11: String Extras
print(f"[TEST] repeat('Na', 3) = {repeat('Na', 3)} (expect NaNaNa)")
print(f"[TEST] pad_left('42', 5, '0') = {pad_left('42', 5, '0')} (expect 00042)")
print(f"[TEST] index_of('hello world', 'world') = {index_of('hello world', 'world')} (expect 6)")

// TEST 12: List Extras
let nested = [[1, 2], [3, 4], [5]]
let flat_list = flatten(nested)
print(f"[TEST] flatten([[1,2],[3,4],[5]]) = {flat_list}")

let a = [1, 2, 3]
let b = [4, 5, 6]
let zipped = zip(a, b)
print(f"[TEST] zip([1,2,3], [4,5,6]) = {zipped}")

// TEST 13: Deep Merge
let d1 = {"a": 1, "b": {"x": 10}}
let d2 = {"b": {"y": 20}, "c": 3}
let merged = deep_merge(d1, d2)
print(f"[TEST] deep_merge result = {merged}")

// TEST 14: Retry3
let retry_cfg = retry3(5, 2000)
print(f"[TEST] retry3(5, 2000) = {retry_cfg}")

print("")
print("=== All v1.3 tests complete ===")
