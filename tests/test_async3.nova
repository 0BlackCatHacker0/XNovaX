// ── async3/await3 Ternary Async Test ──

// Test 1: Basic async3 launch + await3
fn slow_add(a, b) {
    return a + b
}

let h1 = async3 slow_add(10, 20)
print("launched: " + h1)
let r1 = await3(h1)
assert(r1["result"] == 30)
assert(r1["trit"] == 1)
print("PASS: basic async3 + await3")

// Test 2: Multiple concurrent tasks
fn multiply(x, y) {
    return x * y
}

let h2 = async3 multiply(3, 7)
let h3 = async3 multiply(5, 5)
let h4 = async3 slow_add(100, 200)

let r2 = await3(h2)
let r3 = await3(h3)
let r4 = await3(h4)
assert(r2["result"] == 21)
assert(r3["result"] == 25)
assert(r4["result"] == 300)
print("PASS: multiple concurrent async3 tasks")

// Test 3: async3_all — batch await
let h5 = async3 slow_add(1, 2)
let h6 = async3 slow_add(3, 4)
let h7 = async3 slow_add(5, 6)
let all_r = async3_all([h5, h6, h7])
assert(all_r["trit"] == 1)
assert(all_r["total"] == 3)
print("PASS: async3_all batch await")

// Test 4: async3_status
let h8 = async3 slow_add(99, 1)
let s8 = await3(h8)
let st = async3_status(h8)
assert(st["done"] == true)
assert(st["trit"] == 1)
print("PASS: async3_status")

print("=== ALL ASYNC3 TESTS PASSED ===")
