// NovaLang v1.4 Boltzmann3 Tests
// Tests: boltz3_new, register, softmax_scores, select, record, cool, heat, stats

import3 "C:\\NovaX\\stdlib\\boltzmann3.nova"

print("=== Boltzmann3 Softmax Router Tests ===")
print("")

// ── Create router ──
print("── Create Router ──")
let r = boltz3_new("test-router", 1.0)
print(f"  Name: {dict_get(r, 'name')} (expect test-router)")
print(f"  Temp: {dict_get(r, 'temperature')} (expect 1)")
print(f"  Total routes: {dict_get(r, 'total_routes')} (expect 0)")

print("")

// ── Register providers ──
print("── Register Providers ──")
r = boltz3_register(r, "openai", 80)
r = boltz3_register(r, "anthropic", 70)
r = boltz3_register(r, "ollama", 50)
let providers = dict_get(r, "providers") ?? {}
print(f"  Provider count: {len(dict_keys(providers))} (expect 3)")
let oai = dict_get(providers, "openai") ?? {}
print(f"  OpenAI score: {dict_get(oai, 'score')} (expect 80)")
let anth = dict_get(providers, "anthropic") ?? {}
print(f"  Anthropic score: {dict_get(anth, 'score')} (expect 70)")

print("")

// ── Softmax scores ──
print("── Softmax Probabilities ──")
let probs = boltz3_softmax_scores(r)
let p_oai = dict_get(probs, "openai") ?? 0
let p_anth = dict_get(probs, "anthropic") ?? 0
let p_oll = dict_get(probs, "ollama") ?? 0
print(f"  OpenAI prob: {p_oai}")
print(f"  Anthropic prob: {p_anth}")
print(f"  Ollama prob: {p_oll}")
// OpenAI (80) should have highest probability
if3 p_oai > p_anth {
    print(f"  ✓ OpenAI > Anthropic (correct, higher score)")
} else {
    print(f"  ✗ FAIL: OpenAI should be > Anthropic")
}
if3 p_anth > p_oll {
    print(f"  ✓ Anthropic > Ollama (correct)")
} else {
    print(f"  ✗ FAIL: Anthropic should be > Ollama")
}
// Sum should be ~100
let sum = p_oai + p_anth + p_oll
print(f"  Sum of probs: {sum} (expect ~100)")

print("")

// ── Select provider ──
print("── Select Provider ──")
let sel = boltz3_select(r)
let chosen = dict_get(sel, "provider") ?? "none"
let trit = dict_get(sel, "trit") ?? -1
let expl = dict_get(sel, "exploration") ?? -1
print(f"  Selected: {chosen}")
print(f"  Trit: {trit} (1=exploit, 0=explore)")
print(f"  Exploration: {expl}")
print(f"  Probability: {dict_get(sel, 'probability') ?? 0}")

// Run 10 selections to see distribution
let counts = {"openai": 0, "anthropic": 0, "ollama": 0}
let si = 0
while3 si < 10 {
    let s = boltz3_select(r)
    let p = dict_get(s, "provider") ?? "unknown"
    let c = dict_get(counts, p) ?? 0
    counts = dict_set(counts, p, c + 1)
    si = si + 1
}
print(f"  Distribution (10 runs): {counts}")

print("")

// ── Record outcomes ──
print("── Record Outcomes ──")
r = boltz3_record(r, "openai", 1, 150)
r = boltz3_record(r, "openai", 1, 200)
r = boltz3_record(r, "anthropic", 1, 300)
r = boltz3_record(r, "ollama", 0, 0)
print(f"  Total routes: {dict_get(r, 'total_routes')} (expect 4)")

let prov2 = dict_get(r, "providers") ?? {}
let oai2 = dict_get(prov2, "openai") ?? {}
print(f"  OpenAI successes: {dict_get(oai2, 'successes')} (expect 2)")
print(f"  OpenAI score: {dict_get(oai2, 'score')} (should be near 80)")
print(f"  OpenAI avg latency: {dict_get(oai2, 'avg_latency_ms')}ms")

let oll2 = dict_get(prov2, "ollama") ?? {}
print(f"  Ollama failures: {dict_get(oll2, 'failures')} (expect 1)")
print(f"  Ollama score: {dict_get(oll2, 'score')} (should drop from 50)")

// After recording, probabilities should shift
let probs2 = boltz3_softmax_scores(r)
print(f"  Updated probs: {probs2}")

print("")

// ── Temperature control ──
print("── Temperature Control ──")
let hot = boltz3_heat(r, 2.0)
print(f"  After heat(2.0): temp={dict_get(hot, 'temperature')}")
let hot_probs = boltz3_softmax_scores(hot)
print(f"  Hot probs (should be more uniform): {hot_probs}")

let cold = boltz3_cool(r, 0.5)
print(f"  After cool(0.5): temp={dict_get(cold, 'temperature')}")
let cold_probs = boltz3_softmax_scores(cold)
print(f"  Cold probs (should be more peaked): {cold_probs}")

// Verify: at low temp, best provider should dominate
let cold2 = boltz3_cool(r, 0.1)
let cold2_probs = boltz3_softmax_scores(cold2)
let cold_oai = dict_get(cold2_probs, "openai") ?? 0
print(f"  Very cold (T=0.1) OpenAI prob: {cold_oai} (should dominate)")

print("")

// ── Cooling limits ──
print("── Cooling Limits ──")
let c = boltz3_new("limit-test", 0.05)
c = boltz3_cool(c, 0.1)
print(f"  Cool below 0.01 clamped: temp={dict_get(c, 'temperature')} (expect 0.01)")

let h = boltz3_new("limit-test", 90)
h = boltz3_heat(h, 2.0)
print(f"  Heat above 100 clamped: temp={dict_get(h, 'temperature')} (expect 100)")

print("")

// ── Stats ──
print("── Stats ──")
let stats = boltz3_stats(r)
print(f"  Stats: {stats}")
print(f"  Name: {dict_get(stats, 'name')} (expect test-router)")
print(f"  Provider count: {dict_get(stats, 'provider_count')} (expect 3)")

print("")

// ── Empty router edge case ──
print("── Edge Cases ──")
let empty = boltz3_new("empty")
let empty_probs = boltz3_softmax_scores(empty)
print(f"  Empty router probs: {empty_probs} (expect empty dict)")
let empty_sel = boltz3_select(empty)
print(f"  Empty select trit: {dict_get(empty_sel, 'trit')} (expect -1)")

// Single provider
let single = boltz3_new("single")
single = boltz3_register(single, "solo", 75)
let single_probs = boltz3_softmax_scores(single)
print(f"  Single provider prob: {dict_get(single_probs, 'solo')} (expect 100)")

print("")
print("=== Boltzmann3 tests complete ===")
