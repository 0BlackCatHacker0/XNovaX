// NovaLang v1.4 Stdlib Tests — Circuit Breaker + Reynolds Router

import3 "C:\\NovaX\\stdlib\\circuit3.nova"
import3 "C:\\NovaX\\stdlib\\reynolds3.nova"

print("=== v1.4 Stdlib Tests ===")
print("")

// ── Circuit Breaker Tests ──
print("── Circuit Breaker ──")
let cb = circuit3_new("hivemind", 3, 2000)
print(f"  Created: {circuit3_state_name(cb)} (expect CLOSED)")

let check1 = circuit3_check(cb)
print(f"  Check: {check1} (expect 1/CLOSED)")

// Simulate 3 failures to trip the breaker
cb = circuit3_failure(cb)
cb = circuit3_failure(cb)
print(f"  After 2 failures: {circuit3_state_name(cb)} (expect CLOSED)")
cb = circuit3_failure(cb)
print(f"  After 3 failures: {circuit3_state_name(cb)} (expect OPEN)")

let check2 = circuit3_check(cb)
print(f"  Check when OPEN: {check2} (expect -1)")

let stats = circuit3_stats(cb)
print(f"  Stats: {stats}")

// Simulate success
cb = circuit3_success(cb)
print(f"  After success: {circuit3_state_name(cb)} (expect CLOSED)")

print("")

// ── Reynolds Router Tests ──
print("── Reynolds Router ──")
print(f"  Re=5:   {reynolds_describe(5)}")
print(f"  Re=100: {reynolds_describe(100)}")
print(f"  Re=500: {reynolds_describe(500)}")

let re = reynolds_calculate(50, 256, 1000)
print(f"  reynolds_calculate(50, 256, 1000) = {re}")

let services = ["brain:9990", "hivemind:9881", "cloud:9878", "prime:9869"]
let route_laminar = reynolds_route(services, 10)
let route_trans = reynolds_route(services, 200)
let route_turb = reynolds_route(services, 500)
print(f"  Laminar (Re=10):      {route_laminar}")
print(f"  Transitional (Re=200): {route_trans}")
print(f"  Turbulent (Re=500):    {route_turb}")

print("")
print("=== Stdlib tests complete ===")
