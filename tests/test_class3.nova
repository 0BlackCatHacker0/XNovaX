// ── class3 Ternary Class System Test ──

// Test 1: Basic class definition with fields and methods
class3 Vector3 {
    let x = 0
    let y = 0
    let z = 0

    fn init3(x, y, z) {
        self.x = x
        self.y = y
        self.z = z
    }

    fn magnitude() {
        let sum = self.x * self.x + self.y * self.y + self.z * self.z
        return sum
    }

    fn add(other) {
        let nx = self.x + other.x
        let ny = self.y + other.y
        let nz = self.z + other.z
        return Vector3(nx, ny, nz)
    }

    fn scale(factor) {
        self.x = self.x * factor
        self.y = self.y * factor
        self.z = self.z * factor
    }

    fn describe() {
        return str(self.x) + "," + str(self.y) + "," + str(self.z)
    }
}

// Test instantiation with init3
let v1 = Vector3(3, 4, 0)
print("v1.x = " + str(v1.x))
print("v1.y = " + str(v1.y))
print("v1.z = " + str(v1.z))
assert(v1.x == 3)
assert(v1.y == 4)
assert(v1.z == 0)
print("PASS: init3 constructor")

// Test method call
let mag = v1.magnitude()
print("magnitude^2 = " + str(mag))
assert(mag == 25)
print("PASS: method call")

// Test describe
let desc = v1.describe()
print("describe = " + desc)
assert(desc == "3,4,0")
print("PASS: describe method")

// Test mutation via method
v1.scale(2)
print("after scale(2): " + str(v1.x) + "," + str(v1.y))
assert(v1.x == 6)
assert(v1.y == 8)
print("PASS: mutation via method")

// Test second instance
let v2 = Vector3(1, 2, 3)
assert(v2.x == 1)
assert(v2.y == 2)
assert(v2.z == 3)
print("PASS: second instance independent")

// Test method returning new instance
let v3 = v2.add(v2)
print("v2+v2 = " + str(v3.x) + "," + str(v3.y) + "," + str(v3.z))
assert(v3.x == 2)
assert(v3.y == 4)
assert(v3.z == 6)
print("PASS: method returning new instance")

// Test dot assignment from outside
v3.x = 99
assert(v3.x == 99)
print("PASS: external dot assignment")

// Test _class3_trit
assert(v1._class3_trit == 1)
print("PASS: _class3_trit = +1 (init3 succeeded)")

// Test 2: Class without init3
class3 Counter {
    let count = 0

    fn inc() {
        self.count = self.count + 1
    }

    fn get() {
        return self.count
    }
}

let c = Counter()
assert(c.count == 0)
assert(c._class3_trit == 0)
print("PASS: class without init3 (trit=0)")

c.inc()
c.inc()
c.inc()
assert(c.get() == 3)
print("PASS: stateful counter")

print("=== ALL class3 TESTS PASSED ===")
