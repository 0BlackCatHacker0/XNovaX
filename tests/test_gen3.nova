// ── gen3/yield3 Ternary Generator Test ──

// Test 1: Basic generator — yields 3 values
fn counting(start, end) {
    let i = start
    while3 i <= end {
        yield3(i)
        i = i + 1
    }
}

let g = gen3 counting(1, 3)
let r1 = next3(g)
assert(r1["value"] == 1)
assert(r1["done"] == false)
let r2 = next3(g)
assert(r2["value"] == 2)
let r3 = next3(g)
assert(r3["value"] == 3)
let r4 = next3(g)
assert(r4["done"] == true)
print("PASS: basic generator yield3/next3")

// Test 2: collect3 — gather all values into list
fn squares(n) {
    let i = 1
    while3 i <= n {
        yield3(i * i)
        i = i + 1
    }
}

let g2 = gen3 squares(5)
let all = collect3(g2)
assert(len(all) == 5)
assert(all[0] == 1)
assert(all[1] == 4)
assert(all[2] == 9)
assert(all[3] == 16)
assert(all[4] == 25)
print("PASS: collect3 gathers all yields")

// Test 3: Generator with computation
fn fibonacci(limit) {
    let a = 0
    let b = 1
    while3 a < limit {
        yield3(a)
        let temp = a + b
        a = b
        b = temp
    }
}

let g3 = gen3 fibonacci(20)
let fibs = collect3(g3)
assert(fibs[0] == 0)
assert(fibs[1] == 1)
assert(fibs[2] == 1)
assert(fibs[3] == 2)
assert(fibs[4] == 3)
assert(fibs[5] == 5)
assert(fibs[6] == 8)
assert(fibs[7] == 13)
print("PASS: fibonacci generator")

print("=== ALL GEN3 TESTS PASSED ===")
