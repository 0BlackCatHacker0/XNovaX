// Test: tserve creates a server handle, troute registers a route
let srv = tserve(19891, "Test Server")
print(type(srv))

fn test_health() {
    return {"ok": true, "test": "passed"}
}

troute(srv, "GET", "/health", "test_health")
let st = tstatus(srv)
print(st.get("name"))
print(st.get("routes"))
