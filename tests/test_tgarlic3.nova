// ============================================================================
// test_tgarlic3.nova — Ternary Garlic-Onion Hybrid Protocol Tests
// ============================================================================
import3 "C:\\NovaX\\stdlib\\tgarlic3.nova"

print("=== TGarlic3 Hybrid Anonymity Protocol Tests ===")
print("")

// ── Clove Creation ──
print("── Clove Creation ──")
let data_clove = tgarlic3_clove_new("hello secret world", "bob_dest", 1)
print(f"  Data clove trit: {dict_get(data_clove, 'trit')} (expect 1)")
print(f"  Delivery: {dict_get(data_clove, 'delivery')} (expect tunnel)")

let ack = tgarlic3_clove_ack("msg_001", "return_tunnel")
print(f"  ACK clove is_ack: {dict_get(ack, 'is_ack')} (expect true)")

let decoy = tgarlic3_clove_decoy()
print(f"  Decoy trit: {dict_get(decoy, 'trit')} (expect -1)")
print(f"  Decoy delivery: {dict_get(decoy, 'delivery')} (expect drop)")

print("")

// ── Garlic Bundle ──
print("── Garlic Message Bundle ──")
let cloves = [data_clove, ack]
let garlic = tgarlic3_bundle(cloves)
print(f"  Clove count: {dict_get(garlic, 'clove_count')} (expect 5, padded with decoys)")
print(f"  Real count: {dict_get(garlic, 'real_count')} (expect 2)")
print(f"  Encryption: {dict_get(garlic, 'encryption')} (expect triple)")

// Unbundle
let unbundled = tgarlic3_unbundle(garlic)
let real = dict_get(unbundled, "real") ?? []
let acks = dict_get(unbundled, "acks") ?? []
let dropped = dict_get(unbundled, "decoys_dropped") ?? 0
print(f"  Unbundled real: {len(real)} (expect 1)")
print(f"  Unbundled acks: {len(acks)} (expect 1)")
print(f"  Decoys dropped: {dropped} (expect 3)")

print("")

// ── Tunnel Construction ──
print("── Tunnel Construction ──")
let out_hops = ["guard_node", "relay_1", "relay_2", "exit_node"]
let tunnel = tgarlic3_tunnel_new("test_outbound", out_hops, 1)
print(f"  Hop count: {dict_get(tunnel, 'hop_count')} (expect 4)")
print(f"  Gateway: {dict_get(tunnel, 'gateway')} (expect guard_node)")
print(f"  Endpoint: {dict_get(tunnel, 'endpoint')} (expect exit_node)")
print(f"  Mode: {dict_get(tunnel, 'mode')} (expect 1=garlic)")
print(f"  Alive: {tgarlic3_tunnel_alive(tunnel)} (expect 1)")

// Too many hops
let bad_tunnel = tgarlic3_tunnel_new("too_long", ["a","b","c","d","e","f","g","h"], 1)
print(f"  8-hop error: {dict_get(bad_tunnel, 'error')} (expect max 7 hops)")

print("")

// ── LeaseSet ──
print("── LeaseSet Publishing ──")
let t1 = tgarlic3_tunnel_new("in_1", ["node_a", "node_b", "node_c"], 1)
let t2 = tgarlic3_tunnel_new("in_2", ["node_d", "node_e"], 1)
let ls = tgarlic3_leaseset_new("my_destination", [t1, t2])
print(f"  Lease count: {dict_get(ls, 'lease_count')} (expect 2)")
print(f"  Health: {dict_get(ls, 'health')} (expect 1=fresh)")
print(f"  Dest: {dict_get(ls, 'dest')} (expect my_destination)")

let ls_health = tgarlic3_leaseset_health(ls)
print(f"  LeaseSet health check: {ls_health} (expect 1=fresh)")

print("")

// ── Session Tags ──
print("── Session Tags (Single-Use Symmetric) ──")
let session = tgarlic3_session_new("peer_bob")
print(f"  Tags remaining: {dict_get(session, 'tags_remaining')} (expect 13)")
print(f"  Tags used: {dict_get(session, 'tags_used')} (expect 0)")

// Use 11 tags
let s = session
let step = 0
while3 step < 11 {
    let result = tgarlic3_session_use_tag(s)
    s = dict_get(result, "session") ?? s
    step = step + 1
}
print(f"  After 11 uses, remaining: {dict_get(s, 'tags_remaining')} (expect 2)")
print(f"  After 11 uses, trit: {dict_get(s, 'trit')} (expect 0=running low)")

// Use 2 more (exhaust)
let r12 = tgarlic3_session_use_tag(s)
s = dict_get(r12, "session") ?? s
let r13 = tgarlic3_session_use_tag(s)
s = dict_get(r13, "session") ?? s
print(f"  After 13 uses, remaining: {dict_get(s, 'tags_remaining')} (expect 0)")
print(f"  After 13 uses, trit: {dict_get(s, 'trit')} (expect -1=exhausted)")
print(f"  Needs restock: {dict_get(r13, 'needs_restock')} (expect true)")

// Restock
s = tgarlic3_session_restock(s)
print(f"  After restock, remaining: {dict_get(s, 'tags_remaining')} (expect 13)")
print(f"  After restock, trit: {dict_get(s, 'trit')} (expect 1)")

print("")

// ── Full Route ──
print("── Full Route (Garlic-Onion Hybrid) ──")
let route = tgarlic3_route_new("alice_to_bob",
    ["guard_a", "relay_1", "exit_a"],     // outbound: 3 hops
    ["guard_b", "relay_2", "entry_b"],     // inbound: 3 hops
    0)                                      // hybrid mode
print(f"  Mode: {dict_get(route, 'mode')} (expect 0=hybrid)")
print(f"  Out hops: {dict_get(route, 'out_hops')} (expect 3)")
print(f"  In hops: {dict_get(route, 'in_hops')} (expect 3)")
print(f"  Total hops: {dict_get(route, 'total_hops')} (expect 6)")

// Send through route
let sent = tgarlic3_route_send(route, "classified message", "bob_dest", ls)
let sent_garlic = dict_get(sent, "garlic") ?? {}
print(f"  Sent garlic cloves: {dict_get(sent_garlic, 'clove_count')} (expect 5)")
print(f"  Sent garlic real: {dict_get(sent_garlic, 'real_count')} (expect 3, data+ack+ls)")

print("")

// ── Network Manager ──
print("── Network Manager ──")
let net = tgarlic3_network_new("nova_darknet")

// Add routes
let r1 = tgarlic3_network_add_route(net, "route_openai",
    ["guard_1", "relay_1", "exit_1"],
    ["entry_1", "relay_2", "guard_2"], 1)
net = dict_get(r1, "net") ?? net

let r2 = tgarlic3_network_add_route(net, "route_anthropic",
    ["guard_3", "relay_3"],
    ["entry_2", "relay_4"], 0)
net = dict_get(r2, "net") ?? net

// Add sessions
let s1 = tgarlic3_network_add_session(net, "openai_peer")
net = dict_get(s1, "net") ?? net

let s2 = tgarlic3_network_add_session(net, "anthropic_peer")
net = dict_get(s2, "net") ?? net

// Publish leaseset
let ls_result = tgarlic3_network_publish_leaseset(net, "nova_hidden_service")
net = dict_get(ls_result, "net") ?? net
let pub_ls = dict_get(ls_result, "leaseset") ?? {}
print(f"  Published leases: {dict_get(pub_ls, 'lease_count')} (expect 2)")

// Stats
let stats = tgarlic3_stats(net)
print(f"  Routes: {dict_get(stats, 'routes')} (expect 2)")
print(f"  Sessions: {dict_get(stats, 'sessions')} (expect 2)")
print(f"  LeaseSets: {dict_get(stats, 'leasesets')} (expect 1)")
print(f"  Tunnels alive: {dict_get(stats, 'tunnels_alive')}/{dict_get(stats, 'tunnels_total')} (expect 4/4)")
print(f"  Tags remaining: {dict_get(stats, 'tags_remaining')} (expect 26, 13 each)")
print(f"  Health: {dict_get(stats, 'health')} (expect 1)")

print("")
print("=== TGarlic3 tests complete ===")
