// NovaLang v1.4 Extended Stdlib Tests
// Tests: retry3, ratelimit3, pool3, uuid3, semaphore3, cache3, metrics3

import3 "C:\\NovaX\\stdlib\\retry3.nova"
import3 "C:\\NovaX\\stdlib\\ratelimit3.nova"
import3 "C:\\NovaX\\stdlib\\pool3.nova"
import3 "C:\\NovaX\\stdlib\\uuid3.nova"
import3 "C:\\NovaX\\stdlib\\semaphore3.nova"
import3 "C:\\NovaX\\stdlib\\cache3.nova"
import3 "C:\\NovaX\\stdlib\\metrics3.nova"

print("=== v1.4 Extended Stdlib Tests ===")
print("")

// ── Retry3 Tests ──
print("── Retry3 ──")
let r = retry3_new("test-retry", 3, 100, 5000)
print(f"  Created: {retry3_stats(r)}")
r = retry3_failure(r, "connection timeout")
print(f"  After failure 1: should_retry={retry3_should_retry(r)}")
r = retry3_failure(r, "connection timeout")
print(f"  After failure 2: should_retry={retry3_should_retry(r)}")
r = retry3_failure(r, "connection timeout")
print(f"  After failure 3: exhausted={retry3_is_exhausted(r)}")
let delay = retry3_next_delay(r)
print(f"  Next delay: {delay}ms")
r = retry3_success(retry3_new("fresh"))
print(f"  After success: {retry3_stats(r)}")

print("")

// ── RateLimit3 Tests ──
print("── RateLimit3 ──")
let rl = ratelimit3_new("api-limiter", 10, 5)
print(f"  Created: {ratelimit3_stats(rl)}")
let check1 = ratelimit3_check(rl, 1)
rl = dict_get(check1, "rl")
print(f"  Check 1: trit={dict_get(check1, 'trit')} (expect 1)")
let check2 = ratelimit3_check(rl, 4)
rl = dict_get(check2, "rl")
print(f"  Check 2 (cost=4): trit={dict_get(check2, 'trit')}")
print(f"  Stats: {ratelimit3_stats(rl)}")

print("")

// ── Pool3 Tests ──
print("── Pool3 ──")
let pool = pool3_new("db-pool", 3, 1)
print(f"  Created: {pool3_stats(pool)}")
let a1 = pool3_acquire(pool)
pool = dict_get(a1, "pool")
print(f"  Acquire 1: trit={dict_get(a1, 'trit')} (expect 1)")
let a2 = pool3_acquire(pool)
pool = dict_get(a2, "pool")
let a3 = pool3_acquire(pool)
pool = dict_get(a3, "pool")
print(f"  After 3 acquires: health={pool3_health(pool)} (expect -1, exhausted)")
let a4 = pool3_acquire(pool)
print(f"  Acquire 4 (over limit): trit={dict_get(a4, 'trit')} (expect -1)")
let rel = pool3_release(pool)
pool = dict_get(rel, "pool")
print(f"  After release: health={pool3_health(pool)}")

print("")

// ── UUID3 Tests ──
print("── UUID3 ──")
let u1 = uuid3_v4()
let u2 = uuid3_v4()
print(f"  UUID v4: {u1}")
print(f"  UUID v4: {u2} (should differ)")
let t1 = uuid3_ternary("NX")
print(f"  Ternary ID: {t1}")
let s1 = uuid3_short()
print(f"  Short ID: {s1}")
let ts1 = uuid3_timestamp()
print(f"  Timestamp ID: {ts1}")

print("")

// ── Semaphore3 Tests ──
print("── Semaphore3 ──")
let sem = sem3_new("work-sem", 3)
print(f"  Created: {sem3_stats(sem)}")
let sa1 = sem3_acquire(sem, 2)
sem = dict_get(sa1, "sem")
print(f"  Acquire 2: trit={dict_get(sa1, 'trit')} health={sem3_health(sem)}")
let sa2 = sem3_acquire(sem, 2)
print(f"  Acquire 2 more: trit={dict_get(sa2, 'trit')} (expect -1, not enough)")
let sr1 = sem3_release(sem, 1)
sem = dict_get(sr1, "sem")
print(f"  Released 1: health={sem3_health(sem)}")

print("")

// ── Cache3 Tests ──
print("── Cache3 ──")
let cache = cache3_new("test-cache", 3, 60000)
cache = cache3_set(cache, "user:1", "Alice")
cache = cache3_set(cache, "user:2", "Bob")
cache = cache3_set(cache, "user:3", "Carol")
let g1 = cache3_get(cache, "user:1")
cache = dict_get(g1, "cache")
print(f"  Get user:1: trit={dict_get(g1, 'trit')} value={dict_get(g1, 'value')} (expect Alice)")
let g2 = cache3_get(cache, "user:99")
cache = dict_get(g2, "cache")
print(f"  Get user:99: trit={dict_get(g2, 'trit')} status={dict_get(g2, 'status')} (expect miss)")
// Eviction test: add 4th entry with max_size=3
cache = cache3_set(cache, "user:4", "Dave")
print(f"  After eviction: {cache3_stats(cache)}")

print("")

// ── Metrics3 Tests ──
print("── Metrics3 ──")
let m = metrics3_new("test")
m = metrics3_inc(m, "requests", 5)
m = metrics3_inc(m, "errors", 1)
m = metrics3_gauge_set(m, "cpu_pct", 45)
m = metrics3_histogram_record(m, "latency_ms", 120)
m = metrics3_histogram_record(m, "latency_ms", 80)
m = metrics3_histogram_record(m, "latency_ms", 200)
let avg = metrics3_histogram_avg(m, "latency_ms")
print(f"  Counters: {metrics3_report(m)}")
print(f"  Latency avg: {avg}ms (expect ~133)")
print(f"  CPU gauge: {metrics3_gauge_get(m, 'cpu_pct')} (expect 45)")

print("")
print("=== Extended stdlib tests complete ===")
