// ============================================================
// NOVAX END-TO-END WORKFLOW TEST
// ============================================================
// Tests cross-service communication patterns.
// Requires: Orchestrator (:9999) running.
// Run: python novalang.py tests/test_e2e_workflow.nova
// ============================================================

import3 "tests/test_framework.nova" { test3, assert3, assert_eq3, assert_trit3, assert_gt3, suite3, report3, H3, H5, H7, H13 }
import3 http3
import3 trit3
import3 time3

// ============================================================
// WORKFLOW 1: Service Discovery & Health
// Query orchestrator for all services, check health
// ============================================================

fn test_orchestrator_health() {
  let resp = get3("http://127.0.0.1:9999/health")
  assert_trit3(resp["trit"], 1, "orchestrator responds")
}

fn test_services_health_endpoint() {
  let resp = get3("http://127.0.0.1:9999/api/services/health")
  assert_trit3(resp["trit"], 1, "services health endpoint exists")
}

fn test_orchestrator_latency() {
  let t = timed3(fn() { return get3("http://127.0.0.1:9999/health") })
  assert_gt3(t["trit"], -1, "timing works")
  assert3(t["elapsed_ms"] >= 0, "latency is non-negative")
}

// ============================================================
// WORKFLOW 2: NovaLang Execution Pipeline
// Send code to NovaLang exec endpoint, verify output
// ============================================================

fn test_novalang_exec() {
  let code = "let x = 3 + 5\nprint3(x)"
  let resp = post3("http://127.0.0.1:9999/api/novalang/exec", {"code": code})
  assert_trit3(resp["trit"], 1, "novalang exec responds")
}

fn test_novalang_math() {
  let code = "let result = 7 * 13\nresult"
  let resp = post3("http://127.0.0.1:9999/api/novalang/exec", {"code": code})
  assert_trit3(resp["trit"], 1, "novalang math execution")
}

// ============================================================
// WORKFLOW 3: Multi-Service Ping Sweep
// Check multiple core services respond
// ============================================================

fn test_multi_service_ping() {
  let ports = [9999, 9890, 9891]
  let up = 0
  for3 port in ports {
    let trit = health3(port)
    if3 trit {
      let up = up + 1
    } maybe {} else3 {}
  }
  // At least orchestrator should be up
  assert_gt3(up, 0, "at least 1 service responding")
}

fn test_service_resilience() {
  // Test that invalid port returns clean failure (not crash)
  let resp = get3("http://127.0.0.1:1/health")
  assert_trit3(resp["trit"], -1, "unreachable port returns -1")
}

// ============================================================
// WORKFLOW 4: Data Flow (if TAlchemy running)
// ============================================================

fn test_talchemy_filter() {
  let data = [
    {"name": "alpha", "value": 10},
    {"name": "beta", "value": 25},
    {"name": "gamma", "value": 5}
  ]
  let resp = post3("http://127.0.0.1:9928/talchemy/filter", {
    "data": data,
    "field": "value",
    "op": "gt",
    "threshold": 8
  })
  // May fail if TAlchemy not running — that's ok
  if3 resp["trit"] {
    assert3(1, "talchemy filter responded")
  } maybe {
    assert3(1, "talchemy partially available")
  } else3 {
    assert3(1, "talchemy not running (skipped)")
  }
}

// ============================================================
// WORKFLOW 5: Timing & Performance
// ============================================================

fn test_response_time_budget() {
  let start = now3()
  let resp = get3("http://127.0.0.1:9999/health")
  let elapsed = elapsed3(start)
  // Health check should complete in under 5 seconds
  assert3(cmp3(elapsed, 5) == -1, "health check under 5s")
}

fn test_sequential_requests() {
  let i = 0
  let successes = 0
  while3 cmp3(i, H3) == -1 {
    let resp = get3("http://127.0.0.1:9999/health")
    if3 resp["trit"] {
      let successes = successes + 1
    } maybe {} else3 {}
    let i = i + 1
  }
  assert_eq3(successes, H3, "all H3 sequential requests succeed")
}

// ============================================================
// RUN ALL
// ============================================================

let e2e_results = suite3("End-to-End Workflows", [
  test_orchestrator_health,
  test_services_health_endpoint,
  test_orchestrator_latency,
  test_novalang_exec,
  test_novalang_math,
  test_multi_service_ping,
  test_service_resilience,
  test_talchemy_filter,
  test_response_time_budget,
  test_sequential_requests
])

report3(e2e_results)
