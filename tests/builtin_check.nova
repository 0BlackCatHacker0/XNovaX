// Check which string builtins exist
print("=== Builtin String Functions Check ===")

// Test each potential builtin
let s = "Hello World"

// str_trim
let r1 = str_trim("  hi  ") ?? "MISSING"
print("str_trim: " + str(r1))

// str_upper
let r2 = str_upper("hello") ?? "MISSING"
print("str_upper: " + str(r2))

// str_lower
let r3 = str_lower("HELLO") ?? "MISSING"
print("str_lower: " + str(r3))

// str_find
let r4 = str_find("hello", "ll") ?? "MISSING"
print("str_find: " + str(r4))

// str_split
let r5 = str_split("a,b", ",") ?? "MISSING"
print("str_split: " + str(r5))

// str_join
let r6 = str_join(",", ["a", "b"]) ?? "MISSING"
print("str_join: " + str(r6))

// str_slice
let r7 = str_slice("hello", 0, 3) ?? "MISSING"
print("str_slice: " + str(r7))

// str_replace
let r8 = str_replace("hello", "l", "r") ?? "MISSING"
print("str_replace: " + str(r8))

// Alternative names
print("=== Try alternative names ===")
let r9 = trim("  hi  ") ?? "MISSING"
print("trim: " + str(r9))

let r10 = upper("hello") ?? "MISSING"
print("upper: " + str(r10))

let r11 = lower("HELLO") ?? "MISSING"
print("lower: " + str(r11))

let r12 = find("hello", "ll") ?? "MISSING"
print("find: " + str(r12))

let r13 = split("a,b", ",") ?? "MISSING"
print("split: " + str(r13))

let r14 = join(",", ["a", "b"]) ?? "MISSING"
print("join: " + str(r14))

let r15 = slice("hello", 0, 3) ?? "MISSING"
print("slice: " + str(r15))

let r16 = replace("hello", "l", "r") ?? "MISSING"
print("replace: " + str(r16))

let r17 = contains("hello", "ell") ?? "MISSING"
print("contains: " + str(r17))

let r18 = substring("hello", 1, 3) ?? "MISSING"
print("substring: " + str(r18))

// Check type_of vs type
let r19 = type_of(42) ?? "MISSING"
print("type_of: " + str(r19))

// Check float
let r20 = float("3.14") ?? "MISSING"
print("float: " + str(r20))

// Check int
let r21 = int("42") ?? "MISSING"
print("int: " + str(r21))

// Check time_now
let r22 = time_now() ?? "MISSING"
print("time_now: " + str(r22))

// Check json_parse
let r23 = json_parse("{\"a\":1}") ?? "MISSING"
print("json_parse: " + str(r23))

// Check json_stringify
let r24 = json_stringify({"a": 1}) ?? "MISSING"
print("json_stringify: " + str(r24))

// Check dict_get
let r25 = dict_get({"a": 1}, "a") ?? "MISSING"
print("dict_get: " + str(r25))

// Check dict_set
let r26 = dict_set({"a": 1}, "b", 2) ?? "MISSING"
print("dict_set: " + str(r26))

// Check dict_keys
let r27 = dict_keys({"a": 1, "b": 2}) ?? "MISSING"
print("dict_keys: " + str(r27))

// Check dict_values
let r28 = dict_values({"a": 1, "b": 2}) ?? "MISSING"
print("dict_values: " + str(r28))

print("=== DONE ===")
