// ============================================================
// NOVAX TEST: Stdlib Phase 3-4 (event3, pipe3, log3, format3)
// ============================================================
// Tests the 4 stdlib modules added in Session 38 phase 3-4.
// Run: python novalang.py tests/test_stdlib_phase34.nova
// ============================================================

import3 "tests/test_framework.nova" { test3, assert3, assert_eq3, assert_trit3, assert_gt3, assert_contains3, assert_len3, suite3, report3, report3_multi, H3, H5, H7, H13 }
import3 event3
import3 pipe3
import3 log3
import3 format3

// ============================================================
// EVENT3 TESTS (6 functions)
// ============================================================

fn test_event_on_emit() {
  let _received = []
  fn handler(data) {
    let _received = append(_received, data)
  }
  on3("test.ping", handler)
  emit3("test.ping", "hello")
  assert_eq3(len(_received), 1, "handler received 1 event")
  assert_eq3(_received[0], "hello", "handler received correct data")
  off3("test.ping", handler)
}

fn test_event_off() {
  let _count = 0
  fn counter(data) {
    let _count = _count + 1
  }
  on3("test.off", counter)
  emit3("test.off", null)
  off3("test.off", counter)
  emit3("test.off", null)
  assert_eq3(_count, 1, "handler removed after off3")
}

fn test_event_once() {
  let _fired = 0
  fn once_handler(data) {
    let _fired = _fired + 1
  }
  once3("test.once", once_handler)
  emit3("test.once", null)
  emit3("test.once", null)
  assert_eq3(_fired, 1, "once3 handler fires exactly once")
}

fn test_event_events_list() {
  on3("test.list1", fn(d) {})
  on3("test.list2", fn(d) {})
  let evts = events3()
  assert_gt3(len(evts), 0, "events3 returns registered events")
}

fn test_event_log() {
  emit3("test.logged", "payload")
  let log = event_log3()
  assert_gt3(len(log), 0, "event_log3 captures emitted events")
}

// ============================================================
// PIPE3 TESTS (8 functions)
// ============================================================

fn test_pipe_basic() {
  fn add1(x) { return x + 1 }
  fn double(x) { return x * 2 }
  let result = pipe3(5, [add1, double])
  assert_eq3(result, 12, "pipe3: (5+1)*2 = 12")
}

fn test_compose_basic() {
  fn add1(x) { return x + 1 }
  fn double(x) { return x * 2 }
  let composed = compose3([double, add1])
  let result = composed(5)
  assert_eq3(result, 11, "compose3: double then add1 = 5*2+1 = 11")
}

fn test_tap() {
  let _side = 0
  fn track(x) { let _side = x }
  let result = tap3(42, track)
  assert_eq3(result, 42, "tap3 returns original value")
  assert_eq3(_side, 42, "tap3 calls side-effect function")
}

fn test_when() {
  fn is_pos(x) { return x > 0 }
  fn double(x) { return x * 2 }
  let r1 = when3(5, is_pos, double)
  let r2 = when3(-3, is_pos, double)
  assert_eq3(r1, 10, "when3 applies fn on true condition")
  assert_eq3(r2, -3, "when3 returns original on false")
}

fn test_branch() {
  fn is_pos(x) { return x > 0 }
  fn pos_handler(x) { return "positive" }
  fn neg_handler(x) { return "not positive" }
  let r = branch3(5, is_pos, pos_handler, neg_handler)
  assert_eq3(r, "positive", "branch3 takes true path")
}

fn test_memo() {
  let _call_count = 0
  fn expensive(x) {
    let _call_count = _call_count + 1
    return x * x
  }
  let cached = memo3(expensive)
  let r1 = cached(7)
  let r2 = cached(7)
  assert_eq3(r1, 49, "memo3 returns correct result")
  assert_eq3(r2, 49, "memo3 returns cached result")
}

// ============================================================
// LOG3 TESTS (14+ functions)
// ============================================================

fn test_log_levels() {
  clear_logs3()
  info3("test info message")
  warn3("test warn message")
  error3("test error message")
  let logs = get_logs3()
  assert_gt3(len(logs), 0, "logs captured after info/warn/error")
}

fn test_log_errors_only() {
  clear_logs3()
  info3("info")
  error3("critical failure")
  let errors = get_errors3()
  assert_gt3(len(errors), 0, "get_errors3 filters errors")
}

fn test_log_trit() {
  clear_logs3()
  log_trit3(1, "success operation")
  log_trit3(0, "partial operation")
  log_trit3(-1, "failed operation")
  let logs = get_logs3()
  assert_gt3(len(logs), 0, "log_trit3 records entries")
}

fn test_log_clear() {
  info3("before clear")
  clear_logs3()
  let logs = get_logs3()
  assert_eq3(len(logs), 0, "clear_logs3 empties log buffer")
}

fn test_log_context() {
  set_context3("test-suite")
  clear_logs3()
  info3("with context")
  let logs = get_logs3()
  assert_gt3(len(logs), 0, "context-scoped logging works")
  set_context3("")
}

// ============================================================
// FORMAT3 TESTS (9 functions)
// ============================================================

fn test_template() {
  let result = template3("Hello {name}, you are {age}", {"name": "Nova", "age": "42"})
  assert_eq3(result, "Hello Nova, you are 42", "template3 replaces placeholders")
}

fn test_pad_num() {
  let result = pad_num3(42, 6)
  assert_eq3(len(result), 6, "pad_num3 right-aligns to width")
  assert_contains3(result, "42", "pad_num3 contains the number")
}

fn test_pad_str() {
  let result = pad_str3("hi", 6)
  assert_eq3(len(result), 6, "pad_str3 left-aligns to width")
}

fn test_trit_fmt() {
  let pos = trit_fmt3(1)
  let maybe = trit_fmt3(0)
  let neg = trit_fmt3(-1)
  assert_contains3(pos, "+1", "trit_fmt3 positive contains +1")
  assert_contains3(neg, "-1", "trit_fmt3 negative contains -1")
}

fn test_bytes_fmt() {
  assert_eq3(bytes_fmt3(500), "500 B", "bytes_fmt3 formats bytes")
  assert_contains3(bytes_fmt3(2048), "KB", "bytes_fmt3 formats KB")
  assert_contains3(bytes_fmt3(5000000), "MB", "bytes_fmt3 formats MB")
}

fn test_pct_fmt() {
  assert_eq3(pct_fmt3(3, 10), "30%", "pct_fmt3 calculates percentage")
  assert_eq3(pct_fmt3(0, 0), "0%", "pct_fmt3 handles zero total")
}

fn test_progress_bar() {
  let bar = progress3(7, 10, 20)
  assert_contains3(bar, "[", "progress3 starts with [")
  assert_contains3(bar, "]", "progress3 ends with ]")
  assert_contains3(bar, "%", "progress3 shows percentage")
}

fn test_table() {
  let lines = table3(["Name", "Score"], [["Alpha", "85"], ["Beta", "72"]])
  assert_gt3(len(lines), 0, "table3 returns formatted lines")
}

// ============================================================
// RUN ALL SUITES
// ============================================================

let event_results = suite3("event3 Module", [
  test_event_on_emit,
  test_event_off,
  test_event_once,
  test_event_events_list,
  test_event_log
])

let pipe_results = suite3("pipe3 Module", [
  test_pipe_basic,
  test_compose_basic,
  test_tap,
  test_when,
  test_branch,
  test_memo
])

let log_results = suite3("log3 Module", [
  test_log_levels,
  test_log_errors_only,
  test_log_trit,
  test_log_clear,
  test_log_context
])

let format_results = suite3("format3 Module", [
  test_template,
  test_pad_num,
  test_pad_str,
  test_trit_fmt,
  test_bytes_fmt,
  test_pct_fmt,
  test_progress_bar,
  test_table
])

report3_multi([event_results, pipe_results, log_results, format_results])
