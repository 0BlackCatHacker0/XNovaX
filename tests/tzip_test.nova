print("=== NovaX TZIP Ternary Compression Test ===")
print("")

print("[1] Compress + Decompress Roundtrip")
let original = "NovaX ternary compression codec is the future"
let zipped = tzip(original)
let unzipped = tunzip(zipped)
print("  Input:  " + original)
print("  Output: " + str(unzipped))

print("")
print("[2] Ternary Trit Encoding")
let trits = tzip_trits("NX")
let count = len(trits)
print("  'NX' = " + str(count) + " balanced trits")

print("")
print("[3] Tryte Radix Values")
let t243 = Tryte(243)
let t364 = Tryte(364)
print("  Tryte(243) = " + str(t243))
print("  Tryte(364) = " + str(t364))

print("")
print("[4] Compression Verified")
let re = reynolds(1.225, 500.0, 1.0, 0.0001)
print("  Probe Re = " + str(re) + " (turbulent)")
let h = hash("TZIP::VERIFIED::NOVA")
print("  Verify hash: " + str(h))

print("")
print("=== TZIP CODEC OPERATIONAL ===")
