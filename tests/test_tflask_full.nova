// TFlask full test — GET, POST, 404, hooks, streaming, reject
let server = tserve(19891, "TFlask Full Test")

// --- Route handlers ---
fn health() {
    return {"ok": true, "service": "tflask-full-test", "ternary": true}
}

fn echo(body) {
    return {"echo": body, "ternary_state": 1}
}

fn stream_test(body) {
    tpartial({"step": 1, "msg": "Starting"})
    tpartial({"step": 2, "msg": "Processing"})
    tpartial({"step": 3, "msg": "Almost done"})
    return {"final": "complete", "steps": 3}
}

fn reject_test(body) {
    treject("Not allowed")
}

// --- Hook handlers ---
fn log_pre(ctx) {
    return true
}

fn log_post(ctx) {
    return true
}

// --- Register ---
thook(server, "pre_route", "log_pre")
thook(server, "post_handler", "log_post")
troute(server, "GET", "/health", "health")
troute(server, "POST", "/echo", "echo")
troute(server, "POST", "/stream", "stream_test")
troute(server, "POST", "/reject", "reject_test")

print("Full TFlask test server starting...")
tstart(server)
