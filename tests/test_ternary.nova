// test_ternary.nova — Tests ternary builtins and control flow
// Expected: exit 0 (all pass)

let pass = 0
let total = 0

// Test bool3
total = total + 1
let t = bool3(1)
if3 t == 1 { pass = pass + 1 } else { print("FAIL: bool3(1) != 1") }

total = total + 1
let t2 = bool3(0)
if3 t2 == 0 { pass = pass + 1 } else { print("FAIL: bool3(0) != 0") }

total = total + 1
let t3 = bool3(-5)
if3 t3 == -1 { pass = pass + 1 } else { print("FAIL: bool3(-5) != -1") }

// Test not3
total = total + 1
if3 not3(1) == -1 { pass = pass + 1 } else { print("FAIL: not3(1) != -1") }

total = total + 1
if3 not3(0) == 0 { pass = pass + 1 } else { print("FAIL: not3(0) != 0") }

total = total + 1
if3 not3(-1) == 1 { pass = pass + 1 } else { print("FAIL: not3(-1) != 1") }

// Test and3 / or3
total = total + 1
if3 and3(1, 1) == 1 { pass = pass + 1 } else { print("FAIL: and3(1,1) != 1") }

total = total + 1
if3 and3(1, 0) == 0 { pass = pass + 1 } else { print("FAIL: and3(1,0) != 0") }

total = total + 1
if3 or3(-1, 1) == 1 { pass = pass + 1 } else { print("FAIL: or3(-1,1) != 1") }

// Test cmp3
total = total + 1
if3 cmp3(5, 3) == 1 { pass = pass + 1 } else { print("FAIL: cmp3(5,3) != 1") }

total = total + 1
if3 cmp3(3, 3) == 0 { pass = pass + 1 } else { print("FAIL: cmp3(3,3) != 0") }

total = total + 1
if3 cmp3(1, 7) == -1 { pass = pass + 1 } else { print("FAIL: cmp3(1,7) != -1") }

// Test balanced ternary
total = total + 1
let bt8 = bt(8)
if3 bt8 == "10T" { pass = pass + 1 } else { print("FAIL: bt(8) = " + bt8 + " expected 10T") }

total = total + 1
let val = bt_val("10T")
if3 val == 8 { pass = pass + 1 } else { print("FAIL: bt_val(10T) = " + str(val)) }

total = total + 1
let neg = bt_neg("10T")
if3 neg == "T01" { pass = pass + 1 } else { print("FAIL: bt_neg(10T) = " + neg + " expected T01") }

print("TERNARY: " + str(pass) + "/" + str(total) + " passed")
