// More builtin discovery
print("=== join tests ===")
let r1 = join("-", ["a", "b", "c"]) ?? "MISSING"
print("join('-', list): " + str(r1))
let r2 = join(["a", "b", "c"], "-") ?? "MISSING"
print("join(list, '-'): " + str(r2))

print("=== find/index tests ===")
let r3 = index_of("hello", "ll") ?? "MISSING"
print("index_of: " + str(r3))
let r4 = str_index("hello", "ll") ?? "MISSING"
print("str_index: " + str(r4))
let r5 = find("hello", "ll") ?? "MISSING"
print("find: " + str(r5))
let r6 = search("hello", "ll") ?? "MISSING"
print("search: " + str(r6))
let r7 = pos("hello", "ll") ?? "MISSING"
print("pos: " + str(r7))

print("=== json tests ===")
let r8 = json_encode({"a": 1}) ?? "MISSING"
print("json_encode: " + str(r8))
let r9 = json_decode("{\"a\":1}") ?? "MISSING"
print("json_decode: " + str(r9))
let r10 = to_json({"a": 1}) ?? "MISSING"
print("to_json: " + str(r10))
let r11 = from_json("{\"a\":1}") ?? "MISSING"
print("from_json: " + str(r11))
let r12 = parse("{\"a\":1}") ?? "MISSING"
print("parse: " + str(r12))
let r13 = stringify({"a": 1}) ?? "MISSING"
print("stringify: " + str(r13))

print("=== contains details ===")
let r14 = contains("hello", "ell")
print("contains raw: " + str(r14))
print("contains type: " + str(type_of(r14)))

print("=== cmp3 details ===")
let r15 = cmp3(5, 3)
print("cmp3(5,3): " + str(r15))
print("cmp3 type: " + str(type_of(r15)))
let r16 = cmp3(3, 3)
print("cmp3(3,3): " + str(r16))
let r17 = cmp3(1, 3)
print("cmp3(1,3): " + str(r17))

print("=== async3 builtins ===")
let r18 = async3 ?? "MISSING"
print("async3: " + str(r18))
let r19 = async3_status ?? "MISSING"
print("async3_status: " + str(r19))
let r20 = async3_all ?? "MISSING"
print("async3_all: " + str(r20))

print("=== list builtins ===")
let r21 = push([1, 2], 3) ?? "MISSING"
print("push: " + str(r21))
let r22 = append([1, 2], 3) ?? "MISSING"
print("append: " + str(r22))
let r23 = list_set([1, 2, 3], 1, 99) ?? "MISSING"
print("list_set: " + str(r23))
let r24 = replace_at([1, 2, 3], 1, 99) ?? "MISSING"
print("replace_at: " + str(r24))

print("=== misc builtins ===")
let r25 = range(5) ?? "MISSING"
print("range: " + str(r25))
let r26 = floor(3.7) ?? "MISSING"
print("floor: " + str(r26))
let r27 = http_get ?? "MISSING"
print("http_get exists: " + str(type_of(r27)))
let r28 = http_post ?? "MISSING"
print("http_post exists: " + str(type_of(r28)))
let r29 = sha256("test") ?? "MISSING"
print("sha256: " + str(r29))
let r30 = hmac_sha256("key", "data") ?? "MISSING"
print("hmac_sha256: " + str(r30))
let r31 = time() ?? "MISSING"
print("time: " + str(r31))
let r32 = tlog("INFO", "test") ?? "MISSING"
print("tlog: " + str(r32))
let r33 = health3(9999) ?? "MISSING"
print("health3: " + str(r33))

print("=== DONE ===")
