// Markov Chain Router Tests
import3 "C:\\NovaX\\stdlib\\markov3.nova"

print("=== Markov3 Chain Tests ===")

let m = markov3_new("provider-chain")
m = markov3_add_state(m, "openai")
m = markov3_add_state(m, "anthropic")
m = markov3_add_state(m, "ollama")

// Simulate: openai→anthropic (success), anthropic→ollama (success), ollama→openai (fail)
m = markov3_transition(m, "openai", "anthropic", 1)
m = markov3_transition(m, "anthropic", "ollama", 1)
m = markov3_transition(m, "ollama", "openai", 0)
m = markov3_transition(m, "openai", "anthropic", 1)
m = markov3_transition(m, "openai", "ollama", 1)

// Transition probabilities
let p_oa = markov3_prob(m, "openai", "anthropic")
let p_oo = markov3_prob(m, "openai", "ollama")
print(f"  P(anthropic|openai) = {p_oa} (expect ~0.67)")
print(f"  P(ollama|openai) = {p_oo} (expect ~0.33)")

// Prediction
let pred = markov3_predict(m, "openai")
print(f"  Predict from openai: {pred}")

// Fallback after failure
let fb = markov3_fallback(m, "openai")
print(f"  Fallback after openai fail: {fb}")

// Stats
let stats = markov3_stats(m)
print(f"  Total transitions: {dict_get(stats, 'total_transitions')} (expect 5)")
print(f"  States: {dict_get(stats, 'states')}")
print(f"  Current: {dict_get(stats, 'current_state')}")

print("=== Markov3 tests complete ===")
