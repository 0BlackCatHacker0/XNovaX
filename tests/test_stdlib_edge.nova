// ============================================================
// NOVAX TEST: Stdlib Edge Cases (math3, string3, list3, dict3)
// ============================================================
// Boundary conditions, empty inputs, negative cases, overflow.
// Run: python novalang.py tests/test_stdlib_edge.nova
// ============================================================

import3 "tests/test_framework.nova" { test3, assert3, assert_eq3, assert_trit3, assert_gt3, assert_lt3, assert_contains3, assert_len3, suite3, report3, report3_multi, H3, H5, H7, H13 }
import3 math3
import3 string3
import3 list3
import3 dict3

// ============================================================
// MATH3 EDGE CASES
// ============================================================

fn test_math_zero_division() {
  // div3 should handle division by zero gracefully
  let result = div3(10, 0)
  assert_eq3(result, 0, "div3(10,0) returns 0 (safe)")
}

fn test_math_negative_factorial() {
  // factorial of negative should return 1 or handle gracefully
  let result = factorial3(-1)
  assert_gt3(result, -1, "factorial3(-1) does not crash")
}

fn test_math_large_pow() {
  // 3^13 = 1594323 (ternary alignment)
  let result = pow3(3, 13)
  assert_eq3(result, 1594323, "3^13 = 1594323")
}

fn test_math_pow_zero() {
  assert_eq3(pow3(0, 0), 1, "0^0 = 1 by convention")
  assert_eq3(pow3(5, 0), 1, "5^0 = 1")
  assert_eq3(pow3(0, 5), 0, "0^5 = 0")
}

fn test_math_empty_list_ops() {
  assert_eq3(sum3([]), 0, "sum of empty list = 0")
  assert_eq3(avg3([]), 0, "avg of empty list = 0")
}

fn test_math_single_element() {
  assert_eq3(sum3([42]), 42, "sum of [42] = 42")
  assert_eq3(avg3([42]), 42, "avg of [42] = 42")
  assert_eq3(min_list3([42]), 42, "min of [42] = 42")
  assert_eq3(max_list3([42]), 42, "max of [42] = 42")
}

fn test_math_min_max_negative() {
  assert_eq3(min3(-100, -1), -100, "min(-100,-1) = -100")
  assert_eq3(max3(-100, -1), -1, "max(-100,-1) = -1")
}

fn test_math_clamp_equal_bounds() {
  assert_eq3(clamp3(5, 5, 5), 5, "clamp(5,5,5) = 5")
  assert_eq3(clamp3(10, 5, 5), 5, "clamp(10,5,5) = 5")
}

fn test_math_harmonic_constants() {
  // Verify 3-5-7-13 computed values
  assert_eq3(pow3(3, 3), 27, "H3^3 = 27 (laminar boundary)")
  assert_eq3(pow3(5, 3), 125, "H5^3 = 125 (transitional boundary)")
  assert_eq3(pow3(7, 3), 343, "H7^3 = 343 (turbulent boundary)")
  assert_eq3(pow3(3, 7), 2187, "BLOCK_SIZE = 3^H7 = 2187")
  assert_eq3(H13 * H13, 169, "H13^2 = 169 (cache max)")
  assert_eq3(H13 * H7, 91, "H13*H7 = 91 (ring buffer)")
}

// ============================================================
// STRING3 EDGE CASES
// ============================================================

fn test_string_empty() {
  assert_eq3(len(""), 0, "len of empty string = 0")
  assert_eq3(upper3(""), "", "upper of empty = empty")
  assert_eq3(lower3(""), "", "lower of empty = empty")
  assert_eq3(trim3(""), "", "trim of empty = empty")
}

fn test_string_whitespace_only() {
  assert_eq3(trim3("   "), "", "trim whitespace-only = empty")
  assert_eq3(trim3("  \t  "), "", "trim mixed whitespace = empty")
}

fn test_string_single_char() {
  assert_eq3(upper3("a"), "A", "upper single char")
  assert_eq3(lower3("Z"), "z", "lower single char")
  assert_eq3(len("x"), 1, "len single char = 1")
}

fn test_string_contains_edge() {
  assert_eq3(contains("hello", ""), 1, "contains empty substring = true")
  assert_eq3(contains("", "hello"), 0, "empty string contains nothing")
  assert_eq3(contains("abc", "abc"), 1, "string contains itself")
}

fn test_string_split_edge() {
  let parts = split3("hello", ",")
  assert_eq3(len(parts), 1, "split no-delimiter = 1 part")
  let parts2 = split3(",,,", ",")
  assert_eq3(len(parts2), 4, "split consecutive delimiters")
}

fn test_string_replace_edge() {
  assert_eq3(replace3("aaa", "a", "b"), "bbb", "replace all chars")
  assert_eq3(replace3("hello", "xyz", "abc"), "hello", "replace nonexistent = unchanged")
}

fn test_string_slice_edge() {
  assert_eq3(slice3("hello", 0, 0), "", "slice zero length = empty")
  assert_eq3(slice3("hello", 0, 100), "hello", "slice beyond length = full string")
}

fn test_string_repeat_edge() {
  assert_eq3(repeat3("x", 0), "", "repeat 0 = empty")
  assert_eq3(repeat3("x", 1), "x", "repeat 1 = original")
  assert_eq3(repeat3("ab", 3), "ababab", "repeat 3")
}

// ============================================================
// LIST3 EDGE CASES
// ============================================================

fn test_list_empty_ops() {
  let empty = []
  assert_eq3(len(empty), 0, "len of empty list = 0")
  let mapped = map3(empty, fn(x) { return x * 2 })
  assert_eq3(len(mapped), 0, "map empty list = empty")
  let filtered = filter3(empty, fn(x) { return 1 })
  assert_eq3(len(filtered), 0, "filter empty list = empty")
}

fn test_list_single_element_ops() {
  let single = [42]
  let mapped = map3(single, fn(x) { return x * 2 })
  assert_eq3(mapped[0], 84, "map single element")
  let reversed = reverse3(single)
  assert_eq3(reversed[0], 42, "reverse single = same")
}

fn test_list_append_to_empty() {
  let result = append([], "first")
  assert_eq3(len(result), 1, "append to empty = 1 element")
  assert_eq3(result[0], "first", "appended value correct")
}

fn test_list_nested_operations() {
  let data = [1, 2, 3, 4, 5, 6, 7, 8, 9]
  // Filter even, then map to squares
  fn is_even(x) { return x % 2 }
  fn square(x) { return x * x }
  let evens = filter3(data, fn(x) { return 1 - (x % 2) })
  let squares = map3(evens, square)
  assert_eq3(len(squares), 4, "filter then map: 4 even numbers")
}

fn test_list_reduce_edge() {
  let result = reduce3([5], fn(a, b) { return a + b }, 0)
  assert_eq3(result, 5, "reduce single element")
  let result2 = reduce3([], fn(a, b) { return a + b }, 99)
  assert_eq3(result2, 99, "reduce empty = initial value")
}

fn test_list_sort_already_sorted() {
  let sorted = sort3([1, 2, 3, 4, 5])
  assert_eq3(sorted[0], 1, "sort already-sorted: first")
  assert_eq3(sorted[4], 5, "sort already-sorted: last")
}

fn test_list_sort_reverse() {
  let sorted = sort3([5, 4, 3, 2, 1])
  assert_eq3(sorted[0], 1, "sort reverse: first")
  assert_eq3(sorted[4], 5, "sort reverse: last")
}

fn test_list_sort_duplicates() {
  let sorted = sort3([3, 1, 3, 1, 2])
  assert_eq3(sorted[0], 1, "sort with dupes: first")
  assert_eq3(sorted[4], 3, "sort with dupes: last")
}

fn test_list_index_bounds() {
  let data = [10, 20, 30]
  assert_eq3(data[0], 10, "index 0")
  assert_eq3(data[2], 30, "index 2 (last)")
}

// ============================================================
// DICT3 EDGE CASES
// ============================================================

fn test_dict_empty() {
  let empty = {}
  let keys = dict_keys(empty)
  assert_eq3(len(keys), 0, "keys of empty dict = 0")
}

fn test_dict_get_missing() {
  let d = {"a": 1}
  let result = dict_get(d, "b") ?? -1
  assert_eq3(result, -1, "dict_get missing key returns default")
}

fn test_dict_set_overwrite() {
  let d = {"a": 1}
  let d2 = dict_set(d, "a", 99)
  assert_eq3(dict_get(d2, "a") ?? 0, 99, "dict_set overwrites existing key")
}

fn test_dict_has_key_edge() {
  let d = {"name": "NovaX", "version": "5.0"}
  assert_eq3(dict_has(d, "name"), 1, "dict_has existing key = 1")
  assert_eq3(dict_has(d, "missing"), 0, "dict_has missing key = 0")
}

fn test_dict_merge_edge() {
  let a = {"x": 1, "y": 2}
  let b = {"y": 99, "z": 3}
  let merged = dict_merge(a, b)
  assert_eq3(dict_get(merged, "x") ?? 0, 1, "merge keeps left key")
  assert_eq3(dict_get(merged, "y") ?? 0, 99, "merge: right overwrites")
  assert_eq3(dict_get(merged, "z") ?? 0, 3, "merge adds right key")
}

fn test_dict_keys_values_edge() {
  let d = {"a": 1, "b": 2, "c": 3}
  let keys = dict_keys(d)
  let vals = dict_values(d)
  assert_eq3(len(keys), 3, "dict_keys count = 3")
  assert_eq3(len(vals), 3, "dict_values count = 3")
}

// ============================================================
// RUN ALL SUITES
// ============================================================

let math_edge = suite3("math3 Edge Cases", [
  test_math_zero_division,
  test_math_negative_factorial,
  test_math_large_pow,
  test_math_pow_zero,
  test_math_empty_list_ops,
  test_math_single_element,
  test_math_min_max_negative,
  test_math_clamp_equal_bounds,
  test_math_harmonic_constants
])

let string_edge = suite3("string3 Edge Cases", [
  test_string_empty,
  test_string_whitespace_only,
  test_string_single_char,
  test_string_contains_edge,
  test_string_split_edge,
  test_string_replace_edge,
  test_string_slice_edge,
  test_string_repeat_edge
])

let list_edge = suite3("list3 Edge Cases", [
  test_list_empty_ops,
  test_list_single_element_ops,
  test_list_append_to_empty,
  test_list_nested_operations,
  test_list_reduce_edge,
  test_list_sort_already_sorted,
  test_list_sort_reverse,
  test_list_sort_duplicates,
  test_list_index_bounds
])

let dict_edge = suite3("dict3 Edge Cases", [
  test_dict_empty,
  test_dict_get_missing,
  test_dict_set_overwrite,
  test_dict_has_key_edge,
  test_dict_merge_edge,
  test_dict_keys_values_edge
])

report3_multi([math_edge, string_edge, list_edge, dict_edge])
