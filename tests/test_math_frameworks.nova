// NovaLang v1.4 Math Framework Tests
// Tests: queue_theory3, pid3, shannon3

import3 "C:\\NovaX\\stdlib\\queue_theory3.nova"
import3 "C:\\NovaX\\stdlib\\pid3.nova"
import3 "C:\\NovaX\\stdlib\\shannon3.nova"

print("=== Math Framework Tests ===")
print("")

// ── Queue Theory3 ──
print("── Queue Theory3 (Little's Law + M/M/1) ──")
let q = qt3_new("test-queue", 100)
q = qt3_register(q, "openai", 50)
q = qt3_register(q, "anthropic", 40)
q = qt3_register(q, "ollama", 30)

// Simulate arrivals
q = qt3_arrive(q, "openai")
q = qt3_arrive(q, "anthropic")
q = qt3_arrive(q, "ollama")

// Simulate departures
q = qt3_depart(q, "openai", 150)
q = qt3_depart(q, "anthropic", 200)
q = qt3_depart(q, "ollama", 300)

let qstats = qt3_stats(q)
print(f"  Total routed: {dict_get(qstats, 'total_routed')} (expect 3)")
print(f"  Provider stats: {dict_get(qstats, 'providers')}")

// Selection
let qsel = qt3_select(q)
print(f"  Best provider: {dict_get(qsel, 'provider')}")
print(f"  Trit: {dict_get(qsel, 'trit')}")

print("")

// ── PID Controller ──
print("── PID3 Controller ──")
let pid = pid3_new("rate-control", 70)
print(f"  Initial: {pid3_stats(pid)}")

// Simulate: measurement starts at 30, PID should push output up toward setpoint=70
let m = 30
let step = 0
while3 step < 7 {
    let result = pid3_update(pid, m)
    pid = dict_get(result, "pid")
    let output = dict_get(result, "output") ?? 0
    let error = dict_get(result, "error") ?? 0
    let trit = dict_get(result, "trit") ?? -1
    print(f"  Step {step}: measurement={m} output={output} error={error} trit={trit}")
    // Simulate system responding to control output
    m = m + output * 0.3
    if3 m > 100 { m = 100 }
    if3 m < 0 { m = 0 }
    step = step + 1
}

// After 7 steps, should be near setpoint
print(f"  Final measurement: {m} (target: 70)")
let final_stats = pid3_stats(pid)
print(f"  Final stats: {final_stats}")

// Reset test
let pid2 = pid3_reset(pid)
print(f"  After reset integral: {dict_get(pid2, 'integral')} (expect 0)")

// Setpoint change
let pid3_inst = pid3_set_target(pid, 50)
print(f"  New setpoint: {dict_get(pid3_inst, 'setpoint')} (expect 50)")

print("")

// ── Shannon Entropy ──
print("── Shannon3 Entropy ──")

// Test log2
let l2_1 = shannon3_log2(1)
let l2_2 = shannon3_log2(2)
let l2_4 = shannon3_log2(4)
let l2_8 = shannon3_log2(8)
print(f"  log2(1)={l2_1} (expect 0)")
print(f"  log2(2)={l2_2} (expect ~1)")
print(f"  log2(4)={l2_4} (expect ~2)")
print(f"  log2(8)={l2_8} (expect ~3)")

// Test entropy - uniform distribution (maximum entropy)
let uniform = {"a": 10, "b": 10, "c": 10, "d": 10}
let h_uniform = shannon3_entropy(uniform)
let n_uniform = shannon3_normalized(uniform)
print(f"  Uniform entropy: {h_uniform} (expect ~2.0)")
print(f"  Uniform normalized: {n_uniform} (expect ~1.0)")
print(f"  Uniform health: {shannon3_health(uniform)} (expect 1, diverse)")

// Test entropy - skewed distribution
let skewed = {"a": 90, "b": 5, "c": 3, "d": 2}
let h_skewed = shannon3_entropy(skewed)
let n_skewed = shannon3_normalized(skewed)
print(f"  Skewed entropy: {h_skewed}")
print(f"  Skewed normalized: {n_skewed}")
print(f"  Skewed health: {shannon3_health(skewed)} (expect 0 or -1)")

// Test entropy - collapsed (all same)
let collapsed = {"a": 100}
let h_collapsed = shannon3_entropy(collapsed)
print(f"  Collapsed entropy: {h_collapsed} (expect 0)")
print(f"  Collapsed health: {shannon3_health(collapsed)} (expect -1)")

// Test redundancy
let r_uniform = shannon3_redundancy(uniform)
let r_skewed = shannon3_redundancy(skewed)
print(f"  Uniform redundancy: {r_uniform} (expect ~0)")
print(f"  Skewed redundancy: {r_skewed} (expect high)")

// Test diversity tracker
let tracker = shannon3_tracker_new("provider-diversity")
tracker = shannon3_record(tracker, "openai", "good")
tracker = shannon3_record(tracker, "anthropic", "good")
tracker = shannon3_record(tracker, "ollama", "ok")
tracker = shannon3_record(tracker, "openai", "good")
tracker = shannon3_record(tracker, "openai", "excellent")
let tstats = shannon3_stats(tracker)
print(f"  Tracker stats: {tstats}")
print(f"  Provider entropy: {dict_get(tstats, 'provider_entropy')}")
print(f"  Provider diversity: {dict_get(tstats, 'provider_diversity')}")

print("")
print("=== Math framework tests complete ===")
