// ============================================================
// NOVAX TEST: New Services (TConfig, TBenchmark, TTest, TDocs)
// ============================================================
// Tests Session 38 NovaLang services on ports 9932-9935.
// Requires: Orchestrator (:9999) + target services running.
// Run: python novalang.py tests/test_new_services.nova
// ============================================================

import3 "tests/test_framework.nova" { test3, assert3, assert_eq3, assert_trit3, assert_gt3, assert_contains3, suite3, report3, report3_multi, H3, H5, H7, H13 }
import3 http3

// ============================================================
// TCONFIG SERVICE (port 9932)
// ============================================================

fn test_tconfig_health() {
  let trit = health3(9932)
  assert_trit3(trit, 1, "tconfig service healthy")
}

fn test_tconfig_set_get() {
  let resp = post3("http://127.0.0.1:9932/tconfig/set", {
    "key": "test.greeting",
    "value": "hello novax",
    "namespace": "test"
  })
  assert_trit3(resp["trit"], 1, "tconfig set works")

  let resp2 = get3("http://127.0.0.1:9932/tconfig/get?key=test.greeting")
  if3 resp2["trit"] {
    assert_eq3(resp2["value"], "hello novax", "tconfig get returns correct value")
  } maybe {
    assert3(1, "tconfig get partial (service may be cold)")
  } else3 {
    assert3(0, "tconfig get failed (service not running?)")
  }
}

fn test_tconfig_list() {
  let resp = get3("http://127.0.0.1:9932/tconfig/list")
  assert_trit3(resp["trit"], 1, "tconfig list responds")
}

fn test_tconfig_stats() {
  let resp = get3("http://127.0.0.1:9932/tconfig/stats")
  assert_trit3(resp["trit"], 1, "tconfig stats responds")
}

// ============================================================
// TBENCHMARK SERVICE (port 9933)
// ============================================================

fn test_tbenchmark_health() {
  let trit = health3(9933)
  assert_trit3(trit, 1, "tbenchmark service healthy")
}

fn test_tbenchmark_latency() {
  let resp = post3("http://127.0.0.1:9933/tbenchmark/latency", {
    "target": "http://127.0.0.1:9999/health",
    "iterations": H3
  })
  if3 resp["trit"] {
    assert_gt3(resp["avg_ms"], -1, "latency measurement returned")
  } maybe {
    assert3(1, "tbenchmark partial response")
  } else3 {
    assert3(0, "tbenchmark not running")
  }
}

fn test_tbenchmark_results() {
  let resp = get3("http://127.0.0.1:9933/tbenchmark/results")
  assert_trit3(resp["trit"], 1, "tbenchmark results responds")
}

fn test_tbenchmark_history() {
  let resp = get3("http://127.0.0.1:9933/tbenchmark/history")
  assert_trit3(resp["trit"], 1, "tbenchmark history responds")
}

// ============================================================
// TTEST SERVICE (port 9934)
// ============================================================

fn test_ttest_health() {
  let trit = health3(9934)
  assert_trit3(trit, 1, "ttest service healthy")
}

fn test_ttest_list() {
  let resp = get3("http://127.0.0.1:9934/ttest/list")
  assert_trit3(resp["trit"], 1, "ttest list responds")
}

fn test_ttest_results() {
  let resp = get3("http://127.0.0.1:9934/ttest/results")
  assert_trit3(resp["trit"], 1, "ttest results responds")
}

fn test_ttest_report() {
  let resp = get3("http://127.0.0.1:9934/ttest/report")
  assert_trit3(resp["trit"], 1, "ttest report responds")
}

// ============================================================
// TDOCS SERVICE (port 9935)
// ============================================================

fn test_tdocs_health() {
  let trit = health3(9935)
  assert_trit3(trit, 1, "tdocs service healthy")
}

fn test_tdocs_list() {
  let resp = get3("http://127.0.0.1:9935/tdocs/list")
  assert_trit3(resp["trit"], 1, "tdocs list responds")
}

fn test_tdocs_stats() {
  let resp = get3("http://127.0.0.1:9935/tdocs/stats")
  assert_trit3(resp["trit"], 1, "tdocs stats responds")
}

fn test_tdocs_auto_register() {
  let resp = post3("http://127.0.0.1:9935/tdocs/auto-register", {})
  if3 resp["trit"] {
    assert_gt3(resp["registered"], 0, "auto-register populated docs")
  } maybe {
    assert3(1, "tdocs auto-register partial")
  } else3 {
    assert3(0, "tdocs not running")
  }
}

fn test_tdocs_search() {
  let resp = get3("http://127.0.0.1:9935/tdocs/search?query=health")
  assert_trit3(resp["trit"], 1, "tdocs search responds")
}

// ============================================================
// RUN ALL SUITES
// ============================================================

let config_results = suite3("TConfig Service (:9932)", [
  test_tconfig_health,
  test_tconfig_set_get,
  test_tconfig_list,
  test_tconfig_stats
])

let bench_results = suite3("TBenchmark Service (:9933)", [
  test_tbenchmark_health,
  test_tbenchmark_latency,
  test_tbenchmark_results,
  test_tbenchmark_history
])

let ttest_results = suite3("TTest Service (:9934)", [
  test_ttest_health,
  test_ttest_list,
  test_ttest_results,
  test_ttest_report
])

let docs_results = suite3("TDocs Service (:9935)", [
  test_tdocs_health,
  test_tdocs_list,
  test_tdocs_stats,
  test_tdocs_auto_register,
  test_tdocs_search
])

report3_multi([config_results, bench_results, ttest_results, docs_results])
