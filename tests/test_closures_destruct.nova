// ── Closures & Destructuring Test ──

// Test 1: Basic closure — inner fn captures outer variable
let multiplier = 3
fn make_multiplier(factor) {
    fn multiply(x) {
        return x * factor
    }
    return multiply
}

let double = make_multiplier(2)
let triple = make_multiplier(3)
assert(double(5) == 10)
assert(triple(5) == 15)
print("PASS: closures capture outer scope")

// Test 2: Counter closure — stateful fn
fn make_counter() {
    let count = 0
    fn next() {
        count = count + 1
        return count
    }
    return next
}

// Test 3: Array destructuring
let items = [10, 20, 30]
let [a, b, c] = items
assert(a == 10)
assert(b == 20)
assert(c == 30)
print("PASS: array destructuring")

// Test 4: Dict destructuring
let config = {"host": "localhost", "port": 9999, "debug": 1}
let {host, port, debug} = config
assert(host == "localhost")
assert(port == 9999)
assert(debug == 1)
print("PASS: dict destructuring")

// Test 5: Partial destructuring (fewer names than values)
let pair = [100, 200, 300]
let [first, second] = pair
assert(first == 100)
assert(second == 200)
print("PASS: partial array destructuring")

// Test 6: Destructuring with computed values
let data = [1 + 2, 3 * 4, 5]
let [x, y, z] = data
assert(x == 3)
assert(y == 12)
assert(z == 5)
print("PASS: destructuring with computed source")

print("=== ALL CLOSURE & DESTRUCTURING TESTS PASSED ===")
