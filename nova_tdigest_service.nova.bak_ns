// nova_tdigest_service.nova -- NovaX Ternary Data Digest Micro-Tool (port 9983)
// Pure NovaLang port of nova_tdigest.py
//
// The brain stem of NovaX. Compresses raw information into digestible summaries.
// Summarize logs, metrics, conversations, code changes. Extracts key points
// with ternary confidence scoring.
//
// Like the Navier-Stokes equations reduce turbulent chaos to smooth laminar flow,
// TDigest reduces noisy data to clear signal.
//
// Algorithms:
//   Extractive Summary -- Score sentences by word frequency, position, length,
//                         keyword overlap. Pick top N by composite score.
//   Keyword Extraction -- Tokenize, remove stopwords, count TF, rank. Return
//                         top H13 keywords with frequency and importance trit.
//   Statistical Digest -- Pure math: mean, median, std, min, max, percentiles.
//   Diff Digest        -- Summarize code changes: files touched, net delta, hotspots.
//   Log Digest         -- Pattern-match log entries: group by service/level, anomalies.
//
// Trit Scoring:
//   Summary  -- TRUE if compression ratio > 3:1, MAYBE if > 2:1, FALSE if minimal
//   Keywords -- TRUE if >= 5 keywords found, MAYBE if >= 2, FALSE if < 2
//   Stats    -- TRUE always (deterministic computation)
//
// 3-5-7-13 Harmonic Constants:
//   3  = ternary base, trit states, min sentences
//   5  = TZip pack, percentile buckets
//   7  = composition unit, scoring weights
//   13 = carrier frame, max keywords returned
//
// Endpoints:
//   GET  /tdigest/health      -- Health check with ternary stats
//   POST /tdigest/summarize   -- Extractive summary of text
//   POST /tdigest/keywords    -- Extract top keywords with importance trits
//   POST /tdigest/stats       -- Statistical digest of numeric data
//   POST /tdigest/diff_digest -- Summarize code changes
//   POST /tdigest/log_digest  -- Summarize log patterns
//   GET  /tdigest/stats       -- Cumulative digest statistics

// -- Port and server --
let PORT = 9983
let server = tserve(PORT, "TDigest v1.0 - NovaX Ternary Data Digest Engine")

// -- Harmonic constants --
let H3   = 3
let H5   = 5
let H7   = 7
let H13  = 13
let BLOCK = 2187     // 3^7 ternary block

// -- Ternary state constants --
let T_TRUE  =  1
let T_MAYBE =  0
let T_FALSE = -1

// -- Service identity --
let VERSION      = "1.0"
let SERVICE_NAME = "nova-tdigest"

// -- Body limit: BLOCK * H7 = 15309 bytes --
let MAX_BODY = 15309

// -- N-S Reynolds boundaries --
let RE_LAMINAR     = 27    // H3^3
let RE_TRANS       = 125   // H5^3
let RE_TURBULENT   = 343   // H7^3

// -- Cumulative digest statistics (no threading -- single-flow NovaLang) --
let _total_digests      = 0
let _cnt_summarize      = 0
let _cnt_keywords       = 0
let _cnt_stats          = 0
let _cnt_diff           = 0
let _cnt_log            = 0
let _total_input_chars  = 0
let _total_output_chars = 0
let _start_time         = time()

