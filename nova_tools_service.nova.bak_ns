    "FACT": "who is,what is,when did,where is,history,define,meaning of,fact,wikipedia",
    "INSTRUCT": "how to,step by step,tutorial,guide,instructions,recipe,procedure,workflow",
    "LONG": "essay,article,report,document,story,narrative,chapter,summary,abstract",
    "DOMAIN": "medical,legal,financial,engineering,scientific,clinical,regulatory,compliance",
    "AGENT": "execute,run ,launch,deploy,automate,schedule,trigger,pipeline,workflow",
