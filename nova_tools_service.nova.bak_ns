// ============================================================================
// TIER 1: FILE SYSTEM PRIMITIVES
// ============================================================================

// POST /tools/mkdir — create directory
fn handle_mkdir(body) {
    let path = dict_get(body, "path", "")
    if len(path) == 0 {
        return {"ok": false, "error": "missing 'path'", "trit": T_FALSE}
    }
    let cmd = "mkdir -p \"" + path + "\" 2>&1 && echo OK"
    let exec_body = {"command": cmd}
    let resp = http_post(EXEC_SERVER + "/exec", exec_body, "application/json")
    let out = dict_get(resp, "stdout", "")
    let trit = T_TRUE
    if contains(out, "ERROR") {
        trit = T_FALSE
    }
    record_op_trit(trit)
    return {"ok": trit > 0, "path": path, "output": out, "trit": trit, "char": trit_char(trit)}
}

// POST /tools/ls — list directory contents
fn handle_ls(body) {
    let path = dict_get(body, "path", ".")
    let flags = dict_get(body, "flags", "-la")
    let cmd = "ls " + flags + " \"" + path + "\" 2>&1"
    let exec_body = {"command": cmd}
    let resp = http_post(EXEC_SERVER + "/exec", exec_body, "application/json")
    let out = dict_get(resp, "stdout", "")
    let lines = split(out, "\n")
    let count = len(lines)
    let trit = T_TRUE
    if count == 0 {
        trit = T_MAYBE
    }
    record_op_trit(trit)
    return {"ok": true, "path": path, "entries": count, "output": out, "trit": trit, "char": trit_char(trit)}
}

// POST /tools/du — disk usage
fn handle_du(body) {
    let path = dict_get(body, "path", ".")
    let cmd = "du -sh \"" + path + "\" 2>&1"
    let exec_body = {"command": cmd}
    let resp = http_post(EXEC_SERVER + "/exec", exec_body, "application/json")
    let out = dict_get(resp, "stdout", "")
    let trit = T_TRUE
    if contains(out, "cannot") {
        trit = T_FALSE
    }
    record_op_trit(trit)
    return {"ok": trit >= 0, "path": path, "usage": strip(out), "trit": trit, "char": trit_char(trit)}
}

// POST /tools/df — disk free space
fn handle_df(body) {
    let cmd = "df -h 2>&1"
    let exec_body = {"command": cmd}
    let resp = http_post(EXEC_SERVER + "/exec", exec_body, "application/json")
    let out = dict_get(resp, "stdout", "")
    let lines = split(out, "\n")
    let trit = T_TRUE
    record_op_trit(trit)
    return {"ok": true, "output": out, "volumes": len(lines), "trit": trit, "char": trit_char(trit)}
}

// POST /tools/chmod — change file permissions
fn handle_chmod(body) {
    let path = dict_get(body, "path", "")
    let mode = dict_get(body, "mode", "")
    if len(path) == 0 {
        return {"ok": false, "error": "missing 'path'", "trit": T_FALSE}
    }
    if len(str(mode)) == 0 {
        return {"ok": false, "error": "missing 'mode' (e.g. '755')", "trit": T_FALSE}
    }
    let cmd = "chmod " + str(mode) + " \"" + path + "\" 2>&1 && echo OK"
    let exec_body = {"command": cmd}
    let resp = http_post(EXEC_SERVER + "/exec", exec_body, "application/json")
    let out = dict_get(resp, "stdout", "")
    let trit = T_TRUE
    if contains(out, "ERROR") {
        trit = T_FALSE
    }
    record_op_trit(trit)
    return {"ok": trit > 0, "path": path, "mode": str(mode), "output": out, "trit": trit, "char": trit_char(trit)}
}

// POST /tools/chown — change file ownership
fn handle_chown(body) {
    let path = dict_get(body, "path", "")
    let owner = dict_get(body, "owner", "")
    if len(path) == 0 {
        return {"ok": false, "error": "missing 'path'", "trit": T_FALSE}
    }
    if len(owner) == 0 {
        return {"ok": false, "error": "missing 'owner' (e.g. 'user:group')", "trit": T_FALSE}
    }
    let cmd = "chown " + owner + " \"" + path + "\" 2>&1 && echo OK"
    let exec_body = {"command": cmd}
    let resp = http_post(EXEC_SERVER + "/exec", exec_body, "application/json")
    let out = dict_get(resp, "stdout", "")
    let trit = T_TRUE
    if contains(out, "ERROR") {
        trit = T_FALSE
    }
    record_op_trit(trit)
    return {"ok": trit > 0, "path": path, "owner": owner, "output": out, "trit": trit, "char": trit_char(trit)}
}

// POST /tools/tree — directory tree visualization
fn handle_tree(body) {
    let path = dict_get(body, "path", ".")
    let depth = dict_get(body, "depth", 3)
    let cmd = "find \"" + path + "\" -maxdepth " + str(depth) + " -print 2>&1 | head -200"
    let exec_body = {"command": cmd}
    let resp = http_post(EXEC_SERVER + "/exec", exec_body, "application/json")
    let out = dict_get(resp, "stdout", "")
    let lines = split(out, "\n")
    let count = len(lines)
    let trit = T_TRUE
    if count == 0 {
        trit = T_MAYBE
    }
    record_op_trit(trit)
    return {"ok": true, "path": path, "depth": depth, "entries": count, "tree": out, "trit": trit, "char": trit_char(trit)}
}

// ============================================================================
// TZIP ENDPOINTS
// ============================================================================

// GET /tzip/stats -- compression metrics
fn handle_tzip_stats() {
    return tzip_stats()
}

// POST /tzip/toggle -- enable/disable TZip, or set per-path
fn handle_tzip_toggle(body) {
    let enabled = dict_get(body, "enabled", "toggle")
    if enabled == "toggle" {
        // Toggle current state
        if _tzip_enabled == true {
            let _tzip_enabled = false
        } else {
            let _tzip_enabled = true
    } else {
        if enabled == true {
            let _tzip_enabled = true
        } else {
            let _tzip_enabled = false
        }
    }
    return {"ok": true, "tzip_enabled": _tzip_enabled}
}

// POST /tzip/status -- check shadow status for a specific path
}
fn handle_tzip_path_status(body) {
    let path = dict_get(body, "path", "")
    if len(path) == 0 {
        return {"ok": false, "error": "missing 'path'"}
    }
    let info = tzip_check_status(path)
    return {"ok": true, "path": path, "tzip": info}
}

