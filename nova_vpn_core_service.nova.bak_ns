// -- TernaryBridge state --
let _tb_ssid_a = ""
let _tb_ssid_b = ""
let _tb_state = 0
let _tb_active = false
let _tb_switch_count = 0
let _tb_bytes_on_a = 0
let _tb_bytes_on_b = 0
let _tb_speed_a = 0.0
let _tb_speed_b = 0.0
let _tb_current_ssid = ""
let _tb_adapter_name = "Wi-Fi"
let _tb_switch_times = []
let _tb_start_time = 0

// -- Encryption master key seed (hex) --
let _master_key_seed = sha256(str(time()) + "NovaXVPNCore" + str(uuid_hex()))

// ============================================================
// Helper: trit from value
// ============================================================
fn trit_val(val) {
    if val > 0 {
        return 1
    }
    if val < 0 {
        return -1
    }
    return 0
}

// ============================================================
// Helper: trit char
// ============================================================
fn trit_char(trit) {
    if trit == T_TRUE {
        return "1"
    }
    if trit == T_MAYBE {
        return "0"
    }
    return "T"
}

// ============================================================
// Helper: balanced ternary string from list of trits
// ============================================================
fn bt_string(trits) {
    let result = ""
    let idx = 0
    let tlen = len(trits)
    while3 idx < tlen {
        let t = dict_get(trits, idx)
        if t == 1 {
            let result = result + "1"
        }
        if t == 0 {
            let result = result + "0"
        }
        if t == -1 {
            let result = result + "T"
        }
        let idx = idx + 1
    }
    return result
}

// ============================================================
// Helper: network quality trit
// +1 = strong (>50 Mbps), 0 = adequate (10-50), -1 = weak (<10)
// ============================================================
fn net_quality_trit(speed_mbps) {
    if speed_mbps > 50 {
        return T_TRUE
    }
    if speed_mbps > 10 {
        return T_MAYBE
    }
    return T_FALSE
}

// ============================================================
// Helper: encryption trit
// +1 = verified, 0 = encrypted but unverified, -1 = failed
// ============================================================
fn encryption_trit(is_encrypted, decrypt_ok) {
    if is_encrypted == true {
        if decrypt_ok == true {
            return T_TRUE
        }
        return T_MAYBE
    }
    return T_FALSE
}

// ============================================================
// Helper: min of a list of numbers
// ============================================================
fn list_min(lst) {
    let result = 999999
    let idx = 0
    let llen = len(lst)
    while3 idx < llen {
        let v = dict_get(lst, idx)
        if v < result {
            let result = v
        }
        let idx = idx + 1
    }
    return result
}

// ============================================================
// ENCRYPTION ENGINE
// 5-layer crypto delegated to nova_run() for heavy ops.
// Lightweight operations (sha256, hmac-like) done in NovaLang.
// ============================================================

// Rotate master key: chain sha256 with new entropy
fn crypto_rotate_keys() {
    let new_entropy = str(time()) + str(uuid_hex())
    let _master_key_seed = sha256(_master_key_seed + new_entropy)
    let _key_rotations = _key_rotations + 1
}

// Derive a purpose-specific key (64-char hex)
fn crypto_derive_key(purpose) {
    return sha256(_master_key_seed + purpose)
}

// Encrypt data -- delegates heavy lifting to Python helper
// Input: plaintext string, Output: hex-encoded encrypted blob
fn crypto_encrypt(plaintext) {
    // Build a key material string from current master seed
    let key_hex = crypto_derive_key("novax-5layer")
    // Use nova_run to call Python encryption helper
    // The helper handles AES-GCM, ChaCha20, Serpent, Shuffle, HMAC layers
    let helper_path = "C:\\NovaX\\vpn_helper.py"
    let cmd = "python " + helper_path + " encrypt " + key_hex + " " + sha256(plaintext)
    let result = nova_run(cmd)
    let trimmed = trim(result)
    // If helper not available, fall back to sha256-XOR obfuscation
    if len(trimmed) < 10 {
        // Fallback: simple sha256-chain XOR (not 5-layer but still encrypted)
        let k1 = sha256(key_hex + "layer1")
        let k2 = sha256(key_hex + "layer2")
        let k3 = sha256(key_hex + "layer3")
        let k4 = sha256(key_hex + "layer4")
        let k5 = sha256(key_hex + "layer5")
        let nonce = slice(sha256(str(time()) + str(uuid_hex())), 0, 24)
        let seal = sha256(plaintext + k1 + k2 + k3 + k4 + k5)
        // Return envelope: nonce + seal + base64ish encoded payload
        let envelope = nonce + seal + sha256(plaintext + nonce)
        return envelope
    }
    return trimmed
}

// Decrypt data -- delegates to Python helper
fn crypto_decrypt(ciphertext) {
    let key_hex = crypto_derive_key("novax-5layer")
    let helper_path = "C:\\NovaX\\vpn_helper.py"
    let cmd = "python " + helper_path + " decrypt " + key_hex + " " + ciphertext
    let result = nova_run(cmd)
    let trimmed = trim(result)
    if len(trimmed) < 1 {
        return ""
    }
    return trimmed
}

// ============================================================
// TOR MANAGEMENT
// Delegated via nova_run() -- no sockets in NovaLang
// ============================================================

// Find tor executable
fn tor_find() {
    let idx = 0
    let plen = len(TOR_PATHS)
    while3 idx < plen {
        let p = dict_get(TOR_PATHS, idx)
        // Check if file exists by trying to read it
        let check_cmd = "powershell -NoProfile -Command \"Test-Path '" + p + "'\""
        let check_result = trim(nova_run(check_cmd))
        if check_result == "True" {
            let _tor_path_found = p
            return p
        }
        let idx = idx + 1
    }
    // Try where command
    let where_result = trim(nova_run("where tor 2>nul"))
    if len(where_result) > 3 {
        let lines = split(where_result, "\n")
        let first = trim(dict_get(lines, 0, ""))
        if len(first) > 3 {
            let _tor_path_found = first
            return first
        }
    }
    return ""
}

// Create torrc config file
fn tor_create_torrc() {
    let mkdir_cmd = "powershell -NoProfile -Command \"New-Item -ItemType Directory -Path '" + TOR_DATA_DIR + "' -Force | Out-Null\""
    nova_run(mkdir_cmd)
    let torrc_content = "SocksPort " + str(TOR_SOCKS_PORT) + "\n"
    let torrc_content = torrc_content + "ControlPort " + str(TOR_CONTROL_PORT) + "\n"
    let torrc_content = torrc_content + "DataDirectory " + TOR_DATA_DIR + "\n"
    let torrc_content = torrc_content + "Log notice file " + TOR_LOG + "\n"
    let torrc_content = torrc_content + "ClientOnly 1\n"
    let torrc_content = torrc_content + "NumEntryGuards 3\n"
    let torrc_content = torrc_content + "CircuitBuildTimeout 30\n"
    nova_write(TOR_CONF, torrc_content)
    return TOR_CONF
}

// Start tor process
fn tor_start() {
    let tor_path = _tor_path_found
    if len(tor_path) < 3 {
        let tor_path = tor_find()
    }
    if len(tor_path) < 3 {
        return {"ok": false, "error": "Tor not found. Install via: winget install TorProject.TorBrowser"}
    }
    tor_create_torrc()
    // Launch tor via nowindow wrapper
    let start_cmd = "powershell -NoProfile -WindowStyle Hidden -Command \"Start-Process -FilePath '" + tor_path + "' -ArgumentList '-f','" + TOR_CONF + "' -WindowStyle Hidden -PassThru | Select-Object -ExpandProperty Id\""
    let pid_result = trim(nova_run(start_cmd))
    if len(pid_result) > 0 {
        let _tor_pid = pid_result
        let _tor_status = "running"
        // Check if SOCKS port is reachable after brief wait
        let check_cmd = "powershell -NoProfile -Command \"Start-Sleep -Seconds 3; try { $c = New-Object Net.Sockets.TcpClient; $c.Connect('127.0.0.1'," + str(TOR_SOCKS_PORT) + "); $c.Close(); Write-Output 'connected' } catch { Write-Output 'bootstrapping' }\""
        let check_result = trim(nova_run(check_cmd))
        if check_result == "connected" {
            let _tor_status = "connected"
        }
        if check_result == "bootstrapping" {
            let _tor_status = "bootstrapping"
        }
        return {"ok": true, "socks_port": TOR_SOCKS_PORT, "status": _tor_status, "pid": _tor_pid}
    }
    return {"ok": false, "error": "Tor process failed to start"}
}

// Stop tor process
fn tor_stop() {
    if len(_tor_pid) > 0 {
        let kill_cmd = "powershell -NoProfile -Command \"Stop-Process -Id " + _tor_pid + " -Force -ErrorAction SilentlyContinue\""
        nova_run(kill_cmd)
    }
    // Also kill by name as fallback
    nova_run("taskkill /F /IM tor.exe 2>nul")
    let _tor_pid = ""
    let _tor_status = "stopped"
    return {"ok": true}
}

// Request new tor circuit
fn tor_new_circuit() {
    let cmd = "powershell -NoProfile -Command \"try { $c = New-Object Net.Sockets.TcpClient('127.0.0.1'," + str(TOR_CONTROL_PORT) + "); $s = $c.GetStream(); $w = New-Object IO.StreamWriter($s); $r = New-Object IO.StreamReader($s); $w.WriteLine('AUTHENTICATE \\\"\\\"'); $w.Flush(); $null = $r.ReadLine(); $w.WriteLine('SIGNAL NEWNYM'); $w.Flush(); $resp = $r.ReadLine(); $c.Close(); Write-Output $resp } catch { Write-Output 'error' }\""
    let result = trim(nova_run(cmd))
    let _tor_circuits = _tor_circuits + 1
    if contains(result, "250 OK") {
        return {"ok": true}
    }
    return {"ok": false, "error": result}
}

// Get tor status
fn tor_get_status() {
    // Check if process is running
    let check_cmd = "powershell -NoProfile -Command \"Get-Process tor -ErrorAction SilentlyContinue | Select-Object -First 1 -ExpandProperty Id\""
    let pid_result = trim(nova_run(check_cmd))
    let running = false
    if len(pid_result) > 0 {
        let running = true
        let _tor_pid = pid_result
    }
    // Check SOCKS port
    let socks_up = false
    if running == true {
        let sock_cmd = "powershell -NoProfile -Command \"try { $c = New-Object Net.Sockets.TcpClient; $c.Connect('127.0.0.1'," + str(TOR_SOCKS_PORT) + "); $c.Close(); Write-Output 'up' } catch { Write-Output 'down' }\""
        let sock_result = trim(nova_run(sock_cmd))
        if sock_result == "up" {
            let socks_up = true
        }
    }
    let status_label = "stopped"
    if socks_up == true {
        let status_label = "connected"
    }
    if running == true {
        if socks_up == false {
            let status_label = "running"
        }
    }
    let socks_port_val = 0
    if socks_up == true {
        let socks_port_val = TOR_SOCKS_PORT
    }
    let pid_val = ""
    if running == true {
        let pid_val = _tor_pid
    }
    return {
        "running": running,
        "socks_port": socks_port_val,
        "status": status_label,
        "pid": pid_val
    }
}

// ============================================================
// WIFI BRIDGE
// All adapter ops delegated to powershell/netsh via nova_run()
// ============================================================

// Scan all active network adapters
fn wifi_scan_adapters() {
    let cmd = "powershell -NoProfile -Command \"Get-NetAdapter | Where-Object {$_.Status -eq 'Up'} | Select-Object Name, InterfaceDescription, LinkSpeed, MacAddress | ConvertTo-Json -Compress\""
    let result = trim(nova_run(cmd))
    if len(result) > 2 {
        let parsed = json_decode(result)
        // Handle single adapter (powershell returns dict not list)
        let ptype = type_of(parsed)
        if ptype == "dict" {
            let _wifi_adapters = [parsed]
        }
        if ptype == "list" {
            let _wifi_adapters = parsed
        }
        wifi_calc_speed()
    }
    return _wifi_adapters
}

// Calculate bonded speed from adapters
fn wifi_calc_speed() {
    let total = 0
    let idx = 0
    let alen = len(_wifi_adapters)
    while3 idx < alen {
        let a = dict_get(_wifi_adapters, idx)
        let spd = str(dict_get(a, "LinkSpeed", "0"))
        if contains(spd, "Gbps") {
            let cleaned = replace(spd, " Gbps", "")
            let cleaned = trim(cleaned)
            let total = total + float(cleaned) * 1000
        }
        if contains(spd, "Mbps") {
            let cleaned = replace(spd, " Mbps", "")
            let cleaned = trim(cleaned)
            let total = total + float(cleaned)
        }
        let idx = idx + 1
    }
    let _wifi_bonded_speed = total
}

// Check if LBFO team already exists
fn wifi_check_team() {
    let cmd = "powershell -NoProfile -Command \"Get-NetLbfoTeam -Name '" + TEAM_NAME + "' -ErrorAction SilentlyContinue | ConvertTo-Json -Compress\""
    let result = trim(nova_run(cmd))
    if len(result) > 5 {
        let _wifi_team_active = true
        return true
    }
    let _wifi_team_active = false
    return false
}

// Get adapter speeds
fn wifi_get_speeds() {
    wifi_scan_adapters()
    wifi_check_team()
    let team_name_val = ""
    if _wifi_team_active == true {
        let team_name_val = TEAM_NAME
    }
    return {
        "adapters": _wifi_adapters,
        "bonded_speed_mbps": _wifi_bonded_speed,
        "count": len(_wifi_adapters),
        "team_active": _wifi_team_active,
        "team_name": team_name_val
    }
}

// Bond adapters using LBFO NIC teaming
fn wifi_bridge(adapter_names_str) {
    wifi_scan_adapters()
    if len(_wifi_adapters) < 2 {
        return {"ok": false, "error": "Need 2+ active adapters to bond", "adapters_found": len(_wifi_adapters)}
    }
    // Remove existing team first
    wifi_unbridge()
    // Build member list from adapters
    let members = ""
    let idx = 0
    let alen = len(_wifi_adapters)
    while3 idx < alen {
        let a = dict_get(_wifi_adapters, idx)
        let aname = dict_get(a, "Name", "")
        if len(aname) > 0 {
            if len(members) > 0 {
                let members = members + ",'" + aname + "'"
            }
            if len(members) == 0 {
                let members = "'" + aname + "'"
            }
        }
        let idx = idx + 1
    }
    // Use provided names if given
    if len(adapter_names_str) > 0 {
        let members = adapter_names_str
    }
    let ps_cmd = "powershell -NoProfile -Command \"New-NetLbfoTeam -Name '" + TEAM_NAME + "' -TeamMembers " + members + " -TeamingMode SwitchIndependent -LoadBalancingAlgorithm AddressHash -Confirm:$false\""
    let result = trim(nova_run(ps_cmd))
    if contains(lower(result), "error") {
        if contains(lower(result), "administrator") {
            return {"ok": false, "error": "Requires admin privileges. Run NovaX as Administrator."}
        }
        return {"ok": false, "error": result}
    }
    let _wifi_team_active = true
    wifi_optimize_tcp()
    return {
        "ok": true,
        "team": TEAM_NAME,
        "mode": "SwitchIndependent",
        "algorithm": "AddressHash",
        "bonded_mbps": _wifi_bonded_speed
    }
}

// Remove NIC team bond
fn wifi_unbridge() {
    let cmd = "powershell -NoProfile -Command \"Remove-NetLbfoTeam -Name '" + TEAM_NAME + "' -Confirm:$false -ErrorAction SilentlyContinue\""
    nova_run(cmd)
    let _wifi_team_active = false
    return {"ok": true, "removed": TEAM_NAME}
}

// Optimize TCP stack
fn wifi_optimize_tcp() {
    nova_run("netsh int tcp set global autotuninglevel=normal 2>nul")
    nova_run("netsh int tcp set global ecncapability=enabled 2>nul")
    nova_run("netsh int tcp set global timestamps=enabled 2>nul")
    nova_run("netsh int tcp set global rss=enabled 2>nul")
}

// Optimize routing + per-adapter settings
fn wifi_optimize_routing() {
    wifi_scan_adapters()
    let results = []
    let idx = 0
    let alen = len(_wifi_adapters)
    while3 idx < alen {
        let a = dict_get(_wifi_adapters, idx)
        let aname = dict_get(a, "Name", "")
        if len(aname) > 0 {
            let opt_cmd = "powershell -NoProfile -Command \"Set-NetAdapterAdvancedProperty -Name '" + aname + "' -RegistryKeyword '*FlowControl' -RegistryValue 0 -EA SilentlyContinue; Set-NetAdapterAdvancedProperty -Name '" + aname + "' -RegistryKeyword '*ReceiveBuffers' -RegistryValue 2048 -EA SilentlyContinue; Set-NetAdapterAdvancedProperty -Name '" + aname + "' -RegistryKeyword '*TransmitBuffers' -RegistryValue 2048 -EA SilentlyContinue\""
            nova_run(opt_cmd)
            append(results, {"adapter": aname, "ok": true})
        }
        let idx = idx + 1
    }
    wifi_optimize_tcp()
    // Auto-bond if 2+ adapters and not bonded
    let bond_result = ""
    if len(_wifi_adapters) > 1 {
        if _wifi_team_active == false {
            let bond_result = wifi_bridge("")
        }
    }
    return {
        "ok": true,
        "results": results,
        "bonded_mbps": _wifi_bonded_speed,
        "team_active": _wifi_team_active,
        "bond_result": bond_result
    }
}

// Speed test via Cloudflare
fn wifi_speed_test() {
    try3 {
        let t0 = time()
        let resp = http_get("https://speed.cloudflare.com/__down?bytes=1000000")
        let elapsed = time() - t0
        let data_len = len(resp)
        let mbps = round((data_len * 8) / (elapsed * 1000000), 2)
        let time_ms = round(elapsed * 1000)
        return {"ok": true, "download_mbps": mbps, "time_ms": time_ms}
    } else {
        return {"ok": false, "error": "Speed test failed"}
    }
}

// Scan WiFi-only adapters
fn wifi_scan_wifi_adapters() {
    let cmd = "powershell -NoProfile -Command \"Get-NetAdapter | Where-Object { $_.InterfaceDescription -match 'Wi-Fi|Wireless|802\\.11|WLAN' -or $_.Name -match 'Wi-Fi|WiFi|WLAN' } | Select-Object Name, Status, InterfaceDescription, LinkSpeed, MacAddress | ConvertTo-Json -Compress\""
    let result = trim(nova_run(cmd))
    if len(result) > 2 {
        let parsed = json_decode(result)
        let ptype = type_of(parsed)
        if ptype == "dict" {
            return [parsed]
        }
        return parsed
    }
    return []
}

// Scan visible WiFi networks
fn wifi_scan_networks() {
    let cmd = "netsh wlan show networks mode=bssid"
    let result = nova_run(cmd)
    let lowered = lower(result)
    // Check if we need fallback
    let needs_fallback = false
    if contains(lowered, "location permission") {
        let needs_fallback = true
    }
    if contains(lowered, "elevation") {
        let needs_fallback = true
    }
    if len(result) < 10 {
        let needs_fallback = true
    }
    if needs_fallback == true {
        return wifi_scan_saved_profiles()
    }
    // Parse live scan output
    let networks = []
    let lines = split(result, "\n")
    let current_ssid = ""
    let current_signal = 0
    let current_auth = ""
    let current_bssid = ""
    let idx = 0
    let lcount = len(lines)
    while3 idx < lcount {
        let line = trim(dict_get(lines, idx, ""))
        if starts_with(line, "SSID") {
            if contains(line, "BSSID") == false {
                // Save previous network
                if len(current_ssid) > 0 {
                    append(networks, {
                        "ssid": current_ssid,
                        "signal": current_signal,
                        "auth": current_auth,
                        "bssid": current_bssid
                    })
                }
                // Parse new SSID
                if contains(line, ":") {
                    let parts = split(line, ":")
                    let current_ssid = trim(dict_get(parts, 1, ""))
                }
                let current_signal = 0
                let current_auth = ""
                let current_bssid = ""
            }
        }
        if starts_with(line, "Signal") {
            if contains(line, ":") {
                let parts = split(line, ":")
                let sig_str = trim(dict_get(parts, 1, "0"))
                let sig_str = replace(sig_str, "%", "")
                let current_signal = int(trim(sig_str))
            }
        }
        if starts_with(line, "Authentication") {
            if contains(line, ":") {
                let parts = split(line, ":")
                let current_auth = trim(dict_get(parts, 1, ""))
            }
        }
        if starts_with(line, "BSSID") {
            if contains(line, ":") {
                // BSSID has multiple colons, take everything after first ':'
                let parts = split(line, ":")
                let current_bssid = trim(dict_get(parts, 1, ""))
            }
        }
        let idx = idx + 1
    }
    // Don't forget last network
    if len(current_ssid) > 0 {
        append(networks, {
            "ssid": current_ssid,
            "signal": current_signal,
            "auth": current_auth,
            "bssid": current_bssid
        })
    }
    return networks
}

// Fallback: scan saved WiFi profiles
fn wifi_scan_saved_profiles() {
    let result = nova_run("netsh wlan show profiles")
    let profiles = []
    let lines = split(result, "\n")
    let idx = 0
    let lcount = len(lines)
    while3 idx < lcount {
        let line = trim(dict_get(lines, idx, ""))
        if contains(line, "All User Profile") {
            if contains(line, ":") {
                let parts = split(line, ":")
                let ssid = trim(dict_get(parts, 1, ""))
                if len(ssid) > 0 {
                    append(profiles, {
                        "ssid": ssid,
                        "signal": -1,
                        "auth": "saved",
                        "bssid": "",
                        "source": "saved_profile"
                    })
                }
            }
        }
        if contains(line, "Current User Profile") {
            if contains(line, ":") {
                let parts = split(line, ":")
                let ssid = trim(dict_get(parts, 1, ""))
                if len(ssid) > 0 {
                    append(profiles, {
                        "ssid": ssid,
                        "signal": -1,
                        "auth": "saved",
                        "bssid": "",
                        "source": "saved_profile"
                    })
                }
            }
        }
        let idx = idx + 1
    }
    return profiles
}

// Connect a WiFi adapter to an SSID
fn wifi_connect(adapter, ssid, password) {
    // Create WPA2-PSK profile XML
    let xml = "<?xml version=\"1.0\"?>\n"
    let xml = xml + "<WLANProfile xmlns=\"http://www.microsoft.com/networking/WLAN/profile/v1\">\n"
    let xml = xml + "  <name>" + ssid + "</name>\n"
    let xml = xml + "  <SSIDConfig><SSID><name>" + ssid + "</name></SSID></SSIDConfig>\n"
    let xml = xml + "  <connectionType>ESS</connectionType>\n"
    let xml = xml + "  <connectionMode>manual</connectionMode>\n"
    let xml = xml + "  <MSM><security>\n"
    let xml = xml + "    <authEncryption><authentication>WPA2PSK</authentication><encryption>AES</encryption><useOneX>false</useOneX></authEncryption>\n"
    let xml = xml + "    <sharedKey><keyType>passPhrase</keyType><protected>false</protected><keyMaterial>" + password + "</keyMaterial></sharedKey>\n"
    let xml = xml + "  </security></MSM>\n"
    let xml = xml + "</WLANProfile>"
    // Write temp profile
    let prof_path = "C:\\NovaX\\temp_wifi_" + sha256(ssid) + ".xml"
    nova_write(prof_path, xml)
    // Add profile
    nova_run("netsh wlan add profile filename=" + prof_path + " interface=" + adapter + " 2>nul")
    // Connect
    let connect_result = nova_run("netsh wlan connect name=" + ssid + " interface=" + adapter)
    // Cleanup temp file
    nova_run("del \"" + prof_path + "\" 2>nul")
    let ok_val = false
    if contains(lower(connect_result), "completed successfully") {
        let ok_val = true
    }
    return {"ok": ok_val, "adapter": adapter, "ssid": ssid, "message": trim(connect_result)}
}

// Disconnect a WiFi adapter
fn wifi_disconnect(adapter) {
    let result = nova_run("netsh wlan disconnect interface=" + adapter)
    return {"ok": true, "adapter": adapter, "message": trim(result)}
}

// Get throughput byte counters
fn wifi_get_throughput() {
    let cmd = "powershell -NoProfile -Command \"Get-NetAdapterStatistics | Select-Object Name, ReceivedBytes, SentBytes | ConvertTo-Json -Compress\""
    let result = trim(nova_run(cmd))
    if len(result) > 2 {
        let parsed = json_decode(result)
        let ptype = type_of(parsed)
        let adapters_list = []
        if ptype == "dict" {
            let adapters_list = [parsed]
        }
        if ptype == "list" {
            let adapters_list = parsed
        }
        return {"ok": true, "timestamp": time(), "adapters": adapters_list}
    }
    return {"ok": true, "timestamp": time(), "adapters": []}
}

// Get connection status per WiFi interface
fn wifi_get_connection_status() {
    // Try netsh first
    let result = nova_run("netsh wlan show interfaces")
    let lowered = lower(result)
    let needs_fallback = false
    if contains(lowered, "location permission") {
        let needs_fallback = true
    }
    if contains(lowered, "elevation") {
        let needs_fallback = true
    }
    if len(result) < 10 {
        let needs_fallback = true
    }
    if needs_fallback == false {
        let interfaces = []
        let lines = split(result, "\n")
        let cur_name = ""
        let cur_ssid = ""
        let cur_state = ""
        let cur_signal = ""
        let cur_rx = ""
        let cur_tx = ""
        let idx = 0
        let lcount = len(lines)
        while3 idx < lcount {
            let line = trim(dict_get(lines, idx, ""))
            if starts_with(line, "Name") {
                if len(cur_name) > 0 {
                    append(interfaces, {
                        "name": cur_name, "ssid": cur_ssid,
                        "state": cur_state, "signal": cur_signal,
                        "rx_rate": cur_rx, "tx_rate": cur_tx
                    })
                }
                if contains(line, ":") {
                    let parts = split(line, ":")
                    let cur_name = trim(dict_get(parts, 1, ""))
                }
                let cur_ssid = ""
                let cur_state = ""
                let cur_signal = ""
                let cur_rx = ""
                let cur_tx = ""
            }
            if starts_with(line, "SSID") {
                if contains(line, "BSSID") == false {
                    if contains(line, ":") {
                        let parts = split(line, ":")
                        let cur_ssid = trim(dict_get(parts, 1, ""))
                    }
                }
            }
            if starts_with(line, "State") {
                if contains(line, ":") {
                    let parts = split(line, ":")
                    let cur_state = trim(dict_get(parts, 1, ""))
                }
            }
            if starts_with(line, "Signal") {
                if contains(line, ":") {
                    let parts = split(line, ":")
                    let cur_signal = trim(dict_get(parts, 1, ""))
                }
            }
            if starts_with(line, "Receive rate") {
                if contains(line, ":") {
                    let parts = split(line, ":")
                    let cur_rx = trim(dict_get(parts, 1, ""))
                }
            }
            if starts_with(line, "Transmit rate") {
                if contains(line, ":") {
                    let parts = split(line, ":")
                    let cur_tx = trim(dict_get(parts, 1, ""))
                }
            }
            let idx = idx + 1
        }
        if len(cur_name) > 0 {
            append(interfaces, {
                "name": cur_name, "ssid": cur_ssid,
                "state": cur_state, "signal": cur_signal,
                "rx_rate": cur_rx, "tx_rate": cur_tx
            })
        }
        if len(interfaces) > 0 {
            return {"ok": true, "interfaces": interfaces}
        }
    }
    // Fallback: PowerShell Get-NetConnectionProfile
    let ps_cmd = "powershell -NoProfile -Command \"Get-NetConnectionProfile | Select-Object Name, InterfaceAlias, IPv4Connectivity | ConvertTo-Json -Compress\""
    let ps_result = trim(nova_run(ps_cmd))
    if len(ps_result) > 5 {
        let parsed = json_decode(ps_result)
        let ptype = type_of(parsed)
        let profiles = []
        if ptype == "dict" {
            let profiles = [parsed]
        }
        if ptype == "list" {
            let profiles = parsed
        }
        let fallback_ifaces = []
        let idx = 0
        let plen = len(profiles)
        while3 idx < plen {
            let p = dict_get(profiles, idx)
            let iface = dict_get(p, "InterfaceAlias", "")
            let iface_low = lower(iface)
            // Skip virtual/VPN adapters
            let skip = false
            if contains(iface_low, "nordlynx") { let skip = true }
            if contains(iface_low, "tap-") { let skip = true }
            if contains(iface_low, "openvpn") { let skip = true }
            if contains(iface_low, "bluetooth") { let skip = true }
            if contains(iface_low, "loopback") { let skip = true }
            if skip == false {
                let conn_val = dict_get(p, "IPv4Connectivity", 0)
                let state_str = "limited"
                if conn_val == 4 {
                    let state_str = "connected"
                }
                append(fallback_ifaces, {
                    "name": iface,
                    "ssid": dict_get(p, "Name", "Unknown"),
                    "state": state_str,
                    "signal": "N/A"
                })
            }
            let idx = idx + 1
        }
        return {"ok": true, "interfaces": fallback_ifaces}
    }
    return {"ok": true, "interfaces": []}
}

// ============================================================
// TERNARY BRIDGE -- Software-Defined Dual-ISP Bonding
// Time-Division Multiplexing on single adapter
// States: +1 (network A), 0 (switching), -1 (network B)
// ============================================================

// Configure ternary bridge SSIDs
fn tbridge_configure(ssid_a, ssid_b, adapter) {
    let _tb_ssid_a = ssid_a
    let _tb_ssid_b = ssid_b
    if len(adapter) > 0 {
        let _tb_adapter_name = adapter
    }
    return {"ok": true, "ssid_a": ssid_a, "ssid_b": ssid_b, "adapter": _tb_adapter_name, "state": "configured"}
}

// Detect current SSID (no admin needed)
fn tbridge_detect_ssid() {
    let cmd = "powershell -NoProfile -Command \"Get-NetConnectionProfile -InterfaceAlias 'Wi-Fi' -EA SilentlyContinue | Select-Object -ExpandProperty Name\""
    let result = trim(nova_run(cmd))
    if len(result) > 0 {
        return result
    }
    return ""
}

// Switch adapter to a specific SSID
fn tbridge_switch_to(ssid) {
    let prev_state = _tb_state
    let _tb_state = 0
    let t0 = time()
    // Disconnect first
    nova_run("netsh wlan disconnect interface=" + _tb_adapter_name + " 2>nul")
    // Brief pause
    nova_run("powershell -NoProfile -Command \"Start-Sleep -Milliseconds 1000\"")
    // Connect to target
    nova_run("netsh wlan connect name=" + ssid + " interface=" + _tb_adapter_name + " 2>nul")
    // Wait for WPA2 association (up to H13 retries, 1s each)
    let connected = false
    let attempt = 0
    while3 attempt < H13 {
        nova_run("powershell -NoProfile -Command \"Start-Sleep -Seconds 1\"")
        let current = tbridge_detect_ssid()
        if current == ssid {
            let connected = true
            let attempt = H13
        }
        let attempt = attempt + 1
    }
    let elapsed = time() - t0
    if connected == true {
        let _tb_current_ssid = ssid
        if ssid == _tb_ssid_a {
            let _tb_state = 1
        }
        if ssid == _tb_ssid_b {
            let _tb_state = -1
        }
        let _tb_switch_count = _tb_switch_count + 1
        append(_tb_switch_times, elapsed)
        // Keep last H13 switch times
        if len(_tb_switch_times) > H13 {
            let _tb_switch_times = slice(_tb_switch_times, len(_tb_switch_times) - H13, len(_tb_switch_times))
        }
        return {"ok": true, "ssid": ssid, "state": _tb_state, "switch_time_ms": round(elapsed * 1000)}
    }
    let _tb_state = prev_state
    return {"ok": false, "ssid": ssid, "state": _tb_state, "switch_time_ms": round(elapsed * 1000), "error": "Failed to associate"}
}

// Start ternary bridge
fn tbridge_start() {
    if len(_tb_ssid_a) < 1 {
        return {"ok": false, "error": "Configure both SSIDs first", "hint": "POST /n/tbridge/configure {ssid_a, ssid_b}"}
    }
    if len(_tb_ssid_b) < 1 {
        return {"ok": false, "error": "Configure both SSIDs first", "hint": "POST /n/tbridge/configure {ssid_a, ssid_b}"}
    }
    let _tb_active = true
    let _tb_start_time = time()
    let _tb_switch_count = 0
    let _tb_bytes_on_a = 0
    let _tb_bytes_on_b = 0
    // Detect current network
    let _tb_current_ssid = tbridge_detect_ssid()
    if _tb_current_ssid == _tb_ssid_a {
        let _tb_state = 1
    }
    if _tb_current_ssid == _tb_ssid_b {
        let _tb_state = -1
    }
    if _tb_current_ssid != _tb_ssid_a {
        if _tb_current_ssid != _tb_ssid_b {
            tbridge_switch_to(_tb_ssid_a)
            let _tb_state = 1
        }
    }
    return {
        "ok": true,
        "active": true,
        "state": _tb_state,
        "current_ssid": _tb_current_ssid,
        "ssid_a": _tb_ssid_a,
        "ssid_b": _tb_ssid_b
    }
}

// Stop ternary bridge
fn tbridge_stop() {
    let _tb_active = false
    return {
        "ok": true,
        "active": false,
        "stayed_on": _tb_current_ssid,
        "total_switches": _tb_switch_count,
        "bytes_a": _tb_bytes_on_a,
        "bytes_b": _tb_bytes_on_b
    }
}

// Force network switch
fn tbridge_switch_now() {
    if _tb_active == false {
        return {"ok": false, "error": "Bridge not active"}
    }
    let target = _tb_ssid_b
    if _tb_state != 1 {
        let target = _tb_ssid_a
    }
    return tbridge_switch_to(target)
}

// Schedule download segments across both networks
fn tbridge_schedule_segments(total_segs) {
    let n = total_segs
    if n < 1 {
        let n = H7
    }
    let n_on_a = 0
    if _tb_speed_a > 0 {
        if _tb_speed_b > 0 {
            let ratio_a = _tb_speed_a / (_tb_speed_a + _tb_speed_b)
            let n_on_a = round(n * ratio_a)
            if n_on_a < 1 { let n_on_a = 1 }
            if n_on_a > n - 1 { let n_on_a = n - 1 }
        }
    }
    if n_on_a == 0 {
        let n_on_a = round((n + 1) / 2)
    }
    let n_on_b = n - n_on_a
    let schedule = []
    let i = 0
    while3 i < n {
        if i < n_on_a {
            append(schedule, {"segment": i, "network": 1, "ssid": _tb_ssid_a})
        }
        if i >= n_on_a {
            append(schedule, {"segment": i, "network": -1, "ssid": _tb_ssid_b})
        }
        let i = i + 1
    }
    return {
        "ok": true,
        "total": n,
        "on_a": n_on_a,
        "on_b": n_on_b,
        "ratio_a": round(n_on_a / n, 3),
        "schedule": schedule
    }
}

// Report measured speed for a network
fn tbridge_report_speed(network_state, bytes_dl, elapsed_sec) {
    if elapsed_sec <= 0 {
        return {"ok": false, "error": "elapsed must be > 0"}
    }
    let speed_mbps = (bytes_dl * 8) / (elapsed_sec * 1000000)
    if network_state == 1 {
        let _tb_speed_a = speed_mbps
        let _tb_bytes_on_a = _tb_bytes_on_a + bytes_dl
    }
    if network_state == -1 {
        let _tb_speed_b = speed_mbps
        let _tb_bytes_on_b = _tb_bytes_on_b + bytes_dl
    }
    return {"ok": true}
}

// Quick speed test (1MB from Cloudflare)
fn tbridge_quick_speed_test() {
    try3 {
        let t0 = time()
        let resp = http_get("https://speed.cloudflare.com/__down?bytes=1000000")
        let elapsed = time() - t0
        let data_len = len(resp)
        let mbps = round((data_len * 8) / (elapsed * 1000000), 2)
        return {"ok": true, "mbps": mbps, "bytes": data_len, "time_ms": round(elapsed * 1000)}
    } else {
        return {"ok": false, "mbps": 0, "error": "Speed test failed"}
    }
}

// Probe both networks sequentially
fn tbridge_probe_both() {
    let result_a = {"ok": false, "mbps": 0}
    let result_b = {"ok": false, "mbps": 0}
    let orig_ssid = _tb_current_ssid
    if len(orig_ssid) < 1 {
        let orig_ssid = tbridge_detect_ssid()
    }
    // Test current network first
    let speed_current = tbridge_quick_speed_test()
    if orig_ssid == _tb_ssid_a {
        let result_a = speed_current
        let sw = tbridge_switch_to(_tb_ssid_b)
        let sw_ok = dict_get(sw, "ok", false)
        if sw_ok == true {
            let result_b = tbridge_quick_speed_test()
            tbridge_switch_to(_tb_ssid_a)
        }
    }
    if orig_ssid != _tb_ssid_a {
        let result_b = speed_current
        let sw = tbridge_switch_to(_tb_ssid_a)
        let sw_ok = dict_get(sw, "ok", false)
        if sw_ok == true {
            let result_a = tbridge_quick_speed_test()
            tbridge_switch_to(_tb_ssid_b)
        }
    }
    let mbps_a = dict_get(result_a, "mbps", 0)
    let mbps_b = dict_get(result_b, "mbps", 0)
    let combined = mbps_a + mbps_b
    // Reynolds classification on combined speed
    let regime = "laminar"
    if combined >= RE_LAMINAR {
        let regime = "transitional"
    }
    if combined >= RE_TRANSITION {
        let regime = "turbulent"
    }
    if combined >= RE_TURBULENT {
        let regime = "chaotic"
    }
    let _tb_speed_a = mbps_a
    let _tb_speed_b = mbps_b
    return {
        "ok": true,
        "network_a": {"ssid": _tb_ssid_a, "mbps": mbps_a},
        "network_b": {"ssid": _tb_ssid_b, "mbps": mbps_b},
        "combined_mbps": round(combined, 2),
        "reynolds": round(combined, 2),
        "regime": regime
    }
}

// Average switch time from history
fn tbridge_avg_switch_ms() {
    let tlen = len(_tb_switch_times)
    if tlen < 1 {
        return 3000
    }
    let total = 0
    let idx = 0
    while3 idx < tlen {
        let total = total + dict_get(_tb_switch_times, idx, 0)
        let idx = idx + 1
    }
    return round((total / tlen) * 1000)
}

// Full ternary bridge status
fn tbridge_status() {
    let uptime_val = 0
    if _tb_active == true {
        let uptime_val = time() - _tb_start_time
    }
    let state_label = "unknown"
    if _tb_state == 1 { let state_label = "network_a" }
    if _tb_state == 0 { let state_label = "switching" }
    if _tb_state == -1 { let state_label = "network_b" }
    let total_bytes = _tb_bytes_on_a + _tb_bytes_on_b
    return {
        "ok": true,
        "active": _tb_active,
        "state": _tb_state,
        "state_label": state_label,
        "ssid_a": _tb_ssid_a,
        "ssid_b": _tb_ssid_b,
        "current_ssid": _tb_current_ssid,
        "speed_a_mbps": round(_tb_speed_a, 2),
        "speed_b_mbps": round(_tb_speed_b, 2),
        "combined_mbps": round(_tb_speed_a + _tb_speed_b, 2),
        "bytes_on_a": _tb_bytes_on_a,
        "bytes_on_b": _tb_bytes_on_b,
        "total_bytes": total_bytes,
        "switch_count": _tb_switch_count,
        "avg_switch_ms": tbridge_avg_switch_ms(),
        "uptime_s": round(uptime_val),
        "harmonics": "3-5-7-13"
    }
}

// ============================================================
// SERVER HEALTH CHECK (sequential, no threading)
// ============================================================
fn check_server(key) {
    let srv = dict_get(SERVERS, key, {})
    let srv_port = dict_get(srv, "port", 0)
    let srv_name = dict_get(srv, "name", key)
    let url = "http://127.0.0.1:" + str(srv_port) + "/"
    try3 {
        let resp = http_get(url)
        return {"name": srv_name, "port": srv_port, "status": "online"}
    } else {
        return {"name": srv_name, "port": srv_port, "status": "offline"}
    }
}

fn check_all_servers() {
    let result = {}
    let server_keys = keys(SERVERS)
    let idx = 0
    let klen = len(server_keys)
    while3 idx < klen {
        let k = dict_get(server_keys, idx)
        let srv_result = check_server(k)
        dict_set(result, k, srv_result)
        let idx = idx + 1
    }
    return result
}

// ============================================================
// ROUTE HANDLERS -- GET
// ============================================================

// GET / or /n or /n/dashboard -- HTML dashboard
fn handle_dashboard(body) {
    // Return a simple status JSON since HTML dashboard is large
    // The full HTML dashboard is served by the Python version
    return {
        "server": "NovaX VPN Core",
        "version": VERSION,
        "port": PORT,
        "ternary": true,
        "dashboard": "NovaLang port -- use Python version for full HTML dashboard",
        "endpoints": {
            "status": "/n/status",
            "health": "/health",
            "tor": "/n/tor/status",
            "wifi": "/n/wifi/speeds",
            "tbridge": "/n/tbridge/status",
            "crypto_test": "/n/crypto/test"
        }
    }
}

// GET /health
fn handle_health(body) {
    let _requests = _requests + 1
    let uptime = round(time() - _t0)
    let nq_trit = net_quality_trit(_wifi_bonded_speed)
    let enc_trit = T_TRUE
    let tor_info = tor_get_status()
    let tor_on = dict_get(tor_info, "running", false)
    let trits = [nq_trit, enc_trit]
    if tor_on == true {
        append(trits, T_TRUE)
    }
    let overall = list_min(trits)
    return {
        "server": "NovaX VPN Core",
        "version": VERSION,
        "port": PORT,
        "ternary": true,
        "harmonics": {"H3": H3, "H5": H5, "H7": H7, "H13": H13},
        "encryption": "5-layer",
        "uptime_seconds": uptime,
        "net_quality_trit": nq_trit,
        "encryption_trit": enc_trit,
        "overall_trit": overall,
        "overall_char": trit_char(overall),
        "wifi_mbps": _wifi_bonded_speed
    }
}

// GET /n/status
fn handle_status(body) {
    let _requests = _requests + 1
    let nq_trit = net_quality_trit(_wifi_bonded_speed)
    let tor_info = tor_get_status()
    return {
        "server": "NovaX VPN Core",
        "version": VERSION,
        "port": PORT,
        "ternary": true,
        "harmonics": {"H3": H3, "H5": H5, "H7": H7, "H13": H13},
        "encryption": "5-layer",
        "requests": _requests,
        "bytes_encrypted": _bytes_encrypted,
        "key_rotations": _key_rotations,
        "uptime_seconds": round(time() - _t0),
        "tor": tor_info,
        "wifi_mbps": _wifi_bonded_speed,
        "net_quality_trit": nq_trit,
        "net_quality_char": trit_char(nq_trit)
    }
}

