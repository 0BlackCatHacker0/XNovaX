// GET /n/crypto/test
fn handle_crypto_test(body) {
    let _requests = _requests + 1
    try3 {
        let test_data = "NovaX VPN test " + str(uuid_hex())
        let t0 = time()
        let enc = crypto_encrypt(test_data)
        let enc_time = round((time() - t0) * 1000, 2)
        let _bytes_encrypted = _bytes_encrypted + len(test_data)
        return {
            "ok": true,
            "time_ms": enc_time,
            "original_len": len(test_data),
            "encrypted_len": len(enc),
            "layers": "AES-256-GCM + ChaCha20 + Serpent + Shuffle + HMAC (delegated)"
    } else {
        return {"ok": false, "error": "Encryption test failed"}
    }
}

