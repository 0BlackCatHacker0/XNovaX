// POST /n/encrypt
fn handle_encrypt(body) {
    let _requests = _requests + 1
    let data = dict_get(body, "data", "")
    if len(data) < 1 {
        return {"ok": false, "error": "No data provided"}
    }
    try3 {
        let enc = crypto_encrypt(data)
        let _bytes_encrypted = _bytes_encrypted + len(data)
        let _encrypted_ops = _encrypted_ops + 1
        return {"ok": true, "encrypted": enc}
    } else {
        return {"ok": false, "error": "Encryption failed"}
    }
}

// POST /n/decrypt
fn handle_decrypt(body) {
    let _requests = _requests + 1
    let data = dict_get(body, "data", "")
    if len(data) < 1 {
        return {"ok": false, "error": "No data provided"}
    }
    try3 {
        let dec = crypto_decrypt(data)
        let _decrypted_ops = _decrypted_ops + 1
        return {"ok": true, "decrypted": dec}
    } else {
        return {"ok": false, "error": "Decryption failed"}
    }
}

// POST /n/proxy -- encrypted proxy to internal servers
fn handle_proxy(body) {
    let _requests = _requests + 1
    let srv_key = dict_get(body, "server", "")
    let ep = dict_get(body, "path", "/")
    let method = dict_get(body, "method", "GET")
    if dict_has(SERVERS, srv_key) == false {
        return {"ok": false, "error": "Unknown server"}
    }
    let srv = dict_get(SERVERS, srv_key, {})
    let srv_port = dict_get(srv, "port", 0)
    let url = "http://127.0.0.1:" + str(srv_port) + ep
    try3 {
        let proxy_body = dict_get(body, "body", "")
        let result = ""
        if method == "GET" {
            let result = http_get(url)
        }
        if method == "POST" {
            let post_data = ""
            if len(str(proxy_body)) > 0 {
                let post_data = json_encode(proxy_body)
            }
            let result = http_post(url, post_data)
        }
        let enc = crypto_encrypt(result)
        let _bytes_encrypted = _bytes_encrypted + len(result)
        return {"ok": true, "data": enc}
    } else {
        return {"ok": false, "error": "Proxy request failed"}
    }
}

