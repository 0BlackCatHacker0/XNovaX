// nova_vpn_core_service.nova -- NovaX VPN Core v3.0 (NovaLang Port)
// Port 9880 | Pure NovaLang port of nova_vpn_core.py
//
// Architecture (NovaLang-compatible):
//   - 5-layer encryption delegated to nova_run("python vpn_helper.py ...")
//   - Tor SOCKS5 proxy management via nova_run() subprocess
//   - WiFi NIC bonding via nova_run("netsh ...") / nova_run("powershell ...")
//   - TernaryBridge dual-ISP bonding on single adapter
//   - All threading replaced with sequential on-demand POST endpoints
//   - No class/import/def/for -- flat fns with globals
//
// Ternary states:
//   +1 (T_TRUE)  = verified / connected / success
//    0 (T_MAYBE) = encrypted but unverified / partial / switching
//   -1 (T_FALSE) = failed / offline / error
//
// 3-5-7-13 Harmonic Constants:
//   H3=3  H5=5  H7=7  H13=13
//   BLOCK = 3^7 = 2187
//   RE boundaries: 27 (laminar) / 125 (transitional) / 343 (turbulent)
//
// Endpoints -- GET:
//   /                       -- HTML dashboard
//   /health                 -- health check with ternary trits
//   /n/status               -- full service status
//   /n/servers              -- server registry check (sequential)
//   /n/tor/status           -- tor process status
//   /n/wifi/speeds          -- adapter speeds + bond info
//   /n/wifi/speedtest       -- cloudflare speed test
//   /n/wifi/adapters        -- wifi adapter list
//   /n/wifi/scan            -- visible wifi networks
//   /n/wifi/throughput      -- byte counters per adapter
//   /n/wifi/connections     -- connected SSID per interface
//   /n/tbridge/status       -- ternary bridge status
//   /n/tbridge/schedule     -- segment schedule for dual-ISP
//   /n/crypto/test          -- encrypt/decrypt round-trip test
//
// Endpoints -- POST:
//   /n/tor/start            -- start tor process
//   /n/tor/stop             -- stop tor process
//   /n/tor/new-circuit      -- request new tor circuit
//   /n/wifi/optimize        -- optimize TCP + adapters
//   /n/wifi/bridge          -- bond adapters (LBFO)
//   /n/wifi/unbridge        -- remove adapter bond
//   /n/wifi/connect         -- connect wifi to SSID
//   /n/wifi/disconnect      -- disconnect wifi adapter
//   /n/tbridge/configure    -- configure dual-ISP SSIDs
//   /n/tbridge/start        -- activate ternary bridge
//   /n/tbridge/stop         -- deactivate ternary bridge
//   /n/tbridge/switch       -- force network switch
//   /n/tbridge/probe        -- speed test both networks
//   /n/tbridge/report       -- report speed measurement
//   /n/crypto/rotate        -- rotate encryption keys
//   /n/encrypt              -- encrypt data (5-layer)
//   /n/decrypt              -- decrypt data (5-layer)
//   /n/proxy                -- encrypted proxy to internal servers

// ============================================================
// Port, version, server
// ============================================================
let PORT = 9880
let VERSION = "3.0"
let SERVICE = "nova-vpn-core"

let server = tserve(PORT, "NovaX VPN Core v3.0 - 5-Layer Encryption + Tor + WiFi Bridge")

// ============================================================
// 3-5-7-13 Harmonic Constants
// ============================================================
let H3 = 3
let H5 = 5
let H7 = 7
let H13 = 13
let BLOCK = 2187

// ============================================================
// Ternary state symbols
// ============================================================
let T_TRUE  =  1
let T_MAYBE =  0
let T_FALSE = -1

// ============================================================
// Reynolds boundaries (N-S flow routing)
// ============================================================
let RE_LAMINAR    = 27
let RE_TRANSITION = 125
let RE_TURBULENT  = 343

// ============================================================
// Tor config
// ============================================================
let TOR_SOCKS_PORT = 9050
let TOR_CONTROL_PORT = 9051
let TOR_PATHS = [
    "C:\\NovaX\\tor\\tor.exe",
    "C:\\Program Files\\Tor Browser\\Browser\\TorBrowser\\Tor\\tor.exe",
    "C:\\Program Files (x86)\\Tor Browser\\Browser\\TorBrowser\\Tor\\tor.exe"
]
let TOR_DATA_DIR = "C:\\NovaX\\tor\\data"
let TOR_CONF = "C:\\NovaX\\tor\\torrc"
let TOR_LOG = "C:\\NovaX\\tor\\tor.log"

// ============================================================
// WiFi Bridge constants
// ============================================================
let TEAM_NAME = "NovaXBond"

// ============================================================
// Server registry
// ============================================================
let SERVERS = {
    "bridge":   {"port": 9999, "name": "Nova Bridge"},
    "brain":    {"port": 9990, "name": "Nova Brain"},
    "ws":       {"port": 9998, "name": "WebSocket"},
    "ui":       {"port": 9997, "name": "Nova UI"},
    "ollama":   {"port": 11434, "name": "Ollama"},
    "voice":    {"port": 9876, "name": "Nova Voice"},
    "relay":    {"port": 9877, "name": "Nova Relay"},
    "cloud":    {"port": 9878, "name": "Cloud Router"},
    "hivemind": {"port": 9881, "name": "Hive Mind"},
    "whisper":  {"port": 9879, "name": "Whisper STT"},
    "vpn":      {"port": 9880, "name": "VPN Core"}
}

// ============================================================
// Global mutable state
// ============================================================
let _t0 = time()

// -- Stats --
let _requests = 0
let _encrypted_ops = 0
let _decrypted_ops = 0
let _bytes_encrypted = 0
let _key_rotations = 0
let _tor_circuits = 0

// -- Tor state --
let _tor_status = "stopped"
let _tor_pid = ""
let _tor_path_found = ""

// -- WiFi state --
let _wifi_adapters = []
let _wifi_bonded_speed = 0
