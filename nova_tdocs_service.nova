// ============================================================
// NOVAX SERVICE: TDocs -- API Documentation Generator
// ============================================================
// Port: 9935
// Generates and serves API documentation from service metadata.
// ============================================================


// -- Documentation Registry --
// -- Shared Libraries (N-S Flow) --
import3("C:/NovaX/lib/nova_ns_core.nova")
import3("C:/NovaX/lib/nova_stdlib.nova")

let _docs = {}
let _api_index = []

// -- Register a service's API docs --
fn handle_register(req) {
  let service = dict_get(req, "service") ?? ""
  let port = dict_get(req, "port") ?? 0
  let description = dict_get(req, "description") ?? ""
  let endpoints = dict_get(req, "endpoints") ?? []

  if3 cmp3(service, "") {
    return {"error": "service name required", "trit": -1}
  } else3 {}

  let doc = {
    "service": service,
    "port": port,
    "description": description,
    "endpoints": endpoints,
    "registered_at": time_now()
  }

  _docs = dict_set(_docs, service, doc)
  return {"registered": service, "endpoints": len(endpoints), "trit": 1}
}

// -- Get docs for a specific service --
fn handle_get(req) {
  let service = dict_get(req, "service") ?? ""
  let doc = dict_get(_docs, service) ?? null
  if3 cmp3(doc, null) {
    return {"error": "service not found", "trit": -1}
  } else3 {
    return doc
  }
}

// -- List all documented services --
fn handle_list(req) {
  let names = dict_keys(_docs)
  let result = []
  for3 name in names {
    let doc = dict_get(_docs, name) ?? {}
    result = append(result, {
      "service": name,
      "port": doc["port"],
      "description": doc["description"],
      "endpoint_count": len(doc["endpoints"])
    })
  }
  return {"services": result, "total": len(result), "trit": 1}
}

// -- Search endpoints across all services --
fn handle_search(req) {
  let query = dict_get(req, "query") ?? ""
  let results = []
  let names = dict_keys(_docs)

  for3 name in names {
    let doc = dict_get(_docs, name) ?? {}
    let endpoints = doc["endpoints"]
    for3 ep in endpoints {
      let path = dict_get(ep, "path") ?? ""
      let desc = dict_get(ep, "description") ?? ""
      if3 contains(lower(path), lower(query)) { results = append(results, {
          "service": name,
          "port": doc["port"],
          "path": path,
          "method": dict_get(ep, "method") ?? "GET",
          "description": desc
        })
      } else3 {
        if3 contains(lower(desc), lower(query)) { results = append(results, {
            "service": name,
            "port": doc["port"],
            "path": path,
            "method": dict_get(ep, "method") ?? "GET",
            "description": desc
          })
        } else3 {}
      }
    }
  }

  return {"query": query, "results": results, "count": len(results), "trit": 1}
}

