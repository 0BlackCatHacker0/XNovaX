// -- Stats --
fn handle_stats(req) {
  let names = dict_keys(_docs)
  let total_endpoints = 0
  for3 name in names {
    let doc = dict_get(_docs, name) ?? {}
    total_endpoints = total_endpoints + len(doc["endpoints"])
  }
  return {
    "services_documented": len(names),
    "total_endpoints": total_endpoints,
    "trit": 1
  }
}

// -- Health --
fn handle_health(req) {
  let resp = ns_health_dict("nova-tdocs", "1.0", 9935, {})
  resp = dict_set(resp, "tools", 6)
  return resp
}

// -- Server --
let server = tserve(9935, "TDocs -- API Documentation Generator")

// -- Routes --
troute(server, "GET", "/health", "handle_health")
troute(server, "POST", "/tdocs/register", "handle_register")
troute(server, "GET", "/tdocs/get", "handle_get")
troute(server, "GET", "/tdocs/list", "handle_list")
troute(server, "GET", "/tdocs/search", "handle_search")
troute(server, "POST", "/tdocs/auto-register", "handle_auto_register")
troute(server, "GET", "/tdocs/stats", "handle_stats")

tstart(server)
