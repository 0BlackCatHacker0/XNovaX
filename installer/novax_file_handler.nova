// novax_file_handler.nova -- Opens files/folders via NovaX Desktop
// Usage: novalang novax_file_handler.nova [--ask|--dir] <path>

let args = sys_args()
if3 len(args) < 2 {
    exit(0)
}

let mode = "open"
let path = args[len(args) - 1]

if3 list_contains(args, "--ask") {
    let mode = "ask"
} else3 if3 list_contains(args, "--dir") {
    let mode = "dir"
}

let encoded = url_encode(path)

let url = ""
if3 mode == "ask" {
    let url = "http://127.0.0.1:9999/nova_desktop.html#ask=" + encoded
} else3 if3 mode == "dir" {
    let url = "http://127.0.0.1:9999/nova_desktop.html#files=" + encoded
} else3 {
    let url = "http://127.0.0.1:9999/nova_desktop.html#open=" + encoded
}

shell("cmd /c start \"\" \"" + url + "\"")
