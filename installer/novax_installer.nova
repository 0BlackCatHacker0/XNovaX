// novax_installer.nova -- NovaX Enterprise Installer (Pure NovaLang)
// One-command setup: checks dependencies, initializes memory stores,
// validates all modules and services.
//
// Usage:
//   novalang novax_installer.nova              (full install)
//   novalang novax_installer.nova --check      (verify only)

let NOVAX_ROOT = "C:\\NovaX"

let CORE_DEPS = ["flask", "flask-cors", "flask-socketio", "requests"]
let EXTENDED_DEPS = ["xrpl-py", "SpeechRecognition", "pyttsx3", "anthropic"]

let REQUIRED_DIRS = [
    NOVAX_ROOT + "\\memory", NOVAX_ROOT + "\\memory\\profiles",
    NOVAX_ROOT + "\\modules", NOVAX_ROOT + "\\installer",
    NOVAX_ROOT + "\\web", NOVAX_ROOT + "\\web\\assets",
    NOVAX_ROOT + "\\core", NOVAX_ROOT + "\\servers"
]

let CORE_NOVA_FILES = [
    "core/orchestrator.nova", "core/task_classifier.nova",
    "core/ai_router.nova", "core/hive_mind.nova",
    "core/route_validator.nova", "core/patch_dispatch.nova"
]

let WEB_FILES = ["web/hivemind.html", "web/nova_desktop.html"]

fn3 step(msg, status) {
    let icons = {"ok": "[OK]", "fail": "[!!]", "skip": "[--]", "...": "[..]", "warn": "[??]"}
    let icon = dict_get(icons, status) ?? status
    print("  " + pad_right(icon, 6) + "  " + msg)
}

fn3 banner() {
    print("")
    print("  +=============================================+")
    print("  |     N O V A X                               |")
    print("  |     Personal AI Operating System            |")
    print("  |     Installer v3.0 (Pure NovaLang)          |")
    print("  +=============================================+")
    print("")
}

fn3 check_directories() {
    let created = 0
    for3 d in REQUIRED_DIRS {
        let exists = shell("powershell -Command \"Test-Path '" + d + "'\"")
        if3 trim(exists) != "True" {
            shell("powershell -Command \"New-Item -ItemType Directory -Path '" + d + "' -Force | Out-Null\"")
            let created = created + 1
        }
    }
    step("Directories verified (" + to_str(created) + " created)", "ok")
    return +1
}

fn3 install_deps() {
    let all_deps = CORE_DEPS
    for3 d in EXTENDED_DEPS {
        let all_deps = append(all_deps, d)
    }
    let installed = 0
    let failed = []
    for3 pkg in all_deps {
        let result = shell("C:\\NovaX\\ai_env\\Scripts\\pip.exe install " + pkg + " --quiet 2>&1")
        if3 contains(result, "ERROR") {
            let failed = append(failed, pkg)
        } else3 {
            let installed = installed + 1
        }
    }
    if3 len(failed) > 0 {
        step("Dependencies: " + to_str(installed) + " installed, " + to_str(len(failed)) + " failed", "warn")
    } else3 {
        step("All " + to_str(installed) + " dependencies installed", "ok")
    }
    return {"installed": installed, "failed": failed}
}

fn3 check_nova_files() {
    let missing = []
    for3 f in CORE_NOVA_FILES {
        let path = NOVAX_ROOT + "\\" + replace(f, "/", "\\")
        let exists = shell("powershell -Command \"Test-Path '" + path + "'\"")
        if3 trim(exists) != "True" {
            let missing = append(missing, f)
        }
    }
    if3 len(missing) > 0 {
        step("Core .nova files: " + to_str(len(CORE_NOVA_FILES) - len(missing)) + "/" + to_str(len(CORE_NOVA_FILES)) + " present", "warn")
    } else3 {
        step("All " + to_str(len(CORE_NOVA_FILES)) + " core .nova files present", "ok")
    }
    return missing
}

fn3 check_web_files() {
    let missing = []
    for3 f in WEB_FILES {
        let path = NOVAX_ROOT + "\\" + replace(f, "/", "\\")
        let exists = shell("powershell -Command \"Test-Path '" + path + "'\"")
        if3 trim(exists) != "True" {
            let missing = append(missing, f)
        }
    }
    if3 len(missing) > 0 {
        step("Web files: " + to_str(len(WEB_FILES) - len(missing)) + "/" + to_str(len(WEB_FILES)), "warn")
    } else3 {
        step("All " + to_str(len(WEB_FILES)) + " web files present", "ok")
    }
    return missing
}

fn3 check_services() {
    let ports = {"9999": "Orchestrator", "9881": "Hivemind", "9878": "CloudRouter", "9877": "ExecServer"}
    let online = 0
    let keys = dict_keys(ports)
    for3 port in keys {
        let name = dict_get(ports, port) ?? "?"
        try3 {
            let r = http_get("http://127.0.0.1:" + port + "/health")
            if3 r != null {
                step("  " + name + " (:" + port + "): online", "ok")
                let online = online + 1
            } else3 {
                step("  " + name + " (:" + port + "): offline", "skip")
            }
        } catch3 e {
            step("  " + name + " (:" + port + "): offline", "skip")
        }
    }
    step("Services: " + to_str(online) + "/" + to_str(len(keys)) + " online", "ok")
    return online
}

fn3 initialize_memory() {
    let defaults = {
        "skills.json": "[]", "repair_log.json": "[]",
        "module_registry.json": "{}", "ui_patterns.json": "{}",
        "session_capture.json": "[]", "projects.json": "{}"
    }
    let created = 0
    let keys = dict_keys(defaults)
    for3 filename in keys {
        let path = NOVAX_ROOT + "\\memory\\" + filename
        let exists = shell("powershell -Command \"Test-Path '" + path + "'\"")
        if3 trim(exists) != "True" {
            write_file(path, dict_get(defaults, filename) ?? "[]")
            let created = created + 1
        }
    }
    step("Memory stores initialized (" + to_str(created) + " new)", "ok")
    return created
}

// ── Main ──
let args = sys_args()
let check_only = list_contains(args, "--check")

banner()
print("  -- System Check --")

check_directories()
let missing_nova = check_nova_files()
let missing_web = check_web_files()

if3 check_only == false {
    print("")
    print("  -- Installing Dependencies --")
    install_deps()
    print("")
    print("  -- Memory Initialization --")
    initialize_memory()
}

print("")
print("  -- Service Check --")
let svc_count = check_services()

print("")
let total_issues = len(missing_nova) + len(missing_web)
if3 total_issues == 0 {
    print("  [OK] NovaX installation is COMPLETE and VERIFIED.")
} else3 {
    print("  [!!] " + to_str(total_issues) + " issue(s) found.")
}
print("")
