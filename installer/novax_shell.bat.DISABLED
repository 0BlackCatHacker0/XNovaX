@echo off
title NovaX OS Shell
cd /d "C:\NovaX"

REM ── NovaX Shell Launcher ──
REM This replaces explorer.exe as the Windows shell.
REM All services start, then NovaX Desktop opens in kiosk mode.

REM Start ALL NovaX services
start /min "" "C:\NovaX\ai_env\Scripts\python.exe" start_all.py

REM Wait for orchestrator to come online (up to 60 seconds)
set /a tries=0
:wait_loop
set /a tries+=1
if %tries% gtr 30 goto launch_browser
timeout /t 2 /nobreak >nul
"C:\NovaX\ai_env\Scripts\python.exe" -c "import socket; s=socket.socket(); s.settimeout(1); r=s.connect_ex(('127.0.0.1',9999)); s.close(); exit(0 if r==0 else 1)" 2>nul
if errorlevel 1 goto wait_loop

:launch_browser
REM Open NovaX Desktop in APP mode (has close button, resizable, Alt+F4 works)
REM NEVER use --kiosk — it traps the user with no escape
start "" "C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe" --app="http://localhost:9999/nova_desktop.html" --disable-infobars --no-first-run --disable-session-crashed-bubble --noerrdialogs

REM Clean exit — explorer.exe is the real shell
echo [OK] NovaX Desktop launched.
timeout /t 5 /nobreak >nul
exit /b 0
