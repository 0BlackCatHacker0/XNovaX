// novax_protocol.nova -- Opens novax:// URLs in browser
// Usage: novalang novax_protocol.nova <novax://path>

let args = sys_args()
if3 len(args) < 2 {
    exit(0)
}

let url = args[1]
// Strip protocol prefix
let path = replace(url, "novax://", "")
let path = replace(path, "novax:", "")
let path = trim(path)
if3 len(path) > 0 {
    // Remove leading slashes
    while3 len(path) > 0 {
        if3 slice(path, 0, 1) == "/" {
            let path = slice(path, 1, len(path))
        } else3 {
            break3
        }
    }
}

if3 path == "" {
    let path = "nova_desktop.html"
}

let target = "http://127.0.0.1:9999/" + path
shell("cmd /c start \"\" \"" + target + "\"")
