// elevate.nova -- NovaX Admin Elevation Helper (Pure NovaLang)
// Runs specific NovaX operations with elevated (Administrator) privileges.
// Uses PowerShell Start-Process -Verb RunAs to trigger UAC.
//
// Usage:
//   novalang elevate.nova <action>
//
// Actions: startup-enable, startup-disable, boot-task-create, boot-task-remove,
//          integration-enable-all, integration-disable-all,
//          theme-set, theme-restore, lockscreen-set, lockscreen-restore,
//          file-assoc-enable, file-assoc-disable, status

let NOVAX_ROOT = "C:\\NovaX"
let RESULT_FILE = NOVAX_ROOT + "\\memory\\elevation_result.json"

fn3 is_admin() {
    let check = shell("powershell -Command \"([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)\"")
    let trimmed = trim(check)
    if3 trimmed == "True" {
        return +1
    }
    return -1
}

fn3 request_elevation(action) {
    // Re-launch this script as admin via UAC
    let script = NOVAX_ROOT + "\\installer\\elevate.nova"
    let novalang_exe = "C:\\NovaX\\ai_env\\Scripts\\python.exe"
    let novalang_script = "C:\\NovaX\\novalang.py"
    let cmd = "powershell -Command \"Start-Process -FilePath '" + novalang_exe + "' -ArgumentList '\"" + novalang_script + "\" \"" + script + "\" " + action + "' -Verb RunAs -WorkingDirectory '" + NOVAX_ROOT + "'\""
    try3 {
        shell(cmd)
        return +1
    } catch3 e {
        return -1
    }
}

fn3 save_result(result) {
    let json_str = to_json(result)
    write_file(RESULT_FILE, json_str)
}

fn3 run_action(action) {
    // NOTE: os_takeover and shell_replace are DISABLED per permanent locks
    // These actions are kept for API compatibility but return errors
    let disabled_actions = ["startup-enable", "startup-disable", "boot-task-create", "boot-task-remove", "shell-install", "shell-uninstall"]

    if3 list_contains(disabled_actions, action) {
        return {"ok": false, "error": "Action '" + action + "' is permanently disabled (security lock)"}
    }

    if3 action == "status" {
        return {"ok": true, "admin": is_admin() == 1, "message": "NovaX elevation service running"}
    }

    if3 action == "integration-enable-all" {
        // Run os_integration enable via PowerShell
        let r = shell("novalang " + NOVAX_ROOT + "\\installer\\os_integration.nova enable-all 2>&1")
        return {"ok": true, "output": r}
    }

    if3 action == "integration-disable-all" {
        let r = shell("novalang " + NOVAX_ROOT + "\\installer\\os_integration.nova disable-all 2>&1")
        return {"ok": true, "output": r}
    }

    if3 action == "theme-set" {
        let r = shell("novalang " + NOVAX_ROOT + "\\installer\\os_integration.nova theme-set 2>&1")
        return {"ok": true, "output": r}
    }

    if3 action == "theme-restore" {
        let r = shell("novalang " + NOVAX_ROOT + "\\installer\\os_integration.nova theme-restore 2>&1")
        return {"ok": true, "output": r}
    }

    if3 action == "lockscreen-set" {
        let r = shell("novalang " + NOVAX_ROOT + "\\installer\\os_integration.nova lockscreen-set 2>&1")
        return {"ok": true, "output": r}
    }

    if3 action == "lockscreen-restore" {
        let r = shell("novalang " + NOVAX_ROOT + "\\installer\\os_integration.nova lockscreen-restore 2>&1")
        return {"ok": true, "output": r}
    }

    if3 action == "file-assoc-enable" {
        let r = shell("novalang " + NOVAX_ROOT + "\\installer\\os_integration.nova file-assoc-enable 2>&1")
        return {"ok": true, "output": r}
    }

    if3 action == "file-assoc-disable" {
        let r = shell("novalang " + NOVAX_ROOT + "\\installer\\os_integration.nova file-assoc-disable 2>&1")
        return {"ok": true, "output": r}
    }

    return {"ok": false, "error": "Unknown action: " + action}
}

// ── Main ──
let args = sys_args()
if3 len(args) < 2 {
    print("Usage: novalang elevate.nova <action>")
    print("Actions: status, integration-enable-all, integration-disable-all,")
    print("         theme-set, theme-restore, lockscreen-set, lockscreen-restore,")
    print("         file-assoc-enable, file-assoc-disable")
    exit(0)
}

let action = args[1]

if3 is_admin() == -1 {
    print("[NovaX] Requesting admin elevation for: " + action)
    let ok = request_elevation(action)
    if3 ok == 1 {
        print("[NovaX] UAC prompt shown -- check elevated window for result")
        print("[NovaX] Result will be saved to: " + RESULT_FILE)
    } else3 {
        print("[NovaX] Failed to request elevation")
        save_result({"ok": false, "error": "UAC elevation denied or failed"})
    }
} else3 {
    // We ARE admin -- run the action
    print("[NovaX Admin] Running: " + action)
    let result = run_action(action)
    save_result(result)
    print("[NovaX Admin] Result: " + to_json(result))
    print("[NovaX Admin] Saved to: " + RESULT_FILE)
    sleep(3000)
}
