// NovaX TText Service v2.0 - Pure NovaLang Text Processing
// Port 9923: Text manipulation through ternary-native NovaLang builtins
// NO Python dependencies — all operations use NovaLang builtins + shell()
//
// 7 ternary-native text tools on 3-5-7-13 harmonic constants:
//   1. /ttext/sed    -- Regex find/replace in text (text, pattern, replacement)
//   2. /ttext/awk    -- Field extraction from structured text (text, delimiter, fields)
//   3. /ttext/jq     -- JSON path query (json, path)
//   4. /ttext/sort   -- Sort lines (text, reverse?, numeric?)
//   5. /ttext/uniq   -- Deduplicate lines (text, count?)
//   6. /ttext/count  -- Word/line/char count (text)
//   7. /ttext/grep   -- Regex search in text (text, pattern)
//
// N-S Mapping:
//   text_flow        = velocity_field (text being processed)
//   parse_complexity = turbulent_energy (regex/query complexity)
//   Reynolds(text)   = line_count * H3
//   RE_LAMINAR=27    = small text (<9 lines)
//   RE_TRANSITION=125 = medium text (9-41 lines)
//   RE_TURBULENT=343  = large text (>41 lines)

// -- Shared Libraries (N-S Flow) --
import3("C:/NovaX/lib/nova_ns_core.nova")
import3("C:/NovaX/lib/nova_stdlib.nova")

let PORT = 9923
let server = tserve(PORT, "TText v2.0 - Pure NovaLang Text Processing")

let H3  = 3
let H5  = 5
let H7  = 7

let T_TRUE  =  1
let T_MAYBE =  0
let T_FALSE = -1

let BLOCK_SIZE     = 2187
let RE_LAMINAR     = 27
let RE_TRANSITION  = 125
let RE_TURBULENT   = 343

let TOOLS_COUNT    = 7
let VERSION        = "2.0.0"
let SERVICE_NAME   = "nova-ttext"
let TMP_DIR        = "C:\\NovaX\\data"

let stat_ops         = 0
let stat_trit_true   = 0
let stat_trit_maybe  = 0
let stat_trit_false  = 0
let stat_t0          = time()

let by_tool_sed   = 0
let by_tool_awk   = 0
let by_tool_jq    = 0
let by_tool_sort  = 0
let by_tool_uniq  = 0
let by_tool_count = 0
let by_tool_grep  = 0

fn bt_one(t) {
    if3 t == T_TRUE { return "+" }
    if3 t == T_MAYBE { return "~" }
    return "T"
}

fn flow_regime(re_num) {
    if3 re_num < RE_LAMINAR { return "laminar" }
    if3 re_num < RE_TRANSITION { return "transitional" }
    if3 re_num < RE_TURBULENT { return "turbulent" }
    return "chaotic"
}

fn record_op(tool_name, trit_val) {
    stat_ops = stat_ops + 1
    if3 trit_val == T_TRUE { stat_trit_true = stat_trit_true + 1 }
    if3 trit_val == T_MAYBE { stat_trit_maybe = stat_trit_maybe + 1 }
    if3 trit_val == T_FALSE { stat_trit_false = stat_trit_false + 1 }
    if3 tool_name == "sed" { by_tool_sed = by_tool_sed + 1 }
    if3 tool_name == "awk" { by_tool_awk = by_tool_awk + 1 }
    if3 tool_name == "jq" { by_tool_jq = by_tool_jq + 1 }
    if3 tool_name == "sort" { by_tool_sort = by_tool_sort + 1 }
    if3 tool_name == "uniq" { by_tool_uniq = by_tool_uniq + 1 }
    if3 tool_name == "count" { by_tool_count = by_tool_count + 1 }
    if3 tool_name == "grep" { by_tool_grep = by_tool_grep + 1 }
}

// ===========================================================================
// TOOL 1: /ttext/sed — Regex find/replace (pure NovaLang)
// Body: {text, pattern, replacement, count?}
// Uses shell() with PowerShell -replace for regex support
// ===========================================================================
fn handle_sed(body) {
    let text = dict_get(body, "text") ?? ""
    let pattern = dict_get(body, "pattern") ?? ""
    let replacement = dict_get(body, "replacement") ?? ""

    if3 text == "" {
        record_op("sed", T_FALSE)
        return {"ok": false, "trit": -1, "char": "T", "error": "missing text"}
    }
    if3 pattern == "" {
        record_op("sed", T_FALSE)
        return {"ok": false, "trit": -1, "char": "T", "error": "missing pattern"}
    }

    // Write text to temp file for shell processing
    let in_path = TMP_DIR + "\\ttext_sed_in.txt"
    let out_path = TMP_DIR + "\\ttext_sed_out.txt"
    nova_write(in_path, text)

    // Use PowerShell -replace for regex: read file, apply regex, write result
    let ps_cmd = "powershell -NoProfile -Command \"$t = Get-Content '" + in_path + "' -Raw -Encoding UTF8; $t = $t -replace '" + pattern + "', '" + replacement + "'; Set-Content -Path '" + out_path + "' -Value $t -NoNewline -Encoding UTF8\""
    shell(ps_cmd)

    // Read result back
    let result_text = nova_read(out_path)

    // Count matches by checking how many lines differ
    let orig_lines = split(text, "\n")
    let new_lines = split(result_text, "\n")
    let replacements = 0
    let li = 0
    while3 li < len(orig_lines) {
        if3 li < len(new_lines) {
            if3 orig_lines[li] != new_lines[li] {
                replacements = replacements + 1
            }
        }
        li = li + 1
    }

    // Clean up temp files
    shell("del /q \"" + in_path + "\" 2>NUL")
    shell("del /q \"" + out_path + "\" 2>NUL")

    record_op("sed", T_TRUE)
    return {"ok": true, "trit": 1, "char": "1", "result": result_text, "replacements": replacements}
}

// ===========================================================================
// TOOL 2: /ttext/awk — Field extraction (pure NovaLang)
// Body: {text, delimiter?, fields (list of ints or "all")}
// ===========================================================================
fn handle_awk(body) {
    let text = dict_get(body, "text") ?? ""
    if3 text == "" {
        record_op("awk", T_FALSE)
        return {"ok": false, "trit": -1, "char": "T", "error": "missing text"}
    }

    let delim = dict_get(body, "delimiter") ?? " "
    let fields = dict_get(body, "fields") ?? []
    let lines = split(trim(text), "\n")
    let out_lines = []
    let i = 0
    while3 i < len(lines) {
        let parts = split(lines[i], delim)
        // If delimiter is space and we got one big element, split on any whitespace
        if3 delim == " " {
            // split on space handles single-space; trim each part and remove empties
            let cleaned = []
            let p = 0
            while3 p < len(parts) {
                let trimmed = trim(parts[p])
                if3 trimmed != "" {
                    cleaned = append(cleaned, trimmed)
                }
                p = p + 1
            }
            parts = cleaned
        }
        if3 len(fields) == 0 {
            // No field selection: rejoin all parts
            out_lines = append(out_lines, join(parts, delim))
        }
        if3 len(fields) > 0 {
            // Select specific fields by index
            let selected = []
            let f = 0
            while3 f < len(fields) {
                let idx = to_int(fields[f])
                if3 idx >= 0 {
                    if3 idx < len(parts) {
                        selected = append(selected, parts[idx])
                    }
                }
                f = f + 1
            }
            out_lines = append(out_lines, join(selected, delim))
        }
        i = i + 1
    }
    let result = join(out_lines, "\n")

    record_op("awk", T_TRUE)
    return {"ok": true, "trit": 1, "char": "1", "result": result, "lines": len(out_lines)}
}

// ===========================================================================
// TOOL 3: /ttext/jq — JSON path query (pure NovaLang)
// Body: {json (string or object), path}
// Supports paths like: .key.subkey, .key[0].field
// ===========================================================================
fn handle_jq(body) {
    let json_input = dict_get(body, "json") ?? ""
    let path = dict_get(body, "path") ?? ""

    if3 path == "" {
        record_op("jq", T_FALSE)
        return {"ok": false, "trit": -1, "char": "T", "error": "missing path"}
    }

    // Parse JSON if it's a string
    let data = json_input
    if3 type(json_input) == "str" {
        data = json_decode(json_input)
    }

    // Parse the path: strip leading dot, split on dots
    let clean_path = path
    if3 starts_with(path, ".") {
        clean_path = slice(path, 1, len(path))
    }

    // Split path on "." and traverse
    let segments = split(clean_path, ".")
    let current = data
    let seg_i = 0
    let err = ""
    while3 seg_i < len(segments) {
        let seg = segments[seg_i]
        if3 seg != "" {
            // Check for array index: key[N]
            if3 contains(seg, "[") {
                // Split on "[" to get key and index
                let bracket_parts = split(seg, "[")
                let key_part = bracket_parts[0]
                let idx_str = bracket_parts[1]
                // Remove trailing "]"
                idx_str = replace(idx_str, "]", "")
                // Traverse key first if non-empty
                if3 key_part != "" {
                    current = dict_get(current, key_part) ?? null
                    if3 current == null {
                        err = "key '" + key_part + "' not found"
                        seg_i = len(segments)
                    }
                }
                // Then array index
                if3 err == "" {
                    let arr_idx = to_int(idx_str)
                    if3 arr_idx >= 0 {
                        if3 arr_idx < len(current) {
                            current = current[arr_idx]
                        }
                        if3 arr_idx >= len(current) {
                            err = "index " + str(arr_idx) + " out of range"
                            seg_i = len(segments)
                        }
                    }
                }
            }
            // Plain key traversal
            if3 contains(seg, "[") == false {
                let next = dict_get(current, seg) ?? null
                if3 next == null {
                    // Check if key truly doesn't exist vs value is null
                    err = "key '" + seg + "' not found"
                    seg_i = len(segments)
                }
                if3 next != null {
                    current = next
                }
            }
        }
        seg_i = seg_i + 1
    }

    if3 err != "" {
        record_op("jq", T_FALSE)
        return {"ok": false, "trit": -1, "char": "T", "error": err}
    }

    record_op("jq", T_TRUE)
    return {"ok": true, "trit": 1, "char": "1", "result": current}
}

// ===========================================================================
// TOOL 4: /ttext/sort — Sort lines (pure NovaLang)
// Body: {text, reverse?, numeric?}
// ===========================================================================
fn handle_sort(body) {
    let text = dict_get(body, "text") ?? ""
    if3 text == "" {
        record_op("sort", T_FALSE)
        return {"ok": false, "trit": -1, "char": "T", "error": "missing text"}
    }

    let lines = split(trim(text), "\n")
    let reverse_flag = dict_get(body, "reverse") ?? false
    let numeric_flag = dict_get(body, "numeric") ?? false

    if3 numeric_flag == true {
        // Numeric sort: use sort() builtin which sorts by float value
        let sorted_lines = sort(lines)
        if3 reverse_flag == true {
            sorted_lines = reverse(sorted_lines)
        }
        let result = join(sorted_lines, "\n")
        record_op("sort", T_TRUE)
        return {"ok": true, "trit": 1, "char": "1", "result": result, "lines": len(sorted_lines)}
    }

    // Alphabetic sort: use shell sort command
    let in_path = TMP_DIR + "\\ttext_sort_in.txt"
    let out_path = TMP_DIR + "\\ttext_sort_out.txt"
    nova_write(in_path, trim(text))

    let sort_cmd = "sort \"" + in_path + "\" > \"" + out_path + "\""
    if3 reverse_flag == true {
        sort_cmd = "sort /R \"" + in_path + "\" > \"" + out_path + "\""
    }
    shell(sort_cmd)
    let result = trim(nova_read(out_path))

    // Clean up
    shell("del /q \"" + in_path + "\" 2>NUL")
    shell("del /q \"" + out_path + "\" 2>NUL")

    let result_lines = split(result, "\n")
    record_op("sort", T_TRUE)
    return {"ok": true, "trit": 1, "char": "1", "result": result, "lines": len(result_lines)}
}

// ===========================================================================
// TOOL 5: /ttext/uniq — Deduplicate lines (pure NovaLang)
// Body: {text, count?}
// ===========================================================================
fn handle_uniq(body) {
    let text = dict_get(body, "text") ?? ""
    if3 text == "" {
        record_op("uniq", T_FALSE)
        return {"ok": false, "trit": -1, "char": "T", "error": "missing text"}
    }

    let lines = split(trim(text), "\n")
    let total = len(lines)
    let show_count = dict_get(body, "count") ?? false

    if3 show_count == true {
        // Count occurrences of each line
        let counts = {}
        let ci = 0
        while3 ci < len(lines) {
            let line = lines[ci]
            let cur_count = dict_get(counts, line) ?? 0
            counts = dict_set(counts, line, cur_count + 1)
            ci = ci + 1
        }
        // Build result lines: "count\tline"
        let seen_keys = []
        let result_lines = []
        let ri = 0
        while3 ri < len(lines) {
            let line = lines[ri]
            // Only add each unique line once
            let already = false
            let si = 0
            while3 si < len(seen_keys) {
                if3 seen_keys[si] == line {
                    already = true
                }
                si = si + 1
            }
            if3 already == false {
                seen_keys = append(seen_keys, line)
                let c = dict_get(counts, line) ?? 0
                result_lines = append(result_lines, str(c) + "\t" + line)
            }
            ri = ri + 1
        }
        let result = join(result_lines, "\n")
        record_op("uniq", T_TRUE)
        return {"ok": true, "trit": 1, "char": "1", "result": result, "unique": len(seen_keys), "total": total}
    }

    // Simple dedup: keep first occurrence
    let seen = []
    let unique_lines = []
    let ui = 0
    while3 ui < len(lines) {
        let line = lines[ui]
        let found = false
        let si = 0
        while3 si < len(seen) {
            if3 seen[si] == line {
                found = true
            }
            si = si + 1
        }
        if3 found == false {
            seen = append(seen, line)
            unique_lines = append(unique_lines, line)
        }
        ui = ui + 1
    }
    let result = join(unique_lines, "\n")
    record_op("uniq", T_TRUE)
    return {"ok": true, "trit": 1, "char": "1", "result": result, "unique": len(unique_lines), "total": total}
}

// ===========================================================================
// TOOL 6: /ttext/count — Word/line/char count (pure NovaLang)
// Body: {text}
// ===========================================================================
fn handle_count(body) {
    let text = dict_get(body, "text") ?? ""
    if3 text == "" {
        record_op("count", T_MAYBE)
        return {"ok": true, "trit": 0, "char": "0", "lines": 0, "words": 0, "chars": 0}
    }

    let chars = len(text)
    // Count lines: split on newline
    let line_arr = split(text, "\n")
    let line_count = len(line_arr)
    // If text ends with newline, last element is empty — don't count it
    if3 ends_with(text, "\n") {
        line_count = line_count - 1
    }

    // Count words: split on whitespace by splitting on space, tab, newline
    // Replace tabs and newlines with spaces, then split
    let normalized = replace(text, "\t", " ")
    normalized = replace(normalized, "\n", " ")
    normalized = replace(normalized, "\r", " ")
    let word_parts = split(normalized, " ")
    let word_count = 0
    let wi = 0
    while3 wi < len(word_parts) {
        if3 trim(word_parts[wi]) != "" {
            word_count = word_count + 1
        }
        wi = wi + 1
    }

    record_op("count", T_TRUE)
    return {"ok": true, "trit": 1, "char": "1", "lines": line_count, "words": word_count, "chars": chars}
}

// ===========================================================================
// TOOL 7: /ttext/grep — Regex search in text (pure NovaLang)
// Body: {text, pattern, context?}
// Uses shell() with findstr for regex matching
// ===========================================================================
fn handle_grep(body) {
    let text = dict_get(body, "text") ?? ""
    let pattern = dict_get(body, "pattern") ?? ""

    if3 text == "" {
        record_op("grep", T_FALSE)
        return {"ok": false, "trit": -1, "char": "T", "error": "missing text"}
    }
    if3 pattern == "" {
        record_op("grep", T_FALSE)
        return {"ok": false, "trit": -1, "char": "T", "error": "missing pattern"}
    }

    // Write text to temp file, use findstr /N /R for regex grep with line numbers
    let in_path = TMP_DIR + "\\ttext_grep_in.txt"
    let out_path = TMP_DIR + "\\ttext_grep_out.txt"
    nova_write(in_path, text)

    // Use findstr /N /R /C: for regex search; capture output
    let grep_cmd = "findstr /N /R /C:\"" + pattern + "\" \"" + in_path + "\" > \"" + out_path + "\" 2>NUL"
    shell(grep_cmd)

    // Check if output file exists and has content
    let exists_check = trim(shell("if exist \"" + out_path + "\" (echo yes) else (echo no)"))
    let matched_lines = []
    let result_text = ""
    let match_count = 0

    if3 exists_check == "yes" {
        let raw_output = nova_read(out_path)
        if3 trim(raw_output) != "" {
            let out_lines = split(trim(raw_output), "\n")
            let oi = 0
            while3 oi < len(out_lines) {
                let line = out_lines[oi]
                // findstr /N output format: "linenum:text"
                if3 contains(line, ":") {
                    let colon_parts = split(line, ":")
                    let line_num = to_int(colon_parts[0])
                    // Rejoin rest after first colon (line may contain colons)
                    let line_text = slice(line, len(colon_parts[0]) + 1, len(line))
                    matched_lines = append(matched_lines, {"line": line_num, "text": line_text})
                    match_count = match_count + 1
                }
                oi = oi + 1
            }
            // Build result text from matched lines
            let result_parts = []
            let ri = 0
            while3 ri < len(matched_lines) {
                result_parts = append(result_parts, dict_get(matched_lines[ri], "text") ?? "")
                ri = ri + 1
            }
            result_text = join(result_parts, "\n")
        }
    }

    // Clean up
    shell("del /q \"" + in_path + "\" 2>NUL")
    shell("del /q \"" + out_path + "\" 2>NUL")

    if3 match_count > 0 {
        record_op("grep", T_TRUE)
        return {"ok": true, "trit": 1, "char": "1", "result": result_text, "matches": match_count, "matched_lines": matched_lines}
    }
    record_op("grep", T_MAYBE)
    return {"ok": true, "trit": 0, "char": "0", "result": "", "matches": 0}
}

// ===========================================================================
// /health
// ===========================================================================
fn handle_health(body) {
    let counters = {}
    counters = dict_set(counters, "total_ops", stat_ops)
    counters = dict_set(counters, "trit_true", stat_trit_true)
    counters = dict_set(counters, "trit_maybe", stat_trit_maybe)
    counters = dict_set(counters, "trit_false", stat_trit_false)
    let resp = ns_health_dict(SERVICE_NAME, VERSION, PORT, counters)
    resp = dict_set(resp, "reynolds", stat_ops * H3)
    resp = dict_set(resp, "flow_regime", flow_regime(stat_ops * H3))
    resp = dict_set(resp, "runtime", "novalang-native")
    return resp
}

// ===========================================================================
// /ttext/service-status
// ===========================================================================
fn handle_status(body) {
    let uptime = time() - stat_t0
    return {
        "ok": true,
        "service": SERVICE_NAME,
        "version": VERSION,
        "port": PORT,
        "uptime_s": uptime,
        "tools_count": TOOLS_COUNT,
        "stats": {"total_ops": stat_ops, "trit_true": stat_trit_true, "trit_maybe": stat_trit_maybe, "trit_false": stat_trit_false},
        "by_tool": {"sed": by_tool_sed, "awk": by_tool_awk, "jq": by_tool_jq, "sort": by_tool_sort, "uniq": by_tool_uniq, "count": by_tool_count, "grep": by_tool_grep},
        "trit": 1,
        "char": "1"
    }
}

// POST /ttext/paste — join columns/lines side by side
fn handle_paste(body) {
    let inputs = dict_get(body, "inputs") ?? []
    let delimiter = dict_get(body, "delimiter") ?? "\t"
    if3 len(inputs) == 0 {
        return {"ok": false, "error": "missing 'inputs' array of strings", "trit": -1}
    }
    // Split each input into lines, then join corresponding lines
    let split_inputs = []
    let max_lines = 0
    let idx = 0
    while3 idx < len(inputs) {
        let lines_arr = split(inputs[idx], "\n")
        split_inputs = append(split_inputs, lines_arr)
        if3 len(lines_arr) > max_lines {
            max_lines = len(lines_arr)
        }
        idx = idx + 1
    }
    let result_lines = []
    let line_idx = 0
    while3 line_idx < max_lines {
        let parts = []
        let inp_idx = 0
        while3 inp_idx < len(split_inputs) {
            let cur = split_inputs[inp_idx]
            if3 line_idx < len(cur) {
                parts = append(parts, cur[line_idx])
            }
            inp_idx = inp_idx + 1
        }
        result_lines = append(result_lines, join(parts, delimiter))
        line_idx = line_idx + 1
    }
    let output = join(result_lines, "\n")
    stat_ops = stat_ops + 1
    return {"ok": true, "output": output, "lines": max_lines, "trit": 1, "char": "1"}
}

// ROUTES
troute(server, "GET",  "/health",                 "handle_health")
troute(server, "GET",  "/ttext/service-status",    "handle_status")
troute(server, "POST", "/ttext/sed",               "handle_sed")
troute(server, "POST", "/ttext/awk",               "handle_awk")
troute(server, "POST", "/ttext/jq",                "handle_jq")
troute(server, "POST", "/ttext/sort",              "handle_sort")
troute(server, "POST", "/ttext/uniq",              "handle_uniq")
troute(server, "POST", "/ttext/count",             "handle_count")
troute(server, "POST", "/ttext/grep",              "handle_grep")
troute(server, "POST", "/ttext/paste",             "handle_paste")

tstart(server)
