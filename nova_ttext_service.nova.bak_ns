// NovaX TText Service v1.0 - Ternary Text Processing (NovaLang)
// Port 9923: Text manipulation through ternary-native micro-tools
//
// 7 ternary-native text tools on 3-5-7-13 harmonic constants:
//   1. /ttext/sed    -- Regex find/replace in text (text, pattern, replacement)
//   2. /ttext/awk    -- Field extraction from structured text (text, delimiter, fields)
//   3. /ttext/jq     -- JSON path query (json, path)
//   4. /ttext/sort   -- Sort lines (text, reverse?, numeric?)
//   5. /ttext/uniq   -- Deduplicate lines (text, count?)
//   6. /ttext/count  -- Word/line/char count (text)
//   7. /ttext/grep   -- Regex search in text (text, pattern)
//
// N-S Mapping:
//   text_flow        = velocity_field (text being processed)
//   parse_complexity = turbulent_energy (regex/query complexity)
//   Reynolds(text)   = line_count * H3
//   RE_LAMINAR=27    = small text (<9 lines)
//   RE_TRANSITION=125 = medium text (9-41 lines)
//   RE_TURBULENT=343  = large text (>41 lines)

let PORT = 9923
let server = tserve(PORT, "TText v1.0 - Ternary Text Processing")

let H3  = 3
let H5  = 5
let H7  = 7
let H13 = 13

let T_TRUE  =  1
let T_MAYBE =  0
let T_FALSE = -1

let BLOCK_SIZE     = 2187
let RE_LAMINAR     = 27
let RE_TRANSITION  = 125
let RE_TURBULENT   = 343

let TOOLS_COUNT    = 7
let VERSION        = "1.0.0"
let SERVICE_NAME   = "nova-ttext"
let TMP_DIR        = "C:\\NovaX\\data"

let stat_ops         = 0
let stat_trit_true   = 0
let stat_trit_maybe  = 0
let stat_trit_false  = 0
let stat_t0          = time()

let by_tool_sed   = 0
let by_tool_awk   = 0
let by_tool_jq    = 0
let by_tool_sort  = 0
let by_tool_uniq  = 0
let by_tool_count = 0
let by_tool_grep  = 0

fn bt_one(t) {
    if3 t == T_TRUE { return "+" }
    if3 t == T_MAYBE { return "~" }
    return "T"
}

fn flow_regime(re_num) {
    if3 re_num < RE_LAMINAR { return "laminar" }
    if3 re_num < RE_TRANSITION { return "transitional" }
    if3 re_num < RE_TURBULENT { return "turbulent" }
    return "chaotic"
}

fn record_op(tool_name, trit_val) {
    stat_ops = stat_ops + 1
    if3 trit_val == T_TRUE { stat_trit_true = stat_trit_true + 1 }
    if3 trit_val == T_MAYBE { stat_trit_maybe = stat_trit_maybe + 1 }
    if3 trit_val == T_FALSE { stat_trit_false = stat_trit_false + 1 }
    if3 tool_name == "sed" { by_tool_sed = by_tool_sed + 1 }
    if3 tool_name == "awk" { by_tool_awk = by_tool_awk + 1 }
    if3 tool_name == "jq" { by_tool_jq = by_tool_jq + 1 }
    if3 tool_name == "sort" { by_tool_sort = by_tool_sort + 1 }
    if3 tool_name == "uniq" { by_tool_uniq = by_tool_uniq + 1 }
    if3 tool_name == "count" { by_tool_count = by_tool_count + 1 }
    if3 tool_name == "grep" { by_tool_grep = by_tool_grep + 1 }
}

// All text tools use a Python helper script for the heavy lifting.
// NovaLang does routing, stats, and ternary classification.
let SCRIPT_PATH = "C:\\NovaX\\scripts\\ttext_worker.py"

// ===========================================================================
// TOOL 1: /ttext/sed — Regex find/replace
// Body: {text, pattern, replacement, count?}
// ===========================================================================
fn handle_sed(body) {
    let text = dict_get(body, "text", "")
    let pattern = dict_get(body, "pattern", "")
    let replacement = dict_get(body, "replacement", "")

    if3 text == "" {
        record_op("sed", T_FALSE)
        return {"ok": false, "trit": -1, "char": "T", "error": "missing text"}
    }
    if3 pattern == "" {
        record_op("sed", T_FALSE)
        return {"ok": false, "trit": -1, "char": "T", "error": "missing pattern"}
    }

    // Write input to temp file, run python script
    let in_path = TMP_DIR + "\\ttext_input.txt"
    nova_write(in_path, text)
    let count = dict_get(body, "count", 0)
    let cmd = "python \"" + SCRIPT_PATH + "\" sed \"" + in_path + "\" \"" + pattern + "\" \"" + replacement + "\" " + str(count)
    let raw = nova_run(cmd, 30)
    let result = json_decode(raw)
    let ok = dict_get(result, "ok", false)

    if3 ok == true {
        record_op("sed", T_TRUE)
        return {"ok": true, "trit": 1, "char": "1", "result": dict_get(result, "result", ""), "replacements": dict_get(result, "replacements", 0)}
    }
    record_op("sed", T_FALSE)
    return {"ok": false, "trit": -1, "char": "T", "error": dict_get(result, "error", "sed failed")}
}

// ===========================================================================
// TOOL 2: /ttext/awk — Field extraction
// Body: {text, delimiter?, fields (list of ints or "all")}
// ===========================================================================
fn handle_awk(body) {
    let text = dict_get(body, "text", "")
    if3 text == "" {
        record_op("awk", T_FALSE)
        return {"ok": false, "trit": -1, "char": "T", "error": "missing text"}
    }

    let in_path = TMP_DIR + "\\ttext_input.txt"
    nova_write(in_path, text)
    let delim = dict_get(body, "delimiter", " ")
    let fields = dict_get(body, "fields", [])
    let fields_json = json_encode(fields)
    // Write params
    let params_path = TMP_DIR + "\\ttext_params.json"
    nova_write(params_path, json_encode({"delimiter": delim, "fields": fields}))
    let cmd = "python \"" + SCRIPT_PATH + "\" awk \"" + in_path + "\" \"" + params_path + "\""
    let raw = nova_run(cmd, 30)
    let result = json_decode(raw)
    let ok = dict_get(result, "ok", false)

    if3 ok == true {
        record_op("awk", T_TRUE)
        return {"ok": true, "trit": 1, "char": "1", "result": dict_get(result, "result", ""), "lines": dict_get(result, "lines", 0)}
    }
    record_op("awk", T_FALSE)
    return {"ok": false, "trit": -1, "char": "T", "error": dict_get(result, "error", "awk failed")}
}

// ===========================================================================
// TOOL 3: /ttext/jq — JSON path query
// Body: {json (string or object), path}
// ===========================================================================
fn handle_jq(body) {
    let json_input = dict_get(body, "json", "")
    let path = dict_get(body, "path", "")

    if3 path == "" {
        record_op("jq", T_FALSE)
        return {"ok": false, "trit": -1, "char": "T", "error": "missing path"}
    }

    let in_path = TMP_DIR + "\\ttext_jq_input.json"
    // If json_input is a string, write directly; if object, encode first
    let json_str = json_input
    if3 type(json_input) != "str" {
        json_str = json_encode(json_input)
    }
    nova_write(in_path, json_str)

    let cmd = "python \"" + SCRIPT_PATH + "\" jq \"" + in_path + "\" \"" + path + "\""
    let raw = nova_run(cmd, 30)
    let result = json_decode(raw)
    let ok = dict_get(result, "ok", false)

    if3 ok == true {
        record_op("jq", T_TRUE)
        return {"ok": true, "trit": 1, "char": "1", "result": dict_get(result, "result", null)}
    }
    record_op("jq", T_FALSE)
    return {"ok": false, "trit": -1, "char": "T", "error": dict_get(result, "error", "jq failed")}
}

// ===========================================================================
// TOOL 4: /ttext/sort — Sort lines
// Body: {text, reverse?, numeric?}
// ===========================================================================
fn handle_sort(body) {
    let text = dict_get(body, "text", "")
    if3 text == "" {
        record_op("sort", T_FALSE)
        return {"ok": false, "trit": -1, "char": "T", "error": "missing text"}
    }

    let in_path = TMP_DIR + "\\ttext_input.txt"
    nova_write(in_path, text)
    let reverse = dict_get(body, "reverse", false)
    let numeric = dict_get(body, "numeric", false)
    let flags = ""
    if3 reverse == true { flags = flags + "r" }
    if3 numeric == true { flags = flags + "n" }

    let cmd = "python \"" + SCRIPT_PATH + "\" sort \"" + in_path + "\" \"" + flags + "\""
    let raw = nova_run(cmd, 30)
    let result = json_decode(raw)
    let ok = dict_get(result, "ok", false)

    if3 ok == true {
        record_op("sort", T_TRUE)
        return {"ok": true, "trit": 1, "char": "1", "result": dict_get(result, "result", ""), "lines": dict_get(result, "lines", 0)}
    }
    record_op("sort", T_FALSE)
    return {"ok": false, "trit": -1, "char": "T", "error": dict_get(result, "error", "sort failed")}
}

// ===========================================================================
// TOOL 5: /ttext/uniq — Deduplicate lines
// Body: {text, count?}
// ===========================================================================
fn handle_uniq(body) {
    let text = dict_get(body, "text", "")
    if3 text == "" {
        record_op("uniq", T_FALSE)
        return {"ok": false, "trit": -1, "char": "T", "error": "missing text"}
    }

    let in_path = TMP_DIR + "\\ttext_input.txt"
    nova_write(in_path, text)
    let show_count = dict_get(body, "count", false)
    let flags = ""
    if3 show_count == true { flags = "c" }

    let cmd = "python \"" + SCRIPT_PATH + "\" uniq \"" + in_path + "\" \"" + flags + "\""
    let raw = nova_run(cmd, 30)
    let result = json_decode(raw)
    let ok = dict_get(result, "ok", false)

    if3 ok == true {
        record_op("uniq", T_TRUE)
        return {"ok": true, "trit": 1, "char": "1", "result": dict_get(result, "result", ""), "unique": dict_get(result, "unique", 0), "total": dict_get(result, "total", 0)}
    }
    record_op("uniq", T_FALSE)
    return {"ok": false, "trit": -1, "char": "T", "error": dict_get(result, "error", "uniq failed")}
}

// ===========================================================================
// TOOL 6: /ttext/count — Word/line/char count
// Body: {text}
// ===========================================================================
fn handle_count(body) {
    let text = dict_get(body, "text", "")
    if3 text == "" {
        record_op("count", T_MAYBE)
        return {"ok": true, "trit": 0, "char": "0", "lines": 0, "words": 0, "chars": 0}
    }

    let in_path = TMP_DIR + "\\ttext_input.txt"
    nova_write(in_path, text)
    let cmd = "python \"" + SCRIPT_PATH + "\" count \"" + in_path + "\""
    let raw = nova_run(cmd, 30)
    let result = json_decode(raw)

    record_op("count", T_TRUE)
    return {"ok": true, "trit": 1, "char": "1", "lines": dict_get(result, "lines", 0), "words": dict_get(result, "words", 0), "chars": dict_get(result, "chars", 0)}
}

// ===========================================================================
// TOOL 7: /ttext/grep — Regex search in text
// Body: {text, pattern, context?}
// ===========================================================================
fn handle_grep(body) {
    let text = dict_get(body, "text", "")
    let pattern = dict_get(body, "pattern", "")

    if3 text == "" {
        record_op("grep", T_FALSE)
        return {"ok": false, "trit": -1, "char": "T", "error": "missing text"}
    }
    if3 pattern == "" {
        record_op("grep", T_FALSE)
        return {"ok": false, "trit": -1, "char": "T", "error": "missing pattern"}
    }

    let in_path = TMP_DIR + "\\ttext_input.txt"
    nova_write(in_path, text)
    let cmd = "python \"" + SCRIPT_PATH + "\" grep \"" + in_path + "\" \"" + pattern + "\""
    let raw = nova_run(cmd, 30)
    let result = json_decode(raw)
    let ok = dict_get(result, "ok", false)
    let matches = dict_get(result, "matches", 0)

    if3 matches > 0 {
        record_op("grep", T_TRUE)
        return {"ok": true, "trit": 1, "char": "1", "result": dict_get(result, "result", ""), "matches": matches}
    }
    record_op("grep", T_MAYBE)
    return {"ok": true, "trit": 0, "char": "0", "result": "", "matches": 0}
}

// ===========================================================================
// /health
// ===========================================================================
fn handle_health(body) {
    return {
        "ok": true,
        "service": SERVICE_NAME,
        "port": PORT,
        "version": VERSION,
        "ternary": true,
        "trit": 1,
        "char": "1",
        "reynolds": stat_ops * H3,
        "flow_regime": flow_regime(stat_ops * H3),
        "total_ops": stat_ops,
        "runtime": "novalang",
        "harmonics": {"H3": H3, "H5": H5, "H7": H7, "H13": H13}
    }
}

// ===========================================================================
// /ttext/service-status
// ===========================================================================
fn handle_status(body) {
    let uptime = time() - stat_t0
    return {
        "ok": true,
        "service": SERVICE_NAME,
        "version": VERSION,
        "port": PORT,
        "uptime_s": uptime,
        "tools_count": TOOLS_COUNT,
        "stats": {"total_ops": stat_ops, "trit_true": stat_trit_true, "trit_maybe": stat_trit_maybe, "trit_false": stat_trit_false},
        "by_tool": {"sed": by_tool_sed, "awk": by_tool_awk, "jq": by_tool_jq, "sort": by_tool_sort, "uniq": by_tool_uniq, "count": by_tool_count, "grep": by_tool_grep},
        "trit": 1,
        "char": "1"
    }
}

// POST /ttext/paste — join columns/lines side by side
fn handle_paste(body) {
    let inputs = dict_get(body, "inputs", [])
    let delimiter = dict_get(body, "delimiter", "\t")
    if len(inputs) == 0 {
        return {"ok": false, "error": "missing 'inputs' array of strings", "trit": -1}
    }
    // Split each input into lines, then join corresponding lines
    let split_inputs = []
    let max_lines = 0
    let idx = 0
    while idx < len(inputs) {
        let lines_arr = split(inputs[idx], "\n")
        split_inputs = append(split_inputs, lines_arr)
        if len(lines_arr) > max_lines {
            max_lines = len(lines_arr)
        }
        idx = idx + 1
    }
    let result_lines = []
    let line_idx = 0
    while line_idx < max_lines {
        let parts = []
        let inp_idx = 0
        while inp_idx < len(split_inputs) {
            let cur = split_inputs[inp_idx]
            if line_idx < len(cur) {
                parts = append(parts, cur[line_idx])
            }
            inp_idx = inp_idx + 1
        }
        result_lines = append(result_lines, join(parts, delimiter))
        line_idx = line_idx + 1
    }
    let output = join(result_lines, "\n")
    stat_ops = stat_ops + 1
    return {"ok": true, "output": output, "lines": max_lines, "trit": 1, "char": "1"}
}

// ROUTES
troute(server, "GET",  "/health",                 "handle_health")
troute(server, "GET",  "/ttext/service-status",    "handle_status")
troute(server, "POST", "/ttext/sed",               "handle_sed")
troute(server, "POST", "/ttext/awk",               "handle_awk")
troute(server, "POST", "/ttext/jq",                "handle_jq")
troute(server, "POST", "/ttext/sort",              "handle_sort")
troute(server, "POST", "/ttext/uniq",              "handle_uniq")
troute(server, "POST", "/ttext/count",             "handle_count")
troute(server, "POST", "/ttext/grep",              "handle_grep")
troute(server, "POST", "/ttext/paste",             "handle_paste")

tstart(server)
