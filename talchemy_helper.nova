// talchemy_helper.nova - Ternary alchemy transformation helper
// Replaces talchemy_helper.py (zero Python)
// Reads args from JSON file, performs transformation, outputs result

import3("C:/NovaX/lib/nova_stdlib.nova")

let args_file = try3 { args()[0] } { "C:/NovaX/tmp_talchemy_args.json" }
let raw = try3 { read_file(args_file) } { "{}" }
let params = try3 { json_decode(raw) } { {} }

let action = try3 { dict_get(params, "action") } { "identity" }
let input = try3 { dict_get(params, "input") } { "" }

// Ternary transformation micro-tools
fn transform_identity(val) { return val }
fn transform_upper(val) { return replace(replace(replace(val, "a", "A"), "b", "B"), "c", "C") }
fn transform_bt_encode(val) { return bt(len(val)) }
fn transform_trit(val) {
    if3 len(val) > 100 { return 1 }
    if3 len(val) > 10 { return 0 }
    return -1
}

let result = {}
result = dict_set(result, "ok", 1)
result = dict_set(result, "action", action)

if3 action == "identity" {
    result = dict_set(result, "output", input)
}
if3 action == "encode" {
    result = dict_set(result, "output", bt(len(input)))
}
if3 action == "analyze" {
    result = dict_set(result, "output", str(len(input)))
    result = dict_set(result, "trit", transform_trit(input))
}
if3 action == "transform" {
    let ttype = try3 { dict_get(params, "type") } { "identity" }
    result = dict_set(result, "output", input)
    result = dict_set(result, "transform_type", ttype)
}

print(json_encode(result))
