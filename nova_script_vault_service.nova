// NovaX Script Vault v1.0.0 | Port 9938
// The World's Largest Ternary Script Collection
// Connected to: GitHub, ScriptShare, Tripple Module
// NOTE: All shell commands use vault_helper.py (no inline braces)
// NOTE: All dict returns use _empty()+dict_set() (no inline dict literals in multi-line fns)

import3("C:/NovaX/lib/nova_ns_core.nova")
import3("C:/NovaX/lib/nova_stdlib.nova")
import3("C:/NovaX/lib/nova_tripple.nova")

let _PORT = 9938
let _VERSION = "1.0.0"
let _NAME = "ScriptVault"
let _VAULT_PATH = "C:/NovaX/scripts/vault"
let _HELPER = "C:/NovaX/scripts/vault_helper.exe"

let H3 = 3
let H5 = 5
let H7 = 7
let H13 = 13

let _CATEGORIES = ["sysadmin", "network", "fileops", "textproc", "automation", "api", "security", "crypto", "math", "data", "git", "testing"]

// Safe single-line helpers (no nested braces issue on one-liners)
fn _mk_portal(url, ptype, freq) { return {"url": url, "type": ptype, "freq": freq} }
fn _empty() { return {} }
fn _err_result(msg) { return {"ok": false, "trit": -1, "error": msg} }
fn _gh_headers() { return {"Accept": "application/vnd.github.v3+json", "User-Agent": "NovaX-ScriptVault/1.0"} }

// Portals
let _PORTALS = {}
_PORTALS = dict_set(_PORTALS, "github", _mk_portal("https://api.github.com", "cloud", 500))
_PORTALS = dict_set(_PORTALS, "scriptshare", _mk_portal("https://www.scriptshare.io", "cloud", 500))
_PORTALS = dict_set(_PORTALS, "gists", _mk_portal("https://api.github.com/gists", "cloud", 500))
_PORTALS = dict_set(_PORTALS, "rosetta", _mk_portal("https://rosettacode.org", "cloud", 300))
_PORTALS = dict_set(_PORTALS, "codepen", _mk_portal("https://codepen.io", "cloud", 200))
_PORTALS = dict_set(_PORTALS, "pastebin", _mk_portal("https://pastebin.com", "fallback", 100))
_PORTALS = dict_set(_PORTALS, "local", _mk_portal("file://C:/NovaX/scripts/vault", "local", 1000))

// Stats
let _ns = ns_init_counters()
let _stats = {"total_scripts": 0, "total_runs": 0, "total_downloads": 0, "last_scan": 0}
_stats = dict_set(_stats, "categories", _empty())
_stats = dict_set(_stats, "popular", _empty())
_stats = dict_set(_stats, "portal_hits", _empty())
let _tripple = tripple_init()

// --- Vault Scanner (uses vault_helper.py) ---
fn _scan_vault() {
  let result = shell(_HELPER + " scan")
  let stdout = dict_get(result, "stdout") ?? ""
  let data = try3 { json_decode(trim(stdout)) } fail { _empty() }
  let total = dict_get(data, "total") ?? 0
  let cats = dict_get(data, "categories") ?? _empty()
  _stats = dict_set(_stats, "total_scripts", total)
  _stats = dict_set(_stats, "categories", cats)
  _stats = dict_set(_stats, "last_scan", time())
  return data
}

// --- Script Loader ---
fn _load_script(category, name) {
  let path = _VAULT_PATH + "/" + category + "/" + name
  if3 contains(name, ".nova") == false { path = path + ".nova"
  }
  let content = try3 { read_file(path) } fail { "" }
  if3 len(content) > 0 { r = _empty()
    r = dict_set(r, "ok", true)
    r = dict_set(r, "trit", 1)
    r = dict_set(r, "name", name)
    r = dict_set(r, "category", category)
    r = dict_set(r, "content", content)
    r = dict_set(r, "path", path)
    return r
  }
  return _err_result("Script not found: " + category + "/" + name)
}

// --- Script Runner ---
fn _run_script(category, name, args) {
  let path = _VAULT_PATH + "/" + category + "/" + name
  if3 contains(name, ".nova") == false { path = path + ".nova"
  }
  let cmd = "C:/NovaX/novalang.exe " + path
  if3 len(args) > 0 { cmd = cmd + " " + args
  }
  let result = shell(cmd)
  _stats = dict_set(_stats, "total_runs", (dict_get(_stats, "total_runs") ?? 0) + 1)
  let key = category + "/" + name
  let pop = dict_get(_stats, "popular") ?? _empty()
  let count = (dict_get(pop, key) ?? 0) + 1
  pop = dict_set(pop, key, count)
  _stats = dict_set(_stats, "popular", pop)
  return result
}

// --- Search (uses vault_helper.py) ---
fn _search_vault(query) {
  let result = shell(_HELPER + " search " + query)
  let stdout = dict_get(result, "stdout") ?? "[]"
  let parsed = try3 { json_decode(trim(stdout)) } fail { [] }
  return parsed
}

fn _search_content(query) {
  let result = shell(_HELPER + " grep " + query)
  let stdout = dict_get(result, "stdout") ?? "[]"
  let parsed = try3 { json_decode(trim(stdout)) } fail { [] }
  return parsed
}

// --- Portal Connection (uses vault_helper.py for HTTP) ---
fn _query_portal(portal_name, search_term) {
  let portal = dict_get(_PORTALS, portal_name) ?? _empty()
  let url = dict_get(portal, "url") ?? ""
  if3 len(url) == 0 {
    return _err_result("Unknown portal: " + portal_name)
  }
  let hits = dict_get(_stats, "portal_hits") ?? _empty()
  let count = (dict_get(hits, portal_name) ?? 0) + 1
  hits = dict_set(hits, portal_name, count)
  _stats = dict_set(_stats, "portal_hits", hits)
  _tripple = tripple_ripple(_tripple, portal_name, 1, 100)
  let cmd = ""
  if3 portal_name == "github" { cmd = _HELPER + " github " + search_term
  }
  if3 portal_name == "gists" { cmd = _HELPER + " gists " + search_term
  }
  if3 len(cmd) > 0 { result = shell(cmd)
    let stdout = dict_get(result, "stdout") ?? ""
    let data = try3 { json_decode(trim(stdout)) } fail { _empty() }
    let r = _empty()
    r = dict_set(r, "ok", true)
    r = dict_set(r, "trit", 1)
    r = dict_set(r, "portal", portal_name)
    r = dict_set(r, "results", dict_get(data, "results") ?? [])
    r = dict_set(r, "total", dict_get(data, "total") ?? 0)
    return r
  }
  let r = _empty()
  r = dict_set(r, "ok", true)
  r = dict_set(r, "trit", 0)
  r = dict_set(r, "portal", portal_name)
  r = dict_set(r, "message", "Portal query queued")
  return r
}

// === HTTP Handlers ===

let server = tserve(_PORT)

fn handle_health(req) {
  _ns = ns_record(_ns, 1, 10)
  return ns_health_dict(_ns, _NAME, _PORT, _VERSION)
}
troute(server, "GET", "/health", "handle_health")

fn handle_status(req) {
  let scan = _scan_vault()
  let total = dict_get(scan, "total") ?? 0
  let r = _empty()
  r = dict_set(r, "ok", true)
  r = dict_set(r, "trit", 1)
  r = dict_set(r, "service", _NAME)
  r = dict_set(r, "version", _VERSION)
  r = dict_set(r, "port", _PORT)
  r = dict_set(r, "total_scripts", total)
  r = dict_set(r, "total_runs", dict_get(_stats, "total_runs") ?? 0)
  r = dict_set(r, "portals", keys(_PORTALS))
  r = dict_set(r, "tripple_prime", tripple_prime_state(_tripple))
  return r
}
troute(server, "GET", "/vault/status", "handle_status")

fn handle_categories(req) {
  let scan = _scan_vault()
  let cats = dict_get(scan, "categories") ?? _empty()
  let r = _empty()
  r = dict_set(r, "ok", true)
  r = dict_set(r, "trit", 1)
  r = dict_set(r, "categories", cats)
  return r
}
troute(server, "GET", "/vault/categories", "handle_categories")

fn handle_list(req) {
  let body = try3 { json_decode(dict_get(req, "body") ?? "") } fail { req }
  let category = dict_get(body, "category") ?? ""
  if3 len(category) == 0 { qp = dict_get(req, "query") ?? ""
    if3 contains(qp, "category=") { parts = split(qp, "category=")
      if3 len(parts) > 1 { category = parts[1]
        if3 contains(category, "&") { category = dict_get(split(category, "&"), 0) ?? ""
        }
      }
    }
  }
  if3 len(category) == 0 {
    return _err_result("Missing category param")
  }
  let result = shell(_HELPER + " list " + category)
  let stdout = dict_get(result, "stdout") ?? "[]"
  let scripts = try3 { json_decode(trim(stdout)) } fail { [] }
  let r = _empty()
  r = dict_set(r, "ok", true)
  r = dict_set(r, "trit", 1)
  r = dict_set(r, "category", category)
  r = dict_set(r, "count", len(scripts))
  r = dict_set(r, "scripts", scripts)
  return r
}
troute(server, "GET", "/vault/list", "handle_list")
troute(server, "POST", "/vault/list", "handle_list")

fn handle_get(req) {
  let body = try3 { json_decode(dict_get(req, "body") ?? "") } fail { req }
  let category = dict_get(body, "category") ?? ""
  let name = dict_get(body, "name") ?? ""
  if3 len(category) == 0 { return _err_result("Missing category") }
  if3 len(name) == 0 { return _err_result("Missing name") }
  return _load_script(category, name)
}
troute(server, "POST", "/vault/get", "handle_get")

fn handle_run(req) {
  let body = try3 { json_decode(dict_get(req, "body") ?? "") } fail { req }
  let category = dict_get(body, "category") ?? ""
  let name = dict_get(body, "name") ?? ""
  let args = dict_get(body, "args") ?? ""
  if3 len(category) == 0 { return _err_result("Missing category") }
  if3 len(name) == 0 { return _err_result("Missing name") }
  let result = _run_script(category, name, args)
  let ok = dict_get(result, "ok") ?? -1
  let stdout = dict_get(result, "stdout") ?? ""
  let stderr = dict_get(result, "stderr") ?? ""
  let r = _empty()
  r = dict_set(r, "ok", true)
  r = dict_set(r, "trit", ok)
  r = dict_set(r, "output", trim(stdout))
  r = dict_set(r, "errors", trim(stderr))
  r = dict_set(r, "script", category + "/" + name)
  return r
}
troute(server, "POST", "/vault/run", "handle_run")

fn handle_search(req) {
  let body = try3 { json_decode(dict_get(req, "body") ?? "") } fail { req }
  let query = dict_get(body, "query") ?? (dict_get(body, "q") ?? "")
  if3 len(query) == 0 { return _err_result("Missing query") }
  let results = _search_vault(query)
  let r = _empty()
  r = dict_set(r, "ok", true)
  r = dict_set(r, "trit", 1)
  r = dict_set(r, "query", query)
  r = dict_set(r, "count", len(results))
  r = dict_set(r, "results", results)
  return r
}
troute(server, "POST", "/vault/search", "handle_search")

fn handle_grep(req) {
  let body = try3 { json_decode(dict_get(req, "body") ?? "") } fail { req }
  let query = dict_get(body, "query") ?? (dict_get(body, "q") ?? "")
  if3 len(query) == 0 { return _err_result("Missing query") }
  let results = _search_content(query)
  let r = _empty()
  r = dict_set(r, "ok", true)
  r = dict_set(r, "trit", 1)
  r = dict_set(r, "query", query)
  r = dict_set(r, "count", len(results))
  r = dict_set(r, "results", results)
  return r
}
troute(server, "POST", "/vault/grep", "handle_grep")

fn handle_popular(req) {
  let pop = dict_get(_stats, "popular") ?? _empty()
  let r = _empty()
  r = dict_set(r, "ok", true)
  r = dict_set(r, "trit", 1)
  r = dict_set(r, "popular", pop)
  r = dict_set(r, "total_runs", dict_get(_stats, "total_runs") ?? 0)
  return r
}
troute(server, "GET", "/vault/popular", "handle_popular")

fn handle_portal(req) {
  let body = try3 { json_decode(dict_get(req, "body") ?? "") } fail { req }
  let portal = dict_get(body, "portal") ?? "github"
  let search = dict_get(body, "search") ?? (dict_get(body, "q") ?? "")
  if3 len(search) == 0 { return _err_result("Missing search term") }
  return _query_portal(portal, search)
}
troute(server, "POST", "/vault/portal", "handle_portal")

fn handle_portals(req) {
  let r = _empty()
  r = dict_set(r, "ok", true)
  r = dict_set(r, "trit", 1)
  r = dict_set(r, "portals", _PORTALS)
  return r
}
troute(server, "GET", "/vault/portals", "handle_portals")

fn handle_tripple(req) {
  let status = tripple_status(_tripple)
  let r = _empty()
  r = dict_set(r, "ok", true)
  r = dict_set(r, "trit", 1)
  r = dict_set(r, "tripple", status)
  return r
}
troute(server, "GET", "/vault/tripple", "handle_tripple")

fn handle_stats(req) {
  let scan = _scan_vault()
  let r = _empty()
  r = dict_set(r, "ok", true)
  r = dict_set(r, "trit", 1)
  r = dict_set(r, "total_scripts", dict_get(scan, "total") ?? 0)
  r = dict_set(r, "total_runs", dict_get(_stats, "total_runs") ?? 0)
  r = dict_set(r, "popular", dict_get(_stats, "popular") ?? _empty())
  r = dict_set(r, "portal_hits", dict_get(_stats, "portal_hits") ?? _empty())
  r = dict_set(r, "tripple_prime", tripple_prime_state(_tripple))
  return r
}
troute(server, "GET", "/vault/stats", "handle_stats")

fn handle_catalog(req) {
  let result = shell(_HELPER + " catalog")
  let stdout = dict_get(result, "stdout") ?? ""
  let catalog = try3 { json_decode(trim(stdout)) } fail { _empty() }
  let total = 0
  let cat_keys = keys(catalog)
  let i = 0
  while3 i < len(cat_keys) {
    let k = cat_keys[i]
    let scripts = dict_get(catalog, k) ?? []
    total = total + len(scripts)
    i = i + 1
  }
  let r = _empty()
  r = dict_set(r, "ok", true)
  r = dict_set(r, "trit", 1)
  r = dict_set(r, "total", total)
  r = dict_set(r, "catalog", catalog)
  return r
}
troute(server, "GET", "/vault/catalog", "handle_catalog")

fn handle_download(req) {
  let body = try3 { json_decode(dict_get(req, "body") ?? "") } fail { req }
  let url = dict_get(body, "url") ?? ""
  let category = dict_get(body, "category") ?? "automation"
  if3 len(url) == 0 { return _err_result("Missing url") }
  let result = shell(_HELPER + " download " + url + " " + category)
  let stdout = dict_get(result, "stdout") ?? ""
  let data = try3 { json_decode(trim(stdout)) } fail { _empty() }
  let ok = dict_get(data, "ok") ?? false
  _stats = dict_set(_stats, "total_downloads", (dict_get(_stats, "total_downloads") ?? 0) + 1)
  return data
}
troute(server, "POST", "/vault/download", "handle_download")

print("Script Vault v" + _VERSION + " starting on port " + str(_PORT))
print("Vault path: " + _VAULT_PATH)
print("Categories: " + str(len(_CATEGORIES)))
print("Portals: " + str(len(keys(_PORTALS))))

tstart(server)
