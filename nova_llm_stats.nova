let PORT = 9930
let dir = "C:/NovaX/data/super_archive/"

fn handle_stats(req) {
  let files = dir_list(dir)
  let count = 0
  let chars = 0
  let providers = {}
  let fi = 0
  while3 fi < len(files) {
    if3 ends_with(files[fi], ".json") {
      let raw = try3 { read_file(dir + files[fi]) } fail { "" }
      if3 len(raw) > 10 {
        let e = try3 { json_decode(raw) } fail { {} }
        let r = dict_get(e, "response") ?? ""
        if3 len(r) > 3 {
          count = count + 1
          chars = chars + len(r)
          let p = dict_get(e, "provider") ?? "?"
          providers = dict_set(providers, p, (dict_get(providers, p) ?? 0) + 1)
        }
      }
    }
    fi = fi + 1
  }
  return {"total_entries": count, "total_chars": chars, "token_count": chars / 4, "providers": providers, "unique_models": len(keys(providers))}
}

fn handle_health(req) {
  return {"ok": 1, "service": "llm-stats", "port": PORT}
}

let server = tserve(PORT, "llm-stats")
troute(server, "GET", "/llm/archive-stats", "handle_stats")
troute(server, "GET", "/health", "handle_health")
print("[LLM-Stats] Archive stats on port " + str(PORT))
tstart(server)
