// URL parsing using PowerShell
fn parse_url(url) -> dict
    try3 {
        let ps_cmd = "powershell -Command \"[uri]'" + url + "' | Select-Object Scheme, Host, Port, AbsolutePath, Query, Fragment | ConvertTo-Json\""
        let json_str = shell(ps_cmd)
        if3 json_str == "" {
            return {}
        }
        return json_decode(json_str)
    } uncertain {
        return {}
    } fail3 {
        return {}
    }

