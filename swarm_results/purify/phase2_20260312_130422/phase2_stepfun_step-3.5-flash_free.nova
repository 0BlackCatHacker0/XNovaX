// === PURE NOVALANG REPLACEMENT: nova_thttp_service.nova ===
// Replaces: 38 Python calls for HTTP client operations
// Builtins used: shell, file_read, file_write, file_exists, json_decode, json_encode, len, split, join, replace, trim, format, dict_get, dict_set, dict_keys, dict_has, to_string, try3, if3

// HTTP client with full features (cookies, SSL, multipart, headers)
fn http_get(url, headers=[], cookies=[], verify=true, timeout=30) -> string
    try3 {
        let cmd = "curl -s -L --max-time " + to_string(timeout)
        if3 not verify {
            cmd += " --insecure"
        }
        for3 h in headers {
            cmd += " -H \"" + h + "\""
        }
        for3 c in cookies {
            cmd += " -b \"" + c + "\""
        }
        cmd += " \"" + url + "\""
        return shell(cmd)
    } uncertain {
        return ""
    } fail3 {
        return ""
    }

fn http_post(url, body="", headers=[], cookies=[], verify=true, timeout=30, multipart=null) -> string
    try3 {
        let cmd = "curl -s -L --max-time " + to_string(timeout) + " -X POST"
        if3 not verify {
            cmd += " --insecure"
        }
        for3 h in headers {
            cmd += " -H \"" + h + "\""
        }
        for3 c in cookies {
            cmd += " -b \"" + c + "\""
        }
        if3 multipart != null {
            let keys = dict_keys(multipart)
            for3 key in keys {
                let value = dict_get(multipart, key) ?? ""
                if3 file_exists(value) {
                    cmd += " -F \"" + key + "=@" + value + "\""
                } else {
                    cmd += " -F \"" + key + "=" + value + "\""
                }
            }
        } else {
            cmd += " -d \"" + body + "\""
        }
        cmd += " \"" + url + "\""
        return shell(cmd)
    } uncertain {
        return ""
    } fail3 {
        return ""
    }

