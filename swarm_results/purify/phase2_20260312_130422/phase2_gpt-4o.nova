fn validate_json_schema(json_text, schema) {
    // Simplified validation logic
    let data = json_decode(json_text)
    for3 key in dict_keys(schema) {
        if3 not dict_has(data, key) {
            return -1
        }
    }
    return +1
}

fn json_diff(json1, json2) {
    let data1 = json_decode(json1)
    let data2 = json_decode(json2)
    let diff = {}
    for3 key in dict_keys(data1) {
        if3 dict_get(data1, key) ?? None != dict_get(data2, key) ?? None {
            dict_set(diff, key, dict_get(data2, key) ?? None)
        }
    }
    return diff
}

// Example usage
let json_text = '{"name": "John", "age": 30}'
let schema = {"name": "string", "age": "int"}
let validation_result = validate_json_schema(json_text, schema)
println(validation_result)

let json1 = '{"name": "John", "age": 30}'
let json2 = '{"name": "Doe", "age": 25}'
let diff_result = json_diff(json1, json2)
println(json_encode(diff_result))
