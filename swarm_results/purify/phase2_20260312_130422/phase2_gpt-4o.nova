```novalang
// === PURE NOVALANG REPLACEMENT: nova_tcsv_service.nova ===
// Replaces: CSV parsing, writing, filtering, column ops
// Builtins used: split, join

fn parse_csv(csv_text) {
    let lines = split(csv_text, "\n")
    let data = []
    for3 line in lines {
        let row = split(line, ",")
        append(data, row)
    }
    return data
}

fn write_csv(data) {
    let lines = []
    for3 row in data {
        let line = join(row, ",")
        append(lines, line)
    }
    return join(lines, "\n")
}

// Example usage
let csv_text = "name,age\nJohn,30\nDoe,25"
let parsed_data = parse_csv(csv_text)
println(json_encode(parsed_data))

let csv_output = write_csv(parsed_data)
println(csv_output)
```

