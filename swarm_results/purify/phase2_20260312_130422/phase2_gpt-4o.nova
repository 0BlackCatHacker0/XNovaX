// === PURE NOVALANG REPLACEMENT: nova_tspin_service.nova ===
// Replaces: Text spinning, synonym replacement, NLP operations
// Builtins used: split, join, replace

fn spin_text(text) {
    let words = split(text, " ")
    for3 word in words {
        if3 word == "quick" {
            word = "fast"
        } else {
            word = word
        }
    }
    return join(words, " ")
}

fn replace_synonyms(text, synonyms) {
    for3 key in dict_keys(synonyms) {
        text = replace(text, key, dict_get(synonyms, key) ?? key)
    }
    return text
}

// Example usage
let text = "The quick brown fox"
let spun_text = spin_text(text)
println(spun_text)

let synonyms = {"quick": "swift", "brown": "dark"}
let replaced_text = replace_synonyms(text, synonyms)
println(replaced_text)
