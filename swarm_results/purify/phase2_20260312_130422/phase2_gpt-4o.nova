// === PURE NOVALANG REPLACEMENT: nova_tyaml_service.nova ===
// Replaces: YAML parsing, dumping, validation, schema checking
// Builtins used: shell, json_decode, json_encode

fn parse_yaml(yaml_text) {
    let command = format("echo '{}' | python -c 'import sys, yaml, json; print(json.dumps(yaml.safe_load(sys.stdin)))'", yaml_text)
    let result = shell(command)
    return json_decode(result)
}

fn dump_yaml(data) {
    let json_text = json_encode(data)
    let command = format("echo '{}' | python -c 'import sys, yaml, json; print(yaml.safe_dump(json.loads(sys.stdin)))'", json_text)
    let result = shell(command)
    return result
}

// Example usage
let yaml_text = "key: value"
let parsed_data = parse_yaml(yaml_text)
println(json_encode(parsed_data))

let yaml_output = dump_yaml(parsed_data)
println(yaml_output)
```

