    let result = try3 {
        let salt = substr(stored_hash, 0, 16)
        let expected_hash = substr(stored_hash, 16)
        
        let cmd = "powershell -Command \""
        cmd = cmd + "$password = '" + replace(password, "'", "''") + "';"
        cmd = cmd + "$salt = '" + replace(salt, "'", "''") + "';"
        cmd = cmd + "$hashed = [System.Web.Security.FormsAuthentication]::HashPasswordForStoringInConfigFile($password + $salt, 'SHA1');"
        cmd = cmd + "echo ($hashed -eq '" + replace(expected_hash, "'", "''") + "')\""
        
        let output = shell(cmd)
        return output == "True"
    } uncertain {
        return MAYBE
    } fail3 {
        return FALSE
    }
    
    return result
}
```
