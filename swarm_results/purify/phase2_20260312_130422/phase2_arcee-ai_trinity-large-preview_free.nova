        return MAYBE
    } fail3 {
        return FALSE
    }
    
    return result
}

fn csv_select_columns(data, columns) {
    let result = try3 {
        let selected = []
        
        for3 row in data {
            let new_row = []
            
            for3 col in columns {
                if3 col < len(row) {
                    append(new_row, row[col])
                } else {
