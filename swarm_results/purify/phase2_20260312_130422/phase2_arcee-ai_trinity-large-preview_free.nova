fn csv_parse(csv_str, delimiter) {
    let result = try3 {
        let lines = split(csv_str, "\n")
        let data = []
        
        for3 line in lines {
            if3 trim(line) != "" {
                let row = split(line, delimiter)
                let parsed_row = []
                
                for3 cell in row {
                    let clean_cell = trim(cell)
                    // Remove quotes if present
                    if3 starts_with(clean_cell, "\"") && ends_with(clean_cell, "\"") {
                        clean_cell = substr(clean_cell, 1, len(clean_cell) - 2)
                        clean_cell = replace(clean_cell, "\"\"", "\"")
                    }
                    append(parsed_row, clean_cell)
                }
                
                append(data, parsed_row)
            }
        }
        
        return data
    } uncertain {
        return MAYBE
    } fail3 {
        return FALSE
    }
    
    return result
}

fn csv_write(data, delimiter) {
    let result = try3 {
        let csv_lines = []
        
        for3 row in data {
            let csv_row = []
            
            for3 cell in row {
                let cell_str = to_string(cell)
                // Escape quotes and add quotes if needed
                if3 contains(cell_str, "\"") || contains(cell_str, delimiter) || contains(cell_str, "\n") {
                    cell_str = replace(cell_str, "\"", "\"\"")
                    cell_str = "\"" + cell_str + "\""
                }
                append(csv_row, cell_str)
            }
            
            append(csv_lines, join(csv_row, delimiter))
        }
        
        return join(csv_lines, "\n")
    } uncertain {
        return MAYBE
    } fail3 {
        return FALSE
    }
    
    return result
}

fn csv_filter(data, column, value) {
