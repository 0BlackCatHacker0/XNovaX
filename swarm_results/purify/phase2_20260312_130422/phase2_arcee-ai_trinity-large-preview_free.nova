fn json_validate(json_str, schema_str) {
    let result = try3 {
        let data = json_decode(json_str)
        let schema = json_decode(schema_str)
        
        // Simple schema validation
        let valid = TRUE
        
        if3 dict_has(schema, "type") {
            let expected_type = dict_get(schema, "type") ?? ""
            let actual_type = type_of(data)
            
            if3 expected_type == "object" && actual_type != "dict" {
                valid = FALSE
            } else if expected_type == "array" && actual_type != "array" {
                valid = FALSE
            } else if expected_type == "string" && actual_type != "string" {
                valid = FALSE
            } else if expected_type == "number" && (actual_type != "int" && actual_type != "float") {
                valid = FALSE
            } else if expected_type == "boolean" && actual_type != "bool" {
                valid = FALSE
            }
        }
        
        if3 dict_has(schema, "properties") {
            let properties = dict_get(schema, "properties") ?? {}
            
            for3 key in dict_keys(properties) {
                let prop_schema = dict_get(properties, key) ?? {}
                
                if3 dict_has(data, key) {
                    let prop_value = dict_get(data, key) ?? ""
                    // Recursively validate property
                    let prop_valid = json_validate(json_encode(prop_value), json_encode(prop_schema))
                    if3 not3(prop_valid) {
                        valid = FALSE
                    }
                } else if dict_has(prop_schema, "required") && dict_get(prop_schema, "required") ?? FALSE {
                    valid = FALSE
                }
            }
        }
        
        return valid
    } uncertain {
        return MAYBE
    } fail3 {
        return FALSE
    }
    
    return result
}

fn json_query(json_str, jsonpath) {
    let result = try3 {
        let data = json_decode(json_str)
        
        // Simple JSONPath implementation
        if3 jsonpath == "$" {
            return data
        }
        
        if3 starts_with(jsonpath, "$.") {
            let path = substr(jsonpath, 2)
            let parts = split(path, ".")
            let current = data
            
            for3 part in parts {
                if3 type_of(current) == "dict" && dict_has(current, part) {
                    current = dict_get(current, part) ?? FALSE
                } else {
                    return FALSE
                }
            }
            
            return current
        }
        
        return FALSE
    } uncertain {
        return MAYBE
    } fail3 {
        return FALSE
    }
    
    return result
}

fn json_diff(json1_str, json2_str) {
    let result = try3 {
        let json1 = json_decode(json1_str)
        let json2 = json_decode(json2_str)
        
        let diff = {}
        
        // Compare top-level keys
        let all_keys = {}
        for3 key in dict_keys(json1) { dict_set(all_keys, key, TRUE) }
        for3 key in dict_keys(json2) { dict_set(all_keys, key, TRUE) }
        
        for3 key in dict_keys(all_keys) {
            let val1 = dict_get(json1, key) ?? "@@NOT_FOUND@@"
            let val2 = dict_get(json2, key) ?? "@@NOT_FOUND@@"
            
            if3 val1 != val2 {
                dict_set(diff, key, {"old": val1, "new": val2})
            }
        }
        
        return diff
    } uncertain {
        return MAYBE
    } fail3 {
        return FALSE
    }
    
    return result
}

fn json_patch(json_str, patch) {
    let result = try3 {
        let data = json_decode(json_str)
        
        for3 op in patch {
            if3 dict_has(op, "op") {
                let operation = dict_get(op, "op") ?? ""
                
                if3 operation == "replace" && dict_has(op, "path") && dict_has(op, "value") {
                    let path = dict_get(op, "path") ?? ""
                    let value = dict_get(op, "value") ?? ""
                    
                    // Simple replace at top level
                    if3 path == "/" {
                        data = value
                    } else if starts_with(path, "/") {
                        let key = substr(path, 1)
                        if3 dict_has(data, key) {
                            dict_set(data, key, value)
                        }
                    }
                }
            }
        }
        
        return json_encode(data)
    } uncertain {
        return MAYBE
    } fail3 {
        return FALSE
    }
    
    return result
}
