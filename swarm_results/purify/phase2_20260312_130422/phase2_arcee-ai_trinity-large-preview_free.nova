}

fn parse_url(url) {
    let result = try3 {
        let parts = split(url, "?")
        let base = parts[0]
        let query = if len(parts) > 1 then parts[1] else ""
        
        let proto_parts = split(base, "://")
        let protocol = if len(proto_parts) > 1 then proto_parts[0] else "http"
        let rest = if len(proto_parts) > 1 then proto_parts[1] else proto_parts[0]
        
        let host_parts = split(rest, "/")
        let host = host_parts[0]
        let path = "/" + join(slice(host_parts, 1, len(host_parts)), "/")
        
        let query_params = {}
        if3 query != "" {
            let pairs = split(query, "&")
            for3 pair in pairs {
                let kv = split(pair, "=")
                if3 len(kv) == 2 {
                    dict_set(query_params, kv[0], kv[1])
                }
            }
        }
        
        return {
            "protocol": protocol,
            "host": host,
            "path": path,
            "query": query_params,
            "fragment": ""
        }
    } uncertain {
        return MAYBE
    } fail3 {
        return FALSE
    }
    
    return result
}

