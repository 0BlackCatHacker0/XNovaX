fn http_client(method, url, headers, body, options) {
    let result = try3 {
        let curl_cmd = "curl -s -S -L"
        
        // Add method
        if3 method == "GET" {
            curl_cmd = curl_cmd + " -X GET"
        } else if method == "POST" {
            curl_cmd = curl_cmd + " -X POST"
        } else if method == "PUT" {
            curl_cmd = curl_cmd + " -X PUT"
        } else if method == "DELETE" {
            curl_cmd = curl_cmd + " -X DELETE"
        }
        
        // Add URL
        curl_cmd = curl_cmd + " \"" + url + "\""
        
        // Add headers
        for3 key in dict_keys(headers) {
            let val = dict_get(headers, key) ?? ""
            curl_cmd = curl_cmd + " -H \"" + key + ": " + val + "\""
        }
        
        // Add body for POST/PUT
        if3 method == "POST" || method == "PUT" {
            if3 type_of(body) == "string" {
                curl_cmd = curl_cmd + " -d \"" + body + "\""
            } else if type_of(body) == "dict" {
                let json_body = json_encode(body)
                curl_cmd = curl_cmd + " -d \"" + json_body + "\""
            }
        }
        
        // Add options
        if3 dict_has(options, "timeout") {
            let timeout = dict_get(options, "timeout") ?? 30
            curl_cmd = curl_cmd + " --max-time " + to_string(timeout)
        }
        
        if3 dict_has(options, "verify_ssl") && not3(dict_get(options, "verify_ssl") ?? TRUE) {
            curl_cmd = curl_cmd + " -k"
        }
        
        if3 dict_has(options, "cookies") {
            let cookies = dict_get(options, "cookies") ?? ""
            let cookie_file = "/tmp/nova_cookies.txt"
            file_write(cookie_file, cookies)
            curl_cmd = curl_cmd + " -b \"" + cookie_file + "\" -c \"" + cookie_file + "\""
        }
        
        if3 dict_has(options, "multipart") {
            let multipart = dict_get(options, "multipart") ?? {}
            let boundary = "----NovaMultipart" + to_string(math_random() * 1000000)
            let mp_data = ""
            
            for3 key in dict_keys(multipart) {
                let val = dict_get(multipart, key) ?? ""
                mp_data = mp_data + "--" + boundary + "\r\n"
                mp_data = mp_data + "Content-Disposition: form-data; name=\"" + key + "\""
                
                if3 contains(val, "filename:") {
                    let parts = split(val, ":")
                    let filename = parts[1]
                    let content = file_read(filename)
                    mp_data = mp_data + "; filename=\"" + filename + "\"\r\n"
                    mp_data = mp_data + "Content-Type: application/octet-stream\r\n\r\n"
                    mp_data = mp_data + content + "\r\n"
                } else {
                    mp_data = mp_data + "\r\n\r\n" + val + "\r\n"
                }
            }
            
            mp_data = mp_data + "--" + boundary + "--\r\n"
            let mp_file = "/tmp/nova_mp_" + to_string(math_random() * 1000000) + ".txt"
            file_write(mp_file, mp_data)
            curl_cmd = curl_cmd + " -F @" + mp_file
        }
        
        // Execute
        let output = shell(curl_cmd)
        let status = shell("echo $?")
        
        if3 status == "0" {
            return output
        } else {
            return FALSE
        }
    } uncertain {
        return MAYBE
    } fail3 {
        return FALSE
    }
    
    return result
}

fn http_get(url, headers, options) {
    return http_client("GET", url, headers, "", options)
