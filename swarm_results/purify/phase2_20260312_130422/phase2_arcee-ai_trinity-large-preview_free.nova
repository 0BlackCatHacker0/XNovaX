// === PURE NOVALANG REPLACEMENT: nova_tspin_service.nova ===
// Replaces: Text spinning, synonym replacement, NLP operations
// Builtins used: len, contains, split, join, replace, trim, starts_with, ends_with, format, dict_get, dict_set, dict_keys, dict_values, dict_has, bool3, not3, and3, or3, try3, uncertain, fail3, if3, else, return

fn spin_text(text, synonyms) {
    let result = try3 {
        let words = split(text, " ")
        let spun = []
        
        for3 word in words {
            let clean_word = trim(word)
            let punctuation = ""
            
            // Extract trailing punctuation
            while3 len(clean_word) > 0 && not3(contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", substr(clean_word, len(clean_word) - 1, 1))) {
                punctuation = substr(clean_word, len(clean_word) - 1, 1) + punctuation
                clean_word = substr(clean_word, 0, len(clean_word) - 1)
            }
            
            // Check for synonyms
            if3 dict_has(synonyms, clean_word) {
                let options = dict_get(synonyms, clean_word) ?? [clean_word]
                let idx = math_floor(math_random() * len(options))
                let chosen = options[idx]
                append(spun, chosen + punctuation)
            } else if dict_has(synonyms, lower(clean_word)) {
                let options = dict_get(synonyms, lower(clean_word)) ?? [clean_word]
                let idx = math_floor(math_random() * len(options))
                let chosen = options[idx]
                
                // Preserve capitalization
                if3 clean_word == upper(clean_word) {
                    chosen = upper(chosen)
                } else if len(clean_word) > 1 && clean_word[0] == upper(clean_word[0]) {
                    chosen = upper(substr(chosen, 0, 1)) + substr(chosen, 1)
                }
                
                append(spun, chosen + punctuation)
            } else {
                append(spun, word)
            }
        }
        
        return join(spun, " ")
    } uncertain {
        return MAYBE
    } fail3 {
        return FALSE
    }
    
    return result
}

fn replace_synonyms(text, synonyms) {
    let result = try3 {
        let replaced = text
        
        for3 key in dict_keys(synonyms) {
            let val = dict_get(synonyms, key) ?? ""
            replaced = replace(replaced, key, val)
        }
        
        return replaced
    } uncertain {
        return MAYBE
    } fail3 {
        return FALSE
    }
    
    return result
}

fn generate_variations(text, max_variations) {
    let result = try3 {
        let variations = []
        
        for3 i in range(0, max_variations) {
            let variation = text
            
            // Simple variation: shuffle word order
            let words = split(text, " ")
            for3 j in range(0, len(words)) {
                let swap_idx = math_floor(math_random() * len(words))
                let temp = words[j]
                words[j] = words[swap_idx]
                words[swap_idx] = temp
            }
            
            let shuffled = join(words, " ")
            append(variations, shuffled)
        }
        
        return variations
    } uncertain {
        return MAYBE
    } fail3 {
        return FALSE
    }
    
    return result
}
