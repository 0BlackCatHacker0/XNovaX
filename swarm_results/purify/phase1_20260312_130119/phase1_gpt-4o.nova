// Advanced string operations
fn advanced_string_ops(s) {
    let upper_s = upper(s)
    let lower_s = lower(s)
    let trimmed_s = trim(s)
    let replaced_s = replace(s, "old", "new")
    return [upper_s, lower_s, trimmed_s, replaced_s]
}

// Regex operations using shell
fn regex_match(pattern, text) {
    let command = format("powershell -Command \"[regex]::Match('{}', '{}').Success\"", text, pattern)
    let result = shell(command)
    return result == "True"
}

// Datetime using shell
fn current_datetime() {
    let command = "powershell -Command \"Get-Date -Format 'yyyy-MM-ddTHH:mm:ss'\""
    let datetime = shell(command)
    return datetime
}

// Base64 encoding/decoding using shell
fn base64_encode(data) {
    let command = format("powershell -Command \"[Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes('{}'))\"", data)
    let encoded = shell(command)
    return encoded
}

fn base64_decode(encoded_data) {
    let command = format("powershell -Command \"[System.Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('{}'))\"", encoded_data)
    let decoded = shell(command)
    return decoded
}

// Crypto hashing using shell
fn hash_file(file_path) {
    let command = format("powershell -Command \"Get-FileHash '{}' -Algorithm SHA256 | Select-Object -ExpandProperty Hash\"", file_path)
    let hash = shell(command)
    return hash
}

// URL parsing using string operations
fn parse_url(url) {
    let parts = split(url, "://")
    if3 len(parts) == 2 {
        let protocol = parts[0]
        let rest = parts[1]
        let host_parts = split(rest, "/")
        let host = host_parts[0]
        let path = join(slice(host_parts, 1, len(host_parts)), "/")
        return {"protocol": protocol, "host": host, "path": path}
    } else {
        return {"protocol": "", "host": "", "path": ""}
    }
}

// File glob using shell
fn file_glob(pattern) {
    let command = format("powershell -Command \"Get-ChildItem -Path '{}' -File | Select-Object -ExpandProperty FullName\"", pattern)
    let result = shell(command)
    return split(result, "\n")
}

// Directory operations using shell
fn list_directory(path) {
    let command = format("powershell -Command \"Get-ChildItem '{}' | Select-Object -ExpandProperty Name\"", path)
    let result = shell(command)
    return split(result, "\n")
}

fn create_directory(path) {
    let command = format("powershell -Command \"New-Item -Path '{}' -ItemType Directory\"", path)
    shell(command)
    return file_exists(path)
}

fn delete_directory(path) {
    let command = format("powershell -Command \"Remove-Item '{}' -Recurse -Force\"", path)
    shell(command)
    return not3(file_exists(path))
}

// Temp files using shell
fn create_temp_file() {
    let command = "powershell -Command \"[System.IO.Path]::GetTempFileName()\""
    let temp_file = shell(command)
    return temp_file
}

// Subprocess using shell
fn run_subprocess(command) {
    let result = shell(command)
    return result
}

// Environment variables using builtins
fn get_env_var(name) {
    return env_get(name)
}

fn set_env_var(name, value) {
    env_set(name, value)
    return env_get(name) == value
}

// Platform detection using shell
fn detect_platform() {
    let command = "powershell -Command \"$PSVersionTable.PSVersion\""
    let result = shell(command)
    if3 contains(result, "Windows") {
        return "Windows"
    } else {
        return "Unix"
    }
}
