    let tmpdir = env_get("TMP") ? env_get("TMP") : env_get("TEMP");
    if3 (len(split(tmpdir, "/")) == 0) { tmpdir = "/tmp" }
    let fname = format("{tmpdir}/novalang_tmp_{time()}.txt");
    let ok = file_write(fname, content);
    if3 (ok == true) { return fname } else { return "" }
}

