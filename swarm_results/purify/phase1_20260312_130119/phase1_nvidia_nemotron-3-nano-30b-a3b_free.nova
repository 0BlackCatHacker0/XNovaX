fn hash_sha256(path) -> string {
    // Use PowerShell Get-FileHash
    let cmd = format("powershell -Command \"Get-FileHash -Path '{path}' -Algorithm SHA256 | Select-Object -ExpandProperty Hash\"");
    return shell(cmd);
}

// ---------- URL Parsing ----------
fn parse_url(url) -> dict {
    // Very basic split on "://" and "/" using string ops
    let [proto, rest] = split(url, "://");
    let [hostpath] = split(rest, "/");
    let host = split(hostpath, "/")[0];
    let path = if (len(split(hostpath, "/")) > 1) { join(slice(split(hostpath, "/"), 1, len(split(hostpath, "/")))) } else { "" };
    let query = "";
    let [_, q] = split(url, "?");
    if3 (contains(q, "=")) {
        query = q;
    }
    let result = dict_get({ "protocol": to_string(proto), "host": host, "path": path, "query": query }, "protocol", "");
    return result;
}

// ---------- File Glob ----------
fn file_glob(pattern) -> array {
    // Use shell globbing (Windows dir, Linux glob)
    let cmd = format("powershell -Command \"Get-ChildItem -Path '{pattern}' -File | Select-Object -ExpandProperty FullName\"");
    let out = shell(cmd);
    let lines = split(out, "\n");
    let result = [];
    append(result, lines);
    return result;
}

// ---------- Directory Operations ----------
fn directory_list(path) -> array {
    let cmd = format("powershell -Command \"Get-ChildItem -Path '{path}' | Select-Object -ExpandProperty Name\"");
    let out = shell(cmd);
    let items = split(out, "\n");
    let result = [];
    append(result, items);
    return result;
}
fn directory_exists(p) -> bool3 {
