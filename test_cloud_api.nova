import3("nova_cloud_api.nova")

// Test: Config loading
let cfg = load_cloud_config()
print("Config providers: " + str(len(keys(cfg))))

// Test: Live OpenAI call
print("Calling OpenAI gpt-4o-mini...")
let t0 = time()
let result = cloud_call("openai", "gpt-4o-mini", "Say hello in exactly 3 words.", "")
let elapsed = floor((time() - t0) * 1000)
print("OK: " + str(dict_get(result, "ok") ?? false))
print("Response: " + dict_get(result, "response") ?? "NO_RESPONSE")
print("Time: " + str(elapsed) + "ms")
