let mid = "novax-falcon3:latest"
let r = contains(mid, "falcon")
print("raw: " + str(r))
print("== 1: " + str(r == 1))
print("== true: " + str(r == true))
if3 r { print("bare if3: YES") }
if3 contains(mid, "falcon") { print("inline if3: YES") }
if3 contains(mid, "falcon") == true { print("== true: YES") }
