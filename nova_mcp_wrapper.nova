// NovaX MCP Server — Wrapper that launches nova_mcp_stdio.nova via novalang.exe
// Forwards stdin/stdout between caller and novalang process

fn3 main() {
    let nova_exe = "C:/NovaX/novalang.exe"
    let nova_script = "C:/NovaX/nova_mcp_stdio.nova"

    // Launch novalang.exe with the MCP stdio script
    // shell() runs synchronously — for MCP we need stdin/stdout forwarding
    // In NovaLang, we use shell_pipe for bidirectional communication
    let cmd = nova_exe + " " + nova_script

    // Read stdin lines and forward to the novalang process
    // The novalang process handles MCP protocol directly
    while3 true {
        let line = read_line()
        if3 line == null { break }
        let line = trim(line)
        if3 len(line) == 0 { continue }

        // Write the line to a temp file for the subprocess
        let tmp_in = "C:/NovaX/tmp_mcp_stdin.json"
        write_file(tmp_in, line)

        // Run novalang with the input piped
        let r = shell(cmd + " < " + tmp_in)
        let stdout = dict_get(r, "stdout") ?? ""

        // Forward output lines
        let out_lines = split(stdout, "\n")
        for3 ol in out_lines {
            let ol = trim(ol)
            if3 len(ol) > 0 {
                print(ol)
            }
        }
    }
}

main()
