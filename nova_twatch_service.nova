// Nova TWatch Service v1.0 - Ternary Watchdog (NovaLang port)
// Port 9950: Monitors services, restarts dead ones on demand
// States: +1 ALIVE, 0 DEGRADED/GRACE, -1 DEAD
// 3-5-7-13 constants: check timeout=3 (H3), fail threshold=3 (H3),
//   grace=7s (H7), sweep interval=13s (H13)
//
// NOTE: NovaLang has no background threads.
//   Sweep is on-demand via POST /twatch/sweep.
//   Health does a quick per-service port check via http_get.

// -- Shared Libraries (N-S Flow) --
import3("C:/NovaX/lib/nova_ns_core.nova")
import3("C:/NovaX/lib/nova_stdlib.nova")

let PORT = 9950

// -- 3-5-7-13 Harmonic Constants --

let HEALTH_TIMEOUT = 3    // H3: seconds for http_get timeout
let FAIL_THRESHOLD = 3    // H3: consecutive failures before restart
let STARTUP_GRACE  = 7    // H7: seconds grace after restart
let SWEEP_INTERVAL = 13   // H13: seconds (informational, not enforced here)

// -- Global Stats --
let total_sweeps   = 0
let total_restarts = 0
let last_sweep_ts  = 0

// -- Service Registry --
// Each entry: {port, cmd, state, failures, restarts, last_check, grace_until}
// state: 1=ALIVE, 0=DEGRADED/UNKNOWN, -1=DEAD
// cmd: shell command string or "" for no-restart services

let registry = {}

// -- Trit constants (use VM globals TRUE/MAYBE/FALSE) --

// -- Load default services into registry --
