// -- Check a single port via http_get --
// Returns TRUE (+1) if alive, FALSE (-1) if dead
fn check_port(port) {
    let url = "http://127.0.0.1:" + str(port) + "/health"
    try3 {
        let resp = http_get(url, HEALTH_TIMEOUT)
        return TRUE
    } catch3 {
        return FALSE
    }
}

// -- Restart a service via nova_run (start /b = no window) --
// Returns TRUE if command launched, FALSE if no cmd or empty cmd
fn restart_service(name) {
    let svc = dict_get(registry, name)
    let cmd = dict_get(svc, "cmd")
    if3 cmd == "" {
        return FALSE  // no-restart service (orchestrator, nova-cortex, etc.)
    } else cmd == FALSE {
        return FALSE
    } else {
        try3 {
            nova_run(cmd)
            // Update state fields in registry entry
            let now = time()
            let grace_ts = now + STARTUP_GRACE
            svc = dict_set(svc, "state",       MAYBE)
            svc = dict_set(svc, "failures",    0)
            svc = dict_set(svc, "restarts",    dict_get(svc, "restarts") + 1)
            svc = dict_set(svc, "last_check",  now)
            svc = dict_set(svc, "grace_until", grace_ts)
            registry = dict_set(registry, name, svc)
            total_restarts = total_restarts + 1
            return TRUE
        } catch3 {
            return FALSE
        }
    }
}

// -- Check one service, update its registry state, return result dict --
fn check_one(name) {
    let svc = dict_get(registry, name)
    let now = time()

    // Still in startup grace window? Skip check, report GRACE
    let grace_until = dict_get(svc, "grace_until")
    if3 now < grace_until {
        return {"name": name, "state": "GRACE", "trit": MAYBE, "port": dict_get(svc, "port")}
    } else grace_until == FALSE {
        // grace_until key missing - proceed with check
    } else {
        // grace expired - proceed with check
    }

    let port = dict_get(svc, "port")
    let alive = check_port(port)

    // Update registry state
    if3 alive == TRUE {
        svc = dict_set(svc, "state",      TRUE)
        svc = dict_set(svc, "failures",   0)
        svc = dict_set(svc, "last_check", now)
        registry = dict_set(registry, name, svc)
        return {"name": name, "state": "ALIVE", "trit": TRUE, "port": port}
    } else alive == MAYBE {
        // Should not happen from check_port, treat as dead
        svc = dict_set(svc, "failures",   dict_get(svc, "failures") + 1)
        svc = dict_set(svc, "last_check", now)
        registry = dict_set(registry, name, svc)
        return {"name": name, "state": "DEGRADED", "trit": MAYBE, "port": port}
    } else {
        // Dead path: increment failures
        let fails = dict_get(svc, "failures") + 1
        svc = dict_set(svc, "failures",   fails)
        svc = dict_set(svc, "last_check", now)

        if3 fails >= FAIL_THRESHOLD {
            // Attempt restart
            svc = dict_set(svc, "state", FALSE)
            registry = dict_set(registry, name, svc)
            let restarted = restart_service(name)
            if3 restarted == TRUE {
                return {"name": name, "state": "RESTARTING", "trit": MAYBE, "port": port, "restarts": dict_get(dict_get(registry, name), "restarts")}
            } else restarted == MAYBE {
                return {"name": name, "state": "DEAD", "trit": FALSE, "port": port, "failures": fails}
            } else {
                return {"name": name, "state": "DEAD", "trit": FALSE, "port": port, "failures": fails}
            }
        } else fails == FAIL_THRESHOLD {
            registry = dict_set(registry, name, svc)
            return {"name": name, "state": "DEGRADED", "trit": MAYBE, "port": port, "failures": fails, "threshold": FAIL_THRESHOLD}
        } else {
            registry = dict_set(registry, name, svc)
            return {"name": name, "state": "DEGRADED", "trit": MAYBE, "port": port, "failures": fails, "threshold": FAIL_THRESHOLD}
        }
    }
}

// -- Full sweep: check every registered service --
fn do_sweep() {
    let svc_names = keys(registry)
    let results = {}
    let alive_count = 0
    let dead_count  = 0
    let grace_count = 0

    let i = 0
    let total = len(svc_names)
    while3 i < total {
        let name = svc_names[i]
        let res  = check_one(name)
        results = dict_set(results, name, res)
        let t = dict_get(res, "trit")
        if3 t == TRUE { alive_count = alive_count + 1
        } else t == MAYBE { grace_count = grace_count + 1
        } else { dead_count = dead_count + 1
        }
        i = i + 1
    }

    total_sweeps  = total_sweeps + 1
    last_sweep_ts = time()

    let sweep_trit = TRUE
    if3 dead_count > 0 {
        sweep_trit = MAYBE
        if3 dead_count >= H3 {
            sweep_trit = FALSE
        }
    }

    return {
        "ok": true,
        "trit": sweep_trit,
        "alive": alive_count,
        "dead": dead_count,
        "grace": grace_count,
        "total": total,
        "sweep_number": total_sweeps,
        "results": results,
        "runtime": "novalang",
        "ternary": true
    }
}

// ================================================================
// Route Handlers
// ================================================================

// GET /health -- quick self + port-check summary
fn health() {
    // Use cached registry state (no live probing -- sweeps handle that)
    let svc_names = keys(registry)
    let total = len(svc_names)
    let alive_count = 0
    let dead_count  = 0

    let i = 0
    while3 i < total {
        let name = svc_names[i]
        let svc  = dict_get(registry, name)
        let status = dict_get(svc, "status")
        if3 status == "" { status = "unknown" }
        if3 status == "alive" { alive_count = alive_count + 1
        } else { dead_count = dead_count + 1
        }
        i = i + 1
    }

    let counters = {}
    counters = dict_set(counters, "watching", total)
    counters = dict_set(counters, "alive", alive_count)
    counters = dict_set(counters, "dead", dead_count)
    counters = dict_set(counters, "total_sweeps", total_sweeps)
    counters = dict_set(counters, "total_restarts", total_restarts)
    let resp = ns_health_dict("nova-twatch", "1.0", PORT, counters)
    resp = dict_set(resp, "runtime", "novalang")
    resp = dict_set(resp, "last_sweep", last_sweep_ts)
    resp = dict_set(resp, "constants", {
        "health_timeout": HEALTH_TIMEOUT,
        "fail_threshold": FAIL_THRESHOLD,
        "startup_grace":  STARTUP_GRACE,
        "sweep_interval": SWEEP_INTERVAL
    })
    return resp
}

// GET /twatch/status -- full registry state (no live checks, reads stored state)
fn twatch_status() {
    let svc_names = keys(registry)
    let total = len(svc_names)
    let alive_count   = 0
    let dead_count    = 0
    let degraded_count = 0
    let states = {}

    let i = 0
    while3 i < total {
        let name = svc_names[i]
        let svc  = dict_get(registry, name)
        let st   = dict_get(svc, "state")
        let state_label = "UNKNOWN"
        if3 st == TRUE { state_label = "ALIVE"
            alive_count = alive_count + 1
        } else st == FALSE { state_label = "DEAD"
            dead_count  = dead_count + 1
        } else { state_label = "DEGRADED"
            degraded_count = degraded_count + 1
        }
        let has_cmd = dict_get(svc, "cmd") != ""
        states = dict_set(states, name, {
            "port":       dict_get(svc, "port"),
            "state":      state_label,
            "trit":       st,
            "failures":   dict_get(svc, "failures"),
            "restarts":   dict_get(svc, "restarts"),
            "last_check": round(dict_get(svc, "last_check"), 1),
            "grace_until": dict_get(svc, "grace_until"),
            "has_cmd":    has_cmd
        })
        i = i + 1
    }

    let summary_trit = TRUE
    if3 dead_count > 0 {
        summary_trit = MAYBE
        if3 dead_count >= H3 {
            summary_trit = FALSE
        }
    }

    return {
        "ok": true,
        "ternary": true,
        "runtime": "novalang",
        "trit": summary_trit,
        "alive": alive_count,
        "degraded": degraded_count,
        "dead": dead_count,
        "total": total,
        "total_sweeps": total_sweeps,
        "total_restarts": total_restarts,
        "last_sweep": last_sweep_ts,
        "sweep_interval": SWEEP_INTERVAL,
        "services": states
    }
}

// POST /twatch/check -- check one specific service right now
fn twatch_check(body) {
    let name = dict_get(body, "name")
    if3 name == FALSE {
        return {"ok": false, "trit": FALSE, "error": "name required"}
    } else name == "" {
        return {"ok": false, "trit": FALSE, "error": "name required"}
    } else { has = dict_has(registry, name)
        if3 has == TRUE { res = check_one(name)
            return {"ok": true, "trit": dict_get(res, "trit"), "result": res}
        } else has == MAYBE {
            return {"ok": false, "trit": FALSE, "error": "unknown service: " + str(name)}
        } else {
            return {"ok": false, "trit": FALSE, "error": "unknown service: " + str(name)}
        }
    }
}

// POST /twatch/register -- add a new service to the watch list
fn twatch_register(body) {
    let name = dict_get(body, "name")
    let port = dict_get(body, "port")
    let cmd  = dict_get(body, "cmd")

    if3 name == FALSE {
        return {"ok": false, "trit": FALSE, "error": "name and port required"}
    } else port == FALSE {
        return {"ok": false, "trit": FALSE, "error": "name and port required"}
    } else {
        // Default cmd to empty string if not provided
        let safe_cmd = ""
        if3 cmd == FALSE { safe_cmd = ""
        } else cmd == "" { safe_cmd = ""
        } else { safe_cmd = str(cmd)
        }

        registry = dict_set(registry, name, {
            "port":       int(port),
            "cmd":        safe_cmd,
            "state":      MAYBE,
            "failures":   0,
            "restarts":   0,
            "last_check": 0,
            "grace_until": 0
        })

        return {
            "ok": true,
            "trit": TRUE,
            "name": name,
            "port": int(port),
            "watching": len(keys(registry))
        }
    }
}

// POST /twatch/unregister -- remove a service from the watch list
fn twatch_unregister(body) {
    let name = dict_get(body, "name")
    if3 name == FALSE {
        return {"ok": false, "trit": FALSE, "error": "name required"}
    } else name == "" {
        return {"ok": false, "trit": FALSE, "error": "name required"}
    } else { has = dict_has(registry, name)
        if3 has == TRUE {
            registry = dict_del(registry, name)
            return {"ok": true, "trit": TRUE, "removed": name, "watching": len(keys(registry))}
        } else has == MAYBE {
            return {"ok": false, "trit": FALSE, "error": "not found: " + str(name)}
        } else {
            return {"ok": false, "trit": FALSE, "error": "not found: " + str(name)}
        }
    }
}

// POST /twatch/restart -- force-restart one service immediately
fn twatch_restart(body) {
    let name = dict_get(body, "name")
    if3 name == FALSE {
        return {"ok": false, "trit": FALSE, "error": "name required"}
    } else name == "" {
        return {"ok": false, "trit": FALSE, "error": "name required"}
    } else { has = dict_has(registry, name)
        if3 has == FALSE {
            return {"ok": false, "trit": FALSE, "error": "unknown service: " + str(name)}
        } else has == MAYBE {
            return {"ok": false, "trit": FALSE, "error": "unknown service: " + str(name)}
        } else { svc = dict_get(registry, name)
            let cmd = dict_get(svc, "cmd")
            if3 cmd == "" {
                return {"ok": false, "trit": FALSE, "error": str(name) + " has no restart command (manual-only)"}
            } else cmd == FALSE {
                return {"ok": false, "trit": FALSE, "error": str(name) + " has no restart command (manual-only)"}
            } else { ok = restart_service(name)
                let svc_after = dict_get(registry, name)
                return {
                    "ok": ok == TRUE,
                    "trit": ok,
                    "name": name,
                    "restarts": dict_get(svc_after, "restarts"),
                    "grace_until": dict_get(svc_after, "grace_until")
                }
            }
        }
    }
}

// POST /twatch/sweep -- on-demand full sweep across all services
fn twatch_sweep(body) {
    let result = do_sweep()
    return result
}

// ================================================================
// Boot: initialise registry and wire up routes
// ================================================================

init_services()

let svc_count = len(keys(registry))
print("[TWatch] NovaLang TWatch v1.0 - Ternary Watchdog")
print("[TWatch] Port: " + str(PORT) + " | Runtime: NovaLang | Ternary: TRUE")
print("[TWatch] Watching " + str(svc_count) + " services")
print("[TWatch] H3=" + str(H3) + " H5=" + str(H5) + " H7=" + str(H7) + " H13=" + str(H13))
print("[TWatch] Fail threshold: " + str(FAIL_THRESHOLD) + " | Grace: " + str(STARTUP_GRACE) + "s | Sweep interval: " + str(SWEEP_INTERVAL) + "s")
print("[TWatch] NOTE: No background thread - sweep is on-demand via POST /twatch/sweep")

let server = tserve(PORT, "TWatch v1.0 - Ternary Watchdog")

troute(server, "GET",  "/health",           "health")
troute(server, "GET",  "/twatch/status",    "twatch_status")
troute(server, "POST", "/twatch/check",     "twatch_check")
troute(server, "POST", "/twatch/register",  "twatch_register")
troute(server, "POST", "/twatch/unregister","twatch_unregister")
troute(server, "POST", "/twatch/restart",   "twatch_restart")
troute(server, "POST", "/twatch/sweep",     "twatch_sweep")

print("[TWatch] Routes: /health, /twatch/status, /twatch/check, /twatch/register, /twatch/unregister, /twatch/restart, /twatch/sweep")

tstart(server)
