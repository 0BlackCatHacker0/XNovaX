    registry = dict_set(registry, "websocket",          {"port": 9998, "cmd": "start /b C:\\Users\\Jupit\\AppData\\Local\\Programs\\Python\\Python312\\pythonw.exe C:\\NovaX\\ws_server.py",            "state": 0, "failures": 0, "restarts": 0, "last_check": 0, "grace_until": 0})
    registry = dict_set(registry, "nova-stt",           {"port": 9875, "cmd": "start /b C:\\Users\\Jupit\\AppData\\Local\\Programs\\Python\\Python312\\pythonw.exe C:\\NovaX\\nova_stt.py",             "state": 0, "failures": 0, "restarts": 0, "last_check": 0, "grace_until": 0})
    registry = dict_set(registry, "nova-tts",           {"port": 9874, "cmd": "start /b C:\\Users\\Jupit\\AppData\\Local\\Programs\\Python\\Python312\\pythonw.exe C:\\NovaX\\nova_tts.py",             "state": 0, "failures": 0, "restarts": 0, "last_check": 0, "grace_until": 0})
    registry = dict_set(registry, "nova-cortex",        {"port": 9879, "cmd": "", "state": 0, "failures": 0, "restarts": 0, "last_check": 0, "grace_until": 0})
    registry = dict_set(registry, "nova-tzip",          {"port": 9885, "cmd": "start /b C:\\Users\\Jupit\\AppData\\Local\\Programs\\Python\\Python312\\pythonw.exe C:\\NovaX\\nova_tzip.py",            "state": 0, "failures": 0, "restarts": 0, "last_check": 0, "grace_until": 0})
    registry = dict_set(registry, "nova-appcontrol",    {"port": 9887, "cmd": "start /b C:\\Users\\Jupit\\AppData\\Local\\Programs\\Python\\Python312\\pythonw.exe C:\\NovaX\\nova_appcontrol.py",      "state": 0, "failures": 0, "restarts": 0, "last_check": 0, "grace_until": 0})
