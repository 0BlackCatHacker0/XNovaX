    registry = dict_set(registry, "nova-cloud-router",  {"port": 9878, "cmd": "start /b C:\\Users\\Jupit\\AppData\\Local\\Programs\\Python\\Python312\\pythonw.exe C:\\NovaX\\nova_cloud_router.py",   "state": 0, "failures": 0, "restarts": 0, "last_check": 0, "grace_until": 0})
    registry = dict_set(registry, "nova-sentinel",      {"port": 9876, "cmd": "start /b C:\\Users\\Jupit\\AppData\\Local\\Programs\\Python\\Python312\\pythonw.exe C:\\NovaX\\nova_sentinel.py",        "state": 0, "failures": 0, "restarts": 0, "last_check": 0, "grace_until": 0})
    registry = dict_set(registry, "nova-nexus",         {"port": 9882, "cmd": "start /b C:\\Users\\Jupit\\AppData\\Local\\Programs\\Python\\Python312\\pythonw.exe C:\\NovaX\\nova_nexus.py",           "state": 0, "failures": 0, "restarts": 0, "last_check": 0, "grace_until": 0})
    registry = dict_set(registry, "nova-deepstorage",   {"port": 9893, "cmd": "start /b C:\\Users\\Jupit\\AppData\\Local\\Programs\\Python\\Python312\\pythonw.exe C:\\NovaX\\nova_deepstorage.py",     "state": 0, "failures": 0, "restarts": 0, "last_check": 0, "grace_until": 0})
    registry = dict_set(registry, "nova-vault",         {"port": 9884, "cmd": "start /b C:\\Users\\Jupit\\AppData\\Local\\Programs\\Python\\Python312\\pythonw.exe C:\\NovaX\\nova_vault.py",           "state": 0, "failures": 0, "restarts": 0, "last_check": 0, "grace_until": 0})
    registry = dict_set(registry, "nova-tbuffer",       {"port": 9886, "cmd": "start /b C:\\Users\\Jupit\\AppData\\Local\\Programs\\Python\\Python312\\pythonw.exe C:\\NovaX\\nova_tbuffer.py",         "state": 0, "failures": 0, "restarts": 0, "last_check": 0, "grace_until": 0})
    registry = dict_set(registry, "nova-tbus",          {"port": 9945, "cmd": "start /b C:\\Users\\Jupit\\AppData\\Local\\Programs\\Python\\Python312\\pythonw.exe C:\\NovaX\\nova_tbus.py",            "state": 0, "failures": 0, "restarts": 0, "last_check": 0, "grace_until": 0})
    registry = dict_set(registry, "nova-tresilience",   {"port": 9948, "cmd": "start /b C:\\Users\\Jupit\\AppData\\Local\\Programs\\Python\\Python312\\pythonw.exe C:\\NovaX\\nova_tresilience.py",     "state": 0, "failures": 0, "restarts": 0, "last_check": 0, "grace_until": 0})
    registry = dict_set(registry, "nova-tintelligence", {"port": 9924, "cmd": "start /b C:\\Users\\Jupit\\AppData\\Local\\Programs\\Python\\Python312\\pythonw.exe C:\\NovaX\\nova_tintelligence.py",   "state": 0, "failures": 0, "restarts": 0, "last_check": 0, "grace_until": 0})
    registry = dict_set(registry, "nova-novacore",      {"port": 9890, "cmd": "start /b C:\\Users\\Jupit\\AppData\\Local\\Programs\\Python\\Python312\\pythonw.exe C:\\NovaX\\nova_novacore.py",        "state": 0, "failures": 0, "restarts": 0, "last_check": 0, "grace_until": 0})
    registry = dict_set(registry, "nova-tsecurity",     {"port": 9888, "cmd": "start /b C:\\Users\\Jupit\\AppData\\Local\\Programs\\Python\\Python312\\pythonw.exe C:\\NovaX\\nova_tsecurity.py",       "state": 0, "failures": 0, "restarts": 0, "last_check": 0, "grace_until": 0})
    registry = dict_set(registry, "nova-exec",          {"port": 9877, "cmd": "start /b C:\\Users\\Jupit\\AppData\\Local\\Programs\\Python\\Python312\\pythonw.exe C:\\NovaX\\launchers\\exec_server.py", "state": 0, "failures": 0, "restarts": 0, "last_check": 0, "grace_until": 0})
    registry = dict_set(registry, "nova-tnet",          {"port": 9889, "cmd": "start /b C:\\Users\\Jupit\\AppData\\Local\\Programs\\Python\\Python312\\pythonw.exe C:\\NovaX\\nova_tnet.py",            "state": 0, "failures": 0, "restarts": 0, "last_check": 0, "grace_until": 0})
