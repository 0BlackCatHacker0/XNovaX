        return {"ok": false, "trit": T_FALSE, "error": "data is required"}
    } else {
        // ok
    }
    if3 field_a == null {
        return {"ok": false, "trit": T_FALSE, "error": "field_a is required"}
    } else {
        // ok
    }
    if3 field_b == null {
        return {"ok": false, "trit": T_FALSE, "error": "field_b is required"}
    } else {
        // ok
    }
    let data_size = len(json_encode(data))
    let re = payload_reynolds(data_size, FMT_JSON)
    let regime = reynolds_regime(re)
    try3 {
        let res = do_correlation(data, field_a, field_b)
        let res_ok = dict_get(res, "ok") ?? false
        if3 res_ok == false {
            return {"ok": false, "trit": T_FALSE, "error": dict_get(res, "error") ?? "correlation failed"}
        } else {
            return {"ok": true, "trit": dict_get(res, "trit") ?? 0, "field_a": dict_get(res, "field_a") ?? "", "field_b": dict_get(res, "field_b") ?? "", "r": dict_get(res, "r") ?? 0, "r_squared": dict_get(res, "r_squared") ?? 0, "strength": dict_get(res, "strength") ?? "", "direction": dict_get(res, "direction") ?? "", "count": dict_get(res, "count") ?? 0, "reynolds": re, "flow_regime": regime}
    } else {
        return {"ok": false, "trit": T_FALSE, "error": "correlation exception"}
    }
}

// ============================================================
// DELEGATE: do_resample — resample time-series into fixed intervals
// ============================================================
}
fn do_resample(data_json_str, time_field, interval, agg, value_field) {
    let args = json_encode({"op": "resample", "data": data_json_str, "time_field": time_field, "interval": interval, "agg": agg, "value_field": value_field})
    nova_write("C:/NovaX/tmp_talchemy_args.json", args)
    let res_str = nova_run("C:/NovaX/novalang.exe C:/NovaX/talchemy_helper.nova C:/NovaX/tmp_talchemy_args.json")
    return json_decode(res_str)
}

// ============================================================
// DELEGATE: do_interpolate — fill missing values in time-series
// ============================================================
fn do_interpolate(data_json_str, time_field, value_field, method) {
    let args = json_encode({"op": "interpolate", "data": data_json_str, "time_field": time_field, "value_field": value_field, "method": method})
