    return json_decode(res_str)
}

// ============================================================
// ROUTE: POST /talchemy/resample
// ============================================================
fn talchemy_resample(body) {
    let data = dict_get(body, "data") ?? null
    let time_field = dict_get(body, "time_field") ?? "ts"
    let interval = dict_get(body, "interval") ?? 60
    let agg = dict_get(body, "agg") ?? "avg"
    let value_field = dict_get(body, "value_field") ?? "value"
    if3 data == null {
        return {"ok": false, "trit": T_FALSE, "error": "data is required"}
    } else {
        // ok
    }
    let data_size = len(json_encode(data))
    let re = payload_reynolds(data_size, FMT_JSON)
    let regime = reynolds_regime(re)
    try3 {
        let res = do_resample(data, time_field, interval, agg, value_field)
        let res_ok = dict_get(res, "ok") ?? false
        if3 res_ok == false {
            return {"ok": false, "trit": T_FALSE, "error": dict_get(res, "error") ?? "resample failed"}
        } else {
            return {"ok": true, "trit": dict_get(res, "trit") ?? 0, "buckets": dict_get(res, "buckets") ?? [], "count": dict_get(res, "count") ?? 0, "interval": dict_get(res, "interval") ?? 0, "empty_buckets": dict_get(res, "empty_buckets") ?? 0, "reynolds": re, "flow_regime": regime}
    } else {
        return {"ok": false, "trit": T_FALSE, "error": "resample exception"}
    }
}

