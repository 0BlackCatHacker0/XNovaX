}

// ============================================================
// ROUTE: POST /talchemy/validate/rows
// Validate an array of rows against column-level rules.
// Rules: [{column, type, required?, min?, max?, pattern?, values?}]
// Trit: +1 all valid, 0 <10% errors, -1 >=10% errors
// ============================================================
fn talchemy_validate_rows(body) {
    let data = dict_get(body, "data") ?? null
    let rules = dict_get(body, "rules") ?? null
    if3 data == null {
        return {"ok": false, "trit": T_FALSE, "error": "data is required"}
    } else {
        // ok
    }
    if3 rules == null {
        return {"ok": false, "trit": T_FALSE, "error": "rules is required"}
    } else {
        // ok
    }
    let data_size = len(json_encode(data))
    let re = payload_reynolds(data_size, FMT_JSON)
    let regime = reynolds_regime(re)
    try3 {
        let res = do_validate_rows(data, rules)
        let res_ok = dict_get(res, "ok") ?? false
        if3 res_ok == false {
            return {"ok": false, "trit": T_FALSE, "error": dict_get(res, "error") ?? "validate failed"}
        } else {
            return {"ok": true, "trit": dict_get(res, "trit") ?? 0, "total_rows": dict_get(res, "total_rows") ?? 0, "valid_rows": dict_get(res, "valid_rows") ?? 0, "invalid_rows": dict_get(res, "invalid_rows") ?? 0, "errors": dict_get(res, "errors") ?? [], "reynolds": re, "flow_regime": regime}
    } else {
        return {"ok": false, "trit": T_FALSE, "error": "validate rows exception"}
    }
}

// ============================================================
// ROUTE: POST /talchemy/schema
// Auto-infer schema from tabular data: column names, types,
// nullable, unique count, min/max for numerics, sample values (H13).
// ============================================================
}
fn talchemy_schema(body) {
    let data = dict_get(body, "data") ?? null
    if3 data == null {
        return {"ok": false, "trit": T_FALSE, "error": "data is required"}
    } else {
        // ok
    }
    let data_size = len(json_encode(data))
    let re = payload_reynolds(data_size, FMT_JSON)
    let regime = reynolds_regime(re)
    try3 {
        let res = do_schema_infer(data)
        let res_ok = dict_get(res, "ok") ?? false
        if3 res_ok == false {
            return {"ok": false, "trit": T_FALSE, "error": dict_get(res, "error") ?? "schema infer failed"}
        } else {
            return {"ok": true, "trit": dict_get(res, "trit") ?? 0, "columns": dict_get(res, "columns") ?? [], "row_count": dict_get(res, "row_count") ?? 0, "reynolds": re, "flow_regime": regime}
    } else {
        return {"ok": false, "trit": T_FALSE, "error": "schema infer exception"}
    }
}

// ============================================================
// ROUTE: POST /talchemy/quality
// Compute data quality metrics: completeness, type consistency,
// quality score 0-100. Trit: 70+=+1, 40-70=0, <40=-1.
// ============================================================
}
fn talchemy_quality(body) {
    let data = dict_get(body, "data") ?? null
    if3 data == null {
        return {"ok": false, "trit": T_FALSE, "error": "data is required"}
    } else {
        // ok
    }
    let data_size = len(json_encode(data))
    let re = payload_reynolds(data_size, FMT_JSON)
    let regime = reynolds_regime(re)
    try3 {
        let res = do_quality_score(data)
        let res_ok = dict_get(res, "ok") ?? false
        if3 res_ok == false {
            return {"ok": false, "trit": T_FALSE, "error": dict_get(res, "error") ?? "quality failed"}
        } else {
            return {"ok": true, "trit": dict_get(res, "trit") ?? 0, "score": dict_get(res, "score") ?? 0, "completeness": dict_get(res, "completeness") ?? 0, "consistency": dict_get(res, "consistency") ?? 0, "columns": dict_get(res, "columns") ?? [], "reynolds": re, "flow_regime": regime}
    } else {
        return {"ok": false, "trit": T_FALSE, "error": "quality exception"}
    }
}

