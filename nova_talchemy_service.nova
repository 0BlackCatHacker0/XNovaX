}

// ============================================================
// DELEGATE: do_rolling — rolling/moving aggregation
// ============================================================
fn do_rolling(data_json_str, value_field, window, func) {
    let args = json_encode({"op": "rolling", "data": data_json_str, "value_field": value_field, "window": window, "func": func})
    nova_write("C:/NovaX/tmp_talchemy_args.json", args)
