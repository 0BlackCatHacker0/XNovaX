// nova_talchemy_service.nova -- NovaX TAlchemy v1.0
// Ternary Data Transformation Engine -- Port 9928
//
// The "data plumber" of NovaX. Transforms data between formats, reshapes
// structures, filters arrays, merges datasets, and aggregates values.
// Every transformation is ternary-encoded: +1 success, 0 partial, -1 failure.
//
// Supported formats: JSON, CSV, YAML (simplified), XML (simplified),
//                    ternary trit encoding, plain text.
//
// 3-5-7-13 Harmonics:
//   3  = ternary transform states (+1 clean, 0 partial, -1 corrupt)
//   5  = max nesting depth for flatten/unflatten
//   7  = max merge sources in one call
//   13 = JSONPath cache size, hash seal length
//
// N-S Reynolds routing:
//   Re < 27  = laminar     (small payload, simple transform)
//   Re < 125 = transitional (medium payload)
//   Re < 343 = turbulent   (large payload)
//   Re >= 343 = chaotic    (very large or complex transform)
//
// Endpoints:
//   GET  /talchemy/health     -- Health check
//   GET  /talchemy/stats      -- Transformation statistics
//   POST /talchemy/transform  -- Convert between formats
//   POST /talchemy/reshape    -- Reshape JSON using JSONPath-like templates
//   POST /talchemy/filter     -- Filter array of objects by conditions
//   POST /talchemy/merge      -- Merge datasets by key
//   POST /talchemy/aggregate  -- Group-by and aggregate operations
//   POST /talchemy/ternary    -- Classify every field to trit representation
//   POST /talchemy/consensus  -- Weighted multi-source consensus with confidence

// -- Shared Libraries (N-S Flow) --
import3("C:/NovaX/lib/nova_ns_core.nova")
import3("C:/NovaX/lib/nova_stdlib.nova")

let PORT = 9928
let server = tserve(PORT, "TAlchemy v1.0 - Ternary Data Transformation Engine")

// -- 3-5-7-13 Harmonic Constants --
let H3  = 3
let H5  = 5
let H7  = 7

// -- Ternary constants --
let T_TRUE  =  1
let T_MAYBE =  0
let T_FALSE = -1

// -- Service identity --
let VERSION      = "1.0"
let SERVICE_NAME = "nova-talchemy"

// -- Reynolds boundaries (N-S flow regime thresholds) --
let RE_LAMINAR     = 27    // H3^3
let RE_TRANS       = 125   // H5^3
let RE_TURBULENT   = 343   // H7^3

// -- Operational limits (3-5-7-13 harmonic sizing) --
let MAX_NEST  = 5          // H5: max nesting depth for flatten/unflatten
let MAX_MERGE = 7          // H7: max merge sources in one call
let MAX_ARRAY = 10000      // max array elements to process
// MAX_BODY: 3^7 * H5 = 2187 * 5 = 10935 bytes
let MAX_BODY  = 10935

// -- Valid format names (used in validation) --
let FMT_JSON    = "json"
let FMT_CSV     = "csv"
let FMT_YAML    = "yaml"
let FMT_XML     = "xml"
let FMT_TERNARY = "ternary"
let FMT_PLAIN   = "plain"

// -- Cumulative transformation statistics --
// No threading in NovaLang -- all state is single-flow
let _start_time          = time()
let _stat_transforms     = 0
let _stat_reshapes        = 0
let _stat_filters         = 0
let _stat_merges          = 0
let _stat_aggregations    = 0
let _stat_ternary_convs   = 0
let _stat_validations     = 0
let _stat_diffs           = 0
// Per-format usage counters (one var per format)
let _fmt_json_count    = 0
let _fmt_csv_count     = 0
let _fmt_yaml_count    = 0
let _fmt_xml_count     = 0
let _fmt_ternary_count = 0
let _fmt_plain_count   = 0

// ============================================================
// Helper: N-S Reynolds number for a transform payload
// Re = (payload_size * format_complexity) / H13
// Complexity: json=1, plain=1, csv=2, ternary=2, yaml=3, xml=3
// ============================================================
fn payload_reynolds(data_size, fmt) {
    let complexity = 1
    if3 fmt == FMT_CSV { complexity = 2
    } else fmt == FMT_TERNARY { complexity = 2
    } else fmt == FMT_YAML { complexity = 3
    } else fmt == FMT_XML { complexity = 3
    } else {
        // json or plain: complexity stays 1
    }
    let re = (data_size * complexity) / H13
    return re
}

// ============================================================
// Helper: N-S flow regime label from Reynolds number
// ============================================================
fn reynolds_regime(re) {
    if3 re < RE_LAMINAR {
        return "laminar"
    } else re < RE_TRANS {
        return "transitional"
    } else re < RE_TURBULENT {
        return "turbulent"
    } else {
        return "chaotic"
    }
}

// ============================================================
// Helper: validate that a format string is supported
// Returns T_TRUE if valid, T_FALSE if not
// ============================================================
fn fmt_valid(fmt) {
    if3 fmt == FMT_JSON {
        return T_TRUE
    } else fmt == FMT_CSV {
        return T_TRUE
    } else fmt == FMT_YAML {
        return T_TRUE
    } else fmt == FMT_XML {
        return T_TRUE
    } else fmt == FMT_TERNARY {
        return T_TRUE
    } else fmt == FMT_PLAIN {
        return T_TRUE
    } else {
        return T_FALSE
    }
}

// ============================================================
// Helper: increment per-format usage counter
// ============================================================
fn record_fmt(fmt) {
    if3 fmt == FMT_JSON {
        _fmt_json_count = _fmt_json_count + 1
    } else fmt == FMT_CSV {
        _fmt_csv_count = _fmt_csv_count + 1
    } else fmt == FMT_YAML {
        _fmt_yaml_count = _fmt_yaml_count + 1
    } else fmt == FMT_XML {
        _fmt_xml_count = _fmt_xml_count + 1
    } else fmt == FMT_TERNARY {
        _fmt_ternary_count = _fmt_ternary_count + 1
    } else {
        _fmt_plain_count = _fmt_plain_count + 1
    }
}

// ============================================================
// Helper: classify ternary trit from a scalar value
// truthy -> T_TRUE, null/empty/zero -> T_MAYBE, false/-1 -> T_FALSE
// This mirrors nova_tlight.trit() logic.
// ============================================================
fn scalar_trit(val) {
    if3 val == null {
        return T_MAYBE
    } else val == "" {
        return T_MAYBE
    } else val == 0 {
        return T_MAYBE
    } else val == false {
        return T_FALSE
    } else val == T_FALSE {
        return T_FALSE
    } else {
        return T_TRUE
    }
}

// ============================================================
// FORMAT CONVERSION HELPERS -- Pure NovaLang
// All transforms implemented inline using json_encode/json_decode,
// dict_get, keys, split, string ops. No Python, no nova_run.
// ============================================================

// -- Helper: flatten a nested dict to dot-notation --
// {"user": {"name": "Alice"}} -> {"user.name": "Alice"}
fn _flatten_recurse(obj, prefix, depth, max_depth, result) {
    if3 depth >= max_depth {
        result = dict_set(result, prefix, obj)
        return result
    } else { }
    if3 type(obj) == "dict" {
        let obj_keys = keys(obj)
        for3 k in obj_keys {
            let v = dict_get(obj, k) ?? null
            let new_prefix = k
            if3 prefix != "" { new_prefix = prefix + "." + k
            } else { }
            result = _flatten_recurse(v, new_prefix, depth + 1, max_depth, result)
        }
        return result
    } else {
        result = dict_set(result, prefix, obj)
        return result
    }
}

fn do_flatten(data_json_str) {
    try3 {
        let data = json_decode(data_json_str)
        let flat = _flatten_recurse(data, "", 0, MAX_NEST, {})
        return {"ok": true, "data": flat}
    } fail {
        return {"ok": false, "error": "flatten failed: " + "unknown error"}
    }
}

// -- Unflatten dot-notation keys to nested dict --
fn do_unflatten(data_json_str) {
    try3 {
        let data = json_decode(data_json_str)
        let result = {}
        let all_keys = keys(data)
        for3 flat_key in all_keys {
            let val = dict_get(data, flat_key) ?? null
            let parts = split(flat_key, ".")
            let current = result
            let pi = 0
            while3 pi < len(parts) - 1 {
                let part = parts[pi]
                let existing = dict_get(current, part) ?? null
                if3 existing == null {
                    current = dict_set(current, part, {})
                    // Re-read to descend
                } else { }
                pi = pi + 1
            }
            // For simple single-level unflattening, set directly on result
            // Multi-level: build nested path
            if3 len(parts) == 1 {
                result = dict_set(result, parts[0], val)
            } else len(parts) == 2 {
                let sub = dict_get(result, parts[0]) ?? {}
                sub = dict_set(sub, parts[1], val)
                result = dict_set(result, parts[0], sub)
            } else len(parts) == 3 {
                let sub = dict_get(result, parts[0]) ?? {}
                let sub2 = dict_get(sub, parts[1]) ?? {}
                sub2 = dict_set(sub2, parts[2], val)
                sub = dict_set(sub, parts[1], sub2)
                result = dict_set(result, parts[0], sub)
            } else len(parts) == 4 {
                let sub = dict_get(result, parts[0]) ?? {}
                let sub2 = dict_get(sub, parts[1]) ?? {}
                let sub3 = dict_get(sub2, parts[2]) ?? {}
                sub3 = dict_set(sub3, parts[3], val)
                sub2 = dict_set(sub2, parts[2], sub3)
                sub = dict_set(sub, parts[1], sub2)
                result = dict_set(result, parts[0], sub)
            } else len(parts) == 5 {
                let sub = dict_get(result, parts[0]) ?? {}
                let sub2 = dict_get(sub, parts[1]) ?? {}
                let sub3 = dict_get(sub2, parts[2]) ?? {}
                let sub4 = dict_get(sub3, parts[3]) ?? {}
                sub4 = dict_set(sub4, parts[4], val)
                sub3 = dict_set(sub3, parts[3], sub4)
                sub2 = dict_set(sub2, parts[2], sub3)
                sub = dict_set(sub, parts[1], sub2)
                result = dict_set(result, parts[0], sub)
            } else {
                // Beyond MAX_NEST depth, store as dotted key
                result = dict_set(result, flat_key, val)
            }
        }
        return {"ok": true, "data": result}
    } fail {
        return {"ok": false, "error": "unflatten failed: " + "unknown error"}
    }
}

// -- JSON list/dict -> CSV string --
fn do_json_to_csv(data_json_str) {
    try3 {
        let data = json_decode(data_json_str)
        if3 type(data) != "list" {
            return {"ok": false, "error": "json_to_csv requires a list of objects"}
        } else { }
        if3 len(data) == 0 {
            return {"ok": true, "data": ""}
        } else { }
        // Collect all column names from all rows
        let cols = []
        let col_set = {}
        let ri = 0
        while3 ri < len(data) {
            let row = dict_get(data, ri) ?? {}
            let rkeys = keys(row)
            for3 rk in rkeys {
                let already = dict_get(col_set, rk) ?? null
                if3 already == null {
                    cols = append(cols, rk)
                    col_set = dict_set(col_set, rk, true)
                } else { }
            }
            ri = ri + 1
        }
        // Build header line
        let header = join(cols, ",")
        let lines = [header]
        // Build data lines
        let di = 0
        while3 di < len(data) {
            let row = dict_get(data, di) ?? {}
            let vals = []
            for3 col in cols {
                let v = dict_get(row, col) ?? ""
                let vs = str(v)
                // Quote if contains comma or newline
                if3 contains(vs, ",") {
                    vs = "\"" + vs + "\""
                } else contains(vs, "\n") {
                    vs = "\"" + vs + "\""
                } else { }
                vals = append(vals, vs)
            }
            lines = append(lines, join(vals, ","))
            di = di + 1
        }
        return {"ok": true, "data": join(lines, "\n")}
    } fail {
        return {"ok": false, "error": "json_to_csv failed: " + "unknown error"}
    }
}

// -- CSV string -> JSON list of dicts --
fn do_csv_to_json(csv_str) {
    try3 {
        let lines = split(csv_str, "\n")
        if3 len(lines) < 1 {
            return {"ok": true, "data": []}
        } else { }
        let headers = split(lines[0], ",")
        // Trim whitespace from headers
        let hi = 0
        while3 hi < len(headers) {
            headers[hi] = trim(headers[hi])
            hi = hi + 1
        }
        let result = []
        let li = 1
        while3 li < len(lines) {
            let line = trim(lines[li])
            if3 len(line) == 0 {
                li = li + 1
            } else {
                let vals = split(line, ",")
                let row = {}
                let vi = 0
                while3 vi < len(headers) {
                    let val = ""
                    if3 vi < len(vals) { val = trim(vals[vi])
                    } else { }
                    // Remove surrounding quotes
                    if3 len(val) >= 2 {
                        if3 starts_with(val, "\"") {
                            if3 ends_with(val, "\"") {
                                val = slice(val, 1, len(val) - 1)
                            } else { }
                        } else { }
                    } else { }
                    row = dict_set(row, headers[vi], val)
                    vi = vi + 1
                }
                result = append(result, row)
                li = li + 1
            }
        }
        return {"ok": true, "data": result}
    } fail {
        return {"ok": false, "error": "csv_to_json failed: " + "unknown error"}
    }
}

// -- JSON -> simplified YAML string --
fn _yaml_value(v) {
    if3 v == null { return "null"
    } else v == true { return "true"
    } else v == false { return "false"
    } else type(v) == "str" { return v
    } else { return str(v)
    }
}

fn _yaml_dict(obj, indent) {
    let result = ""
    let obj_keys = keys(obj)
    for3 k in obj_keys {
        let v = dict_get(obj, k) ?? null
        let pad = ""
        let pi = 0
        while3 pi < indent { pad = pad + "  "
            pi = pi + 1
        }
        if3 type(v) == "dict" {
            result = result + pad + str(k) + ":\n"
            result = result + _yaml_dict(v, indent + 1)
        } else type(v) == "list" {
            result = result + pad + str(k) + ":\n"
            let li = 0
            while3 li < len(v) {
                let item = dict_get(v, li) ?? null
                if3 type(item) == "dict" {
                    result = result + pad + "  - \n"
                    result = result + _yaml_dict(item, indent + 2)
                } else {
                    result = result + pad + "  - " + _yaml_value(item) + "\n"
                }
                li = li + 1
            }
        } else {
            result = result + pad + str(k) + ": " + _yaml_value(v) + "\n"
        }
    }
    return result
}

fn do_json_to_yaml(data_json_str) {
    try3 {
        let data = json_decode(data_json_str)
        if3 type(data) == "dict" {
            let yaml_str = _yaml_dict(data, 0)
            return {"ok": true, "data": yaml_str}
        } else type(data) == "list" {
            let yaml_str = ""
            let li = 0
            while3 li < len(data) {
                let item = dict_get(data, li) ?? null
                if3 type(item) == "dict" {
                    yaml_str = yaml_str + "- \n"
                    yaml_str = yaml_str + _yaml_dict(item, 1)
                } else {
                    yaml_str = yaml_str + "- " + _yaml_value(item) + "\n"
                }
                li = li + 1
            }
            return {"ok": true, "data": yaml_str}
        } else {
            return {"ok": true, "data": _yaml_value(data)}
        }
    } fail {
        return {"ok": false, "error": "json_to_yaml failed: " + "unknown error"}
    }
}

// -- Simplified YAML string -> JSON --
fn do_yaml_to_json(yaml_str) {
    try3 {
        let result = {}
        let lines = split(yaml_str, "\n")
        for3 line in lines {
            let trimmed = trim(line)
            if3 len(trimmed) == 0 {
                // skip blank
            } else starts_with(trimmed, "#") {
                // skip comment
            } else contains(trimmed, ": ") {
                let parts = split(trimmed, ": ")
                let k = trim(parts[0])
                // Remove leading "- " from list items
                if3 starts_with(k, "- ") {
                    k = trim(slice(k, 2, len(k)))
                } else { }
                let v = ""
                if3 len(parts) > 1 { v = trim(parts[1])
                } else { }
                // Type coercion
                if3 v == "true" { result = dict_set(result, k, true)
                } else v == "false" { result = dict_set(result, k, false)
                } else v == "null" { result = dict_set(result, k, null)
                } else {
                    // Try numeric
                    let is_num = true
                    try3 {
                        let num = float(v)
                        result = dict_set(result, k, num)
                    } fail {
                        result = dict_set(result, k, v)
                    }
                }
            } else {
                // Skip complex YAML structures (nested blocks handled at top level only)
            }
        }
        return {"ok": true, "data": result}
    } fail {
        return {"ok": false, "error": "yaml_to_json failed: " + "unknown error"}
    }
}

// -- JSON -> simplified XML string --
fn _xml_escape(s) {
    let result = replace(str(s), "&", "&amp;")
    result = replace(result, "<", "&lt;")
    result = replace(result, ">", "&gt;")
    result = replace(result, "\"", "&quot;")
    return result
}

fn _xml_node(tag, val, indent) {
    let pad = ""
    let pi = 0
    while3 pi < indent { pad = pad + "  "
        pi = pi + 1
    }
    if3 val == null {
        return pad + "<" + tag + " />\n"
    } else type(val) == "dict" {
        let result = pad + "<" + tag + ">\n"
        let val_keys = keys(val)
        for3 k in val_keys {
            let v = dict_get(val, k) ?? null
            result = result + _xml_node(k, v, indent + 1)
        }
        result = result + pad + "</" + tag + ">\n"
        return result
    } else type(val) == "list" {
        let result = ""
        let li = 0
        while3 li < len(val) {
            let item = dict_get(val, li) ?? null
            result = result + _xml_node(tag, item, indent)
            li = li + 1
        }
        return result
    } else {
        return pad + "<" + tag + ">" + _xml_escape(val) + "</" + tag + ">\n"
    }
}

fn do_json_to_xml(data_json_str) {
    try3 {
        let data = json_decode(data_json_str)
        let xml = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
        if3 type(data) == "dict" {
            xml = xml + _xml_node("root", data, 0)
        } else type(data) == "list" {
            xml = xml + "<root>\n"
            let li = 0
            while3 li < len(data) {
                let item = dict_get(data, li) ?? null
                xml = xml + _xml_node("item", item, 1)
                li = li + 1
            }
            xml = xml + "</root>\n"
        } else {
            xml = xml + "<root>" + _xml_escape(data) + "</root>\n"
        }
        return {"ok": true, "data": xml}
    } fail {
        return {"ok": false, "error": "json_to_xml failed: " + "unknown error"}
    }
}

// -- Simplified XML string -> JSON --
// Handles simple <tag>value</tag> patterns, no attributes
fn do_xml_to_json(xml_str) {
    try3 {
        let result = {}
        let lines = split(xml_str, "\n")
        for3 line in lines {
            let trimmed = trim(line)
            if3 len(trimmed) == 0 {
                // skip blank
            } else starts_with(trimmed, "<?") {
                // skip XML declaration
            } else starts_with(trimmed, "<root>") {
                // skip root open
            } else starts_with(trimmed, "</root>") {
                // skip root close
            } else starts_with(trimmed, "<") {
                // Try to extract <tag>value</tag>
                let gt_pos = index_of(trimmed, ">")
                if3 gt_pos > 0 {
                    let tag = slice(trimmed, 1, gt_pos)
                    // Skip self-closing and close tags
                    if3 starts_with(tag, "/") {
                        // close tag, skip
                    } else ends_with(tag, "/") {
                        // self-closing, null value
                        let clean_tag = trim(slice(tag, 0, len(tag) - 1))
                        result = dict_set(result, clean_tag, null)
                    } else {
                        let close_tag = "</" + tag + ">"
                        let close_pos = index_of(trimmed, close_tag)
                        if3 close_pos > 0 {
                            let value = slice(trimmed, gt_pos + 1, close_pos)
                            // Unescape basic XML entities
                            value = replace(value, "&amp;", "&")
                            value = replace(value, "&lt;", "<")
                            value = replace(value, "&gt;", ">")
                            value = replace(value, "&quot;", "\"")
                            result = dict_set(result, tag, value)
                        } else { }
                    }
                } else { }
            } else { }
        }
        return {"ok": true, "data": result}
    } fail {
        return {"ok": false, "error": "xml_to_json failed: " + "unknown error"}
    }
}

// -- JSON -> plain text key: value --
fn do_json_to_plain(data_json_str) {
    try3 {
        let data = json_decode(data_json_str)
        if3 type(data) == "dict" {
            let result = ""
            let all_keys = keys(data)
            for3 k in all_keys {
                let v = dict_get(data, k) ?? ""
                result = result + str(k) + ": " + str(v) + "\n"
            }
            return {"ok": true, "data": result}
        } else type(data) == "list" {
            let result = ""
            let li = 0
            while3 li < len(data) {
                let item = dict_get(data, li) ?? ""
                if3 type(item) == "dict" {
                    let item_keys = keys(item)
                    for3 ik in item_keys {
                        let iv = dict_get(item, ik) ?? ""
                        result = result + str(ik) + ": " + str(iv) + "\n"
                    }
                    result = result + "---\n"
                } else {
                    result = result + str(item) + "\n"
                }
                li = li + 1
            }
            return {"ok": true, "data": result}
        } else {
            return {"ok": true, "data": str(data)}
        }
    } fail {
        return {"ok": false, "error": "json_to_plain failed: " + "unknown error"}
    }
}

// -- Plain text -> JSON dict --
fn do_plain_to_json(plain_str) {
    try3 {
        let result = {}
        let lines = split(plain_str, "\n")
        for3 line in lines {
            let trimmed = trim(line)
            if3 len(trimmed) == 0 {
                // skip blank
            } else trimmed == "---" {
                // skip separator
            } else contains(trimmed, ": ") {
                let colon_pos = index_of(trimmed, ": ")
                let k = slice(trimmed, 0, colon_pos)
                let v = trim(slice(trimmed, colon_pos + 2, len(trimmed)))
                // Type coercion
                if3 v == "true" { result = dict_set(result, k, true)
                } else v == "false" { result = dict_set(result, k, false)
                } else v == "null" { result = dict_set(result, k, null)
                } else {
                    try3 {
                        let num = float(v)
                        result = dict_set(result, k, num)
                    } fail {
                        result = dict_set(result, k, v)
                    }
                }
            } else { }
        }
        return {"ok": true, "data": result}
    } fail {
        return {"ok": false, "error": "plain_to_json failed: " + "unknown error"}
    }
}

// -- Data -> ternary trit representation --
// Classifies every field: truthy=+1, None/empty=0, falsy=-1
fn do_to_ternary(data_json_str) {
    try3 {
        let data = json_decode(data_json_str)
        let result = {}
        let count_pos = 0
        let count_zero = 0
        let count_neg = 0
        if3 type(data) == "dict" {
            let all_keys = keys(data)
            for3 k in all_keys {
                let v = dict_get(data, k) ?? null
                let t = scalar_trit(v)
                result = dict_set(result, k, t)
                if3 t == T_TRUE { count_pos = count_pos + 1
                } else t == T_MAYBE { count_zero = count_zero + 1
                } else { count_neg = count_neg + 1
                }
            }
        } else type(data) == "list" {
            let result_list = []
            let li = 0
            while3 li < len(data) {
                let v = dict_get(data, li) ?? null
                if3 type(v) == "dict" {
                    let row_result = {}
                    let vkeys = keys(v)
                    for3 vk in vkeys {
                        let vv = dict_get(v, vk) ?? null
                        let t = scalar_trit(vv)
                        row_result = dict_set(row_result, vk, t)
                        if3 t == T_TRUE { count_pos = count_pos + 1
                        } else t == T_MAYBE { count_zero = count_zero + 1
                        } else { count_neg = count_neg + 1
                        }
                    }
                    result_list = append(result_list, row_result)
                } else {
                    let t = scalar_trit(v)
                    result_list = append(result_list, t)
                    if3 t == T_TRUE { count_pos = count_pos + 1
                    } else t == T_MAYBE { count_zero = count_zero + 1
                    } else { count_neg = count_neg + 1
                    }
                }
                li = li + 1
            }
            return {"ok": true, "data": result_list, "count_pos": count_pos, "count_zero": count_zero, "count_neg": count_neg}
        } else {
            let t = scalar_trit(data)
            if3 t == T_TRUE { count_pos = 1
            } else t == T_MAYBE { count_zero = 1
            } else { count_neg = 1
            }
            return {"ok": true, "data": t, "count_pos": count_pos, "count_zero": count_zero, "count_neg": count_neg}
        }
        return {"ok": true, "data": result, "count_pos": count_pos, "count_zero": count_zero, "count_neg": count_neg}
    } fail {
        return {"ok": false, "error": "to_ternary failed: " + "unknown error"}
    }
}

// -- Ternary representation -> plain values --
fn do_from_ternary(data_json_str) {
    try3 {
        let data = json_decode(data_json_str)
        let result = {}
        if3 type(data) == "dict" {
            let all_keys = keys(data)
            for3 k in all_keys {
                let t = dict_get(data, k) ?? 0
                if3 t == T_TRUE { result = dict_set(result, k, true)
                } else t == T_FALSE { result = dict_set(result, k, false)
                } else { result = dict_set(result, k, null)
                }
            }
        } else { }
        return {"ok": true, "data": result}
    } fail {
        return {"ok": false, "error": "from_ternary failed: " + "unknown error"}
    }
}

// -- JSONPath resolve --
// Resolves $.key.subkey patterns using dict_get chain
fn do_jsonpath_get(data_json_str, path) {
    try3 {
        let data = json_decode(data_json_str)
        // Strip leading "$." or "$"
        let clean_path = path
        if3 starts_with(clean_path, "$.") {
            clean_path = slice(clean_path, 2, len(clean_path))
        } else starts_with(clean_path, "$") {
            clean_path = slice(clean_path, 1, len(clean_path))
        } else { }
        if3 len(clean_path) == 0 {
            return {"ok": true, "data": data}
        } else { }
        let parts = split(clean_path, ".")
        let current = data
        for3 part in parts {
            if3 current == null {
                return {"ok": true, "data": null}
            } else type(current) == "dict" {
                current = dict_get(current, part) ?? null
            } else type(current) == "list" {
                // Handle array index like [0] or wildcard [*]
                if3 part == "[*]" {
                    // Return all items
                    return {"ok": true, "data": current}
                } else starts_with(part, "[") {
                    let idx_str = slice(part, 1, len(part) - 1)
                    let idx = int(idx_str)
                    current = dict_get(current, idx) ?? null
                } else {
                    // Try numeric index
                    try3 {
                        let idx = int(part)
                        current = dict_get(current, idx) ?? null
                    } fail {
                        // Map over list items
                        let mapped = []
                        let mi = 0
                        while3 mi < len(current) {
                            let item = dict_get(current, mi) ?? {}
                            if3 type(item) == "dict" {
                                mapped = append(mapped, dict_get(item, part) ?? null)
                            } else {
                                mapped = append(mapped, null)
                            }
                            mi = mi + 1
                        }
                        current = mapped
                    }
                }
            } else {
                return {"ok": true, "data": null}
            }
        }
        return {"ok": true, "data": current}
    } fail {
        return {"ok": false, "error": "jsonpath_get failed: " + "unknown error"}
    }
}

// -- Delegate: filter array by conditions dict --
