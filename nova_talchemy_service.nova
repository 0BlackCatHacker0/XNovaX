fn talchemy_pivot(body) {
    let data = dict_get(body, "data") ?? null
    let index_field = dict_get(body, "index") ?? "id"
    let column_field = dict_get(body, "column") ?? ""
    let value_field = dict_get(body, "value") ?? ""

    if3 data == null {
        return {"ok": false, "trit": T_FALSE, "error": "data required"}
    } else {
        // data present
    }
    if3 column_field == "" {
        return {"ok": false, "trit": T_FALSE, "error": "column field required"}
    } else {
        // column present
    }
    if3 value_field == "" {
        return {"ok": false, "trit": T_FALSE, "error": "value field required"}
    } else {
        // value present
    }

    let data_size = len(json_encode(data))
    let re = payload_reynolds(data_size, FMT_JSON)
    let regime = reynolds_regime(re)

    try3 {
        let data_str = json_encode(data)
