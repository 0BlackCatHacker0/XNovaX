                "total_cells": dict_get(res, "total_cells") ?? 0,
                "filled_cells": dict_get(res, "filled_cells") ?? 0,
                "reynolds": re,
                "flow_regime": regime,
                "runtime": "novalang"
    } else {
        return {"ok": false, "trit": T_FALSE, "error": "pivot failed (exception)"}
    }
}

