// NovaX MAX RUN - All 24 Providers - Full Power
// Converted from max_run.py to NovaLang v1.4

let ALL_PROVIDERS = [
    "cerebras_direct", "google_ai_studio", "sambanova_direct", "github_models",
    "mistral_direct", "nvidia_nim", "kluster_ai", "openai", "anthropic",
    "google", "mistral", "groq", "deepseek", "cohere", "together",
    "deepinfra", "together_direct", "cloudflare_ai", "cohere_direct",
    "apifreellm", "openrouter", "ollama"
]

let TOPICS = [
    "cloud router parallel dispatch with 3-provider racing",
    "token throughput maximizer with burst scheduling",
    "response quality scoring with length and coherence metrics",
    "service auto-healer that detects crashes within 10 seconds",
    "adaptive load balancer based on response time history",
    "smart caching layer with TTL and LRU eviction",
    "distributed tracing across all 111 microservices",
    "Chladni eigenmode classifier with 13 skill domains",
    "ternary neural network with 27-trit input layer",
    "swarm consensus algorithm merging 5+ model responses",
    "knowledge graph with subject-predicate-object triples",
    "event-driven pub/sub bus connecting all services",
    "API gateway with rate limiting and auth middleware",
    "prompt engineering engine with automatic optimization",
    "model benchmark suite testing speed and quality",
    "feature flag system with gradual rollout percentages",
    "anomaly detector using z-score on latency trends",
    "code generation service that writes NovaLang services",
    "context manager with windowing and compression",
    "Navier-Stokes flow control for request routing",
    "BitNet 1.58 quantizer with adaptive thresholds",
    "fractal engine with recursive depth control",
    "connection pooling for HTTP client reuse",
    "self-documenting system that catalogs all APIs",
    "ternary CPU emulator with 9 registers",
    "model specialization map for task-to-model routing",
    "NovaLang VM memory compaction for long-running services",
    "neural fabric mesh connecting all 111 services",
    "quantum bridge between binary and ternary computing",
    "reinforcement learning router with ternary rewards",
    "data pipeline with map-reduce-filter on streams",
    "state machine engine for service lifecycle management",
    "chaos engineering tool for resilience testing",
    "fleet commander with rolling restarts and circuit breakers",
    "unified API gateway routing natural language to services",
    "AI training pipeline collecting fine-tuning data",
    "ternary compression with run-length encoding on trits",
    "performance profiler with p50 p95 p99 percentiles",
    "model arena with ELO rating system for competitions",
    "intelligence fabric v3 with semantic routing",
    "CLI tool for fleet management with colored output",
    "system report generator with uptime and throughput stats",
    "migration tool for zero-downtime version upgrades",
    "capability discovery scanning models for strengths"
]

let BASE = "You are upgrading NovaX, an AI OS with 111 microservices in NovaLang (if3/try3/while3/for3, dict_get/dict_set, tserve/troute/tstart). Write a complete implementation for: "

fn3 query(prompt, provider, model) {
    let body = json_encode({"prompt": prompt, "provider": provider, "model": model})
    try3 {
        let raw = http_post("http://127.0.0.1:9878/query", body)
        let d = json_decode(raw)
        let result = dict_get(d, "result") ?? {}
        let resp = dict_get(result, "response") ?? dict_get(d, "response") ?? ""
        let tok = dict_get(result, "tokens") ?? 0
        if3 tok == 0 {
            if3 len(resp) > 0 {
                tok = int(len(resp) / 4)
                if3 tok < 1 { tok = 1 }
            }
        }
        let prov = dict_get(d, "provider") ?? provider
        return3 {"ok": dict_get(d, "ok") ?? false, "tokens": tok, "provider": prov, "response": resp}
    } catch3 {
        return3 {"ok": false, "tokens": 0, "error": "query_failed"}
    }
}

let grand_total = 0
let grand_hits = 0
let grand_queries = 0
let provider_stats = {}

print("============================================================")
print("  NOVAX MAX RUN - ALL 24 PROVIDERS - FULL POWER")
print("============================================================")

// ROUND 1: Every single provider
print("")
print("=== ROUND 1: ALL PROVIDERS FIRST PASS ===")
for3 i in range(len(ALL_PROVIDERS)) {
    let prov = ALL_PROVIDERS[i]
    let topic_idx = i % len(TOPICS)
    let topic = TOPICS[topic_idx]
    let prompt = BASE + topic + ". Full NovaLang code, production-ready."
    let t0 = time_ms()
    let r = query(prompt, prov, "")
    let elapsed = (time_ms() - t0) / 1000
    let tok = dict_get(r, "tokens") ?? 0
    grand_total = grand_total + tok
    grand_queries = grand_queries + 1
    let actual = dict_get(r, "provider") ?? prov
    let tag = "MISS"
    if3 tok > 0 {
        grand_hits = grand_hits + 1
        if3 actual == prov {
            tag = "DIRECT"
        } else3 {
            tag = "CASCADE->" + actual
        }
    }
    if3 dict_get(provider_stats, actual) == null {
        provider_stats = dict_set(provider_stats, actual, {"hits": 0, "tokens": 0})
    }
    let ps = dict_get(provider_stats, actual)
    ps = dict_set(ps, "hits", dict_get(ps, "hits") + 1)
    ps = dict_set(ps, "tokens", dict_get(ps, "tokens") + tok)
    provider_stats = dict_set(provider_stats, actual, ps)
    let resp_text = dict_get(r, "response") ?? ""
    let safe = str(resp_text)
    if3 len(safe) > 80 { safe = slice(safe, 0, 80) }
    print("  [" + prov + "] " + tag + " +" + str(tok) + " tok (" + str(elapsed) + "s) | " + safe + "...")
}

print("")
print("  Round 1: " + str(grand_hits) + "/" + str(grand_queries) + " hits, " + str(grand_total) + " tokens")

// ROUND 2: All providers again with different topics
print("")
print("=== ROUND 2: ALL PROVIDERS SECOND PASS ===")
let r2_hits = 0
let r2_tok = 0
for3 i in range(len(ALL_PROVIDERS)) {
    let prov = ALL_PROVIDERS[i]
    let topic_idx = (i + 22) % len(TOPICS)
    let topic = TOPICS[topic_idx]
    let prompt = BASE + topic + ". Write complete deployable NovaLang code with health endpoint and JSON API."
    let r = query(prompt, prov, "")
    let tok = dict_get(r, "tokens") ?? 0
    grand_total = grand_total + tok
    r2_tok = r2_tok + tok
    grand_queries = grand_queries + 1
    let actual = dict_get(r, "provider") ?? prov
    let tag = "MISS"
    if3 tok > 0 {
        grand_hits = grand_hits + 1
        r2_hits = r2_hits + 1
        if3 actual == prov {
            tag = "DIRECT"
        } else3 {
            tag = "CASCADE->" + actual
        }
    }
    if3 dict_get(provider_stats, actual) == null {
        provider_stats = dict_set(provider_stats, actual, {"hits": 0, "tokens": 0})
    }
    let ps = dict_get(provider_stats, actual)
    ps = dict_set(ps, "hits", dict_get(ps, "hits") + 1)
    ps = dict_set(ps, "tokens", dict_get(ps, "tokens") + tok)
    provider_stats = dict_set(provider_stats, actual, ps)
    print("  [" + prov + "] " + tag + " +" + str(tok) + " tok")
}

print("")
print("  Round 2: " + str(r2_hits) + "/" + str(len(ALL_PROVIDERS)) + " hits, " + str(r2_tok) + " tokens")

// ROUND 3: Top 8 performers get 3 bonus queries each
print("")
print("=== ROUND 3: TOP PERFORMER BONUS (3x each) ===")
let top_provs = dict_keys(provider_stats)
// Sort by tokens descending — collect into list of [prov, tokens] pairs
let scored = []
for3 p in top_provs {
    let ps = dict_get(provider_stats, p)
    scored = append(scored, [p, dict_get(ps, "tokens")])
}
// Simple selection sort for top 8
let top8 = []
for3 pick in range(8) {
    if3 len(scored) == 0 { break }
    let best_idx = 0
    let best_val = 0
    for3 si in range(len(scored)) {
        if3 scored[si][1] > best_val {
            best_val = scored[si][1]
            best_idx = si
        }
    }
    top8 = append(top8, scored[best_idx][0])
    // Remove best from scored
    let new_scored = []
    for3 si in range(len(scored)) {
        if3 si != best_idx {
            new_scored = append(new_scored, scored[si])
        }
    }
    scored = new_scored
}

let r3_tok = 0
let r3_hits = 0
for3 prov in top8 {
    for3 j in range(3) {
        let topic_idx = (grand_queries + j) % len(TOPICS)
        let topic = TOPICS[topic_idx]
        let prompt = BASE + topic + ". Maximum detail. Full implementation. Production-grade."
        let r = query(prompt, prov, "")
        let tok = dict_get(r, "tokens") ?? 0
        grand_total = grand_total + tok
        r3_tok = r3_tok + tok
        grand_queries = grand_queries + 1
        if3 tok > 0 {
            grand_hits = grand_hits + 1
            r3_hits = r3_hits + 1
        }
        print("  [" + prov + "] +" + str(tok) + " tok (bonus " + str(j + 1) + ")")
    }
}

print("")
print("  Round 3: " + str(r3_hits) + " hits, " + str(r3_tok) + " tokens")

// ROUND 4: Scatter shot rapid fire (deterministic shuffle via stride)
print("")
print("=== ROUND 4: SCATTER SHOT RAPID FIRE ===")
let r4_tok = 0
let r4_hits = 0
let scatter_count = 20
for3 i in range(scatter_count) {
    let prov_idx = (i * 7 + 3) % len(ALL_PROVIDERS)
    let prov = ALL_PROVIDERS[prov_idx]
    let topic_idx = (i * 3) % len(TOPICS)
    let topic = TOPICS[topic_idx]
    let prompt = BASE + topic + ". Concise but complete NovaLang code."
    let r = query(prompt, prov, "")
    let tok = dict_get(r, "tokens") ?? 0
    grand_total = grand_total + tok
    r4_tok = r4_tok + tok
    grand_queries = grand_queries + 1
    if3 tok > 0 {
        grand_hits = grand_hits + 1
        r4_hits = r4_hits + 1
    }
    print("  [" + prov + "] +" + str(tok) + " tok")
}

print("")
print("  Round 4: " + str(r4_hits) + "/20 hits, " + str(r4_tok) + " tokens")

// Final report
print("")
print("============================================================")
print("  MAX RUN COMPLETE")
print("============================================================")
let max_q = grand_queries
if3 max_q < 1 { let max_q = 1 }
print("  Total queries:  " + str(grand_queries))
print("  Total hits:     " + str(grand_hits))
print("  Hit rate:       " + str(int(grand_hits * 100 / max_q)) + "%")
print("  Total tokens:   " + str(grand_total))
print("")
print("  PROVIDER LEADERBOARD:")
for3 prov in dict_keys(provider_stats) {
    let ps = dict_get(provider_stats, prov)
    let hits = dict_get(ps, "hits")
    let tokens = dict_get(ps, "tokens")
    let bar_len = int(tokens / 500)
    let bar = ""
    for3 b in range(bar_len) { bar = bar + "#" }
    print("    " + prov + "  hits=" + str(hits) + "  tokens=" + str(tokens) + "  " + bar)
}

// Save results
let results_json = json_encode({
    "total_queries": grand_queries,
    "total_hits": grand_hits,
    "total_tokens": grand_total,
    "hit_rate": str(int(grand_hits * 100 / max_q)) + "%",
    "provider_stats": provider_stats
})
write_file("C:/NovaX/max_run_results.json", results_json)
print("")
print("  Results saved to C:/NovaX/max_run_results.json")
