            ],
            "min_consensus": 3,
            "reynolds": 500
        },
        "threat_assessment": {
            "mirrors": "Palantir AIP",
            "focus": "risk scoring, threat chain analysis, adversary modeling",
            "models": [
                "openai/gpt-4.1",
                "x-ai/grok-3-beta",
                "anthropic/claude-sonnet-4",
                "google/gemini-2.5-pro-preview-03-25"
            ],
            "min_consensus": 3,
            "reynolds": 400
        },
        "code_exploit": {
            "mirrors": "NSA SIGINT Tools",
            "focus": "vulnerability analysis, security scanning, exploit detection",
            "models": [
