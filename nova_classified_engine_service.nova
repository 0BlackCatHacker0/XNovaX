            "focus": "location analysis, mapping, spatial reasoning, terrain",
            "models": [
                "openai/gpt-4.1",
                "google/gemini-2.5-pro-preview-03-25",
                "anthropic/claude-opus-4-0"
            ],
            "min_consensus": 2,
            "reynolds": 350
        },
        "autonomous_planning": {
            "mirrors": "DARPA ACE/RACER",
            "focus": "multi-step planning, decision trees, strategy, wargaming",
            "models": [
                "openai/o3",
