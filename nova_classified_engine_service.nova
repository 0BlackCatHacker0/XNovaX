            "reynolds": 400
        },
        "multilingual_intel": {
            "mirrors": "Five-Eyes SIGINT",
            "focus": "cross-language analysis, translation with context, cultural intel",
            "models": [
                "mistralai/mistral-large-2411",
                "qwen/qwen3-235b-a22b",
                "google/gemini-2.5-pro-preview-03-25",
