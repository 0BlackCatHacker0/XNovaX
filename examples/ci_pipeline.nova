// ============================================================
// NOVAX EXAMPLE: CI/CD Pipeline with TCI
// ============================================================
// Demonstrates the TCI service for continuous integration:
// lint, build, test, templates, caching, and analytics.
// Requires: Orchestrator (:9999) + TCI (:9927) + TGit (:9913)
//           + TBuild (:9909) running.
// Run: python novalang.py examples/ci_pipeline.nova
// ============================================================

import3 http3
import3 format3
import3 trit3

let H3 = 3
let H5 = 5
let H7 = 7
let H13 = 13

print3("╔═══════════════════════════════════════════╗")
print3("║   NovaX CI/CD Pipeline Demo               ║")
print3("║   TCI Service (:9927)                      ║")
print3("╚═══════════════════════════════════════════╝")
print3("")

// ============================================================
// Step 1: Health checks
// ============================================================
print3(">>> Step 1: Service Health Checks")
let tci_h = health3(9927)
let git_h = health3(9913)
let build_h = health3(9909)

fn trit_label(t) {
  if3 t {
    return "OFFLINE"
  } maybe {
    return "ONLINE"
  } else3 {
    return "ONLINE"
  }
}

print3("    TCI    (:9927): " + trit_label(tci_h))
print3("    TGit   (:9913): " + trit_label(git_h))
print3("    TBuild (:9909): " + trit_label(build_h))

// ============================================================
// Step 2: Run lint pipeline
// ============================================================
print3("")
print3(">>> Step 2: Lint Pipeline")
let lint = post3("http://127.0.0.1:9927/tci/lint", {
  "path": "C:\\NovaX"
})
let lint_trit = dict_get(lint, "trit") ?? -1
let lint_stages = dict_get(lint, "stages") ?? []
print3("    Lint result: " + trit_fmt3(lint_trit))
print3("    Stages: " + str(len(lint_stages)))
for3 stage in lint_stages {
  let sname = dict_get(stage, "name") ?? "?"
  let strit = dict_get(stage, "trit") ?? -1
  print3("      " + pad_str3(sname, 20) + trit_fmt3(strit))
}

// ============================================================
// Step 3: Run build pipeline
// ============================================================
print3("")
print3(">>> Step 3: Build Pipeline")
let build = post3("http://127.0.0.1:9927/tci/build", {
  "path": "C:\\NovaX"
})
let build_trit = dict_get(build, "trit") ?? -1
print3("    Build result: " + trit_fmt3(build_trit))
let build_stages = dict_get(build, "stages") ?? []
for3 stage in build_stages {
  let sname = dict_get(stage, "name") ?? "?"
  let strit = dict_get(stage, "trit") ?? -1
  print3("      " + pad_str3(sname, 20) + trit_fmt3(strit))
}

// ============================================================
// Step 4: Run test pipeline
// ============================================================
print3("")
print3(">>> Step 4: Test Pipeline")
let tests = post3("http://127.0.0.1:9927/tci/test", {
  "path": "C:\\NovaX"
})
let test_trit = dict_get(tests, "trit") ?? -1
print3("    Test result: " + trit_fmt3(test_trit))

// ============================================================
// Step 5: Save a template
// ============================================================
print3("")
print3(">>> Step 5: Save Pipeline Template")
let tmpl = post3("http://127.0.0.1:9927/tci/template/save", {
  "name": "quick-check",
  "pipeline": "lint",
  "description": "Quick lint-only check for rapid feedback"
})
let tmpl_trit = dict_get(tmpl, "trit") ?? -1
print3("    Template 'quick-check' saved: " + trit_fmt3(tmpl_trit))

// List templates
let tmpl_list = get3("http://127.0.0.1:9927/tci/templates")
let templates = dict_get(tmpl_list, "templates") ?? []
print3("    Templates registered: " + str(len(templates)))
for3 t in templates {
  let tname = dict_get(t, "name") ?? "?"
  let tpipe = dict_get(t, "pipeline") ?? "?"
  print3("      " + pad_str3(tname, 20) + "-> " + tpipe)
}

// ============================================================
// Step 6: Pipeline cache stats
// ============================================================
print3("")
print3(">>> Step 6: Pipeline Cache")
let cache = get3("http://127.0.0.1:9927/tci/cache")
let cache_entries = dict_get(cache, "entries") ?? 0
let cache_hits = dict_get(cache, "hits") ?? 0
let cache_misses = dict_get(cache, "misses") ?? 0
print3("    Entries: " + str(cache_entries))
print3("    Hits:    " + str(cache_hits))
print3("    Misses:  " + str(cache_misses))
let cache_total = cache_hits + cache_misses
if3 cmp3(cache_total, 0) {
  print3("    Hit rate: N/A")
} else3 {
  let hit_pct = pct_fmt3(cache_hits, cache_total)
  print3("    Hit rate: " + hit_pct)
}

// ============================================================
// Step 7: Pipeline history
// ============================================================
print3("")
print3(">>> Step 7: Pipeline History")
let hist = get3("http://127.0.0.1:9927/tci/history")
let hist_entries = dict_get(hist, "entries") ?? []
let hist_count = len(hist_entries)
print3("    History entries: " + str(hist_count))
if3 cmp3(hist_count, 0) {
  print3("    (no history yet)")
} else3 {
  // Show last 3 entries
  let show_count = H3
  if3 cmp3(hist_count, show_count) {
    let show_count = hist_count
  } else3 {}
  let idx = 0
  for3 entry in hist_entries {
    if3 cmp3(idx, show_count) {
    } else3 {
      let epipe = dict_get(entry, "pipeline") ?? "?"
      let etrit = dict_get(entry, "trit") ?? -1
      print3("      " + pad_str3(epipe, 12) + trit_fmt3(etrit))
    }
    let idx = idx + 1
  }
}

// ============================================================
// Step 8: Analytics
// ============================================================
print3("")
print3(">>> Step 8: Pipeline Analytics")
let analytics = get3("http://127.0.0.1:9927/tci/analytics")
let a_trit = dict_get(analytics, "trit") ?? -1
if3 a_trit {
  print3("    Analytics not available")
} maybe {
  let total_runs = dict_get(analytics, "total_runs") ?? 0
  print3("    Total pipeline runs: " + str(total_runs))
  print3("    Analytics: " + trit_fmt3(a_trit))
} else3 {
  let total_runs = dict_get(analytics, "total_runs") ?? 0
  print3("    Total pipeline runs: " + str(total_runs))
  print3("    Analytics: " + trit_fmt3(a_trit))
}

// ============================================================
// Step 9: TCI Stats
// ============================================================
print3("")
print3(">>> Step 9: Overall Stats")
let stats = get3("http://127.0.0.1:9927/tci/stats")
let stats_trit = dict_get(stats, "trit") ?? -1
print3("    TCI Stats: " + trit_fmt3(stats_trit))

// ============================================================
// Summary
// ============================================================
print3("")
let trits = [lint_trit, build_trit, test_trit]
let counts = trit_counts3(trits)
let score = trit_score3(trits)
let passed = dict_get(counts, "positive") ?? 0
let partial = dict_get(counts, "maybe") ?? 0
let failed = dict_get(counts, "negative") ?? 0

print3("╔═══════════════════════════════════════════╗")
print3("║   Pipeline Summary                        ║")
print3("╠═══════════════════════════════════════════╣")
print3("║   Lint:  " + trit_fmt3(lint_trit) + "                          ║")
print3("║   Build: " + trit_fmt3(build_trit) + "                          ║")
print3("║   Test:  " + trit_fmt3(test_trit) + "                          ║")
print3("║   Pass/Partial/Fail: " + str(passed) + "/" + str(partial) + "/" + str(failed) + "               ║")
print3("║   Health: " + progress3(passed, H3, 15) + "            ║")
print3("╚═══════════════════════════════════════════╝")
