// ============================================================
// NOVAX EXAMPLE: Ternary FSM Demo
// ============================================================
// Demonstrates the fsm3 stdlib: service lifecycle, efficiency
// comparison, and custom FSM construction.
// Run: python novalang.py examples/tfsm_demo.nova
// ============================================================

import3 fsm3
import3 trit3

print3("=== NovaX Ternary Finite State Machine ===")
print3("")

// -------------------------------------------------------
// 1. EFFICIENCY PROOF: Ternary vs Binary encoding
// -------------------------------------------------------
print3("--- Encoding Efficiency: Ternary vs Binary ---")
let test_sizes = [9, 16, 27, 64, 81, 243]
for3 n in test_sizes {
  let eff = tfsm_efficiency3(n)
  print3("States=" + str(n) + ": binary=" + str(eff["binary_bits"]) + " bits (cap " + str(eff["binary_capacity"]) + ", waste " + str(eff["binary_waste"]) + ") | ternary=" + str(eff["ternary_trits"]) + " trits (cap " + str(eff["ternary_capacity"]) + ", waste " + str(eff["ternary_waste"]) + ") | savings=" + str(eff["encoding_savings_pct"]) + "%")
}
print3("")

// -------------------------------------------------------
// 2. SERVICE LIFECYCLE FSM
// -------------------------------------------------------
print3("--- NovaX Service Lifecycle TFSM ---")
let svc = tfsm_service_lifecycle3()

// Validate completeness
let valid = tfsm_validate3(svc)
print3("Validation: states=" + str(valid["total_states"]) + " transitions=" + str(valid["total_transitions"]) + " complete=" + trit_label3(valid["trit"]))
print3("")

// Simulate: boot sequence (+1,+1,+1,+1 = IDLE→BOOTING→WARM→ACTIVE→PEAK)
print3("-- Boot sequence: 4x success signals --")
let current = tfsm_current3(svc)
print3("Start: " + current["label"] + " (output=" + str(current["output"]) + ")")

let boot_inputs = [1, 1, 1, 1]
let result = tfsm_run3(svc, boot_inputs)
let svc = result["fsm"]
for3 rec in result["records"] {
  let from_label = tfsm_label3(svc, rec["from"])
  let to_label = tfsm_label3(svc, rec["to"])
  print3("  input=" + str(rec["input"]) + ": " + from_label + " -> " + to_label + " (output=" + str(rec["output"]) + " " + tfsm_health_label3(rec["output"]) + ")")
}
print3("")

// Simulate: degradation (3x failure from PEAK)
print3("-- Degradation: 3x failure signals --")
let fail_inputs = [-1, -1, -1]
let result2 = tfsm_run3(svc, fail_inputs)
let svc = result2["fsm"]
for3 rec in result2["records"] {
  let from_label = tfsm_label3(svc, rec["from"])
  let to_label = tfsm_label3(svc, rec["to"])
  print3("  input=" + str(rec["input"]) + ": " + from_label + " -> " + to_label + " (output=" + str(rec["output"]) + " " + tfsm_health_label3(rec["output"]) + ")")
}
print3("")

// Simulate: recovery (5x success from DEGRADED)
print3("-- Recovery: 5x success signals --")
let recover_inputs = [1, 1, 1, 1, 1]
let result3 = tfsm_run3(svc, recover_inputs)
let svc = result3["fsm"]
for3 rec in result3["records"] {
  let from_label = tfsm_label3(svc, rec["from"])
  let to_label = tfsm_label3(svc, rec["to"])
  print3("  input=" + str(rec["input"]) + ": " + from_label + " -> " + to_label + " (output=" + str(rec["output"]) + " " + tfsm_health_label3(rec["output"]) + ")")
}

let final = tfsm_current3(svc)
print3("")
print3("Final state: " + final["label"] + " health=" + tfsm_health_label3(final["output"]))
print3("")

// -------------------------------------------------------
// 3. BALANCED TERNARY ENCODING
// -------------------------------------------------------
print3("--- Balanced Ternary State Encoding ---")
let test_vals = [-4, -3, -2, -1, 0, 1, 2, 3, 4]
for3 v in test_vals {
  let trits = to_trits3(v, 3)
  let decoded = from_trits3(trits)
  print3("  " + str(v) + " -> trits " + str(trits) + " -> decoded " + str(decoded))
}
print3("")
print3("=== TFSM Framework Ready ===")
