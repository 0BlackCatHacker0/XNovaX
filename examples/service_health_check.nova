// ============================================================
// NOVAX EXAMPLE: Service Health Check
// ============================================================
// Pings all core services and reports health.
// Run: python novalang.py examples/service_health_check.nova
// ============================================================

import3 http3
import3 trit3

print3("=== NovaX Service Health Check ===")
print3("")

// Core service ports
let services = [
  {"name": "Orchestrator", "port": 9999},
  {"name": "Hivemind", "port": 9881},
  {"name": "TShell/NovaXCore", "port": 9890},
  {"name": "Nova Tools", "port": 9891},
  {"name": "TSpeak", "port": 9895},
  {"name": "Ternary Tools", "port": 9894},
  {"name": "Cloud Router", "port": 9878},
  {"name": "TFetch", "port": 9897},
  {"name": "TKill", "port": 9899},
  {"name": "BitNet Fleet", "port": 9926},
  {"name": "TCI Pipeline", "port": 9927},
  {"name": "TAlchemy", "port": 9928}
]

let up_count = 0
let down_count = 0
let maybe_count = 0

for3 svc in services {
  let trit = health3(svc["port"])
  let label = trit_label3(trit)
  let icon = "?"
  if3 trit {
    let icon = "[OK]"
    let up_count = up_count + 1
  } maybe {
    let icon = "[??]"
    let maybe_count = maybe_count + 1
  } else3 {
    let icon = "[--]"
    let down_count = down_count + 1
  }
  print3(icon + " " + svc["name"] + " (:" + str(svc["port"]) + ")")
}

print3("")
print3("=== Summary ===")
print3("Up:    " + str(up_count))
print3("Maybe: " + str(maybe_count))
print3("Down:  " + str(down_count))
print3("Total: " + str(len(services)))

let overall = to_trit3(up_count - down_count)
print3("Overall: " + trit_label3(overall))
