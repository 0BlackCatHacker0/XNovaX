// ============================================================
// NOVAX EXAMPLE: Auto-Documentation with TDocs
// ============================================================
// Demonstrates the TDocs service for generating and querying
// API documentation across the NovaX service mesh.
// Requires: Orchestrator (:9999) + TDocs (:9935) running.
// Run: python novalang.py examples/auto_docs.nova
// ============================================================

import3 http3
import3 format3
import3 trit3

let H3 = 3
let H7 = 7
let H13 = 13

print3("╔═══════════════════════════════════════════╗")
print3("║   NovaX Auto-Documentation Demo           ║")
print3("║   TDocs Service (:9935)                    ║")
print3("╚═══════════════════════════════════════════╝")
print3("")

// ============================================================
// Step 1: Health check
// ============================================================
print3(">>> Step 1: Health Check")
let h = health3(9935)
if3 h {
  print3("    TDocs service: OFFLINE")
  print3("    Start with: POST /api/services/boot")
  print3("    Exiting.")
} maybe {
  print3("    TDocs service: ONLINE (+1)")
} else3 {
  print3("    TDocs service: ONLINE (+1)")
}

// ============================================================
// Step 2: Auto-register all known services
// ============================================================
print3("")
print3(">>> Step 2: Auto-Register Services")
let reg = post3("http://127.0.0.1:9935/tdocs/auto-register", {})
let reg_count = dict_get(reg, "registered") ?? 0
print3("    Registered " + str(reg_count) + " services")

// ============================================================
// Step 3: Register a custom service manually
// ============================================================
print3("")
print3(">>> Step 3: Register Custom Service")
let custom = post3("http://127.0.0.1:9935/tdocs/register", {
  "service": "my-custom-api",
  "port": 8080,
  "description": "Example custom service for demo",
  "endpoints": [
    {"path": "/api/greet", "method": "GET", "description": "Return a ternary greeting"},
    {"path": "/api/compute", "method": "POST", "description": "Run ternary computation"},
    {"path": "/api/status", "method": "GET", "description": "Service trit status"}
  ]
})
let custom_trit = dict_get(custom, "trit") ?? -1
print3("    Custom service registered: " + trit_fmt3(custom_trit))

// ============================================================
// Step 4: List all documented services
// ============================================================
print3("")
print3(">>> Step 4: Service Directory")
let listing = get3("http://127.0.0.1:9935/tdocs/list")
let services = dict_get(listing, "services") ?? []
let total_svc = dict_get(listing, "total") ?? 0
print3("    Total services: " + str(total_svc))
print3("")

// Print service table
let svc_headers = ["Service", "Port", "Endpoints", "Description"]
let svc_rows = []
for3 svc in services {
  let sname = dict_get(svc, "service") ?? "?"
  let sport = str(dict_get(svc, "port") ?? 0)
  let sep_count = str(dict_get(svc, "endpoint_count") ?? 0)
  let sdesc = dict_get(svc, "description") ?? ""
  // Truncate description for table display
  let sdesc_short = slice3(sdesc, 0, 40)
  let svc_rows = append(svc_rows, [sname, sport, sep_count, sdesc_short])
}
let svc_table = table3(svc_headers, svc_rows)
for3 line in svc_table {
  print3("    " + line)
}

// ============================================================
// Step 5: Search endpoints
// ============================================================
print3("")
print3(">>> Step 5: Endpoint Search")

// Search for "health" endpoints
let search1 = get3("http://127.0.0.1:9935/tdocs/search?query=health")
let results1 = dict_get(search1, "results") ?? []
let count1 = dict_get(search1, "count") ?? 0
print3("    Search 'health': " + str(count1) + " matches")
for3 r in results1 {
  let rpath = dict_get(r, "path") ?? ""
  let rsvc = dict_get(r, "service") ?? ""
  let rmethod = dict_get(r, "method") ?? ""
  print3("      " + rmethod + " " + rpath + " (" + rsvc + ")")
}

print3("")

// Search for "query" endpoints
let search2 = get3("http://127.0.0.1:9935/tdocs/search?query=query")
let results2 = dict_get(search2, "results") ?? []
let count2 = dict_get(search2, "count") ?? 0
print3("    Search 'query': " + str(count2) + " matches")
for3 r in results2 {
  let rpath = dict_get(r, "path") ?? ""
  let rsvc = dict_get(r, "service") ?? ""
  let rmethod = dict_get(r, "method") ?? ""
  print3("      " + rmethod + " " + rpath + " (" + rsvc + ")")
}

// ============================================================
// Step 6: Get specific service docs
// ============================================================
print3("")
print3(">>> Step 6: Detailed Service Docs")
let detail = get3("http://127.0.0.1:9935/tdocs/get?service=orchestrator")
let detail_trit = dict_get(detail, "trit") ?? -1
if3 detail_trit {
  print3("    Service not found")
} maybe {
  let desc = dict_get(detail, "description") ?? ""
  let eps = dict_get(detail, "endpoints") ?? []
  print3("    Orchestrator: " + desc)
  print3("    Endpoints: " + str(len(eps)))
  for3 ep in eps {
    let epath = dict_get(ep, "path") ?? ""
    let emethod = dict_get(ep, "method") ?? ""
    let edesc = dict_get(ep, "description") ?? ""
    print3("      " + pad_str3(emethod, 6) + epath)
    print3("             " + edesc)
  }
} else3 {
  let desc = dict_get(detail, "description") ?? ""
  let eps = dict_get(detail, "endpoints") ?? []
  print3("    Orchestrator: " + desc)
  print3("    Endpoints: " + str(len(eps)))
  for3 ep in eps {
    let epath = dict_get(ep, "path") ?? ""
    let emethod = dict_get(ep, "method") ?? ""
    let edesc = dict_get(ep, "description") ?? ""
    print3("      " + pad_str3(emethod, 6) + epath)
    print3("             " + edesc)
  }
}

// ============================================================
// Step 7: Documentation stats
// ============================================================
print3("")
print3(">>> Step 7: Documentation Stats")
let stats = get3("http://127.0.0.1:9935/tdocs/stats")
let doc_svcs = dict_get(stats, "services_documented") ?? 0
let doc_eps = dict_get(stats, "total_endpoints") ?? 0
print3("    Services documented:  " + str(doc_svcs))
print3("    Total endpoints:      " + str(doc_eps))
print3("    Coverage:             " + progress3(doc_svcs, H13, 20))

// ============================================================
// Summary
// ============================================================
print3("")
print3("╔═══════════════════════════════════════════╗")
print3("║   Documentation Summary                   ║")
print3("╠═══════════════════════════════════════════╣")
print3("║   Services: " + pad_num3(doc_svcs, 4) + "                            ║")
print3("║   Endpoints: " + pad_num3(doc_eps, 4) + "                           ║")
print3("║   Status: " + trit_fmt3(1) + "                         ║")
print3("╚═══════════════════════════════════════════╝")
