// ============================================================
// NOVAX EXAMPLE: Class3 & Extends3 Demo
// ============================================================
// Demonstrates NovaLang OOP features.
// Run: python novalang.py examples/class_demo.nova
// ============================================================

import3 trit3

// -- Base service class --
class3 Service {
  let name = "unknown"
  let port = 0
  let status = 0

  fn init3(self, name, port) {
    self.name = name
    self.port = port
    self.status = 1
  }

  fn health(self) {
    return self.status
  }

  fn describe(self) {
    let label = trit_label3(self.status)
    return self.name + " (:" + str(self.port) + ") [" + label + "]"
  }
}

// -- Extended service with metrics --
class3 MonitoredService extends Service {
  let queries = 0
  let errors = 0

  fn init3(self, name, port) {
    self.name = name
    self.port = port
    self.status = 1
    self.queries = 0
    self.errors = 0
  }

  fn record_query(self, success) {
    self.queries = self.queries + 1
    if3 success {
      // ok
    } else3 {
      self.errors = self.errors + 1
    }
  }

  fn error_rate(self) {
    if3 cmp3(self.queries, 0) {
      return 0
    } maybe {
      return 0
    } else3 {
      return self.errors / self.queries * 100
    }
  }

  fn describe(self) {
    let base = self.name + " (:" + str(self.port) + ")"
    return base + " [queries=" + str(self.queries) + " errors=" + str(self.errors) + "]"
  }
}

// -- Create instances --
print3("=== Class3 Demo ===")

let svc = Service("TSpeak", 9895)
print3(svc.describe())

let mon = MonitoredService("Hivemind", 9881)
mon.record_query(1)
mon.record_query(1)
mon.record_query(-1)
mon.record_query(1)
mon.record_query(1)

print3(mon.describe())
print3("Error rate: " + str(mon.error_rate()) + "%")
print3("Health: " + trit_label3(mon.health()))

// -- Ternary fleet scoring --
print3("")
print3("=== Fleet Scoring ===")
let fleet = [
  MonitoredService("Model-A", 9001),
  MonitoredService("Model-B", 9002),
  MonitoredService("Model-C", 9003)
]

// Simulate queries
fleet[0].record_query(1)
fleet[0].record_query(1)
fleet[0].record_query(1)

fleet[1].record_query(1)
fleet[1].record_query(-1)
fleet[1].record_query(0)

fleet[2].record_query(-1)
fleet[2].record_query(-1)
fleet[2].record_query(1)

for3 m in fleet {
  print3(m.describe() + " | error_rate=" + str(m.error_rate()) + "%")
}

// Consensus on fleet health
let healths = [fleet[0].health(), fleet[1].health(), fleet[2].health()]
print3("Fleet consensus: " + trit_label3(consensus3(healths[0], healths[1], healths[2])))
