// ============================================================
// NOVAX EXAMPLE: Data Processing Pipeline
// ============================================================
// Shows NovaLang data transformation using stdlib.
// Run: python novalang.py examples/data_pipeline.nova
// ============================================================

import3 math3
import3 list3
import3 dict3
import3 trit3
import3 format3

print3("=== NovaX Data Pipeline Demo ===")
print3("")

// -- Sample dataset --
let data = [
  {"name": "Alpha",   "score": 85, "category": "A", "active": 1},
  {"name": "Beta",    "score": 72, "category": "B", "active": 1},
  {"name": "Gamma",   "score": 91, "category": "A", "active": -1},
  {"name": "Delta",   "score": 45, "category": "C", "active": 1},
  {"name": "Epsilon", "score": 88, "category": "A", "active": 1},
  {"name": "Zeta",    "score": 33, "category": "C", "active": 0},
  {"name": "Eta",     "score": 67, "category": "B", "active": 1},
  {"name": "Theta",   "score": 95, "category": "A", "active": 1},
  {"name": "Iota",    "score": 58, "category": "B", "active": -1},
  {"name": "Kappa",   "score": 79, "category": "A", "active": 1},
  {"name": "Lambda",  "score": 41, "category": "C", "active": 1},
  {"name": "Mu",      "score": 83, "category": "B", "active": 1},
  {"name": "Nu",      "score": 70, "category": "B", "active": 0}
]

print3("Raw data: " + str(len(data)) + " records")

// -- Step 1: Filter active only --
fn is_active(item) {
  return item["active"]
}
let active = filter3(data, is_active)
print3("After filter (active): " + str(len(active)))

// -- Step 2: Extract scores --
fn get_score(item) {
  return item["score"]
}
let scores = map3(active, get_score)

// -- Step 3: Statistics --
let total = sum3(scores)
let average = avg3(scores)
let minimum = min_list3(scores)
let maximum = max_list3(scores)

print3("")
print3("=== Score Statistics (Active Only) ===")
print3("Total:   " + str(total))
print3("Average: " + str(average))
print3("Min:     " + str(minimum))
print3("Max:     " + str(maximum))
print3("Range:   " + str(maximum - minimum))

// -- Step 4: Categorize by score --
let high = 0
let medium = 0
let low = 0

for3 s in scores {
  if3 cmp3(s, 80) {
    if3 cmp3(s, 60) {
      let low = low + 1
    } else3 {
      let medium = medium + 1
    }
  } maybe {
    let high = high + 1
  } else3 {
    let high = high + 1
  }
}

print3("")
print3("=== Score Distribution ===")
print3("High (80+):  " + str(high) + "  " + progress3(high, len(active), 20))
print3("Medium:      " + str(medium) + "  " + progress3(medium, len(active), 20))
print3("Low (<60):   " + str(low) + "  " + progress3(low, len(active), 20))

// -- Step 5: Category breakdown --
print3("")
print3("=== Category Breakdown ===")
let cat_a = 0
let cat_b = 0
let cat_c = 0
for3 item in active {
  let cat = item["category"]
  if3 cmp3(cat, "A") {
    // not A
  } maybe {
    let cat_a = cat_a + 1
  } else3 {
    // not A
  }
  if3 cmp3(cat, "B") {
    // not B
  } maybe {
    let cat_b = cat_b + 1
  } else3 {
    // not B
  }
  if3 cmp3(cat, "C") {
    // not C
  } maybe {
    let cat_c = cat_c + 1
  } else3 {
    // not C
  }
}

print3("Category A: " + str(cat_a))
print3("Category B: " + str(cat_b))
print3("Category C: " + str(cat_c))

// -- Step 6: Trit health summary --
let trits = map3(data, is_active)
let counts = trit_counts3(trits)
print3("")
print3("=== Dataset Health ===")
print3("Active (+1): " + str(counts["positive"]))
print3("Partial (0): " + str(counts["maybe"]))
print3("Inactive (-1): " + str(counts["negative"]))
print3("Health Score: " + str(trit_score3(trits)))

print3("")
print3("=== Pipeline Complete ===")
