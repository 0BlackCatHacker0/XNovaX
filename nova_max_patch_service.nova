pressure_code = append(pressure_code, {"prompt": "Implement a lock-free concurrent queue in Python using CAS semantics. Handle ABA problem.", "tier": 4, "signals": ["atomic", "cas", "compare", "swap", "aba", "node", "head", "tail"]})
pressure_code = append(pressure_code, {"prompt": "Design and implement a B+ tree with leaf-level linked list, supporting range queries, splits, and merges. Include both insert and delete with rebalancing.", "tier": 5, "signals": ["b+", "leaf", "internal", "split", "merge", "range", "rebalance", "order", "linked"]})
PRESSURE_PROBES = dict_set(PRESSURE_PROBES, "CODE", pressure_code)

let pressure_math = []
