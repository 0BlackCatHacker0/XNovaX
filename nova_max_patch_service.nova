let pressure_reason = []
pressure_reason = append(pressure_reason, {"prompt": "Is 2+2=4? Answer yes or no.", "tier": 1, "signals": ["yes"]})
pressure_reason = append(pressure_reason, {"prompt": "If all dogs are mammals, and Rex is a dog, what is Rex?", "tier": 2, "signals": ["mammal", "rex"]})
pressure_reason = append(pressure_reason, {"prompt": "A bat and ball cost $1.10 total. The bat costs $1 more than the ball. How much is the ball?", "tier": 3, "signals": ["0.05", "5 cent", "five"]})
pressure_reason = append(pressure_reason, {"prompt": "Three boxes labeled 'Apples', 'Oranges', 'Mixed' are ALL mislabeled. You pick one fruit from one box. From which box do you pick, and how do you relabel all three?", "tier": 4, "signals": ["mixed", "label", "one", "pick", "relabel", "deduce"]})
pressure_reason = append(pressure_reason, {"prompt": "A king has 1000 bottles of wine, one poisoned. He has 10 prisoners to test. Poison kills in exactly 24h. He has one day. Using binary encoding, how many bottles can he check and what is the strategy?", "tier": 5, "signals": ["binary", "2^10", "1024", "bit", "encode", "combination", "each prisoner"]})
PRESSURE_PROBES = dict_set(PRESSURE_PROBES, "REASON", pressure_reason)

let pressure_code = []
pressure_code = append(pressure_code, {"prompt": "What does `len('hello')` return in Python?", "tier": 1, "signals": ["5"]})
pressure_code = append(pressure_code, {"prompt": "Write a function to reverse a string without using [::-1].", "tier": 2, "signals": ["def", "return", "reverse", "loop", "join"]})
