pressure_math = append(pressure_math, {"prompt": "Find the eigenvalues of the matrix [[2,1],[1,2]].", "tier": 3, "signals": ["3", "1", "eigenvalue", "lambda"]})
pressure_math = append(pressure_math, {"prompt": "Prove that there are infinitely many primes using Euclid's method. Then extend to show infinitely many primes of form 4k+3.", "tier": 4, "signals": ["assume", "finite", "contradiction", "product", "4k+3", "remainder"]})
