language_probes = append(language_probes, {"prompt": "Translate 'Hello, how are you?' to French and Spanish.", "signals": ["Bonjour", "comment", "Hola"], "tier": "easy"})
language_probes = append(language_probes, {"prompt": "Explain the difference between active and passive voice. Give 3 examples of each.", "signals": ["active", "passive", "subject", "verb", "object", "by"], "tier": "medium"})
language_probes = append(language_probes, {"prompt": "Analyze the rhetorical devices used in Martin Luther King Jr's speech style. Identify at least 4 techniques with examples.", "signals": ["anaphora", "metaphor", "repetition", "parallelism", "allusion", "rhetoric"], "tier": "hard"})
