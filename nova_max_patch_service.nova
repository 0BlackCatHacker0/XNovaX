vision_probes = append(vision_probes, {"prompt": "What causes the tides on Earth?", "signals": ["moon", "gravity", "gravitational", "sun", "pull"], "tier": "easy"})
vision_probes = append(vision_probes, {"prompt": "Explain how mRNA vaccines work, from injection to immune response.", "signals": ["mRNA", "ribosome", "protein", "spike", "antibod", "immune", "T cell"], "tier": "medium"})
vision_probes = append(vision_probes, {"prompt": "Explain quantum entanglement and why it cannot be used for faster-than-light communication. Reference Bell's theorem.", "signals": ["entangle", "Bell", "measurement", "correlation", "local", "hidden variable", "no-communication"], "tier": "hard"})
PROBE_PROMPTS = dict_set(PROBE_PROMPTS, "VISION", vision_probes)

// LANGUAGE probes
