fn engine_init() {
    let engine_start_time = time()
    let engine_running = T_TRUE
    load_fingerprints()
    load_deep_fingerprints()
    let profiled = 0
    let fp_keys = keys(fingerprints)
    let fi = 0
    while3 fi < len(fp_keys) {
        let fp = dict_get(fingerprints, dict_get(fp_keys, fi))
        if3 dict_get(fp, "probe_count") ?? 0 > 0 { profiled = profiled + 1
        }
        fi = fi + 1
    }
    print("[MaxPatch] Engine initialized (3-5-7-13 harmonics)... [" + str(profiled) + " profiled from disk]")
}

// Run init on startup
engine_init()


