// AGENT probes
let agent_probes = []
agent_probes = append(agent_probes, {"prompt": "You are a system administrator. A web server is returning 503 errors. What is your first diagnostic step?", "signals": ["log", "check", "status", "resource", "restart", "memory", "disk"], "tier": "easy"})
agent_probes = append(agent_probes, {"prompt": "You are an AI agent tasked with automating a CI/CD pipeline. Describe your action plan including tools and checkpoints.", "signals": ["git", "build", "test", "deploy", "pipeline", "Docker", "monitor", "rollback"], "tier": "medium"})
agent_probes = append(agent_probes, {"prompt": "You are coordinating 5 specialized AI agents to handle a complex software migration project. Define each agent's role, communication protocol, and conflict resolution strategy.", "signals": ["agent", "role", "coordinate", "message", "priority", "conflict", "consensus", "fallback"], "tier": "hard"})
