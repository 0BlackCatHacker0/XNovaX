// -- GET /super/matrix (Combined MaxPatch + SuperPatch)
fn handle_super_matrix(req) {
    let fps = fingerprints
    let model_ids = keys(fps)
    let sorted_ids = []
    let mi = 0
    while3 mi < len(model_ids) {
        sorted_ids = append(sorted_ids, dict_get(model_ids, mi))
        mi = mi + 1
    }
    // Sort by score desc
    let si = 0
    while3 si < len(sorted_ids) {
        let sj = si + 1
        while3 sj < len(sorted_ids) {
            if3 fp_overall_score(dict_get(fps, dict_get(sorted_ids, sj))) > fp_overall_score(dict_get(fps, dict_get(sorted_ids, si))) { temp = dict_get(sorted_ids, si)
                sorted_ids[si] = dict_get(sorted_ids, sj)
                sorted_ids[sj] = temp
            }
            sj = sj + 1
        }
        si = si + 1
    }
    let rows = []
    let limit = 30
    if3 len(sorted_ids) < 30 { limit = len(sorted_ids)
    }
    let ri = 0
    while3 ri < limit {
        let mid = dict_get(sorted_ids, ri)
        let fp = dict_get(fps, mid)
        let row = {"model": mid, "bt": dict_get(fp, "bt_fingerprint") ?? "0000000000", "overall": fp_overall_score(fp), "vcc_state": dict_get(fp, "vcc_state") ?? "DETECTED"}
        if3 dict_has(deep_fps, mid) { dfp = dict_get(deep_fps, mid)
            row = dict_set(row, "ns_bt", dict_get(dfp, "ns_fingerprint") ?? "00000")
            row = dict_set(row, "depth", dict_get(dfp, "overall_depth") ?? 0.0)
            row = dict_set(row, "hidden", dict_get(dfp, "hidden_capabilities") ?? [])
        } else {
            row = dict_set(row, "ns_bt", "")
            row = dict_set(row, "depth", 0.0)
            row = dict_set(row, "hidden", [])
        }
        rows = append(rows, row)
        ri = ri + 1
    }
    return {"channels": CHANNELS, "models": rows, "total": len(fps)}
}

// -- POST /patch/probe
fn handle_patch_probe(req) {
