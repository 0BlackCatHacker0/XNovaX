domain_probes = append(domain_probes, {"prompt": "Compare and contrast the legal frameworks for data privacy in GDPR vs CCPA. Cover scope, consent requirements, and enforcement mechanisms.", "signals": ["GDPR", "CCPA", "consent", "data subject", "controller", "fine", "opt-out", "enforcement"], "tier": "hard"})
