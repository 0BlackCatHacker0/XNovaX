        let mi = 0
        while3 mi < len(discovered_local) {
            let m = dict_get(discovered_local, mi)
            if3 model_matches_channel(m, ch) == T_TRUE {
                if3 is_excluded(m) == T_FALSE {
                    local_match = append(local_match, m)
                }
            }
            mi = mi + 1
        }
        assignments = dict_set(assignments, ch, {"local": local_match, "patterns": dict_get(CHANNEL_ASSIGNMENTS, ch) ?? [], "count": len(local_match)})
        ci = ci + 1
    }
    return {"ok": T_TRUE, "assignments": assignments, "excluded": GENERATION_EXCLUDED, "fast_fallback": FAST_FALLBACK, "total_channels": len(CHANNELS)}
}

