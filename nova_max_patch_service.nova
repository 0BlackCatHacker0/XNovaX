// ============================================================================
// BALANCED TERNARY HELPERS
// ============================================================================

fn score_to_trit(score) {
    // Ternary thirds quantization: >2/H3 -> +1, 1/H3-2/H3 -> 0, <1/H3 -> -1
    if3 score > 0.667 { result = 1
    } else {
        if3 score < 0.333 { result = -1
        } else { result = 0
        }
    }
    result
}

fn trit_to_char(t) {
    if3 t == 1 { c = "1"
    } else {
        if3 t == -1 { c = "T"
        } else { c = "0"
        }
    }
    c
}

fn char_to_trit(c) {
    if3 c == "1" { t = 1
    } else {
        if3 c == "T" { t = -1
        } else { t = 0
        }
    }
    t
}

fn bt_string(trits) {
    // List of trits to balanced ternary string
    let result = ""
    let idx = 0
    while3 idx < len(trits) {
        let t = dict_get(trits, idx)
        result = result + trit_to_char(t)
        idx = idx + 1
    }
    result
}

fn bt_neg(bt_str) {
    // Negate BT string -- flip all trits
    let result = ""
    let chars = split(bt_str, "")
    let idx = 0
    while3 idx < len(chars) {
        let c = dict_get(chars, idx)
        if3 c == "1" { result = result + "T"
        } else {
            if3 c == "T" { result = result + "1"
            } else { result = result + "0"
            }
        }
        idx = idx + 1
    }
    result
}

fn bt_or3(a_str, b_str) {
    // Ensemble coverage: max trit per position
    let result = ""
    let a_chars = split(a_str, "")
    let b_chars = split(b_str, "")
    let idx = 0
    while3 idx < len(a_chars) {
        let a_trit = char_to_trit(dict_get(a_chars, idx))
        let b_trit = char_to_trit(dict_get(b_chars, idx))
        let mx = max(a_trit, b_trit)
        result = result + trit_to_char(mx)
        idx = idx + 1
    }
    result
}

fn bt_cmp3(a_str, b_str) {
    // Compare two BT fingerprints: +1 if a stronger, 0 if equal, -1 if b stronger
    let a_chars = split(a_str, "")
    let b_chars = split(b_str, "")
    let a_val = 0
    let b_val = 0
    let total = len(a_chars)
    let idx = 0
    while3 idx < total {
        let power = total - 1 - idx
        let a_t = char_to_trit(dict_get(a_chars, idx))
        let b_t = char_to_trit(dict_get(b_chars, idx))
        // 3^power approximation via repeated multiplication
        let mult = 1
        let pi = 0
        while3 pi < power {
            mult = mult * 3
            pi = pi + 1
        }
        a_val = a_val + a_t * mult
        b_val = b_val + b_t * mult
        idx = idx + 1
    }
    if3 a_val > b_val { cmp = 1
    } else {
        if3 a_val < b_val { cmp = -1
        } else { cmp = 0
        }
    }
    cmp
}


// ============================================================================
// FINGERPRINT HELPERS (replaces TernaryFingerprint dataclass)
// ============================================================================

fn make_fingerprint(model_id, is_cloud) {
    // Create a new fingerprint dict
    let fp = {}
    fp = dict_set(fp, "model_id", model_id)
    fp = dict_set(fp, "is_cloud", is_cloud)
    // Channel scores
    let scores = {}
    let ci = 0
    while3 ci < len(CHANNELS) {
        scores = dict_set(scores, dict_get(CHANNELS, ci), 0.0)
        ci = ci + 1
    }
    fp = dict_set(fp, "channel_scores", scores)
    // Channel confidence
    let conf = {}
    let ci2 = 0
    while3 ci2 < len(CHANNELS) {
        conf = dict_set(conf, dict_get(CHANNELS, ci2), 0)
        ci2 = ci2 + 1
    }
    fp = dict_set(fp, "channel_confidence", conf)
    fp = dict_set(fp, "bt_fingerprint", "0000000000")
    // Territory
    let terr = {}
    let ci3 = 0
    while3 ci3 < len(CHANNELS) {
        terr = dict_set(terr, dict_get(CHANNELS, ci3), 0)
        ci3 = ci3 + 1
    }
    fp = dict_set(fp, "territory", terr)
    fp = dict_set(fp, "strengths", [])
    fp = dict_set(fp, "weaknesses", [])
    fp = dict_set(fp, "limits", {"max_context_tokens": 0, "avg_tokens_per_sec": 0.0, "failure_modes": [], "reasoning_depth": 0, "instruction_complexity": 0})
    fp = dict_set(fp, "ensemble_partners", {})
    fp = dict_set(fp, "probed_at", 0.0)
    fp = dict_set(fp, "probe_count", 0)
    fp = dict_set(fp, "vcc_state", "DETECTED")
    fp
}

fn update_bt(fp) {
    // Recompute balanced ternary fingerprint from float scores
    let scores = dict_get(fp, "channel_scores") ?? {}
    let trits = []
    let strengths = []
    let weaknesses = []
    let ci = 0
    while3 ci < len(CHANNELS) {
        let ch = dict_get(CHANNELS, ci)
        let sc = dict_get(scores, ch) ?? 0.0
        let t = score_to_trit(sc)
        trits = append(trits, t)
        if3 t == 1 {
            strengths = append(strengths, ch)
        } else {
            if3 t == -1 { conf = dict_get(dict_get(fp, "channel_confidence") ?? {}, ch) ?? 0
                if3 conf > 0 {
                    weaknesses = append(weaknesses, ch)
                }
            }
        }
        ci = ci + 1
    }
    fp = dict_set(fp, "bt_fingerprint", bt_string(trits))
    fp = dict_set(fp, "strengths", strengths)
    fp = dict_set(fp, "weaknesses", weaknesses)
    fp
}

fn fp_trit_for(fp, channel) {
    // Get trit value for a specific channel from fingerprint
    let bt = dict_get(fp, "bt_fingerprint") ?? "0000000000"
    let ci = 0
    let found = -1
    while3 ci < len(CHANNELS) {
        if3 dict_get(CHANNELS, ci) == channel { found = ci
        }
        ci = ci + 1
    }
    if3 found < 0 { trit = 0
    } else { chars = split(bt, "")
        if3 found < len(chars) { trit = char_to_trit(dict_get(chars, found))
        } else { trit = 0
        }
    }
    trit
}

fn fp_overall_score(fp) {
    let scores = dict_get(fp, "channel_scores") ?? {}
    let total = 0.0
    let count = 0
    let ci = 0
    while3 ci < len(CHANNELS) {
        let ch = dict_get(CHANNELS, ci)
        let v = dict_get(scores, ch) ?? 0.0
        if3 v > 0 { total = total + v
            count = count + 1
        }
        ci = ci + 1
    }
    if3 count > 0 { result = round(total / count, 3)
    } else { result = 0.0
    }
    result
}

fn fp_to_dict(fp) {
    let scores = dict_get(fp, "channel_scores") ?? {}
    let rounded = {}
    let ci = 0
    while3 ci < len(CHANNELS) {
        let ch = dict_get(CHANNELS, ci)
        rounded = dict_set(rounded, ch, round(dict_get(scores, ch) ?? 0.0, 3))
        ci = ci + 1
    }
    let result = {}
    result = dict_set(result, "model_id", dict_get(fp, "model_id") ?? "")
    result = dict_set(result, "is_cloud", dict_get(fp, "is_cloud") ?? T_FALSE)
    result = dict_set(result, "bt_fingerprint", dict_get(fp, "bt_fingerprint") ?? "0000000000")
    result = dict_set(result, "overall_score", fp_overall_score(fp))
    result = dict_set(result, "channel_scores", rounded)
    result = dict_set(result, "channel_confidence", dict_get(fp, "channel_confidence") ?? {})
    result = dict_set(result, "territory", dict_get(fp, "territory") ?? {})
    result = dict_set(result, "strengths", dict_get(fp, "strengths") ?? [])
    result = dict_set(result, "weaknesses", dict_get(fp, "weaknesses") ?? [])
    result = dict_set(result, "limits", dict_get(fp, "limits") ?? {})
    result = dict_set(result, "ensemble_partners", dict_get(fp, "ensemble_partners") ?? {})
    result = dict_set(result, "probed_at", dict_get(fp, "probed_at") ?? 0.0)
    result = dict_set(result, "probe_count", dict_get(fp, "probe_count") ?? 0)
    result = dict_set(result, "vcc_state", dict_get(fp, "vcc_state") ?? "DETECTED")
    result
}

fn fp_summary(fp) {
    let result = {}
    result = dict_set(result, "model_id", dict_get(fp, "model_id") ?? "")
    result = dict_set(result, "is_cloud", dict_get(fp, "is_cloud") ?? T_FALSE)
    result = dict_set(result, "bt", dict_get(fp, "bt_fingerprint") ?? "0000000000")
    result = dict_set(result, "overall", fp_overall_score(fp))
    result = dict_set(result, "strengths", dict_get(fp, "strengths") ?? [])
    result = dict_set(result, "weaknesses", dict_get(fp, "weaknesses") ?? [])
    result = dict_set(result, "vcc_state", dict_get(fp, "vcc_state") ?? "DETECTED")
    result = dict_set(result, "probe_count", dict_get(fp, "probe_count") ?? 0)
    result
}


// ============================================================================
// MODEL MATCHING HELPERS
// ============================================================================

fn model_matches_channel(model_name, channel) {
    // Check if a model name matches a channel assignment pattern
    let patterns = dict_get(CHANNEL_ASSIGNMENTS, channel) ?? []
    let parts = split(model_name, ":")
    let base = parts[0]
    let found = T_FALSE
    let pi = 0
    while3 pi < len(patterns) {
        let pat = dict_get(patterns, pi)
        if3 contains(model_name, pat) { found = T_TRUE
        } else {
            if3 pat == base { found = T_TRUE
            }
        }
        pi = pi + 1
    }
    found
}

fn is_excluded(model_name) {
    // Check if a model is embedding/safety (never generate text)
    let parts = split(model_name, ":")
    let base = parts[0]
    let excluded = T_FALSE
    let ei = 0
    while3 ei < len(GENERATION_EXCLUDED) {
        if3 dict_get(GENERATION_EXCLUDED, ei) == base { excluded = T_TRUE
        }
        ei = ei + 1
    }
    excluded
}

fn has_refusal(text_lower) {
    // Check if text contains refusal signals
    let found = T_FALSE
    let ri = 0
    while3 ri < len(REFUSAL_SIGNALS) {
        if3 contains(text_lower, dict_get(REFUSAL_SIGNALS, ri)) { found = T_TRUE
        }
        ri = ri + 1
    }
    found
}


// ============================================================================
// SCORING FUNCTIONS
// ============================================================================

fn score_response(response, probe) {
    // Multi-signal scoring: length + signal hits + confidence + structure
    if3 len(trim(response)) < 5 { result = 0.0
    } else { text = trim(response)
        let text_lower = lower(text)

        // Refusal detection
        if3 has_refusal(text_lower) == T_TRUE { result = 0.05
        } else { score = 0.0

            // Length score (max H3/H13 ~ 0.231)
            let len_score = len(text) / 200.0
            if3 len_score > 0.231 { len_score = 0.231
            }
            score = score + len_score

            // Signal hits (max H5/H13 ~ 0.385)
            let signals = dict_get(probe, "signals") ?? []
            if3 len(signals) > 0 { hits = 0
                let si = 0
                while3 si < len(signals) {
                    if3 contains(text_lower, lower(dict_get(signals, si))) { hits = hits + 1
                    }
                    si = si + 1
                }
                score = score + (hits / len(signals)) * 0.385
            }

            // Confidence words (max 1/H13 ~ 0.077)
            let conf_hits = 0
            let cwi = 0
            while3 cwi < len(CONFIDENCE_WORDS) {
                if3 contains(text_lower, dict_get(CONFIDENCE_WORDS, cwi)) { conf_hits = conf_hits + 1
                }
                cwi = cwi + 1
            }
            let conf_score = conf_hits / 5.0
            if3 conf_score > 0.077 { conf_score = 0.077
            }
            score = score + conf_score

            // Structure score (max H3/H13)
            let struct_score = 0.0
            if3 contains(text, "```") { struct_score = struct_score + 0.077
            }
            if3 contains(text, "1.") { struct_score = struct_score + 0.077
            }
            if3 contains(text, "#") { struct_score = struct_score + 0.077
            }
            if3 struct_score > 0.231 { struct_score = 0.231
            }
            score = score + struct_score

            // Tier bonus/penalty
            let tier = dict_get(probe, "tier") ?? "easy"
            if3 tier == "hard" { score = score * 1.667
            } else {
                if3 tier == "easy" {
                    if3 score < 0.333 { score = score * 0.333
                    }
                }
            }

            if3 score > 1.0 { score = 1.0
            }
            let result = round(score, 3)
        }
    }
    result
}

fn super_score_response(response, signals, tier_weight) {
    // Score a SuperPatch probe response. Returns 0.0-1.0
    if3 len(trim(response)) < 5 { result = 0.0
    } else { text = trim(response)
        let text_lower = lower(text)

        if3 has_refusal(text_lower) == T_TRUE { result = 0.05
        } else { score = 0.0
            // Length contribution (max H3/H13)
            let len_s = len(text) / 300.0
            if3 len_s > 0.231 { len_s = 0.231
            }
            score = score + len_s

            // Signal hits (max H5/H13)
            if3 len(signals) > 0 { hits = 0
                let si = 0
                while3 si < len(signals) {
                    if3 contains(text_lower, lower(dict_get(signals, si))) { hits = hits + 1
                    }
                    si = si + 1
                }
                score = score + (hits / len(signals)) * 0.385
            }

            // Structure bonus (max 1/H13)
            if3 contains(text, "```") { score = score + 0.077
            } else {
                if3 contains(text, "1.") { score = score + 0.077
                }
            }

            score = score * tier_weight
            if3 score > 1.0 { score = 1.0
            }
            let result = round(score, 3)
        }
    }
    result
}


// ============================================================================
// MODEL QUERYING
// ============================================================================

fn query_model_direct(model_id, prompt, channel) {
    // Query a single model -- local via Ollama, cloud via Cloud Router, cortex via Cortex
    let result = {}

    try3 {
        if3 starts_with(model_id, "cortex:") {
            // Cortex desktop models
            let parts = split(model_id, ":")
            let target = parts[1]
            let endpoint = "/cortex/" + target
            let t0 = time()
            let payload = json_encode({"prompt": prompt, "timeout": 90})
            let resp = http_post(CORTEX_URL + endpoint, payload)
            let elapsed = round((time() - t0) * 1000)
            let resp_data = json_decode(resp)
            if3 dict_get(resp_data, "ok") ?? T_FALSE == T_TRUE {
                result = dict_set(result, "ok", T_TRUE)
                result = dict_set(result, "response", dict_get(resp_data, "response") ?? "")
                result = dict_set(result, "time_ms", elapsed)
                result = dict_set(result, "tokens", 0)
            } else {
                result = dict_set(result, "ok", T_FALSE)
                result = dict_set(result, "response", "")
                result = dict_set(result, "error", dict_get(resp_data, "error") ?? "cortex failed")
                result = dict_set(result, "time_ms", elapsed)
        } else {
            if3 starts_with(model_id, "cloud:") {
                // Cloud models via Cloud Router
                let parts = split(model_id, ":")
                if3 len(parts) < 3 {
                    result = dict_set(result, "ok", T_FALSE)
                    result = dict_set(result, "response", "")
                    result = dict_set(result, "error", "bad cloud id: " + model_id)
                } else { provider = dict_get(parts, 1)
                    let model_name = dict_get(parts, 2)
                    let t0 = time()
                    let payload = json_encode({"prompt": prompt, "providers": [provider], "model": model_name})
                    let resp = http_post(CLOUD_URL + "/api/v1/query", payload)
                    let elapsed = round((time() - t0) * 1000)
                    let resp_data = json_decode(resp)
                    let best = dict_get(resp_data, "best") ?? {}
                    if3 dict_get(best, "ok") ?? T_FALSE == T_TRUE {
                        result = dict_set(result, "ok", T_TRUE)
                        result = dict_set(result, "response", dict_get(best, "resp") ?? "")
                        result = dict_set(result, "time_ms", dict_get(best, "ms") ?? elapsed)
                        result = dict_set(result, "tokens", dict_get(best, "tok") ?? 0)
                    } else {
                        // Check results array
                        let results_arr = dict_get(resp_data, "results") ?? []
                        let found_ok = T_FALSE
                        let ri = 0
                        while3 ri < len(results_arr) {
                            let r = dict_get(results_arr, ri)
                            if3 dict_get(r, "ok") ?? T_FALSE == T_TRUE {
                                result = dict_set(result, "ok", T_TRUE)
                                result = dict_set(result, "response", dict_get(r, "resp") ?? "")
                                result = dict_set(result, "time_ms", dict_get(r, "ms") ?? elapsed)
                                result = dict_set(result, "tokens", dict_get(r, "tok") ?? 0)
                                let found_ok = T_TRUE
                                let ri = len(results_arr)
                            }
                            ri = ri + 1
                        }
                        if3 found_ok == T_FALSE {
                            result = dict_set(result, "ok", T_FALSE)
                            result = dict_set(result, "response", "")
                            result = dict_set(result, "error", dict_get(best, "err") ?? "no results")
                            result = dict_set(result, "time_ms", elapsed)
            } else {
                // Local models via Ollama
                let t0 = time()
                let payload = json_encode({"model": model_id, "prompt": prompt, "system": "You are being evaluated on " + channel + " capability. Answer thoroughly.", "stream": T_FALSE, "options": {"num_predict": 512, "temperature": 0.7}})
                let resp = http_post(OLLAMA_URL + "/api/generate", payload)
                let elapsed = round((time() - t0) * 1000)
                let resp_data = json_decode(resp)
                result = dict_set(result, "ok", T_TRUE)
                result = dict_set(result, "response", dict_get(resp_data, "response") ?? "")
                result = dict_set(result, "time_ms", elapsed)
                result = dict_set(result, "tokens", dict_get(resp_data, "eval_count") ?? 0)
    } else {
        result = dict_set(result, "ok", T_FALSE)
        result = dict_set(result, "response", "")
        result = dict_set(result, "error", "query failed")
        result = dict_set(result, "time_ms", 0)
    }
    result
}
}
}
}
}
}
}

fn query_hivemind(prompt, channel) {
    let result = {}
    try3 {
        let payload = json_encode({"prompt": prompt, "channel": channel})
        let resp = http_post(HIVE_URL + "/hive/cluster/query", payload)
        let result = json_decode(resp)
    } else {
        result = dict_set(result, "ok", T_FALSE)
        result = dict_set(result, "error", "hivemind query failed")
    }
    result
}


// ============================================================================
// PROBING FUNCTIONS (replaces CapabilityProbe class)
// ============================================================================

fn probe_model(model_id, channels_to_probe) {
    // Run capability probes across channels and build fingerprint
    let is_cloud = starts_with(model_id, "cloud:") + starts_with(model_id, "cortex:")
    if3 is_cloud > 0 { is_cloud_flag = T_TRUE
    } else { is_cloud_flag = T_FALSE
    }
    let fp = make_fingerprint(model_id, is_cloud_flag)
    fp = dict_set(fp, "probed_at", time())

    let target_channels = channels_to_probe
    if3 len(target_channels) == 0 { target_channels = CHANNELS
    }

    let chi = 0
    while3 chi < len(target_channels) {
        let channel = dict_get(target_channels, chi)
        let probes = dict_get(PROBE_PROMPTS, channel) ?? (dict_get(PROBE_PROMPTS, "REASON") ?? [])
        let channel_scores = []

        let pi = 0
        while3 pi < len(probes) {
            let probe = dict_get(probes, pi)
            let probe_result = query_model_direct(model_id, dict_get(probe, "prompt") ?? "", channel)
            if3 dict_get(probe_result, "ok") ?? T_FALSE == T_TRUE { resp_text = dict_get(probe_result, "response") ?? ""
                if3 len(resp_text) > 0 { sc = score_response(resp_text, probe)
                    channel_scores = append(channel_scores, sc)
                    // Track speed
                    let ms = dict_get(probe_result, "time_ms") ?? 0
                    if3 ms > 0 { resp_len = len(resp_text)
                        let tps = (resp_len / 4.0) / (ms / 1000.0)
                        let lim = dict_get(fp, "limits") ?? {}
                        if3 tps > dict_get(lim, "avg_tokens_per_sec") ?? 0.0 {
                            lim = dict_set(lim, "avg_tokens_per_sec", round(tps, 1))
                } else {
                    channel_scores = append(channel_scores, 0.0)
            } else {
                channel_scores = append(channel_scores, 0.0)
                let err_msg = dict_get(probe_result, "error") ?? ""
                if3 len(err_msg) > 0 { lim = dict_get(fp, "limits") ?? {}
                    let fail_modes = dict_get(lim, "failure_modes") ?? []
                    let short_err = slice(err_msg, 0, 50)
                    // Check if already in list
                    let already = T_FALSE
                    let fi = 0
                    while3 fi < len(fail_modes) {
                        if3 dict_get(fail_modes, fi) == short_err { already = T_TRUE
                        }
                        fi = fi + 1
                    }
                    if3 already == T_FALSE {
                        fail_modes = append(fail_modes, short_err)
                    }
                }
            }
            pi = pi + 1
        }

        if3 len(channel_scores) > 0 { cs_sum = sum(channel_scores)
            let cs_avg = round(cs_sum / len(channel_scores), 3)
            let scores_dict = dict_get(fp, "channel_scores") ?? {}
            scores_dict = dict_set(scores_dict, channel, cs_avg)
            let conf_dict = dict_get(fp, "channel_confidence") ?? {}
            conf_dict = dict_set(conf_dict, channel, len(channel_scores))
        }

        // Detect reasoning depth from tier scores
        if3 len(channel_scores) >= H3 { easy_score = channel_scores[0]
            let med_score = channel_scores[1]
            let hard_score = channel_scores[2]
            let lim = dict_get(fp, "limits") ?? {}
            let cur_depth = dict_get(lim, "reasoning_depth") ?? 0
            if3 easy_score > 0.333 {
                if3 hard_score < 0.333 {
                    if3 cur_depth < 1 {
                        lim = dict_set(lim, "reasoning_depth", 1)
                    }
                }
            }
            if3 med_score > 0.333 {
                if3 cur_depth < 2 {
                    lim = dict_set(lim, "reasoning_depth", 2)
                }
            }
            if3 hard_score > 0.333 {
                if3 cur_depth < 3 {
                    lim = dict_set(lim, "reasoning_depth", 3)
                }
            }
        }

        chi = chi + 1
    }

    let cur_pc = dict_get(fp, "probe_count") ?? 0
    fp = dict_set(fp, "probe_count", cur_pc + 1)
    let fp = update_bt(fp)
    fp = dict_set(fp, "vcc_state", "PROFILED")
    fp
}


// ============================================================================
// LIMIT DETECTOR FUNCTIONS
// ============================================================================
}
}
}

fn detect_speed(model_id) {
    let test_prompts = ["Explain gravity in 2 sentences.", "Count from 1 to 20.", "Name 5 programming languages."]
    let speeds = []
    let ti = 0
    while3 ti < len(test_prompts) {
        try3 {
            let t0 = time()
            let payload = json_encode({"model": model_id, "prompt": dict_get(test_prompts, ti), "stream": T_FALSE, "options": {"num_predict": 512}})
            let resp = http_post(OLLAMA_URL + "/api/generate", payload)
            let elapsed = time() - t0
            let resp_data = json_decode(resp)
            let text = dict_get(resp_data, "response") ?? ""
            let tokens = len(text) / 4.0
            if3 elapsed > 0 {
                speeds = append(speeds, tokens / elapsed)
        } else {
            // skip on error
        }
        ti = ti + 1
    }
    if3 len(speeds) > 0 { result = round(sum(speeds) / len(speeds), 1)
    } else { result = 0.0
    }
    result
}


// ============================================================================
// INFLUENCE & TERRITORY (replaces PatchRouter internals)
// ============================================================================
}

fn compute_influence(fps) {
    // Go influence map: direct(H7/H13) + adjacent(H3/H13) + 2nd-order(1/H13)
    let w_direct = 0.538
    let w_adj = 0.231
    let w_second = 0.077
    let influence = {}
    let model_ids = keys(fps)
    let mi = 0
    while3 mi < len(model_ids) {
        let mid = dict_get(model_ids, mi)
        let fp = dict_get(fps, mid)
        let model_inf = {}
        let ci = 0
        while3 ci < len(CHANNELS) {
            let ch = dict_get(CHANNELS, ci)
            let fp_scores = dict_get(fp, "channel_scores") ?? {}
            let direct = (dict_get(fp_scores, ch) ?? 0.0) * w_direct
            // Adjacent channels
            let adj_scores = []
            if3 ci - 1 >= 0 {
                adj_scores = append(adj_scores, dict_get(fp_scores, dict_get(CHANNELS, ci - 1)) ?? 0.0)
            }
            if3 ci + 1 < len(CHANNELS) {
                adj_scores = append(adj_scores, dict_get(fp_scores, dict_get(CHANNELS, ci + 1)) ?? 0.0)
            }
            let adjacent = 0.0
            if3 len(adj_scores) > 0 { adjacent = (sum(adj_scores) / len(adj_scores)) * w_adj
            }
            // Second-order
            let sec_scores = []
            if3 ci - 2 >= 0 {
                sec_scores = append(sec_scores, dict_get(fp_scores, dict_get(CHANNELS, ci - 2)) ?? 0.0)
            }
            if3 ci + 2 < len(CHANNELS) {
                sec_scores = append(sec_scores, dict_get(fp_scores, dict_get(CHANNELS, ci + 2)) ?? 0.0)
            }
            let second = 0.0
            if3 len(sec_scores) > 0 { second = (sum(sec_scores) / len(sec_scores)) * w_second
            }
            model_inf = dict_set(model_inf, ch, round(direct + adjacent + second, 4))
            ci = ci + 1
        }
        influence = dict_set(influence, mid, model_inf)
        mi = mi + 1
    }
    influence
}

fn generate_patches(fps) {
    // Generate patches: for each model's -1 channels, find +1 specialist
    let influence = compute_influence(fps)
    let latest_influence = influence

    // Quantize influence to ternary territory
    let model_ids = keys(fps)
    let mi = 0
    while3 mi < len(model_ids) {
        let mid = dict_get(model_ids, mi)
        let fp = dict_get(fps, mid)
        let model_inf = dict_get(influence, mid) ?? {}
        let terr = dict_get(fp, "territory") ?? {}
        let ci = 0
        while3 ci < len(CHANNELS) {
            let ch = dict_get(CHANNELS, ci)
            let inf_score = dict_get(model_inf, ch) ?? 0.0
            if3 inf_score > 0.667 {
                terr = dict_set(terr, ch, 1)
            } else {
                if3 inf_score < 0.333 {
                    terr = dict_set(terr, ch, -1)
                } else {
                    terr = dict_set(terr, ch, 0)
                }
            }
            ci = ci + 1
        }
        mi = mi + 1
    }

    // Build patches
    let patches = {}
    let mi2 = 0
    while3 mi2 < len(model_ids) {
        let mid = dict_get(model_ids, mi2)
        let fp = dict_get(fps, mid)
        let model_patches = {}
        let ci = 0
        while3 ci < len(CHANNELS) {
            let ch = dict_get(CHANNELS, ci)
            let terr = dict_get(fp, "territory") ?? {}
            let conf = dict_get(fp, "channel_confidence") ?? {}
            if3 dict_get(terr, ch) ?? 0 == -1 {
                if3 dict_get(conf, ch) ?? 0 > 0 {
                    // Find specialist with +1 territory
                    let best_id = ""
                    let best_inf = 0.0
                    let oi = 0
                    while3 oi < len(model_ids) {
                        let other_id = dict_get(model_ids, oi)
                        if3 other_id != mid { other_fp = dict_get(fps, other_id)
                            let other_terr = dict_get(other_fp, "territory") ?? {}
                            if3 dict_get(other_terr, ch) ?? 0 == 1 { other_scores = dict_get(other_fp, "channel_scores") ?? {}
                                let other_score = dict_get(other_scores, ch) ?? 0.0
                                if3 other_score > best_inf { best_id = other_id
                                    let best_inf = other_score
                                }
                            }
                        }
                        oi = oi + 1
                    }
                    if3 len(best_id) > 0 {
                        model_patches = dict_set(model_patches, ch, best_id)
                        // Update ensemble partners
                        let partners = dict_get(fp, "ensemble_partners") ?? {}
                        let ch_partners = dict_get(partners, ch) ?? []
                        // Check not already in partners
                        let already_in = T_FALSE
                        let pi = 0
                        while3 pi < len(ch_partners) {
                            if3 dict_get(ch_partners, pi) == best_id { already_in = T_TRUE
                            }
                            pi = pi + 1
                        }
                        if3 already_in == T_FALSE {
                            ch_partners = append(ch_partners, best_id)
                            partners = dict_set(partners, ch, ch_partners)
                        }
                    }
                }
            }
            ci = ci + 1
        }
        if3 len(keys(model_patches)) > 0 {
            patches = dict_set(patches, mid, model_patches)
        }
        mi2 = mi2 + 1
    }

    let active_patches = patches
    patches
}


// ============================================================================
// ENSEMBLE OPTIMIZER FUNCTIONS
// ============================================================================

fn ensemble_record_result(channel, models_used, quality) {
    let key = join(sort(models_used), "|")
    if3 dict_has(ensemble_recipes, channel) == T_FALSE {
        ensemble_recipes = dict_set(ensemble_recipes, channel, [])
    }
    let recs = dict_get(ensemble_recipes, channel) ?? []
    let found = T_FALSE
    let ri = 0
    while3 ri < len(recs) {
        let recipe = dict_get(recs, ri)
        let rkey = join(sort(dict_get(recipe, "models") ?? []), "|")
        if3 rkey == key {
            // Harmonic EMA: 2/H3 old + 1/H3 new
            let old_score = dict_get(recipe, "score") ?? 0.0
            recipe = dict_set(recipe, "score", old_score * 0.667 + quality * 0.333)
            recipe = dict_set(recipe, "count", (dict_get(recipe, "count") ?? 0) + 1)
            let found = T_TRUE
        }
        ri = ri + 1
    }
    if3 found == T_FALSE {
        recs = append(recs, {"models": models_used, "score": quality, "count": 1})
    }
}

fn get_best_ensemble(channel, n) {
    let recs = dict_get(ensemble_recipes, channel) ?? []
    if3 len(recs) == 0 { result = []
    } else {
        // Find highest scoring recipe
        let best_score = -1.0
        let best_idx = 0
        let ri = 0
        while3 ri < len(recs) {
            let recipe = dict_get(recs, ri)
            if3 dict_get(recipe, "score") ?? 0.0 > best_score { best_score = dict_get(recipe, "score") ?? 0.0
                let best_idx = ri
            }
            ri = ri + 1
        }
        let best = dict_get(recs, best_idx)
        let models = dict_get(best, "models") ?? []
        if3 len(models) > n { result = slice(models, 0, n)
        } else { result = models
        }
    }
    result
}

fn optimize_ensembles(fps) {
    let ci = 0
    while3 ci < len(CHANNELS) {
        let channel = dict_get(CHANNELS, ci)
        // Rank models by channel score
        let model_ids = keys(fps)
        let ranked = []
        let mi = 0
        while3 mi < len(model_ids) {
            let mid = dict_get(model_ids, mi)
            let fp = dict_get(fps, mid)
            let score = dict_get(dict_get(fp, "channel_scores") ?? {}, channel) ?? 0.0
            ranked = append(ranked, {"mid": mid, "score": score})
            mi = mi + 1
        }
        // Sort by score (manual bubble sort since no sort-by-key builtin)
        let ri = 0
        while3 ri < len(ranked) {
            let rj = ri + 1
            while3 rj < len(ranked) {
                let a = dict_get(dict_get(ranked, ri), "score") ?? 0.0
                let b = dict_get(dict_get(ranked, rj), "score") ?? 0.0
                if3 b > a { temp = dict_get(ranked, ri)
                    ranked[ri] = dict_get(ranked, rj)
                    ranked[rj] = temp
                }
                rj = rj + 1
            }
            ri = ri + 1
        }

        if3 len(ranked) >= 2 { top_count = H7
            if3 len(ranked) < H7 { top_count = len(ranked)
            }
            let top = []
            let avg_sum = 0.0
            let ti = 0
            while3 ti < top_count {
                let entry = dict_get(ranked, ti)
                top = append(top, dict_get(entry, "mid"))
                avg_sum = avg_sum + dict_get(entry, "score") ?? 0.0
                ti = ti + 1
            }
            let avg_score = avg_sum / top_count

            if3 dict_has(ensemble_recipes, channel) == T_FALSE {
                ensemble_recipes = dict_set(ensemble_recipes, channel, [])
            }
            let recs = dict_get(ensemble_recipes, channel) ?? []
            let key = join(sort(top), "|")
            let found = T_FALSE
            let ri2 = 0
            while3 ri2 < len(recs) {
                let recipe = dict_get(recs, ri2)
                let rkey = join(sort(dict_get(recipe, "models") ?? []), "|")
                if3 rkey == key { old_s = dict_get(recipe, "score") ?? 0.0
                    if3 avg_score > old_s {
                        recipe = dict_set(recipe, "score", avg_score)
                    }
                    let found = T_TRUE
                }
                ri2 = ri2 + 1
            }
            if3 found == T_FALSE {
                recs = append(recs, {"models": top, "score": avg_score, "count": 0})
            }
        }
        ci = ci + 1
    }
}


// ============================================================================
// JAPANESE DECOMPOSER FUNCTIONS
// ============================================================================

fn classify_subtask(text) {
    let text_lower = lower(text)
    let best_ch = "REASON"
    let best_count = 0
    let ch_keys = keys(CHANNEL_KEYWORDS)
    let ki = 0
    while3 ki < len(ch_keys) {
        let ch = dict_get(ch_keys, ki)
        let kws = dict_get(CHANNEL_KEYWORDS, ch) ?? []
        let count = 0
        let kwi = 0
        while3 kwi < len(kws) {
            if3 contains(text_lower, dict_get(kws, kwi)) { count = count + 1
            }
            kwi = kwi + 1
        }
        if3 count > best_count { best_ch = ch
            let best_count = count
        }
        ki = ki + 1
    }
    best_ch
}

fn merge_sub_results(sub_results) {
    if3 len(sub_results) == 0 { result = {"merged_response": "", "agreement_ratio": 0.0}
    } else {
        // Group by channel
        let channel_results = {}
        let si = 0
        while3 si < len(sub_results) {
            let sr = dict_get(sub_results, si)
            let ch = dict_get(sr, "channel") ?? "REASON"
            if3 dict_has(channel_results, ch) == T_FALSE {
                channel_results = dict_set(channel_results, ch, [])
            }
            append(dict_get(channel_results, ch), dict_get(sr, "response") ?? "")
            si = si + 1
        }
        let agreements = 0
        let total_intersections = 0
        let ch_keys = keys(channel_results)
        let ci = 0
        while3 ci < len(ch_keys) {
            let ch = dict_get(ch_keys, ci)
            let responses = dict_get(channel_results, ch) ?? []
            if3 len(responses) >= 2 { total_intersections = total_intersections + 1
                // Simple overlap check
                agreements = agreements + 1
            }
            ci = ci + 1
        }
        // Merge responses by index order
        let merged = ""
        let si2 = 0
        while3 si2 < len(sub_results) {
            let sr = dict_get(sub_results, si2)
            let resp = dict_get(sr, "response") ?? ""
            if3 len(resp) > 0 {
                if3 len(merged) > 0 { merged = merged + " " + resp
                } else { merged = resp
                }
            }
            si2 = si2 + 1
        }
        let ratio = 1.0
        if3 total_intersections > 0 { ratio = round(agreements / total_intersections, 3)
        }
        let result = {"merged_response": merged, "agreement_ratio": ratio, "sub_task_count": len(sub_results), "intersections_checked": total_intersections}
    }
    result
}


// ============================================================================
// CHESS STRATEGY FUNCTIONS
// ============================================================================

fn chess_record_query(channel) {
    if3 len(channel_history) > 0 { prev = dict_get(channel_history, len(channel_history) - 1)
        if3 dict_has(transition_matrix, prev) == T_FALSE {
            transition_matrix = dict_set(transition_matrix, prev, {})
        }
        let trans = dict_get(transition_matrix, prev) ?? {}
        let cur = dict_get(trans, channel) ?? 0
        trans = dict_set(trans, channel, cur + 1)
    }
    channel_history = append(channel_history, channel)
    // Keep only last 200
    if3 len(channel_history) > 200 { channel_history = slice(channel_history, len(channel_history) - 200, len(channel_history))
    }
}

fn chess_lookahead(depth) {
    if3 len(channel_history) == 0 { predictions = []
    } else { current = dict_get(channel_history, len(channel_history) - 1)
        let transitions = dict_get(transition_matrix, current) ?? {}
        let t_keys = keys(transitions)
        if3 len(t_keys) == 0 { predictions = []
        } else { total = 0
            let ki = 0
            while3 ki < len(t_keys) {
                total = total + dict_get(transitions, dict_get(t_keys, ki)) ?? 0
                ki = ki + 1
            }
            // Sort by count (bubble sort)
            let sorted_keys = []
            let ki2 = 0
            while3 ki2 < len(t_keys) {
                sorted_keys = append(sorted_keys, dict_get(t_keys, ki2))
                ki2 = ki2 + 1
            }
            let si = 0
            while3 si < len(sorted_keys) {
                let sj = si + 1
                while3 sj < len(sorted_keys) {
                    let a_count = dict_get(transitions, dict_get(sorted_keys, si)) ?? 0
                    let b_count = dict_get(transitions, dict_get(sorted_keys, sj)) ?? 0
                    if3 b_count > a_count { temp = dict_get(sorted_keys, si)
                        sorted_keys[si] = dict_get(sorted_keys, sj)
                        sorted_keys[sj] = temp
                    }
                    sj = sj + 1
                }
                si = si + 1
            }
            let predictions = []
            let limit = depth + 1
            if3 limit > len(sorted_keys) { limit = len(sorted_keys)
            }
            let pi = 0
            while3 pi < limit {
                let ch = dict_get(sorted_keys, pi)
                let count = dict_get(transitions, ch) ?? 0
                predictions = append(predictions, {"channel": ch, "probability": round(count / total, 3), "count": count})
                pi = pi + 1
            }
        }
    }
    predictions
}

fn chess_check_opening(channel, regime) {
    let key = channel + "|" + regime
    let combo = dict_get(opening_book, key) ?? []
    if3 len(combo) > 0 { opening_hits = opening_hits + 1
    }
    combo
}

fn chess_check_endgame(channel, reynolds) {
    if3 reynolds >= 50 { model = ""
    } else { model = dict_get(endgame_table, channel) ?? ""
        if3 len(model) > 0 { endgame_hits = endgame_hits + 1
        }
    }
    model
}

fn chess_build_opening_book(recipes) {
    let ch_keys = keys(recipes)
    let ci = 0
    while3 ci < len(ch_keys) {
        let channel = dict_get(ch_keys, ci)
        let recs = dict_get(recipes, channel) ?? []
        let ri = 0
        while3 ri < len(recs) {
            let recipe = dict_get(recs, ri)
            if3 dict_get(recipe, "count") ?? 0 >= H5 {
                if3 dict_get(recipe, "score") ?? 0.0 > 0.333 { models = dict_get(recipe, "models") ?? []
                    let lam_key = channel + "|laminar"
                    let trans_key = channel + "|transitional"
                    if3 len(models) >= 2 {
                        opening_book = dict_set(opening_book, lam_key, slice(models, 0, 2))
                    }
                    if3 len(models) >= H3 {
                        opening_book = dict_set(opening_book, trans_key, slice(models, 0, H3))
                    }
                }
            }
            ri = ri + 1
        }
        ci = ci + 1
    }
}

fn chess_build_endgame_table(fps) {
    let ci = 0
    while3 ci < len(CHANNELS) {
        let channel = dict_get(CHANNELS, ci)
        let best_id = ""
        let best_latency = 999999.0
        let model_ids = keys(fps)
        let mi = 0
        while3 mi < len(model_ids) {
            let mid = dict_get(model_ids, mi)
            let fp = dict_get(fps, mid)
            let score = dict_get(dict_get(fp, "channel_scores") ?? {}, channel) ?? 0.0
            let tps = dict_get(dict_get(fp, "limits") ?? {}, "avg_tokens_per_sec") ?? 0.0
            if3 tps > 0 { lat = 1000.0 / tps
            } else { lat = 5000.0
            }
            if3 score > 0.333 {
                if3 lat < best_latency { best_id = mid
                    let best_latency = lat
                }
            }
            mi = mi + 1
        }
        if3 len(best_id) > 0 {
            endgame_table = dict_set(endgame_table, channel, best_id)
        }
        ci = ci + 1
    }
}

fn chess_pre_warm(model_id) {
    if3 starts_with(model_id, "cloud:") == T_FALSE {
        try3 {
            let payload = json_encode({"model": model_id, "messages": [{"role": "user", "content": "hi"}], "stream": T_FALSE, "options": {"num_predict": 1}})
            let resp = http_post(OLLAMA_URL + "/api/chat", payload)
            pre_warm_count = pre_warm_count + 1
        } else {
            // skip
        }
    }
}


// ============================================================================
// PERSISTENCE FUNCTIONS
// ============================================================================

fn load_fingerprints() {
    try3 {
        let raw = nova_read(PERSIST_PATH)
        if3 len(raw) > 2 { data = json_decode(raw)
            let model_ids = keys(data)
            let loaded = 0
            let mi = 0
            while3 mi < len(model_ids) {
                let mid = dict_get(model_ids, mi)
                let d = dict_get(data, mid)
                let fp = make_fingerprint(mid, dict_get(d, "is_cloud") ?? T_FALSE)
                fp = dict_set(fp, "channel_scores", dict_get(d, "channel_scores") ?? dict_get(fp, "channel_scores"))
                fp = dict_set(fp, "channel_confidence", dict_get(d, "channel_confidence") ?? dict_get(fp, "channel_confidence"))
                fp = dict_set(fp, "bt_fingerprint", dict_get(d, "bt_fingerprint") ?? "0000000000")
                fp = dict_set(fp, "territory", dict_get(d, "territory") ?? dict_get(fp, "territory"))
                fp = dict_set(fp, "strengths", dict_get(d, "strengths") ?? [])
                fp = dict_set(fp, "weaknesses", dict_get(d, "weaknesses") ?? [])
                fp = dict_set(fp, "limits", dict_get(d, "limits") ?? dict_get(fp, "limits"))
                fp = dict_set(fp, "ensemble_partners", dict_get(d, "ensemble_partners") ?? {})
                fp = dict_set(fp, "probed_at", dict_get(d, "probed_at") ?? 0.0)
                fp = dict_set(fp, "probe_count", dict_get(d, "probe_count") ?? 0)
                fp = dict_set(fp, "vcc_state", dict_get(d, "vcc_state") ?? "DETECTED")
                fingerprints = dict_set(fingerprints, mid, fp)
                loaded = loaded + 1
                mi = mi + 1
            }
            print("[MaxPatch] Loaded " + str(loaded) + " fingerprints from disk")
    } else {
        print("[MaxPatch] No fingerprints on disk or load failed")
    }
}
}

fn save_fingerprints() {
    try3 {
        let data = {}
        let model_ids = keys(fingerprints)
        let mi = 0
        while3 mi < len(model_ids) {
            let mid = dict_get(model_ids, mi)
            let fp = dict_get(fingerprints, mid)
            data = dict_set(data, mid, fp_to_dict(fp))
            mi = mi + 1
        }
        nova_write(PERSIST_PATH, json_encode(data))
    } else {
        print("[MaxPatch] Failed to save fingerprints")
    }
}

fn load_deep_fingerprints() {
    try3 {
        let raw = nova_read(DEEP_PERSIST_PATH)
        if3 len(raw) > 2 { data = json_decode(raw)
            let model_ids = keys(data)
            let loaded = 0
            let mi = 0
            while3 mi < len(model_ids) {
                let mid = dict_get(model_ids, mi)
                let d = dict_get(data, mid)
                let dfp = {}
                dfp = dict_set(dfp, "model_id", mid)
                dfp = dict_set(dfp, "pressure", dict_get(d, "pressure") ?? {})
                dfp = dict_set(dfp, "velocity", dict_get(d, "velocity") ?? {})
                dfp = dict_set(dfp, "viscosity", dict_get(d, "viscosity") ?? {})
                dfp = dict_set(dfp, "turbulence", dict_get(d, "turbulence") ?? {})
                dfp = dict_set(dfp, "vorticity", dict_get(d, "vorticity") ?? {})
                dfp = dict_set(dfp, "ns_fingerprint", dict_get(d, "ns_fingerprint") ?? "00000")
                dfp = dict_set(dfp, "hidden_capabilities", dict_get(d, "hidden_capabilities") ?? [])
                dfp = dict_set(dfp, "overall_depth", dict_get(d, "overall_depth") ?? 0.0)
                dfp = dict_set(dfp, "probed_at", dict_get(d, "probed_at") ?? 0.0)
                deep_fps = dict_set(deep_fps, mid, dfp)
                loaded = loaded + 1
                mi = mi + 1
            }
            if3 loaded > 0 {
                print("[SuperPatch] Loaded " + str(loaded) + " deep fingerprints from disk")
    } else {
        // no deep fingerprints yet
    }
}
}
}

fn save_deep_fingerprints() {
    try3 {
        let data = {}
        let model_ids = keys(deep_fps)
        let mi = 0
        while3 mi < len(model_ids) {
            let mid = dict_get(model_ids, mi)
            data = dict_set(data, mid, dict_get(deep_fps, mid))
            mi = mi + 1
        }
        nova_write(DEEP_PERSIST_PATH, json_encode(data))
    } else {
        print("[SuperPatch] Failed to save deep fingerprints")
    }
}


// ============================================================================
// MODEL DISCOVERY
// ============================================================================

fn discover_models() {
    let models = []

    // Local models from Hivemind
    try3 {
        let resp = http_get(HIVE_URL + "/hive/models")
        let data = json_decode(resp)
        let model_list = dict_get(data, "models") ?? []
        let mi = 0
        while3 mi < len(model_list) {
            let m = dict_get(model_list, mi)
            let name = ""
            if3 type_of(m) == "string" { name = m
            } else { name = dict_get(m, "name") ?? ""
            }
            if3 len(name) > 0 {
                models = append(models, name)
            }
            mi = mi + 1
    } else {
        print("[MaxPatch] Hivemind discovery failed")
    }

    let local_count = len(models)
    let discovered_local = []
    let li = 0
    while3 li < len(models) {
        discovered_local = append(discovered_local, dict_get(models, li))
        li = li + 1
    }

    // Cloud models from Cloud Router
    try3 {
        let resp = http_get(CLOUD_URL + "/api/v1/providers")
        let providers = json_decode(resp)
        let cloud_count = 0
        let p_keys = keys(providers)
        let pi = 0
        while3 pi < len(p_keys) {
            let pid = dict_get(p_keys, pi)
            let pinfo = dict_get(providers, pid) ?? {}
            if3 dict_get(pinfo, "cloud") ?? T_FALSE == T_TRUE {
                if3 dict_get(pinfo, "on") ?? T_FALSE == T_TRUE { p_models = dict_get(pinfo, "models") ?? []
                    let pmi = 0
                    while3 pmi < len(p_models) {
                        let model_name = dict_get(p_models, pmi)
                        models = append(models, "cloud:" + pid + ":" + model_name)
                        cloud_count = cloud_count + 1
                        pmi = pmi + 1
                    }
                }
            }
            pi = pi + 1
        }
        print("[MaxPatch] Discovered " + str(cloud_count) + " cloud models")
    } else {
        print("[MaxPatch] Cloud Router discovery failed")
    }

    // Desktop models from Nova Cortex
    try3 {
        let resp = http_get(CORTEX_URL + "/cortex/status")
        let cortex_data = json_decode(resp)
        let cortex_count = 0
        let claude_info = dict_get(cortex_data, "claude") ?? {}
        if3 dict_get(claude_info, "available") ?? T_FALSE == T_TRUE {
            models = append(models, "cortex:claude")
            cortex_count = cortex_count + 1
        }
        let gpt_info = dict_get(cortex_data, "gpt") ?? {}
        if3 dict_get(gpt_info, "available") ?? T_FALSE == T_TRUE {
            models = append(models, "cortex:gpt")
            cortex_count = cortex_count + 1
        }
        if3 cortex_count > 0 {
            print("[MaxPatch] Discovered " + str(cortex_count) + " Cortex desktop models")
    } else {
        // Cortex not available
    }

    // Create stub fingerprints for new models
    let mi2 = 0
    while3 mi2 < len(models) {
        let mid = dict_get(models, mi2)
        if3 dict_has(fingerprints, mid) == T_FALSE { is_cloud_check = starts_with(mid, "cloud:") + starts_with(mid, "cortex:")
            if3 is_cloud_check > 0 { ic = T_TRUE
            } else { ic = T_FALSE
            }
            fingerprints = dict_set(fingerprints, mid, make_fingerprint(mid, ic))
        }
        mi2 = mi2 + 1
    }

    let total_cloud = len(models) - local_count
    print("[MaxPatch] Total: " + str(len(models)) + " (" + str(local_count) + " local + " + str(total_cloud) + " cloud/cortex)")
    models
}


// ============================================================================
// SUPERPATCH DEEP PROBING FUNCTIONS
// ============================================================================
}
}

fn pressure_scan(model_id, channels) {
    // Pressure Gradient (nabla p): Find complexity ceiling per channel
    let target = channels
    if3 len(target) == 0 { target = keys(PRESSURE_PROBES)
    }
    let results = {}
    let ci = 0
    while3 ci < len(target) {
        let ch = dict_get(target, ci)
        let probes = dict_get(PRESSURE_PROBES, ch) ?? (dict_get(PRESSURE_PROBES, "REASON") ?? [])
        let scores = []
        let ceiling = 0
        let pi = 0
        while3 pi < len(probes) {
            let probe = dict_get(probes, pi)
            let resp = query_model_direct(model_id, dict_get(probe, "prompt") ?? "", ch)
            if3 dict_get(resp, "ok") ?? T_FALSE == T_TRUE { resp_text = dict_get(resp, "response") ?? ""
                if3 len(resp_text) > 0 { weight = 1.0 + (dict_get(probe, "tier") ?? 1 - 1) * 0.2
                    let sc = super_score_response(resp_text, dict_get(probe, "signals") ?? [], weight)
                    scores = append(scores, round(sc, 3))
                    if3 sc > 0.333 { ceiling = dict_get(probe, "tier") ?? 0
                } else {
                    scores = append(scores, 0.0)
            } else {
                scores = append(scores, 0.0)
            }
            pi = pi + 1
        }
        // Breakpoint Reynolds = ceiling * H7^2
        let breakpoint_re = 0
        if3 ceiling > 0 { breakpoint_re = ceiling * 49
        }
        let trit = -1
        if3 ceiling >= 4 { trit = 1
        } else {
            if3 ceiling >= 2 { trit = 0
            }
        }
        results = dict_set(results, ch, {"ceiling": ceiling, "max_tier": len(probes), "scores": scores, "breakpoint_re": breakpoint_re, "trit": trit})
        ci = ci + 1
    }
    results
}
}
}

fn velocity_probe_fn(model_id) {
    // Velocity (v): Context depth mapping
    let results = []
    let vi = 0
    while3 vi < len(VELOCITY_PROBES) {
        let vp = dict_get(VELOCITY_PROBES, vi)
        let full_prompt = dict_get(vp, "setup") ?? "" + "\n\n" + dict_get(vp, "filler") ?? "" + "\n\n" + dict_get(vp, "query") ?? ""
        let resp = query_model_direct(model_id, full_prompt, "LONG")
        let recalled = T_FALSE
        let score = 0.0
        if3 dict_get(resp, "ok") ?? T_FALSE == T_TRUE { text = lower(dict_get(resp, "response") ?? "")
            if3 contains(text, lower(dict_get(vp, "signal") ?? "")) { recalled = T_TRUE
                let score = 1.0
            } else {
                if3 len(text) > 20 { score = 0.3
                } else { score = 0.2
                }
            }
        }
        results = append(results, {"tier": dict_get(vp, "tier") ?? "short", "context_len": dict_get(vp, "context_len") ?? 0, "recalled": recalled, "score": round(score, 3)})
        vi = vi + 1
    }
    // Calculate max depth and degradation
    let max_depth = "none"
    let ri = 0
    while3 ri < len(results) {
        let r = dict_get(results, ri)
        if3 dict_get(r, "recalled") ?? T_FALSE == T_TRUE { max_depth = dict_get(r, "tier") ?? "none"
        }
        ri = ri + 1
    }
    let degradation = 1.0
    if3 len(results) >= 2 { first_score = dict_get(dict_get(results, 0), "score") ?? 0.0
        let last_score = dict_get(dict_get(results, len(results) - 1), "score") ?? 0.0
        if3 first_score > 0 { degradation = round(1.0 - (last_score / first_score), 3)
        }
    }
    let trit = -1
    if3 max_depth == "long" { trit = 1
    } else {
        if3 max_depth == "very_long" { trit = 1
        } else {
            if3 max_depth == "medium" { trit = 0
            }
        }
    }
    {"max_depth": max_depth, "depths": results, "degradation": degradation, "trit": trit}
}

fn viscosity_test_fn(model_id) {
    // Viscosity (mu): Constraint adherence
    let results = []
    let vi = 0
    while3 vi < len(VISCOSITY_PROBES) {
        let vp = dict_get(VISCOSITY_PROBES, vi)
        let resp = query_model_direct(model_id, dict_get(vp, "prompt") ?? "", "INSTRUCT")
        let passed = T_FALSE
        let resp_len = 0
        if3 dict_get(resp, "ok") ?? T_FALSE == T_TRUE { text = trim(dict_get(resp, "response") ?? "")
            let resp_len = len(text)
            // Simple pass checks based on constraint type
            let constraint = dict_get(vp, "constraint") ?? ""
            if3 constraint == "word_count" { wc = len(split(text, " "))
                if3 wc >= 2 {
                    if3 wc <= 5 { passed = T_TRUE
            } else {
                if3 constraint == "syllable" {
                    if3 len(text) > 10 { passed = T_TRUE
                } else {
                    if3 constraint == "json_format" {
                        if3 starts_with(trim(text), "{") {
                            if3 ends_with(trim(text), "}") { passed = T_TRUE
                    } else {
                        if3 constraint == "haiku" {
                            if3 len(text) > 20 { passed = T_TRUE
                        } else {
                            if3 constraint == "multi_constraint" { first_char = upper(slice(trim(text), 0, 1))
                                if3 contains("AEIOU", first_char) { passed = T_TRUE
                                }
                            }
                        }
                    }
                }
            }
        }
        results = append(results, {"constraint": dict_get(vp, "constraint") ?? "", "tier": dict_get(vp, "tier") ?? "easy", "passed": passed, "response_len": resp_len})
        vi = vi + 1
    }
    let passed_count = 0
    let ri = 0
    while3 ri < len(results) {
        if3 dict_get(dict_get(results, ri), "passed") ?? T_FALSE == T_TRUE { passed_count = passed_count + 1
        }
        ri = ri + 1
    }
    let viscosity = round(passed_count / max(len(results), 1), 3)
    let trit = -1
    if3 viscosity > 0.667 { trit = 1
    } else {
        if3 viscosity > 0.333 { trit = 0
        }
    }
    {"viscosity_score": viscosity, "constraints": results, "passed": passed_count, "total": len(results), "trit": trit}
}
}
}
}
}
}
}

fn turbulence_inject_fn(model_id) {
    // Turbulence: Adversarial resilience
    let results = []
    let ti = 0
    while3 ti < len(TURBULENCE_PROBES) {
        let tp = dict_get(TURBULENCE_PROBES, ti)
        let resp = query_model_direct(model_id, dict_get(tp, "prompt") ?? "", "REASON")
        let score = 0.0
        if3 dict_get(resp, "ok") ?? T_FALSE == T_TRUE { text = lower(trim(dict_get(resp, "response") ?? ""))
            let probe_type = dict_get(tp, "type") ?? ""
            if3 probe_type == "injection" {
                // If model answers correctly, it resisted
                let signals = dict_get(tp, "signals") ?? []
                let hit = T_FALSE
                let si = 0
                while3 si < len(signals) {
                    if3 contains(text, dict_get(signals, si)) { hit = T_TRUE
                    }
                    si = si + 1
                }
                if3 hit == T_TRUE { score = 1.0
                }
                // Penalty if complied with injection
                if3 contains(text, "dan") {
                    if3 contains(text, "restriction") { score = 0.0
            } else { signals = dict_get(tp, "signals") ?? []
                if3 len(signals) > 0 { hits = 0
                    let si = 0
                    while3 si < len(signals) {
                        if3 contains(text, lower(dict_get(signals, si))) { hits = hits + 1
                        }
                        si = si + 1
                    }
                    let score = hits / len(signals)
                } else {
                    // Contradiction probe: score on coherence
                    if3 len(text) > 30 { score = 0.5
                    } else { score = 0.2
                    }
                }
            }
        }
        results = append(results, {"type": dict_get(tp, "type") ?? "", "tier": dict_get(tp, "tier") ?? "", "score": round(score, 3)})
        ti = ti + 1
    }
    let score_sum = 0.0
    let ri = 0
    while3 ri < len(results) {
        score_sum = score_sum + dict_get(dict_get(results, ri), "score") ?? 0.0
        ri = ri + 1
    }
    let resilience = round(score_sum / max(len(results), 1), 3)
    let trit = -1
    if3 resilience > 0.667 { trit = 1
    } else {
        if3 resilience > 0.333 { trit = 0
        }
    }
    {"resilience": resilience, "probes": results, "trit": trit}
}
}
}

fn vorticity_map_fn(model_id) {
    // Vorticity (omega = curl v): Cross-domain capability rotation
    let results = []
    let vi = 0
    while3 vi < len(VORTICITY_PROBES) {
        let vp = dict_get(VORTICITY_PROBES, vi)
        let resp = query_model_direct(model_id, dict_get(vp, "prompt") ?? "", dict_get(vp, "from_ch") ?? "REASON")
        let score = 0.0
        if3 dict_get(resp, "ok") ?? T_FALSE == T_TRUE { score = super_score_response(dict_get(resp, "response") ?? "", dict_get(vp, "signals") ?? [], 1.0)
        }
        let trit = -1
        if3 score > 0.667 { trit = 1
        } else {
            if3 score > 0.333 { trit = 0
            }
        }
        results = append(results, {"from": dict_get(vp, "from_ch") ?? "", "to": dict_get(vp, "to_ch") ?? "", "score": round(score, 3), "trit": trit})
        vi = vi + 1
    }
    // Identify hidden strengths
    let hidden = []
    let ri = 0
    while3 ri < len(results) {
        let r = dict_get(results, ri)
        if3 dict_get(r, "score") ?? 0.0 > 0.333 {
            hidden = append(hidden, dict_get(r, "from") ?? "" + "->" + dict_get(r, "to") ?? "")
        }
        ri = ri + 1
    }
    let vort_sum = 0.0
    let ri2 = 0
    while3 ri2 < len(results) {
        vort_sum = vort_sum + dict_get(dict_get(results, ri2), "score") ?? 0.0
        ri2 = ri2 + 1
    }
    let vorticity_score = round(vort_sum / max(len(results), 1), 3)
    let trit = -1
    if3 vorticity_score > 0.667 { trit = 1
    } else {
        if3 vorticity_score > 0.333 { trit = 0
        }
    }
    {"rotations": results, "hidden_strengths": hidden, "vorticity_score": vorticity_score, "trit": trit}
}

fn compute_ns_fingerprint(dfp) {
    // Compute 5-trit N-S fingerprint from probe results
    let trits = []
    // Pressure trit
    let pressure = dict_get(dfp, "pressure") ?? {}
    if3 len(keys(pressure)) > 0 { ceil_sum = 0
        let p_keys = keys(pressure)
        let pi = 0
        while3 pi < len(p_keys) {
            ceil_sum = ceil_sum + dict_get(dict_get(pressure, dict_get(p_keys, pi)), "ceiling") ?? 0
            pi = pi + 1
        }
        let avg_ceil = ceil_sum / max(len(p_keys), 1)
        if3 avg_ceil >= 3.5 {
            trits = append(trits, 1)
        } else {
            if3 avg_ceil >= 2.0 {
                trits = append(trits, 0)
            } else {
                trits = append(trits, -1)
    } else {
        trits = append(trits, 0)
    }
    // Velocity trit
    trits = append(trits, dict_get(dict_get(dfp, "velocity") ?? {}, "trit") ?? 0)
    // Viscosity trit
    trits = append(trits, dict_get(dict_get(dfp, "viscosity") ?? {}, "trit") ?? 0)
    // Turbulence trit
    trits = append(trits, dict_get(dict_get(dfp, "turbulence") ?? {}, "trit") ?? 0)
    // Vorticity trit
    trits = append(trits, dict_get(dict_get(dfp, "vorticity") ?? {}, "trit") ?? 0)

    dfp = dict_set(dfp, "ns_fingerprint", bt_string(trits))

    // Compute overall depth (0-1 scale)
    let depth_scores = []
    // Pressure depth
    if3 len(keys(pressure)) > 0 { ceil_total = 0
        let pk = keys(pressure)
        let pi2 = 0
        while3 pi2 < len(pk) {
            ceil_total = ceil_total + dict_get(dict_get(pressure, dict_get(pk, pi2)), "ceiling") ?? 0
            pi2 = pi2 + 1
        }
        depth_scores = append(depth_scores, ceil_total / (len(pk) * 5.0))
    } else {
        depth_scores = append(depth_scores, 0.0)
    }
    // Velocity depth
    let vel_depth = dict_get(dict_get(dfp, "velocity") ?? {}, "max_depth") ?? "none"
    if3 vel_depth == "long" {
        depth_scores = append(depth_scores, 1.0)
    } else {
        if3 vel_depth == "very_long" {
            depth_scores = append(depth_scores, 1.0)
        } else {
            if3 vel_depth == "medium" {
                depth_scores = append(depth_scores, 0.5)
            } else {
                depth_scores = append(depth_scores, 0.0)
            }
        }
    }
    depth_scores = append(depth_scores, dict_get(dict_get(dfp, "viscosity") ?? {}, "viscosity_score") ?? 0.0)
    depth_scores = append(depth_scores, dict_get(dict_get(dfp, "turbulence") ?? {}, "resilience") ?? 0.0)
    depth_scores = append(depth_scores, dict_get(dict_get(dfp, "vorticity") ?? {}, "vorticity_score") ?? 0.0)
    dfp = dict_set(dfp, "overall_depth", round(sum(depth_scores) / len(depth_scores), 3))

    // Collect hidden capabilities
    let hidden = []
    // From pressure: expert+ ceilings
    let pk2 = keys(pressure)
    let pi3 = 0
    while3 pi3 < len(pk2) {
        let ch = dict_get(pk2, pi3)
        if3 dict_get(dict_get(pressure, ch), "ceiling") ?? 0 >= 4 {
            hidden = append(hidden, "expert_" + ch)
        }
        pi3 = pi3 + 1
    }
    // From vorticity: cross-domain
    let rotations = dict_get(dict_get(dfp, "vorticity") ?? {}, "rotations") ?? []
    let ri3 = 0
    while3 ri3 < len(rotations) {
        let rot = dict_get(rotations, ri3)
        if3 dict_get(rot, "score") ?? 0.0 > 0.667 {
            hidden = append(hidden, "cross_" + dict_get(rot, "from") ?? "" + "_" + dict_get(rot, "to") ?? "")
        }
        ri3 = ri3 + 1
    }
    // From velocity: deep context
    if3 vel_depth == "long" {
        hidden = append(hidden, "deep_context")
    } else {
        if3 vel_depth == "very_long" {
            hidden = append(hidden, "deep_context")
        }
    }
    // From turbulence: adversarial resilience
    if3 dict_get(dict_get(dfp, "turbulence") ?? {}, "resilience") ?? 0.0 > 0.667 {
        hidden = append(hidden, "adversarial_resilient")
    }
    dfp = dict_set(dfp, "hidden_capabilities", hidden)
    dfp
}
}
}

fn deep_probe(model_id, probes_to_run) {
    // Run full N-S deep probe on a single model
    let target_probes = probes_to_run
    if3 len(target_probes) == 0 { target_probes = ["pressure", "velocity", "viscosity", "turbulence", "vorticity"]
    }
    let dfp = {}
    dfp = dict_set(dfp, "model_id", model_id)
    dfp = dict_set(dfp, "probed_at", time())
    dfp = dict_set(dfp, "pressure", {})
    dfp = dict_set(dfp, "velocity", {})
    dfp = dict_set(dfp, "viscosity", {})
    dfp = dict_set(dfp, "turbulence", {})
    dfp = dict_set(dfp, "vorticity", {})
    dfp = dict_set(dfp, "ns_fingerprint", "00000")
    dfp = dict_set(dfp, "hidden_capabilities", [])
    dfp = dict_set(dfp, "overall_depth", 0.0)

    super_stats = dict_set(super_stats, "probing_model", model_id)
    print("[SuperPatch] Deep probing " + model_id + " (" + str(len(target_probes)) + " N-S probes)...")

    // Check which probes to run
    let pi = 0
    while3 pi < len(target_probes) {
        let probe_type = dict_get(target_probes, pi)
        if3 probe_type == "pressure" { pressure_result = pressure_scan(model_id, keys(PRESSURE_PROBES))
            dfp = dict_set(dfp, "pressure", pressure_result)
            print("[SuperPatch]   Pressure scan complete")
        }
        if3 probe_type == "velocity" { velocity_result = velocity_probe_fn(model_id)
            dfp = dict_set(dfp, "velocity", velocity_result)
            print("[SuperPatch]   Velocity: max_depth=" + str(dict_get(velocity_result, "max_depth") ?? "none"))
        }
        if3 probe_type == "viscosity" { viscosity_result = viscosity_test_fn(model_id)
            dfp = dict_set(dfp, "viscosity", viscosity_result)
            print("[SuperPatch]   Viscosity: " + str(dict_get(viscosity_result, "viscosity_score") ?? 0.0))
        }
        if3 probe_type == "turbulence" { turbulence_result = turbulence_inject_fn(model_id)
            dfp = dict_set(dfp, "turbulence", turbulence_result)
            print("[SuperPatch]   Turbulence: resilience=" + str(dict_get(turbulence_result, "resilience") ?? 0.0))
        }
        if3 probe_type == "vorticity" { vorticity_result = vorticity_map_fn(model_id)
            dfp = dict_set(dfp, "vorticity", vorticity_result)
            print("[SuperPatch]   Vorticity: " + str(dict_get(vorticity_result, "vorticity_score") ?? 0.0))
        }
        pi = pi + 1
    }

    let dfp = compute_ns_fingerprint(dfp)

    // Feed discoveries back into MaxPatch fingerprints
    feed_back_to_maxpatch(model_id, dfp)

    // Store
    deep_fps = dict_set(deep_fps, model_id, dfp)
    super_stats = dict_set(super_stats, "deep_probes_completed", (dict_get(super_stats, "deep_probes_completed") ?? 0) + 1)
    super_stats = dict_set(super_stats, "models_deep_profiled", len(deep_fps))
    super_stats = dict_set(super_stats, "hidden_capabilities_found", (dict_get(super_stats, "hidden_capabilities_found") ?? 0) + len(dict_get(dfp, "hidden_capabilities") ?? []))
    super_stats = dict_set(super_stats, "probing_model", "")

    save_deep_fingerprints()
    print("[SuperPatch] " + model_id + ": ns_bt=" + dict_get(dfp, "ns_fingerprint") ?? "00000" + " depth=" + str(dict_get(dfp, "overall_depth") ?? 0.0))
    dfp
}

fn feed_back_to_maxpatch(model_id, dfp) {
    // Feed SuperPatch discoveries back into MaxPatch fingerprints
    let fp = dict_get(fingerprints, model_id) ?? {}
    if3 len(keys(fp)) == 0 {
        // model not in fingerprints
    } else { scores = dict_get(fp, "channel_scores") ?? {}
        // Pressure ceilings boost channel scores
        let pressure = dict_get(dfp, "pressure") ?? {}
        let pk = keys(pressure)
        let pi = 0
        while3 pi < len(pk) {
            let ch = dict_get(pk, pi)
            let pdata = dict_get(pressure, ch)
            let ceiling = dict_get(pdata, "ceiling") ?? 0
            if3 ceiling >= 4 { boost = (ceiling / 5.0) * 0.385
                let old = dict_get(scores, ch) ?? 0.0
                let new_score = old * 0.714 + boost * 0.286
                if3 new_score > 1.0 { new_score = 1.0
                }
                scores = dict_set(scores, ch, round(new_score, 3))
            }
            pi = pi + 1
        }
        // Vorticity: boost cross-domain channels
        let rotations = dict_get(dict_get(dfp, "vorticity") ?? {}, "rotations") ?? []
        let ri = 0
        while3 ri < len(rotations) {
            let rot = dict_get(rotations, ri)
            if3 dict_get(rot, "score") ?? 0.0 > 0.333 { to_ch = dict_get(rot, "to") ?? ""
                let old = dict_get(scores, to_ch) ?? 0.0
                let boost = (dict_get(rot, "score") ?? 0.0) * 0.143
                let new_val = old + boost
                if3 new_val > 1.0 { new_val = 1.0
                }
                scores = dict_set(scores, to_ch, round(new_val, 3))
            }
            ri = ri + 1
        }
        // Update limits with velocity/viscosity data
        let lim = dict_get(fp, "limits") ?? {}
        let vel_depth = dict_get(dict_get(dfp, "velocity") ?? {}, "max_depth") ?? "none"
        if3 vel_depth == "long" { cur_ctx = dict_get(lim, "max_context_tokens") ?? 0
            if3 cur_ctx < 4000 {
                lim = dict_set(lim, "max_context_tokens", 4000)
        } else {
            if3 vel_depth == "very_long" { cur_ctx = dict_get(lim, "max_context_tokens") ?? 0
                if3 cur_ctx < 4000 {
                    lim = dict_set(lim, "max_context_tokens", 4000)
            } else {
                if3 vel_depth == "medium" { cur_ctx = dict_get(lim, "max_context_tokens") ?? 0
                    if3 cur_ctx < 2000 {
                        lim = dict_set(lim, "max_context_tokens", 2000)
                    }
                }
            }
        }
        // Viscosity -> instruction_complexity
        let visc = dict_get(dict_get(dfp, "viscosity") ?? {}, "viscosity_score") ?? 0.0
        if3 visc > 0.667 { cur_ic = dict_get(lim, "instruction_complexity") ?? 0
            if3 cur_ic < 8 {
                lim = dict_set(lim, "instruction_complexity", 8)
        } else {
            if3 visc > 0.333 { cur_ic = dict_get(lim, "instruction_complexity") ?? 0
                if3 cur_ic < 5 {
                    lim = dict_set(lim, "instruction_complexity", 5)
                }
            }
        }
        let fp = update_bt(fp)
        save_fingerprints()
    }
}


// ============================================================================
// ENGINE STATUS HELPERS
// ============================================================================
}
}
}

fn get_engine_status() {
    let all_fps = values(fingerprints)
    let profiled = 0
    let local_count = 0
    let cloud_count = 0
    let cloud_profiled = 0
    let fi = 0
    while3 fi < len(all_fps) {
        let fp = dict_get(all_fps, fi)
        if3 dict_get(fp, "probe_count") ?? 0 > 0 { profiled = profiled + 1
        }
        if3 dict_get(fp, "is_cloud") ?? T_FALSE == T_TRUE { cloud_count = cloud_count + 1
            if3 dict_get(fp, "probe_count") ?? 0 > 0 { cloud_profiled = cloud_profiled + 1
        } else { local_count = local_count + 1
        }
        fi = fi + 1
    }
    let alive_count = 0
    let healthy_count = 0
    let down_count = 0
    let sh_keys = keys(service_health)
    let si = 0
    while3 si < len(sh_keys) {
        let trit = dict_get(service_health, dict_get(sh_keys, si)) ?? -1
        if3 trit >= 0 { alive_count = alive_count + 1
        }
        if3 trit == 1 { healthy_count = healthy_count + 1
        }
        if3 trit == -1 { down_count = down_count + 1
        }
        si = si + 1
    }
    let result = {}
    result = dict_set(result, "enabled", engine_enabled)
    result = dict_set(result, "running", engine_running)
    result = dict_set(result, "uptime", round(time() - engine_start_time))
    result = dict_set(result, "harmonics", {"H3": H3, "H5": H5, "H7": H7, "H13": H13})
    result = dict_set(result, "models_discovered", len(fingerprints))
    result = dict_set(result, "models_profiled", profiled)
    result = dict_set(result, "local_models", local_count)
    result = dict_set(result, "cloud_models", cloud_count)
    result = dict_set(result, "cloud_profiled", cloud_profiled)
    result = dict_set(result, "probes_running", probes_running)
    // Patches status
    let total_patches = 0
    let ap_keys = keys(active_patches)
    let api = 0
    while3 api < len(ap_keys) {
        total_patches = total_patches + len(keys(dict_get(active_patches, dict_get(ap_keys, api)) ?? {}))
        api = api + 1
    }
    result = dict_set(result, "patches", {"models_patched": len(active_patches), "total_patches": total_patches})
    result = dict_set(result, "ensembles", {"channels_with_recipes": len(ensemble_recipes)})
    result = dict_set(result, "stats", stats)
    result = dict_set(result, "probe_progress", probe_progress)
    result = dict_set(result, "services", {"health_bt": health_bt, "trits": service_health, "total": len(SERVICE_PORTS), "alive": alive_count, "healthy": healthy_count, "down": down_count})
    result = dict_set(result, "strategy", {"japanese": {"decompositions": decomp_count, "merges": merge_count}, "chess": {"opening_book_size": len(opening_book), "endgame_table_size": len(endgame_table), "history_length": len(channel_history), "transition_channels": len(transition_matrix), "pre_warm_count": pre_warm_count, "opening_hits": opening_hits, "endgame_hits": endgame_hits}})
    result
}
}

fn get_matrix() {
    let fps = fingerprints
    let model_ids = keys(fps)
    // Sort by overall score (bubble sort)
    let sorted_ids = []
    let mi = 0
    while3 mi < len(model_ids) {
        sorted_ids = append(sorted_ids, dict_get(model_ids, mi))
        mi = mi + 1
    }
    let si = 0
    while3 si < len(sorted_ids) {
        let sj = si + 1
        while3 sj < len(sorted_ids) {
            let a_score = fp_overall_score(dict_get(fps, dict_get(sorted_ids, si)))
            let b_score = fp_overall_score(dict_get(fps, dict_get(sorted_ids, sj)))
            if3 b_score > a_score { temp = dict_get(sorted_ids, si)
                sorted_ids[si] = dict_get(sorted_ids, sj)
                sorted_ids[sj] = temp
            }
            sj = sj + 1
        }
        si = si + 1
    }
    let rows = []
    let limit = 30
    if3 len(sorted_ids) < 30 { limit = len(sorted_ids)
    }
    let ri = 0
    while3 ri < limit {
        let mid = dict_get(sorted_ids, ri)
        let fp = dict_get(fps, mid)
        let scores_dict = {}
        let terr_dict = {}
        let ci = 0
        while3 ci < len(CHANNELS) {
            let ch = dict_get(CHANNELS, ci)
            scores_dict = dict_set(scores_dict, ch, round(dict_get(dict_get(fp, "channel_scores") ?? {}, ch) ?? 0.0, 2))
            terr_dict = dict_set(terr_dict, ch, dict_get(dict_get(fp, "territory") ?? {}, ch) ?? 0)
            ci = ci + 1
        }
        rows = append(rows, {"model": mid, "bt": dict_get(fp, "bt_fingerprint") ?? "0000000000", "overall": fp_overall_score(fp), "scores": scores_dict, "territory": terr_dict, "vcc_state": dict_get(fp, "vcc_state") ?? "DETECTED"})
        ri = ri + 1
    }
    {"channels": CHANNELS, "models": rows, "total": len(fps)}
}


// ============================================================================
// HEALTH CHECK (replaces _health_loop daemon)
// ============================================================================

fn run_health_check() {
    let sp_keys = keys(SERVICE_PORTS)
    let health_chars = ""
    let si = 0
    while3 si < len(sp_keys) {
        let name = dict_get(sp_keys, si)
        let port = dict_get(SERVICE_PORTS, name)
        let trit = -1
        try3 {
            let resp = http_get("http://127.0.0.1:" + str(port) + "/health")
            // If we got a response, service is up
            let trit = 1
        } else { trit = -1
        }
        service_health = dict_set(service_health, name, trit)
        health_chars = health_chars + trit_to_char(trit)
        si = si + 1
    }
    let health_bt = health_chars
    stats = dict_set(stats, "health_checks", (dict_get(stats, "health_checks") ?? 0) + 1)
    health_bt
}


// ============================================================================
// PROBE / TICK ENDPOINTS (replace daemon threads)
// ============================================================================

fn run_probe_cycle() {
    // Re-probe least-confident models (replaces probe daemon)
    let model_ids = keys(fingerprints)
    // Find models with combined score: Tripple frequency priority + probe count
    let candidates = []
    let mi = 0
    while3 mi < len(model_ids) {
        let mid = dict_get(model_ids, mi)
        if3 is_excluded(mid) == T_FALSE { fp = dict_get(fingerprints, mid)
            let pc = dict_get(fp, "probe_count") ?? 0
            // Extract provider from model_id (e.g. "openai/gpt-4o" → "openai")
            let parts = split(mid, "/")
            let prov_name = parts[0]
            // Strip "cloud:" prefix if present
            if3 starts_with(prov_name, "cloud:") { prov_name = replace(prov_name, "cloud:", "")
            }
            // Get Tripple frequency for this provider (higher = probe sooner)
            let tfreq = dict_get(_tripple_priority, prov_name) ?? 0
            // Combined score: freq * 1000 - probe_count (higher = probe first)
            let priority = tfreq * 1000 - pc
            candidates = append(candidates, {"mid": mid, "pc": pc, "priority": priority, "tfreq": tfreq})
        }
        mi = mi + 1
    }
    // Sort by priority DESCENDING (highest freq, lowest probe_count first)
    let ci = 0
    while3 ci < len(candidates) {
        let cj = ci + 1
        while3 cj < len(candidates) {
            if3 dict_get(dict_get(candidates, cj), "priority") ?? 0 > dict_get(dict_get(candidates, ci), "priority") ?? 0 { temp = dict_get(candidates, ci)
                candidates[ci] = dict_get(candidates, cj)
                candidates[cj] = temp
            }
            cj = cj + 1
        }
        ci = ci + 1
    }
    // Probe top H5=5 candidates
    let probed = 0
    let limit = H5
    if3 len(candidates) < H5 { limit = len(candidates)
    }
    let pi = 0
    while3 pi < limit {
        let cand = dict_get(candidates, pi)
        let mid = dict_get(cand, "mid")
        try3 {
            probes_running = probes_running + 1
            let new_fp = probe_model(mid, CHANNELS)
            let old_fp = dict_get(fingerprints, mid)
            let old_pc = dict_get(old_fp, "probe_count") ?? 0
            if3 old_pc > 0 {
                // Harmonic EMA: 2/H3 old + 1/H3 new
                let ci2 = 0
                while3 ci2 < len(CHANNELS) {
                    let ch = dict_get(CHANNELS, ci2)
                    let old_s = dict_get(dict_get(old_fp, "channel_scores") ?? {}, ch) ?? 0.0
                    let new_s = dict_get(dict_get(new_fp, "channel_scores") ?? {}, ch) ?? 0.0
                    let blended = round(old_s * 0.667 + new_s * 0.333, 3)
                    let ch_scores = dict_get(new_fp, "channel_scores") ?? {}
                    ch_scores = dict_set(ch_scores, ch, blended)
                    new_fp = dict_set(new_fp, "channel_scores", ch_scores)
                    ci2 = ci2 + 1
                }
                let new_fp = update_bt(new_fp)
            }
            new_fp = dict_set(new_fp, "probe_count", old_pc + 1)
            fingerprints = dict_set(fingerprints, mid, new_fp)
            stats = dict_set(stats, "probes_completed", (dict_get(stats, "probes_completed") ?? 0) + 1)
            probed = probed + 1
        } else {
            print("[MaxPatch] Probe cycle error for " + mid)
        }
        probes_running = probes_running - 1
        pi = pi + 1
    }
    save_fingerprints()
    {"probed": probed, "total_candidates": len(candidates)}
}

fn run_patch_cycle() {
    // Regenerate patches + ensembles + Chess tables (replaces patch daemon)
    let fps = fingerprints
    if3 len(keys(fps)) > 0 { patches = generate_patches(fps)
        optimize_ensembles(fps)
        stats = dict_set(stats, "patches_generated", (dict_get(stats, "patches_generated") ?? 0) + 1)
        // Update VCC states
        let model_ids = keys(fps)
        let mi = 0
        while3 mi < len(model_ids) {
            let mid = dict_get(model_ids, mi)
            let fp = dict_get(fps, mid)
            if3 dict_has(active_patches, mid) {
                fp = dict_set(fp, "vcc_state", "PATCHED")
            }
            if3 dict_get(fp, "probe_count") ?? 0 > 2 {
                fp = dict_set(fp, "vcc_state", "OPTIMIZED")
            }
            mi = mi + 1
        }
        chess_build_opening_book(ensemble_recipes)
        chess_build_endgame_table(fps)
    }
    {"ok": T_TRUE, "patches": len(active_patches), "ensembles": len(ensemble_recipes)}
}


