fn handle_patch_seal(req) {
    let body = dict_get(req, "body") ?? {}
    let evt = {"ts": time(), "provider": dict_get(body, "provider") ?? "unknown", "model": dict_get(body, "model") ?? "", "reason": dict_get(body, "reason") ?? "", "event": dict_get(body, "event") ?? "seal", "source": dict_get(body, "source") ?? "cloud_router"}
    seal_events = append(seal_events, evt)
    // Notify orchestrator
    try3 {
        let payload = json_encode({"event": "SEAL", "source": "max_patch", "data": evt})
        http_post("http://127.0.0.1:9999/api/debug/event", payload)
    } else {
        // orchestrator might be down
    }
    return {"ok": T_TRUE, "seal_events": len(seal_events)}
}

