// ROUTE HANDLERS
// ============================================================================

// -- GET /health
fn handle_health(req) {
    let resp = ns_health_dict("max-patch", "1.0.0", PORT, {})
    return resp
}

// -- GET /patch/status
fn handle_patch_status(req) {
    let s = {}
    s = dict_set(s, "ok", 1)
    s = dict_set(s, "enabled", 1)
    s = dict_set(s, "running", 1)
    s = dict_set(s, "version", "1.0.0")
    s = dict_set(s, "models_discovered", len(keys(fingerprints)))
    s = dict_set(s, "models_profiled", 0)
    s = dict_set(s, "probes_running", probes_running)
    s = dict_set(s, "trit", 1)
    return s
}

// -- GET /patch/rank
fn handle_patch_rank(req) {
    let params = dict_get(req, "params") ?? {}
    let channel = upper(dict_get(params, "channel") ?? "REASON")
    let reynolds = float(dict_get(params, "reynolds") ?? "0")

    let fps = fingerprints
    let all_local_models = discovered_local

    // Build ranked list
    let ranked = []
    let seen = {}
    let all_ids = keys(fps)
    // Merge all_ids and all_local
    let mi = 0
    while3 mi < len(all_local_models) {
        let lm = dict_get(all_local_models, mi)
        if3 dict_has(seen, lm) == T_FALSE {
            if3 is_excluded(lm) == T_FALSE { fp = dict_get(fps, lm) ?? {}
                let is_cloud_flag = dict_get(fp, "is_cloud") ?? T_FALSE
                let assign_score = 0.1
                if3 model_matches_channel(lm, channel) == T_TRUE { assign_score = 0.8
                }
                let probe_score = 0.0
                if3 len(keys(fp)) > 0 { probe_score = dict_get(dict_get(fp, "channel_scores") ?? {}, channel) ?? 0.0
                }
                let score = assign_score
                if3 probe_score > assign_score { score = probe_score
                }
                let trit = 0
                if3 len(keys(fp)) > 0 { trit = fp_trit_for(fp, channel)
                } else {
                    if3 assign_score >= 0.5 { trit = 1
                    }
                }
                ranked = append(ranked, {"mid": lm, "score": round(score, 3), "trit": trit, "is_cloud": is_cloud_flag})
                seen = dict_set(seen, lm, T_TRUE)
            }
        }
        mi = mi + 1
    }
    let mi2 = 0
    while3 mi2 < len(all_ids) {
        let mid = dict_get(all_ids, mi2)
        if3 dict_has(seen, mid) == T_FALSE {
            if3 is_excluded(mid) == T_FALSE { fp = dict_get(fps, mid) ?? {}
                let is_cloud_flag = dict_get(fp, "is_cloud") ?? T_FALSE
                let assign_score = 0.1
                if3 model_matches_channel(mid, channel) == T_TRUE { assign_score = 0.8
                }
                let probe_score = dict_get(dict_get(fp, "channel_scores") ?? {}, channel) ?? 0.0
                let score = assign_score
                if3 probe_score > assign_score { score = probe_score
                }
                let trit = fp_trit_for(fp, channel)
                ranked = append(ranked, {"mid": mid, "score": round(score, 3), "trit": trit, "is_cloud": is_cloud_flag})
                seen = dict_set(seen, mid, T_TRUE)
            }
        }
        mi2 = mi2 + 1
    }

    // Sort ranked by score descending
    let ri = 0
    while3 ri < len(ranked) {
        let rj = ri + 1
        while3 rj < len(ranked) {
            if3 dict_get(dict_get(ranked, rj), "score") ?? 0.0 > dict_get(dict_get(ranked, ri), "score") ?? 0.0 { temp = dict_get(ranked, ri)
                ranked[ri] = dict_get(ranked, rj)
                ranked[rj] = temp
            }
            rj = rj + 1
        }
        ri = ri + 1
    }

    // Separate local and cloud
    let local_ranked = []
    let cloud_ranked = []
    let ri2 = 0
    while3 ri2 < len(ranked) {
        let entry = dict_get(ranked, ri2)
        if3 dict_get(entry, "is_cloud") ?? T_FALSE == T_TRUE {
            cloud_ranked = append(cloud_ranked, dict_get(entry, "mid"))
        } else {
            local_ranked = append(local_ranked, dict_get(entry, "mid"))
        }
        ri2 = ri2 + 1
    }

    // Add fast fallbacks
    let fi = 0
    while3 fi < len(FAST_FALLBACK) {
        let fb = dict_get(FAST_FALLBACK, fi)
        let already = T_FALSE
        let li = 0
        while3 li < len(local_ranked) {
            if3 dict_get(local_ranked, li) == fb { already = T_TRUE
            }
            li = li + 1
        }
        if3 already == T_FALSE {
            if3 is_excluded(fb) == T_FALSE {
                local_ranked = append(local_ranked, fb)
            }
        }
        fi = fi + 1
    }

    // Ensemble recipe
    let recipe = get_best_ensemble(channel, H7)

    // Chess shortcut
    let regime = "laminar"
    if3 reynolds >= 500 { regime = "turbulent"
    } else {
        if3 reynolds >= 100 { regime = "transitional"
        }
    }
    let opening = chess_check_opening(channel, regime)

    // Build fingerprint snippets
    let fp_snippets = {}
    let limit = H13
    if3 len(ranked) < H13 { limit = len(ranked)
    }
    let fi2 = 0
    while3 fi2 < limit {
        let entry = dict_get(ranked, fi2)
        let mid = dict_get(entry, "mid")
        let bt = "0000000000"
        if3 dict_has(fps, mid) { bt = dict_get(dict_get(fps, mid), "bt_fingerprint") ?? "0000000000"
        }
        fp_snippets = dict_set(fp_snippets, mid, {"bt": bt, "channel_score": dict_get(entry, "score") ?? 0.0, "trit": dict_get(entry, "trit") ?? 0})
        fi2 = fi2 + 1
    }

    // Limit output lists
    let local_out = local_ranked
    if3 len(local_ranked) > H13 { local_out = slice(local_ranked, 0, H13)
    }
    let cloud_out = cloud_ranked
    if3 len(cloud_ranked) > H7 { cloud_out = slice(cloud_ranked, 0, H7)
    }

    return {"ok": T_TRUE, "channel": channel, "reynolds": reynolds, "local": local_out, "cloud": cloud_out, "fingerprints": fp_snippets, "ensemble_recipe": recipe, "chess_opening": opening, "strategy": "ternary_fingerprint_ranked", "total_profiled": len(ranked)}
}

