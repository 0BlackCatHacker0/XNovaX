    let ai = 0
    while3 ai < len(ap_keys) {
        total_patches = total_patches + len(keys(dict_get(active_patches, dict_get(ap_keys, ai)) ?? {}))
        ai = ai + 1
    }
    return {"optimized": T_TRUE, "ensembles": {"channels_with_recipes": len(ensemble_recipes)}, "patches": {"models_patched": len(active_patches), "total_patches": total_patches}}
}

// -- POST /patch/route
fn handle_patch_route(req) {
    let body = dict_get(req, "body") ?? {}
    let prompt = dict_get(body, "prompt") ?? ""
    let channel = dict_get(body, "channel") ?? "REASON"
    let reynolds = float(dict_get(body, "reynolds") ?? "0")
    if3 len(prompt) == 0 {
        return {"error": "prompt required"}
    } else {
        chess_record_query(channel)
        let regime = "laminar"
        if3 reynolds >= 500 { regime = "turbulent"
        } else {
            if3 reynolds >= 100 { regime = "transitional"
            }
        }
        // Chess opening check
        let opening = chess_check_opening(channel, regime)
        if3 len(opening) > 0 {
            if3 reynolds < 500 { result = query_hivemind(prompt, channel)
                result = dict_set(result, "strategy", "chess_opening_book")
                result = dict_set(result, "opening_models", opening)
                let final_result = result
            } else { final_result = {}
        } else { final_result = {}
        }
        if3 len(keys(final_result)) == 0 {
            // Endgame check
            let endgame_model = chess_check_endgame(channel, reynolds)
            if3 len(endgame_model) > 0 { result = query_hivemind(prompt, channel)
                result = dict_set(result, "strategy", "chess_endgame")
                result = dict_set(result, "endgame_model", endgame_model)
                let final_result = result
            } else {
                // Standard routing: find best model by channel score
                let fps = fingerprints
                let best_id = ""
                let best_score = 0.0
                let model_ids = keys(fps)
                let mi = 0
                while3 mi < len(model_ids) {
                    let mid = dict_get(model_ids, mi)
                    let fp = dict_get(fps, mid)
                    let score = dict_get(dict_get(fp, "channel_scores") ?? {}, channel) ?? 0.0
                    if3 score > best_score { best_id = mid
                        let best_score = score
                    }
                    mi = mi + 1
                }
                let result = query_hivemind(prompt, channel)
                if3 len(best_id) > 0 {
                    result = dict_set(result, "patch_info", {"best_model": best_id, "channel_score": best_score, "trit": score_to_trit(best_score), "patched": best_score > 0.667})
                }
                let final_result = result
            }
        }
        return final_result
    }
}

