// ============================================================================
// TRIPPLE MODULE PROBE PRIORITIZATION
// ============================================================================

// -- POST /api/v1/probe/priority
// Receives priority data from the Tripple Module about which providers
// are in resonance and should be probed first
fn handle_probe_priority(req) {
    let body = dict_get(req, "body") ?? {}
    let provider = dict_get(body, "provider") ?? ""
    let freq = dict_get(body, "freq") ?? 0
    let in_phase = dict_get(body, "in_phase") ?? T_FALSE
    let prime_locked = dict_get(body, "prime_locked") ?? T_FALSE

    if3 len(provider) == 0 {
        return {"error": "provider required", "trit": T_FALSE}
    } else {
        // Store priority -- higher freq = probe sooner
        // bare reassignment (no let) to modify global _tripple_priority
        _tripple_priority = dict_set(_tripple_priority, provider, freq)

        let resp = {}
        resp = dict_set(resp, "ok", T_TRUE)
        resp = dict_set(resp, "trit", T_TRUE)
        resp = dict_set(resp, "provider", provider)
        resp = dict_set(resp, "priority_freq", freq)
        resp = dict_set(resp, "in_phase", in_phase)
        resp = dict_set(resp, "prime_locked", prime_locked)
        return resp
    }
}

// -- GET /api/v1/probe/priority
// Returns current Tripple priority map
fn handle_get_probe_priority(req) {
    let resp = {}
    resp = dict_set(resp, "ok", T_TRUE)
    resp = dict_set(resp, "trit", T_TRUE)
    resp = dict_set(resp, "priorities", _tripple_priority)
    return resp
}


