// ============================================================
// nova_novaxcore_engine.nova — Win32 MicroTools via NovaLang
// Port 9851 | SERVICE_NAME = "novaxcore-engine"
// 7 tools: windows, registry, process, system, theme, clipboard, notify
// 100% PURE NOVALANG — zero PowerShell, zero Python
// All Win32 calls go through native Rust VM builtins
// Renamed from microsoft-engine → NovaXCore Engine (pure ternary)
// ============================================================

let H3 = 3
let H5 = 5
let H7 = 7
let H13 = 13
let BLOCK_SIZE = 2187
let RE_LAMINAR = 27
let RE_TRANSITION = 125
let RE_TURBULENT = 343

let SERVICE_NAME = "novaxcore-engine"
let SERVICE_PORT = 9851
let SERVICE_VERSION = "3.0.0-pure"

let _stats = {"total": 0, "ok": 0, "err": 0, "tools": {"windows": 0, "registry": 0, "process": 0, "system": 0, "theme": 0, "clipboard": 0, "notify": 0}}

fn _track(tool_name, success) {
    _stats = dict_set(_stats, "total", (dict_get(_stats, "total") ?? 0) + 1)
    let tc = dict_get(_stats, "tools") ?? {}
    tc = dict_set(tc, tool_name, (dict_get(tc, tool_name) ?? 0) + 1)
    _stats = dict_set(_stats, "tools", tc)
    if3 success {
        _stats = dict_set(_stats, "ok", (dict_get(_stats, "ok") ?? 0) + 1)
    } {
        _stats = dict_set(_stats, "err", (dict_get(_stats, "err") ?? 0) + 1)
    }
}

// ============================================================
// Tool 1: Windows — list, focus, resize, minimize, maximize
// Uses native win_list(), win_focus(), win_show(), win_resize()
// ============================================================
fn handle_windows(req) {
    let body = try3 { json_decode(req["body"]) } fail { req }
    let op = dict_get(body, "op") ?? "list"
    let hwnd = dict_get(body, "hwnd") ?? 0

    if3 op == "list" {
        let windows = win_list()
        _track("windows", true)
        return {"ok": true, "windows": windows}
    }

    if3 hwnd == 0 {
        _track("windows", false)
        return {"ok": false, "error": "hwnd_required"}
    }

    if3 op == "focus" {
        let r = win_focus(hwnd)
        _track("windows", r == 1)
        return {"ok": r == 1, "action": "focus", "hwnd": hwnd}
    }

    if3 op == "minimize" {
        let r = win_show(hwnd, 6)
        _track("windows", true)
        return {"ok": true, "action": "minimize", "hwnd": hwnd}
    }

    if3 op == "maximize" {
        let r = win_show(hwnd, 3)
        _track("windows", true)
        return {"ok": true, "action": "maximize", "hwnd": hwnd}
    }

    if3 op == "resize" {
        let width = dict_get(body, "width") ?? 800
        let height = dict_get(body, "height") ?? 600
        let r = win_resize(hwnd, width, height)
        _track("windows", r == 1)
        return {"ok": r == 1, "action": "resize", "hwnd": hwnd, "width": width, "height": height}
    }

    _track("windows", false)
    return {"ok": false, "error": "unknown_op", "op": op}
}

// ============================================================
// Tool 2: Registry — read, query (READ-ONLY)
// Uses native reg_read(), reg_query()
// ============================================================
fn handle_registry(req) {
    let body = try3 { json_decode(req["body"]) } fail { req }
    let op = dict_get(body, "op") ?? "read"
    let key = dict_get(body, "key") ?? ""
    let value_name = dict_get(body, "value") ?? ""

    if3 len(key) == 0 {
        _track("registry", false)
        return {"ok": false, "error": "key_required"}
    }

    if3 op == "read" {
        let data = reg_read(key, value_name)
        let ok = (dict_get(data, "ok") ?? -1) == 1
        _track("registry", ok)
        return data
    }

    if3 op == "query" {
        let data = reg_query(key)
        let ok = (dict_get(data, "ok") ?? -1) == 1
        _track("registry", ok)
        return data
    }

    _track("registry", false)
    return {"ok": false, "error": "unknown_op", "op": op}
}

// ============================================================
// Tool 3: Process — list, info, ports
// Uses native process_list(), net_connections()
// ============================================================
fn handle_process(req) {
    let body = try3 { json_decode(req["body"]) } fail { req }
    let op = dict_get(body, "op") ?? "list"

    if3 op == "list" {
        let procs = process_list()
        _track("process", true)
        return {"ok": true, "count": len(procs), "processes": procs}
    }

    if3 op == "info" {
        let pid = str(dict_get(body, "pid") ?? 0)
        let name = dict_get(body, "name") ?? ""
        let procs = process_list()
        let filtered = []
        for3 p in procs {
            let p_pid = dict_get(p, "pid") ?? ""
            let p_name = dict_get(p, "name") ?? ""
            if3 pid != "0" {
                if3 p_pid == pid {
                    filtered = append(filtered, p)
                }
            } {
                if3 len(name) > 0 {
                    if3 contains(to_lower(p_name), to_lower(name)) {
                        filtered = append(filtered, p)
                    }
                }
            }
        }
        if3 len(filtered) == 0 {
            _track("process", false)
            return {"ok": false, "error": "not_found"}
        }
        _track("process", true)
        return {"ok": true, "processes": filtered}
    }

    if3 op == "ports" {
        let conns = net_connections()
        _track("process", true)
        return {"ok": true, "count": len(conns), "connections": conns}
    }

    _track("process", false)
    return {"ok": false, "error": "unknown_op", "op": op}
}

// ============================================================
// Tool 4: System — info, cpu, memory, disk
// Uses native system_info(), sys_memory(), sys_disk()
// ============================================================
fn handle_system(req) {
    let body = try3 { json_decode(req["body"]) } fail { req }
    let op = dict_get(body, "op") ?? "info"

    if3 op == "info" {
        let data = system_info()
        _track("system", true)
        return dict_set(data, "ok", true)
    }

    if3 op == "os" {
        let data = system_info()
        _track("system", true)
        return {"ok": true, "os": dict_get(data, "os") ?? "", "hostname": dict_get(data, "hostname") ?? "", "user": dict_get(data, "user") ?? "", "arch": dict_get(data, "arch") ?? "", "is64bit": dict_get(data, "is64bit") ?? false}
    }

    if3 op == "cpu" {
        let data = system_info()
        _track("system", true)
        return {"ok": true, "cpu": {"processor": dict_get(data, "processor") ?? "", "cores": dict_get(data, "cpus") ?? 0}}
    }

    if3 op == "memory" {
        let data = sys_memory()
        _track("system", true)
        return {"ok": true, "memory": data}
    }

    if3 op == "disk" {
        let data = sys_disk()
        _track("system", true)
        return {"ok": true, "drives": data}
    }

    _track("system", false)
    return {"ok": false, "error": "unknown_op", "op": op}
}

// ============================================================
// Tool 5: Theme — darkmode, accent, wallpaper
// Uses native reg_read()
// ============================================================
fn handle_theme(req) {
    let body = try3 { json_decode(req["body"]) } fail { req }
    let op = dict_get(body, "op") ?? "darkmode"

    if3 op == "darkmode" {
        let apps = reg_read("HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize", "AppsUseLightTheme")
        let sys = reg_read("HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize", "SystemUsesLightTheme")
        let apps_val = dict_get(apps, "value") ?? "1"
        let sys_val = dict_get(sys, "value") ?? "1"
        _track("theme", true)
        return {"ok": true, "dark_mode_apps": apps_val == "0", "dark_mode_system": sys_val == "0"}
    }

    if3 op == "accent" {
        let data = reg_read("HKCU\\Software\\Microsoft\\Windows\\DWM", "AccentColor")
        _track("theme", true)
        return {"ok": true, "accent_raw": dict_get(data, "value") ?? ""}
    }

    if3 op == "wallpaper" {
        let data = reg_read("HKCU\\Control Panel\\Desktop", "WallPaper")
        let style = reg_read("HKCU\\Control Panel\\Desktop", "WallpaperStyle")
        _track("theme", true)
        return {"ok": true, "wallpaper": dict_get(data, "value") ?? "", "style": dict_get(style, "value") ?? ""}
    }

    _track("theme", false)
    return {"ok": false, "error": "unknown_op", "op": op}
}

// ============================================================
// Tool 6: Clipboard — read, write
// Uses native clipboard_read(), clipboard_write()
// ============================================================
fn handle_clipboard(req) {
    let body = try3 { json_decode(req["body"]) } fail { req }
    let op = dict_get(body, "op") ?? "read"

    if3 op == "read" {
        let content = clipboard_read()
        _track("clipboard", true)
        return {"ok": true, "content": content, "encoding": "unicode"}
    }

    if3 op == "write" {
        let text = dict_get(body, "text") ?? ""
        let r = clipboard_write(text)
        _track("clipboard", r == 1)
        return {"ok": r == 1, "action": "write", "length": len(text)}
    }

    _track("clipboard", false)
    return {"ok": false, "error": "unknown_op", "op": op}
}

// ============================================================
// Tool 7: Notify — toast (uses shell for balloon tip)
// Note: Windows toast notifications require COM — uses minimal shell
// ============================================================
fn handle_notify(req) {
    let body = try3 { json_decode(req["body"]) } fail { req }
    let op = dict_get(body, "op") ?? "toast"
    let title = dict_get(body, "title") ?? "NovaX"
    let message = dict_get(body, "message") ?? ""

    if3 op == "toast" {
        // msg.exe is a native Windows command (not PowerShell)
        let r = try3 { shell("msg * /TIME:5 " + title + ": " + message) } fail { null }
        _track("notify", true)
        return {"ok": true, "sent": true, "method": "native", "title": title}
    }

    _track("notify", false)
    return {"ok": false, "error": "unknown_op", "op": op}
}

// ============================================================
// Health & Status
// ============================================================
fn handle_health(req) {
    return {"status": "healthy", "service": SERVICE_NAME, "port": SERVICE_PORT, "version": SERVICE_VERSION, "ternary": 1, "pure": true, "bridge": "native_win32"}
}

fn handle_status(req) {
    let total = dict_get(_stats, "total") ?? 0
    let ok_count = dict_get(_stats, "ok") ?? 0
    let err_count = dict_get(_stats, "err") ?? 0
    let tools = dict_get(_stats, "tools") ?? {}
    return {
        "service": SERVICE_NAME,
        "version": SERVICE_VERSION,
        "port": SERVICE_PORT,
        "status": "running",
        "ternary": 1,
        "pure": true,
        "bridge": "native_win32",
        "harmonics": {"H3": H3, "H5": H5, "H7": H7, "H13": H13, "BLOCK_SIZE": BLOCK_SIZE},
        "reynolds": {"laminar": RE_LAMINAR, "transition": RE_TRANSITION, "turbulent": RE_TURBULENT},
        "stats": {"total_calls": total, "ok": ok_count, "errors": err_count, "per_tool": tools},
        "tools": ["windows", "registry", "process", "system", "theme", "clipboard", "notify"]
    }
}

// ============================================================
// Boot — 100% PURE NOVALANG, zero PowerShell, zero Python
// ============================================================
print("=== NovaXCore Engine v" + SERVICE_VERSION + " [PURE] ===")
print("  Port:    " + str(SERVICE_PORT))
print("  Tools:   windows, registry, process, system, theme, clipboard, notify")
print("  Bridge:  NATIVE WIN32 (no PowerShell, no Python)")
print("  Harmonics: 3-5-7-13 | BLOCK=" + str(BLOCK_SIZE))
print("")

let server = tserve(SERVICE_PORT, SERVICE_NAME)

troute(server, "GET",  "/health",               "handle_health")
troute(server, "GET",  "/status",               "handle_status")
troute(server, "POST", "/novaxcore/windows",    "handle_windows")
troute(server, "POST", "/novaxcore/registry",   "handle_registry")
troute(server, "POST", "/novaxcore/process",    "handle_process")
troute(server, "POST", "/novaxcore/system",     "handle_system")
troute(server, "POST", "/novaxcore/theme",      "handle_theme")
troute(server, "POST", "/novaxcore/clipboard",  "handle_clipboard")
troute(server, "POST", "/novaxcore/notify",     "handle_notify")

print("[novaxcore-engine] Listening on :" + str(SERVICE_PORT) + " [100% PURE NOVALANG]")

tstart(server)
