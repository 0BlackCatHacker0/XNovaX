// NovaX Hive Mind v2.0 -- Ternary Swarm Edition (NovaLang)
// ============================================================
// Unified AI mesh with 3-5-7-13 harmonic ternary layer.
// Queries multiple Ollama models, merges into one answer.
// Port: 9881 | Depends: Ollama (11434), Cloud Router (9878)
// ============================================================

// -- Section 1: Server init --
// -- Shared Libraries (N-S Flow) --
import3("C:/NovaX/lib/nova_ns_core.nova")
import3("C:/NovaX/lib/nova_stdlib.nova")
import3("C:/NovaX/lib/nova_tripple.nova")
import3("C:/NovaX/lib/nova_pure_tools.nova")

print("[BOOT-0] Starting port/server...")
let PORT = 9881
let server = tserve(PORT, "nova-hivemind")
print("[BOOT-1] Server created on :9881")

// -- Section 2: 3-5-7-13 Ternary Constants --
let T_TRUE = 1
let T_MAYBE = 0
let T_FALSE = -1
let BLOCK_SIZE = 2187
let RE_LAMINAR = 27
let RE_TRANSITION = 125
let RE_TURBULENT = 343

let OLLAMA_URL = "http://127.0.0.1:11434"
let CLOUD_ROUTER_URL = "http://127.0.0.1:9878"
let TTOOLS_URL = "http://127.0.0.1:9894"
let MAX_PARALLEL = 81
let MERGE_TIMEOUT = 60
let SWARM_TIMEOUT_GLOBAL = 300
let TRYTE_SIZE = 6
let HELPER_PY = "C:/NovaX/hivemind_helper.py"

// -- Section 3: State dicts --
let hive_stats = {"queries": 0, "query_times": [], "trits_pos": 0, "trits_zero": 0, "trits_neg": 0, "t0": time()}

// -- Tripple Module State (resonance sensor for Hivemind) --
let _tripple = tripple_init()
// Register Hivemind's providers: each Ollama model + cloud router
let _tp_ollama = tripple_init_provider("ollama", "local")
let _tp_cloud  = tripple_init_provider("cloud_router", "cloud")
let _tp_openai = tripple_init_provider("openai", "cloud")
let _tp_openrouter = tripple_init_provider("openrouter", "cloud")
let _tp_deepseek = tripple_init_provider("deepseek", "cloud")
let _hive_providers = (dict_get(_tripple, "providers") ?? {})
_hive_providers = dict_set(_hive_providers, "ollama", _tp_ollama)
_hive_providers = dict_set(_hive_providers, "cloud_router", _tp_cloud)
_hive_providers = dict_set(_hive_providers, "openai", _tp_openai)
_hive_providers = dict_set(_hive_providers, "openrouter", _tp_openrouter)
_hive_providers = dict_set(_hive_providers, "deepseek", _tp_deepseek)
_tripple = dict_set(_tripple, "providers", _hive_providers)
_tripple = tripple_mirror_init(_tripple)
_tripple = tripple_pacman_init(_tripple)

let warm_state = {"warming": {}, "warm": {}}

let system_flow_state = {
  "response_times": [],
  "response_tokens": [],
