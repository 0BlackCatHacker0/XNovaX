fn handle_swarm(req) {
  let body = try3 { json_decode(req["body"]) } fail { req }
  let prompt = (dict_get(body, "prompt") ?? (dict_get(body, "q") ?? ""))
  if3 (len(prompt) == 0) { return {"error": "Missing prompt"} }
  let system = (dict_get(body, "system") ?? "You are a helpful AI assistant. Be concise and accurate.")
  let max_models = (dict_get(body, "max_models") ?? 20)
  // SMART SWARM: Pick representative models from each provider
  // 1) Local Ollama: pick top 3 generative models
  let gen_models = []
  let local_picks = ["novax-qwen2.5-coder:latest", "falcon3:1b", "novax-tinyllama:latest"]
  let lp = 0
  while3 (lp < len(local_picks)) {
    if3 (dict_has(registry_models, local_picks[lp])) {
      gen_models = append(gen_models, local_picks[lp])
    }
    lp = lp + 1
  }
  // 2) Cloud: pick one model from each active provider via cloud router
  let cloud_picks = [
    "cloud:cerebras_direct:qwen-3-235b-a22b-instruct-2507",
    "cloud:openai:gpt-4o-mini",
    "cloud:anthropic:claude-sonnet-4-20250514",
    "cloud:together:arcee-ai/trinity-large-preview:free",
    "cloud:groq:arcee-ai/trinity-large-preview:free",
    "cloud:mistral:arcee-ai/trinity-large-preview:free",
    "cloud:deepseek:arcee-ai/trinity-large-preview:free",
    "cloud:cohere:arcee-ai/trinity-large-preview:free",
    "cloud:openrouter:arcee-ai/trinity-large-preview:free"
  ]
  let cp = 0
  while3 (cp < len(cloud_picks)) {
    gen_models = append(gen_models, cloud_picks[cp])
    cp = cp + 1
  }
  print("[SWARM] Smart scatter: " + str(len(gen_models)) + " models (local + cloud representatives)")
  let scatter_result = hive_scatter(gen_models, prompt, system, 90, len(gen_models))
  let results = (dict_get(scatter_result, "results") ?? [])
  let ok_results = []
  let i2 = 0
  while3 (i2 < len(results)) {
    if3 ((dict_get(results[i2], "ok") ?? false) == true) {
      if3 (len((dict_get(results[i2], "response") ?? "")) > 0) {
        ok_results = append(ok_results, results[i2])
      }
    }
    i2 = i2 + 1
  }
  let merged = hive_merge_responses(ok_results, prompt)
  let trit = response_trit({"ok": true, "merged_response": merged})
  record_query(trit)
  return {
    "merged_response": merged,
    "individual_results": results,
    "models_queried": len(gen_models),
    "models_responded": len(ok_results),
    "total_time_ms": (dict_get(scatter_result, "total_ms") ?? 0),
    "trit": trit,
    "task_type": "full_swarm",
    "ok": true
  }
}

