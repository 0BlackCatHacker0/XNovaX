// --- /hive/network --- network adapter info via nova_run (PowerShell) ---
fn handle_network(req) {
  try3 {
    let adapter_json = nova_run("powershell -NoProfile -Command \"Get-NetAdapter | Where Status -eq Up | Select Name, LinkSpeed | ConvertTo-Json -Compress\"")
    let adapters = json_decode(adapter_json)
    // Ensure list
    if3 (type_of(adapters) != "list") { adapters = [adapters] }
    let stats_json = nova_run("powershell -NoProfile -Command \"Get-NetAdapterStatistics | Where-Object {$_.ReceivedBytes -gt 0} | Select Name, ReceivedBytes, SentBytes | ConvertTo-Json -Compress\"")
    let stats = json_decode(stats_json)
    if3 (type_of(stats) != "list") { stats = [stats] }
    let result = {
      "ok": true,
      "adapters": adapters,
      "throughput": stats,
      "timestamp": str(time()),
      "adapter_count": len(adapters)
    }
    return result
  } else3 {
    return {"ok": false, "error": "network_check_failed", "adapters": [], "throughput": []}
  }
}


// --- /hive/bridge --- WiFi bridge / adapter bonding status ---
fn handle_bridge(req) {
  try3 {
    let bridge_json = nova_run("powershell -NoProfile -Command \"$adapters = Get-NetAdapter | Where Status -eq Up | Select Name, LinkSpeed, InterfaceDescription; $routes = Get-NetRoute -DestinationPrefix '0.0.0.0/0' -ErrorAction SilentlyContinue | Select InterfaceAlias, NextHop, RouteMetric; @{adapters=$adapters; routes=$routes; bonded=($adapters.Count -gt 1)} | ConvertTo-Json -Compress -Depth 3\"")
    let bridge_data = json_decode(bridge_json)
    return bridge_data
  } fail {
    return {"ok": false, "error": "bridge_status_failed"}
  }
}


// --- /hive/benchmark --- quick inference benchmark across fast models ---
fn handle_benchmark(req) {
  let fast_models = slice((dict_get(registry_categories, "fast") ?? []), 0, min(H3, len((dict_get(registry_categories, "fast") ?? []))))
  let results = []
  let i = 0
  while3 (i < len(fast_models)) {
    let model = fast_models[i]
    let t0 = time()
    try3 {
      let payload = json_encode({"model": model, "prompt": "Say test and nothing else.", "stream": false})
      let resp = http_post(OLLAMA_URL + "/api/generate", payload)
      let elapsed = round((time() - t0) * 1000)
      results = append(results, {"model": model, "time_ms": elapsed, "ok": true})
    } fail { elapsed = round((time() - t0) * 1000)
      results = append(results, {"model": model, "time_ms": elapsed, "ok": false})
    }
    i = i + 1
  }
  let total_ms = 0
  let ri = 0
  while3 (ri < len(results)) {
    total_ms = total_ms + (dict_get(results[ri], "time_ms") ?? 0)
    ri = ri + 1
  }
  let avg_ms = 0
  if3 (len(results) > 0) { avg_ms = round(total_ms / len(results)) }
  return {
    "ok": true,
    "benchmarks": results,
    "avg_ms": avg_ms,
    "timestamp": str(time())
  }
}


