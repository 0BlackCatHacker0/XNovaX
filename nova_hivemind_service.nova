  let result = {"ok": true, "integrated": integrated, "tcache_stats": tcache_stats, "tindex_stats": tindex_stats, "target_port": 9894}
  return result
}


// --- /hive/influence --- Go-style influence map ---
fn handle_influence(req) {
  // Build model_scores: {model: {channel: snr}}
  let model_scores = {}
  let ch_names = keys(FLOW_CHANNELS)
  let i = 0
  while3 (i < len(ch_names)) {
    let ch_name = ch_names[i]
    let ch_data = (dict_get(cluster_channels, ch_name) ?? {"local": [], "cloud": []})
    let local_models = (dict_get(ch_data, "local") ?? [])
    let cloud_models = (dict_get(ch_data, "cloud") ?? [])
    let snr = modulation_estimate_snr(ch_name)
    // Add local models
    let j = 0
    while3 (j < len(local_models)) {
      let m = local_models[j]
      if3 (dict_has(model_scores, m) == false) { dict_set(model_scores, m, {}) }
      let m_scores = (dict_get(model_scores, m) ?? {})
      m_scores = dict_set(m_scores, ch_name, snr)
      model_scores = dict_set(model_scores, m, m_scores)
      j = j + 1
    }
    // Add cloud models
    let k = 0
    while3 (k < len(cloud_models)) {
      let m = cloud_models[k]
      if3 (dict_has(model_scores, m) == false) { dict_set(model_scores, m, {}) }
      let m_scores = (dict_get(model_scores, m) ?? {})
      m_scores = dict_set(m_scores, ch_name, snr)
      model_scores = dict_set(model_scores, m, m_scores)
      k = k + 1
    }
    i = i + 1
  }
  // Compute Go-style influence with decay = H3/H5 = 0.6
  let decay = H3 * 1.0 / H5
  let influence = {}
  let m_keys = keys(model_scores)
  let mi = 0
  while3 (mi < len(m_keys)) {
    let mid = m_keys[mi]
    let scores = (dict_get(model_scores, mid) ?? {})
    let inf = {}
    let ci = 0
    while3 (ci < len(ch_names)) {
      let ch = ch_names[ci]
      let direct = (dict_get(scores, ch) ?? 0.0)
      let adj_sum = 0.0
      let neighbors = (dict_get(ternary_adj, ch) ?? {})
      let n_keys = keys(neighbors)
      let ni = 0
      while3 (ni < len(n_keys)) {
        let n_ch = n_keys[ni]
        let trit = (dict_get(neighbors, n_ch) ?? 0)
        if3 (trit == 1) { adj_sum = adj_sum + (dict_get(scores, n_ch) ?? 0.0) * decay
        }
        ni = ni + 1
      }
      let total = direct + adj_sum
      if3 (total > 1.0) { total = 1.0 }
      if3 (total > 0.01) {
        inf = dict_set(inf, ch, round(total * 1000) / 1000)
      }
      ci = ci + 1
    }
    influence = dict_set(influence, mid, inf)
    mi = mi + 1
  }
  return {"ok": true, "influence": influence, "models": len(model_scores)}
}


// --- /hive/territory --- territory assignment based on influence ---
fn handle_territory(req) {
  // Reuse influence logic then assign top models per channel
  let max_per = H5
  // Build model_scores
  let model_scores = {}
  let ch_names = keys(FLOW_CHANNELS)
  let i = 0
  while3 (i < len(ch_names)) {
    let ch_name = ch_names[i]
    let ch_data = (dict_get(cluster_channels, ch_name) ?? {"local": [], "cloud": []})
    let local_models = (dict_get(ch_data, "local") ?? [])
    let cloud_models = (dict_get(ch_data, "cloud") ?? [])
    let snr = modulation_estimate_snr(ch_name)
    let j = 0
    while3 (j < len(local_models)) {
      let m = local_models[j]
      if3 (dict_has(model_scores, m) == false) { dict_set(model_scores, m, {}) }
      let m_scores = (dict_get(model_scores, m) ?? {})
      m_scores = dict_set(m_scores, ch_name, snr)
      model_scores = dict_set(model_scores, m, m_scores)
      j = j + 1
    }
    let k = 0
    while3 (k < len(cloud_models)) {
      let m = cloud_models[k]
      if3 (dict_has(model_scores, m) == false) { dict_set(model_scores, m, {}) }
      let m_scores = (dict_get(model_scores, m) ?? {})
      m_scores = dict_set(m_scores, ch_name, snr)
      model_scores = dict_set(model_scores, m, m_scores)
      k = k + 1
    }
    i = i + 1
  }
  // Compute influence
  let decay = H3 * 1.0 / H5
  let influence = {}
  let m_keys = keys(model_scores)
  let mi = 0
  while3 (mi < len(m_keys)) {
    let mid = m_keys[mi]
    let scores = (dict_get(model_scores, mid) ?? {})
    let inf = {}
    let ci = 0
    while3 (ci < len(ch_names)) {
      let ch = ch_names[ci]
      let direct = (dict_get(scores, ch) ?? 0.0)
      let adj_sum = 0.0
      let neighbors = (dict_get(ternary_adj, ch) ?? {})
      let n_keys = keys(neighbors)
      let ni = 0
      while3 (ni < len(n_keys)) {
        let n_ch = n_keys[ni]
        let trit = (dict_get(neighbors, n_ch) ?? 0)
        if3 (trit == 1) { adj_sum = adj_sum + (dict_get(scores, n_ch) ?? 0.0) * decay
        }
        ni = ni + 1
      }
      let total = direct + adj_sum
      if3 (total > 1.0) { total = 1.0 }
      if3 (total > 0.01) {
        inf = dict_set(inf, ch, round(total * 1000) / 1000)
      }
      ci = ci + 1
    }
    influence = dict_set(influence, mid, inf)
    mi = mi + 1
  }
  // Assign territories: top max_per models per channel by influence score
  let territories = {}
  let ti = 0
  while3 (ti < len(ch_names)) {
    let ch = ch_names[ti]
    let candidates = []
    let mj = 0
    while3 (mj < len(m_keys)) {
      let mid = m_keys[mj]
      let inf_map = (dict_get(influence, mid) ?? {})
      let score = (dict_get(inf_map, ch) ?? 0.0)
      if3 (score > 0.05) {
        candidates = append(candidates, [mid, score])
      }
      mj = mj + 1
    }
    // Sort by score descending (simple selection sort)
    let si = 0
    while3 (si < len(candidates)) {
      let best_idx = si
      let sj = si + 1
      while3 (sj < len(candidates)) {
        if3 (candidates[sj][1] > candidates[best_idx][1]) { best_idx = sj
        }
        sj = sj + 1
      }
      if3 (best_idx != si) { let tmp = candidates[si]
        candidates = list_set(candidates, si, candidates[best_idx])
        candidates = list_set(candidates, best_idx, tmp)
      }
      si = si + 1
    }
    // Take top max_per
    let assigned = []
    let ai = 0
    while3 (ai < min(max_per, len(candidates))) {
      assigned = append(assigned, candidates[ai][0])
      ai = ai + 1
    }
    territories = dict_set(territories, ch, assigned)
    ti = ti + 1
  }
  return {"ok": true, "territories": territories}
}

