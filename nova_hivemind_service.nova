// ============================================================
// Section 8: Helper functions
// ============================================================

// -- Stats recording --
fn record_query(trit) {
  hive_stats = dict_set(hive_stats, "queries", (dict_get(hive_stats, "queries") ?? 0) + 1)
  let times = (dict_get(hive_stats, "query_times") ?? [])
  times = append(times, time())
  // Keep last 3600 entries
  if3 (len(times) > 3600) { times = slice(times, len(times) - 3600, len(times))
  }
  hive_stats = dict_set(hive_stats, "query_times", times)
  // Record to hive_history and trim to last 1000 entries
  hive_history = append(hive_history, {"trit": trit, "t": time()})
  if3 (len(hive_history) > 1000) { hive_history = slice(hive_history, len(hive_history) - 1000, len(hive_history))
  }
  if3 (trit == 1) { hive_stats = dict_set(hive_stats, "trits_pos", (dict_get(hive_stats, "trits_pos") ?? 0) + 1)
  }
  if3 (trit == 0) { hive_stats = dict_set(hive_stats, "trits_zero", (dict_get(hive_stats, "trits_zero") ?? 0) + 1)
  }
  if3 (trit == -1) { hive_stats = dict_set(hive_stats, "trits_neg", (dict_get(hive_stats, "trits_neg") ?? 0) + 1)
  }
}

// -- Response trit --
fn response_trit(result) {
  if3 (type_of(result) != "dict") { return T_FALSE }
  let ok = (dict_get(result, "ok") ?? false)
  if3 (ok == false) { return T_FALSE }
  let resp = (dict_get(result, "merged_response") ?? (dict_get(result, "merged") ?? (dict_get(result, "response") ?? (dict_get(result, "resp") ?? ""))))
  if3 (type_of(resp) == "string") {
    if3 (len(resp) > 50) { return T_TRUE }
    if3 (len(resp) > 0) { return T_MAYBE }
  }
  return T_FALSE
}

// -- Hive Reynolds --
fn hive_reynolds() {
  let now = time()
  let times = (dict_get(hive_stats, "query_times") ?? [])
  let count = 0
  let i = 0
  while3 (i < len(times)) {
    if3 (now - times[i] < 60) { count = count + 1
    }
    i = i + 1
  }
  return count
}

// -- Flow regime --
fn flow_regime(re_num) {
  if3 (re_num < RE_LAMINAR) { return "laminar" }
  if3 (re_num < RE_TRANSITION) { return "transitional" }
  if3 (re_num < RE_TURBULENT) { return "turbulent" }
  return "chaotic"
}

// -- Ternary logic functions --
fn trit_clamp(v) {
  if3 (v > 0) { return 1 }
  if3 (v < 0) { return -1 }
  return 0
}

fn trit_not3(t) {
  return 0 - t
}

fn trit_and3(a, b) {
  return min(a, b)
}

fn trit_or3(a, b) {
  return max(a, b)
}

fn trit_merge3(a, b) {
  if3 (a == b) { return a }
  if3 (a == 0) { return b }
  if3 (b == 0) { return a }
  return 0
}

fn bt_string(trits) {
  let result = ""
  let i = 0
  while3 (i < len(trits)) {
    if3 (trits[i] == 1) { result = result + "1" }
    if3 (trits[i] == 0) { result = result + "0" }
    if3 (trits[i] == -1) { result = result + "T" }
    i = i + 1
  }
  return result
}

fn merge_ternary(trits) {
  if3 (len(trits) == 0) { return 0 }
  let s = sum(trits)
  let n = len(trits)
  if3 (s == n) { return 1 }
  if3 (s == 0 - n) { return -1 }
  let threshold = n / H3
  if3 (s > threshold) { return 1 }
  if3 (s < 0 - threshold) { return -1 }
  return 0
}

// -- Standard deviation (manual, no statistics module) --
fn stdev(vals) {
  let n = len(vals)
  if3 (n < 2) { return 0.0 }
  let mean_val = sum(vals) / n
  let sq_sum = 0
  let i = 0
  while3 (i < n) {
    let diff = vals[i] - mean_val
    sq_sum = sq_sum + diff * diff
    i = i + 1
  }
  return sqrt(sq_sum / (n - 1))
}

// -- Ternary quantization --
fn ternary_quantize(value) {
  let HIGH_THRESH = 2.0 / H3
  let LOW_THRESH = 1.0 / H3
  if3 (value > HIGH_THRESH) { return 1 }
  if3 (value < LOW_THRESH) { return -1 }
  return 0
}

fn ternary_quantize_confidence(score) {
  return ternary_quantize(score)
}

// -- Tryte packing --
fn tryte_pack(trits) {
  let result = []
  let i = 0
  while3 (i < len(trits)) {
    let chunk = slice(trits, i, min(i + TRYTE_SIZE, len(trits)))
    while3 (len(chunk) < TRYTE_SIZE) {
      chunk = append(chunk, 0)
    }
    let val = 0
    let j = 0
    let pow3 = 1
    while3 (j < TRYTE_SIZE) {
      val = val + (chunk[j] + 1) * pow3
      pow3 = pow3 * 3
      j = j + 1
    }
    result = append(result, val)
    i = i + TRYTE_SIZE
  }
  return result
}

fn tryte_unpack(packed, total_trits) {
  let result = []
  let i = 0
  while3 (i < len(packed)) {
    let val = packed[i]
    let j = 0
    while3 (j < TRYTE_SIZE) {
      let digit = val - int(val / 3) * 3
      result = append(result, digit - 1)
      val = int(val / 3)
      j = j + 1
    }
    i = i + 1
  }
  if3 (total_trits > 0) { result = slice(result, 0, total_trits)
  }
  return result
}

fn tryte_string(packed) {
  let parts = []
  let i = 0
  while3 (i < len(packed)) {
    let v = packed[i]
    let d2 = int(v / 81)
    let d1 = int((v - d2 * 81) / 9)
    let d0 = v - d2 * 81 - d1 * 9
    parts = append(parts, str(d2) + str(d1) + str(d0))
    i = i + 1
  }
  return join(parts, ":")
}


// ============================================================
// Section 9: Flattened class methods
// ============================================================

// -- ModelRegistry --
fn registry_refresh() {
  try3 {
    let resp = http_get(OLLAMA_URL + "/api/tags")
    let body = (dict_get(resp, "body") ?? str(resp))
    let data = json_decode(body)
    let models = (dict_get(data, "models") ?? [])
    // Reset global registry (assign to global, not local)
    registry_models = {}
    let i = 0
    while3 (i < len(models)) {
      let m = models[i]
      let name = (dict_get(m, "name") ?? "")
      registry_models = dict_set(registry_models, name, {
        "name": name,
        "size": (dict_get(m, "size") ?? 0),
        "modified": (dict_get(m, "modified_at") ?? "")
      })
      i = i + 1
    }
    // ── INJECT ALL CLOUD MODELS INTO REGISTRY ──
    // ALL_CLOUD_MODELS has 469 cloud models from Tripple Mirror discovery
    let ci2 = 0
    while3 (ci2 < len(ALL_CLOUD_MODELS)) {
      let cname = ALL_CLOUD_MODELS[ci2]
      if3 (dict_has(registry_models, cname) == false) {
        registry_models = dict_set(registry_models, cname, {"name": cname, "size": 0, "modified": "", "source": "cloud"})
      }
      ci2 = ci2 + 1
    }
    // ── INJECT DEEPSEEK CLOUD MODELS ──
    let di2 = 0
    while3 (di2 < len(DEEPSEEK_CLOUD_MODELS)) {
      let dname = DEEPSEEK_CLOUD_MODELS[di2]
      if3 (dict_has(registry_models, dname) == false) {
        registry_models = dict_set(registry_models, dname, {"name": dname, "size": 0, "modified": "", "source": "cloud"})
      }
      di2 = di2 + 1
    }
    // ── INJECT DEEPSEEK LOCAL MODELS ──
    let dl2 = 0
    while3 (dl2 < len(DEEPSEEK_LOCAL_MODELS)) {
      let dlname = DEEPSEEK_LOCAL_MODELS[dl2]
      if3 (dict_has(registry_models, dlname) == false) {
        registry_models = dict_set(registry_models, dlname, {"name": dlname, "size": 0, "modified": "", "source": "local"})
      }
      dl2 = dl2 + 1
    }
    print("[REGISTRY] Merged: " + str(len(registry_models)) + " total models (local + cloud)")
    // Categorize all models AFTER loading
    // CRITICAL: Rust VM requires `let x = append(x, val)` — bare `append(x, val)` is a no-op!
    let code_cat = []
    let math_cat = []
    let reason_cat = []
    let general_cat = []
    let fast_cat = []
    let all_cat = []
    let all_keys = keys(registry_models)
    let ci = 0
    while3 (ci < len(all_keys)) {
      let name = all_keys[ci]
      let n = lower(name)
      let base_name = split(name, ":")[0]
      let is_excl = false
      let ek = 0
      while3 (ek < len(EXCLUDED_MODELS)) {
        if3 (base_name == EXCLUDED_MODELS[ek]) { is_excl = true }
        ek = ek + 1
      }
      if3 (is_excl == false) {
        all_cat = append(all_cat, name)
        if3 (contains(n, "code") || contains(n, "coder") || contains(n, "codellama") || contains(n, "codestral") || contains(n, "starcoder") || contains(n, "wizardcoder") || contains(n, "codegeex")) {
          code_cat = append(code_cat, name)
        }
        if3 (contains(n, "math") || contains(n, "llemma") || contains(n, "numina")) {
          math_cat = append(math_cat, name)
        }
        if3 (contains(n, "deepseek-r1") || contains(n, "qwq") || contains(n, "nous") || contains(n, "reflection") || contains(n, "phi-4")) {
          reason_cat = append(reason_cat, name)
        }
        if3 (contains(n, "llama") || contains(n, "qwen") || contains(n, "gemma") || contains(n, "mistral") || contains(n, "phi") || contains(n, "dolphin") || contains(n, "command") || contains(n, "falcon") || contains(n, "solar") || contains(n, "nemotron")) {
          general_cat = append(general_cat, name)
        }
        if3 (contains(n, "tinyllama") || contains(n, "smollm") || contains(n, "moondream") || contains(n, "granite") || contains(n, "orca-mini")) {
          fast_cat = append(fast_cat, name)
        }
      }
      ci = ci + 1
    }
    // Set all categories at once
    registry_categories = {"code": code_cat, "math": math_cat, "reasoning": reason_cat, "general": general_cat, "creative": [], "analysis": [], "fast": fast_cat, "all": all_cat}
    return len(registry_models)
  } fail {
    print("[HIVE] Registry refresh failed")
    return 0
  }
}

fn registry_categorize(name) {
  let n = lower(name)
  let base = split(name, ":")[0]
  // Check exclusions
  let k = 0
  while3 (k < len(EXCLUDED_MODELS)) {
    if3 (base == EXCLUDED_MODELS[k]) { return }
    k = k + 1
  }
  let matched = false
  let cat_list = []
  // Code
  let code_kws = ["code", "coder", "star", "phind", "codeup", "codegeex", "codellama", "codestral", "qwen2.5-coder", "deepseek-coder", "starcoder", "wizardcoder", "magicoder"]
  let ci = 0
  while3 (ci < len(code_kws)) {
    if3 (contains(n, code_kws[ci])) { cat_list = (dict_get(registry_categories, "code") ?? [])
      cat_list = append(cat_list, name)
      registry_categories = dict_set(registry_categories, "code", cat_list)
      matched = true
    }
    ci = ci + 1
  }
  // Math
  let math_kws = ["math", "wizard-math", "mathstral", "metamath", "llemma", "numina"]
  let mi = 0
  while3 (mi < len(math_kws)) {
    if3 (contains(n, math_kws[mi])) { cat_list = (dict_get(registry_categories, "math") ?? [])
      cat_list = append(cat_list, name)
      registry_categories = dict_set(registry_categories, "math", cat_list)
      matched = true
    }
    mi = mi + 1
  }
  // Reasoning
  let reason_kws = ["deepseek-r1", "qwq", "marco", "nous", "neural", "reflection", "phi-4", "gemma2"]
  let ri = 0
  while3 (ri < len(reason_kws)) {
    if3 (contains(n, reason_kws[ri])) { cat_list = (dict_get(registry_categories, "reasoning") ?? [])
      cat_list = append(cat_list, name)
      registry_categories = dict_set(registry_categories, "reasoning", cat_list)
      matched = true
    }
    ri = ri + 1
  }
  // General
  let gen_kws = ["mixtral", "qwen", "llama", "command", "dolphin", "yi", "solar", "mistral", "gemma", "phi", "nemotron", "internlm", "glm4"]
  let gi = 0
  while3 (gi < len(gen_kws)) {
    if3 (contains(n, gen_kws[gi])) { cat_list = (dict_get(registry_categories, "general") ?? [])
      cat_list = append(cat_list, name)
      registry_categories = dict_set(registry_categories, "general", cat_list)
      matched = true
    }
    gi = gi + 1
  }
  // Fast
  let fast_kws = ["tinyllama", "orca-mini", "stable-code", "granite", "phi-2", "smollm", "moondream"]
  let fi = 0
  while3 (fi < len(fast_kws)) {
    if3 (contains(n, fast_kws[fi])) { cat_list = (dict_get(registry_categories, "fast") ?? [])
      cat_list = append(cat_list, name)
      registry_categories = dict_set(registry_categories, "fast", cat_list)
      matched = true
    }
    fi = fi + 1
  }
  if3 (matched == false) { cat_list = (dict_get(registry_categories, "general") ?? [])
    cat_list = append(cat_list, name)
    registry_categories = dict_set(registry_categories, "general", cat_list)
  }
}

fn registry_get_swarm(task_type, count) {
  let pool = (dict_get(registry_categories, task_type) ?? (dict_get(registry_categories, "all") ?? []))
  if3 (len(pool) == 0) {
    pool = (dict_get(registry_categories, "general") ?? [])
  }
  // Filter excluded — bare assignment inside if3, let x = append(x,v) pattern
  let filtered = []
  let i = 0
  while3 (i < len(pool)) { let base = split(pool[i], ":")[0]
    let excluded = false
    let j = 0
    while3 (j < len(EXCLUDED_MODELS)) {
      if3 (base == EXCLUDED_MODELS[j]) { excluded = true }
      j = j + 1
    }
    if3 (excluded == false) { filtered = append(filtered, pool[i]) }
    i = i + 1
  }
  if3 (len(filtered) > count) {
    return slice(filtered, 0, count)
  }
  return filtered
}

// -- TernaryEngine --
fn ternary_init() {
  // Quantize CHANNEL_ADJACENCY floats into trits
  let ch_names = keys(CHANNEL_ADJACENCY)
  let i = 0
  while3 (i < len(ch_names)) {
    let ch = ch_names[i]
    let neighbors = (dict_get(CHANNEL_ADJACENCY, ch) ?? {})
    let trit_neighbors = {}
    let n_keys = keys(neighbors)
    let j = 0
    while3 (j < len(n_keys)) {
      let nch = n_keys[j]
      let weight = (dict_get(neighbors, nch) ?? 0.0)
      trit_neighbors = dict_set(trit_neighbors, nch, ternary_quantize(weight))
      j = j + 1
    }
    ternary_adj = dict_set(ternary_adj, ch, trit_neighbors)
    i = i + 1
  }
}

fn ternary_get_activated(source_channel) {
  let adj = (dict_get(ternary_adj, source_channel) ?? {})
  let activated = []
  let ch_keys = keys(adj)
  let i = 0
  while3 (i < len(ch_keys)) {
    if3 ((dict_get(adj, ch_keys[i]) ?? 0) == 1) {
      activated = append(activated, ch_keys[i])
    }
    i = i + 1
  }
  return activated
}

fn ternary_get_suppressed(source_channel) {
  let adj = (dict_get(ternary_adj, source_channel) ?? {})
  let suppressed = []
  let ch_keys = keys(adj)
  let i = 0
  while3 (i < len(ch_keys)) {
    if3 ((dict_get(adj, ch_keys[i]) ?? 0) == -1) {
      suppressed = append(suppressed, ch_keys[i])
    }
    i = i + 1
  }
  return suppressed
}

fn ternary_route(source_channel, cross_signals) {
  let adj = (dict_get(ternary_adj, source_channel) ?? {})
  let candidates = {}
  let ch_keys = keys(adj)
  let i = 0
  while3 (i < len(ch_keys)) {
    let ch = ch_keys[i]
    let trit = (dict_get(adj, ch) ?? 0)
    if3 (trit == 1) { candidates = dict_set(candidates, ch, 1.0) }
    if3 (trit == 0) { candidates = dict_set(candidates, ch, 0.0) }
    i = i + 1
  }
  // Integrate cross signals
  if3 (type_of(cross_signals) == "list") { let si = 0
    while3 (si < len(cross_signals)) {
      let sig = cross_signals[si]
      let sig_ch = sig[0]
      let sig_conf = sig[1]
      if3 (dict_has(candidates, sig_ch)) {
        candidates = dict_set(candidates, sig_ch, (dict_get(candidates, sig_ch) ?? 0) + sig_conf)
      }
      si = si + 1
    }
  }
  // Filter by threshold 1/H3
  let result = []
  let rkeys = keys(candidates)
  let ri = 0
  while3 (ri < len(rkeys)) {
    let score = (dict_get(candidates, rkeys[ri]) ?? 0)
    if3 (score > 1.0 / H3) {
      result = append(result, [rkeys[ri], score])
    }
    ri = ri + 1
  }
  // Sort by score descending (simple bubble sort)
  let si = 0
  while3 (si < len(result)) {
    let sj = si + 1
    while3 (sj < len(result)) {
      if3 (result[sj][1] > result[si][1]) { let tmp = result[si]
        result = list_set(result, si, result[sj])
        result = list_set(result, sj, tmp)
      }
      sj = sj + 1
    }
    si = si + 1
  }
  return result
}

fn ternary_vote(responses_with_scores) {
  let agreed = []
  let abstained = []
  let disagreed = []
  let vote_trits = []
  let i = 0
  while3 (i < len(responses_with_scores)) {
    let entry = responses_with_scores[i]
    let text = entry[0]
    let score = entry[1]
    let trit = ternary_quantize_confidence(score)
    vote_trits = append(vote_trits, trit)
    if3 (trit == 1) { agreed = append(agreed, entry) }
    if3 (trit == -1) { disagreed = append(disagreed, entry) }
    if3 (trit == 0) { abstained = append(abstained, entry) }
    i = i + 1
  }
  let total = len(responses_with_scores)
  if3 (total == 0) { total = 1 }
  let confidence_ratio = round(len(agreed) / total, 3)
  let consensus = merge_ternary(vote_trits)
  return {
    "agreed_count": len(agreed),
    "abstained_count": len(abstained),
    "disagreed_count": len(disagreed),
    "consensus_trit": consensus,
    "confidence_ratio": confidence_ratio,
    "trit_distribution": {"+1": len(agreed), "0": len(abstained), "-1": len(disagreed)}
  }
}

fn ternary_synthesize(channel_results) {
  let agreed = []
  let neutral = []
  let suppressed = []
  let i = 0
  while3 (i < len(channel_results)) {
    let r = channel_results[i]
    let trit = ternary_quantize_confidence((dict_get(r, "score") ?? 0.5))
    if3 (trit == 1) { agreed = append(agreed, r) }
    if3 (trit == -1) { suppressed = append(suppressed, r) }
    if3 (trit == 0) { neutral = append(neutral, r) }
    i = i + 1
  }
  let anchor = ""
  if3 (len(agreed) > 0) { anchor = (dict_get(agreed[0], "response") ?? "")
  }
  return {
    "anchor_response": anchor,
    "+1_channels": len(agreed),
    "0_channels": len(neutral),
    "-1_channels": len(suppressed),
    "total": len(channel_results)
  }
}

fn ternary_adjacency_stats() {
  let total = 0
  let pos = 0
  let neg = 0
  let zero = 0
  let ch_keys = keys(ternary_adj)
  let i = 0
  while3 (i < len(ch_keys)) {
    let neighbors = (dict_get(ternary_adj, ch_keys[i]) ?? {})
    let n_keys = keys(neighbors)
    let j = 0
    while3 (j < len(n_keys)) {
      let trit = (dict_get(neighbors, n_keys[j]) ?? 0)
      total = total + 1
      if3 (trit == 1) { pos = pos + 1 }
      if3 (trit == -1) { neg = neg + 1 }
      if3 (trit == 0) { zero = zero + 1 }
      j = j + 1
    }
    i = i + 1
  }
  let skip_ratio = 0
  if3 (total > 0) { skip_ratio = round(zero / total, 3) }
  return {
    "total_connections": total,
    "activated_pos": pos,
    "neutral_zero": zero,
    "suppressed_neg": neg,
    "skip_ratio": skip_ratio
  }
}

// -- ModulationEngine --
fn modulation_init() {
  let ch_keys = keys(FLOW_CHANNELS)
  let i = 0
  while3 (i < len(ch_keys)) {
    mod_channel_snr = dict_set(mod_channel_snr, ch_keys[i], 0.5)
    mod_channel_ber = dict_set(mod_channel_ber, ch_keys[i], 0.0)
    mod_query_count = dict_set(mod_query_count, ch_keys[i], 0)
    i = i + 1
  }
}

fn modulation_estimate_snr(channel) {
  let snr = (dict_get(mod_channel_snr, channel) ?? 0.5)
  let ber = (dict_get(mod_channel_ber, channel) ?? 0.0)
  return snr / (1.0 + ber)
}

fn modulation_update_channel(channel, quality_score, success) {
  let alpha = 1.0 / H3
  let old_snr = (dict_get(mod_channel_snr, channel) ?? 0.5)
  let new_snr = (1 - alpha) * old_snr + alpha * quality_score
  mod_channel_snr = dict_set(mod_channel_snr, channel, new_snr)
  let old_ber = (dict_get(mod_channel_ber, channel) ?? 0.0)
  if3 (success == false) { let new_ber = min(1.0, old_ber + 1.0 / H13)
    mod_channel_ber = dict_set(mod_channel_ber, channel, new_ber)
  } else3 { let new_ber = max(0.0, old_ber - 1.0 / (H13 * 2))
    mod_channel_ber = dict_set(mod_channel_ber, channel, new_ber)
  }
  mod_query_count = dict_set(mod_query_count, channel, (dict_get(mod_query_count, channel) ?? 0) + 1)
  mod_total_queries = mod_total_queries + 1
}

fn modulation_select_scheme(channel) {
  let snr = modulation_estimate_snr(channel)
  let best = "BPSK"
  let i = 0
  while3 (i < len(MOD_SCHEME_ORDER)) {
    let scheme_name = MOD_SCHEME_ORDER[i]
    let scheme = (dict_get(MOD_SCHEMES, scheme_name) ?? {})
    if3 (snr >= (dict_get(scheme, "snr_min") ?? 0)) { best = scheme_name
    }
    i = i + 1
  }
  return best
}

fn modulation_select_for_reynolds(regime) {
  if3 (regime == "chaotic") { return "1024QAM" }
  if3 (regime == "turbulent") { return "64QAM" }
  if3 (regime == "transitional") { return "16QAM" }
  return "BPSK"
}

fn modulation_link_budget() {
  let snr_vals = values(mod_channel_snr)
  let ber_vals = values(mod_channel_ber)
  let avg_snr = 0.5
  let avg_ber = 0.0
  if3 (len(snr_vals) > 0) { avg_snr = sum(snr_vals) / len(snr_vals) }
  if3 (len(ber_vals) > 0) { avg_ber = sum(ber_vals) / len(ber_vals) }
  return {
    "total_queries": mod_total_queries,
    "avg_snr": round(avg_snr, 3),
    "avg_ber": round(avg_ber, 4)
  }
}

// -- NavierStokesEngine --
fn ns_init() {
  let ch_keys = keys(FLOW_CHANNELS)
  let i = 0
  while3 (i < len(ch_keys)) {
    ns_backpressure = dict_set(ns_backpressure, ch_keys[i], 0.0)
    ns_momentum = dict_set(ns_momentum, ch_keys[i], {"context": "", "magnitude": 0.0})
    i = i + 1
  }
}

fn ns_compute_energy(model_count, latency_ms, queue_pressure, complexity_cost) {
  let kinetic = 0.5 * model_count * (latency_ms / 1000.0) * (latency_ms / 1000.0)
  let pressure = queue_pressure / max(model_count, 1)
  let potential = complexity_cost * 0.5
  let total = kinetic + pressure + potential
  let result = {
    "kinetic": round(kinetic, 4),
    "pressure": round(pressure, 4),
    "potential": round(potential, 4),
    "total": round(total, 4)
  }
  ns_energy_history = append(ns_energy_history, result)
  if3 (len(ns_energy_history) > 100) {
    ns_energy_history = slice(ns_energy_history, len(ns_energy_history) - 100, len(ns_energy_history))
  }
  ns_total_computed = ns_total_computed + 1
  return result
}

fn ns_viscous_damping(scores_list) {
  let nu = 1.0 / H7
  if3 (len(scores_list) < 2) { return scores_list }
  let smoothed = []
  let i = 0
  while3 (i < len(scores_list)) {
    let left_val = scores_list[i]
    if3 (i > 0) { left_val = scores_list[i - 1] }
    let right_val = scores_list[i]
    if3 (i < len(scores_list) - 1) { right_val = scores_list[i + 1] }
    let laplacian = (left_val + right_val) / 2.0 - scores_list[i]
    let damped = scores_list[i] + nu * laplacian
    smoothed = append(smoothed, round(damped, 4))
    i = i + 1
  }
  return smoothed
}

fn ns_compute_backpressure(channel) {
  let pressure = min(ns_ollama_queue_depth / H5, 1.0)
  ns_backpressure = dict_set(ns_backpressure, channel, pressure)
  let recommendation = "local"
  if3 (pressure > 2.0 / H3) { recommendation = "cloud" }
  if3 (pressure > 1.0 / H3) {
    if3 (recommendation == "local") { recommendation = "balanced" }
  }
  return {"channel": channel, "pressure_level": round(pressure, 3), "recommendation": recommendation}
}

fn ns_get_flow_field() {
  return {
    "backpressure": ns_backpressure,
    "ollama_queue_depth": ns_ollama_queue_depth,
    "total_computed": ns_total_computed,
    "recent_energy_count": len(ns_energy_history)
  }
}

fn ns_status() {
  return {
    "total_computed": ns_total_computed,
    "ollama_queue_depth": ns_ollama_queue_depth,
    "energy_history_len": len(ns_energy_history)
  }
}

// -- BenchmarkCluster --
fn cluster_assign_models() {
  let all_local = keys(registry_models)
  let ch_names = keys(FLOW_CHANNELS)
  let i = 0
  while3 (i < len(ch_names)) {
    let ch_name = ch_names[i]
    let ch_def = (dict_get(FLOW_CHANNELS, ch_name) ?? {})
    let patterns = (dict_get(ch_def, "local_patterns") ?? [])
    let cloud_models_list = (dict_get(ch_def, "cloud_models") ?? [])
    // Match local models by pattern
    let local_matches = []
    let li = 0
    while3 (li < len(all_local)) {
      let model = all_local[li]
      let n = lower(model)
      let pi = 0
      while3 (pi < len(patterns)) {
        if3 (contains(n, patterns[pi])) {
          local_matches = append(local_matches, model)
          pi = len(patterns)
        }
        pi = pi + 1
      }
      li = li + 1
    }
    // Filter cloud models to those in master list
    let cloud_matches = []
    let ci = 0
    while3 (ci < len(cloud_models_list)) {
      let cm = cloud_models_list[ci]
      let cj = 0
      while3 (cj < len(ALL_CLOUD_MODELS)) {
        if3 (cm == ALL_CLOUD_MODELS[cj]) {
          cloud_matches = append(cloud_matches, cm)
          cj = len(ALL_CLOUD_MODELS)
        }
        cj = cj + 1
      }
      ci = ci + 1
    }
    cluster_channels = dict_set(cluster_channels, ch_name, {"local": local_matches, "cloud": cloud_matches})
    i = i + 1
  }
}

fn cluster_get_channel_for_query(prompt) {
  let prompt_lower = lower(prompt)
  let best_ch = "REASON"
  let best_score = 0
  let ch_names = keys(CHANNEL_KEYWORDS)
  let i = 0
  while3 (i < len(ch_names)) {
    let ch = ch_names[i]
    let kws = (dict_get(CHANNEL_KEYWORDS, ch) ?? [])
    let score = 0
    let j = 0
    while3 (j < len(kws)) {
      if3 (contains(prompt_lower, kws[j])) { score = score + 1
      }
      j = j + 1
    }
    if3 (score > best_score) { best_score = score
      best_ch = ch
    }
    i = i + 1
  }
  return best_ch
}

fn cluster_status() {
  let result = {}
  let total_local = 0
  let total_cloud = 0
  let ch_names = keys(FLOW_CHANNELS)
  let i = 0
  while3 (i < len(ch_names)) {
    let ch_name = ch_names[i]
    let ch_data = (dict_get(cluster_channels, ch_name) ?? {"local": [], "cloud": []})
    let n_local = len((dict_get(ch_data, "local") ?? []))
    let n_cloud = len((dict_get(ch_data, "cloud") ?? []))
    total_local = total_local + n_local
    total_cloud = total_cloud + n_cloud
    result = dict_set(result, ch_name, {"local": n_local, "cloud": n_cloud, "total": n_local + n_cloud})
    i = i + 1
  }
  result = dict_set(result, "_summary", {"channels": len(ch_names), "total_local": total_local, "total_cloud": total_cloud})
  return result
}

// -- Calculate Reynolds --
fn calculate_reynolds(prompt) {
  let words = split(prompt, " ")
  let word_count = len(words)
  let prompt_lower = lower(prompt)
  // Density
  let complexity = 0
  // Count commas, semicolons, questions
  let ci = 0
  while3 (ci < len(prompt_lower)) {
    let ch = slice(prompt_lower, ci, ci + 1)
    if3 (ch == ",") { complexity = complexity + 2 }
    if3 (ch == ";") { complexity = complexity + H3 }
    if3 (ch == "?") { complexity = complexity + H5 }
    ci = ci + 1
  }
  let density = max(1, word_count + complexity)
  // Velocity
  let velocity = 1.0
  if3 (contains(prompt_lower, "step by step")) { velocity = H5 / 2.0 }
  if3 (contains(prompt_lower, "detailed")) { velocity = H5 / 2.0 }
  if3 (contains(prompt_lower, "explain")) { velocity = H5 / H3 }
  if3 (contains(prompt_lower, "quick")) { velocity = 0.5 }
  if3 (contains(prompt_lower, "brief")) { velocity = 0.5 }
  // Length
  let length = max(1, len(prompt) / 10)
  // Viscosity
  let viscosity = H5 / H3
  if3 (contains(prompt_lower, "medical")) { viscosity = viscosity + 0.3 }
  if3 (contains(prompt_lower, "legal")) { viscosity = viscosity + 0.3 }
  if3 (contains(prompt_lower, "quantum")) { viscosity = viscosity + 0.4 }
  // Reynolds
  let re = (density * velocity * length) / viscosity
  // Classify regime
  let regime = "laminar"
  let config = {"models": 1, "deliberate": false}
  if3 (re >= RE_TURBULENT) { regime = "chaotic"
    config = {"models": MAX_PARALLEL, "deliberate": true}
  }
  if3 (re >= RE_TRANSITION) {
    if3 (re < RE_TURBULENT) { regime = "turbulent"
      config = {"models": H5 * H3, "deliberate": true}
    }
  }
  if3 (re >= RE_LAMINAR) {
    if3 (re < RE_TRANSITION) { regime = "transitional"
      config = {"models": H5, "deliberate": false}
    }
  }
  return {"re": re, "regime": regime, "config": config}
}

// -- HiveMind query functions --
fn hive_query_model(model_name, prompt, system_prompt) {
  // CRITICAL: json_encode + http_post doesn't produce valid JSON for Ollama
  // Must build JSON string manually with "stream":false hardcoded
  let esc_prompt = replace(replace(replace(replace(prompt, "\\", "\\\\"), "\"", "\\\""), "\n", " "), "\r", " ")
  let esc_system = replace(replace(replace(replace(system_prompt, "\\", "\\\\"), "\"", "\\\""), "\n", " "), "\r", " ")
  let payload = "{\"model\":\"" + model_name + "\",\"prompt\":\"" + esc_prompt + "\",\"system\":\"" + esc_system + "\",\"stream\":false,\"options\":{\"num_predict\":4096,\"temperature\":0.7}}"
  try3 {
    let t0 = time()
    let resp = http_post(OLLAMA_URL + "/api/generate", payload)
    let elapsed = round((time() - t0) * 1000)
    // http_post returns {ok, status, body} — extract body before json_decode
    let body = (dict_get(resp, "body") ?? str(resp))
    let data = json_decode(body)
    let response_text = (dict_get(data, "response") ?? "")
    let has_error = dict_has(data, "error")
    if3 (has_error == true) { return {"model": model_name, "response": "", "time_ms": elapsed, "ok": false, "source": "local", "error": (dict_get(data, "error") ?? "")} }
    return {"model": model_name, "response": response_text, "time_ms": elapsed, "tokens": (dict_get(data, "eval_count") ?? 0), "ok": true, "source": "local"}
  } fail {
    return {"model": model_name, "response": "", "time_ms": 0, "ok": false, "source": "local"}
  }
}

fn hive_query_cloud(model_id, prompt, system_prompt) {
  let actual_model = model_id
  let provider = "openrouter"
  if3 (starts_with(model_id, "openai:")) {
    provider = "openai"
    let parts = split(model_id, ":")
    if3 (len(parts) >= 2) { actual_model = parts[1] }
  }
  if3 (starts_with(model_id, "cloud:")) { let parts = split(model_id, ":")
    if3 (len(parts) >= 3) {
      provider = parts[1]
      actual_model = parts[2]
    }
  }
  // Check rate limit
  let rate_state = (dict_get(provider_rate_state, provider) ?? {})
  let is_limited = (dict_get(rate_state, "limited") ?? false)
  if3 (is_limited == true) { let since = (dict_get(rate_state, "since") ?? 0)
    if3 (time() - since < H13 * 60) {
      return {"model": model_id, "response": "", "time_ms": 0, "ok": false, "source": "cloud", "error": "rate_limited"}
    }
  }
  let esc_prompt = replace(replace(replace(prompt, "\\", "\\\\"), "\"", "\\\""), "\n", " ")
  let payload = "{\"prompt\":\"" + esc_prompt + "\",\"provider\":\"" + provider + "\"}"
  let headers = {"Content-Type": "application/json"}
  try3 {
    let t0 = time()
    let resp = http_post_headers(CLOUD_ROUTER_URL + "/query", payload, headers, 45000)
    let elapsed = round((time() - t0) * 1000)
    let body_str = (dict_get(resp, "body") ?? "")
    if3 (len(body_str) == 0) { body_str = str(resp) }
    // Sanitize control chars before JSON parse
    let clean = replace(replace(replace(body_str, "\n", " "), "\r", " "), "\t", " ")
    let data = try3 { json_decode(clean) } fail { {} }
    // Cloud router returns {ok, result: {response, tokens, ...}}
    let res = (dict_get(data, "result") ?? {})
    let text = (dict_get(res, "response") ?? "")
    if3 (len(text) == 0) { text = (dict_get(data, "response") ?? "") }
    let tok = (dict_get(res, "tokens") ?? 0)
    print("[HIVE-CLOUD] " + provider + " -> " + str(len(text)) + " chars, " + str(tok) + " tokens")
    return {"model": model_id, "response": text, "time_ms": elapsed, "tokens": tok, "ok": len(text) > 0, "source": "cloud", "provider": provider}
  } fail {
    print("[HIVE-CLOUD] " + provider + " -> FAILED (try3 caught)")
    return {"model": model_id, "response": "", "time_ms": 0, "ok": false, "source": "cloud", "error": "http_or_parse_failed"}
  }
}

// -- Parallel scatter via helper --
fn hive_scatter(models, prompt, system_prompt, timeout, early_return) {
  // Scatter across BOTH local and cloud models
  let results = []
  let ok_count = 0
  let t0 = time()
  let i = 0
  while3 (i < len(models)) {
    let model_name = models[i]
    // Detect cloud vs local: check prefix OR registry source
    let is_cloud = false
    if3 (starts_with(model_name, "cloud:")) { is_cloud = true }
    if3 (starts_with(model_name, "openai:")) { is_cloud = true }
    if3 (starts_with(model_name, "anthropic:")) { is_cloud = true }
    if3 (starts_with(model_name, "google:")) { is_cloud = true }
    if3 (is_cloud == false) {
      let model_info = (dict_get(registry_models, model_name) ?? {})
      let src = (dict_get(model_info, "source") ?? "local")
      if3 (src == "cloud") { is_cloud = true }
    }
    let r = {}
    if3 (is_cloud == true) {
      // Route cloud models through the cloud router
      r = hive_query_cloud(model_name, prompt, system_prompt)
    } else3 {
      // Local Ollama models — direct query
      r = hive_query_model(model_name, prompt, system_prompt)
    }
    results = append(results, r)
    if3 ((dict_get(r, "ok") ?? false) == true) {
      ok_count = ok_count + 1
    }
    // Early return if we have enough good results
    if3 (ok_count >= early_return) { i = len(models)
    }
    // Timeout check
    if3 ((time() - t0) * 1000 > timeout * 1000) { i = len(models) }
    i = i + 1
  }
  let total_ms = round((time() - t0) * 1000)
  return {"results": results, "ok_count": ok_count, "total_ms": total_ms}
}

// -- Merge responses --
fn hive_merge_responses(results, prompt) {
  if3 (len(results) == 0) { return "No models responded." }
  if3 (len(results) == 1) {
    return (dict_get(results[0], "response") ?? "")
  }
  hive_state = dict_set(hive_state, "merge_count", (dict_get(hive_state, "merge_count") ?? 0) + 1)
  // Classify each response
  let classified = []
  let i = 0
  while3 (i < len(results)) {
    let r = results[i]
    let resp = (dict_get(r, "response") ?? "")
    let ms = (dict_get(r, "time_ms") ?? 9999)
    let q = 0.0
    q = q + min(len(resp) / 500, 1.0) * 0.5
    q = q + max(0, 1.0 - ms / 5000) * 0.3
    if3 (contains(lower(resp), "because")) { q = q + 0.05 }
    if3 (contains(lower(resp), "therefore")) { q = q + 0.05 }
    if3 (contains(lower(resp), "step")) { q = q + 0.05 }
    let trit = ternary_quantize(q)
    classified = append(classified, {"response": resp, "trit": trit, "quality": round(q, 3)})
    i = i + 1
  }
  // Sort: best trit and quality first (simple selection sort)
  let si = 0
  while3 (si < len(classified)) {
    let best_idx = si
    let sj = si + 1
    while3 (sj < len(classified)) {
      let a = classified[sj]
      let b = classified[best_idx]
      if3 ((dict_get(a, "trit") ?? 0) > (dict_get(b, "trit") ?? 0)) {
        best_idx = sj
      }
      if3 ((dict_get(a, "trit") ?? 0) == (dict_get(b, "trit") ?? 0)) {
        if3 ((dict_get(a, "quality") ?? 0) > (dict_get(b, "quality") ?? 0)) {
          best_idx = sj
        }
      }
      sj = sj + 1
    }
    if3 (best_idx != si) { let tmp = classified[si]
      // swap
      classified = list_set(classified, si, classified[best_idx])
      classified = list_set(classified, best_idx, tmp)
    }
    si = si + 1
  }
  // Get best response
  let merged = (dict_get(classified[0], "response") ?? "")
  return trim(merged)
}

// -- Similarity check --
fn text_similarity(a, b) {
  if3 (len(a) == 0) { return 0 }
  if3 (len(b) == 0) { return 0 }
  let a_words = split(lower(a), " ")
  let b_words = split(lower(b), " ")
  // Count overlap
  let overlap = 0
  let i = 0
  while3 (i < len(a_words)) {
    let j = 0
    while3 (j < len(b_words)) {
      if3 (a_words[i] == b_words[j]) { overlap = overlap + 1
        j = len(b_words)
      }
      j = j + 1
    }
    i = i + 1
  }
  return overlap / max(len(a_words), len(b_words))
}

// -- Cluster query (main entry point) --
fn hive_cluster_query(prompt, channel, force_regime) {
  let t_start = time()
  hive_state = dict_set(hive_state, "total_queries", (dict_get(hive_state, "total_queries") ?? 0) + 1)
  // Auto-detect channel
  if3 (len(channel) == 0) { channel = cluster_get_channel_for_query(prompt)
  }
  channel = upper(channel)
  if3 (dict_has(FLOW_CHANNELS, channel) == false) { channel = "REASON" }
  // Calculate Reynolds
  let re_result = calculate_reynolds(prompt)
  let re_num = (dict_get(re_result, "re") ?? 0)
  let regime = (dict_get(re_result, "regime") ?? "laminar")
  let regime_config = (dict_get(re_result, "config") ?? {"models": 1, "deliberate": false})
  if3 (len(force_regime) > 0) { regime = force_regime
    if3 (force_regime == "laminar") { regime_config = {"models": 1, "deliberate": false} }
    if3 (force_regime == "transitional") { regime_config = {"models": 5, "deliberate": false} }
    if3 (force_regime == "turbulent") { regime_config = {"models": 15, "deliberate": true} }
    if3 (force_regime == "chaotic") { regime_config = {"models": MAX_PARALLEL, "deliberate": true} }
  }
  // Get channel system prompt
  let ch_def = (dict_get(FLOW_CHANNELS, channel) ?? {})
  let system = (dict_get(ch_def, "system") ?? "You are a helpful AI assistant.")
  // Get model pools
  let ch_data = (dict_get(cluster_channels, channel) ?? {"local": [], "cloud": []})
  let local_pool = (dict_get(ch_data, "local") ?? [])
  let cloud_pool = (dict_get(ch_data, "cloud") ?? [])
  // Limit models based on regime
  let max_models = (dict_get(regime_config, "models") ?? 5)
  let models_to_query = []
  // Add local models
  let li = 0
  while3 (li < len(local_pool)) {
    if3 (len(models_to_query) < max_models) {
      models_to_query = append(models_to_query, local_pool[li])
    }
    li = li + 1
  }
  // Add cloud models
  let ci = 0
  while3 (ci < len(cloud_pool)) {
    if3 (len(models_to_query) < max_models) {
      models_to_query = append(models_to_query, cloud_pool[ci])
    }
    ci = ci + 1
  }
  // Scatter via helper for parallelism
  let scatter_result = hive_scatter(models_to_query, prompt, system, MERGE_TIMEOUT, H7)
  let results = (dict_get(scatter_result, "results") ?? [])
  let ok_results = []
  let i = 0
  while3 (i < len(results)) {
    let r = results[i]
    if3 ((dict_get(r, "ok") ?? false) == true) {
      if3 (len((dict_get(r, "response") ?? "")) > 0) {
        ok_results = append(ok_results, r)
      }
    }
    i = i + 1
  }
  // Merge
  let final_response = hive_merge_responses(ok_results, prompt)
  let total_ms = round((time() - t_start) * 1000)
  // Record query
  let trit = response_trit({"ok": true, "response": final_response})
  record_query(trit)
  return {
    "response": final_response,
    "channel": channel,
    "reynolds": round(re_num, 1),
    "regime": regime,
    "models_queried": len(models_to_query),
    "models_responded": len(ok_results),
    "local_models": len(local_pool),
    "cloud_models": len(cloud_pool),
    "deliberated": (dict_get(regime_config, "deliberate") ?? false),
    "total_time_ms": total_ms,
    "trit": trit,
    "ok": true
  }
}

// -- Pipeline query --
fn hive_pipeline_query(prompt, mode, channels_list, max_depth) {
  // For pipeline modes, we chain cluster queries
  if3 (mode == "explicit") { let stages = []
    let i = 0
    while3 (i < len(channels_list)) {
      let ch = upper(channels_list[i])
      if3 (dict_has(FLOW_CHANNELS, ch)) { let result = hive_cluster_query(prompt, ch, "")
        stages = append(stages, result)
      }
      i = i + 1
    }
    // Synthesize
    let best_response = ""
    let best_score = 0
    let si = 0
    while3 (si < len(stages)) {
      let resp = (dict_get(stages[si], "response") ?? "")
      if3 (len(resp) > best_score) { best_score = len(resp)
        best_response = resp
      }
      si = si + 1
    }
    return {
      "response": best_response,
      "stages_count": len(stages),
      "mode": mode,
      "ok": true
    }
  }
  // Default: auto mode -- classify then query
  let channel = cluster_get_channel_for_query(prompt)
  let result = hive_cluster_query(prompt, channel, "")
  result = dict_set(result, "mode", "auto")
  return result
}

// -- Balanced ternary addition with carry --
fn bt_add_carry(a, b, carry) {
  let s = a + b + carry
  if3 (s > 1) { return {"digit": s - 3, "carry": 1} }
  if3 (s < -1) { return {"digit": s + 3, "carry": -1} }
  return {"digit": s, "carry": 0}
}

// -- Vector merge ternary --
fn vec_merge_ternary(vectors, mode) {
  if3 (len(vectors) == 0) { return [] }
  let max_len = 0
  let vi = 0
  while3 (vi < len(vectors)) {
    if3 (len(vectors[vi]) > max_len) { max_len = len(vectors[vi]) }
    vi = vi + 1
  }
  if3 (mode == "majority") { let result = []
    let d = 0
    while3 (d < max_len) {
      let s = 0
      let pi = 0
      while3 (pi < len(vectors)) {
        let v = vectors[pi]
        if3 (d < len(v)) { s = s + v[d] }
        pi = pi + 1
      }
      let n = len(vectors)
      let threshold = n / H3
      if3 (s > threshold) { result = append(result, 1) }
      if3 (s < 0 - threshold) { result = append(result, -1) }
      if3 (s >= 0 - threshold) {
        if3 (s <= threshold) { result = append(result, 0) }
      }
      d = d + 1
    }
    return result
  }
  if3 (mode == "merge3") { let result = vectors[0]
    let ri = 1
    while3 (ri < len(vectors)) {
      let v = vectors[ri]
      let new_result = []
      let d = 0
      while3 (d < max_len) {
        let a_val = 0
        let b_val = 0
        if3 (d < len(result)) { a_val = result[d] }
        if3 (d < len(v)) { b_val = v[d] }
        new_result = append(new_result, trit_merge3(a_val, b_val))
        d = d + 1
      }
      result = new_result
      ri = ri + 1
    }
    return result
  }
  if3 (mode == "bt_add") { let result = vectors[0]
    let ri = 1
    while3 (ri < len(vectors)) {
      let v = vectors[ri]
      let carry = 0
      let new_result = []
      let d = 0
      while3 (d < max_len) {
        let a_val = 0
        let b_val = 0
        if3 (d < len(result)) { a_val = result[d] }
        if3 (d < len(v)) { b_val = v[d] }
        let add_r = bt_add_carry(a_val, b_val, carry)
        new_result = append(new_result, (dict_get(add_r, "digit") ?? 0))
        carry = (dict_get(add_r, "carry") ?? 0)
        d = d + 1
      }
      result = new_result
      ri = ri + 1
    }
    return result
  }
  return vec_merge_ternary(vectors, "majority")
}

// -- Influence map (Go-style) --
fn influence_map(model_scores) {
  let decay = H3 / H5
  let influence = {}
  let ch_list = keys(FLOW_CHANNELS)
  let mids = keys(model_scores)
  let mi = 0
  while3 (mi < len(mids)) {
    let mid = mids[mi]
    let scores = (dict_get(model_scores, mid) ?? {})
    let inf = {}
    let ci = 0
    while3 (ci < len(ch_list)) {
      let ch = ch_list[ci]
      let direct = (dict_get(scores, ch) ?? 0.0)
      let adj_sum = 0.0
      let second_sum = 0.0
      let neighbors = (dict_get(ternary_adj, ch) ?? {})
      let n_keys = keys(neighbors)
      let ni = 0
      while3 (ni < len(n_keys)) {
        let n_ch = n_keys[ni]
        let trit = (dict_get(neighbors, n_ch) ?? 0)
        if3 (trit == 1) { adj_sum = adj_sum + (dict_get(scores, n_ch) ?? 0.0) * decay
          let n2 = (dict_get(ternary_adj, n_ch) ?? {})
          let n2_keys = keys(n2)
          let n2i = 0
          while3 (n2i < len(n2_keys)) {
            let n2_ch = n2_keys[n2i]
            let t2 = (dict_get(n2, n2_ch) ?? 0)
            if3 (t2 == 1) {
              if3 (n2_ch != ch) { second_sum = second_sum + (dict_get(scores, n2_ch) ?? 0.0) * decay * decay
              }
            }
            n2i = n2i + 1
          }
        }
        ni = ni + 1
      }
      let total = min(direct + adj_sum + second_sum, 1.0)
      if3 (total > 0.01) {
        inf = dict_set(inf, ch, round(total, 3))
      }
      ci = ci + 1
    }
    influence = dict_set(influence, mid, inf)
    mi = mi + 1
  }
  return influence
}

// -- Territory assignment --
fn territory_assignment(influence_data, max_per_territory) {
  let territories = {}
  let ch_list = keys(FLOW_CHANNELS)
  let ci = 0
  while3 (ci < len(ch_list)) {
    let ch = ch_list[ci]
    let candidates = []
    let mids = keys(influence_data)
    let mi = 0
    while3 (mi < len(mids)) {
      let mid = mids[mi]
      let inf_map = (dict_get(influence_data, mid) ?? {})
      let score = (dict_get(inf_map, ch) ?? 0.0)
      if3 (score > 0.05) {
        candidates = append(candidates, [mid, score])
      }
      mi = mi + 1
    }
    let si = 0
    while3 (si < len(candidates)) {
      let sj = si + 1
      while3 (sj < len(candidates)) {
        if3 (candidates[sj][1] > candidates[si][1]) { let tmp = candidates[si]
          candidates = list_set(candidates, si, candidates[sj])
          candidates = list_set(candidates, sj, tmp)
        }
        sj = sj + 1
      }
      si = si + 1
    }
    let assigned = []
    let ai = 0
    while3 (ai < min(max_per_territory, len(candidates))) {
      assigned = append(assigned, candidates[ai][0])
      ai = ai + 1
    }
    territories = dict_set(territories, ch, assigned)
    ci = ci + 1
  }
  return territories
}

// -- System Reynolds --
fn system_reynolds() {
  let total_models = max(len(registry_models), 1)
  let pressures = (dict_get(system_flow_state, "model_pressures") ?? {})
  let active_models = 0
  let p_keys = keys(pressures)
  let pi = 0
  while3 (pi < len(p_keys)) {
    if3 ((dict_get(pressures, p_keys[pi]) ?? 0) > 0) { active_models = active_models + 1
    }
    pi = pi + 1
  }
  let rho = max(active_models / total_models, 1.0 / total_models)
  let now = time()
  let recent = 0
  let times = (dict_get(hive_stats, "query_times") ?? [])
  let ti = 0
  while3 (ti < len(times)) {
    if3 (now - times[ti] < 60) { recent = recent + 1 }
    ti = ti + 1
  }
  let v = max(recent / 60.0, 1.0 / 60.0)
  let resp_tokens = (dict_get(system_flow_state, "response_tokens") ?? [])
  let big_l = H13 * H7
  if3 (len(resp_tokens) > 0) { big_l = sum(resp_tokens) / len(resp_tokens) }
  let big_l = max(big_l, 1.0)
  let resp_times = (dict_get(system_flow_state, "response_times") ?? [])
  let mu = H5 / H3
  if3 (len(resp_times) > 0) { mu = sum(resp_times) / len(resp_times) }
  let mu = max(mu, 0.01)
  let re = (rho * v * big_l) / mu
  let regime = flow_regime(int(re))
  return {
    "Re": round(re, 1),
    "regime": regime,
    "components": {"rho": round(rho, 4), "v": round(v, 4), "L": round(big_l, 1), "mu": round(mu, 4)},
    "model_pressures": pressures
  }
}

// -- Get channel leaders from MaxPatch --
fn get_channel_leaders() {
  let leaders = {}
  try3 {
    let resp = http_get("http://127.0.0.1:9889/patch/fingerprints")
    let data = json_decode(resp)
    let fps = (dict_get(data, "fingerprints") ?? {})
    let ch_names = keys(FLOW_CHANNELS)
    let ci = 0
    while3 (ci < len(ch_names)) {
      let ch = ch_names[ci]
      let best_model = ""
      let best_score = 0
      let mid_keys = keys(fps)
      let mi = 0
      while3 (mi < len(mid_keys)) {
        let mid = mid_keys[mi]
        let is_embed = false
        let ei = 0
        while3 (ei < len(EMBEDDING_MODELS)) {
          if3 (contains(mid, EMBEDDING_MODELS[ei])) { is_embed = true }
          ei = ei + 1
        }
        if3 (is_embed == false) {
          if3 (contains(mid, "cloud:") == false) {
            if3 (contains(mid, "cortex:") == false) { let fp = (dict_get(fps, mid) ?? {})
              let ch_scores = (dict_get(fp, "channel_scores") ?? {})
              let score = (dict_get(ch_scores, ch) ?? 0)
              if3 (score > best_score) { best_score = score
                let best_model = mid
              }
            }
          }
        }
        mi = mi + 1
      }
      if3 (len(best_model) > 0) {
        leaders = dict_set(leaders, ch, best_model)
      }
      ci = ci + 1
  } else3 {
    // MaxPatch not available
  }
  return leaders
}

// -- Strategy state --
let strategy_plans = {}
let strategy_plan_counter = 0
let STRATEGY_BRANCH = {"laminar": 3, "transitional": 7, "turbulent": 13, "chaotic": 27}
}

fn strategy_plan(goal, context, depth, regime) {
  let t0 = time()
  let branch_factor = (dict_get(STRATEGY_BRANCH, regime) ?? H7)
  let planning_models = registry_get_swarm("reasoning", min(branch_factor, H7))
  if3 (len(planning_models) == 0) { planning_models = registry_get_swarm("general", H3)
  }
  let forward_prompt = "You are a strategic planner. Given the goal: " + goal
  if3 (len(context) > 0) { forward_prompt = forward_prompt + "\nContext: " + context
  }
  forward_prompt = forward_prompt + "\n\nGenerate " + str(min(branch_factor, H5)) + " distinct strategic approaches. For each, list 3-5 concrete steps."
  let forward_result = hive_scatter(planning_models, forward_prompt, "You are a strategic planning expert.", 60, H5)
  let forward_responses = []
  let fr_results = (dict_get(forward_result, "results") ?? [])
  let fri = 0
  while3 (fri < len(fr_results)) {
    let r = fr_results[fri]
    if3 ((dict_get(r, "ok") ?? false) == true) {
      if3 (len((dict_get(r, "response") ?? "")) > 10) {
        forward_responses = append(forward_responses, (dict_get(r, "response") ?? ""))
      }
    }
    fri = fri + 1
  }
  let backward_prompt = "Given the goal: " + goal + "\n\nWhat are the top 5 risks, blockers, or failure modes? For each, suggest a mitigation."
  let backward_result = hive_scatter(slice(planning_models, 0, min(H3, len(planning_models))), backward_prompt, "You are a risk analysis expert.", 60, H3)
  let backward_responses = []
  let br_results = (dict_get(backward_result, "results") ?? [])
  let bri = 0
  while3 (bri < len(br_results)) {
    let r = br_results[bri]
    if3 ((dict_get(r, "ok") ?? false) == true) {
      if3 (len((dict_get(r, "response") ?? "")) > 10) {
        backward_responses = append(backward_responses, (dict_get(r, "response") ?? ""))
      }
    }
    bri = bri + 1
  }
  let elapsed = round((time() - t0) * 1000)
  let total_moves = len(forward_responses) + len(backward_responses)
  let trit = T_TRUE
  if3 (total_moves == 0) { trit = T_FALSE }
  if3 (total_moves < H3) { trit = T_MAYBE }
  return {
    "ok": true,
    "goal": goal,
    "regime": regime,
    "depth": depth,
    "branch_factor": branch_factor,
    "forward_paths": len(forward_responses),
    "backward_paths": len(backward_responses),
    "total_moves": total_moves,
    "forward_responses": forward_responses,
    "backward_responses": backward_responses,
    "trit": trit,
    "elapsed_ms": elapsed
  }
}

fn strategy_status() {
  return {
    "ok": true,
    "plans_count": len(strategy_plans),
    "plan_counter": strategy_plan_counter,
    "branch_factors": STRATEGY_BRANCH
  }
}


