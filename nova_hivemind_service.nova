fn handle_query(req) {
  let body = try3 { json_decode(req["body"]) } fail { req }
  let prompt = (dict_get(body, "prompt") ?? (dict_get(body, "q") ?? ""))
  let task = (dict_get(body, "task") ?? (dict_get(body, "type") ?? "general"))
  let count = min((dict_get(body, "models") ?? (dict_get(body, "count") ?? 5)), MAX_PARALLEL)
  let system = (dict_get(body, "system") ?? "")
  if3 (len(prompt) == 0) { return {"error": "Missing prompt"} }

  // Tripple: outer loop regime detection before query
  _tripple = tripple_outer(_tripple)

  // Get model swarm
  let models = registry_get_swarm(task, count)
  if3 (len(models) == 0) { return {"error": "No models available"} }
  let sys_prompt = system
  if3 (len(sys_prompt) == 0) {
    if3 (task == "code") { sys_prompt = "You are an expert programmer. Write clean, efficient code with comments." }
    if3 (task == "math") { sys_prompt = "You are a mathematics expert. Show step-by-step solutions." }
    if3 (task == "reasoning") { sys_prompt = "You are a deep reasoning AI. Think step by step." }
    if3 (len(sys_prompt) == 0) { sys_prompt = "You are a helpful, knowledgeable AI assistant." }
  }
  // Scatter
  let t0 = time()
  let scatter_result = hive_scatter(models, prompt, sys_prompt, MERGE_TIMEOUT, H7)
  let results = (dict_get(scatter_result, "results") ?? [])
  let ok_results = []
  let i = 0
  while3 (i < len(results)) {
    if3 ((dict_get(results[i], "ok") ?? false) == true) {
      if3 (len((dict_get(results[i], "response") ?? "")) > 0) {
        ok_results = append(ok_results, results[i])
      }
    }
    i = i + 1
  }
  let merged = hive_merge_responses(ok_results, prompt)
  let total_time = (dict_get(scatter_result, "total_ms") ?? 0)
  let trit = response_trit({"ok": true, "merged_response": merged})
  record_query(trit)

  // Tripple: fire ripples for each model that responded
  let latency = time() - t0
  let ri = 0
  while3 (ri < len(results)) {
    let r = results[ri]
    let model_name = (dict_get(r, "model") ?? "unknown")
    let r_ok = (dict_get(r, "ok") ?? false)
    let r_trit = -1
    if3 (r_ok == true) { r_trit = 1 }
    // Determine provider from model name
    let prov_key = "ollama"
    if3 (contains(model_name, "openai")) { prov_key = "openai" }
    if3 (contains(model_name, "deepseek/")) { prov_key = "deepseek" }
    if3 (contains(model_name, ":free")) { prov_key = "openrouter" }
    if3 (contains(model_name, "google/")) { prov_key = "openrouter" }
    if3 (contains(model_name, "meta-llama/")) { prov_key = "openrouter" }
    if3 (contains(model_name, "qwen/")) { prov_key = "openrouter" }
    _tripple = tripple_ripple(_tripple, prov_key, r_trit, latency)
    // Mirror: reflect each model
    _tripple = tripple_mirror_reflect(_tripple, prov_key, model_name, r_trit, latency)
    ri = ri + 1
  }
  _tripple = tripple_resonance_check(_tripple)

  // Auto-inject SNR boost from ripple into modulation channels
  let prime_locked = (dict_get(_tripple, "prime_locked") ?? false)
  if3 (prime_locked == true) {
    // Prime state: boost all channel SNRs for 1024QAM
    let ch_keys = dict_keys(mod_channel_snr)
    let ci = 0
    while3 (ci < len(ch_keys)) {
      let ck = ch_keys[ci]
      let cur_snr = (dict_get(mod_channel_snr, ck) ?? 500)
      if3 (cur_snr < 900) {
        mod_channel_snr = dict_set(mod_channel_snr, ck, 900)
      }
      ci = ci + 1
    }
  }

  let res_score = (dict_get(_tripple, "resonance_score") ?? 0)
  return {
    "merged_response": merged,
    "individual_results": results,
    "models_queried": len(models),
    "models_responded": len(ok_results),
    "total_time_ms": total_time,
    "task_type": task,
    "trit": trit,
    "ok": true,
    "tripple_resonance": res_score,
    "tripple_prime": prime_locked
  }
}

fn handle_cluster_query(req) {
  let prompt = (dict_get(req, "prompt") ?? (dict_get(req, "q") ?? ""))
  if3 (len(prompt) == 0) { return {"error": "Missing prompt"} }
  let channel = (dict_get(req, "channel") ?? "")
  let regime = (dict_get(req, "regime") ?? "")

  // Tripple: outer loop before query
  _tripple = tripple_outer(_tripple)
  let t0 = time()

  try3 {
    let result = hive_cluster_query(prompt, channel, regime)
    let trit = response_trit(result)
    record_query(trit)
    result = dict_set(result, "trit", trit)

    // Tripple: ripple on success
    let latency = time() - t0
    let r_trit = -1
    if3 (trit >= 0) { r_trit = 1 }
    _tripple = tripple_ripple(_tripple, "ollama", r_trit, latency)
    _tripple = tripple_resonance_check(_tripple)
    return result
  } fail {
    record_query(T_FALSE)
    // Tripple: ripple on failure
    _tripple = tripple_ripple(_tripple, "ollama", -1, time() - t0)
    return {"error": "cluster_query_failed", "trit": T_FALSE, "ok": false}
  }
}

