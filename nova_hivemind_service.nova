// -- /hive/model-to-model --
// Direct model-to-model conversation through ternary channel
fn handle_model_to_model(req) {
  let sender = (dict_get(req, "sender") ?? "system")
  let receiver = (dict_get(req, "receiver") ?? "")
  let prompt = (dict_get(req, "prompt") ?? "")
  let channel = (dict_get(req, "channel") ?? "REASON")
  if3 (len(receiver) == 0) { return {"error": "Missing receiver model"} }
  if3 (len(prompt) == 0) { return {"error": "Missing prompt"} }
  // Build system prompt for model-to-model communication
  let system = "You are model '" + sender + "' communicating with model '" + receiver + "' through ternary channel " + channel + ". Respond concisely and technically."
  // Determine if receiver is cloud or local
  let is_cloud = contains(receiver, "/")
  if3 (is_cloud == false) { is_cloud = starts_with(receiver, "gpt") }
  if3 (is_cloud == false) { is_cloud = starts_with(receiver, "claude") }
  let result = {}
  if3 (is_cloud) { result = hive_query_cloud(receiver, prompt, system)
  }
  if3 (is_cloud == false) { result = hive_query_model(receiver, prompt, system)
  }
  result = dict_set(result, "sender", sender)
  result = dict_set(result, "receiver", receiver)
  result = dict_set(result, "channel", channel)
  let trit = response_trit(result)
  record_query(trit)
  result = dict_set(result, "trit", trit)
  return result
}

// -- /hive/discuss --
// Multi-round discussion between models. Each model sees previous responses.
fn handle_discuss(req) {
  let topic = (dict_get(req, "topic") ?? "")
  let model_ids = (dict_get(req, "models") ?? [])
  let rounds = (dict_get(req, "rounds") ?? 3)
  let channel = (dict_get(req, "channel") ?? "REASON")
  if3 (len(topic) == 0) { return {"error": "Missing topic"} }
  if3 (rounds > H7) { rounds = H7 }
  // Auto-select models if none specified
  if3 (len(model_ids) == 0) { ch_data = (dict_get(cluster_channels, upper(channel)) ?? {"local": [], "cloud": []})
    let local_pool = (dict_get(ch_data, "local") ?? [])
    let cloud_pool = (dict_get(ch_data, "cloud") ?? [])
    // Pick up to 3 models from local + cloud
    let mi = 0
    while3 (mi < len(local_pool)) {
      if3 (len(model_ids) < H3) {
        model_ids = append(model_ids, local_pool[mi])
      }
      mi = mi + 1
    }
    let ci = 0
    while3 (ci < len(cloud_pool)) {
      if3 (len(model_ids) < H3) {
        model_ids = append(model_ids, cloud_pool[ci])
      }
      ci = ci + 1
    }
  }
  if3 (len(model_ids) == 0) { return {"error": "No models available for discussion"} }
  // Run multi-round discussion
  let transcript = []
  let context = "TOPIC: " + topic + "\nChannel: " + channel + "\n\n"
  let round_num = 1
  while3 (round_num <= rounds) {
    let midx = 0
    while3 (midx < len(model_ids)) {
      let mid = model_ids[midx]
      let round_prompt = context + "Round " + str(round_num) + "/" + str(rounds) + ". You are '" + mid + "'. Build on previous responses. Be concise (2-3 sentences)."
      // Determine if cloud or local
      let is_cloud = contains(mid, "/")
      if3 (is_cloud == false) { is_cloud = starts_with(mid, "gpt") }
      if3 (is_cloud == false) { is_cloud = starts_with(mid, "claude") }
      let result = {}
      if3 (is_cloud) { result = hive_query_cloud(mid, round_prompt, "")
      }
      if3 (is_cloud == false) { result = hive_query_model(mid, round_prompt, "")
      }
      let response = (dict_get(result, "response") ?? "")
      let entry = {
        "round": round_num,
        "model": mid,
        "response": response,
        "time_ms": (dict_get(result, "time_ms") ?? 0),
        "ok": (dict_get(result, "ok") ?? false)
      }
      transcript = append(transcript, entry)
      // Accumulate context for next model
      context = context + "[" + mid + " R" + str(round_num) + "]: " + response + "\n\n"
      midx = midx + 1
    }
    round_num = round_num + 1
  }
  return {
    "topic": topic,
    "channel": channel,
    "models": model_ids,
    "rounds": rounds,
    "transcript": transcript,
    "total_entries": len(transcript),
    "ok": true
  }
}

// -- /hive/agent/plan --
// AI-driven task planning: takes a goal, returns action sequence
fn handle_agent_plan(req) {
  let goal = (dict_get(req, "goal") ?? (dict_get(req, "prompt") ?? ""))
  let screen_state = (dict_get(req, "screen_state") ?? {})
  let ctx = (dict_get(req, "context") ?? {})
  if3 (len(goal) == 0) { return {"error": "Missing goal"} }
  let screen_str = json_encode(screen_state)
  let ctx_str = json_encode(ctx)
  let plan_prompt = "You are a desktop automation agent. Plan steps for:\n\nGOAL: " + goal + "\n\nSCREEN: " + slice(screen_str, 0, min(1500, len(screen_str))) + "\n\nCONTEXT: " + slice(ctx_str, 0, min(500, len(ctx_str))) + "\n\nOutput ONLY a JSON array of actions. Each action has:\n- action: focus|click|type|key|hotkey|scroll|drag|doubleclick|launch|close|minimize|maximize|restore|wait|screenshot\n- For coords: use rx,ry,window (relative 0-1) or x,y (absolute)\n- For type: text field. For key: key field. For hotkey: keys array\n- For launch: name, exe. For wait: ms."
  try3 {
    let result = hive_cluster_query(plan_prompt, "AGENT", "")
    let trit = response_trit(result)
    record_query(trit)
    let response_text = (dict_get(result, "response") ?? "")
    let actions = []
    if3 (len(response_text) > 0) {
      try3 {
        let parsed = json_decode(trim(response_text))
        if3 (type_of(parsed) == "list") {
          actions = parsed
        }
      } fail {
        try3 {
          let parts = split(trim(response_text), "[")
          if3 (len(parts) > 1) {
            let end_parts = split(parts[1], "]")
            if3 (len(end_parts) > 0) {
              actions = json_decode("[" + end_parts[0] + "]")
            }
          }
        } fail {
          // Could not parse actions
        }
      }
    }
    let action_trit = T_TRUE
    if3 (len(actions) == 0) { action_trit = T_MAYBE }
    return {
      "ok": true,
      "trit": action_trit,
      "actions": actions,
      "action_count": len(actions),
      "goal": goal,
      "raw_response": response_text
    }
  } fail {
    return {"ok": false, "trit": T_FALSE, "error": "agent_plan_failed"}
  }
}

// -- /hive/agent/dispatch --
}
fn handle_agent_dispatch(req) {
  let goal = (dict_get(req, "goal") ?? "")
  let agent_id = (dict_get(req, "agent_id") ?? "hivemind-swarm")
  let subtasks = (dict_get(req, "subtasks") ?? [])
  if3 (len(goal) == 0) {
    if3 (len(subtasks) == 0) {
      return {"error": "Missing goal or subtasks"}
    }
  }
  let bridge_url = "http://127.0.0.1:9887"
  let results = []
  // Create goals list from subtasks or single goal
  let goals = subtasks
  if3 (len(goals) == 0) { goals = [goal]
  }
  let gi = 0
  while3 (gi < len(goals)) {
    let g = goals[gi]
    let task_goal = g
    let task_priority = 0
    let task_context = {}
    if3 (type_of(g) == "dict") { task_goal = (dict_get(g, "goal") ?? "")
      let task_priority = (dict_get(g, "priority") ?? 0)
      let task_context = (dict_get(g, "context") ?? {})
    }
    try3 {
      let task_payload = json_encode({
        "goal": task_goal,
        "agent_id": agent_id,
        "priority": task_priority,
        "context": task_context
      })
      let resp = http_post(bridge_url + "/task/create", task_payload)
      let resp_data = json_decode(resp)
      results = append(results, resp_data)
    } fail {
      results = append(results, {"ok": false, "error": "task_create_failed"})
    }
    gi = gi + 1
  }
  return {
    "ok": true,
    "trit": T_TRUE,
    "tasks_created": len(results),
    "results": results
  }
}

// -- /hive/agent/swarm --
// Launch multiple agent workers for parallel task execution
fn handle_agent_swarm(req) {
  let workers = min((dict_get(req, "workers") ?? H3), H7)
  let goals = (dict_get(req, "goals") ?? [])
  let agent_prefix = (dict_get(req, "agent_id") ?? "swarm")
  if3 (len(goals) == 0) { return {"error": "Missing goals array"} }
  let bridge_url = "http://127.0.0.1:9887"
  let tasks = []
  let task_ids = []
  let gi = 0
  while3 (gi < len(goals)) {
    let g = goals[gi]
    let task_goal = g
    let task_priority = gi
    let task_context = {}
    if3 (type_of(g) == "dict") { task_goal = (dict_get(g, "goal") ?? "")
      let task_priority = (dict_get(g, "priority") ?? gi)
      let task_context = (dict_get(g, "context") ?? {})
    }
    // Assign worker ID via modulo: gi - (gi / workers) * workers
    let div_result = int(gi / workers)
    let worker_num = gi - div_result * workers
    let worker_id = agent_prefix + "-" + str(worker_num)
    try3 {
      let task_payload = json_encode({
        "goal": task_goal,
        "agent_id": worker_id,
        "priority": task_priority,
        "context": task_context
      })
      let resp = http_post(bridge_url + "/task/create", task_payload)
      let resp_data = json_decode(resp)
      tasks = append(tasks, resp_data)
      if3 ((dict_get(resp_data, "ok") ?? false) == true) {
        let task_obj = (dict_get(resp_data, "task") ?? {})
        task_ids = append(task_ids, (dict_get(task_obj, "id") ?? ""))
      }
    } fail {
      tasks = append(tasks, {"ok": false, "error": "swarm_task_create_failed"})
    }
    gi = gi + 1
  }
  return {
    "ok": true,
    "trit": T_TRUE,
    "workers": workers,
    "tasks_created": len(tasks),
    "tasks": task_ids,
    "hint": "Start " + str(workers) + " agent runners: python nova_agent_runner.py --workers " + str(workers)
  }
}

// -- /hive/strategy/plan --
// Strategic lookahead: forward+backward reasoning via cluster queries
fn handle_strategy_plan(req) {
  let body = try3 { json_decode(req["body"]) } fail { req }
  let goal = (dict_get(body, "goal") ?? (dict_get(body, "prompt") ?? ""))
  let ctx = (dict_get(body, "context") ?? "")
  let depth = min((dict_get(body, "depth") ?? 5), 5)
  let regime = (dict_get(body, "regime") ?? "transitional")
  if3 (len(goal) == 0) { return {"error": "goal required"} }
  // Determine branch factor from regime (3-5-7-13 harmonic)
  let branch_factor = H7
  if3 (regime == "laminar") { branch_factor = H3 }
  if3 (regime == "transitional") { branch_factor = H7 }
  if3 (regime == "turbulent") { branch_factor = H13 }
  if3 (regime == "chaotic") { branch_factor = RE_LAMINAR }
  // Use registry_get_swarm + hive_scatter (same as working /hive/query path)
  let model_count = branch_factor
  if3 (model_count > 5) { model_count = 5 }
  let models = registry_get_swarm("reasoning", model_count)
  if3 (len(models) == 0) { models = registry_get_swarm("general", 3) }
  let sys_prompt = "You are a strategic AI planner. Think step by step."
  // Layer 1: SCATTER (Forward) -- generate forward paths
  let forward_prompt = "Given this goal: " + goal + " Context: " + ctx + " Generate " + str(branch_factor) + " possible next steps or approaches. Output as a numbered list. Be concise."
  let fwd_scatter = hive_scatter(models, forward_prompt, sys_prompt, MERGE_TIMEOUT, H3)
  let fwd_results = (dict_get(fwd_scatter, "results") ?? [])
  let fwd_ok = []
  let fi = 0
  while3 (fi < len(fwd_results)) {
    if3 ((dict_get(fwd_results[fi], "ok") ?? false) == true) {
      if3 (len((dict_get(fwd_results[fi], "response") ?? "")) > 0) {
        fwd_ok = append(fwd_ok, fwd_results[fi])
      }
    }
    fi = fi + 1
  }
  let forward_text = hive_merge_responses(fwd_ok, forward_prompt)
  // Layer 2: PRESSURE (Backward) -- work backwards from desired outcome
  let backward_prompt = "Working BACKWARDS from achieved goal: " + goal + " Context: " + ctx + " What " + str(branch_factor) + " steps must have been completed just before success? Work backwards. Output as a numbered list."
  let bwd_scatter = hive_scatter(models, backward_prompt, sys_prompt, MERGE_TIMEOUT, H3)
  let bwd_results = (dict_get(bwd_scatter, "results") ?? [])
  let bwd_ok = []
  let bi = 0
  while3 (bi < len(bwd_results)) {
    if3 ((dict_get(bwd_results[bi], "ok") ?? false) == true) {
      if3 (len((dict_get(bwd_results[bi], "response") ?? "")) > 0) {
        bwd_ok = append(bwd_ok, bwd_results[bi])
      }
    }
    bi = bi + 1
  }
  let backward_text = hive_merge_responses(bwd_ok, backward_prompt)
  // Layer 3: DIFFUSION (Merge) -- synthesize forward and backward
  let merge_prompt = "Merge these forward and backward plans into a coherent strategy. FORWARD PATHS: " + forward_text + " BACKWARD PATHS: " + backward_text + " GOAL: " + goal + " Output a unified step-by-step plan with convergence points."
  let mrg_scatter = hive_scatter(models, merge_prompt, sys_prompt, MERGE_TIMEOUT, H3)
  let mrg_results = (dict_get(mrg_scatter, "results") ?? [])
  let mrg_ok = []
  let mi = 0
  while3 (mi < len(mrg_results)) {
    if3 ((dict_get(mrg_results[mi], "ok") ?? false) == true) {
      if3 (len((dict_get(mrg_results[mi], "response") ?? "")) > 0) {
        mrg_ok = append(mrg_ok, mrg_results[mi])
      }
    }
    mi = mi + 1
  }
  let merged_plan = hive_merge_responses(mrg_ok, merge_prompt)
  // Layer 4: MINESWEEPER (Risk Sweep) -- identify hidden dangers and probability
  // Chess=tactics, Go=territory, Minesweeper=risk under uncertainty
  // Each step in the plan is a "cell" -- sweep for hidden mines (risks)
  let mine_prompt = "You are a risk analyst using minesweeper logic. For this plan: " + merged_plan + " GOAL: " + goal + " Analyze each step like a minesweeper grid: 1) Flag MINES: hidden risks, dependencies, failure points that could blow up. 2) Count ADJACENTS: for each risk, how many plan steps does it affect (1-8 like minesweeper numbers). 3) Mark SAFE ZONES: steps with zero adjacent risks. 4) Identify PROBABILITY CLUSTERS: areas where multiple risks overlap. 5) Suggest PROBE ORDER: safest steps to execute first to reveal information. Output as: MINES: [list], ADJACENTS: [step: count], SAFE_FIRST: [steps], DANGER_ZONES: [clusters]."
  let mine_scatter = hive_scatter(models, mine_prompt, sys_prompt, MERGE_TIMEOUT, H3)
  let mine_results = (dict_get(mine_scatter, "results") ?? [])
  let mine_ok = []
  let mni = 0
  while3 (mni < len(mine_results)) {
    if3 ((dict_get(mine_results[mni], "ok") ?? false) == true) {
      if3 (len((dict_get(mine_results[mni], "response") ?? "")) > 0) {
        mine_ok = append(mine_ok, mine_results[mni])
      }
    }
    mni = mni + 1
  }
  let minesweeper_text = hive_merge_responses(mine_ok, mine_prompt)
  let trit = 1
  if3 (len(merged_plan) < 10) { trit = -1 }
  record_query(trit)
  let total_models = len(fwd_ok) + len(bwd_ok) + len(mrg_ok) + len(mine_ok)
  return {
    "ok": true,
    "trit": trit,
    "goal": goal,
    "regime": regime,
    "depth": depth,
    "branch_factor": branch_factor,
    "layers": {
      "scatter_forward": forward_text,
      "pressure_backward": backward_text,
      "diffusion_merged": merged_plan,
      "minesweeper_risk": minesweeper_text
    },
    "plan": merged_plan,
    "risk_sweep": minesweeper_text,
    "models_used": total_models
  }
}

// ============================================================

// Section 10b: Tripple Module Ripple Injection
// ============================================================

// POST /api/v1/modulation/ripple — receives ripple signal from Tripple Module
fn handle_tripple_ripple(req) {
  let body = try3 { json_decode(req["body"]) } fail { req }
  let provider = (dict_get(body, "provider") ?? "ollama")
  let trit = (dict_get(body, "trit") ?? 0)
  let latency_ms = (dict_get(body, "latency_ms") ?? 100)
  let prime_locked = (dict_get(body, "prime_locked") ?? false)
  if3 (provider == null) { provider = "ollama" }
  if3 (trit == null) { trit = 0 }
  if3 (latency_ms == null) { latency_ms = 100 }

  // Feed ripple into local _tripple state too
  _tripple = tripple_ripple(_tripple, provider, trit, latency_ms)
  _tripple = tripple_resonance_check(_tripple)

  // Map provider success to channel SNR boost
  let channels = dict_keys(mod_channel_snr)
  let updated = 0
  let i = 0
  while3 i < len(channels) {
    let ch = channels[i]
    let old_snr = dict_get(mod_channel_snr, ch)

    if3 trit == 1 { let boost = (1000 - 333) * old_snr + 333 * 900
      let new_snr = boost / 1000
      mod_channel_snr = dict_set(mod_channel_snr, ch, new_snr)
      updated = updated + 1
    }
    if3 trit == -1 { let decay = (1000 - 200) * old_snr + 200 * 100
      let new_snr = decay / 1000
      mod_channel_snr = dict_set(mod_channel_snr, ch, new_snr)
      updated = updated + 1
    }

    i = i + 1
  }

  // If prime state is locked, auto-upgrade modulation to max
  let is_prime = (dict_get(_tripple, "prime_locked") ?? false)
  if3 is_prime == true { j = 0
    while3 j < len(channels) {
      let ch = channels[j]
      let cur = dict_get(mod_channel_snr, ch)
      if3 cur < 900 { mod_channel_snr = dict_set(mod_channel_snr, ch, 900)
      }
      j = j + 1
    }
  }

  let res_score = (dict_get(_tripple, "resonance_score") ?? 0)
  let resp = make_ok({"updated_channels": updated, "provider": provider, "trit": trit, "prime_locked": is_prime, "resonance_score": res_score})
  return resp
}

// ============================================================

// Section 10c: Tripple Resonance Sensor Endpoints (Hivemind)
// ============================================================

fn handle_hive_tripple_status(req) {
  _tripple = tripple_outer(_tripple)
  _tripple = tripple_resonance_check(_tripple)
  let status = tripple_status(_tripple)
  let result = {"ok": true, "trit": 1, "service": "hivemind"}
  result = dict_set(result, "resonance_score", (dict_get(status, "resonance_score") ?? 0))
  result = dict_set(result, "regime", (dict_get(status, "regime") ?? "laminar"))
  result = dict_set(result, "prime_locked", (dict_get(status, "prime_locked") ?? false))
  result = dict_set(result, "hyper_locked", (dict_get(status, "hyper_locked") ?? false))
  result = dict_set(result, "total_ripples", (dict_get(status, "total_ripples") ?? 0))
  result = dict_set(result, "providers", (dict_get(status, "providers") ?? {}))
  result = dict_set(result, "formula", (dict_get(status, "formula") ?? {}))
  return result
}

fn handle_hive_tripple_wave(req) {
  let wave = tripple_standing_wave(_tripple)
  return {"ok": true, "trit": 1, "wave": wave}
}

fn handle_hive_tripple_mirror(req) {
  let mirror = tripple_mirror_status(_tripple)
  return {"ok": true, "trit": 1, "mirror": mirror}
}

fn handle_hive_tripple_ripple_post(req) {
  let body = try3 { json_decode(req["body"]) } fail { req }
  let provider = (dict_get(body, "provider") ?? "ollama")
  let trit = (dict_get(body, "trit") ?? 1)
  let latency = (dict_get(body, "latency_ms") ?? 100)
  if3 (provider == null) { provider = "ollama" }
  if3 (trit == null) { trit = 1 }
  if3 (latency == null) { latency = 100 }
  _tripple = tripple_ripple(_tripple, provider, trit, latency)
  _tripple = tripple_resonance_check(_tripple)
  let score = (dict_get(_tripple, "resonance_score") ?? 0)
  return {"ok": true, "trit": 1, "provider": provider, "ripple_trit": trit, "resonance_score": score}
}

// GET /api/v1/modulation/status — returns full modulation state with per-channel schemes
fn handle_tripple_modulation_status(req) {
  let resp = {}
  resp = dict_set(resp, "ok", true)
  resp = dict_set(resp, "trit", 1)
  resp = dict_set(resp, "channel_snr", mod_channel_snr)
  resp = dict_set(resp, "channel_ber", mod_channel_ber)
  // Get current scheme for each channel
  let schemes = {}
  let channels = dict_keys(mod_channel_snr)
  let i = 0
  while3 i < len(channels) {
    let ch = channels[i]
    let snr = dict_get(mod_channel_snr, ch)
    // Determine which scheme this SNR maps to
    let scheme = "BPSK"
    if3 (snr >= 900) { scheme = "1024QAM" }
    if3 (snr >= 800) { if3 (snr < 900) { scheme = "256QAM" } }
    if3 (snr >= 650) { if3 (snr < 800) { scheme = "64QAM" } }
    if3 (snr >= 500) { if3 (snr < 650) { scheme = "16QAM" } }
    if3 (snr >= 350) { if3 (snr < 500) { scheme = "8PSK" } }
    if3 (snr >= 200) { if3 (snr < 350) { scheme = "QPSK" } }
    schemes = dict_set(schemes, ch, scheme)
    i = i + 1
  }
  resp = dict_set(resp, "modulation_schemes", schemes)
  return resp
}

// ============================================================
// Section 10b: Microsoft Engine Proxy (Win32 System Tools)
// ============================================================
// Routes system tool queries to Microsoft Engine (:9851)
// Provides 7 Win32 tools: windows, registry, process, system, theme, clipboard, notify

fn handle_microsoft_proxy(req) {
  let body = try3 { json_decode(req["body"]) } fail { {} }
  let tool = (dict_get(body, "tool") ?? "system")
  let valid_tools = ["windows", "registry", "process", "system", "theme", "clipboard", "notify"]
  let found = 0
  let i = 0
  while3 i < len(valid_tools) {
    if3 valid_tools[i] == tool { found = 1 }
    i = i + 1
  }
  if3 found == 0 {
    return {"ok": false, "error": "invalid_tool", "valid": valid_tools}
  }
  let url = "http://127.0.0.1:9851/novaxcore/" + tool
  let result = try3 { http_post(url, json_encode(body)) } fail { {"ok": false, "error": "novaxcore_engine_unreachable"} }
  let parsed = try3 { json_decode(result) } fail { result }
  // Inject ripple for successful system tool use
  let is_ok = (dict_get(parsed, "ok") ?? false)
  if3 is_ok {
    let ripple = {"source": "novaxcore_engine", "tool": tool, "trit": 1}
    try3 { http_post("http://127.0.0.1:9881/hive/tripple/ripple", json_encode(ripple)) } fail { 0 }
  }
  return parsed
}

fn handle_microsoft_status(req) {
  let result = try3 { http_get("http://127.0.0.1:9851/status") } fail { "{\"error\":\"unreachable\"}" }
  let parsed = try3 { json_decode(result) } fail { {"error": "parse_failed"} }
  return parsed
}

