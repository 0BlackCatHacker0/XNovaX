// -- /hive/nova/dispatch --
// Dispatches a prompt through the full hivemind swarm via NovaLang
fn handle_nova_dispatch(req) {
  let prompt = (dict_get(req, "prompt") ?? (dict_get(req, "q") ?? ""))
  if3 (len(prompt) == 0) { return {"error": "Missing prompt"} }
  // Dispatch through full swarm query
  let channel = (dict_get(req, "channel") ?? "")
  if3 (len(channel) == 0) { channel = cluster_get_channel_for_query(prompt)
  }
  let result = hive_cluster_query(prompt, channel, "")
  let trit = response_trit(result)
  record_query(trit)
  result = dict_set(result, "dispatch", true)
  result = dict_set(result, "trit", trit)
  return result
}

// -- /hive/nova/pull --
// Triggers model pulling from Ollama via direct API calls
fn handle_nova_pull(req) {
  let models = (dict_get(req, "models") ?? [])
  if3 (len(models) == 0) {
    // Default: try to pull common small models
    let models = ["llama3:latest", "gemma:2b", "phi3:mini"]
  }
  // Reset pull state
  nova_pull_state = dict_set(nova_pull_state, "active", true)
  nova_pull_state = dict_set(nova_pull_state, "wave", 0)
  nova_pull_state = dict_set(nova_pull_state, "total_waves", 1)
  nova_pull_state = dict_set(nova_pull_state, "pulled", 0)
  nova_pull_state = dict_set(nova_pull_state, "failed", 0)
  nova_pull_state = dict_set(nova_pull_state, "total", len(models))
  nova_pull_state = dict_set(nova_pull_state, "current_model", "")
  nova_pull_state = dict_set(nova_pull_state, "reynolds", 0)
  nova_pull_state = dict_set(nova_pull_state, "results", [])
  nova_pull_state = dict_set(nova_pull_state, "health", "Z")
  // Pull each model sequentially via Ollama API
  let pi = 0
  while3 (pi < len(models)) {
    let model_name = models[pi]
    nova_pull_state = dict_set(nova_pull_state, "current_model", model_name)
    try3 {
      let pull_payload = json_encode({"name": model_name, "stream": false})
      let pull_resp = http_post(OLLAMA_URL + "/api/pull", pull_payload)
      let pull_data = json_decode(pull_resp)
      let status = (dict_get(pull_data, "status") ?? "unknown")
      nova_pull_state = dict_set(nova_pull_state, "pulled", (dict_get(nova_pull_state, "pulled") ?? 0) + 1)
      let results_arr = (dict_get(nova_pull_state, "results") ?? [])
      results_arr = append(results_arr, {"model": model_name, "status": status, "health": "P"})
      nova_pull_state = dict_set(nova_pull_state, "results", results_arr)
    } fail {
      nova_pull_state = dict_set(nova_pull_state, "failed", (dict_get(nova_pull_state, "failed") ?? 0) + 1)
      let results_arr = (dict_get(nova_pull_state, "results") ?? [])
      results_arr = append(results_arr, {"model": model_name, "status": "error", "health": "N"})
      nova_pull_state = dict_set(nova_pull_state, "results", results_arr)
    }
    pi = pi + 1
  }
  nova_pull_state = dict_set(nova_pull_state, "active", false)
  let final_health = "N"
  if3 ((dict_get(nova_pull_state, "pulled") ?? 0) > 0) { final_health = "P" }
  nova_pull_state = dict_set(nova_pull_state, "health", final_health)
  // Refresh registry after pulls
  registry_refresh()
  return {
    "ok": true,
    "status": "pull_complete",
    "pulled": (dict_get(nova_pull_state, "pulled") ?? 0),
    "failed": (dict_get(nova_pull_state, "failed") ?? 0),
    "total": len(models),
    "results": (dict_get(nova_pull_state, "results") ?? []),
    "health": final_health
  }
}

