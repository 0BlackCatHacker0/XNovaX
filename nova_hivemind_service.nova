  let tforge_ok = false
  let tindex_ok = false
  let tcache_stats = {}
  let tindex_stats = {}
  try3 {
    let tc_resp = http_get(TTOOLS_URL + "/api/tcache/status")
    let tcache_stats = json_decode(tc_resp)
    tcache_ok = true
  } fail {
    tcache_ok = false
  }
  try3 {
