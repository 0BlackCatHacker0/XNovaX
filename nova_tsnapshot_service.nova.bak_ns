print("  GET  /health")
print("  GET  /tsnapshot/list")
print("  GET  /tsnapshot/latest")
print("  GET  /tsnapshot/get?name=<snap-name>")
print("  POST /tsnapshot/capture")
print("  POST /tsnapshot/compare")
print("  POST /tsnapshot/restore")
print("  POST /tsnapshot/delete")
print("[TSnapshot] Harmonics: H3=" + str(H3) + " H5=" + str(H5) + " H7=" + str(H7) + " H13=" + str(H13))
print("[TSnapshot] BLOCK=" + str(BLOCK) + " MAX_SNAPSHOTS=" + str(MAX_SNAPSHOTS))
print("[TSnapshot] T_TRUE=" + str(T_TRUE) + " T_MAYBE=" + str(T_MAYBE) + " T_FALSE=" + str(T_FALSE))
print("[TSnapshot] Ready -- http://127.0.0.1:" + str(PORT) + "/health")

tstart(server)
