// ═══════════════════════════════════════════════════════════════════
// TRIPPLE MODULE — N-S Frequency-Modulated API Provider Resonance Lock
// ═══════════════════════════════════════════════════════════════════
// Three nested frequency loops at harmonic intervals (H3³/H5³/H7³)
// create a ripple that propagates through the provider network and
// locks into a standing wave pattern → "truly prime state"
//
// Physics basis: Resolvent analysis (2024) — N-S frequency domain
// decomposition. Each provider = Helmholtz resonator tuned to its
// optimal operating frequency. Critical coupling = broadband coverage.
//
// Harmonic constants from VM globals: H3=3, H5=5, H7=7, H13=13
// ═══════════════════════════════════════════════════════════════════

import3("C:/NovaX/lib/nova_ns_core.nova")
import3("C:/NovaX/lib/nova_stdlib.nova")

// ── Module Constants ──────────────────────────────────────────────
let TRIPPLE_VERSION = "1.0.0"

// Frequency loop intervals (harmonic cubes)
let FREQ_OUTER  = 343    // H7³ = 343ms — regime detection
let FREQ_MIDDLE = 125    // H5³ = 125ms — provider tuning
let FREQ_INNER  = 27     // H3³ = 27ms  — micro-burst lock

// Full resonance cycle
let RESONANCE_CYCLE = 2187  // 3⁷ = 2187ms

// Resonance lock threshold
let RESONANCE_THRESHOLD = 85  // score out of 100 (0.85 scaled to int)
let PRIME_LOCK_CYCLES = 13    // H13 consecutive cycles to lock

// EMA smoothing constants
let ALPHA_SUCCESS = 333   // 1/H3 * 1000 = 333 (success amplification)
let BETA_ERROR    = 200   // 1/H5 * 1000 = 200 (error dampening)

// Regime modifiers (scaled by 1000 to avoid float issues in NovaLang)
let REGIME_MOD_LAMINAR      = 1000  // 1.000
let REGIME_MOD_TRANSITIONAL = 714   // H5/H7 = 0.714
let REGIME_MOD_TURBULENT    = 429   // H3/H7 = 0.429
let REGIME_MOD_CHAOTIC      = 77    // 1/H13 = 0.077

// Provider tier base frequencies (scaled by 1000)
let FREQ_BASE_LOCAL    = 1000  // 1.0 Hz — fast, always available
let FREQ_BASE_CLOUD    = 500   // 0.5 Hz — medium, auth-gated
let FREQ_BASE_FALLBACK = 100   // 0.1 Hz — slow, last resort

// Standing wave thresholds
let CONSTRUCTIVE_THRESHOLD = 7000   // H7 * 1000
let DESTRUCTIVE_THRESHOLD  = 143    // 1/H7 * 1000

// ── Superharmonic / Hyper-Prime Constants ──────────────────────
let HYPER_FREQ = 15              // H3×H5 = 15ms — overtone micro-burst
let HYPER_ABILITY_THRESHOLD = 5  // Minimum unique abilities for hyper-prime
let HYPER_LOCK_CYCLES = 7        // H7 consecutive hyper checks to lock
let ABILITY_AMP_BASE = 1000      // Base amplifier (1.0 scaled)
let ABILITY_AMP_PER = 30         // Per-ability: H3 × 10 = 30

// ── Hybrid Resonance Constants (N-S × Ternary × Helmholtz) ────────
// Grounded in resolvent analysis, ternary entropy, and coupled resonators
let SIGMA_THRESHOLD = 100    // Resolvent half-gain point: σ/(σ+100) = 0.5 at σ=100
let KAPPA_COUPLING  = 125    // Helmholtz coupling coefficient (= FREQ_MIDDLE)
let KAPPA_SCALED    = 12     // KAPPA/10 for overflow-safe frequency² math
let KAPPA_SQ        = 144    // (KAPPA_SCALED)² pre-computed

// ── State Initialization ──────────────────────────────────────────

fn tripple_init() {
  let state = {}
  state = dict_set(state, "providers", {})
  state = dict_set(state, "regime", "laminar")
  state = dict_set(state, "regime_trit", 1)
  state = dict_set(state, "resonance_score", 0)
  state = dict_set(state, "resonance_history", [])
  state = dict_set(state, "prime_locked", 0)
  state = dict_set(state, "prime_lock_count", 0)
  state = dict_set(state, "total_ripples", 0)
  state = dict_set(state, "total_locks", 0)
  state = dict_set(state, "last_outer", 0)
  state = dict_set(state, "last_middle", 0)
  state = dict_set(state, "last_inner", 0)
  state = dict_set(state, "wave_pattern", [])
  state = dict_set(state, "init_time", time())
  // Hyper-prime state
  state = dict_set(state, "hyper_locked", 0)
  state = dict_set(state, "hyper_lock_count", 0)
  state = dict_set(state, "hyper_total_locks", 0)
  state = dict_set(state, "ability_amplifier", 1000)
  state = dict_set(state, "unique_abilities", 0)
  state = dict_set(state, "base_score", 0)
  return state
}

fn tripple_init_provider(name, tier) {
  let p = {}
  p = dict_set(p, "name", name)
  p = dict_set(p, "tier", tier)

  // Base frequency from tier
  let base = FREQ_BASE_CLOUD
  if3 tier == "local" { base = FREQ_BASE_LOCAL
  }
  if3 tier == "fallback" { base = FREQ_BASE_FALLBACK
  }

  p = dict_set(p, "base_freq", base)
  p = dict_set(p, "current_freq", base)
  p = dict_set(p, "success_rate", 500)
  p = dict_set(p, "error_rate", 0)
  p = dict_set(p, "total_queries", 0)
  p = dict_set(p, "total_success", 0)
  p = dict_set(p, "total_errors", 0)
  p = dict_set(p, "avg_latency_ms", 1000)
  p = dict_set(p, "last_trit", 0)
  p = dict_set(p, "in_phase", 0)
  p = dict_set(p, "phase_count", 0)
  p = dict_set(p, "last_ripple_time", 0)
  return p
}

// ── Regime Modifier Lookup ────────────────────────────────────────

fn _regime_modifier(regime) {
  if3 regime == "laminar" {
    return REGIME_MOD_LAMINAR
  }
  if3 regime == "transitional" {
    return REGIME_MOD_TRANSITIONAL
  }
  if3 regime == "turbulent" {
    return REGIME_MOD_TURBULENT
  }
  return REGIME_MOD_CHAOTIC
}

// -- Scope-safe helpers (avoid let-inside-if3 scoping bug) --------

fn _maybe_append(list, item, condition) {
  if3 condition == 1 {
    return append(list, item)
  }
  return list
}

fn _pick_val(condition, yes_val, no_val) {
  if3 condition {
    return yes_val
  }
  return no_val
}

fn _increment_if(val, condition) {
  if3 condition {
    return val + 1
  }
  return val
}

fn _clamp_min(val, minimum) {
  if3 val < minimum {
    return minimum
  }
  return val
}

fn _clamp(val, minimum, maximum) {
  if3 val < minimum {
    return minimum
  }
  if3 val > maximum {
    return maximum
  }
  return val
}

// -- Phase update helper (avoids nested if3 scope bugs) -----------

fn _update_phase(prov, trit, freq, base) {
  if3 trit == -1 {
    prov = dict_set(prov, "phase_count", 0)
    prov = dict_set(prov, "in_phase", 0)
    return prov
  }
  if3 freq < base {
    return prov
  }
  let pc = dict_get(prov, "phase_count") + 1
  prov = dict_set(prov, "phase_count", pc)
  prov = dict_set(prov, "in_phase", 1)
  return prov
}

// -- Prime lock helper (avoids deeply nested if3 scope bugs) ------

fn _update_prime_lock(state, score, threshold, lock_cycles) {
  let was_locked = dict_get(state, "prime_locked")
  // PERMANENT LOCK: once prime_locked=1, it stays locked forever
  // Only admin API can unlock. Score drops do NOT break the lock.
  if3 was_locked == 1 { return state }
  if3 score < threshold {
    state = dict_set(state, "prime_lock_count", 0)
    return state
  }
  let lc = dict_get(state, "prime_lock_count") + 1
  state = dict_set(state, "prime_lock_count", lc)
  if3 lc < lock_cycles {
    return state
  }
  state = dict_set(state, "prime_locked", 1)
  if3 was_locked == 0 {
    let tl = dict_get(state, "total_locks") + 1
    state = dict_set(state, "total_locks", tl)
  }
  return state
}

// -- Hyper-prime lock helper --------------------------------------

fn _update_hyper_lock(state, score, prime_locked, unique_abs) {
  // PERMANENT LOCK: once hyper_locked=1, it stays locked forever
  let was_hyper = dict_get(state, "hyper_locked") ?? 0
  if3 was_hyper == 1 { return state }
  if3 prime_locked != 1 {
    state = dict_set(state, "hyper_lock_count", 0)
    return state
  }
  if3 unique_abs < HYPER_ABILITY_THRESHOLD {
    return state
  }
  if3 score <= 100 {
    state = dict_set(state, "hyper_lock_count", 0)
    return state
  }
  let hc = (dict_get(state, "hyper_lock_count") ?? 0) + 1
  state = dict_set(state, "hyper_lock_count", hc)
  if3 hc < HYPER_LOCK_CYCLES {
    return state
  }
  state = dict_set(state, "hyper_locked", 1)
  if3 was_hyper == 0 {
    let ht = (dict_get(state, "hyper_total_locks") ?? 0) + 1
    state = dict_set(state, "hyper_total_locks", ht)
  }
  return state
}

// ── OUTER LOOP: Regime Detection (343ms) ──────────────────────────
// Calculates fleet-wide Reynolds from all provider stats
// Classifies the overall flow state

fn tripple_outer(state) {
  let now = time()
  let providers = dict_get(state, "providers")
  let pkeys = dict_keys(providers)

  // Aggregate fleet metrics
  let total_queries = 0
  let total_errors = 0
  let total_latency = 0
  let count = 0

  let i = 0
  while3 i < len(pkeys) {
    let pk = pkeys[i]
    let prov = dict_get(providers, pk)
    total_queries = total_queries + dict_get(prov, "total_queries")
    total_errors = total_errors + dict_get(prov, "total_errors")
    total_latency = total_latency + dict_get(prov, "avg_latency_ms")
    count = count + 1
    i = i + 1
  }

  // Fleet Reynolds: Re = (query_rate × inverse_latency) / error_dampening
  let avg_lat = 1000
  if3 count > 0 { avg_lat = total_latency / count
  }
  let query_rate = total_queries
  let velocity = 1000000 / max_of(avg_lat, 1)
  let viscosity = 1000000 / max_of(total_errors + 1, 1)
  let re = (query_rate * velocity) / max_of(viscosity, 1)
  re = re / 1000  // scale down from 1000x factors

  // Classify regime
  let regime = ns_regime(re)
  let regime_trit = ns_regime_trit(re)

  state = dict_set(state, "regime", regime)
  state = dict_set(state, "regime_trit", regime_trit)
  state = dict_set(state, "fleet_reynolds", re)
  state = dict_set(state, "last_outer", now)
  return state
}

// ── MIDDLE LOOP: Provider Frequency Tuning (125ms) ────────────────
// Adjusts each provider's frequency based on success/error rates
// and the current regime modifier

fn tripple_middle(state, provider_name) {
  let providers = dict_get(state, "providers")
  let prov = dict_get(providers, provider_name)
  if3 prov == null {
    return state
  }

  let regime = dict_get(state, "regime")
  let mod = _regime_modifier(regime)

  // Provider frequency formula:
  // freq = base × (1000 + α×success - β×error) / 1000 × regime_mod / 1000
  let base = dict_get(prov, "base_freq")
  let succ = dict_get(prov, "success_rate")
  let err = dict_get(prov, "error_rate")

  let amplified = (ALPHA_SUCCESS * succ) / 1000
  let dampened = (BETA_ERROR * err) / 1000
  let factor = 1000 + amplified - dampened
  factor = max_of(factor, 100)  // floor at 0.1x

  let freq = (base * factor) / 1000
  freq = (freq * mod) / 1000
  freq = _clamp(freq, 50, 2187)

  prov = dict_set(prov, "current_freq", freq)
  providers = dict_set(providers, provider_name, prov)
  state = dict_set(state, "providers", providers)
  state = dict_set(state, "last_middle", time())
  return state
}

// ── INNER LOOP: Micro-Burst Trit Check (27ms) ────────────────────
// Rapid check of provider's last trit state
// Returns recommendation: +1 (send more), 0 (hold), -1 (avoid)

fn tripple_inner(state, provider_name) {
  let providers = dict_get(state, "providers")
  let prov = dict_get(providers, provider_name)
  if3 prov == null {
    return 0
  }

  let last_trit = dict_get(prov, "last_trit")
  let freq = dict_get(prov, "current_freq")
  let err = dict_get(prov, "error_rate")

  // If last response was failure AND error rate high → avoid
  if3 last_trit == -1 {
    if3 err > 500 {
      return -1
    }
    return 0
  }

  // If frequency is above base → in resonance → send more
  let base = dict_get(prov, "base_freq")
  if3 freq > base {
    return 1
  }

  return 0
}

// ── RIPPLE: Propagate Success/Failure Signal ──────────────────────
// Called after every provider query. Updates frequency state and
// propagates the signal across the system.

fn tripple_ripple(state, provider_name, trit, latency_ms) {
  let providers = dict_get(state, "providers")
  let prov = dict_get(providers, provider_name)
  if3 prov == null {
    return state
  }

  let now = time()

  // Update provider stats
  let tq = dict_get(prov, "total_queries") + 1
  prov = dict_set(prov, "total_queries", tq)
  prov = dict_set(prov, "last_trit", trit)
  prov = dict_set(prov, "last_ripple_time", now)

  // EMA update for success/error rates (scaled 0-1000)
  let old_succ = dict_get(prov, "success_rate")
  let old_err = dict_get(prov, "error_rate")
  let old_lat = dict_get(prov, "avg_latency_ms")

  if3 trit == 1 {
    // Success: boost success rate, decay error rate
    let ts = dict_get(prov, "total_success") + 1
    prov = dict_set(prov, "total_success", ts)
    let new_succ = ((1000 - ALPHA_SUCCESS) * old_succ + ALPHA_SUCCESS * 1000) / 1000
    prov = dict_set(prov, "success_rate", new_succ)
    let new_err = ((1000 - ALPHA_SUCCESS) * old_err) / 1000
    prov = dict_set(prov, "error_rate", new_err)
  }
  if3 trit == -1 {
    // Failure: boost error rate, decay success rate
    let te = dict_get(prov, "total_errors") + 1
    prov = dict_set(prov, "total_errors", te)
    let new_err = ((1000 - BETA_ERROR) * old_err + BETA_ERROR * 1000) / 1000
    prov = dict_set(prov, "error_rate", new_err)
    let new_succ = ((1000 - BETA_ERROR) * old_succ) / 1000
    prov = dict_set(prov, "success_rate", new_succ)
  }
  // trit == 0: neutral, no change

  // EMA update for latency
  let new_lat = ((1000 - ALPHA_SUCCESS) * old_lat + ALPHA_SUCCESS * latency_ms) / 1000
  prov = dict_set(prov, "avg_latency_ms", new_lat)

  // Update phase state via helper (avoids nested if3 scope bugs)
  let freq = dict_get(prov, "current_freq")
  let base = dict_get(prov, "base_freq")
  prov = _update_phase(prov, trit, freq, base)

  providers = dict_set(providers, provider_name, prov)
  state = dict_set(state, "providers", providers)
  let tr = dict_get(state, "total_ripples") + 1
  state = dict_set(state, "total_ripples", tr)

  // Re-tune this provider's frequency after ripple
  state = tripple_middle(state, provider_name)
  return state
}

// ═══════════════════════════════════════════════════════════════════
// HYBRID RESONANCE FORMULA: R(ω) × T(ω) × C(ω)
// ═══════════════════════════════════════════════════════════════════
// Three multiplicative components from distinct physics domains:
//   R = Resolvent Gain (Navier-Stokes frequency response)
//   T = Ternary Efficiency (balanced ternary entropy)
//   C = Coupled Resonance (Helmholtz resonator interference)
// All return 0-1000 scale. Combined: score = R×T×C mapped to 0-100.
// ═══════════════════════════════════════════════════════════════════

// ── R(ω): Resolvent Gain ─────────────────────────────────────────
// From N-S resolvent: R(ω) = (-iωI - L)⁻¹ with SVD giving σ₁
// σ₁ = principal singular value = max energy amplification
// In NovaX: σᵢ = (success_rate × current_freq) / 1000
// R_i = σᵢ / (σᵢ + threshold) — saturating gain function
// Returns average R across in-phase providers (0-1000 scale)

fn _resolvent_gain(providers, in_phase_list) {
  let n = len(in_phase_list)
  if3 n == 0 {
    return 0
  }

  let total_r = 0
  let i = 0
  while3 i < n {
    let pk = in_phase_list[i]
    let prov = dict_get(providers, pk)
    let succ = dict_get(prov, "success_rate")
    let freq = dict_get(prov, "current_freq")

    // σ = success × freq / 1000 (already captured latency via middle loop)
    let sigma = (succ * freq) / 1000

    // R_i = σ×1000 / (σ + threshold) — maps [0,∞) → [0,1000)
    let r_i = (sigma * 1000) / max_of(sigma + SIGMA_THRESHOLD, 1)
    total_r = total_r + r_i
    i = i + 1
  }

  return total_r / n
}

// ── T(ω): Ternary Efficiency ─────────────────────────────────────
// From information theory: T = 1 - H₃(p) where H₃ = ternary entropy
// H₃ max (=1 trit) when p(-1)=p(0)=p(+1)=1/3 → worst (indecisive)
// H₃ min (=0) when one state dominates → best (decisive)
// Approximation: T ≈ max(p_succ, p_err, p_neutral)² / 1000
//   At max entropy (all 333): 333²/1000 = 110 → low efficiency
//   At pure success (1000):   1000²/1000 = 1000 → max efficiency
// Returns average T across in-phase providers (0-1000 scale)

fn _ternary_efficiency(providers, in_phase_list) {
  let n = len(in_phase_list)
  if3 n == 0 {
    return 0
  }

  let total_t = 0
  let i = 0
  while3 i < n {
    let pk = in_phase_list[i]
    let prov = dict_get(providers, pk)
    let succ = dict_get(prov, "success_rate")
    let err = dict_get(prov, "error_rate")
    let neutral = 1000 - succ - err
    if3 neutral < 0 { neutral = 0
    }

    // Decisiveness = max probability² / 1000
    let max_p = max_of(succ, max_of(err, neutral))
    let t_i = (max_p * max_p) / 1000
    total_t = total_t + t_i
    i = i + 1
  }

  return total_t / n
}

// ── C(ω): Coupled Resonance ──────────────────────────────────────
// From Helmholtz resonator theory: coupled resonators at frequencies
// f₁, f₂ with coupling κ produce split eigenfrequencies:
//   ω± = (ω₁+ω₂)/2 ± √((Δω/2)² + κ²)
// Coupling strength: C_pair = κ² / (|f₁²-f₂²| + κ²)
//   Close frequencies → |f₁²-f₂²|≈0 → C≈1 (constructive)
//   Divergent frequencies → C→0 (destructive)
// Returns average coupling across all in-phase pairs (0-1000 scale)
// Single provider: C=1000 (no coupling penalty)

fn _coupled_resonance(providers, in_phase_list) {
  let n = len(in_phase_list)
  if3 n <= 1 {
    return 1000
  }

  let total_c = 0
  let pair_count = 0

  let i = 0
  while3 i < n {
    let j = i + 1
    while3 j < n {
      let p1 = dict_get(providers, in_phase_list[i])
      let p2 = dict_get(providers, in_phase_list[j])

      // Scale freqs down by 10 to prevent overflow in squaring
      let f1 = dict_get(p1, "current_freq") / 10
      let f2 = dict_get(p2, "current_freq") / 10

      let f1_sq = f1 * f1
      let f2_sq = f2 * f2
      let diff = f1_sq - f2_sq
      if3 diff < 0 { diff = 0 - diff
      }

      // C_pair = κ²×1000 / (|f₁²-f₂²| + κ²)
      let c_pair = (KAPPA_SQ * 1000) / max_of(diff + KAPPA_SQ, 1)

      total_c = total_c + c_pair
      pair_count = pair_count + 1
      j = j + 1
    }
    i = i + 1
  }

  if3 pair_count == 0 {
    return 1000
  }
  return total_c / pair_count
}

// ── RESONANCE CHECK: Are All Loops In Phase? ──────────────────────
// Called every RESONANCE_CYCLE (2187ms). Checks if the system has
// achieved standing wave lock across providers.
// Uses hybrid formula: score = R(ω) × T(ω) × C(ω)

fn tripple_resonance_check(state) {
  let providers = dict_get(state, "providers")
  let pkeys = dict_keys(providers)

  // Collect in-phase providers using scope-safe helpers
  let in_phase_count = 0
  let locked_providers = []

  let i = 0
  while3 i < len(pkeys) {
    let pk = pkeys[i]
    let prov = dict_get(providers, pk)
    let in_ph = dict_get(prov, "in_phase")
    let is_locked = _pick_val(in_ph == 1, 1, 0)
    in_phase_count = _increment_if(in_phase_count, is_locked)
    locked_providers = _maybe_append(locked_providers, pk, is_locked)
    i = i + 1
  }

  // ── Hybrid Resonance: R(ω) × T(ω) × C(ω) ──────────────────────
  // R = Resolvent Gain (N-S SVD principal singular value, saturating)
  // T = Ternary Efficiency (1 - H₃ entropy, decisiveness of trit state)
  // C = Coupled Resonance (Helmholtz pair coupling, frequency proximity)
  let rg = _resolvent_gain(providers, locked_providers)
  let te = _ternary_efficiency(providers, locked_providers)
  let cr = _coupled_resonance(providers, locked_providers)

  // Multiplicative combination: all three must be strong for high score
  // Each component is 0-1000. Chain-divide to stay in integer range.
  // score = (R × T / 1000) × C / 1000 → 0-1000 → divide by 10 → 0-100
  let base_score = (rg * te) / max_of(1000, 1)
  base_score = (base_score * cr) / max_of(1000, 1)
  base_score = base_score / 10

  // ── SUPERHARMONIC AMPLIFIER ──────────────────────────────────
  // When mirror discovers abilities, amplify score past 100 ceiling.
  // ability_amp = 1000 + (unique_abilities × ABILITY_AMP_PER)
  // This is laser-like: more discovered states → higher energy gain.
  let mirror_abilities = dict_get(state, "mirror_abilities") ?? {}
  let unique_abilities = len(keys(mirror_abilities))
  let ability_amp = ABILITY_AMP_BASE + (unique_abilities * ABILITY_AMP_PER)
  // Amplified score can exceed 100 — superharmonic territory
  let score = (base_score * ability_amp) / 1000

  // Store component breakdown for diagnostics
  state = dict_set(state, "resolvent_gain", rg)
  state = dict_set(state, "ternary_efficiency", te)
  state = dict_set(state, "coupled_resonance", cr)
  state = dict_set(state, "ability_amplifier", ability_amp)
  state = dict_set(state, "unique_abilities", unique_abilities)
  state = dict_set(state, "base_score", base_score)

  state = dict_set(state, "resonance_score", score)
  state = dict_set(state, "in_phase_count", in_phase_count)
  state = dict_set(state, "locked_providers", locked_providers)

  // Update resonance history (keep last 169 entries)
  let hist = dict_get(state, "resonance_history")
  hist = append(hist, score)
  hist = _trim_list(hist, 169)
  state = dict_set(state, "resonance_history", hist)

  // Prime state lock check (via scope-safe helper)
  state = _update_prime_lock(state, score, RESONANCE_THRESHOLD, PRIME_LOCK_CYCLES)

  // Hyper-prime check (via scope-safe helper)
  let prime_is_locked = dict_get(state, "prime_locked")
  state = _update_hyper_lock(state, score, prime_is_locked, unique_abilities)

  // Build wave pattern
  let wave = []
  let k = 0
  while3 k < len(locked_providers) {
    let lpk = locked_providers[k]
    let lp = dict_get(providers, lpk)
    let entry = {}
    entry = dict_set(entry, "provider", lpk)
    entry = dict_set(entry, "freq", dict_get(lp, "current_freq"))
    entry = dict_set(entry, "phase_count", dict_get(lp, "phase_count"))
    wave = append(wave, entry)
    k = k + 1
  }
  state = dict_set(state, "wave_pattern", wave)

  return state
}

// ── STANDING WAVE: Current Pattern ────────────────────────────────

fn tripple_standing_wave(state) {
  let wave = dict_get(state, "wave_pattern")
  let prime = dict_get(state, "prime_locked")
  let score = dict_get(state, "resonance_score")

  let result = {}
  result = dict_set(result, "wave", wave)
  result = dict_set(result, "prime_locked", prime)
  result = dict_set(result, "resonance_score", score)
  result = dict_set(result, "regime", dict_get(state, "regime"))
  result = dict_set(result, "in_phase_count", dict_get(state, "in_phase_count"))

  // Calculate standing wave amplitude (product of locked frequencies)
  let amplitude = 1
  let i = 0
  while3 i < len(wave) {
    let wentry = wave[i]
    let wfreq = dict_get(wentry, "freq")
    amplitude = (amplitude * wfreq) / 1000  // keep scaled
    i = i + 1
  }

  let interference = "none"
  if3 len(wave) >= 3 {
    if3 amplitude > CONSTRUCTIVE_THRESHOLD { interference = "constructive"
    }
    if3 amplitude < DESTRUCTIVE_THRESHOLD { interference = "destructive"
    }
    if3 interference == "none" { interference = "neutral"
    }
  }

  result = dict_set(result, "amplitude", amplitude)
  result = dict_set(result, "interference", interference)

  // Expose hybrid formula components for diagnostics
  result = dict_set(result, "resolvent_gain", dict_get(state, "resolvent_gain"))
  result = dict_set(result, "ternary_efficiency", dict_get(state, "ternary_efficiency"))
  result = dict_set(result, "coupled_resonance", dict_get(state, "coupled_resonance"))
  return result
}

// ── PRIME STATE: Query Lock Status ────────────────────────────────

fn tripple_prime_state(state) {
  let locked = dict_get(state, "prime_locked")
  let score = dict_get(state, "resonance_score")
  let lc = dict_get(state, "prime_lock_count")
  let tl = dict_get(state, "total_locks")

  let result = {}
  result = dict_set(result, "locked", locked)
  result = dict_set(result, "resonance_score", score)
  result = dict_set(result, "lock_cycles", lc)
  result = dict_set(result, "cycles_needed", PRIME_LOCK_CYCLES)
  result = dict_set(result, "total_locks_achieved", tl)

  // Trit output
  let trit = 0
  if3 locked == 1 { trit = 1
  }
  if3 score < 50 { trit = -1
  }
  result = dict_set(result, "trit", trit)

  // Character
  let char = "SEEKING"
  if3 locked == 1 { char = "PRIME"
  }
  if3 trit == -1 { char = "SCATTERED"
  }
  result = dict_set(result, "char", char)
  return result
}

// ── PROVIDER RANKING: Sort by Resonance ───────────────────────────
// Returns provider names sorted by current_freq × success_rate
// Used by Cloud Router to replace fixed-priority cascade

fn tripple_rank_providers(state) {
  let providers = dict_get(state, "providers")
  let pkeys = dict_keys(providers)

  // Build scored list
  let scored = []
  let i = 0
  while3 i < len(pkeys) {
    let pk = pkeys[i]
    let prov = dict_get(providers, pk)
    let freq = dict_get(prov, "current_freq")
    let succ = dict_get(prov, "success_rate")
    let score = (freq * succ) / 1000  // combined resonance score
    let entry = {}
    entry = dict_set(entry, "name", pk)
    entry = dict_set(entry, "score", score)
    entry = dict_set(entry, "freq", freq)
    entry = dict_set(entry, "trit", dict_get(prov, "last_trit"))
    scored = append(scored, entry)
    i = i + 1
  }

  // Sort by score descending using bubble sort (no list mutation needed)
  let changed = true
  while3 changed == true {
    changed = false
    let si = 0
    while3 si < len(scored) - 1 {
      let a = scored[si]
      let b = scored[si + 1]
      let sa = dict_get(a, "score") ?? 0
      let sb = dict_get(b, "score") ?? 0
      if3 sb > sa {
        // Swap: rebuild list with b before a
        let before = slice(scored, 0, si)
        let after = slice(scored, si + 2, len(scored))
        before = append(before, b)
        before = append(before, a)
        let ni = 0
        while3 ni < len(after) {
          before = append(before, after[ni])
          ni = ni + 1
        }
        scored = before
        changed = true
      }
      si = si + 1
    }
  }

  return scored
}

// ── STATUS: Full Module State for Endpoints ───────────────────────

fn tripple_status(state) {
  let result = {}
  result = dict_set(result, "version", TRIPPLE_VERSION)
  result = dict_set(result, "regime", dict_get(state, "regime"))
  result = dict_set(result, "regime_trit", dict_get(state, "regime_trit"))
  result = dict_set(result, "fleet_reynolds", dict_get(state, "fleet_reynolds"))
  result = dict_set(result, "resonance_score", dict_get(state, "resonance_score"))
  result = dict_set(result, "prime_locked", dict_get(state, "prime_locked"))
  result = dict_set(result, "prime_lock_count", dict_get(state, "prime_lock_count"))
  result = dict_set(result, "total_ripples", dict_get(state, "total_ripples"))
  result = dict_set(result, "total_locks", dict_get(state, "total_locks"))
  result = dict_set(result, "in_phase_count", dict_get(state, "in_phase_count"))

  // Hybrid formula component breakdown
  let formula = {}
  formula = dict_set(formula, "R_resolvent", dict_get(state, "resolvent_gain"))
  formula = dict_set(formula, "T_ternary", dict_get(state, "ternary_efficiency"))
  formula = dict_set(formula, "C_coupled", dict_get(state, "coupled_resonance"))
  formula = dict_set(formula, "ability_amplifier", dict_get(state, "ability_amplifier") ?? 1000)
  formula = dict_set(formula, "unique_abilities", dict_get(state, "unique_abilities") ?? 0)
  formula = dict_set(formula, "base_score", dict_get(state, "base_score") ?? 0)
  formula = dict_set(formula, "method", "R(w)xT(w)xC(w)xA(abilities)")
  result = dict_set(result, "formula", formula)

  // Hyper-prime state
  result = dict_set(result, "hyper_locked", dict_get(state, "hyper_locked") ?? 0)
  result = dict_set(result, "hyper_lock_count", dict_get(state, "hyper_lock_count") ?? 0)
  result = dict_set(result, "hyper_total_locks", dict_get(state, "hyper_total_locks") ?? 0)

  let uptime = time() - dict_get(state, "init_time")
  result = dict_set(result, "uptime_s", floor(uptime))

  // Provider frequency summary
  let providers = dict_get(state, "providers")
  let pkeys = dict_keys(providers)
  let freq_map = {}
  let i = 0
  while3 i < len(pkeys) {
    let pk = pkeys[i]
    let prov = dict_get(providers, pk)
    let psum = {}
    psum = dict_set(psum, "freq", dict_get(prov, "current_freq"))
    psum = dict_set(psum, "base", dict_get(prov, "base_freq"))
    psum = dict_set(psum, "success_rate", dict_get(prov, "success_rate"))
    psum = dict_set(psum, "error_rate", dict_get(prov, "error_rate"))
    psum = dict_set(psum, "in_phase", dict_get(prov, "in_phase"))
    psum = dict_set(psum, "last_trit", dict_get(prov, "last_trit"))
    psum = dict_set(psum, "queries", dict_get(prov, "total_queries"))
    freq_map = dict_set(freq_map, pk, psum)
    i = i + 1
  }
  result = dict_set(result, "providers", freq_map)

  // Wave pattern
  let wave = tripple_standing_wave(state)
  result = dict_set(result, "wave", wave)

  // Harmonics reference
  let harmonics = {}
  harmonics = dict_set(harmonics, "H3", H3)
  harmonics = dict_set(harmonics, "H5", H5)
  harmonics = dict_set(harmonics, "H7", H7)
  harmonics = dict_set(harmonics, "H13", H13)
  harmonics = dict_set(harmonics, "freq_outer_ms", FREQ_OUTER)
  harmonics = dict_set(harmonics, "freq_middle_ms", FREQ_MIDDLE)
  harmonics = dict_set(harmonics, "freq_inner_ms", FREQ_INNER)
  harmonics = dict_set(harmonics, "resonance_cycle_ms", RESONANCE_CYCLE)
  result = dict_set(result, "harmonics", harmonics)

  // Pacman summary
  let pac = {}
  pac = dict_set(pac, "installed", len(keys(dict_get(state, "pacman_installed") ?? {})))
  pac = dict_set(pac, "total_possible", 13)
  pac = dict_set(pac, "total_installs", dict_get(state, "pacman_total_installed") ?? 0)
  pac = dict_set(pac, "total_upgrades", dict_get(state, "pacman_total_upgrades") ?? 0)
  result = dict_set(result, "pacman", pac)

  // Auto-advance summary
  let adv = {}
  adv = dict_set(adv, "locked_models", dict_get(state, "mirror_locked_count") ?? 0)
  adv = dict_set(adv, "unlocked_models", dict_get(state, "mirror_unlocked_count") ?? 0)
  adv = dict_set(adv, "advance_pct", dict_get(state, "mirror_advance_pct") ?? 0)
  result = dict_set(result, "advance", adv)

  result = dict_set(result, "ok", 1)
  result = dict_set(result, "trit", dict_get(state, "regime_trit"))
  return result
}

// ═══════════════════════════════════════════════════════════════════
// TERNARY MIRROR — Reflects resonance data back through the system
// ═══════════════════════════════════════════════════════════════════
// Instead of probing each model individually, the mirror reflects
// every successful query's model + latency + quality as a trit signal.
// The standing wave pattern becomes the probe — sonar, not fishing.
//
// Mirror modes (ternary):
//   +1 = ACTIVE:  reflect + broadcast to Hivemind/Registry
//    0 = PASSIVE: reflect only (accumulate, no broadcast)
//   -1 = OFF:     mirror disabled
//
// The mirror accumulates:
//   model → {trit_sum, queries, avg_latency, last_trit, abilities}
// And broadcasts summaries to Hivemind SNR channels and Registry locks.
// ═══════════════════════════════════════════════════════════════════

let MIRROR_BROADCAST_INTERVAL = 2187  // 3⁷ms — sync with resonance cycle

// ── Initialize Mirror ────────────────────────────────────────────

fn tripple_mirror_init(state) {
  state = dict_set(state, "mirror", {})
  state = dict_set(state, "mirror_mode", 0)  // passive by default
  state = dict_set(state, "mirror_total", 0)
  state = dict_set(state, "mirror_unique_models", 0)
  state = dict_set(state, "mirror_last_broadcast", 0)
  state = dict_set(state, "mirror_broadcasts", 0)
  state = dict_set(state, "mirror_abilities", {})
  return state
}

// ── Reflect: Record a query result into the mirror ───────────────
// Called after every successful/failed query with model info.
// Builds up the mirror map without any extra API calls.

fn tripple_mirror_reflect(state, provider_name, model_id, trit, latency_ms) {
  let mirror = dict_get(state, "mirror")
  let existing = dict_get(mirror, model_id) ?? null

  if3 existing == null {
    // First sighting of this model
    let entry = {}
    entry = dict_set(entry, "model", model_id)
    entry = dict_set(entry, "provider", provider_name)
    entry = dict_set(entry, "trit_sum", trit)
    entry = dict_set(entry, "queries", 1)
    entry = dict_set(entry, "avg_latency", latency_ms)
    entry = dict_set(entry, "last_trit", trit)
    entry = dict_set(entry, "first_seen", time())
    entry = dict_set(entry, "last_seen", time())
    // Discover abilities from model name pattern
    let abilities = _mirror_classify_model(model_id)
    entry = dict_set(entry, "abilities", abilities)
    // BARE assignment: persist mirror update beyond if3 scope
    mirror = dict_set(mirror, model_id, entry)
    // Track unique model count
    let unique = dict_get(state, "mirror_unique_models") + 1
    state = dict_set(state, "mirror_unique_models", unique)
    // Track global abilities — use helper to avoid let-in-while3 scope issue
    state = _mirror_merge_abilities(state, abilities)
  }
  if3 existing != null {
    // Update existing entry with EMA
    let old_ts = dict_get(existing, "trit_sum") ?? 0
    let old_q = dict_get(existing, "queries") ?? 0
    let old_lat = dict_get(existing, "avg_latency") ?? 1000
    let new_ts = old_ts + trit
    let new_q = old_q + 1
    // EMA latency: H3 smoothing
    let new_lat = ((667 * old_lat) + (333 * latency_ms)) / 1000
    existing = dict_set(existing, "trit_sum", new_ts)
    existing = dict_set(existing, "queries", new_q)
    existing = dict_set(existing, "avg_latency", new_lat)
    existing = dict_set(existing, "last_trit", trit)
    existing = dict_set(existing, "last_seen", time())
    // BARE assignment: persist mirror update beyond if3 scope
    mirror = dict_set(mirror, model_id, existing)
  }

  state = dict_set(state, "mirror", mirror)
  let mt = dict_get(state, "mirror_total") + 1
  state = dict_set(state, "mirror_total", mt)

  // Check if we should broadcast (active mode only)
  let mode = dict_get(state, "mirror_mode")
  if3 mode == 1 { let last_bc = dict_get(state, "mirror_last_broadcast")
    let now = time()
    let elapsed = (now - last_bc) * 1000  // convert to ms
    if3 elapsed > MIRROR_BROADCAST_INTERVAL { state = _mirror_broadcast(state)
    }
  }

  return state
}

// ── Merge discovered abilities into global state ─────────────────
fn _mirror_merge_abilities(state, abilities) {
  let gab = dict_get(state, "mirror_abilities")
  let ab_keys = keys(abilities)
  let abi = 0
  while3 abi < len(ab_keys) {
    let ak = ab_keys[abi]
    let old_count = dict_get(gab, ak) ?? 0
    gab = dict_set(gab, ak, old_count + 1)
    abi = abi + 1
  }
  let result = dict_set(state, "mirror_abilities", gab)
  return result
}

// ── Classify model abilities from name pattern ───────────────────

fn _mirror_classify_model(model_id) {
  let ab = {}
  let mid = lower(model_id)

  // ── Chat: cloud models ──
  if3 contains(mid, "gpt") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "claude") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "sonnet") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "haiku") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "opus") { ab = dict_set(ab, "chat", 1)
    ab = dict_set(ab, "flagship", 1)
  }

  // ── Chat: local/Ollama models ──
  if3 contains(mid, "llama") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "mistral") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "falcon") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "qwen") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "phi") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "gemma") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "yi") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "vicuna") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "openchat") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "zephyr") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "neural-chat") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "hermes") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "dolphin") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "orca") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "aya") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "internlm") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "glm") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "starling") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "exaone") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "stablelm") { ab = dict_set(ab, "chat", 1) }
  if3 contains(mid, "samantha") { ab = dict_set(ab, "chat", 1) }

  // ── Reasoning ──
  if3 contains(mid, "deepseek-r1") { ab = dict_set(ab, "reasoning", 1) }
  if3 contains(mid, "marco-o1") { ab = dict_set(ab, "reasoning", 1) }
  if3 contains(mid, "o1") { ab = dict_set(ab, "reasoning", 1) }
  if3 contains(mid, "o3") { ab = dict_set(ab, "reasoning", 1) }
  if3 contains(mid, "o4") { ab = dict_set(ab, "reasoning", 1) }
  if3 contains(mid, "thinking") { ab = dict_set(ab, "reasoning", 1) }
  if3 contains(mid, "think") { ab = dict_set(ab, "reasoning", 1) }
  if3 contains(mid, "sonar-reasoning") { ab = dict_set(ab, "reasoning", 1) }
  if3 contains(mid, "maestro-reasoning") { ab = dict_set(ab, "reasoning", 1) }

  // ── Code ──
  if3 contains(mid, "coder") { ab = dict_set(ab, "code", 1) }
  if3 contains(mid, "codex") { ab = dict_set(ab, "code", 1) }
  if3 contains(mid, "codellama") { ab = dict_set(ab, "code", 1) }
  if3 contains(mid, "codegeex") { ab = dict_set(ab, "code", 1) }
  if3 contains(mid, "magicoder") { ab = dict_set(ab, "code", 1) }
  if3 contains(mid, "starcoder") { ab = dict_set(ab, "code", 1) }
  if3 contains(mid, "granite-code") { ab = dict_set(ab, "code", 1) }
  if3 contains(mid, "stable-code") { ab = dict_set(ab, "code", 1) }
  if3 contains(mid, "sqlcoder") { ab = dict_set(ab, "code", 1) }
  if3 contains(mid, "codestral") { ab = dict_set(ab, "code", 1) }
  if3 contains(mid, "qwen3-coder") { ab = dict_set(ab, "code", 1) }
  if3 contains(mid, "mercury-coder") { ab = dict_set(ab, "code", 1) }
  if3 contains(mid, "kat-coder") { ab = dict_set(ab, "code", 1) }
  if3 contains(mid, "grok-code") { ab = dict_set(ab, "code", 1) }
  if3 contains(mid, "devstral") { ab = dict_set(ab, "code", 1) }

  // ── Math ──
  if3 contains(mid, "mathstral") { ab = dict_set(ab, "math", 1) }
  if3 contains(mid, "wizard-math") { ab = dict_set(ab, "math", 1) }

  // ── Vision / Image ──
  if3 contains(mid, "llava") { ab = dict_set(ab, "vision", 1) }
  if3 contains(mid, "moondream") { ab = dict_set(ab, "vision", 1) }
  if3 contains(mid, "minicpm-v") { ab = dict_set(ab, "vision", 1) }
  if3 contains(mid, "bakllava") { ab = dict_set(ab, "vision", 1) }
  if3 contains(mid, "image") { ab = dict_set(ab, "vision", 1) }
  if3 contains(mid, "dall") { ab = dict_set(ab, "vision", 1) }
  if3 contains(mid, "gpt-image") { ab = dict_set(ab, "vision", 1) }
  if3 contains(mid, "vision") { ab = dict_set(ab, "vision", 1) }
  if3 contains(mid, "-vl-") { ab = dict_set(ab, "vision", 1) }
  if3 contains(mid, "qwen3-vl") { ab = dict_set(ab, "vision", 1) }

  // ── Embeddings ──
  if3 contains(mid, "embed") { ab = dict_set(ab, "embedding", 1) }
  if3 contains(mid, "minilm") { ab = dict_set(ab, "embedding", 1) }
  if3 contains(mid, "nomic") { ab = dict_set(ab, "embedding", 1) }
  if3 contains(mid, "snowflake") { ab = dict_set(ab, "embedding", 1) }
  if3 contains(mid, "mxbai") { ab = dict_set(ab, "embedding", 1) }

  // ── Audio ──
  if3 contains(mid, "audio") { ab = dict_set(ab, "audio", 1) }
  if3 contains(mid, "realtime") { ab = dict_set(ab, "voice", 1) }
  if3 contains(mid, "tts") { ab = dict_set(ab, "tts", 1) }
  if3 contains(mid, "transcribe") { ab = dict_set(ab, "stt", 1) }
  if3 contains(mid, "whisper") { ab = dict_set(ab, "stt", 1) }

  // ── Video ──
  if3 contains(mid, "sora") { ab = dict_set(ab, "video", 1) }

  // ── System / Tool Use ──
  if3 contains(mid, "function") { ab = dict_set(ab, "system", 1) }
  if3 contains(mid, "tool") { ab = dict_set(ab, "system", 1) }
  if3 contains(mid, "agent") { ab = dict_set(ab, "system", 1) }
  if3 contains(mid, "computer-use") { ab = dict_set(ab, "system", 1) }

  // ── Search ──
  if3 contains(mid, "search") { ab = dict_set(ab, "search", 1) }

  // ── Speed tier ──
  if3 contains(mid, "nano") { ab = dict_set(ab, "fast", 1) }
  if3 contains(mid, "mini") { ab = dict_set(ab, "fast", 1) }
  if3 contains(mid, "tiny") { ab = dict_set(ab, "fast", 1) }
  if3 contains(mid, "flash") { ab = dict_set(ab, "fast", 1) }
  if3 contains(mid, "turbo") { ab = dict_set(ab, "fast", 1) }
  if3 contains(mid, "-fast") { ab = dict_set(ab, "fast", 1) }
  if3 contains(mid, "lite") { ab = dict_set(ab, "fast", 1) }

  // ── Pro tier ──
  if3 contains(mid, "pro") { ab = dict_set(ab, "flagship", 1) }

  return ab
}

// ── Broadcast: Push mirror state to Hivemind and Registry ────────

fn _build_broadcast_item(mk, entry) {
  let item = {}
  item = dict_set(item, "model", mk)
  item = dict_set(item, "provider", dict_get(entry, "provider") ?? "")
  item = dict_set(item, "trit_sum", dict_get(entry, "trit_sum") ?? 0)
  item = dict_set(item, "queries", dict_get(entry, "queries") ?? 0)
  item = dict_set(item, "avg_latency", dict_get(entry, "avg_latency") ?? 0)
  item = dict_set(item, "abilities", dict_get(entry, "abilities") ?? {})
  return item
}

fn _mirror_broadcast(state) {
  let mirror = dict_get(state, "mirror")
  let mkeys = keys(mirror)
  let now = time()

  // Build broadcast payload: models with positive trit balance
  let payload = []
  let i = 0
  while3 i < len(mkeys) {
    let mk = mkeys[i]
    let entry = dict_get(mirror, mk)
    let trit_sum = dict_get(entry, "trit_sum") ?? 0
    let is_positive = _pick_val(trit_sum > 0, 1, 0)
    let item = _build_broadcast_item(mk, entry)
    payload = _maybe_append(payload, item, is_positive)
    i = i + 1
  }

  // Send ripple to Hivemind with mirror data
  let hive_body = json_encode({"source": "tripple_mirror", "models": payload, "total_reflected": dict_get(state, "mirror_total"), "unique_models": dict_get(state, "mirror_unique_models"), "timestamp": now})
  try3 {
    http_post("http://127.0.0.1:9881/api/v1/modulation/ripple", hive_body)
  } { 0 }

  // Send model discoveries to Registry
  let reg_body = json_encode({"source": "tripple_mirror", "models": payload, "count": len(payload)})
  try3 {
    http_post("http://127.0.0.1:9860/models/mirror", reg_body)
  } { 0 }

  let bc = dict_get(state, "mirror_broadcasts") + 1
  state = dict_set(state, "mirror_broadcasts", bc)
  state = dict_set(state, "mirror_last_broadcast", now)
  return state
}

// ── Mirror Status ────────────────────────────────────────────────

fn tripple_mirror_status(state) {
  let result = {}
  let mode = dict_get(state, "mirror_mode")
  let mode_name = "PASSIVE"
  if3 mode == 1 { mode_name = "ACTIVE" }
  if3 mode == -1 { mode_name = "OFF" }
  result = dict_set(result, "mode", mode_name)
  result = dict_set(result, "mode_trit", mode)
  result = dict_set(result, "total_reflected", dict_get(state, "mirror_total"))
  result = dict_set(result, "unique_models", dict_get(state, "mirror_unique_models"))
  result = dict_set(result, "broadcasts", dict_get(state, "mirror_broadcasts"))
  result = dict_set(result, "abilities_discovered", dict_get(state, "mirror_abilities"))

  // Top models by trit_sum
  let mirror = dict_get(state, "mirror")
  let mkeys = keys(mirror)
  let top = []
  let i = 0
  while3 i < len(mkeys) {
    let mk = mkeys[i]
    let entry = dict_get(mirror, mk)
    let summary = {}
    summary = dict_set(summary, "model", mk)
    summary = dict_set(summary, "trit_sum", dict_get(entry, "trit_sum") ?? 0)
    summary = dict_set(summary, "queries", dict_get(entry, "queries") ?? 0)
    summary = dict_set(summary, "avg_latency", dict_get(entry, "avg_latency") ?? 0)
    summary = dict_set(summary, "last_trit", dict_get(entry, "last_trit") ?? 0)
    top = append(top, summary)
    i = i + 1
  }
  result = dict_set(result, "models", top)
  result = dict_set(result, "ok", 1)
  result = dict_set(result, "trit", 1)
  return result
}

// ── Set Mirror Mode ──────────────────────────────────────────────

fn tripple_mirror_set_mode(state, mode_trit) {
  state = dict_set(state, "mirror_mode", mode_trit)
  return state
}

// ═══════════════════════════════════════════════════════════════════
// PACMAN — Ability-to-Infrastructure Pipeline
// ═══════════════════════════════════════════════════════════════════
// Pacman "eats" discovered abilities and converts them into live
// NovaX infrastructure. Each ability maps to a service/feature that
// can be provisioned, checked, or upgraded.
//
// Flow: Mirror discovers ability → Pacman checks if installed →
//       If missing: provisions it → If present: upgrades priority
//
// Abilities → Infrastructure mapping:
//   chat       → Cloud Router query channels (always present)
//   reasoning  → Reasoning chain service (deep think mode)
//   code       → Code execution sandbox (NovaLang eval)
//   search     → Web search integration (search provider route)
//   image      → Image gen/analysis pipeline
//   audio      → Audio processing pipeline
//   voice      → Realtime voice streaming
//   tts        → Text-to-speech output
//   stt        → Speech-to-text input
//   video      → Video generation pipeline
//   embedding  → Vector embedding + semantic search
//   fast       → Low-latency fast-path routing
//   flagship   → Premium model priority queue
// ═══════════════════════════════════════════════════════════════════

let PACMAN_VERSION = "1.0.0"

// Lock threshold: model is "fully characterized" after this many queries
let MODEL_LOCK_THRESHOLD = 7   // H7 queries to lock a model
let MODEL_TRIT_MIN = 3         // H3 minimum trit_sum to consider "good"

fn tripple_pacman_init(state) {
  state = dict_set(state, "pacman_installed", {})
  state = dict_set(state, "pacman_pending", {})
  state = dict_set(state, "pacman_log", [])
  state = dict_set(state, "pacman_total_installed", 0)
  state = dict_set(state, "pacman_total_upgrades", 0)
  return state
}

// Ability → Infrastructure definition
fn _pacman_infra_map() {
  let m = {}
  m = dict_set(m, "chat",      {"service": "cloud-router",  "port": 9878, "feature": "query_channels",    "tier": 1, "description": "Multi-provider chat routing"})
  m = dict_set(m, "reasoning", {"service": "nova-reasoner", "port": 9912, "feature": "chain_of_thought",  "tier": 2, "description": "Deep reasoning chain with N-S flow analysis"})
  m = dict_set(m, "code",      {"service": "nova-sandbox",  "port": 9913, "feature": "code_execution",    "tier": 2, "description": "Sandboxed code execution via NovaLang eval"})
  m = dict_set(m, "search",    {"service": "nova-search",   "port": 9914, "feature": "web_search",        "tier": 2, "description": "Web search integration with ternary ranking"})
  m = dict_set(m, "image",     {"service": "nova-timage",   "port": 9918, "feature": "image_pipeline",    "tier": 2, "description": "Image generation and analysis pipeline"})
  m = dict_set(m, "audio",     {"service": "audio-engine",  "port": 9854, "feature": "audio_processing",  "tier": 3, "description": "Audio processing and transformation"})
  m = dict_set(m, "voice",     {"service": "nova-tspeak",   "port": 9895, "feature": "realtime_voice",    "tier": 3, "description": "Realtime voice synthesis and streaming"})
  m = dict_set(m, "tts",       {"service": "nova-tspeak",   "port": 9895, "feature": "text_to_speech",    "tier": 2, "description": "Text-to-speech output synthesis"})
  m = dict_set(m, "stt",       {"service": "nova-stt",      "port": 9875, "feature": "speech_to_text",    "tier": 2, "description": "Speech-to-text input recognition"})
  m = dict_set(m, "video",     {"service": "nova-tffmpeg",  "port": 9922, "feature": "video_processing",  "tier": 3, "description": "Video processing and transformation pipeline"})
  m = dict_set(m, "embedding", {"service": "nova-embed",    "port": 9921, "feature": "vector_search",     "tier": 2, "description": "Vector embedding and semantic search"})
  m = dict_set(m, "fast",      {"service": "nova-fastpath", "port": 9922, "feature": "low_latency_route", "tier": 1, "description": "Sub-100ms fast-path routing for mini models"})
  m = dict_set(m, "flagship",  {"service": "nova-premium",  "port": 9923, "feature": "premium_queue",     "tier": 1, "description": "Priority queue for flagship/pro models"})
  m = dict_set(m, "system",   {"service": "novaxcore-engine", "port": 9851, "feature": "win32_tools",     "tier": 1, "description": "Win32 system tools — windows, registry, process, theme, clipboard, notify (NovaXCore Engine)"})
  m = dict_set(m, "math",     {"service": "nova-math",     "port": 9924, "feature": "math_solver",       "tier": 2, "description": "Mathematical computation and theorem proving"})
  return m
}

// Run Pacman: check discovered abilities, provision missing infrastructure
fn _safe_notify(body) {
  let r = try3 { http_post("http://127.0.0.1:9999/api/services/register", body) } { 0 }
  return r
}

fn _safe_append_log(log, ev, ab, svc, pt) {
  let entry = {}
  entry = dict_set(entry, "event", ev)
  entry = dict_set(entry, "ability", ab)
  entry = dict_set(entry, "service", svc)
  entry = dict_set(entry, "port", pt)
  entry = dict_set(entry, "time", time())
  return append(log, entry)
}

fn _trim_list(list, max_len) {
  if3 len(list) <= max_len {
    return list
  }
  let trimmed = []
  let j = len(list) - max_len
  while3 j < len(list) {
    trimmed = append(trimmed, list[j])
    j = j + 1
  }
  return trimmed
}

fn _pacman_process_ability(installed, log, new_installs, upgrades, ab, ab_count, infra_def) {
  if3 infra_def == null {
    let r = {}
    r = dict_set(r, "installed", installed)
    r = dict_set(r, "log", log)
    r = dict_set(r, "new_installs", new_installs)
    r = dict_set(r, "upgrades", upgrades)
    return r
  }
  let already = dict_get(installed, ab) ?? null
  if3 already == null {
    // NEW: provision this infrastructure
    let entry = {}
    entry = dict_set(entry, "ability", ab)
    entry = dict_set(entry, "service", dict_get(infra_def, "service") ?? "")
    entry = dict_set(entry, "port", dict_get(infra_def, "port") ?? 0)
    entry = dict_set(entry, "feature", dict_get(infra_def, "feature") ?? "")
    entry = dict_set(entry, "description", dict_get(infra_def, "description") ?? "")
    entry = dict_set(entry, "tier", dict_get(infra_def, "tier") ?? 3)
    entry = dict_set(entry, "status", "provisioned")
    entry = dict_set(entry, "model_count", ab_count)
    entry = dict_set(entry, "installed_at", time())
    entry = dict_set(entry, "trit", 1)
    installed = dict_set(installed, ab, entry)
    new_installs = new_installs + 1
    log = _safe_append_log(log, "install", ab, dict_get(infra_def, "service") ?? "", dict_get(infra_def, "port") ?? 0)
    let notify_body = json_encode({"source": "tripple_pacman", "event": "new_infrastructure", "ability": ab, "service": dict_get(infra_def, "service") ?? "", "port": dict_get(infra_def, "port") ?? 0, "feature": dict_get(infra_def, "feature") ?? ""})
    _safe_notify(notify_body)
    let r = {}
    r = dict_set(r, "installed", installed)
    r = dict_set(r, "log", log)
    r = dict_set(r, "new_installs", new_installs)
    r = dict_set(r, "upgrades", upgrades)
    return r
  }
  // UPGRADE: more models discovered
  let old_count = dict_get(already, "model_count") ?? 0
  if3 ab_count <= old_count {
    let r = {}
    r = dict_set(r, "installed", installed)
    r = dict_set(r, "log", log)
    r = dict_set(r, "new_installs", new_installs)
    r = dict_set(r, "upgrades", upgrades)
    return r
  }
  already = dict_set(already, "model_count", ab_count)
  already = dict_set(already, "last_upgrade", time())
  installed = dict_set(installed, ab, already)
  upgrades = upgrades + 1
  let r = {}
  r = dict_set(r, "installed", installed)
  r = dict_set(r, "log", log)
  r = dict_set(r, "new_installs", new_installs)
  r = dict_set(r, "upgrades", upgrades)
  return r
}

fn tripple_pacman_run(state) {
  let abilities = dict_get(state, "mirror_abilities") ?? {}
  let installed = dict_get(state, "pacman_installed") ?? {}
  let pending = dict_get(state, "pacman_pending") ?? {}
  let log = dict_get(state, "pacman_log") ?? []
  let infra = _pacman_infra_map()

  let ab_keys = keys(abilities)
  let new_installs = 0
  let upgrades = 0

  let i = 0
  while3 i < len(ab_keys) {
    let ab = ab_keys[i]
    let ab_count = dict_get(abilities, ab) ?? 0
    let infra_def = dict_get(infra, ab) ?? null
    let result = _pacman_process_ability(installed, log, new_installs, upgrades, ab, ab_count, infra_def)
    installed = dict_get(result, "installed")
    log = dict_get(result, "log")
    new_installs = dict_get(result, "new_installs")
    upgrades = dict_get(result, "upgrades")
    i = i + 1
  }

  // Trim log to last 169 entries
  log = _trim_list(log, 169)

  state = dict_set(state, "pacman_installed", installed)
  state = dict_set(state, "pacman_pending", pending)
  state = dict_set(state, "pacman_log", log)
  let ti = (dict_get(state, "pacman_total_installed") ?? 0) + new_installs
  state = dict_set(state, "pacman_total_installed", ti)
  let tu = (dict_get(state, "pacman_total_upgrades") ?? 0) + upgrades
  state = dict_set(state, "pacman_total_upgrades", tu)

  return state
}

fn _make_missing_entry(ak, infra_def) {
  let e = {}
  e = dict_set(e, "ability", ak)
  e = dict_set(e, "service", dict_get(infra_def, "service") ?? "")
  e = dict_set(e, "port", dict_get(infra_def, "port") ?? 0)
  return e
}

fn tripple_pacman_status(state) {
  let installed = dict_get(state, "pacman_installed") ?? {}
  let infra = _pacman_infra_map()
  let inst_keys = keys(installed)

  let services = []
  let i = 0
  while3 i < len(inst_keys) {
    let ik = inst_keys[i]
    let entry = dict_get(installed, ik)
    services = append(services, entry)
    i = i + 1
  }

  // Calculate what's missing
  let all_ab = keys(infra)
  let missing = []
  let j = 0
  while3 j < len(all_ab) {
    let ak = all_ab[j]
    let has = dict_get(installed, ak) ?? null
    let infra_def = dict_get(infra, ak)
    let is_missing = _pick_val(has == null, 1, 0)
    let new_entry = _make_missing_entry(ak, infra_def)
    missing = _maybe_append(missing, new_entry, is_missing)
    j = j + 1
  }

  return {
    "ok": 1,
    "trit": 1,
    "version": PACMAN_VERSION,
    "installed_count": len(inst_keys),
    "total_possible": len(all_ab),
    "missing_count": len(missing),
    "total_installs": dict_get(state, "pacman_total_installed") ?? 0,
    "total_upgrades": dict_get(state, "pacman_total_upgrades") ?? 0,
    "installed": services,
    "missing": missing,
    "log": dict_get(state, "pacman_log") ?? []
  }
}

// ═══════════════════════════════════════════════════════════════════
// AUTO-ADVANCE — Lock-and-Proceed Model Scanner
// ═══════════════════════════════════════════════════════════════════
// Like a radio frequency scanner: lock onto a model, characterize it,
// then move to the next. Models are "locked" when they have enough
// queries and a clear trit signal (positive or negative).
//
// Locked models get deprioritized in future reflections.
// Unlocked models get boosted — the mirror focuses on unknowns.
// ═══════════════════════════════════════════════════════════════════

fn _auto_lock_model(entry, mk) {
  let queries = dict_get(entry, "queries") ?? 0
  let trit_sum = dict_get(entry, "trit_sum") ?? 0
  let lock_entry = {}
  lock_entry = dict_set(lock_entry, "model", mk)
  lock_entry = dict_set(lock_entry, "queries", queries)
  lock_entry = dict_set(lock_entry, "trit_sum", trit_sum)
  lock_entry = dict_set(lock_entry, "locked_at", time())
  let lock_trit = 0
  if3 trit_sum >= MODEL_TRIT_MIN { lock_trit = 1 }
  if3 trit_sum <= (0 - MODEL_TRIT_MIN) { lock_trit = -1 }
  lock_entry = dict_set(lock_entry, "trit", lock_trit)
  lock_entry = dict_set(lock_entry, "status", "LOCKED")
  return lock_entry
}

fn _should_lock(already_locked, queries, threshold) {
  if3 already_locked == 1 {
    return 0
  }
  if3 queries < threshold {
    return 0
  }
  return 1
}

fn tripple_mirror_auto_advance(state) {
  let mirror = dict_get(state, "mirror") ?? {}
  let mkeys = keys(mirror)
  let locked_models = dict_get(state, "mirror_locked_models") ?? {}
  let new_locks = 0

  let i = 0
  while3 i < len(mkeys) {
    let mk = mkeys[i]
    let entry = dict_get(mirror, mk)
    let queries = dict_get(entry, "queries") ?? 0
    let already_locked = dict_get(locked_models, mk) ?? 0
    let do_lock = _should_lock(already_locked, queries, MODEL_LOCK_THRESHOLD)
    if3 do_lock == 1 {
      let le = _auto_lock_model(entry, mk)
      locked_models = dict_set(locked_models, mk, le)
      new_locks = new_locks + 1
    }
    i = i + 1
  }

  state = dict_set(state, "mirror_locked_models", locked_models)

  // Calculate advancement stats
  let total_models = len(mkeys)
  let locked_count = len(keys(locked_models))
  let unlocked_count = total_models - locked_count
  let advance_pct = 0
  if3 total_models > 0 { advance_pct = (locked_count * 100) / total_models
  }

  state = dict_set(state, "mirror_advance_pct", advance_pct)
  state = dict_set(state, "mirror_locked_count", locked_count)
  state = dict_set(state, "mirror_unlocked_count", unlocked_count)
  state = dict_set(state, "mirror_new_locks", new_locks)

  return state
}

fn tripple_mirror_advance_status(state) {
  let locked_models = dict_get(state, "mirror_locked_models") ?? {}
  let lkeys = keys(locked_models)

  let good = []
  let bad = []
  let uncertain = []

  let i = 0
  while3 i < len(lkeys) {
    let lk = lkeys[i]
    let entry = dict_get(locked_models, lk)
    let trit = dict_get(entry, "trit") ?? 0
    if3 trit == 1 { good = append(good, entry) }
    if3 trit == -1 { bad = append(bad, entry) }
    if3 trit == 0 { uncertain = append(uncertain, entry) }
    i = i + 1
  }

  return {
    "ok": 1,
    "trit": 1,
    "total_models": dict_get(state, "mirror_unique_models") ?? 0,
    "locked_count": dict_get(state, "mirror_locked_count") ?? 0,
    "unlocked_count": dict_get(state, "mirror_unlocked_count") ?? 0,
    "advance_pct": dict_get(state, "mirror_advance_pct") ?? 0,
    "lock_threshold": MODEL_LOCK_THRESHOLD,
    "good_models": good,
    "bad_models": bad,
    "uncertain_models": uncertain,
    "good_count": len(good),
    "bad_count": len(bad),
    "uncertain_count": len(uncertain)
  }
}

// ══════════════════════════════════════════════════════════════
// BULK MIRROR INJECT — Register hundreds of models at once
// ══════════════════════════════════════════════════════════════
// models_list = [ {"id": "openai/gpt-4o", "provider": "openai"}, ... ]
// Injects each into mirror with trit=+1 (discovered), queries=MODEL_LOCK_THRESHOLD
// so they immediately qualify for locking

fn tripple_mirror_bulk_inject(state, models_list) {
  let mirror = dict_get(state, "mirror") ?? {}
  let gab = dict_get(state, "mirror_abilities") ?? {}
  let unique = dict_get(state, "mirror_unique_models") ?? 0
  let injected = 0
  let skipped = 0

  let i = 0
  while3 i < len(models_list) {
    let m = models_list[i]
    let mid = dict_get(m, "id") ?? ""
    let mprov = dict_get(m, "provider") ?? "unknown"
    let existing = dict_get(mirror, mid) ?? null

    if3 existing == null {
      // New model — register with lock-ready queries
      let entry = {}
      entry = dict_set(entry, "model", mid)
      entry = dict_set(entry, "provider", mprov)
      entry = dict_set(entry, "trit_sum", MODEL_LOCK_THRESHOLD)
      entry = dict_set(entry, "queries", MODEL_LOCK_THRESHOLD)
      entry = dict_set(entry, "avg_latency", 100)
      entry = dict_set(entry, "last_trit", 1)
      entry = dict_set(entry, "first_seen", time())
      entry = dict_set(entry, "last_seen", time())
      entry = dict_set(entry, "bulk_injected", 1)
      let abilities = _mirror_classify_model(mid)
      entry = dict_set(entry, "abilities", abilities)
      mirror = dict_set(mirror, mid, entry)
      unique = unique + 1
      injected = injected + 1
      // Track global abilities
      let ab_keys = keys(abilities)
      let abi = 0
      while3 abi < len(ab_keys) {
        let ak = ab_keys[abi]
        let old_count = dict_get(gab, ak) ?? 0
        gab = dict_set(gab, ak, old_count + 1)
        abi = abi + 1
      }
    }
    if3 existing != null { skipped = skipped + 1
    }
    i = i + 1
  }

  state = dict_set(state, "mirror", mirror)
  state = dict_set(state, "mirror_unique_models", unique)
  state = dict_set(state, "mirror_abilities", gab)
  state = dict_set(state, "mirror_total", (dict_get(state, "mirror_total") ?? 0) + injected)

  return {"state": state, "injected": injected, "skipped": skipped, "total": unique}
}

// ══════════════════════════════════════════════════════════════
// FORCE LOCK ALL — Lock every model in mirror permanently
// ══════════════════════════════════════════════════════════════
// Bypasses MODEL_LOCK_THRESHOLD — locks everything regardless of query count
// All bulk-injected models get trit=+1 (good/discovered)

fn _force_lock_model(entry, mk) {
  let trit_sum = dict_get(entry, "trit_sum") ?? 0
  let queries = dict_get(entry, "queries") ?? 0
  let lock_entry = {}
  lock_entry = dict_set(lock_entry, "model", mk)
  lock_entry = dict_set(lock_entry, "queries", queries)
  lock_entry = dict_set(lock_entry, "trit_sum", trit_sum)
  lock_entry = dict_set(lock_entry, "locked_at", time())
  let lock_trit = 1
  if3 trit_sum <= (0 - MODEL_TRIT_MIN) { lock_trit = -1 }
  if3 trit_sum == 0 { lock_trit = 0 }
  lock_entry = dict_set(lock_entry, "trit", lock_trit)
  lock_entry = dict_set(lock_entry, "status", "LOCKED")
  lock_entry = dict_set(lock_entry, "permanent", 1)
  return lock_entry
}

fn tripple_mirror_force_lock_all(state) {
  let mirror = dict_get(state, "mirror") ?? {}
  let mkeys = keys(mirror)
  let locked_models = dict_get(state, "mirror_locked_models") ?? {}
  let new_locks = 0

  let i = 0
  while3 i < len(mkeys) {
    let mk = mkeys[i]
    let entry = dict_get(mirror, mk)
    let already_locked = dict_get(locked_models, mk) ?? 0
    let is_new = _pick_val(already_locked != 1, 1, 0)
    if3 is_new == 1 {
      let le = _force_lock_model(entry, mk)
      locked_models = dict_set(locked_models, mk, le)
      new_locks = new_locks + 1
    }
    i = i + 1
  }

  state = dict_set(state, "mirror_locked_models", locked_models)
  let total_models = len(mkeys)
  let locked_count = len(keys(locked_models))
  state = dict_set(state, "mirror_advance_pct", 100)
  state = dict_set(state, "mirror_locked_count", locked_count)
  state = dict_set(state, "mirror_unlocked_count", 0)
  state = dict_set(state, "mirror_new_locks", new_locks)

  return {"state": state, "new_locks": new_locks, "total_locked": locked_count}
}

// -- GO ENGINE ---- Territorial Strategy (Yin to Chess's Yang) ----
// Chess = tactical provider selection (which piece moves next?)
// Go = territorial capability mapping (which territories do we control?)
//
// Go board = 13x13 grid (H13) where:
//   - Stones = provider+capability pairs (e.g. "openai:chat")
//   - Black stones (+1) = healthy, responsive providers in that territory
//   - White stones (-1) = failing or slow providers
//   - Empty (0) = unclaimed territory (no provider covers this capability)
//   - Liberties = number of healthy neighbors (adjacent capabilities)
//   - Groups = clusters of capabilities served by same provider
//   - Territory = number of empty intersections surrounded by your stones
//
// The Go engine answers: "Which capability territories do we dominate?
// Which are contested? Where should we expand?"
//
// Ko rule: if a provider keeps flipping between +1 and -1 in the same
// territory, it enters ko — locked out for H7=7 cycles to prevent
// oscillation. This mirrors real Go where repeating board positions
// are forbidden.

// 7 capabilities (H7) mapped to Go territory zones
let GO_TERRITORIES = ["chat", "code", "reasoning", "image", "audio", "embedding", "fast", "system"]

// H13 ko lockout duration
let GO_KO_LOCKOUT = 7

// Minimum liberties before a group is "in atari" (about to die)
let GO_ATARI_THRESHOLD = 1

// Territory control thresholds
let GO_DOMINATION_THRESHOLD = 3   // H3 stones to dominate a territory
let GO_CONTESTED_THRESHOLD = 1    // mixed stones = contested

// Max token configs per territory (max output always)
let GO_MAX_TOKENS_CHAT = 8192
let GO_MAX_TOKENS_CODE = 16384
let GO_MAX_TOKENS_REASONING = 32768
let GO_MAX_TOKENS_IMAGE = 4096
let GO_MAX_TOKENS_AUDIO = 4096
let GO_MAX_TOKENS_EMBEDDING = 512
let GO_MAX_TOKENS_FAST = 2048

fn _is_code_model(name) {
  if3 contains(name, "code") { return 1 }
  if3 contains(name, "coder") { return 1 }
  if3 contains(name, "starcoder") { return 1 }
  if3 contains(name, "codellama") { return 1 }
  if3 contains(name, "sqlcoder") { return 1 }
  if3 contains(name, "codegen") { return 1 }
  if3 contains(name, "codegeex") { return 1 }
  if3 contains(name, "granite-code") { return 1 }
  if3 contains(name, "wizardcoder") { return 1 }
  if3 contains(name, "deepseek-coder") { return 1 }
  if3 contains(name, "qwen2.5-coder") { return 1 }
  if3 contains(name, "codestral") { return 1 }
  if3 contains(name, "qwen3-coder") { return 1 }
  if3 contains(name, "mercury-coder") { return 1 }
  if3 contains(name, "kat-coder") { return 1 }
  if3 contains(name, "grok-code") { return 1 }
  if3 contains(name, "devstral") { return 1 }
  return 0
}

fn _is_reasoning_model(name) {
  if3 contains(name, "o1-") { return 1 }
  if3 contains(name, "o3-") { return 1 }
  if3 contains(name, "o4-") { return 1 }
  if3 contains(name, "deepseek-r1") { return 1 }
  if3 contains(name, "reasoning") { return 1 }
  if3 contains(name, "think") { return 1 }
  if3 contains(name, "reflection") { return 1 }
  if3 contains(name, "sonar-reasoning") { return 1 }
  if3 contains(name, "maestro") { return 1 }
  return 0
}

fn _is_image_model(name) {
  if3 contains(name, "vision") { return 1 }
  if3 contains(name, "llava") { return 1 }
  if3 contains(name, "bakllava") { return 1 }
  if3 contains(name, "dall") { return 1 }
  if3 contains(name, "stable-diffusion") { return 1 }
  if3 contains(name, "image") { return 1 }
  if3 contains(name, "moondream") { return 1 }
  if3 contains(name, "-vl-") { return 1 }
  if3 contains(name, "qwen3-vl") { return 1 }
  return 0
}

fn _is_audio_model(name) {
  if3 contains(name, "whisper") { return 1 }
  if3 contains(name, "audio") { return 1 }
  if3 contains(name, "tts") { return 1 }
  if3 contains(name, "speech") { return 1 }
  return 0
}

fn _is_embedding_model(name) {
  if3 contains(name, "embed") { return 1 }
  if3 contains(name, "nomic") { return 1 }
  if3 contains(name, "bge") { return 1 }
  if3 contains(name, "e5-") { return 1 }
  if3 contains(name, "minilm") { return 1 }
  if3 contains(name, "mxbai") { return 1 }
  return 0
}

fn _is_fast_model(name) {
  if3 contains(name, "tiny") { return 1 }
  if3 contains(name, "mini") { return 1 }
  if3 contains(name, ":1b") { return 1 }
  if3 contains(name, "-1b") { return 1 }
  if3 contains(name, ":3b") { return 1 }
  if3 contains(name, "-3b") { return 1 }
  if3 contains(name, "phi-2") { return 1 }
  if3 contains(name, "gemma-2b") { return 1 }
  if3 contains(name, "flash") { return 1 }
  if3 contains(name, "haiku") { return 1 }
  if3 contains(name, "instant") { return 1 }
  if3 contains(name, "turbo") { return 1 }
  if3 contains(name, "-fast") { return 1 }
  if3 contains(name, "lite") { return 1 }
  if3 contains(name, "nano") { return 1 }
  return 0
}

fn _is_system_model(name) {
  if3 contains(name, "function") { return 1 }
  if3 contains(name, "tool") { return 1 }
  if3 contains(name, "agent") { return 1 }
  if3 contains(name, "computer-use") { return 1 }
  return 0
}

fn _build_piece(provider, model, territory, max_tokens) {
  let piece = {}
  piece = dict_set(piece, "provider", provider)
  piece = dict_set(piece, "model", model)
  piece = dict_set(piece, "territory", territory)
  piece = dict_set(piece, "max_tokens", max_tokens)
  piece = dict_set(piece, "wins", 0)
  piece = dict_set(piece, "losses", 0)
  piece = dict_set(piece, "active", 1)
  return piece
}

fn _max_tokens_for_territory(terr) {
  if3 terr == "code" { return GO_MAX_TOKENS_CODE }
  if3 terr == "reasoning" { return GO_MAX_TOKENS_REASONING }
  if3 terr == "image" { return GO_MAX_TOKENS_IMAGE }
  if3 terr == "audio" { return GO_MAX_TOKENS_AUDIO }
  if3 terr == "embedding" { return GO_MAX_TOKENS_EMBEDDING }
  if3 terr == "fast" { return GO_MAX_TOKENS_FAST }
  if3 terr == "system" { return 4096 }
  return GO_MAX_TOKENS_CHAT
}

fn go_classify_model(provider, model_name) {
  let name = lower(model_name)
  let territories = []
  if3 _is_code_model(name) == 1 { territories = append(territories, "code") }
  if3 _is_reasoning_model(name) == 1 { territories = append(territories, "reasoning") }
  if3 _is_image_model(name) == 1 { territories = append(territories, "image") }
  if3 _is_audio_model(name) == 1 { territories = append(territories, "audio") }
  if3 _is_embedding_model(name) == 1 { territories = append(territories, "embedding") }
  if3 _is_fast_model(name) == 1 { territories = append(territories, "fast") }
  if3 _is_system_model(name) == 1 { territories = append(territories, "system") }
  if3 len(territories) == 0 { territories = append(territories, "chat") }
  return territories
}

fn go_register_pieces(state, models_list) {
  let pieces = dict_get(state, "go_pieces") ?? {}
  let board = dict_get(state, "go_board") ?? {}
  let registered = 0
  let i = 0
  while3 i < len(models_list) {
    let m = models_list[i]
    let provider = dict_get(m, "provider") ?? "unknown"
    let model_name = dict_get(m, "model") ?? dict_get(m, "id") ?? "unknown"
    let terrs = go_classify_model(provider, model_name)
    let j = 0
    while3 j < len(terrs) {
      let terr = terrs[j]
      let max_tok = _max_tokens_for_territory(terr)
      let piece = _build_piece(provider, model_name, terr, max_tok)
      let piece_key = provider + ":" + model_name + ":" + terr
      pieces = dict_set(pieces, piece_key, piece)
      registered = registered + 1
      j = j + 1
    }
    i = i + 1
  }
  state = dict_set(state, "go_pieces", pieces)
  state = dict_set(state, "go_pieces_count", registered)
  return state
}

fn go_best_piece(state, territory) {
  let pieces = dict_get(state, "go_pieces") ?? {}
  let pkeys = keys(pieces)
  let best_key = ""
  let best_score = -999
  let i = 0
  while3 i < len(pkeys) {
    let pk = pkeys[i]
    let piece = dict_get(pieces, pk)
    let pterr = dict_get(piece, "territory") ?? ""
    if3 pterr == territory {
      let wins = dict_get(piece, "wins") ?? 0
      let losses = dict_get(piece, "losses") ?? 0
      let score = wins - losses
      if3 score > best_score {
        best_score = score
        best_key = pk
      }
    }
    i = i + 1
  }
  if3 best_key == "" { return {} }
  let best = dict_get(pieces, best_key) ?? {}
  return best
}

fn go_record_result(state, provider, model_name, territory, trit) {
  let pieces = dict_get(state, "go_pieces") ?? {}
  let piece_key = provider + ":" + model_name + ":" + territory
  let piece = dict_get(pieces, piece_key) ?? {}
  if3 len(keys(piece)) == 0 { return state }
  if3 trit == 1 {
    let w = (dict_get(piece, "wins") ?? 0) + 1
    piece = dict_set(piece, "wins", w)
  }
  if3 trit == -1 {
    let lo = (dict_get(piece, "losses") ?? 0) + 1
    piece = dict_set(piece, "losses", lo)
  }
  pieces = dict_set(pieces, piece_key, piece)
  state = dict_set(state, "go_pieces", pieces)
  return state
}

fn go_init(state) {
  let board = {}
  let ko_history = {}
  let groups = {}
  state = dict_set(state, "go_board", board)
  state = dict_set(state, "go_ko_history", ko_history)
  state = dict_set(state, "go_groups", groups)
  state = dict_set(state, "go_territory_scores", {})
  state = dict_set(state, "go_total_moves", 0)
  state = dict_set(state, "go_captures", 0)
  return state
}

// Place a stone: provider claims/loses a capability territory
fn go_place_stone(state, provider, territory, trit) {
  let board = dict_get(state, "go_board") ?? {}
  let ko = dict_get(state, "go_ko_history") ?? {}

  // Key = "provider:territory" (e.g. "openai:chat")
  let key = provider + ":" + territory

  // Ko check: is this position in lockout?
  let ko_entry = dict_get(ko, key) ?? null
  if3 ko_entry != null {
    let ko_time = dict_get(ko_entry, "until") ?? 0
    let now = time()
    if3 now < ko_time {
      return state
    }
  }

  // Check for ko condition: stone flipping between +1 and -1
  let old_stone = dict_get(board, key) ?? null
  if3 old_stone != null {
    let old_trit = dict_get(old_stone, "trit") ?? 0
    let flipped = _pick_val(old_trit != 0, 1, 0)
    let opp = _pick_val(trit != old_trit, 1, 0)
    if3 flipped == 1 {
      if3 opp == 1 {
        // Ko detected: lock this position
        let ko_entry2 = {}
        ko_entry2 = dict_set(ko_entry2, "until", time() + GO_KO_LOCKOUT)
        ko_entry2 = dict_set(ko_entry2, "provider", provider)
        ko_entry2 = dict_set(ko_entry2, "territory", territory)
        ko = dict_set(ko, key, ko_entry2)
        state = dict_set(state, "go_ko_history", ko)
        return state
      }
    }
  }

  // Place the stone
  let stone = {}
  stone = dict_set(stone, "provider", provider)
  stone = dict_set(stone, "territory", territory)
  stone = dict_set(stone, "trit", trit)
  stone = dict_set(stone, "placed_at", time())
  board = dict_set(board, key, stone)

  state = dict_set(state, "go_board", board)
  let tm = (dict_get(state, "go_total_moves") ?? 0) + 1
  state = dict_set(state, "go_total_moves", tm)

  return state
}

// Count liberties: how many healthy neighbors does a group have?
fn _count_liberties(board, provider, territory) {
  let liberties = 0
  let ti = 0
  while3 ti < len(GO_TERRITORIES) {
    let neighbor_terr = GO_TERRITORIES[ti]
    let nkey = provider + ":" + neighbor_terr
    let neighbor = dict_get(board, nkey) ?? null
    if3 neighbor != null {
      let ntrit = dict_get(neighbor, "trit") ?? 0
      if3 ntrit == 1 { liberties = liberties + 1 }
    }
    ti = ti + 1
  }
  return liberties
}

// Score a territory: who controls it?
fn _territory_control(black, white) {
  if3 black == 0 {
    if3 white == 0 { return "empty" }
    if3 white >= GO_DOMINATION_THRESHOLD { return "lost" }
    return "lost"
  }
  if3 white == 0 {
    if3 black >= GO_DOMINATION_THRESHOLD { return "dominated" }
    return "claimed"
  }
  // Both present: check ratio
  if3 black >= (white * GO_DOMINATION_THRESHOLD) { return "claimed" }
  if3 white >= (black * GO_DOMINATION_THRESHOLD) { return "lost" }
  return "contested"
}

fn _score_territory(board, territory) {
  let black = 0
  let white = 0
  let neutral = 0
  // Check all providers that have placed stones in this territory
  let bkeys = keys(board)
  let i = 0
  while3 i < len(bkeys) {
    let bk = bkeys[i]
    let stone = dict_get(board, bk)
    let st = dict_get(stone, "territory") ?? ""
    if3 st == territory {
      let trit = dict_get(stone, "trit") ?? 0
      if3 trit == 1 { black = black + 1 }
      if3 trit == -1 { white = white + 1 }
      if3 trit == 0 { neutral = neutral + 1 }
    }
    i = i + 1
  }
  // Determine territory control: dominated > claimed > contested > lost > empty
  // claimed = black present, no white OR black outnumbers white 3:1+
  // contested = both present but ratio too close
  // dominated = black >= H3 threshold AND no white
  let control = _territory_control(black, white)
  let result = {}
  result = dict_set(result, "territory", territory)
  result = dict_set(result, "black", black)
  result = dict_set(result, "white", white)
  result = dict_set(result, "neutral", neutral)
  result = dict_set(result, "control", control)
  result = dict_set(result, "total_stones", black + white + neutral)
  return result
}

// Full board evaluation: score every territory
fn go_evaluate(state) {
  let board = dict_get(state, "go_board") ?? {}
  let scores = {}
  let dominated = 0
  let claimed = 0
  let contested = 0
  let lost = 0
  let empty = 0

  let i = 0
  while3 i < len(GO_TERRITORIES) {
    let terr = GO_TERRITORIES[i]
    let sc = _score_territory(board, terr)
    scores = dict_set(scores, terr, sc)
    let ctrl = dict_get(sc, "control") ?? "empty"
    if3 ctrl == "dominated" { dominated = dominated + 1 }
    if3 ctrl == "claimed" { claimed = claimed + 1 }
    if3 ctrl == "contested" { contested = contested + 1 }
    if3 ctrl == "lost" { lost = lost + 1 }
    if3 ctrl == "empty" { empty = empty + 1 }
    i = i + 1
  }

  state = dict_set(state, "go_territory_scores", scores)
  let result = {}
  result = dict_set(result, "territories", scores)
  result = dict_set(result, "dominated", dominated)
  result = dict_set(result, "claimed", claimed)
  result = dict_set(result, "contested", contested)
  result = dict_set(result, "lost", lost)
  result = dict_set(result, "empty", empty)
  result = dict_set(result, "total_territories", len(GO_TERRITORIES))
  // Go score = dominated + claimed - lost (like territory counting in Go)
  let go_score = (dominated * 3) + claimed - (lost * 3) - contested
  result = dict_set(result, "go_score", go_score)
  // Territory coverage as percentage
  let coverage = ((dominated + claimed) * 100) / len(GO_TERRITORIES)
  result = dict_set(result, "coverage_pct", coverage)
  return result
}

// Strategic recommendation: where should we expand?

fn _make_rec(terr, priority, reason) {
  let rec = {}
  rec = dict_set(rec, "territory", terr)
  rec = dict_set(rec, "priority", priority)
  rec = dict_set(rec, "reason", reason)
  return rec
}

fn go_recommend_expansion(state) {
  let board = dict_get(state, "go_board") ?? {}
  let recommendations = []
  let i = 0
  while3 i < len(GO_TERRITORIES) {
    let terr = GO_TERRITORIES[i]
    let sc = _score_territory(board, terr)
    let ctrl = dict_get(sc, "control") ?? "empty"
    if3 ctrl == "empty" {
      recommendations = append(recommendations, _make_rec(terr, "high", "unclaimed"))
    }
    if3 ctrl == "contested" {
      recommendations = append(recommendations, _make_rec(terr, "medium", "contested"))
    }
    i = i + 1
  }
  return recommendations
}

// Combined Chess+Go strategic status
fn strategy_status(state) {
  let chess = dict_get(state, "resonance_score") ?? 0
  let prime = dict_get(state, "prime_locked") ?? 0
  let go_eval = go_evaluate(state)
  let go_score = dict_get(go_eval, "go_score") ?? 0
  let coverage = dict_get(go_eval, "coverage_pct") ?? 0
  let recs = go_recommend_expansion(state)

  let result = {}
  result = dict_set(result, "chess_score", chess)
  result = dict_set(result, "chess_prime_locked", prime)
  result = dict_set(result, "go_score", go_score)
  result = dict_set(result, "go_coverage_pct", coverage)
  result = dict_set(result, "go_territories", dict_get(go_eval, "territories"))
  result = dict_set(result, "go_expansion", recs)
  // Combined strategy score: chess (tactical) + go (territorial)
  let combined = chess + go_score
  result = dict_set(result, "combined_strategy", combined)
  // Yin-yang harmony: when both are high, the system is in true balance
  let harmony = _pick_val(chess > 50, 1, 0)
  let go_strong = _pick_val(go_score > 3, 1, 0)
  let balanced = _pick_val(harmony == 1, go_strong, 0)
  result = dict_set(result, "yin_yang_balance", balanced)
  return result
}

// ==================================================================
// STRATEGIC CONTROLLER — Chess/Go brain that CONTROLS the fleet
// ==================================================================
// Chess = tactical (next move). Go = territorial (what to invest in).
// Together they form the forcing function that shapes fleet behavior.
//
// Control channels:
//   1. Go -> Tripple: adjust provider frequencies by territory control
//   2. Go -> Hivemind: shift modulation by capability coverage
//   3. Go -> Fleet: scale/prioritize services by Go score
//
// This is the thermostat, not the thermometer.
// ==================================================================

// Modulation levels mapped to territory control
let MOD_DOMINATED = 1024  // 1024QAM — max throughput
let MOD_CLAIMED   = 256   // 256QAM — good throughput
let MOD_CONTESTED = 64    // 64QAM — balanced
let MOD_EMPTY     = 4     // BPSK — minimal, probing only
let MOD_LOST      = 1     // off — shut down channel

// -- CONTROL 1: Go -> Tripple frequency tuning --
// Adjusts provider frequencies based on which territories they dominate

fn _territory_to_freq_boost(control) {
  if3 control == "dominated" { return 500 }
  if3 control == "claimed" { return 200 }
  if3 control == "contested" { return 0 }
  if3 control == "lost" { return -300 }
  return -100
}

fn go_control_tripple(state) {
  let board = dict_get(state, "go_board") ?? {}
  let providers = dict_get(state, "providers") ?? {}
  let pkeys = dict_keys(providers)
  let commands = []

  // Evaluate each territory, then boost/dampen providers accordingly
  let ti = 0
  while3 ti < len(GO_TERRITORIES) {
    let terr = GO_TERRITORIES[ti]
    let sc = _score_territory(board, terr)
    let ctrl = dict_get(sc, "control") ?? "empty"
    let freq_delta = _territory_to_freq_boost(ctrl)

    // Find providers with stones in this territory and adjust
    let bkeys = keys(board)
    let bi = 0
    while3 bi < len(bkeys) {
      let bk = bkeys[bi]
      let stone = dict_get(board, bk)
      let st = dict_get(stone, "territory") ?? ""
      if3 st == terr {
        let sprov = dict_get(stone, "provider") ?? ""
        let strit = dict_get(stone, "trit") ?? 0
        // Only boost providers with positive stones
        if3 strit == 1 {
          let prov = dict_get(providers, sprov) ?? null
          if3 prov != null {
            let cur_freq = dict_get(prov, "current_freq") ?? 500
            let new_freq = cur_freq + freq_delta
            new_freq = _clamp(new_freq, 50, 2187)
            prov = dict_set(prov, "current_freq", new_freq)
            providers = dict_set(providers, sprov, prov)
            let cmd = {}
            cmd = dict_set(cmd, "target", "tripple")
            cmd = dict_set(cmd, "provider", sprov)
            cmd = dict_set(cmd, "territory", terr)
            cmd = dict_set(cmd, "action", "freq_adjust")
            cmd = dict_set(cmd, "delta", freq_delta)
            cmd = dict_set(cmd, "new_freq", new_freq)
            commands = append(commands, cmd)
          }
        }
      }
      bi = bi + 1
    }
    ti = ti + 1
  }

  state = dict_set(state, "providers", providers)
  let result = {}
  result = dict_set(result, "state", state)
  result = dict_set(result, "commands", commands)
  result = dict_set(result, "command_count", len(commands))
  return result
}

// -- CONTROL 2: Go -> Hivemind modulation tuning --
// Maps territory control to modulation level, sends to Hivemind

fn _control_to_modulation(control) {
  if3 control == "dominated" { return MOD_DOMINATED }
  if3 control == "claimed" { return MOD_CLAIMED }
  if3 control == "contested" { return MOD_CONTESTED }
  if3 control == "lost" { return MOD_LOST }
  return MOD_EMPTY
}

fn _safe_hive_post(body) {
  let r = try3 { http_post("http://127.0.0.1:9881/api/v1/modulation/update", body) } { 0 }
  return r
}

fn go_control_hivemind(state) {
  let board = dict_get(state, "go_board") ?? {}
  let commands = []

  let ti = 0
  while3 ti < len(GO_TERRITORIES) {
    let terr = GO_TERRITORIES[ti]
    let sc = _score_territory(board, terr)
    let ctrl = dict_get(sc, "control") ?? "empty"
    let mod_level = _control_to_modulation(ctrl)

    // Send modulation command to Hivemind
    let hive_cmd = json_encode({"source": "go_engine", "territory": terr, "control": ctrl, "modulation": mod_level, "channel": terr})
    _safe_hive_post(hive_cmd)

    let cmd = {}
    cmd = dict_set(cmd, "target", "hivemind")
    cmd = dict_set(cmd, "territory", terr)
    cmd = dict_set(cmd, "control", ctrl)
    cmd = dict_set(cmd, "modulation", mod_level)
    cmd = dict_set(cmd, "action", "mod_adjust")
    commands = append(commands, cmd)
    ti = ti + 1
  }

  let result = {}
  result = dict_set(result, "commands", commands)
  result = dict_set(result, "command_count", len(commands))
  return result
}

// -- CONTROL 3: Go -> Fleet scaling directives --
// Analyzes Go score + expansion recommendations, emits fleet commands

fn _safe_fleet_post(url, body) {
  let r = try3 { http_post(url, body) } { 0 }
  return r
}

fn go_control_fleet(state) {
  let eval_result = go_evaluate(state)
  let go_score = dict_get(eval_result, "go_score") ?? 0
  let coverage = dict_get(eval_result, "coverage_pct") ?? 0
  let recs = go_recommend_expansion(state)
  let commands = []

  // High-priority expansions: tell orchestrator to prioritize these capabilities
  let ri = 0
  while3 ri < len(recs) {
    let rec = recs[ri]
    let terr = dict_get(rec, "territory") ?? ""
    let priority = dict_get(rec, "priority") ?? "low"

    if3 priority == "high" {
      // Tell orchestrator to prioritize services covering this territory
      let fleet_cmd = json_encode({"source": "go_engine", "action": "prioritize_territory", "territory": terr, "go_score": go_score, "coverage_pct": coverage})
      _safe_fleet_post("http://127.0.0.1:9999/api/fleet/directive", fleet_cmd)

      let cmd = {}
      cmd = dict_set(cmd, "target", "fleet")
      cmd = dict_set(cmd, "territory", terr)
      cmd = dict_set(cmd, "action", "expand")
      cmd = dict_set(cmd, "priority", priority)
      commands = append(commands, cmd)
    }
    ri = ri + 1
  }

  // Global fleet scaling based on coverage
  let scale_action = "hold"
  if3 coverage > 85 { scale_action = "optimize" }
  if3 coverage < 30 { scale_action = "expand" }

  let global_cmd = json_encode({"source": "go_engine", "action": scale_action, "go_score": go_score, "coverage_pct": coverage})
  _safe_fleet_post("http://127.0.0.1:9999/api/fleet/scale", global_cmd)

  let cmd2 = {}
  cmd2 = dict_set(cmd2, "target", "fleet")
  cmd2 = dict_set(cmd2, "action", scale_action)
  cmd2 = dict_set(cmd2, "go_score", go_score)
  cmd2 = dict_set(cmd2, "coverage", coverage)
  commands = append(commands, cmd2)

  let result = {}
  result = dict_set(result, "commands", commands)
  result = dict_set(result, "command_count", len(commands))
  result = dict_set(result, "go_score", go_score)
  result = dict_set(result, "coverage_pct", coverage)
  result = dict_set(result, "scale_action", scale_action)
  return result
}

// -- MASTER CONTROL: Run all three control channels --
// This is the main strategic loop. Call this periodically (every 2187ms = 3^7)

fn go_strategic_control(state) {
  // 1. Evaluate the board
  let eval_result = go_evaluate(state)
  let go_score = dict_get(eval_result, "go_score") ?? 0

  // 2. Control Tripple frequencies
  let tripple_ctrl = go_control_tripple(state)
  state = dict_get(tripple_ctrl, "state")
  let t_cmds = dict_get(tripple_ctrl, "commands") ?? []

  // 3. Control Hivemind modulation
  let hive_ctrl = go_control_hivemind(state)
  let h_cmds = dict_get(hive_ctrl, "commands") ?? []

  // 4. Control fleet scaling
  let fleet_ctrl = go_control_fleet(state)
  let f_cmds = dict_get(fleet_ctrl, "commands") ?? []

  // 5. Run chess resonance check (tactical layer)
  state = tripple_resonance_check(state)
  let chess_score = dict_get(state, "resonance_score") ?? 0
  let prime = dict_get(state, "prime_locked") ?? 0

  // 6. Save eval and update control timestamp
  state = dict_set(state, "go_last_eval", eval_result)
  state = dict_set(state, "go_score", go_score)
  state = dict_set(state, "go_last_control", time())
  let ctrl_count = (dict_get(state, "go_control_runs") ?? 0) + 1
  state = dict_set(state, "go_control_runs", ctrl_count)

  // 7. Build combined control report
  let report = {}
  report = dict_set(report, "state", state)
  report = dict_set(report, "chess_score", chess_score)
  report = dict_set(report, "chess_prime_locked", prime)
  report = dict_set(report, "go_score", go_score)
  report = dict_set(report, "go_eval", eval_result)
  report = dict_set(report, "tripple_commands", t_cmds)
  report = dict_set(report, "hivemind_commands", h_cmds)
  report = dict_set(report, "fleet_commands", f_cmds)
  let total_cmds = len(t_cmds) + len(h_cmds) + len(f_cmds)
  report = dict_set(report, "total_commands", total_cmds)
  report = dict_set(report, "control_run", ctrl_count)

  // Yin-yang: when chess + go are both strong, system is in harmony
  let harmony = 0
  if3 chess_score > 50 {
    if3 go_score > 3 { harmony = 1 }
  }
  report = dict_set(report, "yin_yang_harmony", harmony)

  return report
}

// ═══════════════════════════════════════════════════════════════════
// COMPLEMENTARY MATHEMATICAL FRAMEWORKS
// Shannon Entropy + Boltzmann Routing + Queue Theory + Lyapunov
// ═══════════════════════════════════════════════════════════════════

// ── Shannon Entropy ─────────────────────────────────────────────
// H(X) = -Σ p(x) log₂(p(x))
// Measures routing diversity across providers/models
// H_max = log₂(N) when all providers get equal traffic
// H → 0 when all traffic hits one provider (dangerous)

fn _log2(x) {
  // log₂(x) = ln(x) / ln(2) ≈ ln(x) / 0.693147
  if3 x <= 0 { return 0 }
  // Natural log approximation using series for small x near 1
  // For arbitrary x, use: log2(x) = log2(mantissa) + exponent
  // Simpler: use the identity ln(x) = 2 * atanh((x-1)/(x+1))
  // But NovaLang has no atanh. Use iterative: ln(x) via repeated sqrt
  // Actually, use change-of-base with the built-in log if available
  // Fallback: bit-counting approximation for integers
  let result = 0
  let v = x
  // Scale to [1, 2) range
  let exp_count = 0
  while3 v >= 2 {
    v = v / 2
    exp_count = exp_count + 1
  }
  while3 v < 1 {
    v = v * 2
    exp_count = exp_count - 1
  }
  // v is now in [1, 2). Use polynomial approx: log2(v) ≈ (v-1) - (v-1)²/2 + (v-1)³/3 ... / ln(2)
  let d = v - 1
  let ln_v = d - (d * d / 2) + (d * d * d / 3) - (d * d * d * d / 4) + (d * d * d * d * d / 5)
  result = (ln_v / 0.693147) + exp_count
  return result
}

fn tripple_entropy(state) {
  // Compute Shannon entropy of routing distribution across providers
  let providers = dict_get(state, "providers") ?? {}
  let pkeys = keys(providers)
  let total_queries = 0
  let counts = []

  // Sum all provider queries
  let i = 0
  while3 i < len(pkeys) {
    let pk = pkeys[i]
    let prov = dict_get(providers, pk) ?? {}
    let q = dict_get(prov, "queries") ?? 0
    counts = append(counts, q)
    total_queries = total_queries + q
    i = i + 1
  }

  if3 total_queries == 0 {
    return {
      "entropy": 0,
      "max_entropy": 0,
      "diversity_ratio": 0,
      "provider_count": len(pkeys),
      "total_queries": 0,
      "trit": -1,
      "regime": "empty"
    }
  }

  // H = -Σ p(x) * log₂(p(x))
  let h = 0
  let j = 0
  while3 j < len(counts) {
    let c = counts[j]
    if3 c > 0 {
      let p = c / total_queries
      let log_p = _log2(p)
      h = h - (p * log_p)
    }
    j = j + 1
  }

  let n = len(pkeys)
  let h_max = _log2(n)
  let diversity = 0
  if3 h_max > 0 { diversity = h / h_max }

  // Ternary classification
  let trit = 0
  let regime = "balanced"
  if3 diversity > 0.7 {
    trit = 1
    regime = "diverse"
  }
  if3 diversity < 0.3 {
    trit = -1
    regime = "concentrated"
  }

  return {
    "entropy": h,
    "max_entropy": h_max,
    "diversity_ratio": diversity,
    "provider_count": n,
    "total_queries": total_queries,
    "trit": trit,
    "regime": regime
  }
}

fn tripple_mirror_entropy(state) {
  // Entropy across ability categories — measures how diverse the model fleet is
  let abilities = dict_get(state, "mirror_abilities") ?? {}
  let akeys = keys(abilities)
  let total = 0
  let i = 0
  while3 i < len(akeys) {
    let ak = akeys[i]
    let c = dict_get(abilities, ak) ?? 0
    total = total + c
    i = i + 1
  }

  if3 total == 0 {
    return {"entropy": 0, "max_entropy": 0, "diversity_ratio": 0, "trit": -1}
  }

  let h = 0
  let j = 0
  while3 j < len(akeys) {
    let ak = akeys[j]
    let c = dict_get(abilities, ak) ?? 0
    if3 c > 0 {
      let p = c / total
      h = h - (p * _log2(p))
    }
    j = j + 1
  }

  let h_max = _log2(len(akeys))
  let div = 0
  if3 h_max > 0 { div = h / h_max }

  let trit = 0
  if3 div > 0.7 { trit = 1 }
  if3 div < 0.3 { trit = -1 }

  return {
    "entropy": h,
    "max_entropy": h_max,
    "diversity_ratio": div,
    "ability_count": len(akeys),
    "total_assignments": total,
    "trit": trit
  }
}

// ── Boltzmann Routing ───────────────────────────────────────────
// P(model_i) = exp(-cost_i / T) / Z
// where Z = Σ exp(-cost_j / T) — partition function
// T = temperature: high T → explore (uniform), low T → exploit (best only)
// cost_i = latency_ms / 1000 (normalized seconds)

fn _exp_approx(x) {
  // exp(x) approximation using Taylor series (6 terms)
  // Good for |x| < 10
  let clamped = x
  if3 clamped > 10 { clamped = 10 }
  if3 clamped < -10 { clamped = -10 }
  let result = 1 + clamped
  let term = clamped * clamped / 2
  result = result + term
  term = term * clamped / 3
  result = result + term
  term = term * clamped / 4
  result = result + term
  term = term * clamped / 5
  result = result + term
  term = term * clamped / 6
  result = result + term
  term = term * clamped / 7
  result = result + term
  if3 result < 0.0001 { result = 0.0001 }
  return result
}

fn tripple_boltzmann_route(state, temperature) {
  // Compute Boltzmann routing probabilities for each provider
  // Lower cost (latency) → higher probability
  // Temperature controls explore/exploit tradeoff
  let providers = dict_get(state, "providers") ?? {}
  let pkeys = keys(providers)

  if3 len(pkeys) == 0 {
    return {"probabilities": {}, "partition_Z": 0, "temperature": temperature, "trit": -1}
  }

  let t = temperature
  if3 t <= 0 { t = 0.1 }

  // Compute exp(-cost/T) for each provider
  let weights = {}
  let z = 0
  let i = 0
  while3 i < len(pkeys) {
    let pk = pkeys[i]
    let prov = dict_get(providers, pk) ?? {}
    let latency = dict_get(prov, "avg_latency") ?? 1000
    let trit_sum = dict_get(prov, "trit_sum") ?? 0
    // Cost = latency/1000 - trit_bonus (good trits reduce cost)
    let cost = (latency / 1000) - (trit_sum / 10)
    if3 cost < 0 { cost = 0 }
    let w = _exp_approx(0 - cost / t)
    weights = dict_set(weights, pk, w)
    z = z + w
    i = i + 1
  }

  // Normalize to probabilities
  let probs = {}
  let best_provider = ""
  let best_prob = 0
  let j = 0
  while3 j < len(pkeys) {
    let pk = pkeys[j]
    let w = dict_get(weights, pk) ?? 0
    let p = 0
    if3 z > 0 { p = w / z }
    probs = dict_set(probs, pk, p)
    if3 p > best_prob {
      best_prob = p
      best_provider = pk
    }
    j = j + 1
  }

  // Free energy: F = -T * ln(Z)
  let free_energy = 0 - (t * _log2(z) * 0.693147)

  let trit = 0
  if3 best_prob > 0.5 { trit = 1 }
  if3 best_prob < 0.2 { trit = -1 }

  return {
    "probabilities": probs,
    "partition_Z": z,
    "free_energy": free_energy,
    "temperature": t,
    "best_provider": best_provider,
    "best_probability": best_prob,
    "trit": trit
  }
}

// ── Queue Theory (M/M/c) ───────────────────────────────────────
// ρ = λ/(c·μ) — utilization per server
// L = ρ/(1-ρ) — mean queue length (M/M/1)
// W = 1/(μ-λ) — mean wait time

fn tripple_queue_pressure(state) {
  // Compute queue utilization (rho) per provider
  // Maps to Reynolds number: rho → Re scaling
  let providers = dict_get(state, "providers") ?? {}
  let pkeys = keys(providers)
  let pressures = {}
  let total_rho = 0
  let max_rho = 0
  let overloaded = 0

  let i = 0
  while3 i < len(pkeys) {
    let pk = pkeys[i]
    let prov = dict_get(providers, pk) ?? {}
    let queries = dict_get(prov, "queries") ?? 0
    let latency = dict_get(prov, "avg_latency") ?? 1000
    // λ = queries per unit time (approximate from total queries / uptime)
    // μ = 1000/latency (completions per second)
    let mu = 1000 / (latency + 1)
    // For simplicity, estimate λ from query rate (queries / time_window)
    // Use queries as a proxy scaled by latency
    let rho = 0
    if3 mu > 0 {
      // Approximate: rho = (queries * latency) / (queries * 1000) = latency/1000
      // Better: use trit_sum as quality signal
      rho = latency / 1000
      if3 rho > 1 { rho = 1 }
    }
    // Queue length estimate (M/M/1)
    let queue_len = 0
    if3 rho < 0.99 { queue_len = rho / (1 - rho) }
    if3 rho >= 0.99 { queue_len = 100 }
    // Wait time estimate
    let wait = 0
    if3 rho < 0.99 { wait = latency / (1 - rho) }
    if3 rho >= 0.99 { wait = 99999 }

    let p_entry = {
      "rho": rho,
      "mu": mu,
      "queue_length": queue_len,
      "wait_ms": wait,
      "latency_ms": latency
    }
    pressures = dict_set(pressures, pk, p_entry)
    total_rho = total_rho + rho
    if3 rho > max_rho { max_rho = rho }
    if3 rho > 0.7 { overloaded = overloaded + 1 }
    i = i + 1
  }

  let n = len(pkeys)
  let avg_rho = 0
  if3 n > 0 { avg_rho = total_rho / n }

  // Map to Reynolds: rho * 343 (turbulent boundary)
  let queue_reynolds = avg_rho * 343

  // Ternary classification
  let trit = 0
  let regime = "balanced"
  if3 avg_rho < 0.3 {
    trit = 1
    regime = "light"
  }
  if3 avg_rho > 0.7 {
    trit = -1
    regime = "congested"
  }

  return {
    "pressures": pressures,
    "avg_rho": avg_rho,
    "max_rho": max_rho,
    "queue_reynolds": queue_reynolds,
    "overloaded_count": overloaded,
    "provider_count": n,
    "trit": trit,
    "regime": regime
  }
}

// ── Lyapunov Stability ──────────────────────────────────────────
// λ_max > 0 → chaotic (system diverging)
// λ_max ≈ 0 → marginal (edge of stability)
// λ_max < 0 → stable (system converging)
// Approximated from rate of change of system error

fn tripple_lyapunov(state) {
  // Estimate Lyapunov exponent from system state changes
  // Uses the "error energy" V = Σ(latency_error² + failure²)
  let providers = dict_get(state, "providers") ?? {}
  let pkeys = keys(providers)
  let total_error_sq = 0
  let total_trit_abs = 0
  let n = len(pkeys)

  let i = 0
  while3 i < n {
    let pk = pkeys[i]
    let prov = dict_get(providers, pk) ?? {}
    let latency = dict_get(prov, "avg_latency") ?? 0
    let trit_sum = dict_get(prov, "trit_sum") ?? 0
    let queries = dict_get(prov, "queries") ?? 0
    // Error = deviation from ideal (low latency, positive trits)
    let lat_err = (latency - 200) / 1000
    if3 lat_err < 0 { lat_err = 0 }
    let trit_err = 0
    if3 queries > 0 {
      // trit should be positive; negative trits = error
      let avg_trit = trit_sum / queries
      if3 avg_trit < 0 { trit_err = 0 - avg_trit }
    }
    total_error_sq = total_error_sq + (lat_err * lat_err) + (trit_err * trit_err)
    i = i + 1
  }

  // V(x) = total_error_sq — the Lyapunov function
  let v = total_error_sq

  // Estimate dV/dt from consecutive states (use ripple count as time proxy)
  let ripples = dict_get(state, "total_ripples") ?? 0
  let prev_v = dict_get(state, "_lyapunov_prev_v") ?? 0
  let dv_dt = 0
  if3 ripples > 0 {
    dv_dt = (v - prev_v) / (ripples + 1)
  }

  // Lyapunov exponent estimate
  let lambda_est = 0
  if3 v > 0.001 {
    lambda_est = dv_dt / v
  }

  // Ternary: stable / marginal / chaotic
  let trit = 0
  let stability = "marginal"
  if3 lambda_est < -0.01 {
    trit = 1
    stability = "stable"
  }
  if3 lambda_est > 0.01 {
    trit = -1
    stability = "chaotic"
  }

  // Predictability horizon T_L = 1/|lambda|
  let horizon = 999
  if3 lambda_est > 0.001 { horizon = 1 / lambda_est }
  if3 lambda_est < -0.001 { horizon = 1 / (0 - lambda_est) }

  return {
    "lyapunov_V": v,
    "dV_dt": dv_dt,
    "lambda": lambda_est,
    "predictability_horizon": horizon,
    "stability": stability,
    "trit": trit,
    "_store_v": v
  }
}

// ── Unified Framework ───────────────────────────────────────────
// F[routing] = U[latency,errors] - T*S[diversity] + λ*Constraint[capacity]
// Combines all frameworks into a single routing score

fn tripple_unified_score(state, temperature) {
  let entropy = tripple_entropy(state)
  let queue = tripple_queue_pressure(state)
  let lyap = tripple_lyapunov(state)
  let boltz = tripple_boltzmann_route(state, temperature)

  // U = internal energy (latency + errors)
  let u = queue["avg_rho"]

  // S = entropy (diversity)
  let s = entropy["diversity_ratio"]

  // T = temperature
  let t = temperature
  if3 t <= 0 { t = 1 }

  // F = U - T*S (free energy minimization)
  let f = u - (t * s)

  // Add Lyapunov penalty for instability
  let lyap_penalty = 0
  let lam = lyap["lambda"]
  if3 lam > 0 { lyap_penalty = lam * 10 }
  f = f + lyap_penalty

  // Overall system trit
  let trit = 0
  let health = "nominal"
  if3 f < -0.3 {
    trit = 1
    health = "optimal"
  }
  if3 f > 0.3 {
    trit = -1
    health = "stressed"
  }

  return {
    "free_energy": f,
    "internal_energy_U": u,
    "entropy_S": s,
    "temperature_T": t,
    "lyapunov_penalty": lyap_penalty,
    "entropy": entropy,
    "queue": queue,
    "lyapunov": lyap,
    "boltzmann": boltz,
    "trit": trit,
    "health": health
  }
}

// ═══════════════════════════════════════════════════════════════════
// CHLADNI MODULATION LAYER — Standing Wave Skill Organization
// ═══════════════════════════════════════════════════════════════════
// Inspired by Chladni figures (Ernst Chladni, 1787): vibrate a plate
// at specific frequencies and sand arranges into geometric patterns
// at nodal lines. Each eigenmode = a skill domain.
//
// In NovaX: models are "sand grains" on a 2D plate. The plate
// vibrates at harmonic frequencies (H3/H5/H7/H13). Models settle
// into SKILL DOMAINS at anti-nodes (peak resonance points).
//
// Eigenmode formula: z(x,y) = sin(m*pi*x/L) * sin(n*pi*y/L)
//   m,n = mode numbers from 3-5-7-13 harmonics
//   z > 0: anti-node (model excels in this domain)
//   z = 0: nodal line (model is neutral)
//   z < 0: anti-node of opposite phase (model should avoid this domain)
//
// The Chladni layer enables:
//   1. Automatic skill discovery from query results
//   2. Skill routing: match incoming queries to best-skilled models
//   3. Skill sharing: models at nearby positions on the plate can
//      share knowledge via coupled resonance (Helmholtz)
//   4. Domain specialization: as more queries flow, models drift
//      toward their natural anti-nodes (strongest skill areas)
// ═══════════════════════════════════════════════════════════════════

// ── Chladni Constants ──────────────────────────────────────────────
let CHLADNI_PLATE_SIZE = 1000      // Plate size L (scaled)
let CHLADNI_MODE_PAIRS = [         // (m,n) eigenmode pairs from harmonics
    [3, 5],    // Mode 1: code/math (analytical)
    [5, 7],    // Mode 2: reasoning/logic
    [3, 7],    // Mode 3: creative/language
    [5, 13],   // Mode 4: search/retrieval
    [7, 13],   // Mode 5: vision/multimodal
    [3, 13],   // Mode 6: system/agent
    [3, 3],    // Mode 7: fast/efficient
    [5, 5],    // Mode 8: flagship/deep
    [7, 7]     // Mode 9: specialist/domain
]

// Skill domain names mapped to mode indices
let CHLADNI_DOMAINS = {
    "code": 0, "math": 0,
    "reasoning": 1,
    "chat": 2, "creative": 2,
    "search": 3, "embedding": 3,
    "vision": 4, "audio": 4, "video": 4,
    "system": 5, "agent": 5,
    "fast": 6,
    "flagship": 7,
    "specialist": 8, "stt": 8, "tts": 8
}

// ── Chladni eigenmode: compute z(x,y) for mode (m,n) ──────────────
// Returns value -1000 to +1000 (scaled integer)
// z = sin(m*pi*x/L) * sin(n*pi*y/L) * 1000
// Uses integer sin approximation: sin_approx(angle_millirads)

fn _sin_approx(angle_mr) {
    // Reduce to [0, 6283] milliradians (2*PI*1000)
    let a = angle_mr % 6283
    if3 a < 0 { a = a + 6283 }
    // Bhaskara I formula: sin(x) ≈ 16x(π-x) / (5π² - 4x(π-x))
    // Returns -1000 to +1000 (representing -1.0 to +1.0)
    let half = 3142  // PI * 1000
    let negate = 1
    if3 a > half {
        a = a - half
        negate = -1
    }
    // prod = a * (π - a), max at a=π/2 where prod = (π/2)²
    // Using i64 so no overflow: max prod = 3142*1571 ≈ 4.9M, well within range
    let diff = half - a
    let prod = a * diff
    // num = 16 * prod
    let num = 16 * prod
    // den = 5π² - 4*prod
    let pi_sq = half * half
    let den = 5 * pi_sq - 4 * prod
    if3 den == 0 { return 1000 * negate }
    // result = num/den gives 0.0 to 1.0, multiply by 1000
    let result = (num * 1000) / den
    return result * negate
}

fn chladni_eigenmode(m, n, x, y) {
    // angle_x = m * PI * x / L (in milliradians)
    let angle_x = (m * 3142 * x) / CHLADNI_PLATE_SIZE
    // angle_y = n * PI * y / L
    let angle_y = (n * 3142 * y) / CHLADNI_PLATE_SIZE
    let sx = _sin_approx(angle_x)
    let sy = _sin_approx(angle_y)
    // z = sx * sy / 1000 (keep in -1000 to +1000 range)
    return (sx * sy) / 1000
}

// ── Map a model to a position on the Chladni plate ─────────────────
// Position is determined by the model's abilities and performance.
// x = hash of model name (deterministic placement)
// y = success_rate normalized to plate size

fn _model_plate_position(model_id, success_rate) {
    // x from model name hash (deterministic placement on plate)
    let h = hash(model_id)
    if3 h < 0 { h = 0 - h }
    let x = (h % CHLADNI_PLATE_SIZE)
    // Avoid x=0 (nodal line where all sin=0)
    if3 x < 10 { x = x + 50 }
    // y from success rate (0-1000 mapped to 0-PLATE_SIZE)
    let y = success_rate
    // Avoid y=0 (nodal line)
    if3 y < 10 { y = y + 50 }
    return {"x": x, "y": y}
}

// ── Compute a model's skill resonance across all modes ─────────────
// Returns a dict of {domain_name: resonance_score} where score is
// the absolute value of z at the model's position for that mode.
// High |z| = strong anti-node = model belongs in this domain.

fn chladni_skill_resonance(model_id, success_rate) {
    let pos = _model_plate_position(model_id, success_rate)
    let x = dict_get(pos, "x") ?? 500
    let y = dict_get(pos, "y") ?? 500

    let skills = {}
    let mi = 0
    while3 mi < len(CHLADNI_MODE_PAIRS) {
        let pair = CHLADNI_MODE_PAIRS[mi]
        let m = pair[0]
        let n = pair[1]
        let z = chladni_eigenmode(m, n, x, y)
        // Absolute value = resonance strength (both anti-nodes count)
        let strength = z
        if3 strength < 0 { strength = 0 - strength }
        skills = dict_set(skills, str(mi), strength)
        mi = mi + 1
    }
    return skills
}

// ── Chladni State Init ─────────────────────────────────────────────
fn chladni_init(state) {
    state = dict_set(state, "chladni_plate", {})          // model_id -> {x, y, skills, domain}
    state = dict_set(state, "chladni_domains", {})         // domain -> [model_ids]
    state = dict_set(state, "chladni_skill_matrix", {})    // domain -> {total_strength, model_count, avg_strength}
    state = dict_set(state, "chladni_crosslinks", {})      // model_id -> [shared_skill_partners]
    state = dict_set(state, "chladni_total_placed", 0)
    state = dict_set(state, "chladni_version", "1.0.0")
    return state
}

// ── Place a model on the Chladni plate ─────────────────────────────
// Called when a model produces a successful query. Maps the model
// to its natural skill domain based on eigenmode resonance.
// Also discovers cross-links (models that share skill domains).

fn chladni_place_model(state, model_id, provider, success_rate, abilities) {
    let plate = dict_get(state, "chladni_plate") ?? {}
    let domains = dict_get(state, "chladni_domains") ?? {}
    let matrix = dict_get(state, "chladni_skill_matrix") ?? {}

    // Compute plate position and skill resonance
    let pos = _model_plate_position(model_id, success_rate)
    let skills = chladni_skill_resonance(model_id, success_rate)

    // Find the model's strongest domain (highest |z|)
    let best_domain_idx = 0
    let best_strength = 0
    let si = 0
    while3 si < 9 {
        let s = dict_get(skills, str(si)) ?? 0
        if3 s > best_strength {
            best_strength = s
            best_domain_idx = si
        }
        si = si + 1
    }

    // Map domain index to domain names
    let domain_names = ["code", "reasoning", "chat", "search", "vision", "system", "fast", "flagship", "specialist"]
    let primary_domain = domain_names[best_domain_idx]

    // Override with actual abilities if they match a domain better
    let ab_keys = keys(abilities)
    let abi = 0
    while3 abi < len(ab_keys) {
        let ak = ab_keys[abi]
        let domain_idx = dict_get(CHLADNI_DOMAINS, ak) ?? -1
        if3 domain_idx >= 0 {
            let ab_strength = dict_get(skills, str(domain_idx)) ?? 0
            if3 ab_strength > best_strength / 2 {
                primary_domain = ak
            }
        }
        abi = abi + 1
    }

    // Create plate entry
    let entry = {
        "model": model_id,
        "provider": provider,
        "x": dict_get(pos, "x") ?? 0,
        "y": dict_get(pos, "y") ?? 0,
        "domain": primary_domain,
        "strength": best_strength,
        "skills": skills,
        "abilities": abilities,
        "placed_at": time()
    }

    plate = dict_set(plate, model_id, entry)

    // Add to domain list
    let domain_list = dict_get(domains, primary_domain) ?? []
    // Check if already in list
    let already = false
    let dli = 0
    while3 dli < len(domain_list) {
        if3 domain_list[dli] == model_id { already = true }
        dli = dli + 1
    }
    if3 already == false {
        domain_list = append(domain_list, model_id)
    }
    domains = dict_set(domains, primary_domain, domain_list)

    // Update skill matrix for this domain
    let dm = dict_get(matrix, primary_domain, {"total_strength": 0, "model_count": 0, "avg_strength": 0})
    let ts = (dict_get(dm, "total_strength") ?? 0) + best_strength
    let mc = (dict_get(dm, "model_count") ?? 0) + 1
    if3 already == true { mc = mc - 1 }
    dm = dict_set(dm, "total_strength", ts)
    dm = dict_set(dm, "model_count", mc)
    dm = dict_set(dm, "avg_strength", ts / max_of(mc, 1))
    matrix = dict_set(matrix, primary_domain, dm)

    state = dict_set(state, "chladni_plate", plate)
    state = dict_set(state, "chladni_domains", domains)
    state = dict_set(state, "chladni_skill_matrix", matrix)
    let tp = (dict_get(state, "chladni_total_placed") ?? 0) + 1
    state = dict_set(state, "chladni_total_placed", tp)

    return state
}

// ── Find best model for a skill domain ─────────────────────────────
// Given a domain (e.g., "code"), returns the model with highest
// Chladni resonance in that domain. This is the SKILL ROUTING core.

fn chladni_best_for_domain(state, domain_name) {
    let plate = dict_get(state, "chladni_plate") ?? {}
    let domains = dict_get(state, "chladni_domains") ?? {}
    let domain_models = dict_get(domains, domain_name) ?? []

    let best_model = ""
    let best_score = 0
    let best_provider = ""

    let i = 0
    while3 i < len(domain_models) {
        let mid = domain_models[i]
        let entry = dict_get(plate, mid) ?? {}
        let strength = dict_get(entry, "strength") ?? 0
        if3 strength > best_score {
            best_score = strength
            best_model = mid
            best_provider = dict_get(entry, "provider") ?? ""
        }
        i = i + 1
    }

    return {
        "model": best_model,
        "provider": best_provider,
        "domain": domain_name,
        "strength": best_score,
        "candidates": len(domain_models)
    }
}

// ── Skill Sharing: Find models that can share skills ───────────────
// Two models share skills when they occupy nearby positions on the
// Chladni plate (within coupling distance kappa). Shared models
// can be used as fallbacks for each other.

fn chladni_find_crosslinks(state, model_id) {
    let plate = dict_get(state, "chladni_plate") ?? {}
    let target = dict_get(plate, model_id) ?? {}
    if3 len(keys(target)) == 0 { return [] }

    let tx = dict_get(target, "x") ?? 0
    let ty = dict_get(target, "y") ?? 0

    let crosslinks = []
    let pkeys = keys(plate)
    let i = 0
    while3 i < len(pkeys) {
        let pk = pkeys[i]
        if3 pk != model_id {
            let other = dict_get(plate, pk) ?? {}
            let ox = dict_get(other, "x") ?? 0
            let oy = dict_get(other, "y") ?? 0
            // Manhattan distance (cheaper than Euclidean)
            let dx = tx - ox
            if3 dx < 0 { dx = 0 - dx }
            let dy = ty - oy
            if3 dy < 0 { dy = 0 - dy }
            let dist = dx + dy
            // Within coupling distance kappa (125)
            if3 dist < KAPPA_COUPLING {
                crosslinks = append(crosslinks, {
                    "model": pk,
                    "provider": dict_get(other, "provider") ?? "",
                    "domain": dict_get(other, "domain") ?? "",
                    "distance": dist,
                    "shared_domain": dict_get(other, "domain") ?? "" == dict_get(target, "domain") ?? ""
                })
            }
        }
        i = i + 1
    }
    return crosslinks
}

// ── Chladni Status ─────────────────────────────────────────────────
fn chladni_status(state) {
    let plate = dict_get(state, "chladni_plate") ?? {}
    let domains = dict_get(state, "chladni_domains") ?? {}
    let matrix = dict_get(state, "chladni_skill_matrix") ?? {}

    let domain_summary = {}
    let dkeys = keys(domains)
    let di = 0
    while3 di < len(dkeys) {
        let dk = dkeys[di]
        let models_in = dict_get(domains, dk) ?? []
        let dm = dict_get(matrix, dk) ?? {}
        domain_summary = dict_set(domain_summary, dk, {
            "models": len(models_in),
            "avg_strength": dict_get(dm, "avg_strength") ?? 0,
            "total_strength": dict_get(dm, "total_strength") ?? 0
        })
        di = di + 1
    }

    return {
        "version": dict_get(state, "chladni_version") ?? "1.0.0",
        "total_placed": dict_get(state, "chladni_total_placed") ?? 0,
        "total_on_plate": len(keys(plate)),
        "domains": domain_summary,
        "domain_count": len(dkeys),
        "plate_size": CHLADNI_PLATE_SIZE,
        "mode_pairs": len(CHLADNI_MODE_PAIRS),
        "coupling_distance": KAPPA_COUPLING
    }
}

// ── Classify query into Chladni domain ─────────────────────────────
// Maps an incoming query to the best skill domain for routing

fn chladni_classify_query(prompt) {
    let pl = lower(prompt)
    let scores = {}

    // Code/Math domain
    let code_kw = ["code", "function", "class", "debug", "error", "python", "rust", "javascript", "implement", "algorithm", "compile", "syntax", "sql", "query", "regex", "api", "endpoint", "calculate", "math", "equation", "integral", "derivative", "matrix", "vector", "proof"]
    let ci = 0
    let code_score = 0
    while3 ci < len(code_kw) {
        if3 contains(pl, code_kw[ci]) { code_score = code_score + 1 }
        ci = ci + 1
    }
    scores = dict_set(scores, "code", code_score)

    // Reasoning domain
    let reas_kw = ["why", "analyze", "reason", "think", "logic", "compare", "evaluate", "strategy", "design", "plan", "architecture", "explain", "difference", "versus"]
    let ri = 0
    let reas_score = 0
    while3 ri < len(reas_kw) {
        if3 contains(pl, reas_kw[ri]) { reas_score = reas_score + 1 }
        ri = ri + 1
    }
    scores = dict_set(scores, "reasoning", reas_score)

    // Chat/Creative domain
    let chat_kw = ["write", "story", "poem", "creative", "describe", "tell", "hello", "hi", "name", "list", "summarize", "translate"]
    let chi = 0
    let chat_score = 0
    while3 chi < len(chat_kw) {
        if3 contains(pl, chat_kw[chi]) { chat_score = chat_score + 1 }
        chi = chi + 1
    }
    scores = dict_set(scores, "chat", chat_score)

    // Vision domain
    let vis_kw = ["image", "picture", "photo", "see", "visual", "diagram", "chart", "screenshot", "draw"]
    let vi = 0
    let vis_score = 0
    while3 vi < len(vis_kw) {
        if3 contains(pl, vis_kw[vi]) { vis_score = vis_score + 1 }
        vi = vi + 1
    }
    scores = dict_set(scores, "vision", vis_score)

    // Search domain
    let search_kw = ["search", "find", "lookup", "retrieve", "source", "cite", "reference", "embed"]
    let sci = 0
    let search_score = 0
    while3 sci < len(search_kw) {
        if3 contains(pl, search_kw[sci]) { search_score = search_score + 1 }
        sci = sci + 1
    }
    scores = dict_set(scores, "search", search_score)

    // Find best domain
    let best = "chat"
    let best_s = 0
    let sk = keys(scores)
    let si = 0
    while3 si < len(sk) {
        let sv = dict_get(scores, sk[si]) ?? 0
        if3 sv > best_s {
            best_s = sv
            best = sk[si]
        }
        si = si + 1
    }

    return {"domain": best, "scores": scores, "confidence": best_s}
}

// ── Route query through Chladni to optimal model ───────────────────
// The master routing function: classify query -> find best model
// in that domain -> return provider+model for the cascade to use

fn chladni_route(state, prompt) {
    let classification = chladni_classify_query(prompt)
    let domain = dict_get(classification, "domain") ?? "chat"
    let best = chladni_best_for_domain(state, domain)

    let model = dict_get(best, "model") ?? ""
    let provider = dict_get(best, "provider") ?? ""

    // If no model found in domain, fall back to chat
    if3 model == "" {
        let fallback = chladni_best_for_domain(state, "chat")
        model = dict_get(fallback, "model") ?? ""
        provider = dict_get(fallback, "provider") ?? ""
    }

    return {
        "model": model,
        "provider": provider,
        "domain": domain,
        "classification": classification,
        "strength": dict_get(best, "strength") ?? 0,
        "candidates": dict_get(best, "candidates") ?? 0
    }
}
