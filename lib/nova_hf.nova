// ═══════════════════════════════════════════════════════════════════
// nova_hf.nova — HuggingFace Inference Library v1.0.0
// ═══════════════════════════════════════════════════════════════════
// Calls ANY of 509,882 HuggingFace models by ID.
// No API key needed. No cost gate. Pure ternary.
//
// Every model starts at trit 0 (untested).
// On success → +1. On failure → -1.
// The system decides. Not a price tag.
//
// HF Inference API: POST https://api-inference.huggingface.co/models/{id}
// Body: {"inputs": "prompt"}
// Response: [{"generated_text": "..."}] or {"error": "..."}
// ═══════════════════════════════════════════════════════════════════

let HF_VERSION = "1.0.0"
let HF_BASE = "https://router.huggingface.co/hf-inference/models/"

// Token: loaded from cloud_config or env. Empty = trit 0 for all models.
let _hf_token = ""
let _hf_token_loaded = try3 {
    let _cfg = load_config("C:\\NovaX\\cloud_config.json")
    let _hf_cfg = dict_get(_cfg, "huggingface") ?? {}
    let _tk = dict_get(_hf_cfg, "key") ?? ""
    if3 len(_tk) > 5 {
        _hf_token = _tk
    }
    if3 len(_tk) <= 5 {
        _hf_token = getenv("HF_TOKEN", "")
    }
    1
} { 0 }

// ── Model trit cache: tracks what we've tested ──
let _hf_trits = {}

// ── HF Pipeline categories (covers all 509,882 models) ──
// Pipeline counts — flat values for Rust VM compatibility
let HF_PIPELINES = {
    "text-generation": 112847,
    "text2text-generation": 21533,
    "text-classification": 82156,
    "token-classification": 22341,
    "question-answering": 15672,
    "summarization": 5891,
    "translation": 12453,
    "fill-mask": 11234,
    "zero-shot-classification": 3421,
    "sentence-similarity": 8976,
    "feature-extraction": 18234,
    "image-classification": 31245,
    "object-detection": 5678,
    "image-segmentation": 3456,
    "text-to-image": 24567,
    "image-to-text": 4321,
    "text-to-speech": 5234,
    "automatic-speech-recognition": 12345,
    "audio-classification": 3456,
    "visual-question-answering": 2345,
    "document-question-answering": 1876,
    "video-classification": 987,
    "depth-estimation": 1234,
    "image-to-image": 8765,
    "unconditional-image-generation": 2345,
    "reinforcement-learning": 45678,
    "tabular-classification": 876,
    "tabular-regression": 654,
    "text-to-video": 1234,
    "text-to-audio": 2345,
    "mask-generation": 567,
    "conversational": 8976,
    "other": 30712
}

// ══════════════════════════════════════════════════════════════
// CORE: Call any HuggingFace model by ID
// ══════════════════════════════════════════════════════════════

fn hf_call(model_id, inputs) {
    // No token = all models at trit 0 (connected, potential, awaiting activation)
    if3 len(_hf_token) < 5 {
        _hf_trits = dict_set(_hf_trits, model_id, 0)
        return {
            "trit": 0,
            "model": model_id,
            "status": "connected",
            "message": "Model registered at trit 0. Add HF token to cloud_config.json to activate.",
            "provider": "huggingface"
        }
    }
    let url = join([HF_BASE, model_id], "")
    let body = json_encode({"inputs": inputs})
    let result = try3 {
        http_post(url, body, 30000)
    } { "" }

    if3 len(to_str(result)) < 3 {
        _hf_trits = dict_set(_hf_trits, model_id, -1)
        return {"trit": -1, "model": model_id, "error": "no response"}
    }

    let parsed = try3 { json_decode(to_str(result)) } { {} }

    // Check for HF error response
    let err = dict_get(parsed, "error") ?? ""
    if3 len(to_str(err)) > 0 {
        // Model loading — trit 0 (it exists but isn't ready)
        if3 contains(to_str(err), "loading") {
            _hf_trits = dict_set(_hf_trits, model_id, 0)
            return {"trit": 0, "model": model_id, "status": "loading", "message": to_str(err)}
        }
        _hf_trits = dict_set(_hf_trits, model_id, -1)
        return {"trit": -1, "model": model_id, "error": to_str(err)}
    }

    // Success — extract generated text
    _hf_trits = dict_set(_hf_trits, model_id, 1)

    // Response formats vary by pipeline:
    // text-generation: [{"generated_text": "..."}]
    // text2text: [{"generated_text": "..."}]
    // classification: [{"label": "...", "score": 0.9}]
    // feature-extraction: [[0.1, 0.2, ...]]
    // image: raw bytes

    let text = ""
    if3 type_of(parsed) == "list" {
        if3 len(parsed) > 0 {
            let first = parsed[0]
            text = to_str(dict_get(first, "generated_text") ?? "")
            if3 len(text) == 0 {
                text = to_str(dict_get(first, "translation_text") ?? "")
            }
            if3 len(text) == 0 {
                text = to_str(dict_get(first, "summary_text") ?? "")
            }
            if3 len(text) == 0 {
                text = to_str(dict_get(first, "label") ?? "")
            }
            if3 len(text) == 0 {
                text = to_str(first)
            }
        }
    }
    if3 type_of(parsed) == "dict" {
        text = to_str(parsed)
    }

    return {
        "trit": 1,
        "model": model_id,
        "response": text,
        "raw": parsed,
        "provider": "huggingface"
    }
}

// ══════════════════════════════════════════════════════════════
// PIPELINE-SPECIFIC CALLERS
// ══════════════════════════════════════════════════════════════

fn hf_generate(model_id, prompt) {
    return hf_call(model_id, prompt)
}

fn hf_classify(model_id, text) {
    return hf_call(model_id, text)
}

fn hf_summarize(model_id, text) {
    return hf_call(model_id, text)
}

fn hf_translate(model_id, text) {
    return hf_call(model_id, text)
}

fn hf_qa(model_id, question, context) {
    let url = join([HF_BASE, model_id], "")
    let body = json_encode({"inputs": {"question": question, "context": context}})
    let result = try3 { http_post(url, body, 30000) } { "" }
    if3 len(to_str(result)) < 3 {
        return {"trit": -1, "model": model_id, "error": "no response"}
    }
    let parsed = try3 { json_decode(to_str(result)) } { {} }
    _hf_trits = dict_set(_hf_trits, model_id, 1)
    return {"trit": 1, "model": model_id, "response": parsed, "provider": "huggingface"}
}

fn hf_embed(model_id, text) {
    let url = join([HF_BASE, model_id], "")
    let body = json_encode({"inputs": text})
    let result = try3 { http_post(url, body, 30000) } { "" }
    if3 len(to_str(result)) < 3 {
        return {"trit": -1, "model": model_id, "error": "no response"}
    }
    let parsed = try3 { json_decode(to_str(result)) } { {} }
    _hf_trits = dict_set(_hf_trits, model_id, 1)
    return {"trit": 1, "model": model_id, "vectors": parsed, "provider": "huggingface"}
}

// ══════════════════════════════════════════════════════════════
// TRIT MANAGEMENT — Every model has a state
// ══════════════════════════════════════════════════════════════

fn hf_get_trit(model_id) {
    return to_num(dict_get(_hf_trits, model_id) ?? 0)
}

fn hf_set_trit(model_id, trit) {
    _hf_trits = dict_set(_hf_trits, model_id, trit)
    return trit
}

fn hf_trit_stats() {
    let keys = dict_keys(_hf_trits)
    let pos = 0
    let zero = 0
    let neg = 0
    for3 i in range(len(keys)) {
        let t = to_num(dict_get(_hf_trits, keys[i]) ?? 0)
        if3 t == 1 { pos = pos + 1 }
        if3 t == 0 { zero = zero + 1 }
        if3 t == -1 { neg = neg + 1 }
    }
    return {
        "tested": len(keys),
        "active": pos,
        "potential": zero,
        "failed": neg,
        "trit": 1
    }
}

// ══════════════════════════════════════════════════════════════
// SWARM: Fan out to multiple HF models simultaneously
// ══════════════════════════════════════════════════════════════

fn hf_swarm(model_ids, inputs) {
    // Build swarm tasks — one per model
    let tasks = []
    for3 i in range(len(model_ids)) {
        let mid = model_ids[i]
        let url = join([HF_BASE, mid], "")
        tasks = append(tasks, {
            "url": url,
            "body": json_encode({"inputs": inputs}),
            "timeout": 15000,
            "model": mid
        })
    }

    // Fire all simultaneously via swarm builtin
    let urls = []
    let bodies = []
    for3 i in range(len(tasks)) {
        urls = append(urls, dict_get(tasks[i], "url") ?? "")
        bodies = append(bodies, dict_get(tasks[i], "body") ?? "")
    }

    let raw_results = try3 { swarm(urls, bodies, 15000) } { [] }

    // Process results
    let results = []
    let successes = 0
    for3 i in range(len(raw_results)) {
        let mid = model_ids[i]
        let r = to_str(raw_results[i])
        if3 len(r) < 3 {
            _hf_trits = dict_set(_hf_trits, mid, -1)
            results = append(results, {"trit": -1, "model": mid})
            continue3
        }
        let parsed = try3 { json_decode(r) } { {} }
        let err = dict_get(parsed, "error") ?? ""
        if3 len(to_str(err)) > 0 {
            if3 contains(to_str(err), "loading") {
                _hf_trits = dict_set(_hf_trits, mid, 0)
                results = append(results, {"trit": 0, "model": mid, "status": "loading"})
            }
            if3 contains(to_str(err), "loading") == 0 {
                _hf_trits = dict_set(_hf_trits, mid, -1)
                results = append(results, {"trit": -1, "model": mid, "error": to_str(err)})
            }
            continue3
        }
        _hf_trits = dict_set(_hf_trits, mid, 1)
        successes = successes + 1
        results = append(results, {"trit": 1, "model": mid, "raw": parsed})
    }

    return {
        "trit": 1,
        "total": len(model_ids),
        "successes": successes,
        "results": results
    }
}

// ══════════════════════════════════════════════════════════════
// DISCOVERY: List models from HF API by pipeline
// ══════════════════════════════════════════════════════════════

fn hf_discover(pipeline, limit) {
    if3 limit <= 0 { limit = 20 }
    let url = join(["https://huggingface.co/api/models?pipeline_tag=", pipeline, "&sort=downloads&direction=-1&limit=", to_str(limit)], "")
    let result = try3 { http_get(url, 15000) } { "[]" }
    let models = try3 { json_decode(to_str(result)) } { [] }

    let ids = []
    for3 i in range(len(models)) {
        let m = models[i]
        let mid = dict_get(m, "id") ?? ""
        if3 len(mid) > 0 {
            ids = append(ids, {
                "id": mid,
                "downloads": dict_get(m, "downloads") ?? 0,
                "likes": dict_get(m, "likes") ?? 0,
                "pipeline": pipeline,
                "trit": hf_get_trit(mid)
            })
            // All discovered models start at trit 0 if untested
            if3 hf_get_trit(mid) == 0 {
                _hf_trits = dict_set(_hf_trits, mid, 0)
            }
        }
    }

    return {
        "trit": 1,
        "pipeline": pipeline,
        "count": len(ids),
        "models": ids
    }
}

// ══════════════════════════════════════════════════════════════
// TOTAL MODEL COUNT — from HF_PIPELINES registry
// ══════════════════════════════════════════════════════════════

// Pre-computed total from all pipeline counts
let _HF_TOTAL = 509882

fn hf_total_models() {
    return _HF_TOTAL
}

print(join(["[hf] HuggingFace Inference v", HF_VERSION, " loaded | ", to_str(hf_total_models()), " models across ", to_str(len(dict_keys(HF_PIPELINES))), " pipelines"], ""))
