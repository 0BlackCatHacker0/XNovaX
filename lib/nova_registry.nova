// ═══════════════════════════════════════════════════════════════════
// nova_registry.nova — Universal Model Registry v1.0.0
// ═══════════════════════════════════════════════════════════════════
// Converts ALL discovered models into NovaLang ternary nodes.
// Every model = a trit entry with provider, category, frequency.
// Loaded from tripple_discovery.json (frequency-scanned archives).
// ═══════════════════════════════════════════════════════════════════

let REGISTRY_VERSION = "1.0.0"
let _discovery_path = "C:/NovaX/data/tripple_discovery.json"

// ── Load discovery data ──
let _discovery = try3 {
    let raw = read_file(_discovery_path)
    json_decode(raw)
} {
    {}
}

// ── Category → Ability Mapping ──
// Maps HuggingFace pipeline tags to NovaX ability categories
let CATEGORY_MAP = {
    "text_generation": "chat",
    "image_text_to_text": "vision",
    "text_to_image": "image",
    "text_to_speech": "tts",
    "speech_recognition": "stt",
    "feature_extraction": "embedding",
    "text_to_video": "video",
    "audio_to_audio": "audio",
    "text_to_audio": "audio"
}

// ── Category → Ternary Frequency ──
// Each category resonates at a harmonic frequency
let CATEGORY_FREQ = {
    "chat": 2187,
    "vision": 729,
    "image": 243,
    "tts": 81,
    "stt": 81,
    "embedding": 2187,
    "video": 27,
    "audio": 81,
    "code": 729,
    "reasoning": 2187,
    "fast": 2187,
    "flagship": 2187,
    "search": 243,
    "math": 729
}

// ── Registry Node ──
fn registry_node(model_id, provider, category, frequency) {
    return {
        "id": model_id,
        "provider": provider,
        "category": category,
        "frequency": frequency,
        "trit": 1,
        "locked": 1
    }
}

// ── Get total count per source ──
fn registry_counts() {
    let hf = dict_get(_discovery, "huggingface") ?? {}
    let hf_total = dict_get(hf, "total") ?? 0
    if3 hf_total == 0 {
        // Sum individual categories
        let cats = keys(hf)
        let i = 0
        while3 i < len(cats) {
            let k = cats[i]
            if3 k != "total" {
                hf_total = hf_total + dict_get(hf, k) ?? 0
            }
            i = i + 1
        }
    }
    return {
        "huggingface": hf_total,
        "openrouter": dict_get(_discovery, "openrouter") ?? 344,
        "ollama": dict_get(_discovery, "ollama_library") ?? 102,
        "replicate": dict_get(_discovery, "replicate") ?? 47,
        "local_mirror": dict_get(_discovery, "local_mirror") ?? 819,
        "ability_slots": dict_get(_discovery, "ability_slots") ?? 1053,
        "services": dict_get(_discovery, "services") ?? 106,
        "skills": dict_get(_discovery, "skills") ?? 245
    }
}

fn registry_grand_total() {
    let c = registry_counts()
    let total = 0
    let ks = keys(c)
    let i = 0
    while3 i < len(ks) {
        total = total + dict_get(c, ks[i]) ?? 0
        i = i + 1
    }
    return total
}

// ── Category breakdown for HuggingFace ──
fn registry_hf_categories() {
    let hf = dict_get(_discovery, "huggingface") ?? {}
    let result = {}
    let cat_keys = keys(CATEGORY_MAP)
    let i = 0
    while3 i < len(cat_keys) {
        let hf_key = cat_keys[i]
        let nova_ability = dict_get(CATEGORY_MAP, hf_key) ?? "unknown"
        let count = dict_get(hf, hf_key) ?? 0
        let freq = dict_get(CATEGORY_FREQ, nova_ability) ?? 81
        result = dict_set(result, hf_key, {
            "count": count,
            "nova_ability": nova_ability,
            "frequency": freq,
            "trit": 1
        })
        i = i + 1
    }
    return result
}

// ── Provider routing table ──
// Returns which providers serve which abilities
fn registry_provider_abilities() {
    return {
        "huggingface": ["chat", "vision", "image", "tts", "stt", "embedding", "video", "audio", "code", "reasoning"],
        "openrouter": ["chat", "code", "reasoning", "vision", "fast", "flagship"],
        "ollama": ["chat", "code", "reasoning", "embedding", "vision"],
        "replicate": ["chat", "image", "video", "audio", "vision"],
        "openai": ["chat", "code", "reasoning", "embedding", "tts", "stt", "image", "vision", "flagship"],
        "anthropic": ["chat", "code", "reasoning", "vision", "flagship"],
        "google": ["chat", "code", "reasoning", "vision", "embedding", "tts", "flagship"],
        "deepseek": ["chat", "code", "reasoning", "fast"],
        "groq": ["chat", "code", "fast"],
        "mistral": ["chat", "code", "reasoning"],
        "cohere": ["chat", "embedding", "search"],
        "together": ["chat", "code", "image", "embedding"]
    }
}

// ── Lock all nodes into ternary state ──
fn registry_lock_all(state) {
    let counts = registry_counts()
    let grand = registry_grand_total()
    state = dict_set(state, "registry_counts", counts)
    state = dict_set(state, "registry_grand_total", grand)
    state = dict_set(state, "registry_locked", 1)
    state = dict_set(state, "registry_version", REGISTRY_VERSION)

    // Lock HF categories
    let hf_cats = registry_hf_categories()
    state = dict_set(state, "registry_hf_categories", hf_cats)

    // Lock provider abilities
    let prov_ab = registry_provider_abilities()
    state = dict_set(state, "registry_provider_abilities", prov_ab)

    return state
}

// ── Ternary trit for registry health ──
fn registry_trit() {
    let grand = registry_grand_total()
    if3 grand > 100000 {
        return 1
    }
    if3 grand > 1000 {
        return 0
    }
    return -1
}

print("[registry] Nova Universal Registry v" + REGISTRY_VERSION + " loaded | " + str(registry_grand_total()) + " total nodes")
