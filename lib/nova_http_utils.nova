// nova_http_utils.nova — HTTP Request/Response Helpers
// Version: 0.1.0
// ================================================================

import3("C:/NovaX/lib/nova_stdlib.nova")
import3("C:/NovaX/lib/nova_ns_core.nova")

let HTTP_UTILS_VERSION = "0.1.0"

// ── Request parsing ──
fn parse_body(req) {
    let raw = dict_get(req, "body") ?? ""
    if3 len(raw) == 0 { return {} }
    let parsed = try3 { json_decode(raw) } { {} }
    return parsed
}

fn require_field(body, field) {
    let val = dict_get(body, field) ?? null
    if3 val == null { return make_err("missing_field: " + field) }
    return make_ok(val)
}

fn get_query_param(req, param, fallback) {
    let query = dict_get(req, "query") ?? {}
    return dict_get(query, param) ?? fallback
}

fn get_header(req, name, fallback) {
    let headers = dict_get(req, "headers") ?? {}
    return dict_get(headers, name) ?? fallback
}

// ── Response helpers ──
fn json_ok(data) {
    return json_encode(data)
}

fn json_err(msg) {
    return json_encode(make_err(msg))
}

fn json_health(service, version, port, ns_counters) {
    return json_encode(ns_health_dict(service, version, port, ns_counters))
}

print("[http_utils] HTTP utilities v" + HTTP_UTILS_VERSION + " loaded")
