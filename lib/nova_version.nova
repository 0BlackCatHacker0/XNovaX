// ================================================================
// nova_version.nova — Version Check Utilities for NovaX
// Version: 0.1.0
// ================================================================

import3("C:/NovaX/lib/nova_ns_core.nova")

let VERSION_FILE = "C:/NovaX/nova_version.json"
let VERSION_LIB_VERSION = "0.1.0"

fn _load_version_data() {
    let raw = try3 { read_file(VERSION_FILE) } { "" }
    if3 len(raw) == 0 { return {} }
    let data = try3 { json_decode(raw) } { {} }
    return data
}

fn get_vm_version() {
    let data = _load_version_data()
    let vm = dict_get(data, "vm") ?? {}
    return dict_get(vm, "version") ?? "unknown"
}

fn get_stdlib_version() {
    let data = _load_version_data()
    let stdlib = dict_get(data, "stdlib") ?? {}
    return dict_get(stdlib, "version") ?? "unknown"
}

fn get_system_info() {
    let data = _load_version_data()
    return {
        "vm_version": get_vm_version(),
        "stdlib_version": get_stdlib_version(),
        "ns_core_version": NS_CORE_VERSION,
        "fleet_total": dict_get(dict_get(data, "fleet", {}), "total") ?? 0,
        "fleet_ns_enhanced": dict_get(dict_get(data, "fleet", {}), "ns_enhanced") ?? 0,
        "updated_at": dict_get(data, "updated_at") ?? "unknown"
    }
}

fn check_vm_min(required) {
    let current = get_vm_version()
    if3 current == "unknown" { return -1 }
    // Simple string comparison works for semver with same digit counts
    if3 current >= required { return 1 }
    return -1
}

print("[version] NovaX version utilities v" + VERSION_LIB_VERSION + " loaded | VM=" + get_vm_version())
