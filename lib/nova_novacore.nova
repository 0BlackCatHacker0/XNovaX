// ================================================================
// nova_novacore.nova — NovaCore Client Library
// Gives ANY NovaX service access to Chladni routing + Fractal dispatch
// Usage:
//   import3("C:/NovaX/lib/nova_novacore.nova")
//   let result = novacore_route("Explain quantum physics")
//   let fractal = novacore_fractal_run("Build a web server", 3)
// ================================================================

let NOVACORE_VERSION = "1.0.0"
let NOVACORE_ROUTER_URL = "http://127.0.0.1:9878"
let NOVACORE_FRACTAL_URL = "http://127.0.0.1:9874"
let NOVACORE_HIVEMIND_URL = "http://127.0.0.1:9881"

// ── Chladni Routing ─────────────────────────────────
// Route a prompt through Chladni to find the best model+provider
fn novacore_route(prompt) {
    let url = NOVACORE_ROUTER_URL + "/tripple/chladni/route"
    let body = json_encode({"prompt": prompt})
    let resp = try3 { http_post(url, body) } fail { null }
    if3 resp == null { return {"ok": -1, "error": "chladni_unreachable", "trit": -1} }
    let data = try3 { json_decode(dict_get(resp, "body") ?? "{}") } fail { {"ok": -1, "error": "parse_failed"} }
    return data
}

// Get Chladni domain status — which domains have models, strengths
fn novacore_domains() {
    let url = NOVACORE_ROUTER_URL + "/tripple/chladni/status"
    let resp = try3 { http_get(url) } fail { null }
    if3 resp == null { return {"ok": -1, "error": "chladni_unreachable", "trit": -1} }
    let data = try3 { json_decode(dict_get(resp, "body") ?? "{}") } fail { {"ok": -1} }
    return data
}

// Find models with shared skills (crosslinks)
fn novacore_crosslinks(model_id) {
    let url = NOVACORE_ROUTER_URL + "/tripple/chladni/crosslinks"
    let body = json_encode({"model_id": model_id})
    let resp = try3 { http_post(url, body) } fail { null }
    if3 resp == null { return {"ok": -1, "error": "chladni_unreachable", "trit": -1} }
    let data = try3 { json_decode(dict_get(resp, "body") ?? "{}") } fail { {"ok": -1} }
    return data
}

// ── Cloud Router Direct Query ───────────────────────
// Send a prompt to the cloud router for single-model response
fn novacore_query(prompt, provider) {
    let url = NOVACORE_ROUTER_URL + "/api/v1/query"
    let body_dict = {"prompt": prompt}
    if3 len(provider) > 0 {
        body_dict = dict_set(body_dict, "provider", provider)
    }
    let body = json_encode(body_dict)
    let resp = try3 { http_post(url, body) } fail { null }
    if3 resp == null { return {"ok": -1, "error": "router_unreachable", "trit": -1} }
    let data = try3 { json_decode(dict_get(resp, "body") ?? "{}") } fail { {"ok": -1, "error": "parse_failed"} }
    return data
}

// Smart query — uses Chladni to pick the best provider, then queries
fn novacore_smart_query(prompt) {
    let route = novacore_route(prompt)
    let provider = dict_get(route, "provider") ?? ""
    if3 len(provider) == 0 {
        // Chladni couldn't route — fall back to cascade
        return novacore_query(prompt, "")
    }
    return novacore_query(prompt, provider)
}

// ── Fractal Engine ──────────────────────────────────
// Run full fractal pipeline — split, dispatch, quantize, synthesize
fn novacore_fractal_run(prompt, max_rounds) {
    let url = NOVACORE_FRACTAL_URL + "/fractal/run"
    let body = json_encode({"prompt": prompt, "max_rounds": max_rounds})
    let resp = try3 { http_post(url, body) } fail { null }
    if3 resp == null { return {"ok": -1, "error": "fractal_unreachable", "trit": -1} }
    let data = try3 { json_decode(dict_get(resp, "body") ?? "{}") } fail { {"ok": -1, "error": "parse_failed"} }
    return data
}

// Just split a prompt into sub-tasks (no dispatch)
fn novacore_fractal_split(prompt) {
    let url = NOVACORE_FRACTAL_URL + "/fractal/split"
    let body = json_encode({"prompt": prompt})
    let resp = try3 { http_post(url, body) } fail { null }
    if3 resp == null { return {"ok": -1, "error": "fractal_unreachable", "trit": -1} }
    let data = try3 { json_decode(dict_get(resp, "body") ?? "{}") } fail { {"ok": -1, "error": "parse_failed"} }
    return data
}

// Run amplification round on existing output
fn novacore_fractal_amplify(prompt, previous_output, round_num) {
    let url = NOVACORE_FRACTAL_URL + "/fractal/amplify"
    let body = json_encode({
        "prompt": prompt,
        "previous_output": previous_output,
        "round": round_num
    })
    let resp = try3 { http_post(url, body) } fail { null }
    if3 resp == null { return {"ok": -1, "error": "fractal_unreachable", "trit": -1} }
    let data = try3 { json_decode(dict_get(resp, "body") ?? "{}") } fail { {"ok": -1, "error": "parse_failed"} }
    return data
}

// Get fractal engine status
fn novacore_fractal_status() {
    let url = NOVACORE_FRACTAL_URL + "/fractal/status"
    let resp = try3 { http_get(url) } fail { null }
    if3 resp == null { return {"ok": -1, "error": "fractal_unreachable", "trit": -1} }
    let data = try3 { json_decode(dict_get(resp, "body") ?? "{}") } fail { {"ok": -1} }
    return data
}

// ── HiveMind ────────────────────────────────────────
// Send a task to the hivemind swarm
fn novacore_hive_query(prompt) {
    let url = NOVACORE_HIVEMIND_URL + "/api/v1/query"
    let body = json_encode({"prompt": prompt})
    let resp = try3 { http_post(url, body) } fail { null }
    if3 resp == null { return {"ok": -1, "error": "hivemind_unreachable", "trit": -1} }
    let data = try3 { json_decode(dict_get(resp, "body") ?? "{}") } fail { {"ok": -1, "error": "parse_failed"} }
    return data
}

// ── Swarm Dispatch ──────────────────────────────────
// Dispatch to ALL providers simultaneously for maximum output
fn novacore_swarm(prompt, system_prompt) {
    let url = NOVACORE_FRACTAL_URL + "/swarm/run"
    let body = json_encode({"prompt": prompt, "system_prompt": system_prompt})
    let resp = try3 { http_post(url, body) } fail { null }
    if3 resp == null { return {"ok": -1, "error": "swarm_unreachable", "trit": -1} }
    let data = try3 { json_decode(dict_get(resp, "body") ?? "{}") } fail { {"ok": -1, "error": "parse_failed"} }
    return data
}

// Swarm + Fractal combined — fractalizes THEN swarms each sub-task
fn novacore_swarm_fractal(prompt, max_rounds) {
    let url = NOVACORE_FRACTAL_URL + "/swarm/fractal"
    let body = json_encode({"prompt": prompt, "max_rounds": max_rounds})
    let resp = try3 { http_post(url, body) } fail { null }
    if3 resp == null { return {"ok": -1, "error": "swarm_fractal_unreachable", "trit": -1} }
    let data = try3 { json_decode(dict_get(resp, "body") ?? "{}") } fail { {"ok": -1, "error": "parse_failed"} }
    return data
}

// ── Multi-Strategy Dispatch ─────────────────────────
// The big one: picks the optimal strategy for the task
fn novacore_dispatch(prompt, strategy) {
    // strategy: "smart" | "fractal" | "hive" | "cascade" | "swarm" | "swarm_fractal" | "max"
    if3 strategy == "fractal" {
        return novacore_fractal_run(prompt, 3)
    }
    if3 strategy == "hive" {
        return novacore_hive_query(prompt)
    }
    if3 strategy == "cascade" {
        return novacore_query(prompt, "")
    }
    if3 strategy == "swarm" {
        return novacore_swarm(prompt, "")
    }
    if3 strategy == "swarm_fractal" {
        return novacore_swarm_fractal(prompt, 3)
    }
    if3 strategy == "max" {
        // Maximum output: fractal split + swarm all providers + 3 rounds
        return novacore_swarm_fractal(prompt, 3)
    }
    // Default: smart routing via Chladni
    return novacore_smart_query(prompt)
}

// ── Health Check ────────────────────────────────────
fn novacore_health() {
    let router = try3 { http_get(NOVACORE_ROUTER_URL + "/health") } fail { null }
    let fractal = try3 { http_get(NOVACORE_FRACTAL_URL + "/health") } fail { null }
    let hive = try3 { http_get(NOVACORE_HIVEMIND_URL + "/health") } fail { null }

    let router_ok = 0
    if3 router != null { router_ok = 1 }
    let fractal_ok = 0
    if3 fractal != null { fractal_ok = 1 }
    let hive_ok = 0
    if3 hive != null { hive_ok = 1 }

    return {
        "ok": 1,
        "version": NOVACORE_VERSION,
        "router": router_ok,
        "fractal": fractal_ok,
        "hivemind": hive_ok,
        "total_up": router_ok + fractal_ok + hive_ok,
        "trit": 1
    }
}

print("[NOVACORE] Client library v" + NOVACORE_VERSION + " loaded")
print("[NOVACORE] Endpoints: router=" + NOVACORE_ROUTER_URL + " fractal=" + NOVACORE_FRACTAL_URL + " hive=" + NOVACORE_HIVEMIND_URL)
