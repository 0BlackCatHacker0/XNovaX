// =================================================================
// NOVA FRACTAL ENGINE — Fractal Task Distribution + Synthesis
// =================================================================
// Splits complex tasks into domain-optimized sub-tasks, dispatches
// them across thousands of models via Chladni skill routing, and
// synthesizes results into massive unified output.
//
// Architecture:
//   1. FRACTALIZER: Splits prompt into domain sub-tasks
//   2. DISPATCHER: Sends sub-tasks to optimal models per domain
//   3. QUANTIZER:  Normalizes and deduplicates responses
//   4. SYNTHESIZER: Merges fragments into coherent output
//   5. AMPLIFIER:  Chains rounds for million-token output
//
// N-S Mapping:
//   fractal_split = divergence (one flow becomes many)
//   dispatch      = velocity_field (parallel flow channels)
//   quantize      = pressure_equalization (normalize quality)
//   synthesize    = convergence (many flows become one)
//   amplify       = reynolds_escalation (deeper/longer runs)
//
// 3-5-7-13 Design:
//   H3=3   sub-tasks per fractal split (min)
//   H5=5   parallel dispatch channels
//   H7=7   max fractal depth (recursive splits)
//   H13=13 synthesis quorum (responses needed for consensus)
// =================================================================

import3("C:/NovaX/lib/nova_stdlib.nova")

// ── Constants ─────────────────────────────────────────────────────
let FRACTAL_VERSION = "1.0.0"
let FRACTAL_MIN_SPLITS = 3        // H3: minimum sub-tasks
let FRACTAL_MAX_SPLITS = 13       // H13: maximum sub-tasks
let FRACTAL_MAX_DEPTH = 7         // H7: max recursive depth
let FRACTAL_DISPATCH_PARALLEL = 5 // H5: parallel channels
let FRACTAL_QUORUM = 3            // H3: min responses for synthesis
let FRACTAL_MAX_ROUNDS = 13       // H13: max amplification rounds
let FRACTAL_TOKEN_TARGET = 4096   // target tokens per sub-task response

// Cloud Router URL
let ROUTER_URL = "http://127.0.0.1:9878"

// ── Domain Templates ──────────────────────────────────────────────
// Each domain has a system prompt template and task decomposition strategy
let DOMAIN_TEMPLATES = {
    "code": {
        "system": "You are an expert programmer. Write clean, efficient, well-documented code. Focus on correctness and performance.",
        "split_strategy": "functional",
        "token_weight": 3
    },
    "reasoning": {
        "system": "You are a deep analytical thinker. Break down complex problems step by step. Show your reasoning chain.",
        "split_strategy": "analytical",
        "token_weight": 2
    },
    "chat": {
        "system": "You are a knowledgeable assistant. Provide comprehensive, well-structured responses with examples.",
        "split_strategy": "topical",
        "token_weight": 1
    },
    "search": {
        "system": "You are a research specialist. Find, verify, and synthesize information from multiple angles.",
        "split_strategy": "query_expansion",
        "token_weight": 1
    },
    "vision": {
        "system": "You are a visual analysis expert. Describe, interpret, and reason about visual information.",
        "split_strategy": "perceptual",
        "token_weight": 2
    },
    "system": {
        "system": "You are a systems architect. Design robust, scalable systems with clear interfaces.",
        "split_strategy": "architectural",
        "token_weight": 3
    },
    "math": {
        "system": "You are a mathematician. Show rigorous proofs and calculations. Verify your work.",
        "split_strategy": "analytical",
        "token_weight": 2
    }
}

// =================================================================
// STAGE 1: FRACTALIZER — Split task into domain sub-tasks
// =================================================================

fn fractal_classify_prompt(prompt) {
    // Use keyword-based classification (same as Chladni but returns scores)
    let pl = lower(prompt)
    let domains = {}

    // Code detection
    let code_kw = ["code", "function", "class", "debug", "python", "rust", "javascript",
                   "implement", "algorithm", "compile", "syntax", "sql", "regex", "api",
                   "endpoint", "program", "write a function", "build", "create a"]
    let cs = 0
    let ci = 0
    while3 ci < len(code_kw) {
        if3 contains(pl, code_kw[ci]) { cs = cs + 1 }
        ci = ci + 1
    }
    if3 cs > 0 { domains = dict_set(domains, "code", cs) }

    // Reasoning detection
    let reas_kw = ["why", "analyze", "reason", "think", "logic", "compare", "evaluate",
                   "strategy", "design", "plan", "explain", "difference", "tradeoff",
                   "pros and cons", "architecture", "how does"]
    let rs = 0
    let ri = 0
    while3 ri < len(reas_kw) {
        if3 contains(pl, reas_kw[ri]) { rs = rs + 1 }
        ri = ri + 1
    }
    if3 rs > 0 { domains = dict_set(domains, "reasoning", rs) }

    // Math detection
    let math_kw = ["calculate", "math", "equation", "formula", "integral", "derivative",
                   "matrix", "vector", "probability", "proof", "theorem", "solve"]
    let ms = 0
    let mi = 0
    while3 mi < len(math_kw) {
        if3 contains(pl, math_kw[mi]) { ms = ms + 1 }
        mi = mi + 1
    }
    if3 ms > 0 { domains = dict_set(domains, "math", ms) }

    // Search detection
    let search_kw = ["search", "find", "lookup", "retrieve", "source", "cite",
                     "reference", "research", "information about", "what is"]
    let ss = 0
    let si = 0
    while3 si < len(search_kw) {
        if3 contains(pl, search_kw[si]) { ss = ss + 1 }
        si = si + 1
    }
    if3 ss > 0 { domains = dict_set(domains, "search", ss) }

    // Vision detection
    let vis_kw = ["image", "picture", "photo", "visual", "diagram", "chart", "draw",
                  "screenshot", "describe what you see"]
    let vs = 0
    let vi = 0
    while3 vi < len(vis_kw) {
        if3 contains(pl, vis_kw[vi]) { vs = vs + 1 }
        vi = vi + 1
    }
    if3 vs > 0 { domains = dict_set(domains, "vision", vs) }

    // System detection
    let sys_kw = ["system", "service", "deploy", "infrastructure", "server", "container",
                  "kubernetes", "database", "scale", "monitor", "orchestrate"]
    let sss = 0
    let ssi = 0
    while3 ssi < len(sys_kw) {
        if3 contains(pl, sys_kw[ssi]) { sss = sss + 1 }
        ssi = ssi + 1
    }
    if3 sss > 0 { domains = dict_set(domains, "system", sss) }

    // Chat is always present as fallback
    let chat_kw = ["write", "story", "poem", "creative", "describe", "tell", "hello",
                   "list", "summarize", "translate", "help", "answer"]
    let chs = 0
    let chi = 0
    while3 chi < len(chat_kw) {
        if3 contains(pl, chat_kw[chi]) { chs = chs + 1 }
        chi = chi + 1
    }
    if3 chs > 0 { domains = dict_set(domains, "chat", chs) }

    // If no domains matched, default to chat
    if3 len(keys(domains)) == 0 {
        domains = dict_set(domains, "chat", 1)
    }

    return domains
}

// Generate sub-task prompts for each detected domain
fn fractal_split(prompt, domains) {
    let sub_tasks = []
    let dkeys = keys(domains)
    let di = 0

    while3 di < len(dkeys) {
        let domain = dkeys[di]
        let weight = dict_get(domains, domain) ?? 1
        let template = dict_get(DOMAIN_TEMPLATES, domain) ?? dict_get(DOMAIN_TEMPLATES, "chat") ?? {}
        let sys_prompt = dict_get(template, "system") ?? "Be helpful."
        let tw = dict_get(template, "token_weight") ?? 1

        // Generate domain-specific sub-task prompt
        let sub_prompt = _make_sub_prompt(prompt, domain)

        // Weight determines how many parallel dispatches this domain gets
        let dispatch_count = weight * tw
        if3 dispatch_count < 1 { dispatch_count = 1 }
        if3 dispatch_count > FRACTAL_DISPATCH_PARALLEL { dispatch_count = FRACTAL_DISPATCH_PARALLEL }

        let task = {
            "domain": domain,
            "prompt": sub_prompt,
            "system_prompt": sys_prompt,
            "weight": weight,
            "dispatch_count": dispatch_count,
            "token_target": FRACTAL_TOKEN_TARGET * tw
        }
        sub_tasks = append(sub_tasks, task)
        di = di + 1
    }

    return sub_tasks
}

// Create domain-specific sub-prompt from the original
fn _make_sub_prompt(prompt, domain) {
    if3 domain == "code" {
        return "As a code expert, address this: " + prompt + "\n\nProvide complete, working code with comments."
    }
    if3 domain == "reasoning" {
        return "Analyze this deeply with step-by-step reasoning: " + prompt + "\n\nShow your complete chain of thought."
    }
    if3 domain == "math" {
        return "Solve this mathematically with full work shown: " + prompt + "\n\nVerify your answer."
    }
    if3 domain == "search" {
        return "Research and provide comprehensive information: " + prompt + "\n\nCite multiple perspectives."
    }
    if3 domain == "vision" {
        return "Describe and analyze the visual aspects: " + prompt + "\n\nBe detailed and precise."
    }
    if3 domain == "system" {
        return "Design the system architecture for: " + prompt + "\n\nInclude components, interfaces, and scaling."
    }
    // chat default
    return prompt
}

// =================================================================
// STAGE 2: DISPATCHER — Send sub-tasks to models via Cloud Router
// =================================================================

// Dispatch a single sub-task to the Cloud Router
fn fractal_dispatch_one(sub_task, provider_override) {
    let prompt = dict_get(sub_task, "prompt") ?? ""
    let domain = dict_get(sub_task, "domain") ?? "chat"
    let sys_prompt = dict_get(sub_task, "system_prompt") ?? ""

    // Build request body
    let body = {"prompt": prompt, "system_prompt": sys_prompt}
    if3 len(provider_override) > 0 {
        body = dict_set(body, "provider", provider_override)
    }

    let body_str = json_encode(body)
    let endpoint = ROUTER_URL + "/api/v1/query"

    let t0 = time()
    let resp = try3 {
        http_post_headers(endpoint, body_str, {"Content-Type": "application/json"}, 30000)
    } fail { {"error": "dispatch_failed"} }
    let elapsed = floor((time() - t0) * 1000)

    let err = dict_get(resp, "error") ?? ""
    if3 err != "" {
        return {"ok": false, "domain": domain, "error": err, "time_ms": elapsed}
    }

    let resp_body = dict_get(resp, "body") ?? ""
    let resp_body = trim(resp_body)
    let data = _swarm_parse_response(resp_body)
    if3 data == null {
        return {"ok": false, "domain": domain, "error": "parse_failed", "time_ms": elapsed}
    }

    let result = dict_get(data, "result") ?? {}
    let response_text = dict_get(result, "response") ?? ""
    // Ollama returns raw body with nested response
    if3 len(response_text) == 0 {
        let inner_body = dict_get(result, "body") ?? ""
        if3 len(inner_body) > 0 {
            let inner = try3 { json_decode(inner_body) } fail { {} }
            response_text = dict_get(inner, "response") ?? ""
        }
    }

    let provider = dict_get(data, "provider") ?? "unknown"
    let model = dict_get(data, "model") ?? dict_get(result, "model") ?? "unknown"

    return {
        "ok": true,
        "domain": domain,
        "provider": provider,
        "model": model,
        "response": response_text,
        "tokens": len(response_text),
        "time_ms": elapsed
    }
}

// Dispatch sub-tasks across multiple providers for one domain
fn fractal_dispatch_domain(sub_task, providers) {
    let results = []
    let i = 0
    let dispatch_count = dict_get(sub_task, "dispatch_count") ?? 1
    let count = min_of(dispatch_count, len(providers))
    if3 count < 1 { count = 1 }

    while3 i < count {
        let prov = ""
        if3 i < len(providers) { prov = providers[i] }
        let result = fractal_dispatch_one(sub_task, prov)
        let ok = dict_get(result, "ok") ?? false
        if3 ok == true {
            results = append(results, result)
        }
        i = i + 1
    }
    return results
}

// =================================================================
// STAGE 3: QUANTIZER — Normalize and deduplicate responses
// =================================================================

fn fractal_quantize(results) {
    let quantized = []
    let seen_hashes = []
    let total_tokens = 0

    let i = 0
    while3 i < len(results) {
        let r = results[i]
        let text = dict_get(r, "response") ?? ""
        if3 len(text) > 10 {
            // Simple dedup: hash first 100 chars
            let hash_key = slice(text, 0, 100)
            let is_dup = false
            let hi = 0
            while3 hi < len(seen_hashes) {
                if3 seen_hashes[hi] == hash_key { is_dup = true }
                hi = hi + 1
            }
            if3 is_dup == false {
                // Quality score: length * (1 if has structure, 0.5 if not)
                let has_structure = 0
                if3 contains(text, "\n") { has_structure = 1 }
                if3 contains(text, "```") { has_structure = has_structure + 1 }
                if3 contains(text, "1.") { has_structure = has_structure + 1 }
                let quality = len(text) * (100 + has_structure * 50) / 100

                let entry = dict_set(r, "quality", quality)
                entry = dict_set(entry, "token_count", len(text))
                quantized = append(quantized, entry)
                seen_hashes = append(seen_hashes, hash_key)
                total_tokens = total_tokens + len(text)
            }
        }
        i = i + 1
    }

    // Sort by quality (simple bubble sort, lists are small)
    let j = 0
    while3 j < len(quantized) {
        let k = j + 1
        while3 k < len(quantized) {
            let qj = dict_get(quantized[j], "quality") ?? 0
            let qk = dict_get(quantized[k], "quality") ?? 0
            if3 qk > qj {
                let tmp = quantized[j]
                quantized = array_set(quantized, j, quantized[k])
                quantized = array_set(quantized, k, tmp)
            }
            k = k + 1
        }
        j = j + 1
    }

    return {"fragments": quantized, "total_tokens": total_tokens, "unique_count": len(quantized)}
}

// =================================================================
// STAGE 4: SYNTHESIZER — Merge fragments into coherent output
// =================================================================

fn fractal_synthesize(quantized, original_prompt) {
    let fragments = dict_get(quantized, "fragments") ?? []
    let total_tokens = dict_get(quantized, "total_tokens") ?? 0

    if3 len(fragments) == 0 {
        return {"ok": false, "error": "no_fragments", "output": "", "tokens": 0}
    }

    // If only one fragment, return it directly
    if3 len(fragments) == 1 {
        let f = fragments[0]
        return {
            "ok": true,
            "output": dict_get(f, "response") ?? "",
            "tokens": dict_get(f, "token_count") ?? 0,
            "sources": 1,
            "method": "single"
        }
    }

    // Multi-fragment synthesis: organize by domain, then merge
    let output_parts = []
    let domains_seen = {}
    let fi = 0

    while3 fi < len(fragments) {
        let frag = fragments[fi]
        let domain = dict_get(frag, "domain") ?? "general"
        let text = dict_get(frag, "response") ?? ""
        let provider = dict_get(frag, "provider") ?? "?"
        let model = dict_get(frag, "model") ?? "?"

        // Add domain header if first time seeing this domain
        let seen = dict_get(domains_seen, domain) ?? false
        if3 seen == false {
            let header = "## " + upper(domain) + " Analysis"
            output_parts = append(output_parts, header)
            output_parts = append(output_parts, "")
            domains_seen = dict_set(domains_seen, domain, true)
        }

        // Add the fragment with source attribution
        let source_tag = "[" + provider + "/" + model + "]"
        output_parts = append(output_parts, text)
        output_parts = append(output_parts, "")
        output_parts = append(output_parts, "---")
        output_parts = append(output_parts, "")

        fi = fi + 1
    }

    // Build final output
    let final_output = join(output_parts, "\n")

    return {
        "ok": true,
        "output": final_output,
        "tokens": len(final_output),
        "sources": len(fragments),
        "domains": len(keys(domains_seen)),
        "method": "multi_domain_synthesis"
    }
}

// =================================================================
// STAGE 5: AMPLIFIER — Chain rounds for massive output
// =================================================================

fn fractal_amplify(original_prompt, synthesis, round_num, max_rounds) {
    if3 round_num >= max_rounds { return synthesis }

    // Check if we have enough output
    let current_tokens = dict_get(synthesis, "tokens") ?? 0
    let target = FRACTAL_TOKEN_TARGET * FRACTAL_MAX_SPLITS

    if3 current_tokens >= target { return synthesis }

    // Generate a deeper prompt based on the synthesis
    let previous = dict_get(synthesis, "output") ?? ""
    let deeper_prompt = "Given this analysis:\n" + slice(previous, 0, 2000) + "\n\nGo deeper: expand on the key points, add more detail, provide additional examples, and explore edge cases. Original question: " + original_prompt

    return {"ok": true, "amplify_prompt": deeper_prompt, "round": round_num + 1, "current_tokens": current_tokens}
}

// =================================================================
// MASTER ENTRY POINT: fractal_run()
// =================================================================
// Runs the full fractal pipeline:
//   classify -> split -> dispatch -> quantize -> synthesize -> amplify

fn fractal_run(prompt, providers, max_rounds) {
    let t0 = time()

    // Stage 1: Classify and split
    let domains = fractal_classify_prompt(prompt)
    let sub_tasks = fractal_split(prompt, domains)

    // Stage 2: Dispatch each sub-task across providers
    let all_results = []
    let ti = 0
    while3 ti < len(sub_tasks) {
        let task = sub_tasks[ti]
        let domain_results = fractal_dispatch_domain(task, providers)
        let dri = 0
        while3 dri < len(domain_results) {
            all_results = append(all_results, domain_results[dri])
            dri = dri + 1
        }
        ti = ti + 1
    }

    // Stage 3: Quantize
    let quantized = fractal_quantize(all_results)

    // Stage 4: Synthesize
    let synthesis = fractal_synthesize(quantized, prompt)

    // Stage 5: Amplify (check if more rounds needed)
    let amp = fractal_amplify(prompt, synthesis, 0, max_rounds)
    let needs_more = dict_get(amp, "amplify_prompt") ?? ""

    let elapsed = floor((time() - t0) * 1000)

    return {
        "ok": dict_get(synthesis, "ok") ?? false,
        "output": dict_get(synthesis, "output") ?? "",
        "total_tokens": dict_get(quantized, "total_tokens") ?? 0,
        "output_tokens": dict_get(synthesis, "tokens") ?? 0,
        "sources": dict_get(synthesis, "sources") ?? 0,
        "domains_used": dict_get(synthesis, "domains") ?? 0,
        "sub_tasks": len(sub_tasks),
        "dispatches": len(all_results),
        "unique_fragments": dict_get(quantized, "unique_count") ?? 0,
        "method": dict_get(synthesis, "method") ?? "unknown",
        "time_ms": elapsed,
        "version": FRACTAL_VERSION,
        "domains_detected": domains,
        "needs_amplification": len(needs_more) > 0,
        "amplify_prompt": needs_more
    }
}

// =================================================================
// FRACTAL STATUS
// =================================================================

fn fractal_status() {
    return {
        "version": FRACTAL_VERSION,
        "max_splits": FRACTAL_MAX_SPLITS,
        "max_depth": FRACTAL_MAX_DEPTH,
        "max_rounds": FRACTAL_MAX_ROUNDS,
        "dispatch_parallel": FRACTAL_DISPATCH_PARALLEL,
        "quorum": FRACTAL_QUORUM,
        "token_target": FRACTAL_TOKEN_TARGET,
        "domains": keys(DOMAIN_TEMPLATES),
        "domain_count": len(keys(DOMAIN_TEMPLATES)),
        "ok": 1,
        "trit": 1
    }
}

// =================================================================
// SWARM DISPATCH ENGINE — Massive Parallel Model Dispatch
// =================================================================

let SWARM_VERSION = "1.0.0"
let SWARM_MAX_PROVIDERS = 29
let SWARM_TIMEOUT_MS = 30000
let SWARM_MIN_RESPONSE_LEN = 20

fn _swarm_get_providers() {
    let provs = ["ollama", "cerebras_direct", "openai", "anthropic", "openrouter", "sambanova", "google_ai", "github_models", "huggingface", "groq_direct", "mistral_direct", "nvidia_nim", "deepinfra", "together_direct", "cohere_direct", "kluster_ai", "cloudflare_ai", "apifreellm"]
    return provs
}

fn _swarm_extract_response(data) {
    let result = dict_get(data, "result") ?? {}
    let txt = dict_get(result, "response") ?? ""
    if3 len(txt) > 0 { return txt }
    let inner_body = dict_get(result, "body") ?? ""
    if3 len(inner_body) == 0 { return "" }
    let inner = try3 { json_decode(inner_body) } fail { {} }
    let txt2 = dict_get(inner, "response") ?? ""
    if3 len(txt2) > 0 { return txt2 }
    let choices = try3 { dict_get(inner, "choices") ?? [] } fail { [] }
    if3 len(choices) > 0 {
        let msg = dict_get(choices[0], "message") ?? {}
        return dict_get(msg, "content") ?? ""
    }
    return ""
}

fn _swarm_parse_response(resp_body_raw) {
    let rb = trim(resp_body_raw)
    let d = try3 { json_decode(rb) } fail { null }
    if3 d != null { return d }
    let sb = replace(rb, "\n", "\\n")
    let sb = replace(sb, "\r", "\\r")
    let sb = replace(sb, "\t", "\\t")
    let d2 = try3 { json_decode(sb) } fail { null }
    return d2
}

fn _swarm_dispatch_one(prompt, system_prompt, provider) {
    let req_body = {"prompt": prompt, "provider": provider}
    if3 len(system_prompt) > 0 {
        req_body = dict_set(req_body, "system_prompt", system_prompt)
    }
    let body_str = json_encode(req_body)
    let endpoint = ROUTER_URL + "/api/v1/query"

    let t0 = time()
    let resp = try3 { http_post_headers(endpoint, body_str, {"Content-Type": "application/json"}, SWARM_TIMEOUT_MS) } fail { null }
    let elapsed = floor((time() - t0) * 1000)

    if3 resp == null {
        return {"ok": false, "provider": provider, "error": "timeout", "time_ms": elapsed}
    }

    let resp_body = dict_get(resp, "body") ?? ""
    let data = _swarm_parse_response(resp_body)
    if3 data == null {
        return {"ok": false, "provider": provider, "error": "parse_failed", "time_ms": elapsed}
    }

    let rok = dict_get(data, "ok") ?? -1
    if3 rok != 1 {
        return {"ok": false, "provider": provider, "error": dict_get(data, "error") ?? "unknown", "time_ms": elapsed}
    }

    let response_text = _swarm_extract_response(data)
    let model = dict_get(data, "model") ?? "unknown"
    let result = dict_get(data, "result") ?? {}
    if3 len(model) == 0 { model = dict_get(result, "model") ?? "unknown" }

    if3 len(response_text) < SWARM_MIN_RESPONSE_LEN {
        return {"ok": false, "provider": provider, "error": "response_too_short", "time_ms": elapsed}
    }

    return {"ok": true, "provider": provider, "model": model, "response": response_text, "tokens": len(response_text), "time_ms": elapsed, "domain": dict_get(data, "territory") ?? "general"}
}

fn swarm_run(prompt, system_prompt, target_providers) {
    let t0 = time()
    let providers = target_providers
    if3 len(providers) == 0 {
        providers = _swarm_get_providers()
    }

    print("[SWARM] Dispatching to " + str(len(providers)) + " providers")

    let results = []
    let successes = 0
    let failures = 0
    let total_tokens = 0

    let i = 0
    while3 i < len(providers) {
        let prov = providers[i]
        print("[SWARM] -> " + prov + " (" + str(i + 1) + "/" + str(len(providers)) + ")")

        let result = _swarm_dispatch_one(prompt, system_prompt, prov)
        let rok = dict_get(result, "ok") ?? false

        if3 rok == true {
            results = append(results, result)
            successes = successes + 1
            let toks = dict_get(result, "tokens") ?? 0
            total_tokens = total_tokens + toks
            print("[SWARM]    OK: " + str(toks) + " tokens")
        }
        if3 rok != true {
            failures = failures + 1
            print("[SWARM]    FAIL: " + dict_get(result, "error") ?? "unknown")
        }

        i = i + 1
    }

    let quantized = fractal_quantize(results)
    let unique = dict_get(quantized, "unique_count") ?? 0
    let synthesis = fractal_synthesize(quantized, prompt)
    let output = dict_get(synthesis, "output") ?? ""
    let elapsed = floor((time() - t0) * 1000)

    print("[SWARM] Complete: " + str(successes) + "/" + str(len(providers)) + " ok, " + str(total_tokens) + " tokens, " + str(elapsed) + "ms")

    return {"ok": 1, "trit": 1, "output": output, "total_tokens": total_tokens, "output_tokens": dict_get(synthesis, "tokens") ?? 0, "providers_hit": len(providers), "providers_ok": successes, "providers_fail": failures, "unique_fragments": unique, "raw_results": results, "method": "swarm_dispatch", "time_ms": elapsed, "version": SWARM_VERSION}
}

fn swarm_fractal_run(prompt, max_rounds) {
    let t0 = time()
    let domains = fractal_classify_prompt(prompt)
    let sub_tasks = fractal_split(prompt, domains)
    print("[SWARM-FRACTAL] Split into " + str(len(sub_tasks)) + " sub-tasks")

    let providers = _swarm_get_providers()
    let all_fragments = []
    let total_tokens = 0
    let total_successes = 0
    let round_num = 0

    while3 round_num < max_rounds {
        print("[SWARM-FRACTAL] === Round " + str(round_num + 1) + "/" + str(max_rounds) + " ===")
        let ti = 0
        while3 ti < len(sub_tasks) {
            let task = sub_tasks[ti]
            let task_prompt = dict_get(task, "prompt") ?? ""
            let task_sys = dict_get(task, "system_prompt") ?? ""
            print("[SWARM-FRACTAL] Sub-task " + str(ti + 1) + ": " + dict_get(task, "domain") ?? "?")

            let swarm_result = swarm_run(task_prompt, task_sys, providers)
            let raw = dict_get(swarm_result, "raw_results") ?? []
            let ri = 0
            while3 ri < len(raw) {
                all_fragments = append(all_fragments, raw[ri])
                ri = ri + 1
            }
            total_tokens = total_tokens + dict_get(swarm_result, "total_tokens") ?? 0
            total_successes = total_successes + dict_get(swarm_result, "providers_ok") ?? 0
            ti = ti + 1
        }
        let target = FRACTAL_TOKEN_TARGET * len(sub_tasks) * 3
        if3 total_tokens > target {
            print("[SWARM-FRACTAL] Token target exceeded, stopping early")
            round_num = max_rounds
        }
        round_num = round_num + 1
    }

    let quantized = fractal_quantize(all_fragments)
    let synthesis = fractal_synthesize(quantized, prompt)
    let elapsed = floor((time() - t0) * 1000)

    print("[SWARM-FRACTAL] COMPLETE: " + str(total_successes) + " responses, " + str(total_tokens) + " tokens, " + str(elapsed) + "ms")

    return {"ok": 1, "trit": 1, "output": dict_get(synthesis, "output") ?? "", "total_tokens": total_tokens, "output_tokens": dict_get(synthesis, "tokens") ?? 0, "total_responses": total_successes, "unique_fragments": dict_get(quantized, "unique_count") ?? 0, "sub_tasks": len(sub_tasks), "domains_detected": domains, "method": "swarm_fractal", "time_ms": elapsed, "version": SWARM_VERSION}
}
