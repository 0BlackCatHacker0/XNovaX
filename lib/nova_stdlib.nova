// ================================================================
// nova_stdlib.nova — NovaX Standard Library Prelude
// Common helpers used across all services
// Version: 0.1.0
// ================================================================

let STDLIB_VERSION = "0.1.0"

// ── Safe accessors ──
fn safe_get(d, key, fallback) {
    let v = try3 { dict_get(d, key) ?? fallback } { fallback }
    return v
}

fn safe_idx(lst, idx, fallback) {
    let v = try3 { lst[idx] } { fallback }
    return v
}

// ── Ternary response builders ──
fn make_ok(data) {
    return {"ok": true, "trit": 1, "data": data}
}

fn make_err(msg) {
    return {"ok": false, "trit": -1, "error": msg}
}

fn make_maybe(msg, data) {
    return {"ok": true, "trit": 0, "warning": msg, "data": data}
}

// ── Numeric helpers ──
fn max_of(a, b) {
    if3 a > b { return a }
    return b
}

fn min_of(a, b) {
    if3 a < b { return a }
    return b
}

fn clamp(val, lo, hi) {
    if3 val < lo { return lo }
    if3 val > hi { return hi }
    return val
}

fn abs_val(x) {
    if3 x < 0 { return 0 - x }
    return x
}

// ── Null/empty checks ──
fn is_empty(val) {
    if3 val == null { return 1 }
    let v = try3 { len(val) } { -1 }
    if3 v == 0 { return 1 }
    if3 v == -1 { return 0 }
    return -1
}

fn coalesce(a, b) {
    if3 a == null { return b }
    return a
}

// ── String helpers ──
fn starts_with(s, prefix) {
    let plen = len(prefix)
    if3 len(s) < plen { return false }
    let sub = try3 { slice(s, 0, plen) } { "" }
    if3 sub == prefix { return true }
    return false
}

fn ends_with(s, suffix) {
    let slen = len(s)
    let plen = len(suffix)
    if3 slen < plen { return false }
    let sub = try3 { slice(s, slen - plen, slen) } { "" }
    if3 sub == suffix { return true }
    return false
}

print("[stdlib] NovaX standard library v" + STDLIB_VERSION + " loaded")
