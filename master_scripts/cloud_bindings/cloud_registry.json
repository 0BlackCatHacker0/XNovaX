{
  "version": "1.0",
  "purpose": "Bind external AI clouds so all models share collective knowledge",
  "bindings": [
    {
      "provider": "anthropic",
      "model": "claude-sonnet-4-20250514",
      "endpoint": "https://api.anthropic.com/v1/messages",
      "status": "active",
      "key_env": "CLAUDE_API_KEY",
      "capabilities": [
        "reasoning",
        "code",
        "creative",
        "analysis"
      ]
    },
    {
      "provider": "ollama_local",
      "models": [
        "novax-llama3",
        "novax-mistral",
        "novax-codestral",
        "novax-codellama",
        "novax-gemma2",
        "novax-phi3",
        "novax-deepseek-coder",
        "novax-llava"
      ],
      "endpoint": "http://localhost:11434",
      "status": "active",
      "capabilities": [
        "code",
        "reasoning",
        "vision",
        "math"
      ]
    },
    {
      "provider": "openai",
      "model": "gpt-4o",
      "endpoint": "https://api.openai.com/v1/chat/completions",
      "status": "pending",
      "key_env": "OPENAI_API_KEY",
      "capabilities": [
        "reasoning",
        "code",
        "vision",
        "creative"
      ]
    },
    {
      "provider": "google",
      "model": "gemini-pro",
      "endpoint": "https://generativelanguage.googleapis.com/v1/models",
      "status": "pending",
      "key_env": "GOOGLE_AI_KEY",
      "capabilities": [
        "reasoning",
        "code",
        "vision",
        "search"
      ]
    },
    {
      "provider": "mistral",
      "model": "mistral-large",
      "endpoint": "https://api.mistral.ai/v1/chat/completions",
      "status": "pending",
      "key_env": "MISTRAL_API_KEY",
      "capabilities": [
        "reasoning",
        "code",
        "multilingual"
      ]
    },
    {
      "provider": "meta",
      "model": "llama-3.1-405b",
      "endpoint": "https://api.together.xyz/v1/chat/completions",
      "status": "pending",
      "key_env": "TOGETHER_API_KEY",
      "capabilities": [
        "reasoning",
        "code",
        "creative"
      ]
    },
    {
      "provider": "huggingface",
      "models": "thousands",
      "endpoint": "https://api-inference.huggingface.co/models",
      "status": "pending",
      "key_env": "HF_API_KEY",
      "capabilities": [
        "specialized",
        "research",
        "custom"
      ]
    },
    {
      "provider": "replicate",
      "models": "community",
      "endpoint": "https://api.replicate.com/v1/predictions",
      "status": "pending",
      "key_env": "REPLICATE_API_KEY",
      "capabilities": [
        "image_gen",
        "audio",
        "video",
        "specialized"
      ]
    }
  ],
  "collective_mode": {
    "description": "When enabled, queries route to best model for the task. All models share skill outputs. Cloud data pools accessible to any bound model.",
    "router": "C:\\NovaX\\master_scripts\\shared_skills\\skill_router.js",
    "status": "planned"
  }
}