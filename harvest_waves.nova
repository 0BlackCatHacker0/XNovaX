// NovaX LLM Harvest — Waves 3-7 (65 prompts)
// Pure NovaLang, N-S paced, micro-tool pattern

let all_prompts = [
  // Wave 3: Math + Logic (H14-H26)
  "What is modular arithmetic",
  "Explain the Fibonacci sequence",
  "What is a prime number sieve",
  "Define matrix multiplication",
  "What is Big O notation",
  "Explain recursion vs iteration",
  "What is a binary search tree",
  "Define a graph traversal algorithm",
  "What is dynamic programming",
  "Explain the traveling salesman problem",
  "What is linear regression",
  "Define Bayesian probability",
  "What is a Fourier transform",
  // Wave 4: Security + Crypto (H27-H39)
  "What is a zero knowledge proof",
  "Explain public key cryptography",
  "What is a digital signature",
  "Define a certificate authority",
  "What is TLS and how does the handshake work",
  "Explain cross site scripting prevention",
  "What is SQL injection and how to prevent it",
  "Define two factor authentication",
  "What is a firewall and how does it work",
  "Explain buffer overflow attacks",
  "What is sandboxing in security",
  "Define intrusion detection systems",
  "What is a VPN tunnel",
  // Wave 5: AI + ML (H40-H52)
  "What is reinforcement learning",
  "Explain convolutional neural networks",
  "What is attention mechanism in transformers",
  "Define transfer learning",
  "What is quantization in neural networks",
  "Explain federated learning",
  "What is a GAN and how does it work",
  "Define few shot learning",
  "What is RLHF in language models",
  "Explain mixture of experts architecture",
  "What is model pruning",
  "Define embedding vectors",
  "What is retrieval augmented generation",
  // Wave 6: Systems + Architecture (H53-H65)
  "What is microservice architecture",
  "Explain event driven programming",
  "What is a message queue",
  "Define container orchestration",
  "What is serverless computing",
  "Explain load balancing algorithms",
  "What is database sharding",
  "Define eventual consistency",
  "What is a reverse proxy",
  "Explain circuit breaker pattern",
  "What is service mesh",
  "Define API gateway pattern",
  "What is blue green deployment",
  // Wave 7: Physics + Math for N-S (H66-H78)
  "What is turbulent flow in fluid dynamics",
  "Explain laminar flow characteristics",
  "What is viscosity in fluids",
  "Define pressure gradient in physics",
  "What is the Kolmogorov microscale",
  "Explain vortex shedding",
  "What is the Reynolds averaged equation",
  "Define boundary layer theory",
  "What is the Bernoulli principle",
  "Explain the continuity equation",
  "What is dimensional analysis",
  "Define the energy cascade in turbulence",
  "What is spectral analysis of turbulence"
]

let success = 0
let total = len(all_prompts)
let i = 0

print("=== NOVAX LLM MEGA HARVEST ===")
print("Prompts: " + str(total))
print("Provider: cerebras_direct (Qwen 235B)")
print("Pacing: H5 seconds (5s)")
print("")

while3 i < total {
  let p = all_prompts[i]
  let body = json_encode({"prompt": p + ". Plain text answer only. No markdown or special characters."})
  let h = {"Content-Type": "application/json"}
  let result = try3 { http_request("http://127.0.0.1:9878/api/v1/query", body, h, 20000) } fail { {} }
  let resp = dict_get(result, "body") ?? ""
  if3 len(resp) > 20 {
    let parsed = try3 { json_decode(resp) } fail { {} }
    let response = dict_get(parsed, "response") ?? ""
    let provider = dict_get(parsed, "provider") ?? "unknown"
    if3 len(response) > 3 {
      write_file("C:/NovaX/data/super_archive/h" + str(i + 27) + ".json", resp)
      success = success + 1
      print("H" + str(i + 27) + ": +1 " + provider + " " + str(len(response)) + "ch")
    } else3 {
      print("H" + str(i + 27) + ": 0")
    }
  } else3 {
    print("H" + str(i + 27) + ": -1")
  }
  sleep(5000)
  i = i + 1
}

print("")
print("MEGA HARVEST: " + str(success) + "/" + str(total))
print("Total archive files: check C:/NovaX/data/super_archive/")
