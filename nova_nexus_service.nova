print("[Nexus] Scripts indexed: " + str(len(keys(scripts_index))))
print("[Nexus] Archive indexed: " + str(len(keys(archive_index))))
print("[Nexus] Upstream: OLLAMA=" + OLLAMA + " HIVE=" + HIVE + " CLOUD=" + CLOUD)
print("[Nexus] Upstream: BRAIN=" + BRAIN + " RELAY=" + RELAY + " VPN=" + VPN + " BRIDGE=" + BRIDGE)
print("[Nexus] Harmonics: H3=" + str(H3) + " H5=" + str(H5) + " H7=" + str(H7) + " H13=" + str(H13) + " BLOCK=" + str(BLOCK))
