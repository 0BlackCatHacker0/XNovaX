// POST /focus - focus a window by hwnd, pid, or title search
fn handle_focus(body) {
    let hwnd = dict_get(body, "hwnd", 0)
    let search = dict_get(body, "search", dict_get(body, "name", ""))
    let pid = dict_get(body, "pid", 0)
    let result = helper("focus", {"hwnd": hwnd, "search": search, "pid": pid})
    return result
}

// POST /click - click at coordinates (absolute or window-relative)
fn handle_click(body) {
    let result = helper("click", body)
    return result
}

// POST /doubleclick - double-click at coordinates
fn handle_doubleclick(body) {
    let result = helper("doubleclick", body)
    return result
}

// POST /scroll - scroll at coordinates
fn handle_scroll(body) {
    let delta = dict_get(body, "delta", H3)
    let direction = dict_get(body, "direction", "up")
    dict_set(body, "delta", delta)
    dict_set(body, "direction", direction)
    let result = helper("scroll", body)
    return result
}

// POST /drag - drag from one point to another
fn handle_drag(body) {
    let steps = dict_get(body, "steps", H7)
    let duration = dict_get(body, "duration", 0.3)
    dict_set(body, "steps", steps)
    dict_set(body, "duration", duration)
    let result = helper("drag", body)
    return result
}

// POST /clicktext - find a child control by text and click its center
fn handle_clicktext(body) {
    let result = helper("clicktext", body)
    return result
}

// POST /filedialog - type a path into an open file dialog and press Enter
fn handle_filedialog(body) {
    let filepath = dict_get(body, "path", "")
    if len(filepath) == 0 {
        return {"ok": false, "trit": T_FALSE, "error": "path required"}
    }
    let result = helper("filedialog", {"path": filepath})
    return result
}

// POST /type - type text using unicode input events
fn handle_type(body) {
    let text = dict_get(body, "text", "")
    let hwnd = dict_get(body, "hwnd", 0)
    let result = helper("type_text", {"text": text, "hwnd": hwnd})
    return result
}

// POST /key - press a single key
fn handle_key(body) {
    let key = upper(dict_get(body, "key", ""))
    let vk = dict_get(body, "vk", dict_get(VK_MAP, key, 0))
    let hwnd = dict_get(body, "hwnd", 0)
    if vk == 0 {
        return {"ok": false, "trit": T_FALSE, "error": "Unknown key: " + key}
    }
    let result = helper("send_key", {"vk": vk, "hwnd": hwnd, "key": key})
    return result
}

// POST /hotkey - send a hotkey combo like ["ctrl", "a"]
fn handle_hotkey(body) {
    let hk_keys = dict_get(body, "keys", [])
    let hwnd = dict_get(body, "hwnd", 0)
    // Resolve VK codes for each key name
    let vks = []
    let ki = 0
    while3 ki < len(hk_keys) {
        let kname = upper(dict_get(hk_keys, ki))
        let vk = dict_get(VK_MAP, kname, 0)
        if vk > 0 {
            append(vks, vk)
        }
        let ki = ki + 1
    }
    let result = helper("hotkey", {"vks": vks, "hwnd": hwnd, "keys": hk_keys})
    return result
}

// POST /move - move and resize a window
fn handle_move(body) {
    let result = helper("move_window", body)
    return result
}

// POST /embed - remove title bar and embed window at position
fn handle_embed(body) {
    let search = dict_get(body, "search", dict_get(body, "name", ""))
    let x = dict_get(body, "x", 0)
    let y = dict_get(body, "y", 0)
    let w = dict_get(body, "w", 800)
    let h = dict_get(body, "h", 600)
    let result = helper("embed", {"search": search, "x": x, "y": y, "w": w, "h": h})
    return result
}

// POST /unembed - restore title bar to window
fn handle_unembed(body) {
    let search = dict_get(body, "search", dict_get(body, "name", ""))
    let result = helper("unembed", {"search": search})
    return result
}

// POST /rect - get window rect
fn handle_rect(body) {
    let search = dict_get(body, "search", dict_get(body, "name", ""))
    let result = helper("find_window", {"search": search})
    let w = dict_get(result, "window", {})
    if len(keys(w)) > 0 {
        return {"ok": true, "trit": T_TRUE, "window": w}
    }
    return {"ok": false, "trit": T_FALSE, "error": "Window not found"}
}

// POST /launch - launch an app
fn handle_launch(body) {
    let name = dict_get(body, "name", "")
    let exe = dict_get(body, "exe", "")
    if len(exe) == 0 {
        return {"ok": false, "trit": T_FALSE, "error": "exe path required"}
    }
    // Check if already running
    if dict_has(apps, name) {
        let existing = dict_get(apps, name, {})
        let existing_trit = dict_get(existing, "trit", T_FALSE)
        if existing_trit == T_TRUE {
            return {"ok": true, "trit": T_MAYBE, "status": "already_running", "app": existing}
        }
    }
    let args = dict_get(body, "args", [])
    let result = helper("launch", {"name": name, "exe": exe, "args": args})
    let ok = dict_get(result, "ok", false)
    if ok == true {
        let pid = dict_get(result, "pid", 0)
        let app_entry = {
            "pid": pid,
            "exe": exe,
            "hwnd": 0,
            "trit": T_TRUE,
            "name": name,
            "started": time()
        }
        dict_set(apps, name, app_entry)
        return {"ok": true, "trit": T_TRUE, "status": "launched", "pid": pid, "name": name}
    }
    return result
}

// POST /close - close a tracked app
fn handle_close(body) {
    let name = dict_get(body, "name", "")
    if dict_has(apps, name) == false {
        return {"ok": false, "trit": T_FALSE, "error": str(name) + " not tracked"}
    }
    let app_info = dict_get(apps, name, {})
    let pid = dict_get(app_info, "pid", 0)
    let result = helper("kill_pid", {"pid": pid})
    dict_del(apps, name)
    return {"ok": true, "trit": T_TRUE, "closed": name}
}

// POST /minimize - minimize a window
fn handle_minimize(body) {
    let search = dict_get(body, "search", "")
    let result = helper("minimize", {"search": search})
    return result
}

// POST /maximize - maximize a window
fn handle_maximize(body) {
    let search = dict_get(body, "search", "")
    let result = helper("maximize", {"search": search})
    return result
}

// POST /restore - restore a window
fn handle_restore(body) {
    let search = dict_get(body, "search", "")
    let result = helper("restore", {"search": search})
    return result
}

// POST /task/create - create a new task
fn handle_task_create(body) {
    let goal = dict_get(body, "goal", "")
    if len(goal) == 0 {
        return {"ok": false, "trit": T_FALSE, "error": "goal required"}
    }
    let agent_id = dict_get(body, "agent_id", "")
    let priority = int(dict_get(body, "priority", 0))
    let parent_id = dict_get(body, "parent_id", "")
    let context = dict_get(body, "context", {})
    let task = create_task(goal, agent_id, priority, parent_id, context)
    return {"ok": true, "trit": T_TRUE, "task": task}
}

// POST /task/claim - claim a task for execution
fn handle_task_claim(body) {
    let agent_id = dict_get(body, "agent_id", "unknown")
    let task_id = dict_get(body, "task_id", "")
    let task = {}
    if len(task_id) > 0 {
        let task = claim_task_by_id(agent_id, task_id)
    }
    if len(task_id) == 0 {
        let task = claim_next_task(agent_id)
    }
    if len(keys(task)) > 0 {
        return {"ok": true, "trit": T_TRUE, "task": task}
    }
    return {"ok": false, "trit": T_MAYBE, "error": "No tasks available"}
}

// POST /task/update - update task status/result
fn handle_task_update(body) {
    let task_id = dict_get(body, "task_id", "")
    let status = dict_get(body, "status", "")
    let result = dict_get(body, "result", "")
    let error = dict_get(body, "error", "")
    let action_log = dict_get(body, "action_log", "")
    let task = update_task(task_id, status, result, error, action_log)
    if len(keys(task)) > 0 {
        return {"ok": true, "trit": T_TRUE, "task": task}
    }
    return {"ok": false, "trit": T_FALSE, "error": "Task " + str(task_id) + " not found"}
}

// POST /task/batch - create multiple tasks at once
fn handle_task_batch(body) {
    let goals = dict_get(body, "goals", [])
    let batch_agent = dict_get(body, "agent_id", "")
    let created = []
    let gi = 0
    while3 gi < len(goals) {
        let g = dict_get(goals, gi)
        let g_type = type_of(g)
        if g_type == "string" {
            let t = create_task(g, batch_agent, 0, "", {})
            append(created, t)
        }
        if g_type == "dict" {
            let g_goal = dict_get(g, "goal", "")
            let g_agent = dict_get(g, "agent_id", batch_agent)
            let g_pri = int(dict_get(g, "priority", 0))
            let g_parent = dict_get(g, "parent_id", "")
            let g_ctx = dict_get(g, "context", {})
            let t = create_task(g_goal, g_agent, g_pri, g_parent, g_ctx)
            append(created, t)
        }
        let gi = gi + 1
    }
    return {"ok": true, "trit": T_TRUE, "tasks": created, "count": len(created)}
}

// POST /blender/exec - execute Python in Blender via file bridge
fn handle_blender_exec(body) {
    let code = dict_get(body, "code", "")
    if len(code) == 0 {
        return {"ok": false, "trit": T_FALSE, "error": "code required"}
    }
    // Clear old result
    try3 {
        nova_write(BLENDER_RESULT_FILE, "")
    } else {}
    // Write command
    let cmd_id = str(int(time() * 1000))
    let cmd_data = json_encode({"code": code, "id": cmd_id, "ts": time()})
    try3 {
        nova_write(BLENDER_CMD_FILE, cmd_data)
    } else {
        return {"ok": false, "trit": T_FALSE, "error": "write cmd failed"}
    }
    // Poll for result (up to timeout seconds)
    let timeout = float(dict_get(body, "timeout", 10))
    let polls = int(timeout / 0.5)
    let poll_i = 0
    let found = false
    let bresult = {}
    while3 poll_i < polls {
        // Sleep 0.5s via helper
        let _w = nova_run("ping -n 1 -w 500 127.0.0.1 >nul 2>&1", 2)
        let raw = ""
        try3 {
            let raw = nova_read(BLENDER_RESULT_FILE)
        } else {}
        if len(str(raw)) > 1 {
            try3 {
                let bresult = json_decode(raw)
                let found = true
                // Clear result file
                try3 {
                    nova_write(BLENDER_RESULT_FILE, "")
                } else {}
            } else {}
        }
        if found == true {
            let poll_i = polls
        }
        let poll_i = poll_i + 1
    }
    if found == true {
        let btrit = T_FALSE
        if dict_get(bresult, "ok", false) == true {
            let btrit = T_TRUE
        }
        return {"ok": dict_get(bresult, "ok", false), "trit": btrit, "result": bresult}
    }
    return {"ok": false, "trit": T_FALSE, "error": "Blender did not respond -- ensure NovaX Bridge addon is active"}
}

// POST /blender/status - check if Blender bridge addon is responsive
fn handle_blender_status(body) {
    let probe_code = "_result = {'bridge': True}"
    let probe_body = {"code": probe_code, "timeout": 3}
    let result = handle_blender_exec(probe_body)
    let ok = dict_get(result, "ok", false)
    if ok == true {
        return {"ok": true, "trit": T_TRUE, "addon_active": true}
    }
    return {"ok": true, "trit": T_MAYBE, "addon_active": false, "hint": "Run Blender bridge addon"}
}

// POST /script - multi-action scripting: execute a sequence of actions
fn handle_script(body) {
    let actions = dict_get(body, "actions", [])
    // If body itself is a list, use that
    if type_of(body) == "list" {
        let actions = body
    }
    let results = []
    let si = 0
    while3 si < len(actions) {
        let act = dict_get(actions, si)
        let a = dict_get(act, "action", "")
        let r = {"i": si, "action": a, "trit": T_MAYBE}
        try3 {
            match3 a {
                "focus" {
                    let sr = helper("focus", act)
                    let r = {"i": si, "action": a, "trit": dict_get(sr, "trit", T_FALSE)}
                }
                "click" {
                    let sr = helper("click", act)
                    let r = {"i": si, "action": a, "trit": T_TRUE, "x": dict_get(act, "x", 0), "y": dict_get(act, "y", 0)}
                }
                "doubleclick" {
                    let sr = helper("doubleclick", act)
                    let r = {"i": si, "action": a, "trit": T_TRUE}
                }
                "type" {
                    let sr = helper("type_text", act)
                    let r = {"i": si, "action": a, "trit": T_TRUE}
                }
                "key" {
                    let k = upper(dict_get(act, "key", ""))
                    let vk = dict_get(VK_MAP, k, 0)
                    if vk > 0 {
                        let sr = helper("send_key", {"vk": vk, "key": k})
                        let r = {"i": si, "action": a, "trit": T_TRUE, "key": k}
                    }
                    if vk == 0 {
                        let r = {"i": si, "action": a, "trit": T_FALSE, "error": "unknown key " + k}
                    }
                }
                "hotkey" {
                    let hkeys = dict_get(act, "keys", [])
                    let hvks = []
                    let hki = 0
                    while3 hki < len(hkeys) {
                        let hkn = upper(dict_get(hkeys, hki))
                        let hvk = dict_get(VK_MAP, hkn, 0)
                        if hvk > 0 {
                            append(hvks, hvk)
                        }
                        let hki = hki + 1
                    }
                    let sr = helper("hotkey", {"vks": hvks, "keys": hkeys})
                    let r = {"i": si, "action": a, "trit": T_TRUE}
                }
                "wait" {
                    let wait_ms = dict_get(act, "ms", 100)
                    let wait_s = wait_ms / 1000.0
                    // Use ping for sleep
                    let wait_cmd = "ping -n 1 -w " + str(int(wait_ms)) + " 127.0.0.1 >nul 2>&1"
                    let _w = nova_run(wait_cmd, 5)
                    let r = {"i": si, "action": a, "trit": T_TRUE}
                }
                "move" {
                    let sr = helper("move_window", act)
                    let r = {"i": si, "action": a, "trit": dict_get(sr, "trit", T_FALSE)}
                }
                "minimize" {
                    let sr = helper("minimize", act)
                    let r = {"i": si, "action": a, "trit": dict_get(sr, "trit", T_FALSE)}
                }
                "maximize" {
                    let sr = helper("maximize", act)
                    let r = {"i": si, "action": a, "trit": dict_get(sr, "trit", T_FALSE)}
                }
                "restore" {
                    let sr = helper("restore", act)
                    let r = {"i": si, "action": a, "trit": dict_get(sr, "trit", T_FALSE)}
                }
                "scroll" {
                    let sr = helper("scroll", act)
                    let r = {"i": si, "action": a, "trit": T_TRUE}
                }
                "drag" {
                    let sr = helper("drag", act)
                    let r = {"i": si, "action": a, "trit": T_TRUE}
                }
                "launch" {
                    let sr = helper("launch", act)
                    let r = {"i": si, "action": a, "trit": dict_get(sr, "trit", T_FALSE)}
                }
                "close" {
                    let cname = dict_get(act, "name", dict_get(act, "search", ""))
                    let sr = helper("kill_pid", {"name": cname})
                    let r = {"i": si, "action": a, "trit": dict_get(sr, "trit", T_FALSE)}
                }
                "clicktext" {
                    let sr = helper("clicktext", act)
                    let r = {"i": si, "action": a, "trit": dict_get(sr, "trit", T_FALSE)}
                }
                "filedialog" {
                    let fp = dict_get(act, "path", "")
                    if len(fp) > 0 {
                        let sr = helper("filedialog", {"path": fp})
                        let r = {"i": si, "action": a, "trit": T_TRUE, "path": fp}
                    }
                    if len(fp) == 0 {
                        let r = {"i": si, "action": a, "trit": T_FALSE, "error": "path required"}
                    }
                }
                "keydown" {
                    let k = upper(dict_get(act, "key", ""))
                    let vk = dict_get(VK_MAP, k, 0)
                    if vk > 0 {
                        let sr = helper("keydown", {"vk": vk, "key": k})
                        let r = {"i": si, "action": a, "trit": T_TRUE, "key": k}
                    }
                    if vk == 0 {
                        let r = {"i": si, "action": a, "trit": T_FALSE, "error": "unknown key " + k}
                    }
                }
                "keyup" {
                    let k = upper(dict_get(act, "key", ""))
                    let vk = dict_get(VK_MAP, k, 0)
                    if vk > 0 {
                        let sr = helper("keyup", {"vk": vk, "key": k})
                        let r = {"i": si, "action": a, "trit": T_TRUE, "key": k}
                    }
                    if vk == 0 {
                        let r = {"i": si, "action": a, "trit": T_FALSE, "error": "unknown key " + k}
                    }
                }
                "mousemove" {
                    let sr = helper("mousemove", act)
                    let r = {"i": si, "action": a, "trit": T_TRUE}
                }
                "blender_exec" {
                    let bcode = dict_get(act, "code", "")
                    if len(bcode) > 0 {
                        let br = handle_blender_exec({"code": bcode, "timeout": dict_get(act, "timeout", 10)})
                        let r = {"i": si, "action": a, "trit": dict_get(br, "trit", T_FALSE), "result": dict_get(br, "result", {})}
                    }
                    if len(bcode) == 0 {
                        let r = {"i": si, "action": a, "trit": T_FALSE, "error": "code required"}
                    }
                }
                _ {
                    let r = {"i": si, "action": a, "trit": T_MAYBE, "error": "unknown action"}
        } else {
            let r = {"i": si, "action": a, "trit": T_FALSE, "error": "action exec failed"}
        }
        append(results, r)
        let si = si + 1
    }
    // Count passed
    let passed = 0
    let ri = 0
    while3 ri < len(results) {
        let rr = dict_get(results, ri)
        if dict_get(rr, "trit", T_FALSE) == T_TRUE {
            let passed = passed + 1
        }
        let ri = ri + 1
    }
    let overall_trit = T_TRUE
    if passed < len(results) {
        let overall_trit = T_MAYBE
    }
    if passed == 0 {
        if len(results) > 0 {
            let overall_trit = T_FALSE
        }
    }
    return {"ok": true, "trit": overall_trit, "results": results, "passed": passed, "total": len(results)}
}

