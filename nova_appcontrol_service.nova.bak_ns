// LIVE HTML - streaming screenshot viewer
// ============================================================
let LIVE_HTML = "<!DOCTYPE html><html><head><title>NovaX Live Preview</title><style>*{margin:0;padding:0;box-sizing:border-box;}body{background:#0a0a0f;overflow:hidden;font-family:Consolas,monospace;color:#e0e0e0;}#viewport{width:100vw;height:calc(100vh - 40px);object-fit:contain;display:block;}#bar{height:40px;background:linear-gradient(180deg,#1a1a2e 0%,#0f0f1a 100%);display:flex;align-items:center;padding:0 12px;gap:10px;border-top:1px solid #00ff8833;}.label{color:#00ff88;font-size:11px;font-weight:bold;letter-spacing:1px;}.stat{color:#888;font-size:10px;}.stat b{color:#0f8;}.btn{background:#00ff8818;border:1px solid #00ff8844;color:#00ff88;padding:3px 10px;border-radius:3px;cursor:pointer;font-size:10px;font-family:inherit;}.btn:hover{background:#00ff8833;border-color:#00ff88;}#target{background:#0003;border:1px solid #333;color:#ccc;padding:3px 8px;border-radius:3px;font-size:10px;font-family:inherit;width:180px;}.spacer{flex:1;}#status{width:8px;height:8px;border-radius:50%;background:#00ff88;box-shadow:0 0 6px #00ff88;}</style></head><body><img id='viewport' src='/screenshot?target=active'><div id='bar'><div id='status'></div><span class='label'>NOVAX LIVE</span><select id='target'><option value='active'>Active Window</option><option value='Blender'>Blender</option><option value='ChatGPT'>ChatGPT</option><option value='Claude'>Claude Desktop</option><option value=''>Desktop (All)</option></select><button class='btn' onclick=\"setTarget('Blender')\">BLD</button><button class='btn' onclick=\"setTarget('ChatGPT')\">GPT</button><button class='btn' onclick=\"setTarget('Claude')\">CLD</button><button class='btn' onclick=\"setTarget('active')\">ACT</button><span class='spacer'></span><span class='stat'><b id='fps'>--</b> fps</span><span class='stat'><b id='size'>--</b></span><span class='stat'><b id='tgt'>active</b></span></div><script>var img=document.getElementById('viewport');var fpsEl=document.getElementById('fps');var sizeEl=document.getElementById('size');var tgtEl=document.getElementById('tgt');var sel=document.getElementById('target');var target='active',frames=0,last=Date.now(),running=true;function setTarget(t){target=t;sel.value=t;tgtEl.textContent=t||'desktop';refresh();}sel.onchange=function(){setTarget(sel.value);};function refresh(){if(!running)return;var t=Date.now();var url=target?'/screenshot?target='+encodeURIComponent(target)+'&t='+t:'/screenshot?t='+t;img.src=url;frames++;if(t-last>1000){fpsEl.textContent=frames;frames=0;last=t;}}img.onload=function(){sizeEl.textContent=img.naturalWidth+'x'+img.naturalHeight;setTimeout(refresh,200);};img.onerror=function(){setTimeout(refresh,1000);};refresh();</script></body></html>"

// ============================================================
// VK_MAP - Virtual key code lookup
// ============================================================
let VK_MAP = {
    "ENTER": 13, "RETURN": 13, "ESCAPE": 27, "ESC": 27,
    "TAB": 9, "SPACE": 32, "BACKSPACE": 8, "DELETE": 46,
    "UP": 38, "DOWN": 40, "LEFT": 37, "RIGHT": 39,
    "HOME": 36, "END": 35, "PAGEUP": 33, "PAGEDOWN": 34,
    "F1": 112, "F2": 113, "F3": 114, "F4": 115,
    "F5": 116, "F6": 117, "F7": 118, "F8": 119,
    "F9": 120, "F10": 121, "F11": 122, "F12": 123,
    "CTRL": 17, "CONTROL": 17, "ALT": 18, "SHIFT": 16,
    "WIN": 91, "LWIN": 91, "RWIN": 92,
    "A": 65, "B": 66, "C": 67, "D": 68, "E": 69,
    "F": 70, "G": 71, "H": 72, "I": 73, "J": 74,
    "K": 75, "L": 76, "M": 77, "N": 78, "O": 79,
    "P": 80, "Q": 81, "R": 82, "S": 83, "T": 84,
    "U": 85, "V": 86, "W": 87, "X": 88, "Y": 89, "Z": 90,
    "0": 48, "1": 49, "2": 50, "3": 51, "4": 52,
    "5": 53, "6": 54, "7": 55, "8": 56, "9": 57
}

// ============================================================
// Route Handlers
// ============================================================

// GET /health
fn handle_health(body) {
    return {
        "status": "ok",
        "service": "nova-appcontrol",
        "port": PORT,
        "uptime": round(time() - start_time),
        "trit": T_TRUE,
        "session": "desktop",
        "runtime": "novalang",
        "version": "3.0"
    }
}

// GET /windows - enumerate all visible windows
fn handle_windows(body) {
    let result = helper("enum_windows", {})
    let wins = dict_get(result, "windows", [])
    return {"ok": true, "trit": T_TRUE, "windows": wins, "count": len(wins)}
}

// GET /find/<search> - find window by title substring
// Note: NovaLang troute does not support path params, so we use POST
fn handle_find(body) {
    let search = dict_get(body, "search", "")
    if len(search) == 0 {
        return {"ok": false, "trit": T_FALSE, "error": "search required"}
    }
    let result = helper("find_window", {"search": search})
    let w = dict_get(result, "window", {})
    if len(keys(w)) > 0 {
        return {"ok": true, "trit": T_TRUE, "window": w}
    }
    return {"ok": false, "trit": T_FALSE, "error": "No window matching search"}
}

// GET /screenshot - capture window/desktop screenshot as PNG
// Delegated entirely to helper which returns base64-encoded PNG
fn handle_screenshot(body) {
    let target = dict_get(body, "target", last_target)
    if len(str(target)) > 0 {
        let last_target = target
    }
    let result = helper("screenshot", {"target": target})
    return result
}

// GET /elements - find child controls of a target window
fn handle_elements(body) {
    let search = dict_get(body, "search", dict_get(body, "target", ""))
    let result = helper("elements", {"search": search})
    return result
}

// GET /state - machine-readable screen state for AI decision-making
fn handle_state(body) {
    let target = dict_get(body, "target", "")
    let result = helper("screen_state", {"target": target})
    return result
}

// GET /tasks - list all tasks
fn handle_tasks(body) {
    let pending = []
    let active = []
    let tkeys = keys(tasks)
    let i = 0
    while3 i < len(tkeys) {
        let tid = tkeys[i]
        let t = dict_get(tasks, tid, {})
        let st = dict_get(t, "status", "")
        if st == "pending" {
            append(pending, t)
        }
        if st == "claimed" {
            append(active, t)
        }
        if st == "running" {
            append(active, t)
        }
        let i = i + 1
    }
    let hist_start = len(task_history) - 10
    if hist_start < 0 {
        let hist_start = 0
    }
    let recent_hist = slice(task_history, hist_start, len(task_history))
    return {
        "ok": true,
        "trit": T_TRUE,
        "pending": pending,
        "active": active,
        "history": recent_hist,
        "counts": {
            "pending": len(pending),
            "active": len(active),
            "history": len(task_history)
        }
    }
}

// GET /live - streaming screenshot HTML viewer
fn handle_live(body) {
    return {"_html": LIVE_HTML}
}

// GET /apps - list tracked launched apps
fn handle_apps(body) {
    let app_list = values(apps)
    return {"ok": true, "trit": T_TRUE, "apps": app_list, "count": len(app_list)}
}

