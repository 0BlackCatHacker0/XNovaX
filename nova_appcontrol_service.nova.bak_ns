// Nova AppControl Service v3.0 - Autonomous Desktop Agent Runtime (NovaLang)
// Port 9887: Window management, keyboard/mouse, screenshots, Blender bridge,
// task queue, screen state reading. All ctypes ops delegated to helper script.
//
// N-S Mapping:
//   desktop_flow    = velocity_field
//   window_state    = particle_position
//   input_action    = force_application
//   task_queue      = laminar_pipeline
//   trit            = Reynolds classification (+1 ok, 0 partial, -1 fail)
//
// All Win32/ctypes operations are delegated via nova_run() to:
//   appcontrol_helper.py <command> <json_args>
// This avoids forbidden import/class/ctypes in NovaLang.

let PORT = 9887
let server = tserve(PORT, "Nova AppControl v3.0 - Desktop Agent Runtime")

// -- 3-5-7-13 Harmonic Constants --
let H3  = 3
let H5  = 5
let H7  = 7
let H13 = 13
let BLOCK = 2187

// -- Ternary constants --
let T_TRUE  = 1
let T_MAYBE = 0
let T_FALSE = -1

// -- Reynolds boundaries --
let RE_LAMINAR      = 27
let RE_TRANSITIONAL = 125
let RE_TURBULENT    = 343

// -- Paths --
let HELPER = "C:\\NovaX\\appcontrol_helper.py"
let PW = "C:\\Users\\Jupit\\AppData\\Local\\Programs\\Python\\Python312\\pythonw.exe"
let TASK_FILE = "C:\\NovaX\\memory\\agent_tasks.json"
let BLENDER_CMD_FILE = "C:\\NovaX\\memory\\blender_cmd.json"
let BLENDER_RESULT_FILE = "C:\\NovaX\\memory\\blender_result.json"

// -- Global State --
let start_time = time()
let tasks = {}
let task_queue = []
let task_history = []
let TASK_HISTORY_MAX = 100
let apps = {}
let last_target = ""

// ============================================================
// Helper: run a Win32 operation via the Python helper script
// Returns parsed JSON result or error dict
// ============================================================
fn run_helper(command, args_json) {
    let cmd_str = PW + " " + HELPER + " " + command + " " + args_json
    let raw = ""
    try3 {
        let raw = nova_run(cmd_str, 15)
    } else {
        return {"ok": false, "trit": T_FALSE, "error": "helper exec failed"}
    }
    let result = {}
    try3 {
        let result = json_decode(raw)
    } else {
        return {"ok": false, "trit": T_FALSE, "error": "helper parse failed", "raw": str(raw)}
    }
    return result
}

// Helper shorthand: run_helper with a dict encoded to JSON
fn helper(command, args_dict) {
    let j = json_encode(args_dict)
    return run_helper(command, j)
}

// ============================================================
// Ternary trit classifier
// ============================================================
fn trit(val) {
    if val == true {
        return T_TRUE
    }
    if val == false {
        return T_FALSE
    }
    if type_of(val) == "number" {
        if val > 0 {
            return T_TRUE
        }
        if val < 0 {
            return T_FALSE
        }
    }
    return T_MAYBE
}

// ============================================================
// Task Queue System
// Multi-AI coordination: create -> claim -> run -> complete/fail
// Uses list + slice instead of deque (forbidden)
// ============================================================

fn save_tasks() {
    let data = json_encode({"tasks": tasks, "queue": task_queue, "ts": time()})
    try3 {
        nova_write(TASK_FILE, data)
    } else {}
    return T_TRUE
}

fn load_tasks() {
    let raw = ""
    try3 {
        let raw = nova_read(TASK_FILE)
    } else {
        return T_FALSE
    }
    if len(str(raw)) == 0 {
        return T_FALSE
    }
    let data = {}
    try3 {
        let data = json_decode(raw)
    } else {
        return T_FALSE
    }
    try3 {
        let tasks = data["tasks"]
    } else {}
    try3 {
        let task_queue = data["queue"]
    } else {}
    // Reset any stuck running tasks back to pending
    let tkeys = keys(tasks)
    let i = 0
    while3 i < len(tkeys) {
        let tid = tkeys[i]
        let t = dict_get(tasks, tid, {})
        let st = dict_get(t, "status", "")
        if st == "running" {
            dict_set(t, "status", "pending")
            // Add back to queue if not already there
            let found = false
            let qi = 0
            while3 qi < len(task_queue) {
                if dict_get(task_queue, qi) == tid {
                    let found = true
                }
                let qi = qi + 1
            }
            if found == false {
                append(task_queue, tid)
            }
        }
        let i = i + 1
    }
    return T_TRUE
}

fn create_task(goal, agent_id, priority, parent_id, context) {
    let tid = slice(uuid_hex(), 0, 8)
    let task = {
        "id": tid,
        "goal": goal,
        "status": "pending",
        "priority": priority,
        "agent_id": agent_id,
        "parent_id": parent_id,
        "context": context,
        "actions": [],
        "result": "",
        "created": time(),
        "claimed_at": 0,
        "completed_at": 0,
        "error": ""
    }
    dict_set(tasks, tid, task)
    append(task_queue, tid)
    save_tasks()
    return task
}

fn claim_task_by_id(agent_id, task_id) {
    if dict_has(tasks, task_id) == false {
        return {}
    }
    let t = dict_get(tasks, task_id, {})
    let st = dict_get(t, "status", "")
    if st != "pending" {
        return {}
    }
    dict_set(t, "status", "claimed")
    dict_set(t, "agent_id", agent_id)
    dict_set(t, "claimed_at", time())
    // Remove from queue
    let new_q = []
    let qi = 0
    while3 qi < len(task_queue) {
        let qval = dict_get(task_queue, qi)
        if qval != task_id {
            append(new_q, qval)
        }
        let qi = qi + 1
    }
    let task_queue = new_q
    save_tasks()
    return t
}

fn claim_next_task(agent_id) {
    // Find highest priority pending task
    let best_id = ""
    let best_pri = -9999
    let qi = 0
    while3 qi < len(task_queue) {
        let tid = dict_get(task_queue, qi)
        let t = dict_get(tasks, tid, {})
        let st = dict_get(t, "status", "")
        if st == "pending" {
            let pri = dict_get(t, "priority", 0)
            if pri > best_pri {
                let best_pri = pri
                let best_id = tid
            }
        }
        let qi = qi + 1
    }
    if len(best_id) > 0 {
        return claim_task_by_id(agent_id, best_id)
    }
    return {}
}

fn update_task(task_id, status, result, error, action_log) {
    if dict_has(tasks, task_id) == false {
        return {}
    }
    let t = dict_get(tasks, task_id, {})
    if len(str(status)) > 0 {
        dict_set(t, "status", status)
    }
    if len(str(result)) > 0 {
        dict_set(t, "result", result)
    }
    if len(str(error)) > 0 {
        dict_set(t, "error", error)
    }
    if len(str(action_log)) > 0 {
        let acts = dict_get(t, "actions", [])
        append(acts, action_log)
        dict_set(t, "actions", acts)
    }
    if status == "completed" {
        dict_set(t, "completed_at", time())
        append(task_history, t)
        // Cap history
        if len(task_history) > TASK_HISTORY_MAX {
            let task_history = slice(task_history, len(task_history) - TASK_HISTORY_MAX, len(task_history))
        }
    }
    if status == "failed" {
        dict_set(t, "completed_at", time())
        append(task_history, t)
        if len(task_history) > TASK_HISTORY_MAX {
            let task_history = slice(task_history, len(task_history) - TASK_HISTORY_MAX, len(task_history))
        }
    }
    save_tasks()
    return t
}

// Load tasks from disk on startup
let _load_ok = load_tasks()

