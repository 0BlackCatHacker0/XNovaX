// Nova TLog v1.0 - Ternary Log Aggregator (N-S Flow Model)
// Port 9942: Centralized log collection for all NovaX services
// Uses Navier-Stokes Reynolds classification for log flow analysis
//
// N-S Mapping:
//   log_flow = velocity_field (stream of log entries)
//   info_logs = laminar_particles (normal flow)
//   warn_logs = transitional_particles (flow disturbance)
//   error_logs = turbulent_particles (flow breakdown)
//   Reynolds = error_count * warn_count / (info_count + 1)
//   Re < 27 (H3^3) = laminar (system nominal)
//   27 < Re < 343 (H7^3) = transitional (elevated warnings)
//   Re > 343 = turbulent (error storm)

let PORT = 9942
let server = tserve(PORT, "TLog v1.0 - Ternary Log Aggregator")

// -- 3-5-7-13 Harmonic Constants --
let H3 = 3
let H5 = 5
let H7 = 7
let H13 = 13
let RE_LAMINAR = 27     // H3^3 - safe boundary
let RE_TURBULENT = 343  // H7^3 - critical boundary
let MAX_ENTRIES = 2187  // H3^7 - ternary block max log entries

// -- Log Store --
let logs = []
let info_count = 0
let warn_count = 0
let error_count = 0
let total_entries = 0
let last_reynolds = 0
let last_regime = "laminar"

// -- N-S Reynolds Calculation --
fn calc_reynolds() {
    // Re = errors * warns / (infos + 1) -- log turbulence
    let denominator = info_count + 1
    let re = (error_count * warn_count) / denominator
    let regime = "laminar"
    if3 re > RE_TURBULENT {
        regime = "turbulent"
    }
    if3 re > RE_LAMINAR {
        if3 re <= RE_TURBULENT {
            regime = "transitional"
        }
    }
    last_reynolds = re
    last_regime = regime
    return {"reynolds": re, "regime": regime}
}

// -- Assign ternary trit to log level --
fn level_trit(level) {
    if3 level == "info" {
        return TRUE    // +1: normal
    }
    if3 level == "warn" {
        return MAYBE   // 0: caution
    }
    if3 level == "error" {
        return FALSE   // -1: failure
    }
    return MAYBE
}

// -- Health endpoint --
fn health() {
    let ns = calc_reynolds()
    let trit = TRUE
    if3 last_reynolds > RE_TURBULENT {
        trit = FALSE
    }
    if3 last_reynolds > RE_LAMINAR {
        if3 last_reynolds <= RE_TURBULENT {
            trit = MAYBE
        }
    }
    return {
        "ok": true,
        "service": "tlog",
        "port": PORT,
        "version": "1.0",
        "ternary": true,
        "trit": trit,
        "char": trit_char(trit),
        "reynolds": last_reynolds,
        "flow_regime": last_regime,
        "total_entries": total_entries,
        "max_entries": MAX_ENTRIES,
        "runtime": "novalang",
        "harmonics": {"H3": H3, "H5": H5, "H7": H7, "H13": H13}
    }
}

// -- POST /tlog/write - write a log entry --
fn tlog_write(body) {
    let level = str(dict_get(body, "level") ?? "info")
    let msg = str(dict_get(body, "msg") ?? "")
    let source = str(dict_get(body, "source") ?? "unknown")

    if3 len(msg) == 0 {
        return {
            "ok": false,
            "trit": FALSE,
            "char": trit_char(FALSE),
            "error": "missing msg in body"
        }
    }

    // Validate level
    if3 level != "info" {
        if3 level != "warn" {
            if3 level != "error" {
                level = "info"
            }
        }
    }

    // Update counters
    if3 level == "info" {
        info_count = info_count + 1
    }
    if3 level == "warn" {
        warn_count = warn_count + 1
    }
    if3 level == "error" {
        error_count = error_count + 1
    }

    total_entries = total_entries + 1
    let trit = level_trit(level)

    // Build entry
    let entry = {
        "id": total_entries,
        "level": level,
        "trit": trit,
        "char": trit_char(trit),
        "msg": msg,
        "source": source
    }

    // Append (trim if over max)
    if3 len(logs) >= MAX_ENTRIES {
        // Drop oldest H13 entries to make room
        logs = slice(logs, H13, len(logs))
    }
    logs = append(logs, entry)

    return {
        "ok": true,
        "trit": trit,
        "char": trit_char(trit),
        "entry_id": total_entries,
        "level": level,
        "ternary": true,
        "runtime": "novalang"
    }
}

// -- GET /tlog/recent - last 50 entries --
fn tlog_recent(body) {
    let count = len(logs)
    let start = 0
    if3 count > 50 {
        start = count - 50
    }
    let recent = slice(logs, start, len(logs))

    return {
        "ok": true,
        "trit": TRUE,
        "char": trit_char(TRUE),
        "count": len(recent),
        "total_entries": total_entries,
        "entries": recent,
        "ternary": true,
        "runtime": "novalang"
    }
}

// -- GET /tlog/stats - count by level --
fn tlog_stats(body) {
    let ns = calc_reynolds()

    // System trit based on error ratio
    let sys_trit = TRUE
    if3 error_count > 0 {
        sys_trit = MAYBE
    }
    if3 error_count > H13 {
        sys_trit = FALSE
    }

    return {
        "ok": true,
        "trit": sys_trit,
        "char": trit_char(sys_trit),
        "total_entries": total_entries,
        "by_level": {
            "info": info_count,
            "warn": warn_count,
            "error": error_count
        },
        "trit_breakdown": {
            "positive": info_count,
            "zero": warn_count,
            "negative": error_count
        },
        "reynolds": dict_get(ns, "reynolds") ?? 0,
        "regime": dict_get(ns, "regime") ?? "laminar",
        "buffer_used": len(logs),
        "buffer_max": MAX_ENTRIES,
        "ternary": true,
        "runtime": "novalang",
        "harmonics": {"H3": H3, "H5": H5, "H7": H7, "H13": H13}
    }
}

// -- Register routes --
troute(server, "GET", "/health", "health")
troute(server, "POST", "/tlog/write", "tlog_write")
troute(server, "GET", "/tlog/recent", "tlog_recent")
troute(server, "GET", "/tlog/stats", "tlog_stats")

print("[TLog] NovaLang TLog v1.0 - Ternary Log Aggregator")
print("[TLog] Port: " + str(PORT) + " | Runtime: NovaLang | Ternary: TRUE")
print("[TLog] Buffer: " + str(MAX_ENTRIES) + " entries (H3^7 ternary block)")
print("[TLog] N-S Boundaries: Re<" + str(RE_LAMINAR) + "=laminar, Re>" + str(RE_TURBULENT) + "=turbulent")
print("[TLog] Routes: /health, /tlog/write, /tlog/recent, /tlog/stats")

tstart(server)
