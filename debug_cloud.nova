// GET /health | /status | /api/v1/status
troute(server, "GET", "/health", fn(req) {
  let regime = classify_traffic()
  let re_num  = current_qpm()
  let pkeys   = keys(PROVS)
  let ptrits  = []
  let alive   = 0
  let pi = 0
  while3 pi < len(pkeys) {
    let pk = pkeys[pi]
    let ht = provider_health3(pk)
    ptrits = append(ptrits, ht)
    if3 ht >= T_MAYBE { alive = alive + 1 }
    pi = pi + 1
  }
  let health_bt = bt_string(ptrits)
  let active_ct = 0
  let pki = 0
  while3 pki < len(pkeys) {
    let pv = dict_get(PROVS, pkeys[pki])
    if3 pv != "" { pv_on = dict_get(pv, "on")
      if3 pv_on == 1 { active_ct = active_ct + 1 }
    }
    let pki = pki + 1
  }
  let uptime = round(time() - stats_t0)
  {
    "router": "Nova Cloud Router v2.0",
    "port": PORT,
    "ternary": 1,
    "harmonics": { "H3": H3, "H5": H5, "H7": H7, "H13": H13 },
    "uptime": uptime,
    "queries": stats_queries,
    "tokens": stats_tokens,
    "active": active_ct,
    "total": len(pkeys),
    "reynolds": re_num,
    "flow_regime": regime,
    "health_bt": health_bt,
    "providers_alive": alive,
    "quality_summary": {
      "strong":  stats_quality_true,
      "partial": stats_quality_maybe,
      "failed":  stats_quality_false
    }
  }
})

troute(server, "GET", "/status",       fn(req) { troute_call(server, "GET", "/health", req) })
troute(server, "GET", "/api/v1/status", fn(req) { troute_call(server, "GET", "/health", req) })

