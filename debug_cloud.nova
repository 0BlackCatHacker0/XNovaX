  let regime = classify_traffic()
  let re_num  = current_qpm()
  let elapsed = time() - stats_t0
  if3 elapsed < 1 { elapsed = 1 }
  let qpm_f = round(stats_queries / (elapsed / 60), 1)
  {
    "reynolds": re_num,
    "regime": regime,
    "boundaries": { "laminar": RE_LAMINAR, "transitional": RE_TRANSITION, "turbulent": RE_TURBULENT },
    "qpm": qpm_f,
    "total_queries": stats_queries,
    "quality_distribution": {
      "strong":  stats_quality_true,
      "partial": stats_quality_maybe,
      "failed":  stats_quality_false
    }
  }
})

// GET /api/v1/quality
troute(server, "GET", "/api/v1/quality", fn(req) {
  let pks = keys(PROVS)
  let fp  = {}
  let pi  = 0
  while3 pi < len(pks) {
    let pk   = pks[pi]
    let hist = dict_get(stats_prov_trits, pk)
    if3 hist == "" { hist = [] }
    let hlen = len(hist)
    if3 hlen == 0 { fp = dict_set(fp, pk, { "bt": "", "score": 0, "samples": 0 })
    } else { avg  = round(sum(hist) / hlen, 3)
      let h13_start = 0
      if3 hlen > H13 { h13_start = hlen - H13 }
      let hist13 = slice(hist, h13_start, hlen)
      let bt_fp  = bt_string(hist13)
      let qt_fp  = trit(int(avg))
      let ct_true  = 0
      let ct_maybe = 0
      let ct_false = 0
      let hi = 0
      while3 hi < hlen {
        if3 hist[hi] == T_TRUE  { ct_true  = ct_true  + 1 }
        elif hist[hi] == T_MAYBE { let ct_maybe = ct_maybe + 1 }
        else3 { ct_false = ct_false + 1 }
        hi = hi + 1
      }
      fp = dict_set(fp, pk, {
        "bt":      bt_fp,
        "score":   avg,
        "samples": hlen,
        "trit":    qt_fp,
        "strong":  ct_true,
        "partial": ct_maybe,
        "failed":  ct_false
      })
    }
    pi = pi + 1
  }
  { "providers": fp, "total_queries": stats_queries }
})

// GET /api/v1/cloud
troute(server, "GET", "/api/v1/cloud", fn(req) {
  let pks      = keys(PROVS)
  let mod_count = 0
  let cloud_ct  = 0
  let local_ct  = 0
  let pi = 0
  while3 pi < len(pks) {
    let pv = dict_get(PROVS, pks[pi])
    if3 pv != "" { pv_on    = dict_get(pv, "on")
      let pv_cloud = dict_get(pv, "cloud")
      let pv_mods  = dict_get(pv, "models")
      if3 pv_on == "" { pv_on = 0 }
      if3 pv_cloud == "" { pv_cloud = 0 }
      if3 pv_mods  == "" { pv_mods  = [] }
      let mod_count = mod_count + len(pv_mods)
      if3 pv_on == 1 {
        if3 pv_cloud == 1 { cloud_ct = cloud_ct + 1 }
        else3 { local_ct = local_ct + 1 }
      }
    }
    pi = pi + 1
  }
  // Try to count Ollama local models
  let ol_extra = 0
  let raw_tags = try3 http_get("http://127.0.0.1:11434/api/tags")
  if3 raw_tags != "" { jtags = json_decode(raw_tags)
    let omods = dict_get(jtags, "models")
    if3 omods != "" { ol_extra = len(omods) }
  }
  {
    "models":  mod_count + ol_extra,
    "cloud":   cloud_ct,
    "local":   local_ct,
    "queries": stats_queries,
    "tokens":  stats_tokens
  }
})

// POST /api/v1/query  -- fan-out across providers
troute(server, "POST", "/api/v1/query", fn(req) {
  let body   = dict_get(req, "body")
  if3 body == "" { body = {} }
  let prompt = dict_get(body, "prompt")
  if3 prompt == "" { prompt = dict_get(body, "message") }
  if3 prompt == "" {
    { "err": "prompt required", "_status": 400 }
  } else { pids  = dict_get(body, "providers")
    let model = dict_get(body, "model")
    if3 pids  == "" { pids  = [] }
    if3 model == "" { model = "" }

    let results = fanout(prompt, pids, model)
    let rlen = len(results)

    // Tally results
    let ok_list     = []
    let strong_list = []
    let partial_list = []
    let failed_list = []
    let total_tok   = 0
    let ri = 0
    while3 ri < rlen {
      let r_i     = results[ri]
      let ok_i    = dict_get(r_i, "ok")
      let qt_i    = dict_get(r_i, "quality_trit")
      let tok_i   = dict_get(r_i, "tok")
      if3 ok_i  == "" { ok_i = 0 }
      if3 qt_i  == "" { qt_i = T_FALSE }
      if3 tok_i == "" { tok_i = 0 }
      if3 ok_i == 1 { ok_list = append(ok_list, r_i)
        let total_tok = total_tok + tok_i
        if3 qt_i == T_TRUE  { strong_list  = append(strong_list,  r_i) }
        elif qt_i == T_MAYBE { let partial_list = append(partial_list, r_i) }
        else3 { failed_list = append(failed_list, r_i) }
      } else { failed_list = append(failed_list, r_i)
      }
      ri = ri + 1
    }

    stats_queries = stats_queries + 1
    let stats_tokens  = stats_tokens  + total_tok

    // Build quality_bt string from all result trits
    let all_qt = []
    let qi2 = 0
    while3 qi2 < rlen {
      let r_qt = dict_get(results[qi2], "quality_trit")
      if3 r_qt == "" { r_qt = T_FALSE }
      all_qt = append(all_qt, r_qt)
      let qi2 = qi2 + 1
    }
    let q_bt = bt_string(all_qt)

    let regime  = classify_traffic()
    let re_num2 = current_qpm()

    // Best result: highest quality_trit first, then fastest ms
    let best_result = ""
    if3 len(strong_list) > 0 { best_result = strong_list[0]
    } elif len(ok_list) > 0 {
      let best_result = ok_list[0]
    }

    {
      "best":      best_result,
      "results":   results,
      "tokens":    total_tok,
      "queried":   rlen,
      "succeeded": len(ok_list),
      "ternary": {
        "strong":     len(strong_list),
        "partial":    len(partial_list),
        "failed":     len(failed_list),
        "quality_bt": q_bt,
        "reynolds":   re_num2,
        "regime":     regime
      }
    }
  }
})

// POST /api/v1/bind  -- configure a provider key / enabled state
troute(server, "POST", "/api/v1/bind", fn(req) {
  let body = dict_get(req, "body")
  if3 body == "" { body = {} }
  let pid    = dict_get(body, "provider")
  let api_k  = dict_get(body, "api_key")
  let on_val = dict_get(body, "enabled")
  if3 pid == "" {
    { "err": "unknown provider", "_status": 400 }
  } elif dict_has(PROVS, pid) == 0 {
    { "err": "unknown provider", "_status": 400 }
  } else { pr = dict_get(PROVS, pid)
    if3 api_k  != "" { pr = dict_set(pr, "key", api_k) }
    if3 on_val != "" { pr = dict_set(pr, "on",  on_val) }
    // If key provided but enabled not specified, enable automatically
    if3 api_k != "" && on_val == "" { pr = dict_set(pr, "on", 1)
    }
    PROVS = dict_set(PROVS, pid, pr)
    save_config()
    let final_pr = dict_get(PROVS, pid)
    let fkey = dict_get(final_pr, "key")
    let fon  = dict_get(final_pr, "on")
    let fkey_bool = 0
    if3 len(fkey) > 0 { fkey_bool = 1 }
    { "bound": pid, "on": fon, "key": fkey_bool }
  }
})

// POST /api/v1/transfer  -- compress / decompress files
// All encoding uses certutil (native Windows, no Python dependencies).
troute(server, "POST", "/api/v1/transfer", fn(req) {
  let body = dict_get(req, "body")
  if3 body == "" { body = {} }
  let act = dict_get(body, "action")
  if3 act == "" { act = "compress" }

  if3 act == "compress" { fp = dict_get(body, "path")
    if3 fp == "" {
      { "err": "path required", "_status": 400 }
    } else {
      // Validate path is under safe roots
      let safe_check = nova_run("cmd /c if exist \"" + fp + "\" (echo SAFE) else (echo MISSING)")
      let safe_check = replace(replace(safe_check, "\r\n", ""), "\n", "")
      if3 safe_check == "MISSING" {
        { "err": "path not found", "_status": 404 }
      } else {
        // Base64 encode via certutil (no Python, no blue windows)
        let win_fp = replace(fp, "/", "\\")
        let b64_tmp = "C:\\NovaX\\temp\\b64_out.txt"
        let enc_cmd = "cmd /c certutil -encode \"" + win_fp + "\" \"" + b64_tmp + "\" >nul 2>&1"
        nova_run(enc_cmd)
        let b64_raw = read_file(b64_tmp)
        let b64_lines = split(b64_raw, "\n")
        let b64_clean = ""
        let bi = 1
        while3 bi < len(b64_lines) - 1 {
          b64_clean = b64_clean + trim(b64_lines[bi])
          bi = bi + 1
        }
        let sz_cmd = "cmd /c for %I in (\"" + win_fp + "\") do @echo %~zI"
        let orig_sz = to_int(trim(nova_run(sz_cmd)))
        let enc_sz = len(b64_clean)
        nova_run("cmd /c del /q \"" + b64_tmp + "\" 2>nul")
        if3 b64_clean == "" {
          { "err": "compress failed", "_status": 500 }
        } else {
          { "orig": orig_sz, "compressed": enc_sz, "b64": b64_clean }
        }
      }
    }
  } elif act == "tzip" {
    let fp   = dict_get(body, "path")
    let data = dict_get(body, "data")
    if3 fp == "" && data == "" {
      { "err": "path or data required", "_status": 400 }
    } else {
      // TZip compress: base64 encoding via certutil (native, no Python)
      let win_fp2 = replace(fp, "/", "\\")
      let b64_tmp2 = "C:\\NovaX\\temp\\tzip_b64.txt"
      let enc_cmd2 = "cmd /c certutil -encode \"" + win_fp2 + "\" \"" + b64_tmp2 + "\" >nul 2>&1"
      nova_run(enc_cmd2)
      let b64_raw2 = read_file(b64_tmp2)
      let b64_lines2 = split(b64_raw2, "\n")
      let b64_data2 = ""
      let bi2 = 1
      while3 bi2 < len(b64_lines2) - 1 {
        b64_data2 = b64_data2 + trim(b64_lines2[bi2])
        bi2 = bi2 + 1
      }
      let sz_cmd2 = "cmd /c for %I in (\"" + win_fp2 + "\") do @echo %~zI"
      let orig2 = to_int(trim(nova_run(sz_cmd2)))
      nova_run("cmd /c del /q \"" + b64_tmp2 + "\" 2>nul")
      let tzip_j = {}
      tzip_j = dict_set(tzip_j, "method", "base64")
      tzip_j = dict_set(tzip_j, "orig_size", orig2)
      tzip_j = dict_set(tzip_j, "encoded_size", len(b64_data2))
      tzip_j = dict_set(tzip_j, "data", b64_data2)
      if3 b64_data2 == "" {
        { "err": "tzip failed", "_status": 500 }
      } else {
        tzip_j
      }
    }
  } elif act == "tunzip" {
    let fp  = dict_get(body, "path")
    let b64 = dict_get(body, "b64")
    if3 fp == "" && b64 == "" {
      { "err": "path or b64 required", "_status": 400 }
    } else {
      // TZip decompress: base64 decode via certutil (native, no Python)
      let win_fp3 = replace(fp, "/", "\\")
      let decoded_out = "C:\\NovaX\\temp\\tunzip_out.bin"
      let dec_cmd3 = "cmd /c certutil -decode \"" + win_fp3 + "\" \"" + decoded_out + "\" >nul 2>&1 && echo OK"
      let dec_result = trim(nova_run(dec_cmd3))
      let tunzip_j = {}
      if3 contains(dec_result, "OK") {
        let dec_sz_cmd = "cmd /c for %I in (\"" + decoded_out + "\") do @echo %~zI"
        let dec_sz = to_int(trim(nova_run(dec_sz_cmd)))
        tunzip_j = dict_set(tunzip_j, "ok", true)
        tunzip_j = dict_set(tunzip_j, "decoded_size", dec_sz)
        tunzip_j = dict_set(tunzip_j, "output", decoded_out)
        tunzip_j
      } else {
        tunzip_j = dict_set(tunzip_j, "ok", false)
        tunzip_j = dict_set(tunzip_j, "error", "decode failed")
        { "err": "tunzip failed", "_status": 500 }
      }
    }
  } else {
    { "err": "unknown action", "_status": 400 }
  }
})

// Catch-all 404
troute(server, "GET", "/*", fn(req) {
  {
    "err": "not found",
    "endpoints": ["/health", "/status", "/api/v1/status", "/api/v1/providers",
                  "/api/v1/cloud", "/api/v1/seals", "/api/v1/health3",
                  "/api/v1/reynolds", "/api/v1/quality",
                  "/api/v1/query", "/api/v1/bind", "/api/v1/transfer"],
    "_status": 404
  }
})

// ============================================================
// STARTUP SEQUENCE
// ============================================================
load_config()
load_env_keys()
probe_ollama()

let startup_active = 0
let startup_keys = keys(PROVS)
let si = 0
while3 si < len(startup_keys) {
  let spv = dict_get(PROVS, startup_keys[si])
  if3 spv != "" { spv_on = dict_get(spv, "on")
    if3 spv_on == 1 { startup_active = startup_active + 1 }
  }
  si = si + 1
}
let startup_cloud = 0
let sci = 0
while3 sci < len(startup_keys) {
  let spv2 = dict_get(PROVS, startup_keys[sci])
  if3 spv2 != "" { spv2_on    = dict_get(spv2, "on")
    let spv2_cloud = dict_get(spv2, "cloud")
    if3 spv2_on == 1 && spv2_cloud == 1 { startup_cloud = startup_cloud + 1 }
  }
  let sci = sci + 1
}

// Build startup health banner
let banner_trits = []
let bti = 0
while3 bti < len(startup_keys) {
  let bht = provider_health3(startup_keys[bti])
  banner_trits = append(banner_trits, bht)
  let bti = bti + 1
}
let banner_bt = bt_string(banner_trits)

print("Nova Cloud Router v2.0 (Ternary) on :" + str(PORT))
print("  Harmonics: 3-5-7-13 | Providers: " + str(startup_active) + " active (" + str(startup_cloud) + " cloud)")
print("  Health BT: " + banner_bt + " | Reynolds: laminar/" + str(RE_LAMINAR) + " trans/" + str(RE_TRANSITION) + " turb/" + str(RE_TURBULENT))
print("  Ternary: quality_trit per response, health3 per provider, Reynolds traffic flow")

}
}
tstart(server)
