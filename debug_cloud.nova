  let k_tog = replace(replace(k_tog, "\r\n", ""), "\n", "")
  let k_ort = replace(replace(k_ort, "\r\n", ""), "\n", "")

  // Only bind non-empty, non-placeholder values
}
  fn bind_key(pid, k) {
