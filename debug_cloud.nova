fn probe_ollama() {
  let raw = try3 http_get("http://127.0.0.1:11434/api/tags")
  if3 raw == "" {
}
}
    print("[Router] Ollama offline")
  } else { j    = json_decode(raw)
    let mods = dict_get(j, "models")
    let names = []
    if3 mods != "" { mi = 0
      while3 mi < len(mods) {
        let m_entry = mods[mi]
        let mn = dict_get(m_entry, "name")
        if3 mn != "" { names = append(names, mn) }
