// GET /api/v1/health3
troute(server, "GET", "/api/v1/health3", fn(req) {
  let pks     = keys(PROVS)
  let ptrits  = {}
  let trit_list = []
  let alive   = 0
  let strong  = 0
  let pi = 0
  while3 pi < len(pks) {
    let pk  = pks[pi]
    let ht  = provider_health3(pk)
    let hist = dict_get(stats_prov_trits, pk)
    if3 hist == "" { hist = [] }
    let hlen = len(hist)
    let avg_q = 0
    if3 hlen > 0 { avg_q = round(sum(hist) / hlen, 2)
    }
    let h7_start = 0
    if3 hlen > H7 { h7_start = hlen - H7 }
    let hist7  = slice(hist, h7_start, hlen)
    let qt_char = quality_char(ht)
    let trit_char = qt_char
    let qbt = bt_string(hist7)
    ptrits = dict_set(ptrits, pk, {
      "trit":           ht,
      "trit_char":      trit_char,
      "quality_avg":    avg_q,
      "quality_history": hist7,
      "quality_bt":     qbt
    })
    trit_list = append(trit_list, ht)
    if3 ht >= T_MAYBE { alive = alive + 1 }
    if3 ht == T_TRUE  { strong = strong + 1 }
    pi = pi + 1
  }
  let health_bt = bt_string(trit_list)
  { "health_bt": health_bt, "providers": ptrits, "total": len(pks), "alive": alive, "strong": strong }
})

