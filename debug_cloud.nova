// Query Ollama local
fn qollama(prompt, model) {
  if3 len(model) == 0 { model = "novax-mistral" }
  let body = json_encode({ "model": model, "prompt": prompt, "stream": 0 })
  let t0 = time()
  let raw = try3 http_post("http://127.0.0.1:11434/api/generate", body, { "Content-Type": "application/json" })
  if3 raw == "" { result = { "prov": "ollama", "model": model, "err": "connection failed", "ok": 0, "resp": "", "tok": 0, "ms": 0 }
  } else { j   = json_decode(raw)
    let ms  = int((time() - t0) * 1000)
    let r   = dict_get(j, "response")
    let tok = dict_get(j, "eval_count")
    if3 r   == "" { r   = "" }
    if3 tok == "" { tok = 0 }
    let result = { "prov": "ollama", "model": model, "resp": r, "tok": tok, "ms": ms, "ok": 1, "err": "" }
  }
  result
}

// Query Cortex desktop bridge (Claude or GPT)
fn qcortex(prompt, model) {
  if3 len(model) == 0 { model = "cortex:claude" }
  let endpoint = ""
  if3 contains(model, "claude") { endpoint = "/cortex/claude"
  } else { endpoint = "/cortex/gpt"
  }
  let body = json_encode({ "prompt": prompt })
  let t0   = time()
  let raw  = try3 http_post("http://127.0.0.1:9896" + endpoint, body, { "Content-Type": "application/json" })
  if3 raw == "" { result = { "prov": "cortex", "model": model, "err": "cortex bridge offline", "ok": 0, "resp": "", "tok": 0, "ms": 0 }
  } else { j   = json_decode(raw)
    let ms  = int((time() - t0) * 1000)
    let ok_val = dict_get(j, "ok")
    let resp   = dict_get(j, "response")
    if3 ok_val == "" { ok_val = 0 }
    if3 resp   == "" { resp   = "" }
    let result = { "prov": "cortex", "model": model, "resp": resp, "tok": 0, "ms": ms, "ok": ok_val, "err": "" }
  }
  result
}

// Query OpenAI-compatible provider (openai, mistral, groq, deepseek, cohere, together, openrouter)
fn qoai(pid, prompt, model) {
  let pr = dict_get(PROVS, pid)
  if3 pr == "" { result = { "prov": pid, "model": model, "err": "unknown provider", "ok": 0, "resp": "", "tok": 0, "ms": 0 }
  } else { key = dict_get(pr, "key")
    let on  = dict_get(pr, "on")
    if3 on == "" { on = 0 }
    if3 len(key) == 0 || on == 0 { result = { "prov": pid, "model": model, "err": "not configured", "ok": 0, "resp": "", "tok": 0, "ms": 0 }
    } else { purl = dict_get(pr, "url")
      if3 len(model) == 0 { mlist = dict_get(pr, "models")
        if3 mlist == "" { model = "gpt-4o"
        } else { model = mlist[0]
        }
      }
      let body = json_encode({ "model": model, "messages": [{ "role": "user", "content": prompt }], "max_tokens": 4096 })
      let hdrs = { "Content-Type": "application/json", "Authorization": "Bearer " + key }
      let t0   = time()
      let raw  = try3 http_post(purl + "/chat/completions", body, hdrs)
      if3 raw == "" { result = { "prov": pid, "model": model, "err": "request failed", "ok": 0, "resp": "", "tok": 0, "ms": 0 }
      } else { j       = json_decode(raw)
        let ms      = int((time() - t0) * 1000)
        let choices = dict_get(j, "choices")
        let resp    = ""
        if3 choices != "" { c0   = choices[0]
          let msg  = dict_get(c0, "message")
          if3 msg != "" { resp = dict_get(msg, "content")
print("[DBG] LINE 400")
            if3 resp == "" { resp = "" }
          }
        }
        let usage    = dict_get(j, "usage")
        let tok_used = 0
        if3 usage != "" { tok_used = dict_get(usage, "total_tokens")
          if3 tok_used == "" { tok_used = 0 }
        }
        let result = { "prov": pid, "model": model, "resp": resp, "tok": tok_used, "ms": ms, "ok": 1, "err": "" }
      }
    }
  }
  result
}

// Query Anthropic (uses x-api-key header, not Bearer)
fn qanthropic(prompt, model) {
  let pr = dict_get(PROVS, "anthropic")
  if3 pr == "" { result = { "prov": "anthropic", "model": model, "err": "not configured", "ok": 0, "resp": "", "tok": 0, "ms": 0 }
  } else { key = dict_get(pr, "key")
    let on  = dict_get(pr, "on")
    if3 on == "" { on = 0 }
    if3 len(key) == 0 || on == 0 { result = { "prov": "anthropic", "model": model, "err": "not configured", "ok": 0, "resp": "", "tok": 0, "ms": 0 }
    } else {
      if3 len(model) == 0 { model = "claude-sonnet-4-20250514" }
      let body = json_encode({ "model": model, "max_tokens": 4096, "messages": [{ "role": "user", "content": prompt }] })
      let hdrs = { "Content-Type": "application/json", "x-api-key": key, "anthropic-version": "2023-10-01" }
      let t0   = time()
      let raw  = try3 http_post("https://api.anthropic.com/v1/messages", body, hdrs)
      if3 raw == "" { result = { "prov": "anthropic", "model": model, "err": "request failed", "ok": 0, "resp": "", "tok": 0, "ms": 0 }
      } else { j    = json_decode(raw)
        let ms   = int((time() - t0) * 1000)
        let cont = dict_get(j, "content")
        let resp = ""
        if3 cont != "" { ci = 0
          while3 ci < len(cont) {
            let blk  = cont[ci]
            let btyp = dict_get(blk, "type")
            if3 btyp == "text" { resp = resp + dict_get(blk, "text")
            }
            ci = ci + 1
          }
        }
        let usage   = dict_get(j, "usage")
        let tok_in  = 0
        let tok_out = 0
        if3 usage != "" { tok_in  = dict_get(usage, "input_tokens")
          let tok_out = dict_get(usage, "output_tokens")
          if3 tok_in  == "" { tok_in  = 0 }
          if3 tok_out == "" { tok_out = 0 }
        }
        let tok_used = tok_in + tok_out
        let result = { "prov": "anthropic", "model": model, "resp": resp, "tok": tok_used, "ms": ms, "ok": 1, "err": "" }
      }
    }
  }
  result
}

// Query Google Gemini (API-key in URL param)
fn qgoogle(prompt, model) {
  let pr = dict_get(PROVS, "google")
  if3 pr == "" { result = { "prov": "google", "model": model, "err": "not configured", "ok": 0, "resp": "", "tok": 0, "ms": 0 }
  } else { key = dict_get(pr, "key")
    let on  = dict_get(pr, "on")
    if3 on == "" { on = 0 }
    if3 len(key) == 0 || on == 0 { result = { "prov": "google", "model": model, "err": "not configured", "ok": 0, "resp": "", "tok": 0, "ms": 0 }
    } else {
      if3 len(model) == 0 { model = "gemini-2.0-flash" }
      let base_url = dict_get(pr, "url")
      let gurl = base_url + "/models/" + model + ":generateContent?key=" + key
      let body = json_encode({ "contents": [{ "parts": [{ "text": prompt }] }] })
      let t0   = time()
      let raw  = try3 http_post(gurl, body, { "Content-Type": "application/json" })
      if3 raw == "" { result = { "prov": "google", "model": model, "err": "request failed", "ok": 0, "resp": "", "tok": 0, "ms": 0 }
      } else { j    = json_decode(raw)
        let ms   = int((time() - t0) * 1000)
        let cands = dict_get(j, "candidates")
        let resp  = ""
        if3 cands != "" { ci = 0
          while3 ci < len(cands) {
            let cand  = cands[ci]
            let cobj  = dict_get(cand, "content")
            if3 cobj != "" { parts = dict_get(cobj, "parts")
              if3 parts != "" { pi = 0
                while3 pi < len(parts) {
                  let pt = parts[pi]
                  let tx = dict_get(pt, "text")
                  if3 tx != "" { resp = resp + tx }
                  pi = pi + 1
                }
              }
            }
            ci = ci + 1
          }
        }
        let meta    = dict_get(j, "usageMetadata")
        let tok_cnt = 0
        if3 meta != "" { tok_cnt = dict_get(meta, "totalTokenCount")
          if3 tok_cnt == "" { tok_cnt = 0 }
        }
        let result = { "prov": "google", "model": model, "resp": resp, "tok": tok_cnt, "ms": ms, "ok": 1, "err": "" }
      }
    }
  }
  result
}

// 3-phase sealed fallback via OpenRouter when primary provider fails
// Phase +1 (T_TRUE):  Paid mapped model
// Phase  0 (T_MAYBE): Smart free cascade (top H7 by quality history)
// Phase -1 (T_FALSE): Full free cascade (last resort)
fn or_fallback(pid, prompt, model) {
  let orp = dict_get(PROVS, "openrouter")
  let fallback_result = { "prov": pid, "model": "", "err": "all_fallbacks_failed", "ok": 0, "resp": "", "tok": 0, "ms": 0 }

  if3 orp == "" { fallback_result = fallback_result
  } else { or_key = dict_get(orp, "key")
    let or_on  = dict_get(orp, "on")
    if3 or_on == "" { or_on = 0 }
    if3 len(or_key) == 0 || or_on == 0 { fallback_result = fallback_result
    } else {
      // Phase +1: Try paid mapped model
      let orm = dict_get(OR_MAP, pid)
      let found = 0
      if3 orm != "" { pr1 = qoai("openrouter", prompt, orm)
        let ok1 = dict_get(pr1, "ok")
        if3 ok1 == "" { ok1 = 0 }
        let resp1 = dict_get(pr1, "resp")
        if3 resp1 == "" { resp1 = "" }
        let ms1   = dict_get(pr1, "ms")
        if3 ms1 == "" { ms1 = 9999 }
        let tok1  = dict_get(pr1, "tok")
        if3 tok1 == "" { tok1 = 0 }
        let qt1 = response_quality(ok1, resp1, ms1, tok1)
        if3 qt1 >= T_MAYBE && ok1 == 1 { pr1 = dict_set(pr1, "prov", pid)
          pr1 = dict_set(pr1, "via", "openrouter")
          pr1 = dict_set(pr1, "fallback_phase", T_TRUE)
          emit_seal(pid, orm, "paid_fallback")
          let fallback_result = pr1
          let found = 1
        }
      }

      if3 found == 0 {
        // Phase 0: Try first H7 free models in OR_FREE list
        let fi = 0
        while3 fi < H7 && fi < len(OR_FREE) && found == 0 {
          let fm  = OR_FREE[fi]
          let pr2 = qoai("openrouter", prompt, fm)
          let ok2 = dict_get(pr2, "ok")
          if3 ok2 == "" { ok2 = 0 }
          let resp2 = dict_get(pr2, "resp")
          if3 resp2 == "" { resp2 = "" }
          let ms2   = dict_get(pr2, "ms")
          if3 ms2 == "" { ms2 = 9999 }
          let tok2  = dict_get(pr2, "tok")
          if3 tok2 == "" { tok2 = 0 }
          let qt2 = response_quality(ok2, resp2, ms2, tok2)
          if3 qt2 >= T_MAYBE && ok2 == 1 { pr2 = dict_set(pr2, "prov", pid)
            pr2 = dict_set(pr2, "via", "openrouter-free")
            pr2 = dict_set(pr2, "model_used", fm)
            pr2 = dict_set(pr2, "fallback_phase", T_MAYBE)
            emit_seal(pid, fm, "smart_free")
            let fallback_result = pr2
            let found = 1
          }
          fi = fi + 1
        }
      }

      if3 found == 0 {
        // Phase -1: Remaining free models (full cascade)
        let fi = H7
        while3 fi < len(OR_FREE) && found == 0 {
          let fm  = OR_FREE[fi]
          let pr3 = qoai("openrouter", prompt, fm)
          let ok3 = dict_get(pr3, "ok")
          if3 ok3 == "" { ok3 = 0 }
          if3 ok3 == 1 { pr3 = dict_set(pr3, "prov", pid)
            pr3 = dict_set(pr3, "via", "openrouter-free")
            pr3 = dict_set(pr3, "model_used", fm)
            pr3 = dict_set(pr3, "fallback_phase", T_FALSE)
            emit_seal(pid, fm, "full_cascade")
            let fallback_result = pr3
            let found = 1
          }
          fi = fi + 1
        }
        if3 found == 0 {
          emit_seal(pid, "none", "all_failed")
        }
      }
    }
  }
  fallback_result
}

// Route a single query to the correct provider function
fn query_provider(pid, prompt, model) {
  let result = { "prov": pid, "model": model, "err": "unknown provider", "ok": 0, "resp": "", "tok": 0, "ms": 0 }

  if3 pid == "ollama" { result = score_and_track(qollama(prompt, model))
  } elif pid == "cortex_claude" || pid == "cortex_gpt" {
    let result = score_and_track(qcortex(prompt, model))
  } elif pid == "anthropic" {
    let r1 = qanthropic(prompt, model)
    let ok1 = dict_get(r1, "ok")
    if3 ok1 == "" { ok1 = 0 }
    if3 ok1 == 1 { result = score_and_track(r1)
    } else { fb = or_fallback(pid, prompt, model)
      let fb_ok = dict_get(fb, "ok")
      if3 fb_ok == "" { fb_ok = 0 }
      if3 fb_ok == 1 { result = score_and_track(fb)
      } else { result = score_and_track(r1)
      }
    }
  } elif pid == "google" {
    let r2 = qgoogle(prompt, model)
    let ok2 = dict_get(r2, "ok")
    if3 ok2 == "" { ok2 = 0 }
    if3 ok2 == 1 { result = score_and_track(r2)
    } else { fb2 = or_fallback(pid, prompt, model)
      let fb2_ok = dict_get(fb2, "ok")
      if3 fb2_ok == "" { fb2_ok = 0 }
      if3 fb2_ok == 1 { result = score_and_track(fb2)
      } else { result = score_and_track(r2)
      }
    }
  } elif pid == "openrouter" {
    let result = score_and_track(qoai("openrouter", prompt, model))
  } else {
    // OpenAI-compatible: openai, mistral, groq, deepseek, cohere, together
    let pr_c = dict_get(PROVS, pid)
    if3 pr_c != "" { key_c = dict_get(pr_c, "key")
      let on_c  = dict_get(pr_c, "on")
      if3 on_c == "" { on_c = 0 }
      if3 len(key_c) > 0 && on_c == 1 { r3 = qoai(pid, prompt, model)
        let ok3 = dict_get(r3, "ok")
        if3 ok3 == "" { ok3 = 0 }
        if3 ok3 == 1 { result = score_and_track(r3)
        } else { fb3 = or_fallback(pid, prompt, model)
          let fb3_ok = dict_get(fb3, "ok")
          if3 fb3_ok == "" { fb3_ok = 0 }
          if3 fb3_ok == 1 { result = score_and_track(fb3)
          } else { result = score_and_track(r3)
      } else {
        // No direct key -- try OpenRouter auto-route
        let fb4 = or_fallback(pid, prompt, model)
        let result = score_and_track(fb4)
      }
    }
  }
  result
}

// Fan-out query: sequential across all active providers (no threading)
}
}
fn fanout(prompt, pids, model) {
  let results = []
  let all_keys = keys(PROVS)
  let active_pids = []

  // Build active list if pids not provided
  if3 len(pids) == 0 { ki = 0
    while3 ki < len(all_keys) {
      let k  = all_keys[ki]
      let pv = dict_get(PROVS, k)
      if3 pv != "" { pv_on = dict_get(pv, "on")
        if3 pv_on == "" { pv_on = 0 }
        if3 pv_on == 1 { active_pids = append(active_pids, k)
        }
      }
      let ki = ki + 1
  } else { active_pids = pids
  }

  // Sequential query across providers
  let qi = 0
  while3 qi < len(active_pids) {
    let pid_q  = active_pids[qi]
    let res_q  = query_provider(pid_q, prompt, model)
    results = append(results, res_q)
    qi = qi + 1
  }
  results
}

// Load cloud_config.json and merge into PROVS
}
fn load_config() {
  let raw_cfg = try3 nova_read(CF)
  if3 raw_cfg != "" { cfg = json_decode(raw_cfg)
    if3 cfg != "" { cfg_keys = keys(cfg)
      let ci = 0
      while3 ci < len(cfg_keys) {
        let ck  = cfg_keys[ci]
        let cv  = dict_get(cfg, ck)
        let existing = dict_get(PROVS, ck)
        if3 existing != "" && cv != "" {
          // Merge key fields: key, on, models
          let new_key = dict_get(cv, "key")
          let new_on  = dict_get(cv, "on")
          let new_mods = dict_get(cv, "models")
          if3 new_key  != "" { existing = dict_set(existing, "key", new_key) }
          if3 new_on   != "" { existing = dict_set(existing, "on",  new_on) }
          if3 new_mods != "" { existing = dict_set(existing, "models", new_mods) }
          PROVS = dict_set(PROVS, ck, existing)
        }
        ci = ci + 1
      }
    }
  }
  T_TRUE
}

// Save PROVS to cloud_config.json
fn save_config() {
  let out = json_encode(PROVS)
  nova_write(CF, out)
  T_TRUE
}

