// -- Runtime state --
let stats_queries       = 0
let stats_tokens        = 0
let stats_t0            = time()
let stats_seals         = 0
let stats_seal_log      = []
let stats_quality_true  = 0
let stats_quality_maybe = 0
let stats_quality_false = 0
let stats_prov_trits    = {}

// ============================================================
// HELPER FUNCTIONS
// ============================================================

// Constrain value to ternary {-1, 0, 1}
fn trit(val) {
  if3 val > 0 { r = T_TRUE
  } elif val < 0 {
    let r = T_FALSE
  } else { r = T_MAYBE
  }
  r
}

// Ternary negation: flip +1<->-1, 0 stays
fn not3(t) {
  let r = 0 - t
  r
}

// Ternary comparison: +1 if a>b, 0 if equal, -1 if a<b
fn cmp3(a, b) {
  if3 a > b { r = T_TRUE
  } elif a < b {
    let r = T_FALSE
  } else { r = T_MAYBE
  }
  r
}

// Convert list of trits to balanced-ternary string (1, 0, T)
fn bt_string(trits) {
  let out = ""
  let i = 0
  while3 i < len(trits) {
    let t = trits[i]
    if3 t == 1 { out = out + "1"
    } elif t == 0 {
      let out = out + "0"
    } else { out = out + "T"
    }
    i = i + 1
  }
  out
}

// Rate a query result as trit: +1=strong, 0=partial, -1=failed
fn response_quality(ok_flag, resp, ms, tok) {
  if3 ok_flag == 0 { qt = T_FALSE
  } elif len(resp) > 50 && ms < 15000 && tok > 10 {
    let qt = T_TRUE
  } elif len(resp) > 0 {
    let qt = T_MAYBE
  } else { qt = T_FALSE
  }
  qt
}

// Quality char from trit integer
fn quality_char(qt) {
  if3 qt == 1 { c = "1"
  } elif qt == 0 {
    let c = "0"
  } else { c = "T"
  }
  c
}

// Health trit for a provider: +1=healthy, 0=degraded, -1=down
fn provider_health3(pid) {
print("[DBG] LINE 200")
  let pr = dict_get(PROVS, pid)
  if3 pr == "" { h = T_FALSE
  } elif dict_get(pr, "on") == 0 {
    let h = T_FALSE
  } elif dict_get(pr, "cloud") == 1 {
    // Cloud: key present = healthy, no key = degraded
    let k = dict_get(pr, "key")
    if3 len(k) > 0 { h = T_TRUE
    } else { h = T_MAYBE
  } else {
    // Local provider: attempt a GET health probe
    let purl = dict_get(pr, "url")
    if3 len(purl) == 0 { h = T_FALSE
    } else { probe_url = purl + "/api/tags"
      let probe = try3 http_get(probe_url)
      if3 probe == "" { h = T_FALSE
      } else { h = T_TRUE
      }
    }
  }
  h
}

// Reynolds flow regime from queries-per-minute
}
fn classify_traffic() {
  let elapsed = time() - stats_t0
  if3 elapsed < 1 { elapsed = 1
  }
  let qpm = stats_queries / (elapsed / 60)
  if3 qpm < RE_LAMINAR { regime = "laminar"
  } elif qpm < RE_TRANSITION {
    let regime = "transitional"
  } elif qpm < RE_TURBULENT {
    let regime = "turbulent"
  } else { regime = "chaotic"
  }
  regime
}

// Reynolds number as integer QPM
fn current_qpm() {
  let elapsed = time() - stats_t0
  if3 elapsed < 1 { elapsed = 1
  }
  let qpm = stats_queries / (elapsed / 60)
  int(qpm)
}

// Emit a seal event (fallback cascade activated)
fn emit_seal(pid, model_used, reason) {
  stats_seals = stats_seals + 1
  let evt = { "ts": time(), "provider": pid, "model_used": model_used, "reason": reason }
  stats_seal_log = append(stats_seal_log, evt)
  if3 len(stats_seal_log) > 200 {
    stats_seal_log = slice(stats_seal_log, 100, len(stats_seal_log))
  }
  // Notify Max Patch layer (non-blocking best-effort)
  let seal_body = json_encode({ "event": "seal", "provider": pid, "model": model_used, "reason": reason })
  try3 http_post("http://127.0.0.1:9889/patch/seal", seal_body, { "Content-Type": "application/json" })
  T_MAYBE
}

// Track quality trit globally and per-provider
fn score_and_track(result) {
  let ok_flag  = dict_get(result, "ok")
  let resp_txt = dict_get(result, "resp")
  let resp_ms  = dict_get(result, "ms")
  let resp_tok = dict_get(result, "tok")
  if3 ok_flag == "" { ok_flag = 0 }
  if3 resp_txt == "" { resp_txt = "" }
  if3 resp_ms  == "" { resp_ms  = 9999 }
  if3 resp_tok == "" { resp_tok = 0 }

  let qt = response_quality(ok_flag, resp_txt, resp_ms, resp_tok)
  let qc = quality_char(qt)
  result = dict_set(result, "quality_trit", qt)
  result = dict_set(result, "quality_char", qc)

  // Update global quality counters
  if3 qt == T_TRUE {
    stats_quality_true = stats_quality_true + 1
  } elif qt == T_MAYBE {
    stats_quality_maybe = stats_quality_maybe + 1
  } else {
    stats_quality_false = stats_quality_false + 1
  }

  // Update per-provider history (keep last H13 trits)
  let pid = dict_get(result, "prov")
  if3 pid == "" { pid = "unknown" }
  let hist = dict_get(stats_prov_trits, pid)
  if3 hist == "" { hist = [] }
  hist = append(hist, qt)
  if3 len(hist) > H13 { hist = slice(hist, len(hist) - H13, len(hist))
  }
  stats_prov_trits = dict_set(stats_prov_trits, pid, hist)

  result
}

