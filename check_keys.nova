// check_keys.nova - Check API keys from cloud_config.json
// Replaces check_keys.py

fn3 main() {
    let content = read_file("C:/NovaX/cloud_config.json")
    let c = parse_json(content)

    let providers = ["groq", "mistral", "deepseek", "cohere", "google", "openrouter", "together", "sambanova_direct", "google_ai_studio", "cerebras_direct", "anthropic", "openai"]

    for3 p in providers {
        let info = dict_get(c, p) ?? {}
        let key = dict_get(info, "key") ?? ""
        let key_preview = "NONE"
        if3 len(key) > 5 {
            key_preview = slice(key, 0, 25) + "..."
        }
        let via = dict_get(info, "via") ?? "direct"
        let url = dict_get(info, "url") ?? "N/A"
        let url_short = url
        if3 len(url) > 50 { url_short = slice(url, 0, 50) }
        print(p + "  key=" + key_preview + "  via=" + via + "  url=" + url_short)
    }
}

main()
