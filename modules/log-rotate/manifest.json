{
  "name": "log-rotate",
  "version": "1.0.0",
  "description": "Rotates and compresses NovaX log files to prevent disk bloat",
  "author": "NovaX Core",
  "entry_point": "__init__.py",
  "drivers": ["file"],
  "permissions": ["filesystem"],
  "hooks": {
    "on_load": "setup",
    "on_unload": "teardown"
  },
  "config": {
    "log_dirs": ["C:\\NovaX\\logs", "C:\\NovaX"],
    "max_size_mb": 10,
    "max_age_days": 7,
    "extensions": [".log", ".txt"],
    "compress": true
  }
}
