{
  "name": "auto-backup",
  "version": "1.0.0",
  "description": "Backs up critical NovaX config, memory, and skills to timestamped archives",
  "author": "NovaX Core",
  "entry_point": "__init__.py",
  "drivers": ["file"],
  "permissions": ["filesystem"],
  "hooks": {
    "on_load": "setup",
    "on_unload": "teardown"
  },
  "config": {
    "backup_dir": "C:\\NovaX\\backups",
    "targets": [
      "C:\\NovaX\\memory",
      "C:\\NovaX\\config",
      "C:\\NovaX\\skills",
      "C:\\NovaX\\core\\orchestrator.py",
      "C:\\NovaX\\novalang.py",
      "C:\\NovaX\\web\\nova_desktop.html"
    ],
    "max_backups": 10
  }
}
