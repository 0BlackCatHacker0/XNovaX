{
  "name": "git-sync",
  "version": "1.0.0",
  "description": "Auto-commits and pushes NovaX changes to git on demand",
  "author": "NovaX Core",
  "entry_point": "__init__.py",
  "drivers": ["terminal"],
  "permissions": ["exec"],
  "hooks": {
    "on_load": "setup",
    "on_unload": "teardown"
  },
  "config": {
    "repo_dir": "C:\\NovaX",
    "branch": "main",
    "auto_push": false
  }
}
