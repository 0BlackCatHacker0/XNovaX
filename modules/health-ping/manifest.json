{
  "name": "health-ping",
  "version": "1.0.0",
  "description": "Periodic health check for all NovaX services — logs uptime and alerts on failures",
  "author": "NovaX Core",
  "entry_point": "__init__.py",
  "drivers": [],
  "permissions": ["network"],
  "hooks": {
    "on_load": "setup",
    "on_unload": "teardown"
  },
  "config": {
    "interval_seconds": 60,
    "services": {
      "orchestrator": "http://localhost:9999/health",
      "cloud-router": "http://localhost:9878/health",
      "vpn-core": "http://localhost:9880/n/status",
      "sentinel": "http://localhost:9883/sentinel/status",
      "hivemind": "http://localhost:9881/health",
      "nexus": "http://localhost:9882/health",
      "stt": "http://localhost:9875/health",
      "ollama": "http://localhost:11434/api/tags"
    }
  }
}
