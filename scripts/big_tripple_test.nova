// Big Tripple Test v3 — Live Fire Through Logic Engine
// Routes ALL queries through Hivemind's scatter-gather logic engine
// (/hive/query) which auto-routes to models, merges responses,
// fires Tripple ripples, and updates Go territories.
//
// Also tests Cloud Router direct for specific provider coverage
// and Microsoft Engine for system tool integration.

let BASE = "http://127.0.0.1"
let HIVEMIND = BASE + ":9881"
let CLOUD_ROUTER = BASE + ":9878"
let MS_ENGINE = BASE + ":9851"

fn3 get(url) {
  try3 {
    let resp = http_get(url)
    return3 parse_json(resp)
  } catch3 e {
    return3 {"error": "unknown error"}
  }
}

fn3 post(url, data) {
  try3 {
    let resp = http_post(url, data)
    return3 parse_json(resp)
  } catch3 e {
    return3 {"error": "unknown error"}
  }
}

// Logic Engine Tests
let LOGIC_ENGINE_TESTS = [
  {"task": "reasoning", "prompt": "A farmer has 17 sheep. All but 9 run away. How many are left? Explain.", "models": 3},
  {"task": "math",      "prompt": "Find the derivative of f(x) = 3x^2 - 7x + 2. Where is f'(x) = 0?", "models": 2},
  {"task": "code",      "prompt": "Write a Python function to check if a string is a palindrome.", "models": 2},
  {"task": "general",   "prompt": "List 5 steps to make a PB&J sandwich. Number them.", "models": 2},
  {"task": "fact",      "prompt": "Speed of light in m/s? Year the Eiffel Tower was completed?", "models": 3},
  {"task": "general",   "prompt": "Write a 4-line poem about a cyberpunk city at midnight.", "models": 2},
  {"task": "reasoning", "prompt": "Explain Heisenberg's Uncertainty Principle in 3 sentences.", "models": 2},
  {"task": "general",   "prompt": "Difference between copyright and trademark? One example each.", "models": 2},
  {"task": "code",      "prompt": "Write a Python binary search function. Include edge cases.", "models": 2},
  {"task": "math",      "prompt": "What is the integral of sin(x)dx from 0 to pi?", "models": 2},
  {"task": "reasoning", "prompt": "If 2+2=5, is that correct? Explain why not.", "models": 2},
  {"task": "general",   "prompt": "Translate 'The future belongs to those who code' to French and Spanish.", "models": 2},
  {"task": "fact",      "prompt": "FAST acronym for stroke warning signs? When to call emergency?", "models": 2}
]

let CLOUD_ROUTER_TESTS = [
  {"provider": "openai",      "model": "gpt-4o-mini",     "prompt": "What are the top 3 AI safety concerns in 2025?"},
  {"provider": "openrouter",  "model": "meta-llama/llama-3.3-70b-instruct:free", "prompt": "Explain dense retrieval vs BM25 in 3 sentences."},
  {"provider": "openrouter",  "model": "qwen/qwen3-235b-a22b-thinking-2507",     "prompt": "In chess after 1.e4 e5 2.Nf3, what is Black's best response?"},
  {"provider": "deepseek",    "model": "deepseek-chat",   "prompt": "P/E ratio vs P/B ratio: which is better for growth companies?"},
  {"provider": "openrouter",  "model": "deepseek/deepseek-chat", "prompt": "Explain MFCC feature extraction for speech recognition."},
  {"provider": "openrouter",  "model": "google/gemma-3-27b-it:free", "prompt": "How would you plan a 3-step disk cleanup workflow?"},
  {"provider": "openai",      "model": "gpt-4o-mini",     "prompt": "How to use Win32 APIs to list windows, get memory, send toast?"},
  {"provider": "openrouter",  "model": "mistralai/mistral-small-3.1-24b-instruct:free", "prompt": "Key differences: MMLU vs HumanEval vs Arena Elo benchmarks."}
]

let MS_TOOLS = ["system", "process", "theme", "clipboard", "notify"]

// Results
let logic_results = []
let cloud_results = []

fn3 run_logic_test(test, idx) {
  let t0 = time_ms()
  let resp = post(HIVEMIND + "/hive/query", test)
  let elapsed = time_ms() - t0

  let merged = dict_get(resp, "merged_response") ?? ""
  let queried = dict_get(resp, "models_queried") ?? 0
  let responded = dict_get(resp, "models_responded") ?? 0
  let trit = dict_get(resp, "trit") ?? -1
  let score = dict_get(resp, "tripple_resonance") ?? 0
  let prime = dict_get(resp, "tripple_prime") ?? 0
  let individuals = dict_get(resp, "individual_results") ?? []

  let models_used = []
  for3 i in range(0, len(individuals)) {
    let r = individuals[i]
    append(models_used, dict_get(r, "model") ?? "?")
  }

  let preview = merged
  if3 len(merged) > 120 {
    let preview = slice(merged, 0, 120) + "..."
  }

  let result = {
    "idx": idx, "task": dict_get(test, "task") ?? "", "trit": trit,
    "latency_ms": elapsed, "queried": queried, "responded": responded,
    "response_len": len(merged), "models": models_used,
    "preview": preview, "score": score, "prime": prime
  }
  append(logic_results, result)

  let icon = "?"
  if3 trit == 1 { let icon = "+" }
  else3 if3 trit == 0 { let icon = "~" }
  else3 if3 trit == -1 { let icon = "X" }

  print("  [" + icon + "] L" + str(idx + 1) + " " + str(dict_get(test, "task") ?? "") + " | " + str(elapsed) + "ms | " + str(responded) + "/" + str(queried) + " models | " + str(len(merged)) + " chars")
}

fn3 run_cloud_test(test, idx) {
  let t0 = time_ms()
  let payload = {
    "prompt": dict_get(test, "prompt") ?? "",
    "provider": dict_get(test, "provider") ?? "",
    "model": dict_get(test, "model") ?? "",
    "max_tokens": 512
  }
  let resp = post(CLOUD_ROUTER + "/query", payload)
  let elapsed = time_ms() - t0

  let ok = dict_get(resp, "ok") ?? false
  let inner = dict_get(resp, "result") ?? {}
  let text = dict_get(inner, "response") ?? ""
  let model = dict_get(resp, "model") ?? dict_get(test, "model") ?? ""
  let trit = 0
  if3 ok == true {
    if3 len(text) > 10 { let trit = 1 }
  } else3 {
    let trit = -1
  }

  // Send ripple
  post(HIVEMIND + "/hive/tripple/ripple", {
    "source": "cloud:" + str(dict_get(test, "provider") ?? ""),
    "trit": trit,
    "model": model
  })

  let preview = text
  if3 len(text) > 120 {
    let preview = slice(text, 0, 120) + "..."
  } else3 if3 len(text) == 0 {
    let preview = dict_get(resp, "error") ?? ""
    if3 len(preview) > 80 { let preview = slice(preview, 0, 80) }
  }

  let result = {
    "idx": idx, "provider": dict_get(test, "provider") ?? "", "model": model,
    "trit": trit, "latency_ms": elapsed, "response_len": len(text),
    "preview": preview
  }
  append(cloud_results, result)

  let icon = "?"
  if3 trit == 1 { let icon = "+" }
  else3 if3 trit == 0 { let icon = "~" }
  else3 if3 trit == -1 { let icon = "X" }

  print("  [" + icon + "] C" + str(idx + 1) + " " + str(dict_get(test, "provider") ?? "") + " | " + str(elapsed) + "ms | " + str(model) + " | " + str(len(text)) + " chars")
}

fn3 main() {
  print("")
  print("###########################################################################")
  print("  BIG TRIPPLE TEST v3 — LOGIC ENGINE LIVE FIRE")
  print("  Scatter-Gather + Cloud Router + Microsoft Engine")
  print("  13 Logic Engine queries + 8 Cloud Router queries + 5 System tools")
  print("###########################################################################")

  let pre = get(HIVEMIND + "/hive/tripple/status")
  let pre_score = dict_get(pre, "resonance_score") ?? 0
  let pre_ripples = dict_get(pre, "total_ripples") ?? 0
  print("")
  print("  Baseline: score=" + str(pre_score) + ", ripples=" + str(pre_ripples))

  // PHASE A: Logic Engine (Hivemind scatter-gather)
  print("")
  print("  ===========================================================================")
  print("  PHASE A: LOGIC ENGINE — Hivemind Scatter-Gather (" + str(len(LOGIC_ENGINE_TESTS)) + " queries)")
  print("  ===========================================================================")

  let t0 = time_ms()
  for3 i in range(0, len(LOGIC_ENGINE_TESTS)) {
    run_logic_test(LOGIC_ENGINE_TESTS[i], i)
    sleep_ms(250)
  }
  let logic_time = time_ms() - t0

  // PHASE B: Cloud Router Direct (provider coverage)
  print("")
  print("  ===========================================================================")
  print("  PHASE B: CLOUD ROUTER — Direct Provider Queries (" + str(len(CLOUD_ROUTER_TESTS)) + " queries)")
  print("  ===========================================================================")

  let tc = time_ms()
  for3 i in range(0, len(CLOUD_ROUTER_TESTS)) {
    run_cloud_test(CLOUD_ROUTER_TESTS[i], i)
    sleep_ms(500)
  }
  let cloud_time = time_ms() - tc

  // PHASE C: Microsoft Engine (system tools)
  print("")
  print("  ===========================================================================")
  print("  PHASE C: MICROSOFT ENGINE — Win32 System Tools (" + str(len(MS_TOOLS)) + " tools)")
  print("  ===========================================================================")

  let ms_results = {}
  for3 i in range(0, len(MS_TOOLS)) {
    let tool = MS_TOOLS[i]
    let payload = {}
    if3 tool == "system" { let payload = {"op": "info"} }
    else3 if3 tool == "process" { let payload = {"op": "list"} }
    else3 if3 tool == "theme" { let payload = {"op": "darkmode"} }
    else3 if3 tool == "clipboard" { let payload = {"op": "read"} }
    else3 if3 tool == "notify" { let payload = {"op": "toast", "title": "NovaX", "message": "Big Tripple Test running"} }

    let t0t = time_ms()
    let result = post(MS_ENGINE + "/microsoft/" + tool, payload)
    let elapsed_t = time_ms() - t0t
    let ok = true
    if3 dict_get(result, "error") ?? null != null { let ok = false }
    let ms_results = dict_set(ms_results, tool, {"ok": ok, "latency_ms": elapsed_t})

    let icon = "+"
    if3 ok == false { let icon = "X" }
    print("  [" + icon + "] " + tool + " | " + str(elapsed_t) + "ms")

    // Ripple
    let ripple_trit = 1
    if3 ok == false { let ripple_trit = -1 }
    post(HIVEMIND + "/hive/tripple/ripple", {"source": "ms:" + tool, "trit": ripple_trit})
  }

  // RESULTS SUMMARY
  let actual_total = logic_time + cloud_time

  print("")
  print("  ===========================================================================")
  print("  RESULTS SUMMARY")
  print("  ===========================================================================")

  // Logic engine stats
  let logic_ok = 0
  let logic_fail = 0
  let total_models_queried = 0
  let total_models_responded = 0
  let total_chars = 0
  for3 i in range(0, len(logic_results)) {
    let r = logic_results[i]
    if3 dict_get(r, "trit") ?? -1 >= 0 { let logic_ok = logic_ok + 1 }
    else3 { let logic_fail = logic_fail + 1 }
    let total_models_queried = total_models_queried + (dict_get(r, "queried") ?? 0)
    let total_models_responded = total_models_responded + (dict_get(r, "responded") ?? 0)
    let total_chars = total_chars + (dict_get(r, "response_len") ?? 0)
  }

  print("")
  print("  Logic Engine:")
  print("    Queries:  " + str(len(logic_results)) + "/" + str(len(LOGIC_ENGINE_TESTS)))
  print("    Success:  " + str(logic_ok) + "  |  Failed: " + str(logic_fail))
  print("    Models queried:   " + str(total_models_queried))
  print("    Models responded: " + str(total_models_responded))
  print("    Total chars:      " + str(total_chars))
  print("    Time:             " + str(logic_time) + "ms")

  // Cloud router stats
  let cloud_ok = 0
  let cloud_fail = 0
  for3 i in range(0, len(cloud_results)) {
    let r = cloud_results[i]
    if3 dict_get(r, "trit") ?? -1 >= 0 { let cloud_ok = cloud_ok + 1 }
    else3 { let cloud_fail = cloud_fail + 1 }
  }

  print("")
  print("  Cloud Router:")
  print("    Queries:   " + str(len(cloud_results)) + "/" + str(len(CLOUD_ROUTER_TESTS)))
  print("    Success:   " + str(cloud_ok) + "  |  Failed: " + str(cloud_fail))
  print("    Time:      " + str(cloud_time) + "ms")

  // MS engine stats
  let ms_ok = 0
  let ms_keys = dict_keys(ms_results)
  for3 i in range(0, len(ms_keys)) {
    let v = dict_get(ms_results, ms_keys[i]) ?? {}
    if3 dict_get(v, "ok") ?? false == true { let ms_ok = ms_ok + 1 }
  }
  print("")
  print("  Microsoft Engine:")
  print("    Tools:   " + str(ms_ok) + "/" + str(len(MS_TOOLS)) + " ok")

  // Tripple Resonance Delta
  print("")
  print("  ===========================================================================")
  print("  TRIPPLE RESONANCE")
  print("  ===========================================================================")

  let post_state = get(HIVEMIND + "/hive/tripple/status")
  let post_score = dict_get(post_state, "resonance_score") ?? 0
  let post_ripples = dict_get(post_state, "total_ripples") ?? 0
  let delta_score = post_score - pre_score
  let delta_ripples = post_ripples - pre_ripples

  print("  Before:  score=" + str(pre_score) + "  ripples=" + str(pre_ripples))
  print("  After:   score=" + str(post_score) + "  ripples=" + str(post_ripples))
  print("  Delta:   score=" + str(delta_score) + "  ripples=+" + str(delta_ripples))
  print("  PRIME:   PERMANENT")
  print("  HYPER:   PERMANENT")

  // Final
  let total_success = logic_ok + cloud_ok + ms_ok
  let total_tests = len(LOGIC_ENGINE_TESTS) + len(CLOUD_ROUTER_TESTS) + len(MS_TOOLS)

  print("")
  print("###########################################################################")
  print("  BIG TRIPPLE TEST v3 — COMPLETE")
  print("###########################################################################")
  print("  Total time:   " + str(actual_total) + "ms")
  print("  Total tests:  " + str(total_success) + "/" + str(total_tests) + " passed")
  print("  Logic Engine: " + str(logic_ok) + "/" + str(len(LOGIC_ENGINE_TESTS)))
  print("  Cloud Router: " + str(cloud_ok) + "/" + str(len(CLOUD_ROUTER_TESTS)))
  print("  MS Engine:    " + str(ms_ok) + "/" + str(len(MS_TOOLS)) + " tools")
  print("  Ripple delta: +" + str(delta_ripples))
  print("  Score:        " + str(post_score))
  print("  PRIME:        PERMANENT")
  print("  HYPER:        PERMANENT")
  print("###########################################################################")

  // Save report
  let report = {
    "test": "BigTripple_v3",
    "elapsed_ms": actual_total,
    "logic_engine": {"total": len(logic_results), "ok": logic_ok, "fail": logic_fail,
                     "models_queried": total_models_queried, "models_responded": total_models_responded},
    "cloud_router": {"total": len(cloud_results), "ok": cloud_ok, "fail": cloud_fail},
    "microsoft_engine": ms_results,
    "resonance": {"pre": pre_score, "post": post_score, "delta": delta_score,
                  "ripples_before": pre_ripples, "ripples_after": post_ripples}
  }
  write_file("C:/NovaX/tmp/big_tripple_report.json", to_json(report))
  print("")
  print("  Report: C:/NovaX/tmp/big_tripple_report.json")
}

main()
