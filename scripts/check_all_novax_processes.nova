// Find all NovaX-related Python processes and their resource usage.

fn3 main() {
  let r = shell("powershell -NoProfile -Command \"Get-CimInstance Win32_Process -Filter \\\"Name='python.exe' or Name='pythonw.exe'\\\" | Select ProcessId,CommandLine,WorkingSet64 | ConvertTo-Json\"")

  if3 len(trim(r)) == 0 {
    print("No Python processes found")
    return3 null
  }

  let data = parse_json(r)
  // Handle single object vs array
  if3 type_of(data) != "array" {
    let data = [data]
  }

  let total_ram = 0
  let nova_count = 0

  for3 i in range(0, len(data)) {
    let p = data[i]
    let cmd = dict_get(p, "CommandLine") ?? ""
    let ws = dict_get(p, "WorkingSet64") ?? 0
    let ram = int(ws / 1024 / 1024)
    let pid = dict_get(p, "ProcessId") ?? "?"
    let total_ram = total_ram + ram

    if3 contains(lower(cmd), "nova") {
      let nova_count = nova_count + 1
      // Extract script name
      let parts = split(cmd, " ")
      let script = parts[len(parts) - 1]
      // Get just filename
      let bslash_parts = split(script, "\\")
      let script = bslash_parts[len(bslash_parts) - 1]
      let fslash_parts = split(script, "/")
      let script = fslash_parts[len(fslash_parts) - 1]
      print("PID=" + str(pid) + " RAM=" + str(ram) + "MB  " + script)
    }
  }

  print("--- NovaX Python processes: " + str(nova_count) + ", Total RAM: " + str(total_ram) + "MB")
  print("--- All Python processes: " + str(len(data)))
}

main()
