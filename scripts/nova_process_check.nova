// nova_process_check.nova — Find all NovaX-related Python processes
// Shows PID, RAM usage, and script name
// NovaLang conversion of check_all_novax_processes.py

print("=== NovaX Process Check ===")
print("")

// Get all Python processes with RAM info
let cmd = "powershell -NoProfile -Command \"Get-CimInstance Win32_Process -Filter \\\"Name='python.exe' or Name='pythonw.exe'\\\" | Select ProcessId,CommandLine,WorkingSet64 | ConvertTo-Json\""
let raw = shell(cmd)
let trimmed = trim(raw)

if3 cmp3(len(trimmed), 0) {
  print("No Python processes found")
} maybe {
  print("No Python processes found")
} else {
}

let data = json_decode(trimmed)
// json_decode may return a single dict or array
let procs = data

let total_ram = 0
let nova_count = 0
let all_count = len(procs)
let i = 0

fn extract_last_part(cmdline) {
  let parts = split(cmdline, " ")
  let plen = len(parts)
  if3 cmp3(plen, 0) {
    let last = parts[plen - 1]
    let segs = split(last, "\\")
    let slen = len(segs)
    return segs[slen - 1]
  } maybe {
    return "?"
  } else {
    return "?"
  }
}

while3 i < all_count {
  let p = procs[i]
  let cmd = dict_get(p, "CommandLine") ?? ""
  let ws = dict_get(p, "WorkingSet64") ?? 0
  let pid = dict_get(p, "ProcessId") ?? 0
  let ram = floor(ws / 1048576)
  let total_ram = total_ram + ram
  // Check if NovaX-related
  let has_nova = contains(cmd, "nova")
  let has_NovaX = contains(cmd, "NovaX")
  if3 has_nova {
    let nova_count = nova_count + 1
    let script = extract_last_part(cmd)
    print("PID=" + str(pid) + " RAM=" + str(ram) + "MB  " + script)
  } maybe {
    if3 has_NovaX {
      let nova_count = nova_count + 1
      let script = extract_last_part(cmd)
      print("PID=" + str(pid) + " RAM=" + str(ram) + "MB  " + script)
    } maybe {
    } else {
    }
  } else {
    if3 has_NovaX {
      let nova_count = nova_count + 1
      let script = extract_last_part(cmd)
      print("PID=" + str(pid) + " RAM=" + str(ram) + "MB  " + script)
    } maybe {
    } else {
    }
  }
  let i = i + 1
}

print("--- NovaX Python processes: " + str(nova_count) + ", Total RAM: " + str(total_ram) + "MB")
print("--- All Python processes: " + str(all_count))
print("")
print("=== Process Check Complete ===")
