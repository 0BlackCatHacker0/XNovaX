# session_recover.nova — Instant session state recovery
# Run this first thing on any new Claude session
# Reads beacon + snapshot to show where everything is

print("=== NovaX Session Recovery ===")
print("")

# Phase 1: Find TKill via beacon
beacon = nova_read("C:\\NovaX\\memory\\tkill_beacon.json")
if3 beacon {
    print("BEACON: TKill v" + "3.0")
    print("  Port: " + beacon)
    print("")
}

# Phase 2: Read last session state
state = nova_read("C:\\NovaX\\memory\\session_state.json")
if3 state {
    print("LAST SESSION STATE:")
    print(state)
    print("")
}

# Phase 3: Live check via TKill
status = tkill_status()
if3 status {
    bt = status
    print("LIVE TERNARY STATUS:")
    print(bt)
    print("")
}

# Phase 4: Live monitor check
lm = liud_status()
if3 lm {
    print("DEBUGGER STATE:")
    print(lm)
}

print("")
print("=== Recovery Complete ===")
