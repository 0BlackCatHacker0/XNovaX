// NovaX Script Vault — sysadmin/env_dump.nova
// Description: Dumps all environment variables, sorted alphabetically
// Category: sysadmin | Trit: +1=success, 0=partial, -1=fail

print("═══ ENVIRONMENT VARIABLES DUMP ═══")
print("")

let r = shell("powershell -NoProfile -Command \"[Environment]::GetEnvironmentVariables() | ForEach-Object { $_.GetEnumerator() } | Sort-Object Name | ForEach-Object { $_.Name + '=' + $_.Value }\"")

if3 dict_get(r, "ok") ?? 0 == 1
  let out = trim(dict_get(r, "stdout") ?? "")
  let lines = split(out, "\n")

  let count = 0
  let sensitive_keys = ["KEY", "SECRET", "TOKEN", "PASSWORD", "PASS", "CREDENTIAL"]
  let redacted = 0

  for3 line in lines
    let line = trim(line)
    if3 len(line) > 0
      let count = count + 1

      // Check for sensitive vars and redact values
      let is_sensitive = 0
      let upper_line = upper(line)
      for3 sk in sensitive_keys
        if3 contains(upper_line, sk)
          let is_sensitive = 1
        end3
      end3

      if3 is_sensitive == 1
        // Only show var name, redact value
        let eq_parts = split(line, "=")
        let var_name = dict_get(eq_parts, 0) ?? "?"
        print("  " + var_name + "=****REDACTED****")
        let redacted = redacted + 1
      else3
        // Truncate very long values
        if3 len(line) > 120
          let line = slice(line, 0, 117) + "..."
        end3
        print("  " + line)
      end3
    end3
  end3

  print("")
  print("Total variables: " + str(count))
  if3 redacted > 0
    print("Redacted (sensitive): " + str(redacted))
  end3
  print("")
  print("═══ RESULT: +1 (success) ═══")
else3
  print("ERROR: Could not retrieve environment variables")
  print(dict_get(r, "stderr") ?? "")
  print("")
  print("═══ RESULT: -1 (fail) ═══")
end3
