// NovaX Script Vault — sysadmin/orphan_finder.nova
// Description: Finds zombie/orphan processes (no parent or parent exited)
// Category: sysadmin | Trit: +1=success, 0=partial, -1=fail

print("═══ ORPHAN / ZOMBIE PROCESS FINDER ═══")
print("")

// Find processes whose parent PID no longer exists
let r = shell("powershell -NoProfile -Command \"$allPids = (Get-Process).Id; Get-CimInstance Win32_Process | ForEach-Object { $ppid = $_.ParentProcessId; if ($ppid -ne 0 -and $ppid -notin $allPids) { $mem = [math]::Round($_.WorkingSetSize / 1MB, 1); $_.ProcessId.ToString() + '|' + $_.Name + '|' + $ppid.ToString() + '|' + $mem.ToString() + '|' + $_.CommandLine } }\"")

if3 dict_get(r, "ok") ?? 0 == 1
  let out = trim(dict_get(r, "stdout") ?? "")

  if3 len(out) == 0
    print("No orphan processes found. System is clean.")
    print("")
    print("═══ RESULT: +1 (success) ═══")
  else3
    let lines = split(out, "\n")

    print("PID      Name                  Dead Parent  RAM(MB)  Command")
    print("-------  --------------------  -----------  -------  -------")

    let count = 0

    for3 line in lines
      let line = trim(line)
      if3 len(line) > 0
        let parts = split(line, "|")
        if3 len(parts) >= 4
          let pid = dict_get(parts, 0) ?? "?"
          let name = dict_get(parts, 1) ?? "?"
          let ppid = dict_get(parts, 2) ?? "?"
          let mem = dict_get(parts, 3) ?? "0"
          let cmd = dict_get(parts, 4) ?? ""
          let count = count + 1

          // Truncate long command lines
          if3 len(cmd) > 60
            let cmd = slice(cmd, 0, 57) + "..."
          end3

          print(pid + "    " + name + "    " + ppid + "      " + mem + "    " + cmd)
        end3
      end3
    end3

    print("")
    print("Found " + str(count) + " orphan process(es).")
    print("TIP: Review these — some are normal (e.g. svchost children) but others may be zombies.")
    print("")

    if3 count > 10
      print("═══ RESULT: 0 (partial — many orphans detected) ═══")
    else3
      print("═══ RESULT: +1 (success) ═══")
    end3
  end3
else3
  print("ERROR: Could not scan for orphan processes")
  print(dict_get(r, "stderr") ?? "")
  print("")
  print("═══ RESULT: -1 (fail) ═══")
end3
