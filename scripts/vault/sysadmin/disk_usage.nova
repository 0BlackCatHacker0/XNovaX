// NovaX Script Vault — sysadmin/disk_usage.nova
// Description: Shows disk space for all drives with % used, warns if >85%
// Category: sysadmin | Trit: +1=success, 0=partial, -1=fail

let warnings = []
let warn_threshold = 85

print("═══ DISK USAGE REPORT ═══")
print("")

let r = shell("powershell -NoProfile -Command \"Get-PSDrive -PSProvider FileSystem | Where-Object { $_.Used -ne $null -and $_.Free -ne $null } | ForEach-Object { $total = $_.Used + $_.Free; $pct = [math]::Round(($_.Used / $total) * 100, 1); $usedGB = [math]::Round($_.Used / 1GB, 2); $freeGB = [math]::Round($_.Free / 1GB, 2); $totalGB = [math]::Round($total / 1GB, 2); $_.Name + '|' + $usedGB.ToString() + '|' + $freeGB.ToString() + '|' + $totalGB.ToString() + '|' + $pct.ToString() }\"")

if3 dict_get(r, "ok") ?? 0 == 1
  let out = trim(dict_get(r, "stdout") ?? "")
  let lines = split(out, "\n")

  // Header
  print("Drive  Used(GB)   Free(GB)   Total(GB)  %Used  Status")
  print("-----  --------   --------   ---------  -----  ------")

  for3 line in lines
    let line = trim(line)
    if3 len(line) > 0
      let parts = split(line, "|")
      if3 len(parts) >= 5
        let drive = dict_get(parts, 0) ?? "?"
        let used = dict_get(parts, 1) ?? "0"
        let free = dict_get(parts, 2) ?? "0"
        let total = dict_get(parts, 3) ?? "0"
        let pct = dict_get(parts, 4) ?? "0"

        let status = "OK"
        let pct_num = to_number(pct)
        if3 pct_num > warn_threshold
          let status = "WARNING"
          let warnings = append(warnings, drive + ": at " + pct + "%")
        end3

        print(drive + ":     " + used + "      " + free + "      " + total + "     " + pct + "%   " + status)
      end3
    end3
  end3

  print("")

  if3 len(warnings) > 0
    print("*** WARNINGS (>" + str(warn_threshold) + "% used) ***")
    for3 w in warnings
      print("  ! " + w)
    end3
    print("")
    print("═══ RESULT: 0 (partial — disk space warnings) ═══")
  else3
    print("All drives within normal usage.")
    print("")
    print("═══ RESULT: +1 (success) ═══")
  end3
else3
  print("ERROR: Could not retrieve disk information")
  print(dict_get(r, "stderr") ?? "")
  print("")
  print("═══ RESULT: -1 (fail) ═══")
end3
