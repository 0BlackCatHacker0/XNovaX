// NovaX Script Vault — sysadmin/cpu_monitor.nova
// Description: Reports CPU usage over 5 samples (1s apart)
// Category: sysadmin | Trit: +1=success, 0=partial, -1=fail

print("═══ CPU USAGE MONITOR (5 samples) ═══")
print("")

// Collect 5 CPU samples 1 second apart via a single PowerShell call
let r = shell("powershell -NoProfile -Command \"$samples = @(); for ($i = 0; $i -lt 5; $i++) { $cpu = (Get-CimInstance Win32_Processor | Measure-Object -Property LoadPercentage -Average).Average; $samples += $cpu; if ($i -lt 4) { Start-Sleep -Seconds 1 } }; $samples -join '|'\"")

if3 dict_get(r, "ok") ?? 0 == 1
  let out = trim(dict_get(r, "stdout") ?? "")
  let samples = split(out, "|")

  print("Sample  CPU%   Bar")
  print("------  -----  " + "--------------------")

  let total = 0
  let max_cpu = 0
  let min_cpu = 100
  let idx = 0

  for3 s in samples
    let idx = idx + 1
    let val = to_number(trim(s))
    let total = total + val

    if3 val > max_cpu
      let max_cpu = val
    end3
    if3 val < min_cpu
      let min_cpu = val
    end3

    // Build a simple bar (each block = 5%)
    let bar = ""
    let blocks = round(val / 5, 0)
    let b = 0
    while3 b < blocks
      let bar = bar + "#"
      let b = b + 1
    end3

    print("  " + str(idx) + "     " + str(val) + "%   [" + bar + "]")
  end3

  let avg = round(total / len(samples), 1)

  print("")
  print("Average: " + str(avg) + "%")
  print("Min:     " + str(min_cpu) + "%")
  print("Max:     " + str(max_cpu) + "%")
  print("")

  if3 avg > 90
    print("STATUS: CRITICAL — CPU is heavily loaded")
    print("═══ RESULT: 0 (partial — high CPU) ═══")
  else3
    if3 avg > 70
      print("STATUS: ELEVATED — CPU usage is above normal")
      print("═══ RESULT: 0 (partial — elevated CPU) ═══")
    else3
      print("STATUS: NORMAL")
      print("═══ RESULT: +1 (success) ═══")
    end3
  end3
else3
  print("ERROR: Could not sample CPU usage")
  print(dict_get(r, "stderr") ?? "")
  print("")
  print("═══ RESULT: -1 (fail) ═══")
end3
