// NovaX Script Vault — sysadmin/uptime_check.nova
// Description: Shows system uptime info using native builtins
// Category: sysadmin | Trit: +1=success, 0=partial, -1=fail
// ZERO shell() calls — uses system_info() builtin

print("═══ SYSTEM UPTIME CHECK ═══")
print("")

let info = system_info()

if3 len(dict_keys(info)) > 0
  let hostname = dict_get(info, "hostname") ?? "unknown"
  let os_name = dict_get(info, "os") ?? "unknown"
  let boot_time = dict_get(info, "boot_time") ?? ""
  let uptime_sec = dict_get(info, "uptime_seconds") ?? 0

  if3 len(str(boot_time)) > 0
    print("Boot Time:    " + str(boot_time))
  end3

  if3 uptime_sec > 0
    let days = uptime_sec / 86400
    let remainder = uptime_sec - (days * 86400)
    let hours = remainder / 3600
    let remainder = remainder - (hours * 3600)
    let mins = remainder / 60
    let secs = remainder - (mins * 60)
    let total_hours = uptime_sec / 3600

    print("Uptime:       " + str(days) + " days, " + str(hours) + " hours, " + str(mins) + " minutes, " + str(secs) + " seconds")
    print("Total Hours:  " + str(total_hours) + " hrs")
    print("Host:         " + hostname)
    print("OS:           " + os_name)
    print("")

    if3 days > 30
      print("NOTE: System has been up for over 30 days.")
      print("      Consider a reboot for pending Windows updates.")
      print("")
      print("═══ RESULT: 0 (partial — long uptime, reboot recommended) ═══")
    else3
      if3 days > 14
        print("NOTE: System has been running for " + str(days) + " days.")
        print("      A reboot may help apply updates.")
        print("")
        print("═══ RESULT: +1 (success) ═══")
      else3
        print("System uptime is healthy.")
        print("")
        print("═══ RESULT: +1 (success) ═══")
      end3
    end3
  else3
    print("Host:         " + hostname)
    print("OS:           " + os_name)
    print("Uptime:       (not available from system_info)")
    print("")
    print("═══ RESULT: 0 (partial — uptime seconds not reported) ═══")
  end3
else3
  print("ERROR: Could not retrieve system info")
  print("")
  print("═══ RESULT: -1 (fail) ═══")
end3
