// NovaX Script Vault — sysadmin/ram_monitor.nova
// Description: Reports RAM usage: total, used, free, percentage
// Category: sysadmin | Trit: +1=success, 0=partial, -1=fail

print("═══ RAM USAGE REPORT ═══")
print("")

let r = shell("powershell -NoProfile -Command \"$os = Get-CimInstance Win32_OperatingSystem; $totalGB = [math]::Round($os.TotalVisibleMemorySize / 1MB, 2); $freeGB = [math]::Round($os.FreePhysicalMemory / 1MB, 2); $usedGB = [math]::Round($totalGB - $freeGB, 2); $pct = [math]::Round(($usedGB / $totalGB) * 100, 1); $totalGB.ToString() + '|' + $usedGB.ToString() + '|' + $freeGB.ToString() + '|' + $pct.ToString()\"")

if3 dict_get(r, "ok") ?? 0 == 1
  let out = trim(dict_get(r, "stdout") ?? "")
  let parts = split(out, "|")

  if3 len(parts) >= 4
    let total = dict_get(parts, 0) ?? "0"
    let used = dict_get(parts, 1) ?? "0"
    let free = dict_get(parts, 2) ?? "0"
    let pct = dict_get(parts, 3) ?? "0"
    let pct_num = to_number(pct)

    print("Total RAM:  " + total + " GB")
    print("Used:       " + used + " GB")
    print("Free:       " + free + " GB")
    print("Usage:      " + pct + "%")
    print("")

    // Visual bar (50 chars wide)
    let filled = round(pct_num / 2, 0)
    let empty = 50 - filled
    let bar = ""
    let i = 0
    while3 i < filled
      let bar = bar + "#"
      let i = i + 1
    end3
    while3 i < 50
      let bar = bar + "-"
      let i = i + 1
    end3
    print("[" + bar + "] " + pct + "%")
    print("")

    // Top 5 memory consumers
    print("--- Top 5 Memory Consumers ---")
    let r2 = shell("powershell -NoProfile -Command \"Get-Process | Sort-Object WorkingSet64 -Descending | Select-Object -First 5 | ForEach-Object { $mb = [math]::Round($_.WorkingSet64 / 1MB, 1); $_.ProcessName + ': ' + $mb.ToString() + ' MB' }\"")
    if3 dict_get(r2, "ok") ?? 0 == 1
      let procs = trim(dict_get(r2, "stdout") ?? "")
      let plines = split(procs, "\n")
      for3 p in plines
        let p = trim(p)
        if3 len(p) > 0
          print("  " + p)
        end3
      end3
    end3

    print("")

    if3 pct_num > 90
      print("STATUS: CRITICAL — RAM nearly exhausted!")
      print("═══ RESULT: 0 (partial — critical RAM usage) ═══")
    else3
      if3 pct_num > 80
        print("STATUS: HIGH — Consider closing some applications")
        print("═══ RESULT: 0 (partial — high RAM usage) ═══")
      else3
        print("STATUS: NORMAL")
        print("═══ RESULT: +1 (success) ═══")
      end3
    end3
  else3
    print("ERROR: Unexpected output format")
    print("═══ RESULT: -1 (fail) ═══")
  end3
else3
  print("ERROR: Could not retrieve RAM info")
  print(dict_get(r, "stderr") ?? "")
  print("")
  print("═══ RESULT: -1 (fail) ═══")
end3
