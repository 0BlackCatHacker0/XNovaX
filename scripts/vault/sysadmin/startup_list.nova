// NovaX Script Vault — sysadmin/startup_list.nova
// Description: Lists Windows startup programs from registry Run keys and startup folder
// Category: sysadmin | Trit: +1=success, 0=partial, -1=fail
// ZERO shell() calls — uses reg_query(), list_dir(), is_dir()

print("═══ WINDOWS STARTUP PROGRAMS ═══")
print("")

let total = 0
let errors = 0

// Registry: HKLM Run
print("--- Registry: HKLM\\...\\Run ---")
let hklm = reg_query("HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run")
if3 len(dict_keys(hklm)) > 0
  let keys = dict_keys(hklm)
  for3 name in keys
    let cmd = str(dict_get(hklm, name) ?? "?")
    if3 len(cmd) > 80
      let cmd = slice(cmd, 0, 77) + "..."
    end3
    print("  " + name + " -> " + cmd)
    let total = total + 1
  end3
else3
  print("  (none found)")
end3

print("")

// Registry: HKCU Run
print("--- Registry: HKCU\\...\\Run ---")
let hkcu = reg_query("HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run")
if3 len(dict_keys(hkcu)) > 0
  let keys = dict_keys(hkcu)
  for3 name in keys
    let cmd = str(dict_get(hkcu, name) ?? "?")
    if3 len(cmd) > 80
      let cmd = slice(cmd, 0, 77) + "..."
    end3
    print("  " + name + " -> " + cmd)
    let total = total + 1
  end3
else3
  print("  (none found)")
end3

print("")

// Startup folder
print("--- Startup Folder ---")
let startup_path = "C:\\Users\\" + dict_get(system_info(), "username") ?? "Default" + "\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\Startup"
if3 is_dir(startup_path)
  let items = list_dir(startup_path)
  if3 len(items) > 0
    for3 item in items
      let full = startup_path + "\\" + item
      print("  " + item + " -> " + full)
      let total = total + 1
    end3
  else3
    print("  (none found)")
  end3
else3
  print("  (folder not accessible)")
end3

print("")
print("Total startup entries: " + str(total))
print("")

if3 errors == 0
  print("═══ RESULT: +1 (success) ═══")
else3
  if3 errors < 3
    print("═══ RESULT: 0 (partial — " + str(errors) + " source(s) failed) ═══")
  else3
    print("═══ RESULT: -1 (fail) ═══")
  end3
end3
