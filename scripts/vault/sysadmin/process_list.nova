// NovaX Script Vault — sysadmin/process_list.nova
// Description: Lists top 20 processes by memory usage
// Category: sysadmin | Trit: +1=success, 0=partial, -1=fail

print("═══ TOP 20 PROCESSES BY MEMORY ═══")
print("")

let r = shell("powershell -NoProfile -Command \"Get-Process | Sort-Object WorkingSet64 -Descending | Select-Object -First 20 | ForEach-Object { $mem = [math]::Round($_.WorkingSet64 / 1MB, 1); $cpu = [math]::Round($_.CPU, 1); $_.Id.ToString() + '|' + $_.ProcessName + '|' + $mem.ToString() + '|' + $cpu.ToString() }\"")

if3 dict_get(r, "ok") ?? 0 == 1
  let out = trim(dict_get(r, "stdout") ?? "")
  let lines = split(out, "\n")

  print("Rank  PID      Name                     RAM(MB)    CPU(s)")
  print("----  -------  -----------------------  ---------  ------")

  let rank = 0
  let total_mb = 0

  for3 line in lines
    let line = trim(line)
    if3 len(line) > 0
      let parts = split(line, "|")
      if3 len(parts) >= 4
        let rank = rank + 1
        let pid = dict_get(parts, 0) ?? "?"
        let name = dict_get(parts, 1) ?? "?"
        let mem = dict_get(parts, 2) ?? "0"
        let cpu = dict_get(parts, 3) ?? "0"
        let total_mb = total_mb + to_number(mem)

        let rank_str = str(rank)
        if3 rank < 10
          let rank_str = " " + rank_str
        end3

        print(rank_str + ".   " + pid + "    " + name + "    " + mem + " MB    " + cpu + "s")
      end3
    end3
  end3

  print("")
  print("Total memory (top 20): " + str(round(total_mb, 1)) + " MB")
  print("")
  print("═══ RESULT: +1 (success) ═══")
else3
  print("ERROR: Could not retrieve process list")
  print(dict_get(r, "stderr") ?? "")
  print("")
  print("═══ RESULT: -1 (fail) ═══")
end3
