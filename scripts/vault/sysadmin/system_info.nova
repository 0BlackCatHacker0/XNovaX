// NovaX Script Vault — sysadmin/system_info.nova
// Description: Collects hostname, OS, CPU, RAM, disk, processes into a report
// Category: sysadmin | Trit: +1=success, 0=partial, -1=fail
// ZERO shell() calls — uses system_info(), sys_memory(), sys_disk(), process_list()

let errors = 0

print("═══ SYSTEM INFORMATION REPORT ═══")
print("")

// System info (hostname, OS, CPU, uptime)
let info = system_info()
if3 len(dict_keys(info)) > 0
  print("Hostname:  " + dict_get(info, "hostname") ?? "[unknown]")
  print("OS:        " + dict_get(info, "os") ?? "[unknown]")
  print("CPU:       " + dict_get(info, "cpu") ?? "[unknown]")
  print("Cores:     " + str(dict_get(info, "cpu_cores") ?? "[unknown]"))

  let uptime_sec = dict_get(info, "uptime_seconds") ?? 0
  if3 uptime_sec > 0
    let days = uptime_sec / 86400
    let remainder = uptime_sec - (days * 86400)
    let hours = remainder / 3600
    let mins = (remainder - (hours * 3600)) / 60
    print("Uptime:    " + str(days) + "d " + str(hours) + "h " + str(mins) + "m")
  else3
    print("Uptime:    " + dict_get(info, "boot_time") ?? "[unknown]")
  end3
else3
  print("Hostname:  [ERROR]")
  print("OS:        [ERROR]")
  print("CPU:       [ERROR]")
  print("Uptime:    [ERROR]")
  let errors = errors + 4
end3

// Memory info
let mem = sys_memory()
if3 len(dict_keys(mem)) > 0
  let total = dict_get(mem, "total") ?? 0
  let avail = dict_get(mem, "available") ?? 0
  let pct = dict_get(mem, "percent_used") ?? 0
  print("RAM Total: " + str(total) + " bytes")
  print("RAM Avail: " + str(avail) + " bytes")
  print("RAM Used:  " + str(pct) + "%")
else3
  print("RAM:       [ERROR]")
  let errors = errors + 1
end3

// Disk info
let disk = sys_disk()
if3 len(dict_keys(disk)) > 0
  let dk = dict_keys(disk)
  for3 drive in dk
    let d = dict_get(disk, drive) ?? {}
    let dtotal = dict_get(d, "total") ?? 0
    let dfree = dict_get(d, "free") ?? 0
    let dpct = dict_get(d, "percent_used") ?? 0
    print("Disk " + drive + ":  total=" + str(dtotal) + " free=" + str(dfree) + " used=" + str(dpct) + "%")
  end3
else3
  print("Disk:      [ERROR]")
  let errors = errors + 1
end3

// Process count
let procs = process_list()
print("Processes: " + str(len(procs)) + " running")

print("")
if3 errors == 0
  print("═══ RESULT: +1 (success) ═══")
else3
  if3 errors < 5
    print("═══ RESULT: 0 (partial — " + str(errors) + " errors) ═══")
  else3
    print("═══ RESULT: -1 (fail) ═══")
  end3
end3
