// NovaX Script Vault — sysadmin/service_list.nova
// Description: Lists all running Windows services
// Category: sysadmin | Trit: +1=success, 0=partial, -1=fail

print("═══ RUNNING WINDOWS SERVICES ═══")
print("")

let r = shell("powershell -NoProfile -Command \"Get-Service | Where-Object { $_.Status -eq 'Running' } | Sort-Object DisplayName | ForEach-Object { $_.Name + '|' + $_.DisplayName + '|' + $_.StartType.ToString() }\"")

if3 dict_get(r, "ok") ?? 0 == 1
  let out = trim(dict_get(r, "stdout") ?? "")
  let lines = split(out, "\n")

  print("Name                          Display Name                           StartType")
  print("----------------------------  -------------------------------------  ---------")

  let count = 0

  for3 line in lines
    let line = trim(line)
    if3 len(line) > 0
      let parts = split(line, "|")
      if3 len(parts) >= 3
        let svc_name = dict_get(parts, 0) ?? "?"
        let display = dict_get(parts, 1) ?? "?"
        let start = dict_get(parts, 2) ?? "?"
        let count = count + 1

        print(svc_name + "  |  " + display + "  |  " + start)
      end3
    end3
  end3

  print("")
  print("Total running services: " + str(count))
  print("")
  print("═══ RESULT: +1 (success) ═══")
else3
  print("ERROR: Could not retrieve service list")
  print(dict_get(r, "stderr") ?? "")
  print("")
  print("═══ RESULT: -1 (fail) ═══")
end3
