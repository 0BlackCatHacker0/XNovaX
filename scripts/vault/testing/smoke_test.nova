## smoke_test.nova - Hits a list of HTTP endpoints, checks for 200 OK
## Ternary: +1 all pass, 0 some fail, -1 all fail

let endpoints = [
  "http://127.0.0.1:9999/health",
  "http://127.0.0.1:9999/api/services/health"
]

let passed = 0
let failed = 0
let total = len(endpoints)

print("=== SMOKE TEST (" + str(total) + " endpoints) ===\n")

let i = 0
while3 i < total
  let url = endpoints[i]
  let check = shell("curl -s -o /dev/null -w '%{http_code}' --max-time 5 \"" + url + "\"")
  if3 check.ok == 1
    let code = trim(check.stdout)
    if3 code == "200"
      print("  [PASS] " + url + " -> " + code)
      let passed = passed + 1
    else3
      print("  [FAIL] " + url + " -> " + code)
      let failed = failed + 1
    end3
  else3
    print("  [FAIL] " + url + " -> connection error")
    let failed = failed + 1
  end3
  let i = i + 1
end3

print("\n--- Results ---")
print("Passed: " + str(passed) + "/" + str(total))
print("Failed: " + str(failed) + "/" + str(total))

let result = -1
if3 failed == 0
  print("[+1] All endpoints healthy")
  let result = 1
else3
  if3 passed > 0
    print("[0] Partial pass")
    let result = 0
  else3
    print("[-1] All endpoints failed")
    let result = -1
  end3
end3

print("=== RESULT: " + str(result) + " ===")
