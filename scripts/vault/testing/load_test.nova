## load_test.nova - Sends N sequential requests to a URL, reports avg/min/max time
## Ternary: +1 all succeeded, 0 some failed, -1 all failed

let target_url = "http://127.0.0.1:9999/health"
let num_requests = 20
let result = -1

let times = []
let successes = 0
let failures = 0

print("=== LOAD TEST ===")
print("Target: " + target_url)
print("Requests: " + str(num_requests) + "\n")

let i = 0
while3 i < num_requests
  let t_start = time()
  let req = shell("curl -s -o /dev/null -w '%{http_code}' --max-time 10 \"" + target_url + "\"")
  let t_end = time()
  let elapsed = t_end - t_start

  if3 req.ok == 1
    let code = trim(req.stdout)
    if3 code == "200"
      let successes = successes + 1
      let times = append(times, elapsed)
    else3
      let failures = failures + 1
      print("  [FAIL] Request " + str(i + 1) + " -> " + code)
    end3
  else3
    let failures = failures + 1
    print("  [FAIL] Request " + str(i + 1) + " -> timeout/error")
  end3
  let i = i + 1
end3

print("\n--- Results ---")
print("Successes: " + str(successes) + "/" + str(num_requests))
print("Failures: " + str(failures) + "/" + str(num_requests))

if3 len(times) > 0
  ## Calculate min/max/avg
  let min_t = times[0]
  let max_t = times[0]
  let sum_t = 0.0
  let j = 0
  while3 j < len(times)
    let t = times[j]
    let sum_t = sum_t + t
    if3 t < min_t
      let min_t = t
    end3
    if3 t > max_t
      let max_t = t
    end3
    let j = j + 1
  end3
  let avg_t = sum_t / len(times)

  print("\nTiming (seconds):")
  print("  Min: " + str(min_t))
  print("  Max: " + str(max_t))
  print("  Avg: " + str(avg_t))
end3

if3 failures == 0
  print("\n[+1] All requests succeeded")
  let result = 1
else3
  if3 successes > 0
    print("\n[0] Partial success")
    let result = 0
  else3
    print("\n[-1] All requests failed")
    let result = -1
  end3
end3

print("=== RESULT: " + str(result) + " ===")
