## link_validator.nova - Checks all URLs in a text file for 404s
## Set input_file before running
## Ternary: +1 all ok, 0 some broken, -1 all broken or error

let input_file = "urls.txt"
let result = -1

let content = read_file(input_file)
if3 len(content) == 0
  print("[-1] Cannot read or empty file: " + input_file)
  let result = -1
else3
  ## Extract URLs - look for http:// or https://
  let lines = split(content, "\n")
  let urls = []

  let i = 0
  while3 i < len(lines)
    let line = trim(lines[i])
    if3 starts_with(line, "http://") == 1
      let urls = append(urls, line)
    else3
      if3 starts_with(line, "https://") == 1
        let urls = append(urls, line)
      end3
    end3
    let i = i + 1
  end3

  let total = len(urls)
  if3 total == 0
    print("[0] No URLs found in " + input_file)
    let result = 0
  else3
    let ok_count = 0
    let broken = 0

    print("=== LINK VALIDATOR ===")
    print("File: " + input_file)
    print("URLs found: " + str(total) + "\n")

    let j = 0
    while3 j < total
      let url = urls[j]
      let check = shell("curl -s -o /dev/null -w '%{http_code}' --max-time 10 -L \"" + url + "\"")
      if3 check.ok == 1
        let code = trim(check.stdout)
        let code_num = int(code)
        if3 code_num >= 200
          if3 code_num < 400
            print("  [OK]     " + code + " " + url)
            let ok_count = ok_count + 1
          else3
            print("  [BROKEN] " + code + " " + url)
            let broken = broken + 1
          end3
        else3
          print("  [BROKEN] " + code + " " + url)
          let broken = broken + 1
        end3
      else3
        print("  [ERROR]  --- " + url)
        let broken = broken + 1
      end3
      let j = j + 1
    end3

    print("\n--- Summary ---")
    print("OK: " + str(ok_count) + "/" + str(total))
    print("Broken: " + str(broken) + "/" + str(total))

    if3 broken == 0
      print("[+1] All links valid")
      let result = 1
    else3
      if3 ok_count > 0
        print("[0] Some links broken")
        let result = 0
      else3
        print("[-1] All links broken")
        let result = -1
      end3
    end3
  end3
end3

print("=== RESULT: " + str(result) + " ===")
