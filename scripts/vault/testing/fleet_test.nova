## fleet_test.nova - Tests all NovaX services for /health endpoint responding
## Ternary: +1 all healthy, 0 some down, -1 all down

let services = [
  {"port": 9999, "name": "Orchestrator"},
  {"port": 9881, "name": "Hivemind"},
  {"port": 9878, "name": "Cloud Router"},
  {"port": 9890, "name": "NovaXCore"},
  {"port": 9870, "name": "NovaLang"},
  {"port": 9871, "name": "Route Validator"},
  {"port": 9872, "name": "VCC"},
  {"port": 9875, "name": "Nova Cortex"},
  {"port": 9876, "name": "Nova Vault"},
  {"port": 9877, "name": "Nova Memory"},
  {"port": 9879, "name": "Nova Forge"},
  {"port": 9882, "name": "Nova Scribe"},
  {"port": 9883, "name": "Nova Sentinel"},
  {"port": 9884, "name": "Nova Pulse"},
  {"port": 9885, "name": "Nova Nexus"},
  {"port": 9905, "name": "Tier2 Drift Detector"},
  {"port": 9906, "name": "Tier2 Gradient Mapper"},
  {"port": 9907, "name": "Tier2 Viscosity Engine"},
  {"port": 9908, "name": "Tier2 Turbulence Classifier"},
  {"port": 9909, "name": "Tier2 Boundary Resolver"},
  {"port": 9910, "name": "Tier2 Pressure Solver"},
  {"port": 9911, "name": "Tier2 Vorticity Tracker"}
]

let healthy = 0
let unhealthy = 0
let total = len(services)

print("=== NOVAX FLEET TEST ===")
print("Testing " + str(total) + " services...\n")

let i = 0
while3 i < total
  let svc = services[i]
  let port = svc.port
  let name = svc.name
  let url = "http://127.0.0.1:" + str(port) + "/health"

  let check = shell("curl -s --max-time 3 \"" + url + "\"")
  if3 check.ok == 1
    let body = trim(check.stdout)
    if3 len(body) > 0
      ## Try to parse health response
      let health = json_decode(body)
      let status = dict_get(health, "status") ?? "unknown"
      if3 status == "ok"
        print("  [HEALTHY]   :" + str(port) + " " + name)
        let healthy = healthy + 1
      else3
        if3 status == "healthy"
          print("  [HEALTHY]   :" + str(port) + " " + name)
          let healthy = healthy + 1
        else3
          print("  [DEGRADED]  :" + str(port) + " " + name + " (status=" + status + ")")
          let unhealthy = unhealthy + 1
        end3
      end3
    else3
      print("  [DOWN]      :" + str(port) + " " + name + " (empty response)")
      let unhealthy = unhealthy + 1
    end3
  else3
    print("  [DOWN]      :" + str(port) + " " + name + " (no response)")
    let unhealthy = unhealthy + 1
  end3
  let i = i + 1
end3

print("\n=== FLEET SUMMARY ===")
print("Healthy:   " + str(healthy) + "/" + str(total))
print("Unhealthy: " + str(unhealthy) + "/" + str(total))

let pct = 0
if3 total > 0
  let pct = (healthy * 100) / total
end3
print("Uptime:    " + str(pct) + "%")

let result = -1
if3 unhealthy == 0
  print("\n[+1] Full fleet operational")
  let result = 1
else3
  if3 healthy > 0
    print("\n[0] Fleet partially operational")
    let result = 0
  else3
    print("\n[-1] Fleet down")
    let result = -1
  end3
end3

print("=== RESULT: " + str(result) + " ===")
