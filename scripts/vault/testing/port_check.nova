## port_check.nova - Checks if specific ports are listening
## Ternary: +1 all listening, 0 some down, -1 all down

let ports = [
  {"port": 9999, "name": "Orchestrator"},
  {"port": 9881, "name": "Hivemind"},
  {"port": 9878, "name": "Cloud Router"},
  {"port": 9890, "name": "NovaXCore"},
  {"port": 9870, "name": "NovaLang"}
]

let up = 0
let down = 0
let total = len(ports)

print("=== PORT CHECK ===\n")

let i = 0
while3 i < total
  let entry = ports[i]
  let p = entry.port
  let name = entry.name

  let check = shell("curl -s -o /dev/null -w '%{http_code}' --max-time 2 http://127.0.0.1:" + str(p) + "/health 2>/dev/null || echo FAIL")
  let code = trim(check.stdout)

  if3 code == "200"
    print("  [UP]   :" + str(p) + " " + name)
    let up = up + 1
  else3
    if3 code == "FAIL"
      print("  [DOWN] :" + str(p) + " " + name + " (not responding)")
      let down = down + 1
    else3
      print("  [WARN] :" + str(p) + " " + name + " (HTTP " + code + ")")
      let down = down + 1
    end3
  end3
  let i = i + 1
end3

print("\n--- Summary ---")
print("Up: " + str(up) + "/" + str(total))
print("Down: " + str(down) + "/" + str(total))

let result = -1
if3 down == 0
  print("[+1] All ports listening")
  let result = 1
else3
  if3 up > 0
    print("[0] Some ports down")
    let result = 0
  else3
    print("[-1] All ports down")
    let result = -1
  end3
end3

print("=== RESULT: " + str(result) + " ===")
