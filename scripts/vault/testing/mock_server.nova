// NovaX Script Vault — testing/mock_server.nova
// Description: Creates a mock HTTP server with canned responses
// Category: testing | Trit: +1=started, 0=config only, -1=error
// 100% PURE NOVALANG — uses native tserve(), zero external dependencies

let port = dict_get(args, "port") ?? "8765"

print("=== NovaX Mock Server ===")

// Canned response data
let _mock_routes = {
    "health":  {"status": "ok", "trit": 1},
    "echo":    {"echo": true, "msg": "mock response"},
    "version": {"version": "1.0.0-mock"},
    "status":  {"services": 0, "mock": true}
}

fn handle_mock_health(req) {
    return dict_get(_mock_routes, "health") ?? {"trit": -1}
}

fn handle_mock_echo(req) {
    let body = try3 { json_decode(req["body"]) } { {} }
    let base = dict_get(_mock_routes, "echo") ?? {}
    let base = dict_set(base, "received", body)
    return base
}

fn handle_mock_version(req) {
    return dict_get(_mock_routes, "version") ?? {"trit": -1}
}

fn handle_mock_status(req) {
    return dict_get(_mock_routes, "status") ?? {"trit": -1}
}

// Pure NovaLang HTTP server
let mock_port = try3 { to_int(port) } { 8765 }
let server = tserve(mock_port, "nova-mock-server")

troute(server, "GET",  "/health",      "handle_mock_health")
troute(server, "GET",  "/api/echo",    "handle_mock_echo")
troute(server, "POST", "/api/echo",    "handle_mock_echo")
troute(server, "GET",  "/api/version", "handle_mock_version")
troute(server, "GET",  "/api/status",  "handle_mock_status")

print("Routes configured:")
print("  GET  /health      -> {status: ok}")
print("  GET  /api/echo    -> {echo: true}")
print("  POST /api/echo    -> {echo: true, received: <body>}")
print("  GET  /api/version -> {version: 1.0.0-mock}")
print("  GET  /api/status  -> {services: 0, mock: true}")
print("")
print("[+1] Mock server started on :" + port)
tstart(server)
