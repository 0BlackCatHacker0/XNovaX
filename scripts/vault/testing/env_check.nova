## env_check.nova - Validates required environment variables are set
## Ternary: +1 all set, 0 some missing, -1 all missing

let required_vars = [
  "PATH",
  "HOME",
  "OPENAI_API_KEY",
  "PYTHONPATH"
]

let found = 0
let missing = 0
let total = len(required_vars)

print("=== ENVIRONMENT CHECK ===\n")

let i = 0
while3 i < total
  let varname = required_vars[i]
  let check = shell("echo $" + varname)
  if3 check.ok == 1
    let val = trim(check.stdout)
    if3 len(val) > 0
      ## Mask sensitive values
      if3 contains(varname, "KEY")
        print("  [SET]     " + varname + " = ****" + val[len(val) - 4:])
      else3
        if3 contains(varname, "SECRET")
          print("  [SET]     " + varname + " = ****")
        else3
          if3 len(val) > 60
            print("  [SET]     " + varname + " = " + val[0:60] + "...")
          else3
            print("  [SET]     " + varname + " = " + val)
          end3
        end3
      end3
      let found = found + 1
    else3
      print("  [MISSING] " + varname)
      let missing = missing + 1
    end3
  else3
    print("  [MISSING] " + varname)
    let missing = missing + 1
  end3
  let i = i + 1
end3

print("\n--- Summary ---")
print("Found: " + str(found) + "/" + str(total))
print("Missing: " + str(missing) + "/" + str(total))

let result = -1
if3 missing == 0
  print("[+1] All environment variables set")
  let result = 1
else3
  if3 found > 0
    print("[0] Some variables missing")
    let result = 0
  else3
    print("[-1] All variables missing")
    let result = -1
  end3
end3

print("=== RESULT: " + str(result) + " ===")
