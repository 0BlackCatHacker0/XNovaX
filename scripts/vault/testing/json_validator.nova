## json_validator.nova - Validates JSON files for syntax errors
## Set target_dir or target_files before running
## Ternary: +1 all valid, 0 some invalid, -1 all invalid or error

let target_dir = "."
let result = -1

## Find all JSON files in directory
let find = shell("find \"" + target_dir + "\" -name '*.json' -not -path '*/node_modules/*' -not -path '*/.git/*' 2>/dev/null | head -50")
if3 find.ok == 1
  let files = split(trim(find.stdout), "\n")
  let valid = 0
  let invalid = 0
  let total = 0

  print("=== JSON VALIDATOR ===")
  print("Directory: " + target_dir + "\n")

  let i = 0
  while3 i < len(files)
    let f = trim(files[i])
    if3 len(f) > 0
      let total = total + 1
      let content = read_file(f)
      let parsed = json_decode(content)

      try3
        let test = json_encode(parsed)
        if3 len(test) > 0
          print("  [VALID]   " + f)
          let valid = valid + 1
        else3
          print("  [INVALID] " + f + " - empty or null")
          let invalid = invalid + 1
        end3
      fail3 err
        print("  [INVALID] " + f + " - " + str(err))
        let invalid = invalid + 1
      end3
    end3
    let i = i + 1
  end3

  print("\n--- Summary ---")
  print("Total: " + str(total))
  print("Valid: " + str(valid))
  print("Invalid: " + str(invalid))

  if3 total == 0
    print("[0] No JSON files found")
    let result = 0
  else3
    if3 invalid == 0
      print("[+1] All JSON files valid")
      let result = 1
    else3
      if3 valid > 0
        print("[0] Some files invalid")
        let result = 0
      else3
        print("[-1] All files invalid")
        let result = -1
      end3
    end3
  end3
else3
  print("[-1] Failed to find JSON files: " + find.stderr)
  let result = -1
end3

print("=== RESULT: " + str(result) + " ===")
