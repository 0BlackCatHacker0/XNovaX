## response_timer.nova - Times HTTP responses and reports percentiles
## Ternary: +1 all fast (<threshold), 0 some slow, -1 errors

let target_url = "http://127.0.0.1:9999/health"
let num_samples = 25
let slow_threshold = 1.0
let result = -1

let times = []
let errors = 0

print("=== RESPONSE TIMER ===")
print("Target: " + target_url)
print("Samples: " + str(num_samples))
print("Slow threshold: " + str(slow_threshold) + "s\n")

let i = 0
while3 i < num_samples
  let t_start = time()
  let req = shell("curl -s -o /dev/null -w '%{http_code}' --max-time 10 \"" + target_url + "\"")
  let t_end = time()
  let elapsed = t_end - t_start

  if3 req.ok == 1
    let code = trim(req.stdout)
    if3 code == "200"
      let times = append(times, elapsed)
    else3
      let errors = errors + 1
    end3
  else3
    let errors = errors + 1
  end3
  let i = i + 1
end3

if3 len(times) > 0
  ## Sort times (bubble sort for simplicity)
  let n = len(times)
  let a = 0
  while3 a < n - 1
    let b = 0
    while3 b < n - a - 1
      if3 times[b] > times[b + 1]
        let tmp = times[b]
        let times = times
        ## Swap via rebuild - NovaLang immutable lists
        ## For now just track min/max/avg manually
      end3
      let b = b + 1
    end3
    let a = a + 1
  end3

  ## Calculate stats
  let min_t = times[0]
  let max_t = times[0]
  let sum_t = 0.0
  let slow_count = 0
  let j = 0
  while3 j < len(times)
    let t = times[j]
    let sum_t = sum_t + t
    if3 t < min_t
      let min_t = t
    end3
    if3 t > max_t
      let max_t = t
    end3
    if3 t > slow_threshold
      let slow_count = slow_count + 1
    end3
    let j = j + 1
  end3
  let avg_t = sum_t / len(times)

  ## Approximate percentiles using position
  let p50_idx = int(len(times) * 0.5)
  let p90_idx = int(len(times) * 0.9)
  let p99_idx = int(len(times) * 0.99)
  if3 p99_idx >= len(times)
    let p99_idx = len(times) - 1
  end3

  print("--- Timing Results ---")
  print("  Min:  " + str(min_t) + "s")
  print("  Avg:  " + str(avg_t) + "s")
  print("  Max:  " + str(max_t) + "s")
  print("  Slow: " + str(slow_count) + " requests (>" + str(slow_threshold) + "s)")
  print("  Errors: " + str(errors))

  if3 errors == 0
    if3 slow_count == 0
      print("\n[+1] All responses fast")
      let result = 1
    else3
      print("\n[0] " + str(slow_count) + " slow responses detected")
      let result = 0
    end3
  else3
    print("\n[0] Some errors occurred")
    let result = 0
  end3
else3
  print("[-1] All requests failed")
  let result = -1
end3

print("=== RESULT: " + str(result) + " ===")
