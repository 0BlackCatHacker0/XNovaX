## dep_checker.nova - Checks if required tools/commands are installed
## Ternary: +1 all found, 0 some missing, -1 all missing

let required_tools = [
  "python",
  "git",
  "curl",
  "node",
  "npm",
  "pip",
  "ssh",
  "tar",
  "gzip"
]

let found = 0
let missing = 0
let total = len(required_tools)

print("=== DEPENDENCY CHECKER ===\n")

let i = 0
while3 i < total
  let tool = required_tools[i]
  let check = shell("which " + tool + " 2>/dev/null || where " + tool + " 2>/dev/null")
  if3 check.ok == 1
    let path = trim(check.stdout)
    if3 len(path) > 0
      ## Try to get version
      let ver = shell(tool + " --version 2>/dev/null || " + tool + " -V 2>/dev/null")
      let version = ""
      if3 ver.ok == 1
        let ver_out = trim(ver.stdout)
        if3 len(ver_out) > 80
          let version = ver_out[0:80] + "..."
        else3
          let version = ver_out
        end3
      end3
      print("  [FOUND]   " + tool + " -> " + path)
      if3 len(version) > 0
        print("            version: " + version)
      end3
      let found = found + 1
    else3
      print("  [MISSING] " + tool)
      let missing = missing + 1
    end3
  else3
    print("  [MISSING] " + tool)
    let missing = missing + 1
  end3
  let i = i + 1
end3

print("\n--- Summary ---")
print("Found: " + str(found) + "/" + str(total))
print("Missing: " + str(missing) + "/" + str(total))

let result = -1
if3 missing == 0
  print("[+1] All dependencies installed")
  let result = 1
else3
  if3 found > 0
    print("[0] Some dependencies missing")
    let result = 0
  else3
    print("[-1] All dependencies missing")
    let result = -1
  end3
end3

print("=== RESULT: " + str(result) + " ===")
