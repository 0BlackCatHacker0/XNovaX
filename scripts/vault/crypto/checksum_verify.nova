// NovaX Script Vault — crypto/checksum_verify.nova
// Description: Verify file integrity against known checksums
// Category: crypto | Trit: +1=success

let test_file = "C:/NovaX/nova_version.json"

print("=== NovaX Checksum Verifier ===")
print("File: " + test_file)
print("")

let r = shell("certutil -hashfile \"" + test_file + "\" MD5")
let md5 = ""
if3 dict_get(r, "ok") ?? 0 == 1 {
  let lines = split(dict_get(r, "stdout") ?? "", "\n")
  if3 len(lines) > 1 {
    let md5 = trim(dict_get(lines, 1) ?? "")
  }
}
print("MD5:    " + md5)

let r = shell("certutil -hashfile \"" + test_file + "\" SHA1")
let sha1 = ""
if3 dict_get(r, "ok") ?? 0 == 1 {
  let lines = split(dict_get(r, "stdout") ?? "", "\n")
  if3 len(lines) > 1 {
    let sha1 = trim(dict_get(lines, 1) ?? "")
  }
}
print("SHA1:   " + sha1)

let r = shell("certutil -hashfile \"" + test_file + "\" SHA256")
let sha256 = ""
if3 dict_get(r, "ok") ?? 0 == 1 {
  let lines = split(dict_get(r, "stdout") ?? "", "\n")
  if3 len(lines) > 1 {
    let sha256 = trim(dict_get(lines, 1) ?? "")
  }
}
print("SHA256: " + sha256)

print("")
print("=== RESULT: +1 (success) ===")
