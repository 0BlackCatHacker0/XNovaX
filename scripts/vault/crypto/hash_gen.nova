## hash_gen.nova — Generates MD5/SHA1/SHA256/SHA512 hashes of input text
## Usage: set input_text below

let input_text = "Hello, NovaX!"
let result = -1

print("=== NovaX Hash Generator ===")
print("Input: " + input_text)
print("Length: " + to_string(len(input_text)) + " chars")
print("")

## Write input to temp file for certutil hashing
let tmp_file = "C:\\NovaX\\tmp\\hash_input.tmp"
write_file(tmp_file, input_text)

let algos = ["MD5", "SHA1", "SHA256", "SHA512"]
let labels = ["MD5:    ", "SHA1:   ", "SHA256: ", "SHA512: "]

try3
  let ai = 0
  let all_ok = 1
  while3 ai < len(algos)
    let algo = algos[ai]
    let cmd = "certutil -hashfile \"" + tmp_file + "\" " + algo
    let r = shell(cmd)
    if3 r["code"] == 0
      ## certutil output: line 0 = algo header, line 1 = hash, line 2 = success msg
      let lines = split(trim(r["stdout"]), "\n")
      if3 len(lines) >= 2
        let hash_val = trim(replace(lines[1], " ", ""))
        print(labels[ai] + hash_val)
      else3
        print(labels[ai] + "ERROR")
        let all_ok = 0
    else3
      print(labels[ai] + "ERROR")
      let all_ok = 0
    let ai = ai + 1
  end3

  if3 all_ok == 1
    let result = +1
  end3

fail3 err
  print("ERROR: " + to_string(err))
end3

## Cleanup
shell("del /q \"" + tmp_file + "\" 2>nul")

print("")
if3 result == 1
  print("[+1] Hashes generated successfully")
else3
  print("[-1] Hash generation failed")
end3
