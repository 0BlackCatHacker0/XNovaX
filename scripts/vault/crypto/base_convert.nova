## base_convert.nova — Convert numbers between binary, octal, decimal, hex
## Usage: set input_value and input_base below

let input_value = "255"
let input_base = "decimal"
let result = -1

print("=== NovaX Base Converter ===")
print("Input: " + input_value)
print("Base:  " + input_base)
print("")

## Parse input to decimal using NovaLang
let dec_val = 0
let parse_ok = 1
let hex_digits = "0123456789abcdef"

if3 input_base == "decimal"
  let dec_val = to_int(input_value)
else3
  if3 input_base == "hex"
    let lv = lower(input_value)
    let hi = 0
    while3 hi < len(lv)
      let ch = lv[hi]
      let dv = index_of(hex_digits, ch)
      if3 dv == -1
        let parse_ok = 0
      else3
        let dec_val = dec_val * 16 + dv
      let hi = hi + 1
    end3
  else3
    if3 input_base == "binary"
      let bi = 0
      while3 bi < len(input_value)
        let ch = input_value[bi]
        if3 ch == "0"
          let dec_val = dec_val * 2
        else3
          if3 ch == "1"
            let dec_val = dec_val * 2 + 1
          else3
            let parse_ok = 0
        let bi = bi + 1
      end3
    else3
      if3 input_base == "octal"
        let oi = 0
        while3 oi < len(input_value)
          let ch = input_value[oi]
          let dv = to_int(ch)
          if3 dv >= 0 && dv <= 7
            let dec_val = dec_val * 8 + dv
          else3
            let parse_ok = 0
          let oi = oi + 1
        end3
      else3
        print("Error: Invalid base. Use: binary, octal, decimal, hex")
        let parse_ok = 0
      end3
    end3
  end3
end3

if3 parse_ok == 0
  print("Error: Could not parse value in given base")
  let result = -1
else3
  ## Convert decimal to all bases using NovaLang
  ## Binary
  let bin_str = ""
  let tmp = dec_val
  if3 tmp == 0
    let bin_str = "0"
  else3
    while3 tmp > 0
      let bit = tmp % 2
      let bin_str = str(bit) + bin_str
      let tmp = tmp / 2
    end3
  end3

  ## Octal
  let oct_str = ""
  let tmp = dec_val
  if3 tmp == 0
    let oct_str = "0"
  else3
    while3 tmp > 0
      let digit = tmp % 8
      let oct_str = str(digit) + oct_str
      let tmp = tmp / 8
    end3
  end3

  ## Hex
  let hex_str = ""
  let tmp = dec_val
  if3 tmp == 0
    let hex_str = "0"
  else3
    while3 tmp > 0
      let digit = tmp % 16
      let hex_str = hex_digits[digit] + hex_str
      let tmp = tmp / 16
    end3
  end3

  print("Decimal: " + str(dec_val))
  print("Binary:  0b" + bin_str + "  (" + bin_str + ")")
  print("Octal:   0o" + oct_str + "  (" + oct_str + ")")
  print("Hex:     0x" + hex_str + "  (" + hex_str + ")")

  ## Show ternary for NovaX flavor
  print("")
  print("Ternary (balanced) hint: " + to_string(dec_val) + " in base-3 space")
  let result = +1
end3

print("")
if3 result == 1
  print("[+1] Base conversion successful")
else3
  print("[-1] Base conversion failed")
end3
