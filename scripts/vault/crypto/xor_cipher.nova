## xor_cipher.nova — XOR encryption/decryption with a key
## Usage: set input_text and xor_key below. XOR is symmetric.

let input_text = "Hello NovaX! Secret message."
let xor_key = "N0v4X"
let result = -1

print("=== NovaX XOR Cipher ===")
print("Input: " + input_text)
print("Key:   " + xor_key)
print("")

## NovaLang char-by-char XOR using char_code/from_char_code builtins
let encrypted_codes = []
let enc_hex = ""
let hex_chars = "0123456789abcdef"
let i = 0
while3 i < len(input_text)
  let ch = char_code(input_text[i])
  let kc = char_code(xor_key[i % len(xor_key)])
  let xored = bit_xor(ch, kc)
  let encrypted_codes = append(encrypted_codes, xored)
  ## Build hex string
  let hi = xored / 16
  let lo = xored % 16
  let enc_hex = enc_hex + hex_chars[hi] + hex_chars[lo]
  let i = i + 1
end3

## Decrypt (XOR is symmetric)
let decrypted = ""
let di = 0
while3 di < len(encrypted_codes)
  let ec = encrypted_codes[di]
  let kc = char_code(xor_key[di % len(xor_key)])
  let dec_code = bit_xor(ec, kc)
  let decrypted = decrypted + from_char_code(dec_code)
  let di = di + 1
end3

## Build base64 of encrypted bytes via certutil
let tmp_bin = "C:\\NovaX\\tmp\\xor_bin.tmp"
let tmp_b64 = "C:\\NovaX\\tmp\\xor_b64.tmp"
let bin_str = ""
let bi = 0
while3 bi < len(encrypted_codes)
  let bin_str = bin_str + from_char_code(encrypted_codes[bi])
  let bi = bi + 1
end3
write_file(tmp_bin, bin_str)
let b64_cmd = "certutil -encode \"" + tmp_bin + "\" \"" + tmp_b64 + "\" >nul 2>&1 && type \"" + tmp_b64 + "\""
let b64_r = shell(b64_cmd)
let enc_b64 = ""
if3 b64_r["ok"] == 1
  let raw = trim(b64_r["stdout"])
  let lines = split(raw, "\n")
  let li = 0
  while3 li < len(lines)
    let line = trim(lines[li])
    if3 line != "-----BEGIN CERTIFICATE-----" && line != "-----END CERTIFICATE-----" && line != ""
      let enc_b64 = enc_b64 + line
    let li = li + 1
  end3
end3
shell("del /q \"" + tmp_bin + "\" \"" + tmp_b64 + "\" 2>nul")

print("Encrypted (Base64): " + enc_b64)
print("Encrypted (Hex):    " + enc_hex)
print("Decrypted:          " + decrypted)
print("")

let match = decrypted == input_text
if3 match == true
  print("Round-trip: PASS (XOR is symmetric)")
  let result = +1
else3
  print("Round-trip: FAIL")
  let result = -1
end3

print("")
if3 result == 1
  print("[+1] XOR cipher successful")
else3
  print("[-1] XOR cipher failed")
end3
