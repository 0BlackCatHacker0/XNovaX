## caesar_cipher.nova — Caesar cipher encrypt/decrypt with configurable shift
## Usage: set mode ("encrypt" or "decrypt"), shift, and input_text below

let mode = "encrypt"
let shift = 13
let input_text = "Hello NovaX! The quick brown fox jumps over 42 lazy dogs."
let result = -1

print("=== NovaX Caesar Cipher ===")
print("Mode: " + mode)
print("Shift: " + to_string(shift))
print("Input: " + input_text)
print("")

let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
let lower = "abcdefghijklmnopqrstuvwxyz"
let output = ""
let actual_shift = shift

if3 mode == "decrypt"
  let actual_shift = 26 - shift
end3

## Normalize shift to 0-25
let actual_shift = actual_shift % 26

let i = 0
while3 i < len(input_text)
  let ch = slice(input_text, i, i + 1)
  let shifted = false

  ## Check uppercase
  let ui = 0
  while3 ui < 26
    if3 shifted == false
      if3 ch == slice(upper, ui, ui + 1)
        let ni = (ui + actual_shift) % 26
        let output = output + slice(upper, ni, ni + 1)
        let shifted = true
      end3
    end3
    let ui = ui + 1
  end3

  ## Check lowercase
  if3 shifted == false
    let li = 0
    while3 li < 26
      if3 shifted == false
        if3 ch == slice(lower, li, li + 1)
          let ni = (li + actual_shift) % 26
          let output = output + slice(lower, ni, ni + 1)
          let shifted = true
        end3
      end3
      let li = li + 1
    end3
  end3

  ## Non-alpha passes through
  if3 shifted == false
    let output = output + ch
  end3

  let i = i + 1
end3

print("Output: " + output)
let result = +1

print("")
if3 result == 1
  print("[+1] Caesar cipher " + mode + " complete")
else3
  print("[-1] Caesar cipher failed")
end3
