// NovaX Script Vault — crypto/random_token.nova
// Description: Generate secure random tokens (hex, alphanumeric, numeric)
// Category: crypto | Trit: +1=success

let length = 32

print("=== NovaX Random Token Generator ===")
print("Length: " + str(length))
print("")

let hex_chars = "0123456789abcdef"
let hex_arr = split(hex_chars, "")
let hex_token = ""
let i = 0
while3 i < length {
  let idx = random_int(0, 15)
  let hex_token = hex_token + dict_get(hex_arr, idx) ?? "0"
  let i = i + 1
}
print("Hex:          " + hex_token)

let alnum = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
let alnum_arr = split(alnum, "")
let alnum_token = ""
let i = 0
while3 i < length {
  let idx = random_int(0, 61)
  let alnum_token = alnum_token + dict_get(alnum_arr, idx) ?? "a"
  let i = i + 1
}
print("Alphanumeric: " + alnum_token)

let pin = ""
let i = 0
while3 i < 8 {
  let pin = pin + str(random_int(0, 9))
  let i = i + 1
}
print("Numeric PIN:  " + pin)

let b64 = base64_encode(hex_token)
print("Base64:       " + b64)

print("")
print("=== RESULT: +1 (success) ===")
