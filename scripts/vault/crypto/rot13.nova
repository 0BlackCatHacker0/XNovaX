## rot13.nova — ROT13 encode/decode (symmetric - same operation both ways)
## Usage: set input_text below

let input_text = "Hello NovaX! ROT13 is symmetric."
let result = -1

print("=== NovaX ROT13 Encoder/Decoder ===")
print("Input:  " + input_text)
print("")

let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
let lower = "abcdefghijklmnopqrstuvwxyz"
let output = ""

let i = 0
while3 i < len(input_text)
  let ch = slice(input_text, i, i + 1)
  let done = false

  ## Uppercase
  let ui = 0
  while3 ui < 26
    if3 done == false
      if3 ch == slice(upper, ui, ui + 1)
        let ni = (ui + 13) % 26
        let output = output + slice(upper, ni, ni + 1)
        let done = true
      end3
    end3
    let ui = ui + 1
  end3

  ## Lowercase
  if3 done == false
    let li = 0
    while3 li < 26
      if3 done == false
        if3 ch == slice(lower, li, li + 1)
          let ni = (li + 13) % 26
          let output = output + slice(lower, ni, ni + 1)
          let done = true
        end3
      end3
      let li = li + 1
    end3
  end3

  if3 done == false
    let output = output + ch
  end3

  let i = i + 1
end3

print("Output: " + output)
print("")

## Verify by double-applying (should return original)
let verify = ""
let j = 0
while3 j < len(output)
  let ch = slice(output, j, j + 1)
  let done = false

  let ui = 0
  while3 ui < 26
    if3 done == false
      if3 ch == slice(upper, ui, ui + 1)
        let ni = (ui + 13) % 26
        let verify = verify + slice(upper, ni, ni + 1)
        let done = true
      end3
    end3
    let ui = ui + 1
  end3

  if3 done == false
    let li = 0
    while3 li < 26
      if3 done == false
        if3 ch == slice(lower, li, li + 1)
          let ni = (li + 13) % 26
          let verify = verify + slice(lower, ni, ni + 1)
          let done = true
        end3
      end3
      let li = li + 1
    end3
  end3

  if3 done == false
    let verify = verify + ch
  end3

  let j = j + 1
end3

print("Verify: " + verify)
if3 verify == input_text
  print("Round-trip: PASS (ROT13 is symmetric)")
  let result = +1
else3
  print("Round-trip: FAIL")
  let result = -1
end3

print("")
if3 result == 1
  print("[+1] ROT13 encode/decode successful")
else3
  print("[-1] ROT13 failed")
end3
