## uuid_gen.nova — Generates UUID v4 (random)
## Usage: set count below

let count = 5
let result = -1

print("=== NovaX UUID v4 Generator ===")
print("Count: " + to_string(count))
print("")

let uuids = []
let generated = 0

while3 generated < count
  ## Build UUID v4 from random hex
  let hex_chars = "0123456789abcdef"
  let uuid = ""
  let pos = 0

  while3 pos < 32
    if3 pos == 8
      let uuid = uuid + "-"
    end3
    if3 pos == 12
      let uuid = uuid + "-"
    end3
    if3 pos == 16
      let uuid = uuid + "-"
    end3
    if3 pos == 20
      let uuid = uuid + "-"
    end3

    if3 pos == 12
      ## Version 4
      let uuid = uuid + "4"
    else3 pos == 16
      ## Variant: 8, 9, a, or b
      let vi = random_int(0, 3)
      let variant_chars = "89ab"
      let uuid = uuid + slice(variant_chars, vi, vi + 1)
    else3
      let ri = random_int(0, 15)
      let uuid = uuid + slice(hex_chars, ri, ri + 1)
    end3

    let pos = pos + 1
  end3

  let generated = generated + 1
  let uuids = append(uuids, uuid)
  print("[" + to_string(generated) + "] " + uuid)
end3

print("")
print("Generated " + to_string(len(uuids)) + " UUIDs")
let result = +1
print("[+1] UUID generation complete")
