// unit_convert.nova - Convert between metric/imperial (length, weight, temp)
// NovaX Script Vault | Math Category

let result = +1

try3
    print("=== Unit Converter ===")

    // --- LENGTH CONVERSIONS ---
    print("\n--- Length Conversions ---")
    let miles = 26.2
    let km = miles * 1.60934
    print(str(miles) + " miles = " + str(km) + " km")

    let meters = 100
    let feet = meters * 3.28084
    print(str(meters) + " meters = " + str(feet) + " feet")

    let inches = 72
    let cm = inches * 2.54
    print(str(inches) + " inches = " + str(cm) + " cm")

    let yards = 100
    let m_from_yd = yards * 0.9144
    print(str(yards) + " yards = " + str(m_from_yd) + " meters")

    let nautical = 1
    let km_naut = nautical * 1.852
    print(str(nautical) + " nautical mile = " + str(km_naut) + " km")

    // --- WEIGHT CONVERSIONS ---
    print("\n--- Weight Conversions ---")
    let pounds = 180
    let kg = pounds * 0.453592
    print(str(pounds) + " lbs = " + str(kg) + " kg")

    let ounces = 16
    let grams = ounces * 28.3495
    print(str(ounces) + " oz = " + str(grams) + " g")

    let stones = 12
    let kg_from_stone = stones * 6.35029
    print(str(stones) + " stone = " + str(kg_from_stone) + " kg")

    let tons_us = 1
    let tonnes = tons_us * 0.907185
    print(str(tons_us) + " US ton = " + str(tonnes) + " metric tonnes")

    // --- TEMPERATURE CONVERSIONS ---
    print("\n--- Temperature Conversions ---")

    // Fahrenheit to Celsius
    let temps_f = [32, 72, 98.6, 212, 451]
    let i = 0
    while3 i < len(temps_f)
        let f = temps_f[i]
        let c = (f - 32) * 5 / 9
        let k = c + 273.15
        // Round to 2 decimals via floor trick
        let c_round = floor(c * 100) / 100
        let k_round = floor(k * 100) / 100
        print(str(f) + " F = " + str(c_round) + " C = " + str(k_round) + " K")
        let i = i + 1
    end

    // --- VOLUME ---
    print("\n--- Volume Conversions ---")
    let gallons = 1
    let liters = gallons * 3.78541
    print(str(gallons) + " US gallon = " + str(liters) + " liters")

    let cups = 8
    let ml = cups * 236.588
    print(str(cups) + " cups = " + str(ml) + " ml")

    print("\nTernary result: +1 (success)")
    let result = +1
fail3
    print("ERROR: Unit conversion failed")
    print("Ternary result: -1 (fail)")
    let result = -1
end

return result
