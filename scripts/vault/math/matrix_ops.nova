// matrix_ops.nova - Matrix addition, multiplication, transpose, determinant
// NovaX Script Vault | Math Category

let result = +1

try3
    print("=== Matrix Operations ===")

    // Matrices stored as flat arrays with row/col metadata
    // 2x2 matrix: [a, b, c, d] = | a b |
    //                              | c d |

    // --- 2x2 OPERATIONS ---
    print("\n--- 2x2 Matrix Operations ---")

    let mat_a = [1, 2, 3, 4]
    let mat_b = [5, 6, 7, 8]

    // Print matrices
    print("Matrix A:")
    print("  | " + str(mat_a[0]) + "  " + str(mat_a[1]) + " |")
    print("  | " + str(mat_a[2]) + "  " + str(mat_a[3]) + " |")
    print("Matrix B:")
    print("  | " + str(mat_b[0]) + "  " + str(mat_b[1]) + " |")
    print("  | " + str(mat_b[2]) + "  " + str(mat_b[3]) + " |")

    // Addition
    let add_r = [mat_a[0]+mat_b[0], mat_a[1]+mat_b[1], mat_a[2]+mat_b[2], mat_a[3]+mat_b[3]]
    print("\nA + B:")
    print("  | " + str(add_r[0]) + "  " + str(add_r[1]) + " |")
    print("  | " + str(add_r[2]) + "  " + str(add_r[3]) + " |")

    // Multiplication (2x2)
    let mul_r = [
        mat_a[0]*mat_b[0] + mat_a[1]*mat_b[2],
        mat_a[0]*mat_b[1] + mat_a[1]*mat_b[3],
        mat_a[2]*mat_b[0] + mat_a[3]*mat_b[2],
        mat_a[2]*mat_b[1] + mat_a[3]*mat_b[3]
    ]
    print("\nA * B:")
    print("  | " + str(mul_r[0]) + "  " + str(mul_r[1]) + " |")
    print("  | " + str(mul_r[2]) + "  " + str(mul_r[3]) + " |")

    // Transpose (2x2)
    let trans_a = [mat_a[0], mat_a[2], mat_a[1], mat_a[3]]
    print("\nTranspose(A):")
    print("  | " + str(trans_a[0]) + "  " + str(trans_a[1]) + " |")
    print("  | " + str(trans_a[2]) + "  " + str(trans_a[3]) + " |")

    // Determinant (2x2): ad - bc
    let det_a = mat_a[0]*mat_a[3] - mat_a[1]*mat_a[2]
    print("\ndet(A) = " + str(mat_a[0]) + "*" + str(mat_a[3]) + " - " + str(mat_a[1]) + "*" + str(mat_a[2]) + " = " + str(det_a))

    let det_b = mat_b[0]*mat_b[3] - mat_b[1]*mat_b[2]
    print("det(B) = " + str(det_b))

    // --- 3x3 OPERATIONS ---
    print("\n--- 3x3 Matrix Operations ---")
    // 3x3: [a,b,c, d,e,f, g,h,i]
    let m3 = [1, 2, 3, 0, 4, 5, 1, 0, 6]
    print("Matrix C (3x3):")
    print("  | " + str(m3[0]) + "  " + str(m3[1]) + "  " + str(m3[2]) + " |")
    print("  | " + str(m3[3]) + "  " + str(m3[4]) + "  " + str(m3[5]) + " |")
    print("  | " + str(m3[6]) + "  " + str(m3[7]) + "  " + str(m3[8]) + " |")

    // Transpose 3x3
    let t3 = [m3[0], m3[3], m3[6], m3[1], m3[4], m3[7], m3[2], m3[5], m3[8]]
    print("\nTranspose(C):")
    print("  | " + str(t3[0]) + "  " + str(t3[1]) + "  " + str(t3[2]) + " |")
    print("  | " + str(t3[3]) + "  " + str(t3[4]) + "  " + str(t3[5]) + " |")
    print("  | " + str(t3[6]) + "  " + str(t3[7]) + "  " + str(t3[8]) + " |")

    // Determinant 3x3: a(ei-fh) - b(di-fg) + c(dh-eg)
    let det3 = m3[0] * (m3[4]*m3[8] - m3[5]*m3[7]) - m3[1] * (m3[3]*m3[8] - m3[5]*m3[6]) + m3[2] * (m3[3]*m3[7] - m3[4]*m3[6])
    print("\ndet(C) = " + str(det3))

    // Identity matrix check
    print("\n--- Identity Matrix ---")
    let identity = [1, 0, 0, 0, 1, 0, 0, 0, 1]
    let det_i = identity[0]*(identity[4]*identity[8]-identity[5]*identity[7]) - identity[1]*(identity[3]*identity[8]-identity[5]*identity[6]) + identity[2]*(identity[3]*identity[7]-identity[4]*identity[6])
    print("det(I) = " + str(det_i) + " (should be 1)")

    print("\nTernary result: +1 (success)")
    let result = +1
fail3
    print("ERROR: Matrix operations failed")
    print("Ternary result: -1 (fail)")
    let result = -1
end

return result
