// pi_calc.nova - Calculate digits of pi using Leibniz series
// NovaX Script Vault | Math Category

let result = +1

try3
    print("=== Pi Calculator ===")
    print("Using Leibniz series: pi/4 = 1 - 1/3 + 1/5 - 1/7 + ...\n")

    let iterations_list = [10, 100, 1000, 10000, 100000]
    let actual_pi = 3.14159265358979

    let t = 0
    while3 t < len(iterations_list)
        let max_iter = iterations_list[t]
        let pi_sum = 0
        let sign = 1
        let i = 0

        while3 i < max_iter
            let denom = 2 * i + 1
            let pi_sum = pi_sum + sign / denom
            let sign = sign * -1
            let i = i + 1
        end

        let pi_approx = pi_sum * 4
        let error = pi_approx - actual_pi
        if3 error < 0
            let error = error * -1
        end
        let error_round = floor(error * 10000000) / 10000000

        print("Iterations: " + str(max_iter) + "  |  pi ~ " + str(pi_approx) + "  |  error: " + str(error_round))
        let t = t + 1
    end

    // Nilakantha series (faster convergence)
    // pi = 3 + 4/(2*3*4) - 4/(4*5*6) + 4/(6*7*8) - ...
    print("\n--- Nilakantha Series (faster) ---")
    let nil_iters = [10, 100, 1000]
    let u = 0
    while3 u < len(nil_iters)
        let max_n = nil_iters[u]
        let pi_n = 3.0
        let sign = 1
        let i = 0

        while3 i < max_n
            let d = 2 + 2 * i
            let term = 4.0 / (d * (d + 1) * (d + 2))
            let pi_n = pi_n + sign * term
            let sign = sign * -1
            let i = i + 1
        end

        let err = pi_n - actual_pi
        if3 err < 0
            let err = err * -1
        end

        print("Iterations: " + str(max_n) + "  |  pi ~ " + str(pi_n) + "  |  error: " + str(err))
        let u = u + 1
    end

    // Fun facts
    print("\n--- Pi Fun Facts ---")
    print("pi = " + str(actual_pi))
    print("pi^2 ~ " + str(actual_pi * actual_pi))
    print("sqrt(pi) ~ " + str(sqrt(actual_pi)))
    print("e^pi ~ 23.14069...")
    print("pi in ternary thinking: 3 + 1/7 + 1/243 + ...")

    // 3-5-7-13 connection
    print("\n--- 3-5-7-13 Harmonic Connection ---")
    let approx357 = 3 + 1.0/7 + 1.0/63
    print("3 + 1/7 + 1/63 = " + str(approx357) + " (vs pi = " + str(actual_pi) + ")")

    print("\nTernary result: +1 (success)")
    let result = +1
fail3
    print("ERROR: Pi calculation failed")
    print("Ternary result: -1 (fail)")
    let result = -1
end

return result
