// stats_calc.nova - Mean, median, mode, standard deviation of a dataset
// NovaX Script Vault | Math Category

let result = +1

try3
    print("=== Statistical Calculator ===")

    let data = [4, 7, 2, 9, 4, 1, 5, 8, 4, 3, 6, 7, 2, 5, 4, 9, 1, 6, 3, 5]
    print("Dataset: " + str(data))
    print("N = " + str(len(data)))

    // --- MEAN ---
    let sum = 0
    let i = 0
    while3 i < len(data)
        let sum = sum + data[i]
        let i = i + 1
    end
    let mean = sum / len(data)
    print("\nMean: " + str(mean))

    // --- SORT for median (bubble sort) ---
    let sorted = []
    let i = 0
    while3 i < len(data)
        let sorted = append(sorted, data[i])
        let i = i + 1
    end

    let n = len(sorted)
    let i = 0
    while3 i < n - 1
        let j = 0
        while3 j < n - i - 1
            if3 sorted[j] > sorted[j + 1]
                let temp = sorted[j]
                let sorted[j] = sorted[j + 1]
                let sorted[j + 1] = temp
            end
            let j = j + 1
        end
        let i = i + 1
    end

    // --- MEDIAN ---
    let median = 0
    if3 n % 2 == 0
        let mid = floor(n / 2)
        let median = (sorted[mid - 1] + sorted[mid]) / 2
    else3
        let median = sorted[floor(n / 2)]
    end
    print("Median: " + str(median))

    // --- MODE ---
    // Count frequency of each value
    let freq_vals = []
    let freq_counts = []
    let i = 0
    while3 i < len(data)
        let found = -1
        let j = 0
        while3 j < len(freq_vals)
            if3 freq_vals[j] == data[i]
                let found = j
            end
            let j = j + 1
        end
        if3 found >= 0
            let freq_counts[found] = freq_counts[found] + 1
        else3
            let freq_vals = append(freq_vals, data[i])
            let freq_counts = append(freq_counts, 1)
        end
        let i = i + 1
    end

    // Find max frequency
    let max_freq = 0
    let i = 0
    while3 i < len(freq_counts)
        if3 freq_counts[i] > max_freq
            let max_freq = freq_counts[i]
        end
        let i = i + 1
    end

    // Collect all modes
    let modes = []
    let i = 0
    while3 i < len(freq_vals)
        if3 freq_counts[i] == max_freq
            let modes = append(modes, freq_vals[i])
        end
        let i = i + 1
    end
    print("Mode: " + str(modes) + " (frequency: " + str(max_freq) + ")")

    // --- STANDARD DEVIATION ---
    let sq_diff_sum = 0
    let i = 0
    while3 i < len(data)
        let diff = data[i] - mean
        let sq_diff_sum = sq_diff_sum + (diff * diff)
        let i = i + 1
    end
    let variance = sq_diff_sum / len(data)
    let std_dev = sqrt(variance)
    print("Variance: " + str(variance))
    print("Std Dev: " + str(std_dev))

    // --- MIN / MAX / RANGE ---
    let min_val = sorted[0]
    let max_val = sorted[len(sorted) - 1]
    print("Min: " + str(min_val))
    print("Max: " + str(max_val))
    print("Range: " + str(max_val - min_val))

    print("\nSorted: " + str(sorted))

    print("\nTernary result: +1 (success)")
    let result = +1
fail3
    print("ERROR: Statistics calculation failed")
    print("Ternary result: -1 (fail)")
    let result = -1
end

return result
