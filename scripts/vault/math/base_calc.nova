// base_calc.nova - Calculator: add, subtract, multiply, divide, power, modulo
// NovaX Script Vault | Math Category

let result = +1

try3
    print("=== NovaLang Calculator ===")

    // Define test operations
    let a_vals = [42, 100, 7, 2187, 15, 243, 17, 100, 3, 10]
    let b_vals = [13, 37, 3, 3, 4, 5, 5, 0, 7, 3]
    let ops = ["add", "sub", "mul", "div", "pow", "mod", "add", "div", "pow", "mod"]

    let pass_count = 0
    let fail_count = 0

    let i = 0
    while3 i < len(ops)
        let a = a_vals[i]
        let b = b_vals[i]
        let op = ops[i]
        let res = 0
        let error = 0
        let symbol = ""

        if3 op == "add"
            let res = a + b
            let symbol = "+"
        else3
            if3 op == "sub"
                let res = a - b
                let symbol = "-"
            else3
                if3 op == "mul"
                    let res = a * b
                    let symbol = "*"
                else3
                    if3 op == "div"
                        if3 b == 0
                            print(str(a) + " / " + str(b) + " = ERROR (division by zero)")
                            let error = 1
                            let fail_count = fail_count + 1
                        else3
                            let res = a / b
                            let symbol = "/"
                        end
                    else3
                        if3 op == "pow"
                            // Manual power calculation
                            let res = 1
                            let p = 0
                            while3 p < b
                                let res = res * a
                                let p = p + 1
                            end
                            let symbol = "^"
                        else3
                            if3 op == "mod"
                                let res = a % b
                                let symbol = "%"
                            end
                        end
                    end
                end
            end
        end

        if3 error == 0
            print(str(a) + " " + symbol + " " + str(b) + " = " + str(res))
            let pass_count = pass_count + 1
        end

        let i = i + 1
    end

    // Chained calculation demo
    print("\n--- Chained Calculation ---")
    let chain = 3
    let chain = chain * 3
    let chain = chain * 3
    let chain = chain * 3
    let chain = chain * 3
    let chain = chain * 3
    let chain = chain * 3
    print("3^7 (by chaining *3): " + str(chain) + " (should be 2187)")

    // Ternary arithmetic demo
    print("\n--- Ternary Arithmetic ---")
    let tvals = [-1, 0, 1]
    let ti = 0
    while3 ti < 3
        let tj = 0
        while3 tj < 3
            let ta = tvals[ti]
            let tb = tvals[tj]
            let tsum = ta + tb
            let tprod = ta * tb
            print("(" + str(ta) + ") + (" + str(tb) + ") = " + str(tsum) + "  |  (" + str(ta) + ") * (" + str(tb) + ") = " + str(tprod))
            let tj = tj + 1
        end
        let ti = ti + 1
    end

    print("\nPassed: " + str(pass_count) + " | Failed: " + str(fail_count))

    if3 fail_count > 0
        print("Ternary result: 0 (partial - div by zero caught)")
        let result = 0
    else3
        print("Ternary result: +1 (success)")
        let result = +1
    end
fail3
    print("ERROR: Calculator failed")
    print("Ternary result: -1 (fail)")
    let result = -1
end

return result
