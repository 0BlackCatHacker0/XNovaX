// prime_factor.nova - Decompose a number into prime factors
// NovaX Script Vault | Math Category

let result = +1

try3
    print("=== Prime Factorization ===")

    let test_numbers = [2, 12, 36, 84, 100, 360, 1001, 2187, 9999]

    let t = 0
    while3 t < len(test_numbers)
        let num = test_numbers[t]
        let n = num
        let factors = []

        // Factor out 2s
        while3 n % 2 == 0
            let factors = append(factors, 2)
            let n = floor(n / 2)
        end

        // Factor out odd numbers starting from 3
        let divisor = 3
        while3 divisor * divisor <= n
            while3 n % divisor == 0
                let factors = append(factors, divisor)
                let n = floor(n / divisor)
            end
            let divisor = divisor + 2
        end

        // If n is still > 1, then it's a prime factor
        if3 n > 1
            let factors = append(factors, n)
        end

        // Build output string
        let output = str(num) + " = "
        let f = 0
        while3 f < len(factors)
            if3 f > 0
                let output = output + " x "
            end
            let output = output + str(factors[f])
            let f = f + 1
        end

        // Count unique factors
        let unique = []
        let u = 0
        while3 u < len(factors)
            let found = 0
            let v = 0
            while3 v < len(unique)
                if3 unique[v] == factors[u]
                    let found = 1
                end
                let v = v + 1
            end
            if3 found == 0
                let unique = append(unique, factors[u])
            end
            let u = u + 1
        end

        let is_prime = len(factors) == 1
        let label = ""
        if3 is_prime
            let label = " (prime!)"
        end

        print(output + label + "  [" + str(len(unique)) + " unique factor(s)]")
        let t = t + 1
    end

    // Special: 2187 = 3^7 (NovaX harmonic!)
    print("\nNote: 2187 = 3^7 = BLOCK_SIZE (NovaX harmonic constant)")

    print("\nTernary result: +1 (success)")
    let result = +1
fail3
    print("ERROR: Prime factorization failed")
    print("Ternary result: -1 (fail)")
    let result = -1
end

return result
