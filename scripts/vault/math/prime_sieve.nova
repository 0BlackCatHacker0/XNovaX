// prime_sieve.nova - Sieve of Eratosthenes: generate primes up to N
// NovaX Script Vault | Math Category

let limit = 100
let result = +1

try3
    print("=== Sieve of Eratosthenes ===")
    print("Finding all primes up to " + str(limit) + "...")

    // Initialize sieve - all true (1) initially
    let sieve = []
    let i = 0
    while3 i <= limit
        let sieve = append(sieve, 1)
        let i = i + 1
    end

    // 0 and 1 are not prime
    let sieve[0] = 0
    let sieve[1] = 0

    // Sieve algorithm
    let p = 2
    while3 p * p <= limit
        if3 sieve[p] == 1
            // Mark multiples of p as not prime
            let multiple = p * p
            while3 multiple <= limit
                let sieve[multiple] = 0
                let multiple = multiple + p
            end
        end
        let p = p + 1
    end

    // Collect primes
    let primes = []
    let i = 2
    while3 i <= limit
        if3 sieve[i] == 1
            let primes = append(primes, i)
        end
        let i = i + 1
    end

    // Display results
    let output = ""
    let j = 0
    while3 j < len(primes)
        if3 j > 0
            let output = output + ", "
        end
        let output = output + str(primes[j])
        let j = j + 1
    end
    print("Primes: " + output)
    print("Count: " + str(len(primes)) + " primes found")

    // Twin primes
    print("\nTwin primes (differ by 2):")
    let tp_output = ""
    let k = 0
    while3 k < len(primes) - 1
        if3 primes[k + 1] - primes[k] == 2
            let tp_output = tp_output + "(" + str(primes[k]) + "," + str(primes[k + 1]) + ") "
        end
        let k = k + 1
    end
    print(tp_output)

    print("\nTernary result: +1 (success)")
    let result = +1
fail3
    print("ERROR: Prime sieve failed")
    print("Ternary result: -1 (fail)")
    let result = -1
end

return result
