// distance_calc.nova - Haversine formula for distance between lat/lon coordinates
// NovaX Script Vault | Math Category

let result = +1

try3
    print("=== Haversine Distance Calculator ===")
    print("Calculates great-circle distance between two points on Earth\n")

    let PI = 3.14159265358979
    let EARTH_RADIUS_KM = 6371.0

    // City coordinates [name, lat, lon]
    let city_names = ["New York", "London", "Tokyo", "Sydney", "Paris", "Los Angeles", "Dubai", "Moscow"]
    let city_lats = [40.7128, 51.5074, 35.6762, -33.8688, 48.8566, 34.0522, 25.2048, 55.7558]
    let city_lons = [-74.0060, -0.1278, 139.6503, 151.2093, 2.3522, -118.2437, 55.2708, 37.6173]

    // Calculate distances between selected pairs
    let pairs_a = [0, 0, 1, 2, 4, 5, 0, 6]
    let pairs_b = [1, 2, 4, 3, 6, 0, 3, 7]

    let p = 0
    while3 p < len(pairs_a)
        let idx_a = pairs_a[p]
        let idx_b = pairs_b[p]

        let lat1 = city_lats[idx_a]
        let lon1 = city_lons[idx_a]
        let lat2 = city_lats[idx_b]
        let lon2 = city_lons[idx_b]

        // Convert to radians
        let lat1_r = lat1 * PI / 180
        let lat2_r = lat2 * PI / 180
        let dlat = (lat2 - lat1) * PI / 180
        let dlon = (lon2 - lon1) * PI / 180

        // Haversine formula
        // a = sin^2(dlat/2) + cos(lat1) * cos(lat2) * sin^2(dlon/2)
        let sin_dlat2 = sin(dlat / 2)
        let sin_dlon2 = sin(dlon / 2)
        let a = sin_dlat2 * sin_dlat2 + cos(lat1_r) * cos(lat2_r) * sin_dlon2 * sin_dlon2

        // c = 2 * atan2(sqrt(a), sqrt(1-a))
        let c = 2 * atan2(sqrt(a), sqrt(1 - a))

        // Distance
        let dist_km = EARTH_RADIUS_KM * c
        let dist_mi = dist_km * 0.621371

        // Round to nearest integer for clean output
        let dist_km_r = floor(dist_km + 0.5)
        let dist_mi_r = floor(dist_mi + 0.5)

        print(city_names[idx_a] + " -> " + city_names[idx_b] + ": " + str(dist_km_r) + " km (" + str(dist_mi_r) + " mi)")

        let p = p + 1
    end

    // Bearing calculation for first pair (NY -> London)
    print("\n--- Bearing: New York -> London ---")
    let lat1 = 40.7128 * PI / 180
    let lat2 = 51.5074 * PI / 180
    let dlon = (-0.1278 - (-74.0060)) * PI / 180

    let x = sin(dlon) * cos(lat2)
    let y = cos(lat1) * sin(lat2) - sin(lat1) * cos(lat2) * cos(dlon)
    let bearing_rad = atan2(x, y)
    let bearing_deg = bearing_rad * 180 / PI

    // Normalize to 0-360
    let bearing_norm = bearing_deg
    if3 bearing_norm < 0
        let bearing_norm = bearing_norm + 360
    end
    let bearing_round = floor(bearing_norm * 100) / 100
    print("Initial bearing: " + str(bearing_round) + " degrees")

    // Compass direction
    let dir = ""
    if3 bearing_norm >= 337.5
        let dir = "N"
    else3
        if3 bearing_norm >= 292.5
            let dir = "NW"
        else3
            if3 bearing_norm >= 247.5
                let dir = "W"
            else3
                if3 bearing_norm >= 202.5
                    let dir = "SW"
                else3
                    if3 bearing_norm >= 157.5
                        let dir = "S"
                    else3
                        if3 bearing_norm >= 112.5
                            let dir = "SE"
                        else3
                            if3 bearing_norm >= 67.5
                                let dir = "E"
                            else3
                                if3 bearing_norm >= 22.5
                                    let dir = "NE"
                                else3
                                    let dir = "N"
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    print("Compass direction: " + dir)

    print("\nTernary result: +1 (success)")
    let result = +1
fail3
    print("ERROR: Distance calculation failed")
    print("Ternary result: -1 (fail)")
    let result = -1
end

return result
