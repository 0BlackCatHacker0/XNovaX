// fibonacci.nova - Generate Fibonacci sequence up to N terms
// NovaX Script Vault | Math Category

let n = 20
let result = +1

try3
    print("=== Fibonacci Sequence Generator ===")
    print("Generating first " + str(n) + " Fibonacci numbers...")

    let seq = [0, 1]
    let i = 2
    while3 i < n
        let prev1 = seq[i - 1]
        let prev2 = seq[i - 2]
        let next_val = prev1 + prev2
        let seq = append(seq, next_val)
        let i = i + 1
    end

    // Print the sequence
    let output = ""
    let j = 0
    while3 j < len(seq)
        if3 j > 0
            let output = output + ", "
        end
        let output = output + str(seq[j])
        let j = j + 1
    end
    print("Sequence: " + output)

    // Golden ratio approximation from last two terms
    let last = seq[len(seq) - 1]
    let second_last = seq[len(seq) - 2]
    let phi = last / second_last
    print("Golden ratio approx (F[n]/F[n-1]): " + str(phi))
    print("Actual golden ratio: 1.6180339887...")

    // Sum of sequence
    let total = 0
    let k = 0
    while3 k < len(seq)
        let total = total + seq[k]
        let k = k + 1
    end
    print("Sum of sequence: " + str(total))

    print("\nTernary result: +1 (success)")
    let result = +1
fail3
    print("ERROR: Fibonacci generation failed")
    print("Ternary result: -1 (fail)")
    let result = -1
end

return result
