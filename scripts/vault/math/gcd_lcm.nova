// gcd_lcm.nova - Greatest common divisor and least common multiple
// NovaX Script Vault | Math Category

let result = +1

try3
    print("=== GCD & LCM Calculator ===")

    // Test pairs
    let a_vals = [12, 48, 100, 2187, 17, 243, 1071, 36, 0, 7]
    let b_vals = [8, 18, 75, 729, 13, 81, 462, 24, 5, 7]

    let i = 0
    while3 i < len(a_vals)
        let a = a_vals[i]
        let b = b_vals[i]

        // GCD using Euclidean algorithm
        let x = a
        let y = b

        // Handle zero cases
        if3 x == 0
            let gcd = y
        else3
            if3 y == 0
                let gcd = x
            else3
                while3 y > 0
                    let temp = y
                    let y = x % y
                    let x = temp
                end
                let gcd = x
            end
        end

        // LCM = (a * b) / gcd (avoid division by zero)
        let lcm = 0
        if3 gcd > 0
            let lcm = floor((a * b) / gcd)
        end

        // Verify: gcd * lcm should equal a * b
        let product = a * b
        let verify = gcd * lcm
        let check = ""
        if3 product == verify
            let check = " [verified]"
        else3
            let check = " [CHECK FAILED]"
        end

        print("gcd(" + str(a) + ", " + str(b) + ") = " + str(gcd) + "  |  lcm(" + str(a) + ", " + str(b) + ") = " + str(lcm) + check)
        let i = i + 1
    end

    // GCD of multiple numbers
    print("\n--- GCD of multiple numbers ---")
    let multi = [12, 18, 24, 36, 48]
    let multi_gcd = multi[0]
    let j = 1
    while3 j < len(multi)
        let x = multi_gcd
        let y = multi[j]
        while3 y > 0
            let temp = y
            let y = x % y
            let x = temp
        end
        let multi_gcd = x
        let j = j + 1
    end
    print("gcd(12, 18, 24, 36, 48) = " + str(multi_gcd))

    // LCM of multiple numbers
    print("\n--- LCM of multiple numbers ---")
    let multi2 = [3, 5, 7, 13]
    let multi_lcm = multi2[0]
    let k = 1
    while3 k < len(multi2)
        // GCD of current lcm and next number
        let x = multi_lcm
        let y = multi2[k]
        while3 y > 0
            let temp = y
            let y = x % y
            let x = temp
        end
        let pair_gcd = x
        let multi_lcm = floor((multi_lcm * multi2[k]) / pair_gcd)
        let k = k + 1
    end
    print("lcm(3, 5, 7, 13) = " + str(multi_lcm) + " (3-5-7-13 harmonic!)")

    // Coprime check
    print("\n--- Coprime pairs ---")
    let cp_a = [3, 7, 8, 14, 13]
    let cp_b = [7, 13, 15, 21, 169]
    let m = 0
    while3 m < len(cp_a)
        let x = cp_a[m]
        let y = cp_b[m]
        while3 y > 0
            let temp = y
            let y = x % y
            let x = temp
        end
        let coprime = x == 1
        let label = ""
        if3 coprime
            let label = "coprime"
        else3
            let label = "NOT coprime (gcd=" + str(x) + ")"
        end
        print(str(cp_a[m]) + " & " + str(cp_b[m]) + ": " + label)
        let m = m + 1
    end

    print("\nTernary result: +1 (success)")
    let result = +1
fail3
    print("ERROR: GCD/LCM calculation failed")
    print("Ternary result: -1 (fail)")
    let result = -1
end

return result
