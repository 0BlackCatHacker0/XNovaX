// NovaX Script Vault — network/network_info.nova
// Description: Shows all network adapters, IPs, MAC addresses
// Category: network | Trit: +1=success, 0=partial, -1=fail

print("=== NovaX Network Info ===")
print("")

// Get adapter details via ipconfig /all
let result = shell("ipconfig /all")
let out = dict_get(result, "stdout") ?? ""
let code = dict_get(result, "code") ?? 1

if3 code != 0
  print("Failed to run ipconfig")
  print("TRIT: -1 (command failed)")
else3
  let lines = split(out, "\n")
  let adapter_count = 0
  let current_adapter = ""

  for3 line in lines
    let l = trim(line)

    // Adapter headers end with ":"
    if3 contains(line, "adapter ")
      let current_adapter = l
      let adapter_count = adapter_count + 1
      print("")
      print("[Adapter " + str(adapter_count) + "] " + l)
    end3

    // Key fields
    if3 contains(l, "Physical Address")
      print("  MAC:      " + l)
    end3
    if3 contains(l, "IPv4 Address")
      print("  IPv4:     " + l)
    end3
    if3 contains(l, "IPv6 Address")
      print("  IPv6:     " + l)
    end3
    if3 contains(l, "Subnet Mask")
      print("  Subnet:   " + l)
    end3
    if3 contains(l, "Default Gateway")
      if3 len(l) > 20
        print("  Gateway:  " + l)
      end3
    end3
    if3 contains(l, "DHCP Enabled")
      print("  DHCP:     " + l)
    end3
    if3 contains(l, "DNS Servers")
      print("  DNS:      " + l)
    end3
  end3

  print("")
  print("--- Summary ---")
  print("Adapters found: " + str(adapter_count))

  if3 adapter_count > 0
    print("TRIT: +1 (network info retrieved)")
  else3
    print("TRIT: -1 (no adapters found)")
  end3
end3
