// NovaX Script Vault — network/connection_list.nova
// Description: Shows all active TCP connections (like netstat)
// Category: network | Trit: +1=success, 0=partial, -1=fail

print("=== NovaX Connection List ===")
print("")

let result = shell("netstat -an -p TCP")
let out = dict_get(result, "stdout") ?? ""
let code = dict_get(result, "code") ?? 1

if3 code != 0
  print("Failed to run netstat")
  print("Error: " + dict_get(result, "stderr") ?? "unknown")
  print("TRIT: -1 (command failed)")
else3
  let lines = split(out, "\n")
  let established = []
  let listening = []
  let time_wait = []
  let other = []
  let total = 0

  for3 line in lines
    let l = trim(line)
    if3 starts_with(l, "TCP")
      let total = total + 1
      if3 contains(l, "ESTABLISHED")
        let established = append(established, l)
      else3
        if3 contains(l, "LISTENING")
          let listening = append(listening, l)
        else3
          if3 contains(l, "TIME_WAIT")
            let time_wait = append(time_wait, l)
          else3
            let other = append(other, l)
          end3
        end3
      end3
    end3
  end3

  // Display ESTABLISHED connections
  print("--- ESTABLISHED (" + str(len(established)) + ") ---")
  for3 conn in established
    print("  " + conn)
  end3

  print("")
  print("--- LISTENING (" + str(len(listening)) + ") ---")
  for3 conn in listening
    print("  " + conn)
  end3

  if3 len(time_wait) > 0
    print("")
    print("--- TIME_WAIT (" + str(len(time_wait)) + ") ---")
    for3 conn in time_wait
      print("  " + conn)
    end3
  end3

  if3 len(other) > 0
    print("")
    print("--- OTHER (" + str(len(other)) + ") ---")
    for3 conn in other
      print("  " + conn)
    end3
  end3

  print("")
  print("--- Summary ---")
  print("Total TCP:    " + str(total))
  print("Established:  " + str(len(established)))
  print("Listening:    " + str(len(listening)))
  print("Time Wait:    " + str(len(time_wait)))
  print("Other:        " + str(len(other)))

  if3 total > 0
    print("TRIT: +1 (connections listed)")
  else3
    print("TRIT: 0 (no active connections)")
  end3
end3
