// NovaX Script Vault — network/geo_ip.nova
// Description: Gets WAN IP and geolocation data using free API
// Category: network | Trit: +1=success, 0=partial, -1=fail

print("=== NovaX GeoIP Lookup ===")
print("")

// Get WAN IP and geo data from ip-api.com (free, no key needed)
let result = shell("powershell -NoProfile -Command \"(Invoke-WebRequest -Uri 'http://ip-api.com/json/' -UseBasicParsing).Content\"")
let raw = trim(dict_get(result, "stdout") ?? "")
let code = dict_get(result, "code") ?? 1

if3 code != 0
  print("Failed to reach GeoIP API")
  print("Error: " + dict_get(result, "stderr") ?? "unknown")
  print("TRIT: -1 (API unreachable)")
else3
  let data = json_decode(raw)
  let status = dict_get(data, "status") ?? "fail"

  if3 status == "success"
    let ip = dict_get(data, "query") ?? "unknown"
    let country = dict_get(data, "country") ?? "unknown"
    let region = dict_get(data, "regionName") ?? "unknown"
    let city = dict_get(data, "city") ?? "unknown"
    let zip_code = dict_get(data, "zip") ?? "unknown"
    let lat = dict_get(data, "lat") ?? "unknown"
    let lon = dict_get(data, "lon") ?? "unknown"
    let isp = dict_get(data, "isp") ?? "unknown"
    let org = dict_get(data, "org") ?? "unknown"
    let as_info = dict_get(data, "as") ?? "unknown"
    let tz = dict_get(data, "timezone") ?? "unknown"

    print("--- WAN IP ---")
    print("  IP:       " + str(ip))
    print("")
    print("--- Location ---")
    print("  Country:  " + str(country))
    print("  Region:   " + str(region))
    print("  City:     " + str(city))
    print("  ZIP:      " + str(zip_code))
    print("  Lat/Lon:  " + str(lat) + ", " + str(lon))
    print("  Timezone: " + str(tz))
    print("")
    print("--- ISP ---")
    print("  ISP:      " + str(isp))
    print("  Org:      " + str(org))
    print("  AS:       " + str(as_info))
    print("")
    print("TRIT: +1 (geolocation retrieved)")
  else3
    print("API returned failure status")
    print("TRIT: -1 (API error)")
  end3
end3
