// NovaX Script Vault — network/speed_test.nova
// Description: Simple bandwidth test by downloading a known file and timing it
// Category: network | Trit: +1=success, 0=partial, -1=fail

print("=== NovaX Speed Test ===")
print("")

// Use a known test file (~10MB from speed test servers)
let test_url = "http://speedtest.tele2.net/1MB.zip"
let test_file = "C:\\NovaX\\temp\\speedtest_temp.bin"
let file_size_bytes = 1048576
let file_size_mb = 1.0

print("Test file: 1MB from speedtest.tele2.net")
print("Downloading...")
print("")

// Time the download using PowerShell
let cmd = "powershell -NoProfile -Command \"$sw = [System.Diagnostics.Stopwatch]::StartNew(); try { Invoke-WebRequest -Uri '" + test_url + "' -OutFile '" + test_file + "' -UseBasicParsing -TimeoutSec 30; $sw.Stop(); Write-Output $sw.ElapsedMilliseconds } catch { $sw.Stop(); Write-Output 'FAIL' }\""
let result = shell(cmd)
let out = trim(dict_get(result, "stdout") ?? "FAIL")

if3 out == "FAIL"
  print("Download failed — check internet connection")
  print("Error: " + dict_get(result, "stderr") ?? "unknown")
  print("TRIT: -1 (speed test failed)")
else3
  let elapsed_ms = to_num(out)

  if3 elapsed_ms > 0
    let elapsed_sec = elapsed_ms / 1000.0
    let speed_mbps = (file_size_mb * 8.0) / elapsed_sec
    let speed_kbps = speed_mbps * 1000.0

    print("--- Download Results ---")
    print("  File size:  " + str(file_size_mb) + " MB")
    print("  Time:       " + str(elapsed_ms) + " ms (" + str(round(elapsed_sec, 2)) + " sec)")
    print("  Speed:      " + str(round(speed_mbps, 2)) + " Mbps")
    print("  Throughput: " + str(round(speed_kbps, 0)) + " Kbps")
    print("")

    // Cleanup temp file
    let cleanup = shell("del \"" + test_file + "\" 2>nul")

    // Rate the connection
    if3 speed_mbps > 50
      print("Rating: Excellent")
      print("TRIT: +1 (fast connection)")
    else3
      if3 speed_mbps > 10
        print("Rating: Good")
        print("TRIT: +1 (decent connection)")
      else3
        if3 speed_mbps > 1
          print("Rating: Slow")
          print("TRIT: 0 (slow connection)")
        else3
          print("Rating: Very Slow")
          print("TRIT: -1 (poor connection)")
        end3
      end3
    end3
  else3
    print("Invalid timing result")
    print("TRIT: -1 (measurement error)")
  end3
end3
