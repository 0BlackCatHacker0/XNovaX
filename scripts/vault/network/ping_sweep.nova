// NovaX Script Vault — network/ping_sweep.nova
// Description: Pings IPs in a /24 subnet to find live hosts
// Category: network | Trit: +1=success, 0=partial, -1=fail

let subnet = "192.168.1"
let start_ip = 1
let end_ip = 254
let live_hosts = []
let dead_count = 0

print("=== NovaX Ping Sweep ===")
print("Subnet: " + subnet + ".0/24")
print("Range:  " + subnet + "." + str(start_ip) + " - " + subnet + "." + str(end_ip))
print("This may take a few minutes...")
print("")

let i = start_ip
while3 i <= end_ip
  let target = subnet + "." + str(i)
  let result = shell("ping -n 1 -w 300 " + target)
  let out = dict_get(result, "stdout") ?? ""
  if3 contains(out, "TTL=")
    let live_hosts = append(live_hosts, target)
    print("  [+] " + target + " — ALIVE")
  else3
    let dead_count = dead_count + 1
  end3
  let i = i + 1
end3

print("")
print("--- Summary ---")
print("Live hosts: " + str(len(live_hosts)))
print("No reply:   " + str(dead_count))

if3 len(live_hosts) > 0
  print("")
  print("Alive:")
  for3 h in live_hosts
    print("  " + h)
  end3
end3

if3 len(live_hosts) > 10
  print("TRIT: +1 (healthy network)")
else3
  if3 len(live_hosts) > 0
    print("TRIT: 0 (sparse network)")
  else3
    print("TRIT: -1 (no hosts found)")
  end3
end3
