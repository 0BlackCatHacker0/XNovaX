// NovaX Script Vault — network/http_check.nova
// Description: Checks if a list of URLs are responding (200 OK)
// Category: network | Trit: +1=success, 0=partial, -1=fail

let urls = [
  "https://www.google.com",
  "https://www.github.com",
  "https://www.cloudflare.com",
  "https://httpbin.org/status/200",
  "http://127.0.0.1:9999/health"
]

let up_list = []
let down_list = []

print("=== NovaX HTTP Health Check ===")
print("Checking " + str(len(urls)) + " endpoints...")
print("")

for3 url in urls
  let cmd = "powershell -NoProfile -Command \"try { $r = Invoke-WebRequest -Uri '" + url + "' -Method HEAD -TimeoutSec 5 -UseBasicParsing -ErrorAction Stop; Write-Output $r.StatusCode } catch { Write-Output 'FAIL' }\""
  let result = shell(cmd)
  let out = trim(dict_get(result, "stdout") ?? "FAIL")

  if3 out == "200"
    let up_list = append(up_list, url)
    print("  [+] 200 OK  — " + url)
  else3
    if3 out == "FAIL"
      let down_list = append(down_list, url)
      print("  [-] DOWN    — " + url)
    else3
      // Non-200 but responded
      let up_list = append(up_list, url)
      print("  [~] " + out + "     — " + url)
    end3
  end3
end3

print("")
print("--- Summary ---")
print("Up:   " + str(len(up_list)) + "/" + str(len(urls)))
print("Down: " + str(len(down_list)) + "/" + str(len(urls)))

if3 len(down_list) > 0
  print("")
  print("Failed endpoints:")
  for3 d in down_list
    print("  " + d)
  end3
end3

print("")
if3 len(down_list) == 0
  print("TRIT: +1 (all endpoints responding)")
else3
  if3 len(up_list) > 0
    print("TRIT: 0 (partial — some endpoints down)")
  else3
    print("TRIT: -1 (all endpoints down)")
  end3
end3
