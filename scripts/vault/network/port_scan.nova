// NovaX Script Vault — network/port_scan.nova
// Description: Scans a host for common open ports using PowerShell TCP test
// Category: network | Trit: +1=success, 0=partial, -1=fail

let host = "127.0.0.1"
let ports = [21, 22, 80, 443, 3306, 5432, 8080, 9999]
let open_ports = []
let closed_ports = []
let errors = []

print("=== NovaX Port Scanner ===")
print("Target: " + host)
print("Scanning " + str(len(ports)) + " common ports...")
print("")

for3 p in ports
  let cmd = "powershell -NoProfile -Command \"try { $c = New-Object System.Net.Sockets.TcpClient; $r = $c.BeginConnect('" + host + "', " + str(p) + ", $null, $null); $w = $r.AsyncWaitHandle.WaitOne(500, $false); if($w -and !$c.Client.Connected -eq $false) { Write-Output 'OPEN' } else { Write-Output 'CLOSED' }; $c.Close() } catch { Write-Output 'CLOSED' }\""
  let result = shell(cmd)
  let out = trim(dict_get(result, "stdout") ?? "")
  if3 contains(out, "OPEN")
    let open_ports = append(open_ports, p)
    print("  [+] Port " + str(p) + " — OPEN")
  else3
    let closed_ports = append(closed_ports, p)
    print("  [-] Port " + str(p) + " — closed")
  end3
end3

print("")
print("--- Summary ---")
print("Open:   " + str(len(open_ports)))
print("Closed: " + str(len(closed_ports)))

if3 len(open_ports) > 0
  print("")
  print("Open ports: " + join(open_ports, ", "))
end3

// Ternary result
if3 len(open_ports) == len(ports)
  print("TRIT: +1 (all ports open)")
else3
  if3 len(open_ports) > 0
    print("TRIT: 0 (some ports open)")
  else3
    print("TRIT: -1 (no open ports found)")
  end3
end3
