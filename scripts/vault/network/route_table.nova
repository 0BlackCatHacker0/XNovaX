// NovaX Script Vault — network/route_table.nova
// Description: Displays the system routing table
// Category: network | Trit: +1=success, 0=partial, -1=fail

print("=== NovaX Route Table ===")
print("")

let result = shell("route print")
let out = dict_get(result, "stdout") ?? ""
let code = dict_get(result, "code") ?? 1

if3 code != 0
  print("Failed to retrieve routing table")
  print("Error: " + dict_get(result, "stderr") ?? "unknown")
  print("TRIT: -1 (command failed)")
else3
  let lines = split(out, "\n")
  let route_count = 0
  let section = ""
  let ipv4_routes = []
  let ipv6_routes = []
  let in_ipv4 = 0
  let in_ipv6 = 0
  let in_iface = 0

  // Parse and display interface list + routes
  for3 line in lines
    let l = trim(line)

    if3 contains(l, "Interface List")
      let section = "iface"
      let in_iface = 1
      print("--- Interface List ---")
    end3

    if3 contains(l, "IPv4 Route Table")
      let section = "ipv4"
      let in_iface = 0
      let in_ipv4 = 1
      print("")
      print("--- IPv4 Routes ---")
    end3

    if3 contains(l, "IPv6 Route Table")
      let section = "ipv6"
      let in_ipv4 = 0
      let in_ipv6 = 1
      print("")
      print("--- IPv6 Routes ---")
    end3

    // Print content lines
    if3 len(l) > 0
      if3 in_iface == 1
        if3 contains(l, "...")
          print("  " + l)
        end3
      end3

      if3 in_ipv4 == 1
        if3 contains(l, ".")
          if3 contains(l, "Network") == 0
            let route_count = route_count + 1
          end3
          print("  " + l)
        end3
      end3

      if3 in_ipv6 == 1
        if3 len(l) > 5
          print("  " + l)
        end3
      end3
    end3
  end3

  print("")
  print("--- Summary ---")
  print("IPv4 route entries: ~" + str(route_count))

  // Get default gateway
  let gw = shell("powershell -NoProfile -Command \"(Get-NetRoute -DestinationPrefix '0.0.0.0/0' -ErrorAction SilentlyContinue | Select-Object -First 1).NextHop\"")
  let gw_out = trim(dict_get(gw, "stdout") ?? "")
  if3 len(gw_out) > 0
    print("Default gateway: " + gw_out)
  end3

  if3 route_count > 0
    print("TRIT: +1 (routing table retrieved)")
  else3
    print("TRIT: 0 (table retrieved but no routes parsed)")
  end3
end3
