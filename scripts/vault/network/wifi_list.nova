// NovaX Script Vault — network/wifi_list.nova
// Description: Lists available WiFi networks with signal strength
// Category: network | Trit: +1=success, 0=partial, -1=fail

print("=== NovaX WiFi Scanner ===")
print("")

let result = shell("netsh wlan show networks mode=bssid")
let out = dict_get(result, "stdout") ?? ""
let code = dict_get(result, "code") ?? 1

if3 code != 0
  print("Failed to scan WiFi networks")
  print("Error: " + dict_get(result, "stderr") ?? "unknown")
  print("(WiFi adapter may not be available)")
  print("TRIT: -1 (scan failed)")
else3
  let lines = split(out, "\n")
  let networks = []
  let current_ssid = ""
  let current_signal = ""
  let current_auth = ""
  let current_channel = ""

  for3 line in lines
    let l = trim(line)

    if3 starts_with(l, "SSID")
      if3 contains(l, "BSSID")
        // skip BSSID lines
      else3
        // Save previous network if exists
        if3 len(current_ssid) > 0
          let entry = current_signal + " | " + current_ssid + " | " + current_auth
          let networks = append(networks, entry)
        end3
        let parts = split(l, ":")
        if3 len(parts) > 1
          let current_ssid = trim(dict_get(parts, 1) ?? "")
        end3
        let current_signal = ""
        let current_auth = ""
        let current_channel = ""
      end3
    end3

    if3 starts_with(l, "Signal")
      let parts = split(l, ":")
      if3 len(parts) > 1
        let current_signal = trim(dict_get(parts, 1) ?? "")
      end3
    end3

    if3 starts_with(l, "Authentication")
      let parts = split(l, ":")
      if3 len(parts) > 1
        let current_auth = trim(dict_get(parts, 1) ?? "")
      end3
    end3

    if3 starts_with(l, "Channel")
      let parts = split(l, ":")
      if3 len(parts) > 1
        let current_channel = trim(dict_get(parts, 1) ?? "")
      end3
    end3
  end3

  // Capture last network
  if3 len(current_ssid) > 0
    let entry = current_signal + " | " + current_ssid + " | " + current_auth
    let networks = append(networks, entry)
  end3

  // Display
  print("Signal  | SSID                 | Auth")
  print("--------|----------------------|----------")
  for3 net in networks
    print("  " + net)
  end3

  print("")
  print("--- Summary ---")
  print("Networks found: " + str(len(networks)))

  if3 len(networks) > 0
    print("TRIT: +1 (WiFi scan complete)")
  else3
    print("TRIT: 0 (no networks found)")
  end3
end3
