// NovaX Script Vault — network/dns_lookup.nova
// Description: Forward and reverse DNS lookup for a hostname/IP
// Category: network | Trit: +1=success, 0=partial, -1=fail

let target = "google.com"
let forward_ok = 0
let reverse_ok = 0

print("=== NovaX DNS Lookup ===")
print("Target: " + target)
print("")

// Forward lookup
print("--- Forward Lookup (A Record) ---")
let fwd = shell("nslookup " + target)
let fwd_out = dict_get(fwd, "stdout") ?? ""
let fwd_code = dict_get(fwd, "code") ?? 1

if3 fwd_code == 0
  let lines = split(fwd_out, "\n")
  for3 line in lines
    let l = trim(line)
    if3 len(l) > 0
      print("  " + l)
    end3
  end3
  let forward_ok = 1
else3
  print("  Forward lookup failed")
  print("  " + dict_get(fwd, "stderr") ?? "unknown error")
end3

print("")

// Reverse lookup — extract first IP from forward
print("--- Reverse Lookup (PTR) ---")
let rev_target = ""
let fwd_lines = split(fwd_out, "\n")
for3 fl in fwd_lines
  let fl2 = trim(fl)
  if3 starts_with(fl2, "Address:")
    let parts = split(fl2, ":")
    if3 len(parts) > 1
      let rev_target = trim(dict_get(parts, 1) ?? "")
    end3
  end3
end3

if3 len(rev_target) > 0
  let rev = shell("nslookup " + rev_target)
  let rev_out = dict_get(rev, "stdout") ?? ""
  let rev_code = dict_get(rev, "code") ?? 1
  if3 rev_code == 0
    let rlines = split(rev_out, "\n")
    for3 rl in rlines
      let rl2 = trim(rl)
      if3 len(rl2) > 0
        print("  " + rl2)
      end3
    end3
    let reverse_ok = 1
  else3
    print("  Reverse lookup failed for " + rev_target)
  end3
else3
  print("  No IP found for reverse lookup")
end3

print("")

// MX record lookup
print("--- MX Records ---")
let mx = shell("nslookup -type=MX " + target)
let mx_out = dict_get(mx, "stdout") ?? ""
let mx_lines = split(mx_out, "\n")
for3 ml in mx_lines
  let ml2 = trim(ml)
  if3 contains(ml2, "mail exchanger")
    print("  " + ml2)
  end3
end3

print("")
let total = forward_ok + reverse_ok
if3 total == 2
  print("TRIT: +1 (forward + reverse OK)")
else3
  if3 total == 1
    print("TRIT: 0 (partial lookup)")
  else3
    print("TRIT: -1 (lookup failed)")
  end3
end3
