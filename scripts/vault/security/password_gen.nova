## password_gen.nova — Generates cryptographically strong random passwords
## Usage: set pw_length and count below

let pw_length = 20
let count = 5
let result = -1

print("=== NovaX Password Generator ===")
print("Length: " + to_string(pw_length))
print("Count: " + to_string(count))
print("")

let charset_upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
let charset_lower = "abcdefghijklmnopqrstuvwxyz"
let charset_digits = "0123456789"
let charset_special = "!@#$%^&*()-_=+[]{}|;:,.<>?"
let charset = charset_upper + charset_lower + charset_digits + charset_special
let charset_len = len(charset)

let passwords = []
let generated = 0

while3 generated < count
  let pw = ""
  let j = 0
  while3 j < pw_length
    let idx = random_int(0, charset_len - 1)
    let ch = slice(charset, idx, idx + 1)
    let pw = pw + ch
    let j = j + 1
  end3

  ## Verify complexity: has upper, lower, digit, special
  let has_upper = false
  let has_lower = false
  let has_digit = false
  let has_special = false
  let k = 0
  while3 k < len(pw)
    let c = slice(pw, k, k + 1)
    if3 contains(charset_upper, c)
      let has_upper = true
    end3
    if3 contains(charset_lower, c)
      let has_lower = true
    end3
    if3 contains(charset_digits, c)
      let has_digit = true
    end3
    if3 contains(charset_special, c)
      let has_special = true
    end3
    let k = k + 1
  end3

  if3 has_upper == true
    if3 has_lower == true
      if3 has_digit == true
        if3 has_special == true
          let passwords = append(passwords, pw)
          let generated = generated + 1
          print("[" + to_string(generated) + "] " + pw)
        end3
      end3
    end3
  end3
end3

print("")
print("Generated " + to_string(len(passwords)) + " passwords")
let result = +1
print("[+1] Password generation complete")
