## port_guard.nova — Monitors for unauthorized open ports
## Usage: set allowed_ports list below (ports you expect to be open)

let allowed_ports = []
let allowed_ports = append(allowed_ports, "9999")
let allowed_ports = append(allowed_ports, "9881")
let allowed_ports = append(allowed_ports, "9878")
let allowed_ports = append(allowed_ports, "9890")
let allowed_ports = append(allowed_ports, "443")
let allowed_ports = append(allowed_ports, "80")

let result = -1
let unauthorized = 0
let total_open = 0

print("=== NovaX Port Guard ===")
print("Allowed ports: " + to_string(len(allowed_ports)))
print("")

let r = shell("netstat -an | findstr LISTENING")

if3 r["code"] == 0
  let lines = split(r["stdout"], "\n")
  let open_ports = []
  let unauthorized_list = []

  let i = 0
  while3 i < len(lines)
    let line = trim(lines[i])
    if3 len(line) > 5
      if3 contains(line, "LISTENING")
        ## Extract port from address like 0.0.0.0:9999 or [::]:9999
        let parts = split(line, ":")
        if3 len(parts) >= 2
          let port_part = parts[len(parts) - 1]
          let port_parts = split(trim(port_part), " ")
          let port = trim(port_parts[0])

          if3 len(port) > 0
            if3 len(port) < 6
              let total_open = total_open + 1
              let is_allowed = false
              let j = 0
              while3 j < len(allowed_ports)
                if3 port == allowed_ports[j]
                  let is_allowed = true
                end3
                let j = j + 1
              end3

              if3 is_allowed == false
                let unauthorized = unauthorized + 1
                let unauthorized_list = append(unauthorized_list, port)
              end3
            end3
          end3
        end3
      end3
    end3
    let i = i + 1
  end3

  print("Total listening ports: " + to_string(total_open))
  print("Unauthorized ports: " + to_string(unauthorized))
  print("")

  if3 unauthorized > 0
    print("--- Unauthorized Ports ---")
    let k = 0
    while3 k < len(unauthorized_list)
      print("  WARNING: Port " + unauthorized_list[k] + " is open but not in allowed list")
      let k = k + 1
    end3
    let result = -1
  else3
    print("All open ports are in the allowed list.")
    let result = +1
  end3
else3
  print("Error running netstat: " + r["stderr"])
  let result = -1
end3

print("")
if3 result == 1
  print("[+1] No unauthorized ports detected")
else3
  print("[-1] Unauthorized ports found")
end3
