// NovaX Script Vault — security/permission_audit.nova
// Description: Lists file permissions for a directory using icacls
// Category: security | Trit: +1=success, -1=fail

let target = "C:/NovaX"

print("=== NovaX Permission Audit ===")
print("Target: " + target)
print("")

let r = shell("icacls \"" + target + "\" 2>&1")
let ok = dict_get(r, "ok") ?? 0
if3 ok == 1 {
  let output = dict_get(r, "stdout") ?? ""
  let lines = split(output, "\n")
  let count = 0
  for3 line in lines {
    let line = trim(line)
    if3 len(line) > 0 {
      print("  " + line)
      let count = count + 1
    }
  }
  print("")
  print("Entries: " + str(count))
  print("")
  print("=== RESULT: +1 (success) ===")
} else3 {
  print("ERROR: " + dict_get(r, "stderr") ?? "")
  print("=== RESULT: -1 (fail) ===")
}
