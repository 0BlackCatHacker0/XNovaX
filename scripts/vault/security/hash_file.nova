## hash_file.nova — Computes MD5, SHA1, SHA256 of a file
## Usage: set target_file below

let target_file = "C:\\NovaX\\core\\orchestrator.py"
let result = -1

print("=== NovaX File Hasher ===")
print("File: " + target_file)
print("")

## Check file exists via dir
let check_cmd = "dir /b \"" + target_file + "\" 2>nul"
let check_r = shell(check_cmd)

if3 check_r["ok"] != 1
  print("Error: File not found")
else3
  ## Get file size
  let size_cmd = "for %I in (\"" + target_file + "\") do @echo %~zI"
  let size_r = shell(size_cmd)
  let sz = trim(dict_get(size_r, "stdout") ?? "0")

  ## Compute hashes with certutil
  let algos = ["MD5", "SHA1", "SHA256"]
  let labels = ["MD5:    ", "SHA1:   ", "SHA256: "]
  let all_ok = 1

  try3
    let ai = 0
    while3 ai < len(algos)
      let algo = algos[ai]
      let cmd = "certutil -hashfile \"" + target_file + "\" " + algo
      let r = shell(cmd)
      if3 r["code"] == 0
        let lines = split(trim(r["stdout"]), "\n")
        if3 len(lines) >= 2
          let hash_val = trim(replace(lines[1], " ", ""))
          if3 ai == 0
            print("Size:   " + sz + " bytes")
          print(labels[ai] + hash_val)
        else3
          print(labels[ai] + "ERROR")
          let all_ok = 0
      else3
        print(labels[ai] + "ERROR")
        let all_ok = 0
      let ai = ai + 1
    end3

    if3 all_ok == 1
      let result = +1
    end3

  fail3 err
    print("ERROR: " + to_string(err))
  end3
end3

print("")
if3 result == 1
  print("[+1] Hashes computed successfully")
else3
  print("[-1] Hash computation failed")
end3
