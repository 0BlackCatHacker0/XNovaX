## firewall_rules.nova — Lists all Windows firewall rules
## Usage: set filter_direction and filter_enabled below

let filter_direction = "both"
let filter_enabled = "yes"
let max_rules = 50
let result = -1

print("=== NovaX Firewall Rules Inspector ===")
print("Direction filter: " + filter_direction)
print("Enabled filter: " + filter_enabled)
print("Max rules: " + to_string(max_rules))
print("")

let ps_cmd = "powershell -NoProfile -Command \""
let ps_cmd = ps_cmd + "$rules = Get-NetFirewallRule"
if3 filter_enabled == "yes"
  let ps_cmd = ps_cmd + " -Enabled True"
end3
let ps_cmd = ps_cmd + " | Select-Object -First " + to_string(max_rules)
if3 filter_direction == "in"
  let ps_cmd = ps_cmd + " | Where-Object { $_.Direction -eq 'Inbound' }"
else3 filter_direction == "out"
  let ps_cmd = ps_cmd + " | Where-Object { $_.Direction -eq 'Outbound' }"
end3
let ps_cmd = ps_cmd + " | ForEach-Object { @{name=$_.DisplayName; dir=$_.Direction.ToString(); action=$_.Action.ToString(); profile=$_.Profile.ToString(); enabled=$_.Enabled.ToString()} };"
let ps_cmd = ps_cmd + " ConvertTo-Json @($rules)\""

try3
  let r = shell(ps_cmd)

  if3 r["code"] == 0
    let out = trim(r["stdout"])
    if3 len(out) > 5
      let rules = json_decode(out)
      let in_count = 0
      let out_count = 0
      let allow_count = 0
      let block_count = 0

      let i = 0
      while3 i < len(rules)
        let rule = rules[i]
        let name = dict_get(rule, "name") ?? "unnamed"
        let dir = dict_get(rule, "dir") ?? "?"
        let action = dict_get(rule, "action") ?? "?"
        let profile = dict_get(rule, "profile") ?? "?"

        let icon = " "
        if3 action == "Allow"
          let icon = "+"
          let allow_count = allow_count + 1
        else3
          let icon = "X"
          let block_count = block_count + 1
        end3

        if3 dir == "Inbound"
          let in_count = in_count + 1
        else3
          let out_count = out_count + 1
        end3

        print("[" + icon + "] " + dir + " | " + action + " | " + name)
        let i = i + 1
      end3

      print("")
      print("Total: " + to_string(len(rules)) + " rules")
      print("Inbound: " + to_string(in_count) + " | Outbound: " + to_string(out_count))
      print("Allow: " + to_string(allow_count) + " | Block: " + to_string(block_count))
      let result = +1
    else3
      print("No firewall rules found matching filter.")
      let result = 0
    end3
  else3
    print("Error: " + r["stderr"])
  end3

fail3 err
  print("ERROR: " + to_string(err))
end3

print("")
if3 result == 1
  print("[+1] Firewall rules listed successfully")
else3 result == 0
  print("[0] No rules matched filter")
else3
  print("[-1] Failed to list firewall rules")
end3
