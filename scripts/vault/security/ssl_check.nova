## ssl_check.nova — Checks SSL certificate expiry and details for a domain
## Usage: set domain below

let domain = "google.com"
let result = -1

print("=== NovaX SSL Certificate Checker ===")
print("Domain: " + domain)
print("")

## Use curl -vI to get SSL cert info
let cmd = "curl -vI https://" + domain + " 2>&1"

try3
  let r = shell(cmd)

  if3 r["code"] == 0 || r["ok"] == 1
    let output = dict_get(r, "stdout") ?? "" + dict_get(r, "stderr") ?? ""

    ## Parse subject
    let cn = ""
    let lines = split(output, "\n")
    let issuer_line = ""
    let expire_line = ""
    let start_line = ""
    let li = 0
    while3 li < len(lines)
      let line = trim(lines[li])
      if3 contains(line, "subject:")
        let cn = line
      if3 contains(line, "issuer:")
        let issuer_line = line
      if3 contains(line, "expire date:")
        let expire_line = line
      if3 contains(line, "start date:")
        let start_line = line
      let li = li + 1
    end3

    print("Subject:       " + cn)
    print("Issuer:        " + issuer_line)
    print("Valid From:    " + start_line)
    print("Valid Until:   " + expire_line)

    ## Check HTTP status to confirm SSL works
    let status_cmd = "curl -s -o nul -w \"%{http_code}\" https://" + domain
    let sr = shell(status_cmd)
    let status = trim(dict_get(sr, "stdout") ?? "0")

    print("HTTP Status:   " + status)
    print("")

    if3 cn != ""
      print("Status: SSL connection established")
      let result = +1
    else3
      print("Status: Could not parse certificate details")
      let result = 0
    end3
  else3
    print("Error: " + dict_get(r, "stderr") ?? "Connection failed")
  end3

fail3 err
  print("ERROR: " + to_string(err))
end3

print("")
if3 result == 1
  print("[+1] SSL certificate valid")
else3 result == 0
  print("[0] SSL certificate details incomplete")
else3
  print("[-1] SSL check failed or certificate expired")
end3
