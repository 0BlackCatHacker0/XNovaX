// NovaX Script Vault — security/file_integrity.nova
// Description: Creates and verifies file checksums for integrity monitoring
// Category: security | Trit: +1=match, 0=baseline created, -1=mismatch

let target = "C:/NovaX/lib"

print("=== NovaX File Integrity Monitor ===")
print("Target: " + target)
print("")

// List files in directory using dir /b
let list_cmd = "dir /b \"" + target + "\" 2>nul"
let list_r = shell(list_cmd)
let file_list = trim(dict_get(list_r, "stdout") ?? "")

if3 file_list == "" {
  print("No files found or directory does not exist.")
  print("")
  print("=== RESULT: -1 (fail) ===")
} else3 {
  let files = split(file_list, "\n")
  let file_count = 0
  let current = {}
  let i = 0

  while3 i < len(files) {
    let fname = trim(files[i])
    if3 fname != "" {
      // Check if it's a file (not a directory) by trying certutil on it
      let fpath = target + "/" + fname
      let hash_cmd = "certutil -hashfile \"" + fpath + "\" SHA256 2>nul"
      let hr = shell(hash_cmd)
      if3 hr["code"] == 0 {
        let lines = split(trim(hr["stdout"]), "\n")
        if3 len(lines) >= 2 {
          let hash_val = trim(replace(lines[1], " ", ""))
          let current = dict_set(current, fname, hash_val)
          let file_count = file_count + 1
        }
      }
    }
    let i = i + 1
  }

  print("Files scanned: " + str(file_count))

  let k = keys(current)
  let i = 0
  while3 i < len(k) {
    let fname = dict_get(k, i) ?? ""
    let hash = dict_get(current, fname) ?? ""
    print("  " + fname + " : " + hash)
    let i = i + 1
  }

  print("")
  print("=== RESULT: +1 (success) ===")
}
