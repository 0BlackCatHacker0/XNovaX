## http_headers.nova — Fetches and displays all HTTP response headers for a URL
## Usage: set target_url below

let target_url = "https://httpbin.org/response-headers?Content-Type=application/json"
let result = -1

print("=== NovaX HTTP Header Inspector ===")
print("URL: " + target_url)
print("")

## Use curl -I to fetch headers
let cmd = "curl -s -I -L --max-time 10 -A \"NovaX-HeaderInspector/1.0\" \"" + target_url + "\""

try3
  let r = shell(cmd)

  if3 r["code"] == 0
    let output = trim(r["stdout"])
    if3 output == ""
      print("Error: No response received")
      let result = -1
    else3
      let lines = split(output, "\n")

      ## First line is status
      let status_line = trim(lines[0])
      ## Extract status code from "HTTP/x.x CODE ..."
      let status = "unknown"
      if3 contains(status_line, " ")
        let parts = split(status_line, " ")
        if3 len(parts) >= 2
          let status = parts[1]

      print("Status: " + status)
      print("")
      print("--- Response Headers ---")

      let hdr_count = 0
      let i = 1
      while3 i < len(lines)
        let line = trim(lines[i])
        if3 line != "" && contains(line, ":")
          print("  " + line)
          let hdr_count = hdr_count + 1
        let i = i + 1
      end3

      print("")
      print("Total headers: " + to_string(hdr_count))
      let result = +1
    end3
  else3
    print("Error: " + r["stderr"])
    let result = -1
  end3

fail3 err
  print("ERROR: " + to_string(err))
  let result = -1
end3

print("")
if3 result == 1
  print("[+1] Headers fetched successfully")
else3
  print("[-1] Header fetch failed")
end3
