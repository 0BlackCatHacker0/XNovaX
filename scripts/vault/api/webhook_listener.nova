// NovaX Script Vault — api/webhook_listener.nova
// Description: Starts a simple HTTP server to catch webhooks
// Category: api | Trit: +1=webhooks caught, 0=none received, -1=fail
// 100% PURE NOVALANG — uses native tserve(), zero external dependencies

let port = dict_get(args, "port") ?? "8765"
let log_file = "C:/NovaX/scripts/vault/api/webhook_log.txt"

print("=== NovaX Webhook Listener ===")
print("Port: " + port)
print("Log: " + log_file)
print("")

// Webhook storage (in-memory)
let _webhook_log = []
let _webhook_count = 0

fn handle_webhook_post(req) {
    let body = try3 { json_decode(req["body"]) } { req["body"] }
    let path = dict_get(req, "path") ?? "/"
    let entry = {
        "time": str(_webhook_count + 1),
        "path": path,
        "body": body
    }
    _webhook_log = append(_webhook_log, entry)
    _webhook_count = _webhook_count + 1
    print("WEBHOOK #" + str(_webhook_count) + ": " + path)
    return {"ok": true, "trit": 1, "received": _webhook_count}
}

fn handle_webhook_get(req) {
    return {"ok": true, "trit": 1, "webhooks": _webhook_log, "count": len(_webhook_log)}
}

fn handle_webhook_health(req) {
    return {"status": "listening", "trit": 1, "webhooks_caught": len(_webhook_log)}
}

fn handle_webhook_save(req) {
    write_file(log_file, json_encode(_webhook_log))
    return {"ok": true, "saved": log_file, "count": len(_webhook_log)}
}

// Pure NovaLang HTTP server — no Python http.server
let wh_port = try3 { to_int(port) } { 8765 }
let server = tserve(wh_port, "nova-webhook-listener")

troute(server, "POST", "/webhook",  "handle_webhook_post")
troute(server, "POST", "/",         "handle_webhook_post")
troute(server, "GET",  "/webhooks", "handle_webhook_get")
troute(server, "GET",  "/health",   "handle_webhook_health")
troute(server, "POST", "/save",     "handle_webhook_save")

print("[+1] Webhook listener started on :" + port)
print("  POST /webhook  — receive webhooks")
print("  GET  /webhooks — list all caught webhooks")
print("  POST /save     — save log to file")
tstart(server)
