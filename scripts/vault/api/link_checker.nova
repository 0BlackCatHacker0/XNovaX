// NovaX Script Vault — api/link_checker.nova
// Description: Checks a list of URLs for broken links
// Category: api | Trit: +1=all good, 0=some broken, -1=all broken

let urls = ["https://www.google.com", "https://github.com", "https://httpbin.org/status/200"]

print("=== NovaX Link Checker ===")
print("Checking " + str(len(urls)) + " URLs...")
print("")

let good = 0
let bad = 0

for3 url in urls {
  let cmd = "curl -o nul -s -w \"%{http_code}\" --max-time 10 \"" + url + "\""
  let r = shell(cmd)
  let status = trim(dict_get(r, "stdout") ?? "0")
  if3 status == "200" || status == "301" || status == "302" {
    print("  [OK]   " + url + " (" + status + ")")
    let good = good + 1
  } else3 {
    print("  [FAIL] " + url + " — " + status)
    let bad = bad + 1
  }
}

print("")
print("OK: " + str(good) + " | Broken: " + str(bad))
print("")

if3 bad == 0 {
  print("=== RESULT: +1 (all OK) ===")
} else3 {
  if3 good > 0 {
    print("=== RESULT: 0 (some broken) ===")
  } else3 {
    print("=== RESULT: -1 (all broken) ===")
  }
}
