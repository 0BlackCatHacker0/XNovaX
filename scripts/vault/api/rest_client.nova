## rest_client.nova — Makes GET/POST requests with custom headers
## Usage: set url, method, headers, body below

let url = "https://httpbin.org/get"
let method = "GET"
let headers = {}
let headers = dict_set(headers, "User-Agent", "NovaX-RestClient/1.0")
let headers = dict_set(headers, "Accept", "application/json")
let body = ""

let result = -1

print("=== NovaX REST Client ===")
print("Method: " + method)
print("URL: " + url)
print("")

try3
  if3 method == "GET"
    let resp = http_get(url)
    let result = +1
  else3
    let resp = http_post_headers(url, body, headers)
    let result = +1
  end3

  print("--- Response ---")
  let resp_str = to_string(resp)
  if3 len(resp_str) > 2000
    let resp_str = slice(resp_str, 0, 2000) + "... [truncated]"
  end3
  print(resp_str)

fail3 err
  print("ERROR: " + to_string(err))
  let result = -1
end3

print("")
if3 result == 1
  print("[+1] Request successful")
else3
  print("[-1] Request failed")
end3
