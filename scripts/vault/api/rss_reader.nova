// NovaX Script Vault — api/rss_reader.nova
// Description: Fetches and displays recent entries from an RSS feed
// Category: api | Trit: +1=success, 0=empty, -1=fail

let feed_url = "https://hnrss.org/frontpage?count=10"

print("=== NovaX RSS Reader ===")
print("Feed: " + feed_url)
print("")

// Fetch RSS feed using curl
let cmd = "curl -s -L --max-time 15 \"" + feed_url + "\""
let r = shell(cmd)
let ok = dict_get(r, "ok") ?? 0

if3 ok == 1 {
  let xml = trim(dict_get(r, "stdout") ?? "")
  if3 xml == "" {
    print("No content received.")
    print("")
    print("=== RESULT: 0 (empty) ===")
  } else3 {
    // Parse RSS items from XML using NovaLang string ops
    // Split on <item> tags to find entries
    let parts = split(xml, "<item>")
    let count = 0
    let i = 1
    while3 i < len(parts) && count < 10 {
      let item_block = parts[i]
      // Extract <title>
      let title = ""
      if3 contains(item_block, "<title>") {
        let after_title = split(item_block, "<title>")
        if3 len(after_title) > 1 {
          let before_end = split(after_title[1], "</title>")
          let title = before_end[0]
          // Strip CDATA if present
          let title = replace(title, "<![CDATA[", "")
          let title = replace(title, "]]>", "")
        }
      }
      // Extract <link>
      let link = ""
      if3 contains(item_block, "<link>") {
        let after_link = split(item_block, "<link>")
        if3 len(after_link) > 1 {
          let before_end = split(after_link[1], "</link>")
          let link = trim(before_end[0])
          let link = replace(link, "<![CDATA[", "")
          let link = replace(link, "]]>", "")
        }
      }

      let count = count + 1
      print(str(count) + ". " + title)
      print("   " + link)
      print("")
      let i = i + 1
    }
    print("Total: " + str(count))
    print("")
    print("=== RESULT: +1 (success) ===")
  }
} else3 {
  print("ERROR: " + dict_get(r, "stderr") ?? "")
  print("=== RESULT: -1 (fail) ===")
}
