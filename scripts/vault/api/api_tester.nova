## api_tester.nova — Tests an API endpoint: response time, status code, body validation
## Usage: set target_url and expected_contains below

let target_url = "https://httpbin.org/get"
let expected_contains = "httpbin"
let result = -1
let tests_passed = 0
let tests_total = 3

print("=== NovaX API Tester ===")
print("Target: " + target_url)
print("Expect body contains: " + expected_contains)
print("")

try3
  ## Test 1: Reachability + response time
  let t_start = time_ms()
  let resp = http_get(target_url)
  let t_end = time_ms()
  let elapsed = t_end - t_start
  let resp_str = to_string(resp)

  print("[Test 1] Reachability")
  if3 len(resp_str) > 0
    print("  PASS - Response received (" + to_string(elapsed) + "ms)")
    let tests_passed = tests_passed + 1
  else3
    print("  FAIL - Empty response")
  end3

  ## Test 2: Response time under 5 seconds
  print("[Test 2] Response time < 5000ms")
  if3 elapsed < 5000
    print("  PASS - " + to_string(elapsed) + "ms")
    let tests_passed = tests_passed + 1
  else3
    print("  FAIL - " + to_string(elapsed) + "ms (too slow)")
  end3

  ## Test 3: Body contains expected string
  print("[Test 3] Body contains '" + expected_contains + "'")
  if3 contains(resp_str, expected_contains)
    print("  PASS - Found in response body")
    let tests_passed = tests_passed + 1
  else3
    print("  FAIL - Not found in response body")
  end3

fail3 err
  print("ERROR: " + to_string(err))
end3

print("")
print("Results: " + to_string(tests_passed) + "/" + to_string(tests_total) + " passed")

if3 tests_passed == tests_total
  let result = +1
  print("[+1] All tests passed")
else3 tests_passed > 0
  let result = 0
  print("[0] Partial pass")
else3
  let result = -1
  print("[-1] All tests failed")
end3
