## json_api_poll.nova — Polls a JSON API endpoint at intervals, reports changes
## Usage: set poll_url, interval_sec, max_polls below

let poll_url = "https://httpbin.org/uuid"
let interval_sec = 5
let max_polls = 3
let result = -1

print("=== NovaX JSON API Poller ===")
print("URL: " + poll_url)
print("Interval: " + to_string(interval_sec) + "s")
print("Max polls: " + to_string(max_polls))
print("")

let prev_response = ""
let changes = 0
let poll_count = 0
let errors = 0

while3 poll_count < max_polls
  let poll_count = poll_count + 1
  print("--- Poll #" + to_string(poll_count) + " ---")

  try3
    let resp = http_get(poll_url)
    let resp_str = to_string(resp)

    if3 prev_response == ""
      print("Initial response captured")
      print(resp_str)
    else3
      if3 resp_str != prev_response
        let changes = changes + 1
        print("CHANGE DETECTED (#" + to_string(changes) + ")")
        print(resp_str)
      else3
        print("No change")
      end3
    end3

    let prev_response = resp_str

  fail3 err
    let errors = errors + 1
    print("ERROR: " + to_string(err))
  end3

  if3 poll_count < max_polls
    sleep(interval_sec)
  end3
end3

print("")
print("Polls: " + to_string(poll_count) + " | Changes: " + to_string(changes) + " | Errors: " + to_string(errors))

if3 errors == 0
  let result = +1
  print("[+1] Polling completed successfully")
else3 errors < poll_count
  let result = 0
  print("[0] Polling completed with some errors")
else3
  let result = -1
  print("[-1] Polling failed")
end3
