## url_shortener.nova — Shortens URLs using is.gd API
## Usage: set long_url below

let long_url = "https://github.com/NovaX-AI/NovaX"
let result = -1

print("=== NovaX URL Shortener ===")
print("Original: " + long_url)
print("")

try3
  let api_url = "https://is.gd/create.php?format=simple&url=" + long_url
  let resp = http_get(api_url)
  let short = trim(to_string(resp))

  if3 starts_with(short, "http")
    print("Shortened: " + short)
    let saved = len(long_url) - len(short)
    print("Saved " + to_string(saved) + " characters")
    let result = +1
  else3
    print("API returned unexpected response: " + short)
    let result = -1
  end3

fail3 err
  print("ERROR: " + to_string(err))
  let result = -1
end3

print("")
if3 result == 1
  print("[+1] URL shortened successfully")
else3
  print("[-1] URL shortening failed")
end3
