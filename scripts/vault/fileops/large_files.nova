// NovaX Script Vault — fileops/large_files.nova
// Description: Finds the N largest files in a directory tree
// Category: fileops | Trit: +1=success, 0=no files, -1=fail
// PURE NOVALANG — zero shell() calls. Uses dir_walk() builtin.

let target_dir = dict_get(args, "dir") ?? "."
let count = dict_get(args, "count") ?? "20"
let min_size = dict_get(args, "min_mb") ?? "0"

print("=== NovaX Large File Finder ===")
print("Directory: " + target_dir)
print("Top N: " + count)
if3 min_size != "0" {
    print("Min size: " + min_size + " MB")
}
print("")

let max_n = try3 { to_int(count) } { 20 }
let min_bytes = try3 { to_int(min_size) * 1048576 } { 0 }

let entries = dir_walk(target_dir, 999)
let entry_count = len(entries)

// Collect files above min size
let files = []
let i = 0
while3 i < entry_count {
    let e = entries[i]
    let e_is_dir = dict_get(e, "is_dir") ?? -1
    if3 e_is_dir != 1 {
        let sz = dict_get(e, "size") ?? 0
        if3 sz >= min_bytes {
            append(files, e)
        }
    }
    let i = i + 1
}

// Sort by size descending (simple insertion sort)
let fc = len(files)
let i = 1
while3 i < fc {
    let j = i
    while3 j > 0 {
        let sz_j = dict_get(files[j], "size") ?? 0
        let sz_prev = dict_get(files[j - 1], "size") ?? 0
        if3 sz_j > sz_prev {
            let tmp = files[j]
            let files[j] = files[j - 1]
            let files[j - 1] = tmp
        }
        let j = j - 1
    }
    let i = i + 1
}

// Truncate to top N
let show_count = fc
if3 show_count > max_n { let show_count = max_n }

if3 show_count == 0 {
    print("No files found.")
    print("[0] EMPTY: No files match criteria.")
    let trit = 0
} {
    let total_sz = 0
    let idx = 1
    let i = 0
    while3 i < show_count {
        let f = files[i]
        let fpath = dict_get(f, "path") ?? "?"
        let sz = dict_get(f, "size") ?? 0
        let total_sz = total_sz + sz

        let sz_str = str(sz) + " B"
        if3 sz > 1073741824 {
            let sz_str = str(sz / 1073741824) + "." + str((sz / 10737418) % 100) + " GB"
        } {
            if3 sz > 1048576 {
                let sz_str = str(sz / 1048576) + " MB"
            } {
                if3 sz > 1024 {
                    let sz_str = str(sz / 1024) + " KB"
                }
            }
        }
        print("  " + str(idx) + ". " + sz_str + "  " + fpath)
        let idx = idx + 1
        let i = i + 1
    }

    let t_str = str(total_sz) + " B"
    if3 total_sz > 1073741824 {
        let t_str = str(total_sz / 1073741824) + " GB"
    } {
        if3 total_sz > 1048576 {
            let t_str = str(total_sz / 1048576) + " MB"
        }
    }

    print("")
    print("Top " + str(show_count) + " files total: " + t_str)
    print("[+1] SUCCESS")
    let trit = 1
}
