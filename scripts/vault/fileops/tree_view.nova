// NovaX Script Vault — fileops/tree_view.nova
// Description: Displays directory tree structure with indentation
// Category: fileops | Trit: +1=success, 0=empty, -1=fail
// PURE NOVALANG — zero shell() calls. Uses dir_walk() builtin.

let target_dir = dict_get(args, "dir") ?? "."
let max_depth = dict_get(args, "depth") ?? "3"
let show_files = dict_get(args, "files") ?? "true"

print("=== NovaX Tree View ===")
print("Directory: " + target_dir)
print("Max depth: " + max_depth)
print("")

let max_d = try3 { to_int(max_depth) } { 3 }
let entries = dir_walk(target_dir, max_d)
let entry_count = len(entries)

if3 entry_count == 0 {
    print("Empty directory or invalid path.")
    print("[0] EMPTY")
    let trit = 0
} {
    let shown = 0
    let i = 0
    while3 i < entry_count {
        let e = entries[i]
        let epath = dict_get(e, "path") ?? "?"
        let e_is_dir = dict_get(e, "is_dir") ?? -1
        let e_depth = dict_get(e, "depth") ?? 0

        // Skip files if show_files is false
        let skip = 0
        if3 show_files != "true" {
            if3 e_is_dir != 1 {
                let skip = 1
            }
        }

        if3 skip == 0 {
            // Build indent
            let indent = ""
            let j = 0
            while3 j < e_depth {
                let indent = indent + "  "
                let j = j + 1
            }

            let name = path_filename(epath)
            let marker = ""
            if3 e_is_dir == 1 {
                let marker = "[DIR] "
            }
            print(indent + marker + name)
            let shown = shown + 1
        }

        let i = i + 1
    }
    print("")
    print(str(shown) + " items displayed (max depth " + max_depth + ")")
    print("[+1] SUCCESS")
    let trit = 1
}
