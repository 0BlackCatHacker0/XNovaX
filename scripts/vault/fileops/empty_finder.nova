// NovaX Script Vault — fileops/empty_finder.nova
// Description: Finds empty files and empty directories
// Category: fileops | Trit: +1=found empties, 0=none found, -1=fail
// PURE NOVALANG — zero shell() calls. Uses dir_walk() builtin.

let target_dir = dict_get(args, "dir") ?? "."
let delete_empty = dict_get(args, "delete") ?? "false"

print("=== NovaX Empty Finder ===")
print("Directory: " + target_dir)
print("Auto-delete: " + delete_empty)
print("")

let entries = dir_walk(target_dir, 999)
let entry_count = len(entries)

// Find empty files (size == 0, not a dir)
let empty_files = []
// Track which dirs have children
let dir_has_children = {}
let all_dirs = []

let i = 0
while3 i < entry_count {
    let e = entries[i]
    let epath = dict_get(e, "path") ?? ""
    let e_is_dir = dict_get(e, "is_dir") ?? -1
    let e_size = dict_get(e, "size") ?? 0

    if3 e_is_dir == 1 {
        append(all_dirs, epath)
        // Initialize as having no children
        dict_set(dir_has_children, epath, 0)
    } {
        // It's a file — mark its parent as non-empty
        let parent = path_parent(epath)
        dict_set(dir_has_children, parent, 1)
        // Check if empty file
        if3 e_size == 0 {
            append(empty_files, epath)
        }
    }
    let i = i + 1
}

// Also mark parent dirs of subdirs as non-empty
let i = 0
while3 i < len(all_dirs) {
    let dpath = all_dirs[i]
    let parent = path_parent(dpath)
    dict_set(dir_has_children, parent, 1)
    let i = i + 1
}

// Collect truly empty directories
let empty_dirs = []
let i = 0
while3 i < len(all_dirs) {
    let dpath = all_dirs[i]
    let has_kids = dict_get(dir_has_children, dpath) ?? 1
    if3 has_kids == 0 {
        append(empty_dirs, dpath)
    }
    let i = i + 1
}

let ef_count = len(empty_files)
let ed_count = len(empty_dirs)

if3 ef_count > 0 {
    print("Empty Files (" + str(ef_count) + "):")
    for3 f in empty_files {
        print("  [0B] " + f)
    }
    print("")
}

if3 ed_count > 0 {
    print("Empty Directories (" + str(ed_count) + "):")
    for3 d in empty_dirs {
        print("  [empty] " + d)
    }
    print("")
}

// Optionally delete using native builtins
if3 delete_empty == "true" {
    let deleted = 0
    for3 f in empty_files {
        delete_file(f)
        let deleted = deleted + 1
        print("  Deleted file: " + f)
    }
    for3 d in empty_dirs {
        delete_file(d)
        let deleted = deleted + 1
        print("  Deleted dir: " + d)
    }
    print("Deleted " + str(deleted) + " empty items.")
}

let total = ef_count + ed_count
if3 total == 0 {
    print("No empty files or directories found.")
    print("[0] CLEAN: Nothing empty.")
    let trit = 0
} {
    print("Found " + str(ef_count) + " empty files, " + str(ed_count) + " empty dirs.")
    print("[+1] SUCCESS: Empties identified.")
    let trit = 1
}
