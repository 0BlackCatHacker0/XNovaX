// NovaX Script Vault — fileops/recent_files.nova
// Description: Lists N most recently modified files in a directory tree
// Category: fileops | Trit: +1=success, 0=no files, -1=fail
// PURE NOVALANG — zero shell() calls. Uses dir_walk() builtin.

let target_dir = dict_get(args, "dir") ?? "."
let count = dict_get(args, "count") ?? "20"

print("=== NovaX Recent Files ===")
print("Directory: " + target_dir)
print("Showing top: " + count)
print("")

let max_n = try3 { to_int(count) } { 20 }
let entries = dir_walk(target_dir, 999)
let entry_count = len(entries)

// Collect only files (not dirs)
let files = []
let i = 0
while3 i < entry_count {
    let e = entries[i]
    let e_is_dir = dict_get(e, "is_dir") ?? -1
    if3 e_is_dir != 1 {
        append(files, e)
    }
    let i = i + 1
}

// Sort by mtime descending (insertion sort)
let fc = len(files)
let i = 1
while3 i < fc {
    let j = i
    while3 j > 0 {
        let mt_j = dict_get(files[j], "mtime") ?? 0
        let mt_prev = dict_get(files[j - 1], "mtime") ?? 0
        if3 mt_j > mt_prev {
            let tmp = files[j]
            let files[j] = files[j - 1]
            let files[j - 1] = tmp
        }
        let j = j - 1
    }
    let i = i + 1
}

// Truncate to top N
let show_count = fc
if3 show_count > max_n { let show_count = max_n }

if3 show_count == 0 {
    print("No files found.")
    print("[0] EMPTY: No files in directory tree.")
    let trit = 0
} {
    let idx = 1
    let i = 0
    while3 i < show_count {
        let f = files[i]
        let fpath = dict_get(f, "path") ?? "?"
        let mt = dict_get(f, "mtime") ?? 0
        let sz = dict_get(f, "size") ?? 0
        let sz_str = str(sz) + " B"
        if3 sz > 1048576 {
            let sz_str = str(sz / 1048576) + " MB"
        } {
            if3 sz > 1024 {
                let sz_str = str(sz / 1024) + " KB"
            }
        }
        print("  " + str(idx) + ". [mtime:" + str(mt) + "] " + sz_str + "  " + fpath)
        let idx = idx + 1
        let i = i + 1
    }
    print("")
    print("Showing " + str(show_count) + " most recent files.")
    print("[+1] SUCCESS")
    let trit = 1
}
