// NovaX Script Vault — fileops/batch_rename.nova
// Description: Renames files in a directory by pattern (prefix/suffix/replace)
// Category: fileops | Trit: +1=success, 0=partial, -1=fail

// Usage: set target_dir, mode ("prefix"|"suffix"|"replace"), and pattern vars below
let target_dir = dict_get(args, "dir") ?? "."
let mode = dict_get(args, "mode") ?? "prefix"
let pattern = dict_get(args, "pattern") ?? "nova_"
let replace_from = dict_get(args, "from") ?? ""
let replace_to = dict_get(args, "to") ?? ""

print("=== NovaX Batch Rename ===")
print("Directory: " + target_dir)
print("Mode: " + mode)

// List files in the target directory using dir /b /a-d
let cmd = "dir /b /a-d \"" + target_dir + "\" 2>nul"
let result = shell(cmd)

if3 dict_get(result, "ok") ?? -1 == -1
    print("[-1] FAIL: Could not list directory: " + dict_get(result, "stderr") ?? "")
    let trit = -1
else3
    let raw = trim(dict_get(result, "stdout") ?? "")
    if3 raw == ""
        let files = []
    else3
        let files = split(raw, "\n")
    end3
    let total = len(files)
    let renamed = 0
    let failed = 0

    if3 total == 0
        print("[0] No files found in directory.")
        let trit = 0
    else3
        print("Found " + str(total) + " files to process...")

        for3 f in files
            let f = trim(f)
            let new_name = ""
            if3 mode == "prefix"
                let new_name = pattern + f
            else3
                if3 mode == "suffix"
                    let parts = split(f, ".")
                    if3 len(parts) > 1
                        let ext = parts[len(parts) - 1]
                        let base = replace(f, "." + ext, "")
                        let new_name = base + pattern + "." + ext
                    else3
                        let new_name = f + pattern
                    end3
                else3
                    if3 mode == "replace"
                        let new_name = replace(f, replace_from, replace_to)
                    else3
                        print("Unknown mode: " + mode)
                        let new_name = f
                    end3
                end3
            end3

            if3 new_name != f && new_name != ""
                // Use ren command for renaming
                let mv_cmd = "ren \"" + target_dir + "\\" + f + "\" \"" + new_name + "\" 2>nul && echo OK"
                let mv_result = shell(mv_cmd)
                if3 contains(dict_get(mv_result, "stdout") ?? "", "OK")
                    let renamed = renamed + 1
                    print("  [+1] " + f + " -> " + new_name)
                else3
                    let failed = failed + 1
                    print("  [-1] Failed: " + f + " -> " + dict_get(mv_result, "stderr") ?? "")
                end3
            end3
        end3

        print("")
        print("Renamed: " + str(renamed) + "/" + str(total))
        if3 failed == 0
            let trit = 1
            print("[+1] SUCCESS: All files renamed.")
        else3
            if3 renamed > 0
                let trit = 0
                print("[0] PARTIAL: " + str(failed) + " files failed.")
            else3
                let trit = -1
                print("[-1] FAIL: No files renamed.")
            end3
        end3
    end3
end3
