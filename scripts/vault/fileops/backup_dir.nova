// NovaX Script Vault — fileops/backup_dir.nova
// Description: Creates a file-by-file backup copy of a directory
// Category: fileops | Trit: +1=success, 0=partial, -1=fail
// PURE NOVALANG — zero shell() calls. Uses dir_walk() + copy_file() builtins.
// NOTE: No zip compression without shell; creates a mirror copy instead.

let source_dir = dict_get(args, "dir") ?? "."
let backup_dest = dict_get(args, "dest") ?? "."

print("=== NovaX Backup Directory ===")
print("Source: " + source_dir)
print("Destination: " + backup_dest)
print("Format: directory copy")
print("")

// Build backup directory name with timestamp
let ts = str(time())
let dir_name = path_filename(source_dir)
let backup_name = dir_name + "_backup_" + ts
let backup_path = path_join(backup_dest, backup_name)

print("Creating backup: " + backup_name)
print("")

// Walk source directory
let entries = dir_walk(source_dir, 999)
let entry_count = len(entries)

// Count source files
let file_count = 0
let i = 0
while3 i < entry_count {
    let e = entries[i]
    let e_is_dir = dict_get(e, "is_dir") ?? -1
    if3 e_is_dir != 1 {
        let file_count = file_count + 1
    }
    let i = i + 1
}
print("Source contains " + str(file_count) + " files.")

// Create backup root
mkdir(backup_path)

// Copy all entries
let copied = 0
let errors = 0
let i = 0
while3 i < entry_count {
    let e = entries[i]
    let epath = dict_get(e, "path") ?? ""
    let e_is_dir = dict_get(e, "is_dir") ?? -1

    // Build relative path: strip source_dir prefix from epath
    let rel = replace(epath, source_dir, "")
    // Remove leading separator if present
    if3 len(rel) > 0 {
        let first_char = substr(rel, 0, 1)
        if3 first_char == "/" { let rel = substr(rel, 1, len(rel) - 1) }
        if3 first_char == "\\" { let rel = substr(rel, 1, len(rel) - 1) }
    }

    let dest_path = path_join(backup_path, rel)

    if3 e_is_dir == 1 {
        mkdir(dest_path)
    } {
        // Copy file
        let result = copy_file(epath, dest_path)
        if3 result > 0 {
            let copied = copied + 1
        } {
            let errors = errors + 1
        }
    }
    let i = i + 1
}

if3 errors == 0 {
    print("")
    print("Backup created: " + backup_path)
    print("Files copied: " + str(copied))
    print("[+1] SUCCESS: Backup complete.")
    let trit = 1
} {
    if3 copied > 0 {
        print("")
        print("Backup partially created: " + backup_path)
        print("Files copied: " + str(copied) + ", errors: " + str(errors))
        print("[0] PARTIAL: Some files failed to copy.")
        let trit = 0
    } {
        print("Backup failed: no files copied, " + str(errors) + " errors.")
        print("[-1] FAIL: Could not create backup.")
        let trit = -1
    }
}
