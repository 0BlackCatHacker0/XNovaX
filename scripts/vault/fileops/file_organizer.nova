// NovaX Script Vault — fileops/file_organizer.nova
// Description: Sorts files into folders by extension type
// Category: fileops | Trit: +1=success, 0=partial, -1=fail

let target_dir = dict_get(args, "dir") ?? "."
let dry_run = dict_get(args, "dry_run") ?? "false"

print("=== NovaX File Organizer ===")
print("Directory: " + target_dir)
print("Dry run: " + dry_run)
print("")

// Extension category mapping
let categories = "{\"Images\":\".png,.jpg,.jpeg,.gif,.bmp,.svg,.ico,.webp\",\"Documents\":\".pdf,.doc,.docx,.txt,.rtf,.odt,.xls,.xlsx,.csv,.pptx\",\"Audio\":\".mp3,.wav,.flac,.aac,.ogg,.wma,.m4a\",\"Video\":\".mp4,.avi,.mkv,.mov,.wmv,.flv,.webm\",\"Archives\":\".zip,.rar,.7z,.tar,.gz,.bz2\",\"Code\":\".py,.js,.ts,.html,.css,.java,.cpp,.c,.rs,.go,.nova\",\"Data\":\".json,.xml,.yaml,.yml,.sql,.db,.sqlite\",\"Executables\":\".exe,.msi,.bat,.cmd,.ps1,.sh\"}"
let cat_map = json_decode(categories)
let cat_keys = dict_keys(cat_map)

// List files using dir /b /a-d (files only, no dirs)
let cmd = "dir /b /a-d \"" + target_dir + "\" 2>nul"
let result = shell(cmd)

if3 dict_get(result, "ok") ?? -1 == -1
    print("[-1] FAIL: Cannot list directory.")
    let trit = -1
else3
    let raw = trim(dict_get(result, "stdout") ?? "")
    if3 raw == ""
        print("[0] No files found in directory.")
        let trit = 0
    else3
        let files = split(raw, "\n")
        let moved = 0
        let skipped = 0
        let total = len(files)

        for3 f in files
            let f = trim(f)
            if3 f == ""
                let skipped = skipped + 1
            else3
                // Get extension using NovaLang split on "."
                let parts = split(f, ".")
                let ext = ""
                if3 len(parts) > 1
                    let ext = "." + lower(parts[len(parts) - 1])
                end3

                if3 ext == ""
                    let skipped = skipped + 1
                else3
                    // Find category
                    let found_cat = "Other"
                    for3 ck in cat_keys
                        let exts = dict_get(cat_map, ck) ?? ""
                        if3 contains(exts, ext)
                            let found_cat = ck
                        end3
                    end3

                    let dest_dir = target_dir + "\\" + found_cat
                    if3 dry_run == "true"
                        print("  [DRY] " + f + " -> " + found_cat + "/")
                        let moved = moved + 1
                    else3
                        // Create directory with mkdir
                        let mkdir_cmd = "mkdir \"" + dest_dir + "\" 2>nul"
                        shell(mkdir_cmd)
                        // Move file with move command
                        let mv_cmd = "move /Y \"" + target_dir + "\\" + f + "\" \"" + dest_dir + "\\" + f + "\" >nul 2>&1 && echo OK"
                        let mv_r = shell(mv_cmd)
                        if3 contains(dict_get(mv_r, "stdout") ?? "", "OK")
                            let moved = moved + 1
                            print("  [+1] " + f + " -> " + found_cat + "/")
                        else3
                            let skipped = skipped + 1
                            print("  [-1] Failed: " + f)
                        end3
                    end3
                end3
            end3
        end3

        print("")
        print("Organized: " + str(moved) + " | Skipped: " + str(skipped) + " | Total: " + str(total))

        if3 moved == 0
            let trit = -1
            print("[-1] FAIL: No files organized.")
        else3
            if3 skipped > 0
                let trit = 0
                print("[0] PARTIAL: Some files skipped.")
            else3
                let trit = 1
                print("[+1] SUCCESS: All files organized.")
            end3
        end3
    end3
end3
