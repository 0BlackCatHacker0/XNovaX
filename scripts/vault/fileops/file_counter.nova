// NovaX Script Vault — fileops/file_counter.nova
// Description: Counts files by extension type in a directory
// Category: fileops | Trit: +1=success, 0=empty, -1=fail
// PURE NOVALANG — zero shell() calls. Uses dir_walk() builtin.

let target_dir = dict_get(args, "dir") ?? "."
let recursive = dict_get(args, "recursive") ?? "true"

print("=== NovaX File Counter ===")
print("Directory: " + target_dir)
print("Recursive: " + recursive)
print("")

let walk_depth = 0
if3 recursive == "true" {
    let walk_depth = 999
}

let entries = dir_walk(target_dir, walk_depth)
let entry_count = len(entries)

// Count files by extension
let ext_counts = {}
let total = 0
let i = 0
while3 i < entry_count {
    let e = entries[i]
    let e_is_dir = dict_get(e, "is_dir") ?? -1
    if3 e_is_dir != 1 {
        // Non-recursive: only depth 0
        let e_depth = dict_get(e, "depth") ?? 0
        let include = 1
        if3 recursive != "true" {
            if3 e_depth > 0 { let include = 0 }
        }
        if3 include == 1 {
            let epath = dict_get(e, "path") ?? ""
            let ext = path_ext(epath)
            if3 len(ext) == 0 { let ext = "(no ext)" }
            let cur = dict_get(ext_counts, ext) ?? 0
            dict_set(ext_counts, ext, cur + 1)
            let total = total + 1
        }
    }
    let i = i + 1
}

if3 total == 0 {
    print("No files found.")
    print("[0] EMPTY")
    let trit = 0
} {
    let ext_keys = dict_keys(ext_counts)
    let num_types = len(ext_keys)

    print("Extension breakdown:")
    print("----------------------------")
    let i = 0
    while3 i < num_types {
        let ext = ext_keys[i]
        let cnt = dict_get(ext_counts, ext) ?? 0
        // Build a simple bar
        let bar = ""
        let b = 0
        let bar_len = cnt
        if3 bar_len > 40 { let bar_len = 40 }
        while3 b < bar_len {
            let bar = bar + "#"
            let b = b + 1
        }
        print("  " + ext + "  " + str(cnt) + "  " + bar)
        let i = i + 1
    }
    print("----------------------------")
    print("Total: " + str(total) + " files, " + str(num_types) + " types")
    print("[+1] SUCCESS")
    let trit = 1
}
