// NovaX Script Vault — fileops/dir_size.nova
// Description: Shows directory sizes recursively
// Category: fileops | Trit: +1=success, 0=empty, -1=fail
// PURE NOVALANG — zero shell() calls. Uses dir_walk() builtin.

let target_dir = dict_get(args, "dir") ?? "."
let depth = dict_get(args, "depth") ?? "2"

print("=== NovaX Directory Size ===")
print("Directory: " + target_dir)
print("Max depth: " + depth)
print("")

let max_d = try3 { to_int(depth) } { 2 }
let entries = dir_walk(target_dir, max_d)
let entry_count = len(entries)

// Collect only directories and sum file sizes under each
let dirs = []
let dir_sizes = {}
let i = 0
while3 i < entry_count {
    let e = entries[i]
    let epath = dict_get(e, "path") ?? ""
    let e_is_dir = dict_get(e, "is_dir") ?? -1
    let e_size = dict_get(e, "size") ?? 0
    let e_depth = dict_get(e, "depth") ?? 0

    if3 e_is_dir == 1 {
        append(dirs, e)
        dict_set(dir_sizes, epath, 0)
    } {
        // Add file size to its parent directory
        let parent = path_parent(epath)
        let cur = dict_get(dir_sizes, parent) ?? -1
        if3 cur != -1 {
            dict_set(dir_sizes, parent, cur + e_size)
        }
    }
    let i = i + 1
}

let dir_count = len(dirs)

if3 dir_count == 0 {
    print("No directories found.")
    print("[0] EMPTY")
    let trit = 0
} {
    let grand_total = 0
    let i = 0
    while3 i < dir_count {
        let d = dirs[i]
        let dpath = dict_get(d, "path") ?? "?"
        let dp = dict_get(d, "depth") ?? 0
        let sz = dict_get(dir_sizes, dpath) ?? 0
        let grand_total = grand_total + sz

        // Format size
        let sz_str = str(sz) + " B"
        if3 sz > 1073741824 {
            let sz_str = str(sz / 1073741824) + " GB"
        } {
            if3 sz > 1048576 {
                let sz_str = str(sz / 1048576) + " MB"
            } {
                if3 sz > 1024 {
                    let sz_str = str(sz / 1024) + " KB"
                }
            }
        }

        // Indent by depth
        let indent = ""
        let j = 0
        while3 j < dp {
            let indent = indent + "  "
            let j = j + 1
        }
        print(indent + sz_str + "  " + dpath)
        let i = i + 1
    }

    // Grand total
    let gt_str = str(grand_total) + " B"
    if3 grand_total > 1073741824 {
        let gt_str = str(grand_total / 1073741824) + " GB"
    } {
        if3 grand_total > 1048576 {
            let gt_str = str(grand_total / 1048576) + " MB"
        }
    }

    print("")
    print("Total: " + gt_str + " across " + str(dir_count) + " directories")
    print("[+1] SUCCESS")
    let trit = 1
}
