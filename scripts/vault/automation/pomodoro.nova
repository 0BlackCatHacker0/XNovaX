## pomodoro.nova - Pomodoro timer with notification
## Usage: nova pomodoro.nova [work_minutes] [break_minutes]
##        nova pomodoro.nova 25 5
##        nova pomodoro.nova status

let args = argv()
let argc = len(args)

let work_min = 25
let break_min = 5
let state_file = "C:/NovaX/data/pomodoro_state.json"

shell("mkdir -p C:/NovaX/data")

if3 argc >= 2
  if3 args[1] == "status"
    ## Show current pomodoro state
    try3
      let content = read_file(state_file)
      let state = json_decode(content)
      let phase = dict_get(state, "phase") ?? "idle"
      let started = dict_get(state, "started") ?? "?"
      let duration = dict_get(state, "duration") ?? 0
      let count = dict_get(state, "count") ?? 0
      let ds = str(duration)
      let cs = str(count)
      print("=== Pomodoro Status ===")
      print("  Phase:     " + phase)
      print("  Started:   " + started)
      print("  Duration:  " + ds + " min")
      print("  Completed: " + cs + " pomodoros today")
      print("[TRIT: +1] Status retrieved")
    fail3 e
      print("=== Pomodoro Status ===")
      print("  No active session")
      print("[TRIT: 0] No session")
    exit(0)

  let work_min = int(args[1])
  if3 argc >= 3
    let break_min = int(args[2])

let wms = str(work_min)
let bms = str(break_min)

print("=== Pomodoro Timer ===")
print("  Work:  " + wms + " minutes")
print("  Break: " + bms + " minutes")
print("")

## Load session count
let session_count = 0
try3
  let content = read_file(state_file)
  let state = json_decode(content)
  let session_count = dict_get(state, "count") ?? 0
fail3 e
  let session_count = 0

## Get current time
let now_result = shell("date '+%Y-%m-%d %H:%M:%S'")
let now = trim(now_result["stdout"])

## Save state as working
let state = {}
let state = dict_set(state, "phase", "work")
let state = dict_set(state, "started", now)
let state = dict_set(state, "duration", work_min)
let state = dict_set(state, "count", session_count)
write_file(state_file, json_encode(state))

## Calculate seconds
let work_sec = work_min * 60
let break_sec = break_min * 60
let wss = str(work_sec)

print("Starting WORK phase at " + now)
print("Timer: " + wms + " min (" + wss + " seconds)")
print("")

## Use sleep command for timer
let sleep_cmd = "sleep " + wss
let result = shell(sleep_cmd)

## Work phase complete - notify
print("")
print("*** WORK PHASE COMPLETE! ***")
print("Time for a break!")
print("")

## Send notification (Windows)
let notify_cmd = "powershell -Command \"[System.Reflection.Assembly]::LoadWithPartialName('System.Windows.Forms'); [System.Windows.Forms.MessageBox]::Show('Work phase complete! Take a " + bms + " minute break.', 'Pomodoro', 'OK', 'Information')\" 2>/dev/null &"
shell(notify_cmd)

## Also try terminal bell
print("\a")

## Update state to break
let now_result = shell("date '+%Y-%m-%d %H:%M:%S'")
let now = trim(now_result["stdout"])
let state = dict_set(state, "phase", "break")
let state = dict_set(state, "started", now)
let state = dict_set(state, "duration", break_min)
write_file(state_file, json_encode(state))

print("Starting BREAK phase: " + bms + " minutes")
let bss = str(break_sec)
let sleep_cmd2 = "sleep " + bss
shell(sleep_cmd2)

## Break complete
print("")
print("*** BREAK COMPLETE! ***")
print("Ready for another pomodoro!")

## Update count
let session_count = session_count + 1
let state = dict_set(state, "phase", "idle")
let state = dict_set(state, "count", session_count)
write_file(state_file, json_encode(state))

let scs = str(session_count)
print("")
print("Pomodoros completed today: " + scs)

## Notify break over
let notify_cmd2 = "powershell -Command \"[System.Reflection.Assembly]::LoadWithPartialName('System.Windows.Forms'); [System.Windows.Forms.MessageBox]::Show('Break over! Ready for pomodoro #" + scs + "?', 'Pomodoro', 'OK', 'Information')\" 2>/dev/null &"
shell(notify_cmd2)

print("[TRIT: +1] Pomodoro session complete")
