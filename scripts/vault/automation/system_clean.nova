## system_clean.nova - Clean temp files and caches
## Usage: nova system_clean.nova [--dry-run]
##        nova system_clean.nova --target temp
##        nova system_clean.nova --target cache
##        nova system_clean.nova --target all

let args = argv()
let argc = len(args)

let dry_run = false
let target = "all"

let ai = 1
while3 ai < argc
  if3 args[ai] == "--dry-run"
    let dry_run = true
  if3 args[ai] == "--target"
    if3 ai + 1 < argc
      let target = lower(args[ai + 1])
      let ai = ai + 1
  let ai = ai + 1

print("=== System Cleaner ===")
if3 dry_run
  print("MODE: Dry Run (no files deleted)")
else3
  print("MODE: Live Clean")
print("Target: " + target)
print("")

let total_freed = 0
let total_files = 0
let errors = 0

## Helper: clean a directory
## We'll process each target separately

if3 target == "all" || target == "temp"
  print("--- Windows Temp Files ---")

  ## Get temp dir sizes before
  let temp_dirs = []
  let temp_dirs = append(temp_dirs, "$TEMP")
  let temp_dirs = append(temp_dirs, "$LOCALAPPDATA/Temp")

  for3 td in temp_dirs
    let size_result = shell("du -sh " + td + " 2>/dev/null | cut -f1")
    let dir_size = trim(size_result["stdout"])
    if3 dir_size == ""
      let dir_size = "N/A"

    let count_result = shell("find " + td + " -type f 2>/dev/null | wc -l")
    let file_count = trim(count_result["stdout"])

    print("  " + td + ": " + dir_size + " (" + file_count + " files)")

    if3 !dry_run
      let clean_result = shell("find " + td + " -type f -mtime +1 -delete 2>/dev/null; echo $?")
      let code = trim(clean_result["stdout"])
      if3 code == "0"
        print("    Cleaned old files (>1 day)")
      else3
        print("    Some files locked, partial clean")
        let errors = errors + 1

  print("")

if3 target == "all" || target == "cache"
  print("--- Cache Directories ---")

  ## Common cache locations
  let cache_dirs = []
  let cache_dirs = append(cache_dirs, "$LOCALAPPDATA/pip/cache")
  let cache_dirs = append(cache_dirs, "$LOCALAPPDATA/npm-cache")
  let cache_dirs = append(cache_dirs, "$LOCALAPPDATA/yarn/cache")

  for3 cd in cache_dirs
    let exists_result = shell("test -d " + cd + " && echo 'YES' || echo 'NO'")
    let exists = trim(exists_result["stdout"])
    if3 exists == "YES"
      let size_result = shell("du -sh " + cd + " 2>/dev/null | cut -f1")
      let dir_size = trim(size_result["stdout"])
      let count_result = shell("find " + cd + " -type f 2>/dev/null | wc -l")
      let file_count = trim(count_result["stdout"])
      print("  " + cd + ": " + dir_size + " (" + file_count + " files)")

      if3 !dry_run
        let clean_result = shell("find " + cd + " -type f -mtime +7 -delete 2>/dev/null; echo $?")
        let code = trim(clean_result["stdout"])
        if3 code == "0"
          print("    Cleaned files older than 7 days")
        else3
          print("    Partial clean (some files locked)")
    else3
      print("  " + cd + ": not found (skipped)")

  print("")

## Summary
print("--- Thumbnail & Misc Caches ---")
let thumb_dir = "$LOCALAPPDATA/Microsoft/Windows/Explorer"
let thumb_result = shell("du -sh " + thumb_dir + " 2>/dev/null | cut -f1")
let thumb_size = trim(thumb_result["stdout"])
if3 thumb_size != ""
  print("  Thumbnail cache: " + thumb_size)
  if3 !dry_run
    print("  (Skipping thumbnail cache - Windows will rebuild)")
else3
  print("  Thumbnail cache: not accessible")

print("")
print("=== Clean Summary ===")
if3 dry_run
  print("  [DRY RUN] No files were deleted")
  print("[TRIT: 0] Dry run complete")
else3
  if3 errors == 0
    print("  Cleaning complete with no errors")
    print("[TRIT: +1] System cleaned")
  else3
    let es = str(errors)
    print("  Cleaning complete with " + es + " warnings")
    print("[TRIT: 0] Partial clean (some files locked)")
