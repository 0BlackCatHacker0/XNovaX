## reminder.nova - Set a timed reminder that prints a message
## Usage: nova reminder.nova <minutes> <message>
##        nova reminder.nova 5 Take a break
##        nova reminder.nova list
##        nova reminder.nova clear

let args = argv()
let argc = len(args)

let reminders_file = "C:/NovaX/data/reminders.json"
shell("mkdir -p C:/NovaX/data")

if3 argc < 2
  print("Usage: reminder.nova <minutes> <message>")
  print("       reminder.nova list")
  print("       reminder.nova clear")
  exit(-1)

let action = args[1]

if3 action == "list"
  let reminders = []
  try3
    let content = read_file(reminders_file)
    let content = trim(content)
    if3 content != ""
      let reminders = json_decode(content)
  fail3 e
    let reminders = []

  if3 len(reminders) == 0
    print("=== Reminders ===")
    print("  (none)")
    print("[TRIT: 0] No reminders")
    exit(0)

  print("=== Reminder History ===")
  let i = 0
  for3 r in reminders
    let i = i + 1
    let msg = dict_get(r, "message") ?? "?"
    let set_at = dict_get(r, "set_at") ?? "?"
    let fire_at = dict_get(r, "fire_at") ?? "?"
    let status = dict_get(r, "status") ?? "?"
    print("  " + str(i) + ". [" + status + "] " + msg)
    print("     Set: " + set_at + " | Fire: " + fire_at)
  print("[TRIT: +1] Reminders listed")
  exit(0)

if3 action == "clear"
  write_file(reminders_file, "[]")
  print("Reminders cleared.")
  print("[TRIT: +1] Cleared")
  exit(0)

## Set a new reminder
if3 argc < 3
  print("[-1] Usage: reminder.nova <minutes> <message>")
  exit(-1)

let minutes = int(args[1])
let message = args[2]
let mi = 3
while3 mi < argc
  let message = message + " " + args[mi]
  let mi = mi + 1

let seconds = minutes * 60
let ms = str(minutes)
let ss = str(seconds)

## Get timestamps
let now_result = shell("date '+%Y-%m-%d %H:%M:%S'")
let now = trim(now_result["stdout"])
let fire_result = shell("date -d '+" + ms + " minutes' '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date -v+" + ms + "M '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo 'in " + ms + " min'")
let fire_at = trim(fire_result["stdout"])

## Save to log
let reminders = []
try3
  let content = read_file(reminders_file)
  let content = trim(content)
  if3 content != ""
    let reminders = json_decode(content)
fail3 e
  let reminders = []

let entry = {}
let entry = dict_set(entry, "message", message)
let entry = dict_set(entry, "set_at", now)
let entry = dict_set(entry, "fire_at", fire_at)
let entry = dict_set(entry, "minutes", minutes)
let entry = dict_set(entry, "status", "pending")
let reminders = append(reminders, entry)
write_file(reminders_file, json_encode(reminders))

print("=== Reminder Set ===")
print("  Message: " + message)
print("  Timer:   " + ms + " minutes (" + ss + " seconds)")
print("  Fire at: " + fire_at)
print("")
print("Waiting...")

## Sleep for the duration
let sleep_cmd = "sleep " + ss
shell(sleep_cmd)

## Fire the reminder
print("")
print("============================================")
print("  REMINDER: " + message)
print("============================================")
print("")
print("\a")

## Windows notification
let notify_cmd = "powershell -Command \"[System.Reflection.Assembly]::LoadWithPartialName('System.Windows.Forms'); [System.Windows.Forms.MessageBox]::Show('" + message + "', 'NovaX Reminder', 'OK', 'Information')\" 2>/dev/null &"
shell(notify_cmd)

## Update status in log
let reminders = []
try3
  let content = read_file(reminders_file)
  let reminders = json_decode(content)
  let last_idx = len(reminders) - 1
  let last = reminders[last_idx]
  let last = dict_set(last, "status", "fired")
  let reminders[last_idx] = last
  write_file(reminders_file, json_encode(reminders))
fail3 e
  ## ignore log update failure

print("[TRIT: +1] Reminder fired")
