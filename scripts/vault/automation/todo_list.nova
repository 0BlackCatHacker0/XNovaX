## todo_list.nova - File-based todo list manager
## Usage: nova todo_list.nova add <task>
##        nova todo_list.nova list
##        nova todo_list.nova done <number>
##        nova todo_list.nova remove <number>
##        nova todo_list.nova clear-done

let args = argv()
let argc = len(args)

let todo_file = "C:/NovaX/data/todos.json"

## Ensure data dir exists
shell("mkdir -p C:/NovaX/data")

if3 argc < 2
  print("Usage: todo_list.nova <add|list|done|remove|clear-done> [args]")
  exit(-1)

let action = lower(args[1])

## Load existing todos
let todos = []
try3
  let content = read_file(todo_file)
  let content = trim(content)
  if3 content != ""
    let todos = json_decode(content)
fail3 e
  let todos = []

if3 action == "add"
  if3 argc < 3
    print("[-1] Usage: todo_list.nova add <task description>")
    exit(-1)
  ## Build task text from remaining args
  let task_text = args[2]
  let ti = 3
  while3 ti < argc
    let task_text = task_text + " " + args[ti]
    let ti = ti + 1

  let now_result = shell("date '+%Y-%m-%d %H:%M'")
  let timestamp = trim(now_result["stdout"])

  let item = {}
  let item = dict_set(item, "task", task_text)
  let item = dict_set(item, "done", false)
  let item = dict_set(item, "created", timestamp)
  let todos = append(todos, item)

  write_file(todo_file, json_encode(todos))
  let num = str(len(todos))
  print("[+] Added task #" + num + ": " + task_text)
  print("[TRIT: +1] Task added")

else3
  if3 action == "list"
    if3 len(todos) == 0
      print("=== Todo List ===")
      print("  (empty)")
      print("[TRIT: 0] No tasks")
      exit(0)

    print("=== Todo List ===")
    let i = 0
    let done_count = 0
    let pending_count = 0
    for3 item in todos
      let num = i + 1
      let ns = str(num)
      let task = dict_get(item, "task") ?? "?"
      let is_done = dict_get(item, "done") ?? false
      let created = dict_get(item, "created") ?? ""
      let marker = "[ ]"
      if3 is_done
        let marker = "[x]"
        let done_count = done_count + 1
      else3
        let pending_count = pending_count + 1
      print("  " + ns + ". " + marker + " " + task + "  (" + created + ")")
      let i = i + 1

    let ps = str(pending_count)
    let ds = str(done_count)
    let ts = str(len(todos))
    print("")
    print("Pending: " + ps + " | Done: " + ds + " | Total: " + ts)

    if3 pending_count == 0
      print("[TRIT: +1] All tasks complete")
    else3
      print("[TRIT: 0] Tasks pending")

  else3
    if3 action == "done"
      if3 argc < 3
        print("[-1] Usage: todo_list.nova done <number>")
        exit(-1)
      let idx = int(args[2]) - 1
      if3 idx < 0 || idx >= len(todos)
        print("[-1] Invalid task number")
        exit(-1)
      let item = todos[idx]
      let item = dict_set(item, "done", true)
      let todos[idx] = item
      write_file(todo_file, json_encode(todos))
      let task = dict_get(item, "task") ?? "?"
      print("[x] Completed: " + task)
      print("[TRIT: +1] Task marked done")

    else3
      if3 action == "remove"
        if3 argc < 3
          print("[-1] Usage: todo_list.nova remove <number>")
          exit(-1)
        let idx = int(args[2]) - 1
        if3 idx < 0 || idx >= len(todos)
          print("[-1] Invalid task number")
          exit(-1)
        let task = dict_get(todos[idx], "task") ?? "?"
        let new_todos = []
        let i = 0
        for3 item in todos
          if3 i != idx
            let new_todos = append(new_todos, item)
          let i = i + 1
        write_file(todo_file, json_encode(new_todos))
        print("[-] Removed: " + task)
        print("[TRIT: +1] Task removed")

      else3
        if3 action == "clear-done"
          let new_todos = []
          let cleared = 0
          for3 item in todos
            let is_done = dict_get(item, "done") ?? false
            if3 !is_done
              let new_todos = append(new_todos, item)
            else3
              let cleared = cleared + 1
          write_file(todo_file, json_encode(new_todos))
          let cs = str(cleared)
          print("[~] Cleared " + cs + " completed tasks")
          print("[TRIT: +1] Done tasks cleared")
        else3
          print("[-1] Unknown action: " + action)
          print("Use: add, list, done, remove, clear-done")
          exit(-1)
