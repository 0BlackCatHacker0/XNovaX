## clipboard_history.nova - Save clipboard history to file
## Usage: nova clipboard_history.nova watch [interval_seconds]
##        nova clipboard_history.nova list [count]
##        nova clipboard_history.nova clear
##        nova clipboard_history.nova get <number>

let args = argv()
let argc = len(args)

let history_file = "C:/NovaX/data/clipboard_history.json"
shell("mkdir -p C:/NovaX/data")

if3 argc < 2
  print("Usage: clipboard_history.nova <watch|list|clear|get> [args]")
  exit(-1)

let action = lower(args[1])

## Load existing history
let history = []
try3
  let content = read_file(history_file)
  let content = trim(content)
  if3 content != ""
    let history = json_decode(content)
fail3 e
  let history = []

if3 action == "list"
  let show_count = 20
  if3 argc >= 3
    let show_count = int(args[2])

  let total = len(history)
  if3 total == 0
    print("=== Clipboard History ===")
    print("  (empty)")
    print("[TRIT: 0] No history")
    exit(0)

  print("=== Clipboard History (last " + str(show_count) + ") ===")
  let start = total - show_count
  if3 start < 0
    let start = 0
  let i = start
  while3 i < total
    let num = i + 1
    let entry = history[i]
    let ts = dict_get(entry, "time") ?? "?"
    let text = dict_get(entry, "text") ?? ""
    ## Truncate long entries
    let preview = text
    if3 len(text) > 80
      let preview = text[0:80] + "..."
    ## Replace newlines for display
    let preview = replace(preview, "\n", " ")
    print("  " + str(num) + ". [" + ts + "] " + preview)
    let i = i + 1

  print("")
  print("Total entries: " + str(total))
  print("[TRIT: +1] History listed")

else3
  if3 action == "get"
    if3 argc < 3
      print("[-1] Usage: clipboard_history.nova get <number>")
      exit(-1)
    let idx = int(args[2]) - 1
    if3 idx < 0 || idx >= len(history)
      print("[-1] Invalid entry number")
      exit(-1)
    let entry = history[idx]
    let text = dict_get(entry, "text") ?? ""
    let ts = dict_get(entry, "time") ?? "?"
    print("=== Clipboard Entry #" + str(idx + 1) + " ===")
    print("Time: " + ts)
    print("---")
    print(text)
    print("---")
    print("[TRIT: +1] Entry retrieved")

  else3
    if3 action == "clear"
      write_file(history_file, "[]")
      let cs = str(len(history))
      print("Cleared " + cs + " clipboard entries")
      print("[TRIT: +1] History cleared")

    else3
      if3 action == "watch"
        let interval = 2
        if3 argc >= 3
          let interval = int(args[2])

        let ivs = str(interval)
        print("=== Clipboard Watcher ===")
        print("Interval: " + ivs + " seconds")
        print("Press Ctrl+C to stop")
        print("")

        let last_clip = ""
        let count = 0

        while3 true
          ## Get current clipboard (Windows via PowerShell)
          let clip_result = shell("powershell -Command \"Get-Clipboard\" 2>/dev/null")
          let current_clip = ""
          if3 clip_result["ok"] == 1
            let current_clip = trim(clip_result["stdout"])
          else3
            ## Linux/Mac fallback
            let clip_result = shell("xclip -selection clipboard -o 2>/dev/null || pbpaste 2>/dev/null")
            if3 clip_result["ok"] == 1
              let current_clip = trim(clip_result["stdout"])

          if3 current_clip != "" && current_clip != last_clip
            let last_clip = current_clip
            let count = count + 1

            let now_result = shell("date '+%Y-%m-%d %H:%M:%S'")
            let now = trim(now_result["stdout"])

            let entry = {}
            let entry = dict_set(entry, "text", current_clip)
            let entry = dict_set(entry, "time", now)
            let history = append(history, entry)

            write_file(history_file, json_encode(history))

            let preview = current_clip
            if3 len(current_clip) > 60
              let preview = current_clip[0:60] + "..."
            let preview = replace(preview, "\n", " ")
            let cs = str(count)
            print("[" + now + "] #" + cs + ": " + preview)

          shell("sleep " + ivs)
      else3
        print("[-1] Unknown action: " + action)
        exit(-1)
