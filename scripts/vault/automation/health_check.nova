## health_check.nova - Check HTTP endpoints for 200 OK
## Usage: nova health_check.nova <url1> [url2] [url3] ...
##        nova health_check.nova --file <urls_file>

let args = argv()
let argc = len(args)

if3 argc < 2
  print("Usage: health_check.nova <url1> [url2] ...")
  print("       health_check.nova --file <urls_file>")
  exit(-1)

let urls = []

if3 args[1] == "--file"
  if3 argc < 3
    print("[-1] --file requires a filename")
    exit(-1)
  let content = ""
  try3
    let content = read_file(args[2])
  fail3 e
    print("[-1] Cannot read: " + args[2])
    exit(-1)
  let lines = split(content, "\n")
  for3 line in lines
    let trimmed = trim(line)
    if3 trimmed != "" && !starts_with(trimmed, "#")
      let urls = append(urls, trimmed)
else3
  let ui = 1
  while3 ui < argc
    let urls = append(urls, args[ui])
    let ui = ui + 1

let total = len(urls)
let up_count = 0
let down_count = 0
let warn_count = 0

print("=== Health Check ===")
print("Checking " + str(total) + " endpoint(s)...")
print("")
print("  Status  Time     URL")
print("  ------  ----     ---")

for3 url in urls
  ## Use curl to check endpoint
  let cmd = "curl -s -o /dev/null -w '%{http_code} %{time_total}' --connect-timeout 5 --max-time 10 '" + url + "'"
  let result = shell(cmd)

  if3 result["ok"] == 1
    let output = trim(result["stdout"])
    let parts = split(output, " ")
    let status_code = parts[0]
    let time_taken = ""
    if3 len(parts) > 1
      let time_taken = parts[1] + "s"
    else3
      let time_taken = "?s"

    if3 status_code == "200"
      print("  [ OK ]  " + time_taken + "  " + url)
      let up_count = up_count + 1
    else3
      if3 starts_with(status_code, "2") || starts_with(status_code, "3")
        print("  [WARN]  " + time_taken + "  " + url + " (" + status_code + ")")
        let warn_count = warn_count + 1
      else3
        print("  [DOWN]  " + time_taken + "  " + url + " (" + status_code + ")")
        let down_count = down_count + 1
  else3
    print("  [FAIL]  -----  " + url + " (connection failed)")
    let down_count = down_count + 1

print("")
print("--- Summary ---")
let us = str(up_count)
let ds = str(down_count)
let ws = str(warn_count)
let ts = str(total)
print("UP:   " + us + "/" + ts)
print("WARN: " + ws + "/" + ts)
print("DOWN: " + ds + "/" + ts)

if3 down_count == 0 && warn_count == 0
  print("[TRIT: +1] All endpoints healthy")
else3
  if3 down_count == 0
    print("[TRIT: 0] All up but some warnings")
  else3
    if3 up_count == 0
      print("[TRIT: -1] All endpoints down")
    else3
      print("[TRIT: -1] Some endpoints down")
