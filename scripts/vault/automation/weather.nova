## weather.nova - Get weather using wttr.in free API
## Usage: nova weather.nova <location>
##        nova weather.nova London
##        nova weather.nova "New York"

let args = argv()
let argc = len(args)

if3 argc < 2
  print("Usage: weather.nova <location>")
  print("  Examples: weather.nova London")
  print("            weather.nova 90210")
  exit(-1)

## Build location string
let location = args[1]
let ai = 2
while3 ai < argc
  let location = location + "+" + args[ai]
  let ai = ai + 1

## Use wttr.in with JSON format
let url = "https://wttr.in/" + location + "?format=j1"
let cmd = "curl -s --max-time 10 '" + url + "'"
let result = shell(cmd)

if3 result["ok"] != 1
  print("[-1] Failed to fetch weather data")
  exit(-1)

let body = trim(result["stdout"])
if3 body == "" || starts_with(body, "Unknown")
  print("[-1] Location not found: " + location)
  exit(-1)

let data = {}
try3
  let data = json_decode(body)
fail3 e
  ## Fallback: use simple text format
  let url2 = "https://wttr.in/" + location + "?format=3"
  let result2 = shell("curl -s --max-time 10 '" + url2 + "'")
  if3 result2["ok"] == 1
    print("=== Weather: " + location + " ===")
    print(trim(result2["stdout"]))
    print("[TRIT: +1] Weather fetched (simple)")
    exit(0)
  else3
    print("[-1] Cannot parse weather data")
    exit(-1)

## Extract current conditions
let current = dict_get(data, "current_condition") ?? []
if3 len(current) > 0
  let cc = current[0]
  let temp_c = dict_get(cc, "temp_C") ?? "?"
  let temp_f = dict_get(cc, "temp_F") ?? "?"
  let feels_c = dict_get(cc, "FeelsLikeC") ?? "?"
  let feels_f = dict_get(cc, "FeelsLikeF") ?? "?"
  let humidity = dict_get(cc, "humidity") ?? "?"
  let wind_mph = dict_get(cc, "windspeedMiles") ?? "?"
  let wind_dir = dict_get(cc, "winddir16Point") ?? "?"
  let pressure = dict_get(cc, "pressure") ?? "?"
  let visibility = dict_get(cc, "visibility") ?? "?"
  let uv = dict_get(cc, "uvIndex") ?? "?"

  let desc_list = dict_get(cc, "weatherDesc") ?? []
  let desc = "Unknown"
  if3 len(desc_list) > 0
    let desc = dict_get(desc_list[0], "value") ?? "Unknown"

  print("=== Weather: " + location + " ===")
  print("")
  print("  Condition:  " + desc)
  print("  Temp:       " + temp_c + "C / " + temp_f + "F")
  print("  Feels Like: " + feels_c + "C / " + feels_f + "F")
  print("  Humidity:   " + humidity + "%")
  print("  Wind:       " + wind_mph + " mph " + wind_dir)
  print("  Pressure:   " + pressure + " mb")
  print("  Visibility: " + visibility + " km")
  print("  UV Index:   " + uv)

  ## Extract nearest area
  let areas = dict_get(data, "nearest_area") ?? []
  if3 len(areas) > 0
    let area = areas[0]
    let area_name_list = dict_get(area, "areaName") ?? []
    let country_list = dict_get(area, "country") ?? []
    let area_name = ""
    let country = ""
    if3 len(area_name_list) > 0
      let area_name = dict_get(area_name_list[0], "value") ?? ""
    if3 len(country_list) > 0
      let country = dict_get(country_list[0], "value") ?? ""
    print("  Location:   " + area_name + ", " + country)

  print("")
  print("[TRIT: +1] Weather retrieved successfully")
else3
  print("[-1] No current conditions in response")
  exit(-1)
