// NovaX Script Vault — data/fizzbuzz.nova
// Description: Classic FizzBuzz with ternary twist (Fizz=+1, Buzz=-1, FizzBuzz=0)
// Category: data | Trit: +1=success

let n = 100
let fizz = 0
let buzz = 0
let fizzbuzz = 0

print("=== NovaX Ternary FizzBuzz ===")
print("Range: 1 to " + str(n))
print("")

let i = 1
while3 i <= n {
  let mod3 = i - (floor(i / 3) * 3)
  let mod5 = i - (floor(i / 5) * 5)
  if3 mod3 == 0 {
    if3 mod5 == 0 {
      print(str(i) + ": FizzBuzz [trit: 0]")
      let fizzbuzz = fizzbuzz + 1
    } else3 {
      print(str(i) + ": Fizz [trit: +1]")
      let fizz = fizz + 1
    }
  } else3 {
    if3 mod5 == 0 {
      print(str(i) + ": Buzz [trit: -1]")
      let buzz = buzz + 1
    } else3 {
      print(str(i) + ": " + str(i))
    }
  }
  let i = i + 1
}

print("")
print("--- Ternary Summary ---")
print("Fizz (+1):     " + str(fizz))
print("Buzz (-1):     " + str(buzz))
print("FizzBuzz (0):  " + str(fizzbuzz))
print("Balance:       " + str(fizz - buzz))
print("")
print("=== RESULT: +1 (success) ===")
