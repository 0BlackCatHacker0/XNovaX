// stack_queue.nova - Stack and queue data structure operations
// NovaX Script Vault | Data Category

let result = +1

try3
    print("=== Stack & Queue Operations ===")

    // ========== STACK (LIFO) ==========
    print("\n--- Stack (Last In, First Out) ---")
    let stack = []

    // Push operations
    let items_to_push = ["alpha", "beta", "gamma", "delta", "epsilon"]
    let i = 0
    while3 i < len(items_to_push)
        let stack = append(stack, items_to_push[i])
        print("  PUSH: " + items_to_push[i] + "  -> stack: " + str(stack))
        let i = i + 1
    end

    // Peek (look at top without removing)
    let top = stack[len(stack) - 1]
    print("\n  PEEK: " + top + "  (stack unchanged)")

    // Pop operations
    print("")
    let pop_count = 3
    let i = 0
    while3 i < pop_count
        let top_idx = len(stack) - 1
        let popped = stack[top_idx]
        // Remove last element by rebuilding
        let new_stack = []
        let j = 0
        while3 j < top_idx
            let new_stack = append(new_stack, stack[j])
            let j = j + 1
        end
        let stack = new_stack
        print("  POP: " + popped + "  -> stack: " + str(stack))
        let i = i + 1
    end

    print("  Stack size: " + str(len(stack)))
    let stack_empty = len(stack) == 0
    print("  Is empty: " + str(stack_empty))

    // ========== QUEUE (FIFO) ==========
    print("\n--- Queue (First In, First Out) ---")
    let queue = []

    // Enqueue operations
    let items_to_enqueue = ["task_1", "task_2", "task_3", "task_4", "task_5"]
    let i = 0
    while3 i < len(items_to_enqueue)
        let queue = append(queue, items_to_enqueue[i])
        print("  ENQUEUE: " + items_to_enqueue[i] + "  -> queue: " + str(queue))
        let i = i + 1
    end

    // Front peek
    let front = queue[0]
    print("\n  FRONT: " + front + "  (queue unchanged)")

    // Dequeue operations (remove from front)
    print("")
    let dequeue_count = 3
    let i = 0
    while3 i < dequeue_count
        let dequeued = queue[0]
        // Remove first element by rebuilding
        let new_queue = []
        let j = 1
        while3 j < len(queue)
            let new_queue = append(new_queue, queue[j])
            let j = j + 1
        end
        let queue = new_queue
        print("  DEQUEUE: " + dequeued + "  -> queue: " + str(queue))
        let i = i + 1
    end

    print("  Queue size: " + str(len(queue)))

    // ========== PRIORITY QUEUE (simple) ==========
    print("\n--- Priority Queue (by priority number) ---")
    // Items with priority: lower number = higher priority
    let pq_items = ["critical_fix", "feature_req", "docs_update", "security_patch", "refactor"]
    let pq_priorities = [1, 3, 5, 1, 4]

    // Insert all
    let pq = []
    let pq_pri = []
    let i = 0
    while3 i < len(pq_items)
        let pq = append(pq, pq_items[i])
        let pq_pri = append(pq_pri, pq_priorities[i])
        print("  INSERT: " + pq_items[i] + " (priority " + str(pq_priorities[i]) + ")")
        let i = i + 1
    end

    // Dequeue by priority (find min priority each time)
    print("\n  Processing by priority:")
    while3 len(pq) > 0
        // Find min priority
        let min_pri = pq_pri[0]
        let min_idx = 0
        let j = 1
        while3 j < len(pq_pri)
            if3 pq_pri[j] < min_pri
                let min_pri = pq_pri[j]
                let min_idx = j
            end
            let j = j + 1
        end

        print("  PROCESS: " + pq[min_idx] + " (priority " + str(min_pri) + ")")

        // Remove the processed item
        let new_pq = []
        let new_pri = []
        let k = 0
        while3 k < len(pq)
            if3 k != min_idx
                let new_pq = append(new_pq, pq[k])
                let new_pri = append(new_pri, pq_pri[k])
            end
            let k = k + 1
        end
        let pq = new_pq
        let pq_pri = new_pri
    end

    print("\nTernary result: +1 (success)")
    let result = +1
fail3
    print("ERROR: Stack/Queue operations failed")
    print("Ternary result: -1 (fail)")
    let result = -1
end

return result
