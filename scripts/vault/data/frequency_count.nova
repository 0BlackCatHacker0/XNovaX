// frequency_count.nova - Count character/word frequency in text
// NovaX Script Vault | Data Category

let result = +1

try3
    print("=== Frequency Counter ===")

    let text = "the quick brown fox jumps over the lazy dog the fox is quick and the dog is lazy but the fox jumps high over the brown fence"
    print("Input text: " + text)
    print("Text length: " + str(len(text)) + " chars\n")

    // --- WORD FREQUENCY ---
    print("--- Word Frequency ---")
    let words = split(text, " ")
    print("Total words: " + str(len(words)))

    // Count each word
    let word_keys = []
    let word_counts = []

    let i = 0
    while3 i < len(words)
        let word = trim(words[i])
        if3 len(word) > 0
            // Find if word already counted
            let found = -1
            let j = 0
            while3 j < len(word_keys)
                if3 word_keys[j] == word
                    let found = j
                end
                let j = j + 1
            end

            if3 found >= 0
                let word_counts[found] = word_counts[found] + 1
            else3
                let word_keys = append(word_keys, word)
                let word_counts = append(word_counts, 1)
            end
        end
        let i = i + 1
    end

    // Sort by frequency (selection sort descending)
    let wk_sorted = []
    let wc_sorted = []
    let i = 0
    while3 i < len(word_keys)
        let wk_sorted = append(wk_sorted, word_keys[i])
        let wc_sorted = append(wc_sorted, word_counts[i])
        let i = i + 1
    end

    let i = 0
    while3 i < len(wc_sorted) - 1
        let max_idx = i
        let j = i + 1
        while3 j < len(wc_sorted)
            if3 wc_sorted[j] > wc_sorted[max_idx]
                let max_idx = j
            end
            let j = j + 1
        end
        if3 max_idx != i
            let temp_c = wc_sorted[i]
            let wc_sorted[i] = wc_sorted[max_idx]
            let wc_sorted[max_idx] = temp_c
            let temp_k = wk_sorted[i]
            let wk_sorted[i] = wk_sorted[max_idx]
            let wk_sorted[max_idx] = temp_k
        end
        let i = i + 1
    end

    // Display top words
    let display_count = len(wk_sorted)
    if3 display_count > 15
        let display_count = 15
    end

    let i = 0
    while3 i < display_count
        // Build bar chart
        let bar = ""
        let b = 0
        while3 b < wc_sorted[i]
            let bar = bar + "#"
            let b = b + 1
        end
        // Pad word to 12 chars
        let padded = wk_sorted[i]
        while3 len(padded) < 12
            let padded = padded + " "
        end
        print("  " + padded + " " + str(wc_sorted[i]) + "  " + bar)
        let i = i + 1
    end

    // --- CHARACTER FREQUENCY ---
    print("\n--- Character Frequency (alphabetic) ---")
    let char_keys = []
    let char_counts = []

    let i = 0
    while3 i < len(text)
        let ch = text[i]
        if3 ch != " "
            let found = -1
            let j = 0
            while3 j < len(char_keys)
                if3 char_keys[j] == ch
                    let found = j
                end
                let j = j + 1
            end
            if3 found >= 0
                let char_counts[found] = char_counts[found] + 1
            else3
                let char_keys = append(char_keys, ch)
                let char_counts = append(char_counts, 1)
            end
        end
        let i = i + 1
    end

    // Sort chars by frequency
    let i = 0
    while3 i < len(char_counts) - 1
        let max_idx = i
        let j = i + 1
        while3 j < len(char_counts)
            if3 char_counts[j] > char_counts[max_idx]
                let max_idx = j
            end
            let j = j + 1
        end
        if3 max_idx != i
            let tc = char_counts[i]
            let char_counts[i] = char_counts[max_idx]
            let char_counts[max_idx] = tc
            let tk = char_keys[i]
            let char_keys[i] = char_keys[max_idx]
            let char_keys[max_idx] = tk
        end
        let i = i + 1
    end

    let i = 0
    while3 i < len(char_keys)
        let bar = ""
        let b = 0
        while3 b < char_counts[i]
            let bar = bar + "|"
            let b = b + 1
        end
        print("  '" + char_keys[i] + "' : " + str(char_counts[i]) + "  " + bar)
        let i = i + 1
    end

    // Unique counts
    print("\nUnique words: " + str(len(word_keys)))
    print("Unique chars: " + str(len(char_keys)))

    print("\nTernary result: +1 (success)")
    let result = +1
fail3
    print("ERROR: Frequency counting failed")
    print("Ternary result: -1 (fail)")
    let result = -1
end

return result
