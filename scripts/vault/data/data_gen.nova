// data_gen.nova - Generate fake test data (names, emails, IPs, dates)
// NovaX Script Vault | Data Category

let result = +1

try3
    print("=== Fake Test Data Generator ===")

    // Name pools
    let first_names = ["Alice", "Bob", "Charlie", "Diana", "Eve", "Frank", "Grace", "Hank", "Ivy", "Jack", "Karen", "Leo", "Mia", "Noah", "Olivia"]
    let last_names = ["Smith", "Johnson", "Williams", "Brown", "Jones", "Davis", "Miller", "Wilson", "Moore", "Taylor", "Anderson", "Thomas", "White", "Harris", "Clark"]
    let domains = ["example.com", "test.org", "demo.net", "sample.io", "mock.dev"]
    let cities = ["New York", "London", "Tokyo", "Paris", "Berlin", "Sydney", "Toronto", "Mumbai", "Seoul", "Dubai"]
    let roles = ["engineer", "designer", "manager", "analyst", "developer", "architect", "tester", "admin"]

    let num_records = 10
    print("Generating " + str(num_records) + " fake records...\n")

    let records = []
    let i = 0
    while3 i < num_records
        let first_idx = random_int(0, len(first_names) - 1)
        let last_idx = random_int(0, len(last_names) - 1)
        let domain_idx = random_int(0, len(domains) - 1)
        let city_idx = random_int(0, len(cities) - 1)
        let role_idx = random_int(0, len(roles) - 1)

        let first = first_names[first_idx]
        let last = last_names[last_idx]
        let full_name = first + " " + last

        // Generate email (lowercase first.last@domain)
        let email_local = replace(first, " ", "") + "." + replace(last, " ", "")
        let email = email_local + "@" + domains[domain_idx]

        // Generate IP address
        let ip_a = random_int(1, 254)
        let ip_b = random_int(0, 255)
        let ip_c = random_int(0, 255)
        let ip_d = random_int(1, 254)
        let ip = str(ip_a) + "." + str(ip_b) + "." + str(ip_c) + "." + str(ip_d)

        // Generate date (2024-01-01 to 2025-12-31)
        let year = random_int(2024, 2025)
        let month = random_int(1, 12)
        let day = random_int(1, 28)
        let month_str = str(month)
        if3 month < 10
            let month_str = "0" + month_str
        end
        let day_str = str(day)
        if3 day < 10
            let day_str = "0" + day_str
        end
        let date = str(year) + "-" + month_str + "-" + day_str

        // Generate age and salary
        let age = random_int(22, 65)
        let salary = random_int(40, 200) * 1000

        let record = {}
        let record = dict_set(record, "id", i + 1)
        let record = dict_set(record, "name", full_name)
        let record = dict_set(record, "email", email)
        let record = dict_set(record, "ip", ip)
        let record = dict_set(record, "city", cities[city_idx])
        let record = dict_set(record, "role", roles[role_idx])
        let record = dict_set(record, "age", age)
        let record = dict_set(record, "salary", salary)
        let record = dict_set(record, "joined", date)

        let records = append(records, record)

        print("  #" + str(i + 1) + " " + full_name + " | " + email + " | " + ip + " | " + cities[city_idx] + " | " + roles[role_idx])
        let i = i + 1
    end

    // Output as JSON
    print("\nJSON output:")
    print(json_encode(records))

    // Stats
    print("\n--- Generation Stats ---")
    print("Records generated: " + str(len(records)))
    print("Name pool: " + str(len(first_names)) + " x " + str(len(last_names)) + " = " + str(len(first_names) * len(last_names)) + " combinations")
    print("Domain pool: " + str(len(domains)))
    print("City pool: " + str(len(cities)))

    print("\nTernary result: +1 (success)")
    let result = +1
fail3
    print("ERROR: Data generation failed")
    print("Ternary result: -1 (fail)")
    let result = -1
end

return result
