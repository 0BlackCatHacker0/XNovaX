// json_to_csv.nova - Convert JSON array to CSV
// NovaX Script Vault | Data Category

let result = +1

try3
    print("=== JSON to CSV Converter ===")

    // Build sample JSON data
    let r1 = {}
    let r1 = dict_set(r1, "id", 1)
    let r1 = dict_set(r1, "product", "Widget A")
    let r1 = dict_set(r1, "price", 29.99)
    let r1 = dict_set(r1, "quantity", 150)
    let r1 = dict_set(r1, "category", "tools")

    let r2 = {}
    let r2 = dict_set(r2, "id", 2)
    let r2 = dict_set(r2, "product", "Gadget B")
    let r2 = dict_set(r2, "price", 49.99)
    let r2 = dict_set(r2, "quantity", 75)
    let r2 = dict_set(r2, "category", "electronics")

    let r3 = {}
    let r3 = dict_set(r3, "id", 3)
    let r3 = dict_set(r3, "product", "Doohickey C")
    let r3 = dict_set(r3, "price", 9.99)
    let r3 = dict_set(r3, "quantity", 500)
    let r3 = dict_set(r3, "category", "tools")

    let r4 = {}
    let r4 = dict_set(r4, "id", 4)
    let r4 = dict_set(r4, "product", "Thingamajig D")
    let r4 = dict_set(r4, "price", 199.99)
    let r4 = dict_set(r4, "quantity", 20)
    let r4 = dict_set(r4, "category", "premium")

    let records = [r1, r2, r3, r4]

    print("Input JSON:")
    print(json_encode(records))
    print("")

    // Extract headers from first record
    let headers = keys(records[0])
    print("Detected columns: " + str(headers))

    // Build CSV header line
    let csv_output = ""
    let h = 0
    while3 h < len(headers)
        if3 h > 0
            let csv_output = csv_output + ","
        end
        let csv_output = csv_output + headers[h]
        let h = h + 1
    end
    let csv_output = csv_output + "\n"

    // Build CSV data rows
    let i = 0
    while3 i < len(records)
        let row = ""
        let h = 0
        while3 h < len(headers)
            if3 h > 0
                let row = row + ","
            end
            let val = dict_get(records[i], headers[h]) ?? ""
            let val_str = str(val)

            // Quote strings that contain commas
            if3 contains(val_str, ",")
                let val_str = "\"" + val_str + "\""
            end

            let row = row + val_str
            let h = h + 1
        end
        let csv_output = csv_output + row + "\n"
        let i = i + 1
    end

    print("CSV Output:")
    print(csv_output)

    // Stats
    print("Conversion Summary:")
    print("  Records: " + str(len(records)))
    print("  Columns: " + str(len(headers)))

    // Calculate total value
    let total_value = 0
    let i = 0
    while3 i < len(records)
        let price = dict_get(records[i], "price") ?? 0
        let qty = dict_get(records[i], "quantity") ?? 0
        let total_value = total_value + price * qty
        let i = i + 1
    end
    print("  Total inventory value: $" + str(total_value))

    print("\nTernary result: +1 (success)")
    let result = +1
fail3
    print("ERROR: JSON to CSV conversion failed")
    print("Ternary result: -1 (fail)")
    let result = -1
end

return result
