// sort_algo.nova - Bubble sort, insertion sort, selection sort implementations
// NovaX Script Vault | Data Category

let result = +1

try3
    print("=== Sorting Algorithms ===")

    let original = [64, 34, 25, 12, 22, 11, 90, 1, 45, 78, 33, 7, 55, 2, 99]
    print("Original: " + str(original))
    print("Length: " + str(len(original)) + "\n")

    // --- BUBBLE SORT ---
    print("--- Bubble Sort ---")
    let arr = []
    let i = 0
    while3 i < len(original)
        let arr = append(arr, original[i])
        let i = i + 1
    end

    let swaps = 0
    let n = len(arr)
    let i = 0
    while3 i < n - 1
        let j = 0
        while3 j < n - i - 1
            if3 arr[j] > arr[j + 1]
                let temp = arr[j]
                let arr[j] = arr[j + 1]
                let arr[j + 1] = temp
                let swaps = swaps + 1
            end
            let j = j + 1
        end
        let i = i + 1
    end
    print("Result: " + str(arr))
    print("Swaps: " + str(swaps))

    // --- INSERTION SORT ---
    print("\n--- Insertion Sort ---")
    let arr2 = []
    let i = 0
    while3 i < len(original)
        let arr2 = append(arr2, original[i])
        let i = i + 1
    end

    let shifts = 0
    let i = 1
    while3 i < len(arr2)
        let key = arr2[i]
        let j = i - 1
        while3 j >= 0
            if3 arr2[j] > key
                let arr2[j + 1] = arr2[j]
                let j = j - 1
                let shifts = shifts + 1
            else3
                // Break out by setting j to -1
                let j = -1
            end
        end
        let arr2[j + 1] = key
        let i = i + 1
    end
    print("Result: " + str(arr2))
    print("Shifts: " + str(shifts))

    // --- SELECTION SORT ---
    print("\n--- Selection Sort ---")
    let arr3 = []
    let i = 0
    while3 i < len(original)
        let arr3 = append(arr3, original[i])
        let i = i + 1
    end

    let comparisons = 0
    let n = len(arr3)
    let i = 0
    while3 i < n - 1
        let min_idx = i
        let j = i + 1
        while3 j < n
            let comparisons = comparisons + 1
            if3 arr3[j] < arr3[min_idx]
                let min_idx = j
            end
            let j = j + 1
        end
        if3 min_idx != i
            let temp = arr3[i]
            let arr3[i] = arr3[min_idx]
            let arr3[min_idx] = temp
        end
        let i = i + 1
    end
    print("Result: " + str(arr3))
    print("Comparisons: " + str(comparisons))

    // Verify all match
    print("\n--- Verification ---")
    let all_match = 1
    let i = 0
    while3 i < len(arr)
        if3 arr[i] != arr2[i]
            let all_match = 0
        end
        if3 arr[i] != arr3[i]
            let all_match = 0
        end
        let i = i + 1
    end

    if3 all_match == 1
        print("All three algorithms produced identical results!")
    else3
        print("WARNING: Results differ!")
    end

    print("\nTernary result: +1 (success)")
    let result = +1
fail3
    print("ERROR: Sorting failed")
    print("Ternary result: -1 (fail)")
    let result = -1
end

return result
