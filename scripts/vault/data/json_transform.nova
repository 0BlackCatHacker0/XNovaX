// json_transform.nova - Transform/filter JSON data (extract keys, flatten, merge)
// NovaX Script Vault | Data Category

let result = +1

try3
    print("=== JSON Transformer ===")

    // --- BUILD TEST DATA ---
    let user1 = {}
    let user1 = dict_set(user1, "name", "Alice")
    let user1 = dict_set(user1, "age", 30)
    let user1 = dict_set(user1, "role", "engineer")
    let user1 = dict_set(user1, "active", true)

    let user2 = {}
    let user2 = dict_set(user2, "name", "Bob")
    let user2 = dict_set(user2, "age", 25)
    let user2 = dict_set(user2, "role", "designer")
    let user2 = dict_set(user2, "active", false)

    let user3 = {}
    let user3 = dict_set(user3, "name", "Charlie")
    let user3 = dict_set(user3, "age", 35)
    let user3 = dict_set(user3, "role", "engineer")
    let user3 = dict_set(user3, "active", true)

    let users = [user1, user2, user3]
    print("Source data: " + json_encode(users))

    // --- EXTRACT SPECIFIC KEYS ---
    print("\n--- Extract Keys (name, role) ---")
    let extracted = []
    let i = 0
    while3 i < len(users)
        let item = {}
        let item = dict_set(item, "name", dict_get(users[i], "name") ?? "")
        let item = dict_set(item, "role", dict_get(users[i], "role") ?? "")
        let extracted = append(extracted, item)
        let i = i + 1
    end
    print("Result: " + json_encode(extracted))

    // --- FILTER (active users only) ---
    print("\n--- Filter (active == true) ---")
    let active_users = []
    let i = 0
    while3 i < len(users)
        let is_active = dict_get(users[i], "active") ?? false
        if3 is_active == true
            let active_users = append(active_users, users[i])
        end
        let i = i + 1
    end
    print("Active users: " + json_encode(active_users))
    print("Count: " + str(len(active_users)) + " of " + str(len(users)))

    // --- FILTER BY ROLE ---
    print("\n--- Filter (role == engineer) ---")
    let engineers = []
    let i = 0
    while3 i < len(users)
        let role = dict_get(users[i], "role") ?? ""
        if3 role == "engineer"
            let engineers = append(engineers, dict_get(users[i], "name") ?? "")
        end
        let i = i + 1
    end
    print("Engineers: " + str(engineers))

    // --- MERGE TWO DICTS ---
    print("\n--- Merge Dicts ---")
    let base = {}
    let base = dict_set(base, "version", "1.0")
    let base = dict_set(base, "env", "production")
    let base = dict_set(base, "debug", false)

    let override = {}
    let override = dict_set(override, "env", "staging")
    let override = dict_set(override, "debug", true)
    let override = dict_set(override, "verbose", true)

    // Merge: override wins
    let merged = {}
    let base_keys = keys(base)
    let i = 0
    while3 i < len(base_keys)
        let k = base_keys[i]
        let merged = dict_set(merged, k, dict_get(base, k) ?? "")
        let i = i + 1
    end
    let override_keys = keys(override)
    let i = 0
    while3 i < len(override_keys)
        let k = override_keys[i]
        let merged = dict_set(merged, k, dict_get(override, k) ?? "")
        let i = i + 1
    end

    print("Base:     " + json_encode(base))
    print("Override: " + json_encode(override))
    print("Merged:   " + json_encode(merged))

    // --- ADD COMPUTED FIELD ---
    print("\n--- Add Computed Field (senior: age >= 30) ---")
    let enriched = []
    let i = 0
    while3 i < len(users)
        let u = users[i]
        let age = dict_get(u, "age") ?? 0
        let is_senior = age >= 30
        let u = dict_set(u, "senior", is_senior)
        let enriched = append(enriched, u)
        let i = i + 1
    end
    print("Result: " + json_encode(enriched))

    print("\nTernary result: +1 (success)")
    let result = +1
fail3
    print("ERROR: JSON transform failed")
    print("Ternary result: -1 (fail)")
    let result = -1
end

return result
