// csv_to_json.nova - Convert CSV file to JSON
// NovaX Script Vault | Data Category

let result = +1

try3
    print("=== CSV to JSON Converter ===")

    // Create sample CSV data
    let csv_data = "name,age,city,score\nAlice,30,New York,95\nBob,25,London,88\nCharlie,35,Tokyo,92\nDiana,28,Paris,97\nEve,31,Sydney,85"

    // Save CSV to temp file
    let csv_path = "C:/NovaX/scripts/vault/data/_temp_sample.csv"
    write_file(csv_path, csv_data)
    print("Input CSV:")
    print(csv_data)
    print("")

    // Parse CSV
    let lines = split(csv_data, "\n")
    let header_line = lines[0]
    let headers = split(header_line, ",")

    print("Headers: " + str(headers))
    print("Data rows: " + str(len(lines) - 1))
    print("")

    // Convert each row to a dict
    let records = []
    let i = 1
    while3 i < len(lines)
        let line = trim(lines[i])
        if3 len(line) > 0
            let values = split(line, ",")
            let record = {}
            let j = 0
            while3 j < len(headers)
                let key = trim(headers[j])
                let val = trim(values[j])

                // Try to convert numeric values
                // Check if it's a number by seeing if it contains only digits
                let is_num = 1
                let k = 0
                while3 k < len(val)
                    let ch = val[k]
                    if3 ch != "0"
                        if3 ch != "1"
                            if3 ch != "2"
                                if3 ch != "3"
                                    if3 ch != "4"
                                        if3 ch != "5"
                                            if3 ch != "6"
                                                if3 ch != "7"
                                                    if3 ch != "8"
                                                        if3 ch != "9"
                                                            let is_num = 0
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                    let k = k + 1
                end

                if3 is_num == 1
                    if3 len(val) > 0
                        let record = dict_set(record, key, int(val))
                    else3
                        let record = dict_set(record, key, val)
                    end
                else3
                    let record = dict_set(record, key, val)
                end

                let j = j + 1
            end
            let records = append(records, record)
        end
        let i = i + 1
    end

    // Output JSON
    let json_output = json_encode(records)
    print("JSON Output:")
    print(json_output)

    // Save JSON
    let json_path = "C:/NovaX/scripts/vault/data/_temp_sample.json"
    write_file(json_path, json_output)
    print("\nSaved to: " + json_path)

    // Summary
    print("\nConversion Summary:")
    print("  Records converted: " + str(len(records)))
    print("  Fields per record: " + str(len(headers)))
    print("  CSV size: " + str(len(csv_data)) + " chars")
    print("  JSON size: " + str(len(json_output)) + " chars")

    // Clean up temp files
    shell("del /q \"C:\\NovaX\\scripts\\vault\\data\\_temp_sample.csv\" \"C:\\NovaX\\scripts\\vault\\data\\_temp_sample.json\" 2>NUL")

    print("\nTernary result: +1 (success)")
    let result = +1
fail3
    print("ERROR: CSV to JSON conversion failed")
    print("Ternary result: -1 (fail)")
    let result = -1
end

return result
