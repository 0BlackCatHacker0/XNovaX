// search_algo.nova - Linear search, binary search implementations
// NovaX Script Vault | Data Category

let result = +1

try3
    print("=== Search Algorithms ===")

    // Sorted dataset for searching
    let data = [2, 5, 8, 12, 16, 23, 38, 45, 56, 72, 91, 100, 113, 127, 243]
    print("Dataset: " + str(data))
    print("Size: " + str(len(data)) + "\n")

    let targets = [23, 243, 1, 72, 50, 2, 127, 999]

    // --- LINEAR SEARCH ---
    print("--- Linear Search ---")
    let t = 0
    while3 t < len(targets)
        let target = targets[t]
        let found = -1
        let steps = 0
        let i = 0
        while3 i < len(data)
            let steps = steps + 1
            if3 data[i] == target
                let found = i
                let i = len(data)
            end
            let i = i + 1
        end

        if3 found >= 0
            print("  " + str(target) + " -> found at index " + str(found) + " (" + str(steps) + " steps)")
        else3
            print("  " + str(target) + " -> NOT FOUND (" + str(steps) + " steps)")
        end
        let t = t + 1
    end

    // --- BINARY SEARCH ---
    print("\n--- Binary Search ---")
    let t = 0
    while3 t < len(targets)
        let target = targets[t]
        let low = 0
        let high = len(data) - 1
        let found = -1
        let steps = 0

        while3 low <= high
            let steps = steps + 1
            let mid = floor((low + high) / 2)

            if3 data[mid] == target
                let found = mid
                let low = high + 1
            else3
                if3 data[mid] < target
                    let low = mid + 1
                else3
                    let high = mid - 1
                end
            end
        end

        if3 found >= 0
            print("  " + str(target) + " -> found at index " + str(found) + " (" + str(steps) + " steps)")
        else3
            print("  " + str(target) + " -> NOT FOUND (" + str(steps) + " steps)")
        end
        let t = t + 1
    end

    // --- COMPARISON ---
    print("\n--- Efficiency Comparison ---")
    print("Dataset size: " + str(len(data)))
    print("Linear search worst case: " + str(len(data)) + " comparisons")
    // log2(15) ~ 3.9 -> ceil = 4
    let log2_n = log(len(data)) / log(2)
    let log2_ceil = ceil(log2_n)
    print("Binary search worst case: " + str(log2_ceil) + " comparisons")
    print("Binary search is ~" + str(floor(len(data) / log2_ceil)) + "x faster for this dataset")

    // --- FIND MIN/MAX ---
    print("\n--- Find Min/Max (linear scan) ---")
    let min_val = data[0]
    let max_val = data[0]
    let min_idx = 0
    let max_idx = 0
    let i = 1
    while3 i < len(data)
        if3 data[i] < min_val
            let min_val = data[i]
            let min_idx = i
        end
        if3 data[i] > max_val
            let max_val = data[i]
            let max_idx = i
        end
        let i = i + 1
    end
    print("Min: " + str(min_val) + " at index " + str(min_idx))
    print("Max: " + str(max_val) + " at index " + str(max_idx))

    print("\nTernary result: +1 (success)")
    let result = +1
fail3
    print("ERROR: Search algorithms failed")
    print("Ternary result: -1 (fail)")
    let result = -1
end

return result
