// dedup_list.nova - Remove duplicates from a list/file
// NovaX Script Vault | Data Category

let result = +1

try3
    print("=== Deduplication Tool ===")

    // --- NUMERIC DEDUP ---
    print("--- Numeric List Dedup ---")
    let nums = [3, 7, 3, 1, 7, 13, 5, 3, 13, 7, 5, 1, 3, 243, 7, 2187, 243, 5]
    print("Original: " + str(nums))
    print("Length: " + str(len(nums)))

    let unique_nums = []
    let i = 0
    while3 i < len(nums)
        let found = 0
        let j = 0
        while3 j < len(unique_nums)
            if3 unique_nums[j] == nums[i]
                let found = 1
            end
            let j = j + 1
        end
        if3 found == 0
            let unique_nums = append(unique_nums, nums[i])
        end
        let i = i + 1
    end

    print("Deduped: " + str(unique_nums))
    print("Unique count: " + str(len(unique_nums)))
    let removed = len(nums) - len(unique_nums)
    print("Duplicates removed: " + str(removed))

    // --- STRING DEDUP ---
    print("\n--- String List Dedup ---")
    let strings = ["alpha", "beta", "gamma", "alpha", "delta", "beta", "epsilon", "gamma", "alpha", "zeta", "beta"]
    print("Original: " + str(strings))
    print("Length: " + str(len(strings)))

    let unique_strings = []
    let dup_counts = []
    let i = 0
    while3 i < len(strings)
        let found = -1
        let j = 0
        while3 j < len(unique_strings)
            if3 unique_strings[j] == strings[i]
                let found = j
            end
            let j = j + 1
        end
        if3 found == -1
            let unique_strings = append(unique_strings, strings[i])
            let dup_counts = append(dup_counts, 1)
        else3
            let dup_counts[found] = dup_counts[found] + 1
        end
        let i = i + 1
    end

    print("Deduped: " + str(unique_strings))
    print("Unique count: " + str(len(unique_strings)))

    // Show duplicate report
    print("\nDuplicate report:")
    let i = 0
    while3 i < len(unique_strings)
        let label = ""
        if3 dup_counts[i] > 1
            let label = " (appeared " + str(dup_counts[i]) + " times)"
        end
        print("  " + unique_strings[i] + label)
        let i = i + 1
    end

    // --- PRESERVE ORDER vs SORTED ---
    print("\n--- Order Preservation ---")
    let data = [5, 2, 8, 2, 5, 1, 8, 3, 1, 5]
    print("Input: " + str(data))

    // Order-preserved dedup (already done above style)
    let ordered = []
    let i = 0
    while3 i < len(data)
        let found = 0
        let j = 0
        while3 j < len(ordered)
            if3 ordered[j] == data[i]
                let found = 1
            end
            let j = j + 1
        end
        if3 found == 0
            let ordered = append(ordered, data[i])
        end
        let i = i + 1
    end
    print("Order-preserved: " + str(ordered))

    // Sorted dedup (sort first, then dedup adjacent)
    let sorted = []
    let i = 0
    while3 i < len(data)
        let sorted = append(sorted, data[i])
        let i = i + 1
    end
    // Bubble sort
    let n = len(sorted)
    let i = 0
    while3 i < n - 1
        let j = 0
        while3 j < n - i - 1
            if3 sorted[j] > sorted[j + 1]
                let temp = sorted[j]
                let sorted[j] = sorted[j + 1]
                let sorted[j + 1] = temp
            end
            let j = j + 1
        end
        let i = i + 1
    end
    // Adjacent dedup
    let sorted_unique = [sorted[0]]
    let i = 1
    while3 i < len(sorted)
        if3 sorted[i] != sorted[i - 1]
            let sorted_unique = append(sorted_unique, sorted[i])
        end
        let i = i + 1
    end
    print("Sorted unique:    " + str(sorted_unique))

    // --- STATS ---
    print("\n--- Dedup Statistics ---")
    let total_items = len(nums) + len(strings) + len(data)
    let total_unique = len(unique_nums) + len(unique_strings) + len(ordered)
    let total_dups = total_items - total_unique
    let dup_pct = floor(total_dups * 100 / total_items)
    print("Total items processed: " + str(total_items))
    print("Total unique: " + str(total_unique))
    print("Total duplicates: " + str(total_dups) + " (" + str(dup_pct) + "%)")

    print("\nTernary result: +1 (success)")
    let result = +1
fail3
    print("ERROR: Deduplication failed")
    print("Ternary result: -1 (fail)")
    let result = -1
end

return result
