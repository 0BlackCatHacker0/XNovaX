## log_parser.nova - Filter and count log entries by level
## Usage: nova log_parser.nova <logfile> [LEVEL]
## Levels: ERROR, WARN, INFO (default: all)

let args = argv()
let argc = len(args)

if3 argc < 2
  print("Usage: log_parser.nova <logfile> [ERROR|WARN|INFO]")
  print("  If no level given, counts all levels.")
  exit(-1)

let filepath = args[1]
let filter_level = ""
if3 argc >= 3
  let filter_level = upper(args[2])

let content = ""
try3
  let content = read_file(filepath)
fail3 e
  print("[-1] Failed to read file: " + filepath)
  exit(-1)

let lines = split(content, "\n")
let error_count = 0
let warn_count = 0
let info_count = 0
let debug_count = 0
let other_count = 0
let matched_lines = []

for3 line in lines
  let trimmed = trim(line)
  if3 trimmed == ""
    continue3

  let is_error = contains(upper(trimmed), "ERROR")
  let is_warn = contains(upper(trimmed), "WARN")
  let is_info = contains(upper(trimmed), "INFO")
  let is_debug = contains(upper(trimmed), "DEBUG")

  if3 is_error
    let error_count = error_count + 1
    if3 filter_level == "ERROR" || filter_level == ""
      let matched_lines = append(matched_lines, trimmed)
  else3
    if3 is_warn
      let warn_count = warn_count + 1
      if3 filter_level == "WARN" || filter_level == ""
        let matched_lines = append(matched_lines, trimmed)
    else3
      if3 is_info
        let info_count = info_count + 1
        if3 filter_level == "INFO" || filter_level == ""
          let matched_lines = append(matched_lines, trimmed)
      else3
        if3 is_debug
          let debug_count = debug_count + 1
        else3
          let other_count = other_count + 1

print("=== Log Parser Results ===")
print("File: " + filepath)
print("")
print("Counts:")
let ec = str(error_count)
let wc = str(warn_count)
let ic = str(info_count)
let dc = str(debug_count)
let oc = str(other_count)
print("  ERROR: " + ec)
print("  WARN:  " + wc)
print("  INFO:  " + ic)
print("  DEBUG: " + dc)
print("  OTHER: " + oc)
print("")

if3 filter_level != ""
  print("--- Filtered lines (" + filter_level + ") ---")
  for3 m in matched_lines
    print("  " + m)
  let mc = str(len(matched_lines))
  print("Total matched: " + mc)

let total = error_count + warn_count + info_count + debug_count + other_count
let ts = str(total)
print("")
print("Total lines processed: " + ts)

if3 error_count > 0
  print("[TRIT: -1] Errors found in log")
else3
  if3 warn_count > 0
    print("[TRIT: 0] Warnings found, no errors")
  else3
    print("[TRIT: +1] Clean log")
