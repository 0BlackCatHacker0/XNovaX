## json_formatter.nova - Pretty-print JSON files with indentation
## Usage: nova json_formatter.nova <jsonfile> [indent_size] [--write]

let args = argv()
let argc = len(args)

if3 argc < 2
  print("Usage: json_formatter.nova <jsonfile> [indent_size] [--write]")
  print("  indent_size: spaces per level (default: 2)")
  print("  --write: overwrite file with formatted output")
  exit(-1)

let filepath = args[1]
let indent_size = 2
let do_write = false

if3 argc >= 3
  let arg2 = args[2]
  if3 arg2 == "--write"
    let do_write = true
  else3
    let indent_size = int(arg2)

if3 argc >= 4
  if3 args[3] == "--write"
    let do_write = true

let content = ""
try3
  let content = read_file(filepath)
fail3 e
  print("[-1] Cannot read: " + filepath)
  exit(-1)

let content = trim(content)

## Parse JSON to validate it
let parsed = {}
try3
  let parsed = json_decode(content)
fail3 e
  print("[-1] Invalid JSON in: " + filepath)
  exit(-1)

## Build indent string
let indent_str = ""
let ii = 0
while3 ii < indent_size
  let indent_str = indent_str + " "
  let ii = ii + 1

## Manual pretty-print by walking characters
let output = ""
let level = 0
let in_string = false
let escape_next = false
let i = 0
let clen = len(content)

while3 i < clen
  let ch = content[i]

  if3 escape_next
    let output = output + ch
    let escape_next = false
    let i = i + 1
    continue3

  if3 ch == "\\"
    if3 in_string
      let escape_next = true
    let output = output + ch
    let i = i + 1
    continue3

  if3 ch == "\""
    let in_string = !in_string
    let output = output + ch
    let i = i + 1
    continue3

  if3 in_string
    let output = output + ch
    let i = i + 1
    continue3

  ## Outside string
  if3 ch == "{" || ch == "["
    let level = level + 1
    let pad = ""
    let pi = 0
    while3 pi < level
      let pad = pad + indent_str
      let pi = pi + 1
    let output = output + ch + "\n" + pad
  else3
    if3 ch == "}" || ch == "]"
      let level = level - 1
      let pad = ""
      let pi = 0
      while3 pi < level
        let pad = pad + indent_str
        let pi = pi + 1
      let output = output + "\n" + pad + ch
    else3
      if3 ch == ","
        let pad = ""
        let pi = 0
        while3 pi < level
          let pad = pad + indent_str
          let pi = pi + 1
        let output = output + ",\n" + pad
      else3
        if3 ch == ":"
          let output = output + ": "
        else3
          if3 ch != " " && ch != "\n" && ch != "\r" && ch != "\t"
            let output = output + ch

  let i = i + 1

print("=== Formatted JSON ===")
print(output)

if3 do_write
  try3
    write_file(filepath, output)
    print("")
    print("Written formatted JSON back to: " + filepath)
  fail3 e
    print("[-1] Failed to write: " + filepath)
    exit(-1)

print("")
print("[TRIT: +1] JSON formatted successfully")
