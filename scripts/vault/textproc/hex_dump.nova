## hex_dump.nova - Show hex dump of a file
## Usage: nova hex_dump.nova <file> [bytes_limit]

let args = argv()
let argc = len(args)

if3 argc < 2
  print("Usage: hex_dump.nova <file> [bytes_limit]")
  print("  bytes_limit: max bytes to display (default: 256)")
  exit(-1)

let filepath = args[1]
let max_bytes = 256
if3 argc >= 3
  let max_bytes = int(args[2])

## Use certutil -encodehex for hex dump
let cmd = "certutil -encodehex \"" + filepath + "\" - 4"
let result = shell(cmd)

print("=== Hex Dump: " + filepath + " ===")
print("Offset    00 01 02 03 04 05 06 07 08 09 0a 0b 0c 0d 0e 0f  |ASCII|")
print("--------  -----------------------------------------------  ------")

if3 result["ok"] == 1
  let output = trim(result["stdout"])
  if3 output == ""
    print("[-1] File is empty or not found")
    exit(-1)
  ## certutil -encodehex mode 4 outputs raw hex, limit output lines
  let lines = split(output, "\n")
  let max_lines = max_bytes / 16
  if3 max_lines < 1
    let max_lines = 1
  let li = 0
  let bytes_shown = 0
  while3 li < len(lines) && li < max_lines
    let line = trim(lines[li])
    if3 line != ""
      print(line)
      let bytes_shown = bytes_shown + 16
    let li = li + 1
  print("---")
  print("Bytes displayed: up to " + str(max_bytes))
  print("")
  print("[TRIT: +1] Hex dump complete")
else3
  let err = dict_get(result, "stderr") ?? "Unknown error"
  if3 contains(err, "find") || contains(err, "not exist")
    print("[-1] ERROR:FILE_NOT_FOUND")
  else3
    print("[-1] Failed to generate hex dump: " + err)
  exit(-1)
