## string_replace.nova - Search and replace text in files
## Usage: nova string_replace.nova <file> <search> <replace> [--dry-run]

let args = argv()
let argc = len(args)

if3 argc < 4
  print("Usage: string_replace.nova <file> <search> <replace> [--dry-run]")
  print("  --dry-run: show changes without writing")
  exit(-1)

let filepath = args[1]
let search = args[2]
let replacement = args[3]
let dry_run = false

if3 argc >= 5
  if3 args[4] == "--dry-run"
    let dry_run = true

let content = ""
try3
  let content = read_file(filepath)
fail3 e
  print("[-1] Cannot read: " + filepath)
  exit(-1)

## Count occurrences before replacing
let lines = split(content, "\n")
let match_count = 0
let changed_lines = []

let li = 0
for3 line in lines
  let ln = li + 1
  let lns = str(ln)
  if3 contains(line, search)
    let match_count = match_count + 1
    let old_display = "  - L" + lns + ": " + trim(line)
    let new_line = replace(line, search, replacement)
    let new_display = "  + L" + lns + ": " + trim(new_line)
    let changed_lines = append(changed_lines, old_display)
    let changed_lines = append(changed_lines, new_display)
  let li = li + 1

let ms = str(match_count)
print("=== String Replace ===")
print("File:    " + filepath)
print("Search:  '" + search + "'")
print("Replace: '" + replacement + "'")
print("Matches: " + ms)
print("")

if3 match_count == 0
  print("No matches found.")
  print("[TRIT: 0] Nothing to replace")
  exit(0)

print("Changes:")
for3 cl in changed_lines
  print(cl)
print("")

if3 dry_run
  print("[DRY RUN] No changes written.")
  print("[TRIT: 0] Dry run complete")
else3
  let new_content = replace(content, search, replacement)
  try3
    write_file(filepath, new_content)
    print("File updated successfully.")
    print("[TRIT: +1] " + ms + " replacements made")
  fail3 e
    print("[-1] Failed to write file")
    exit(-1)
