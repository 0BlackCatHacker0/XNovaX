## base64_tool.nova - Encode/decode Base64 strings
## Usage: nova base64_tool.nova encode <text>
##        nova base64_tool.nova decode <base64string>
##        nova base64_tool.nova encode-file <filepath>

let args = argv()
let argc = len(args)

if3 argc < 3
  print("Usage: base64_tool.nova <encode|decode|encode-file> <text|file>")
  exit(-1)

let mode = lower(args[1])
let input = args[2]

## Base64 alphabet
let b64chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

if3 mode == "encode" || mode == "encode-file"
  let text = input
  if3 mode == "encode-file"
    try3
      let text = read_file(input)
    fail3 e
      print("[-1] Cannot read: " + input)
      exit(-1)

  ## Write text to temp file, use certutil to encode
  let tmp_in = "C:\\NovaX\\tmp\\b64_in.tmp"
  let tmp_out = "C:\\NovaX\\tmp\\b64_out.tmp"
  write_file(tmp_in, text)
  let cmd = "certutil -encode " + tmp_in + " " + tmp_out + " >nul 2>&1 && type " + tmp_out
  let result = shell(cmd)

  if3 result["ok"] == 1
    ## certutil adds header/footer lines, strip them
    let raw = trim(result["stdout"])
    let lines = split(raw, "\n")
    let encoded = ""
    let li = 0
    while3 li < len(lines)
      let line = trim(lines[li])
      if3 line != "-----BEGIN CERTIFICATE-----" && line != "-----END CERTIFICATE-----" && line != ""
        let encoded = encoded + line
      let li = li + 1
    print("=== Base64 Encode ===")
    if3 mode == "encode-file"
      print("Source: " + input)
    else3
      print("Input:  " + text)
    print("Output: " + encoded)
    print("")
    print("[TRIT: +1] Encoded successfully")
  else3
    print("[-1] Encoding failed")
    exit(-1)

  ## Cleanup temp files
  shell("del /q " + tmp_in + " " + tmp_out + " 2>nul")

else3
  if3 mode == "decode"
    ## Write base64 with certutil header/footer to temp, decode with certutil
    let tmp_in = "C:\\NovaX\\tmp\\b64d_in.tmp"
    let tmp_out = "C:\\NovaX\\tmp\\b64d_out.tmp"
    let b64_content = "-----BEGIN CERTIFICATE-----\n" + input + "\n-----END CERTIFICATE-----"
    write_file(tmp_in, b64_content)
    let cmd = "certutil -decode " + tmp_in + " " + tmp_out + " >nul 2>&1 && type " + tmp_out
    let result = shell(cmd)

    if3 result["ok"] == 1
      let decoded = result["stdout"]
      print("=== Base64 Decode ===")
      print("Input:  " + input)
      print("Output: " + decoded)
      print("")
      print("[TRIT: +1] Decoded successfully")
    else3
      print("[-1] Invalid Base64 or decode error")
      exit(-1)

    ## Cleanup temp files
    shell("del /q " + tmp_in + " " + tmp_out + " 2>nul")
  else3
    print("[-1] Unknown mode: " + mode)
    print("Use: encode, decode, or encode-file")
    exit(-1)
