## line_counter.nova - Count lines, words, characters (like wc)
## Usage: nova line_counter.nova <file1> [file2] [file3] ...

let args = argv()
let argc = len(args)

if3 argc < 2
  print("Usage: line_counter.nova <file1> [file2] ...")
  exit(-1)

let total_lines = 0
let total_words = 0
let total_chars = 0
let total_bytes = 0
let file_count = 0
let fail_count = 0

## Header
print("   Lines    Words    Chars  File")
print("  ------  -------  -------  ----")

let fi = 1
while3 fi < argc
  let filepath = args[fi]
  let content = ""
  try3
    let content = read_file(filepath)
  fail3 e
    print("  [FAIL]  Cannot read: " + filepath)
    let fail_count = fail_count + 1
    let fi = fi + 1
    continue3

  let char_count = len(content)
  let lines = split(content, "\n")
  let line_count = len(lines)

  ## Count words by splitting on whitespace
  let word_count = 0
  for3 line in lines
    let trimmed = trim(line)
    if3 trimmed == ""
      continue3
    let words = split(trimmed, " ")
    for3 w in words
      let tw = trim(w)
      if3 tw != ""
        let word_count = word_count + 1

  ## Format output with padding
  let ls = str(line_count)
  let ws = str(word_count)
  let cs = str(char_count)

  let lpad = ""
  let lpi = 0
  while3 lpi < 8 - len(ls)
    let lpad = lpad + " "
    let lpi = lpi + 1

  let wpad = ""
  let wpi = 0
  while3 wpi < 8 - len(ws)
    let wpad = wpad + " "
    let wpi = wpi + 1

  let cpad = ""
  let cpi = 0
  while3 cpi < 8 - len(cs)
    let cpad = cpad + " "
    let cpi = cpi + 1

  print(lpad + ls + wpad + ws + cpad + cs + "  " + filepath)

  let total_lines = total_lines + line_count
  let total_words = total_words + word_count
  let total_chars = total_chars + char_count
  let file_count = file_count + 1
  let fi = fi + 1

## Print totals if multiple files
if3 file_count > 1
  print("  ------  -------  -------  ----")
  let tls = str(total_lines)
  let tws = str(total_words)
  let tcs = str(total_chars)

  let tlpad = ""
  let tli = 0
  while3 tli < 8 - len(tls)
    let tlpad = tlpad + " "
    let tli = tli + 1

  let twpad = ""
  let twi = 0
  while3 twi < 8 - len(tws)
    let twpad = twpad + " "
    let twi = twi + 1

  let tcpad = ""
  let tci = 0
  while3 tci < 8 - len(tcs)
    let tcpad = tcpad + " "
    let tci = tci + 1

  print(tlpad + tls + twpad + tws + tcpad + tcs + "  TOTAL")

let fcs = str(file_count)
let ffs = str(fail_count)
print("")
print("Files processed: " + fcs + " | Failed: " + ffs)

if3 fail_count > 0
  if3 file_count == 0
    print("[TRIT: -1] All files failed")
  else3
    print("[TRIT: 0] Some files failed")
else3
  print("[TRIT: +1] All files counted")
