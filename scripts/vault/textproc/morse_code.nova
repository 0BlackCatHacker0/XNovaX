## morse_code.nova - Convert text to/from Morse code
## Usage: nova morse_code.nova encode <text>
##        nova morse_code.nova decode <morse_string>

let args = argv()
let argc = len(args)

if3 argc < 3
  print("Usage: morse_code.nova <encode|decode> <text>")
  print("  Morse uses dots (.) and dashes (-)")
  print("  Letters separated by spaces, words by ' / '")
  exit(-1)

let mode = lower(args[1])

## Collect full input text
let input = args[2]
let ai = 3
while3 ai < argc
  let input = input + " " + args[ai]
  let ai = ai + 1

## Morse code lookup dict
let morse = {}
let morse = dict_set(morse, "A", ".-")
let morse = dict_set(morse, "B", "-...")
let morse = dict_set(morse, "C", "-.-.")
let morse = dict_set(morse, "D", "-..")
let morse = dict_set(morse, "E", ".")
let morse = dict_set(morse, "F", "..-.")
let morse = dict_set(morse, "G", "--.")
let morse = dict_set(morse, "H", "....")
let morse = dict_set(morse, "I", "..")
let morse = dict_set(morse, "J", ".---")
let morse = dict_set(morse, "K", "-.-")
let morse = dict_set(morse, "L", ".-..")
let morse = dict_set(morse, "M", "--")
let morse = dict_set(morse, "N", "-.")
let morse = dict_set(morse, "O", "---")
let morse = dict_set(morse, "P", ".--.")
let morse = dict_set(morse, "Q", "--.-")
let morse = dict_set(morse, "R", ".-.")
let morse = dict_set(morse, "S", "...")
let morse = dict_set(morse, "T", "-")
let morse = dict_set(morse, "U", "..-")
let morse = dict_set(morse, "V", "...-")
let morse = dict_set(morse, "W", ".--")
let morse = dict_set(morse, "X", "-..-")
let morse = dict_set(morse, "Y", "-.--")
let morse = dict_set(morse, "Z", "--..")
let morse = dict_set(morse, "0", "-----")
let morse = dict_set(morse, "1", ".----")
let morse = dict_set(morse, "2", "..---")
let morse = dict_set(morse, "3", "...--")
let morse = dict_set(morse, "4", "....-")
let morse = dict_set(morse, "5", ".....")
let morse = dict_set(morse, "6", "-....")
let morse = dict_set(morse, "7", "--...")
let morse = dict_set(morse, "8", "---..")
let morse = dict_set(morse, "9", "----.")

## Build reverse lookup
let reverse = {}
let reverse = dict_set(reverse, ".-", "A")
let reverse = dict_set(reverse, "-...", "B")
let reverse = dict_set(reverse, "-.-.", "C")
let reverse = dict_set(reverse, "-..", "D")
let reverse = dict_set(reverse, ".", "E")
let reverse = dict_set(reverse, "..-.", "F")
let reverse = dict_set(reverse, "--.", "G")
let reverse = dict_set(reverse, "....", "H")
let reverse = dict_set(reverse, "..", "I")
let reverse = dict_set(reverse, ".---", "J")
let reverse = dict_set(reverse, "-.-", "K")
let reverse = dict_set(reverse, ".-..", "L")
let reverse = dict_set(reverse, "--", "M")
let reverse = dict_set(reverse, "-.", "N")
let reverse = dict_set(reverse, "---", "O")
let reverse = dict_set(reverse, ".--.", "P")
let reverse = dict_set(reverse, "--.-", "Q")
let reverse = dict_set(reverse, ".-.", "R")
let reverse = dict_set(reverse, "...", "S")
let reverse = dict_set(reverse, "-", "T")
let reverse = dict_set(reverse, "..-", "U")
let reverse = dict_set(reverse, "...-", "V")
let reverse = dict_set(reverse, ".--", "W")
let reverse = dict_set(reverse, "-..-", "X")
let reverse = dict_set(reverse, "-.--", "Y")
let reverse = dict_set(reverse, "--..", "Z")
let reverse = dict_set(reverse, "-----", "0")
let reverse = dict_set(reverse, ".----", "1")
let reverse = dict_set(reverse, "..---", "2")
let reverse = dict_set(reverse, "...--", "3")
let reverse = dict_set(reverse, "....-", "4")
let reverse = dict_set(reverse, ".....", "5")
let reverse = dict_set(reverse, "-....", "6")
let reverse = dict_set(reverse, "--...", "7")
let reverse = dict_set(reverse, "---..", "8")
let reverse = dict_set(reverse, "----.", "9")

if3 mode == "encode"
  let text = upper(input)
  let output = ""
  let i = 0
  let unknown = 0
  while3 i < len(text)
    let ch = text[i]
    if3 ch == " "
      let output = output + " / "
    else3
      let code = dict_get(morse, ch) ?? ""
      if3 code != ""
        if3 i > 0 && output != "" && !ends_with(output, "/ ")
          let output = output + " "
        let output = output + code
      else3
        let unknown = unknown + 1
    let i = i + 1

  print("=== Morse Encode ===")
  print("Input:  " + input)
  print("Morse:  " + output)
  if3 unknown > 0
    let us = str(unknown)
    print("Skipped " + us + " unsupported characters")
    print("[TRIT: 0] Encoded with skipped chars")
  else3
    print("[TRIT: +1] Encoded successfully")

else3
  if3 mode == "decode"
    ## Split by " / " for words, then by " " for letters
    let words = split(input, " / ")
    let output = ""
    let unknown = 0

    for3 word in words
      let letters = split(word, " ")
      for3 code in letters
        let c = trim(code)
        if3 c == ""
          continue3
        let letter = dict_get(reverse, c) ?? "?"
        if3 letter == "?"
          let unknown = unknown + 1
        let output = output + letter
      let output = output + " "

    let output = trim(output)
    print("=== Morse Decode ===")
    print("Morse: " + input)
    print("Text:  " + output)
    if3 unknown > 0
      let us = str(unknown)
      print("Unknown codes: " + us)
      print("[TRIT: 0] Decoded with unknown codes")
    else3
      print("[TRIT: +1] Decoded successfully")
  else3
    print("[-1] Unknown mode: " + mode)
    print("Use: encode or decode")
    exit(-1)
