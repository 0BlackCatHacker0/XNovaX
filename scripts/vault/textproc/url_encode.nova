## url_encode.nova - URL encode/decode strings
## Usage: nova url_encode.nova encode <string>
##        nova url_encode.nova decode <encoded_string>

let args = argv()
let argc = len(args)

if3 argc < 3
  print("Usage: url_encode.nova <encode|decode> <string>")
  exit(-1)

let mode = lower(args[1])
let input = args[2]

## Collect remaining args as part of input (spaces)
let ai = 3
while3 ai < argc
  let input = input + " " + args[ai]
  let ai = ai + 1

if3 mode == "encode"
  ## NovaLang replace chain for URL encoding
  let output = ""
  let safe = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~"
  let i = 0
  while3 i < len(input)
    let ch = input[i]
    if3 contains(safe, ch)
      let output = output + ch
    else3
      if3 ch == " "
        let output = output + "%20"
      else3
        if3 ch == "&"
          let output = output + "%26"
        else3
          if3 ch == "="
            let output = output + "%3D"
          else3
            if3 ch == "?"
              let output = output + "%3F"
            else3
              if3 ch == "/"
                let output = output + "%2F"
              else3
                if3 ch == ":"
                  let output = output + "%3A"
                else3
                  if3 ch == "#"
                    let output = output + "%23"
                  else3
                    if3 ch == "@"
                      let output = output + "%40"
                    else3
                      if3 ch == "+"
                        let output = output + "%2B"
                      else3
                        if3 ch == "!"
                          let output = output + "%21"
                        else3
                          if3 ch == "$"
                            let output = output + "%24"
                          else3
                            if3 ch == "'"
                              let output = output + "%27"
                            else3
                              if3 ch == "("
                                let output = output + "%28"
                              else3
                                if3 ch == ")"
                                  let output = output + "%29"
                                else3
                                  if3 ch == "*"
                                    let output = output + "%2A"
                                  else3
                                    if3 ch == ","
                                      let output = output + "%2C"
                                    else3
                                      if3 ch == ";"
                                        let output = output + "%3B"
                                      else3
                                        if3 ch == "%"
                                          let output = output + "%25"
                                        else3
                                          let output = output + ch
    let i = i + 1
  print("=== URL Encode ===")
  print("Input:   " + input)
  print("Encoded: " + output)
  print("")
  print("[TRIT: +1] URL encoded successfully")

else3
  if3 mode == "decode"
    ## NovaLang replace chain for URL decoding
    let output = replace(input, "%20", " ")
    let output = replace(output, "%26", "&")
    let output = replace(output, "%3D", "=")
    let output = replace(output, "%3d", "=")
    let output = replace(output, "%3F", "?")
    let output = replace(output, "%3f", "?")
    let output = replace(output, "%2F", "/")
    let output = replace(output, "%2f", "/")
    let output = replace(output, "%3A", ":")
    let output = replace(output, "%3a", ":")
    let output = replace(output, "%23", "#")
    let output = replace(output, "%40", "@")
    let output = replace(output, "%2B", "+")
    let output = replace(output, "%2b", "+")
    let output = replace(output, "%21", "!")
    let output = replace(output, "%24", "$")
    let output = replace(output, "%27", "'")
    let output = replace(output, "%28", "(")
    let output = replace(output, "%29", ")")
    let output = replace(output, "%2A", "*")
    let output = replace(output, "%2a", "*")
    let output = replace(output, "%2C", ",")
    let output = replace(output, "%2c", ",")
    let output = replace(output, "%3B", ";")
    let output = replace(output, "%3b", ";")
    let output = replace(output, "%25", "%")
    let output = replace(output, "+", " ")
    print("=== URL Decode ===")
    print("Input:   " + input)
    print("Decoded: " + output)
    print("")
    print("[TRIT: +1] URL decoded successfully")
  else3
    print("[-1] Unknown mode: " + mode)
    print("Use: encode or decode")
    exit(-1)
