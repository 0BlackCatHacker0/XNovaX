## diff_files.nova - Compare two files line by line
## Usage: nova diff_files.nova <file1> <file2>

let args = argv()
let argc = len(args)

if3 argc < 3
  print("Usage: diff_files.nova <file1> <file2>")
  exit(-1)

let file1 = args[1]
let file2 = args[2]

let content1 = ""
let content2 = ""

try3
  let content1 = read_file(file1)
fail3 e
  print("[-1] Cannot read: " + file1)
  exit(-1)

try3
  let content2 = read_file(file2)
fail3 e
  print("[-1] Cannot read: " + file2)
  exit(-1)

let lines1 = split(content1, "\n")
let lines2 = split(content2, "\n")
let len1 = len(lines1)
let len2 = len(lines2)
let max_len = len1
if3 len2 > max_len
  let max_len = len2

let diff_count = 0
let add_count = 0
let del_count = 0
let same_count = 0
let diff_lines = []

let i = 0
while3 i < max_len
  let ln = i + 1
  let lns = str(ln)

  if3 i < len1 && i < len2
    let l1 = lines1[i]
    let l2 = lines2[i]
    if3 l1 == l2
      let same_count = same_count + 1
    else3
      let diff_count = diff_count + 1
      let diff_lines = append(diff_lines, "Line " + lns + ":")
      let diff_lines = append(diff_lines, "  - " + l1)
      let diff_lines = append(diff_lines, "  + " + l2)
      let diff_lines = append(diff_lines, "")
  else3
    if3 i < len1
      let l1 = lines1[i]
      let del_count = del_count + 1
      let diff_lines = append(diff_lines, "Line " + lns + ":")
      let diff_lines = append(diff_lines, "  - " + l1)
      let diff_lines = append(diff_lines, "")
    else3
      let l2 = lines2[i]
      let add_count = add_count + 1
      let diff_lines = append(diff_lines, "Line " + lns + ":")
      let diff_lines = append(diff_lines, "  + " + l2)
      let diff_lines = append(diff_lines, "")

  let i = i + 1

print("=== Diff: " + file1 + " vs " + file2 + " ===")
print("")

let l1s = str(len1)
let l2s = str(len2)
print("File 1: " + file1 + " (" + l1s + " lines)")
print("File 2: " + file2 + " (" + l2s + " lines)")
print("")

if3 diff_count == 0 && add_count == 0 && del_count == 0
  print("Files are identical.")
  print("[TRIT: +1] Files match")
else3
  let ds = str(diff_count)
  let as_ = str(add_count)
  let dls = str(del_count)
  let ss = str(same_count)
  print("Changed: " + ds + " | Added: " + as_ + " | Removed: " + dls + " | Same: " + ss)
  print("")
  print("--- Differences ---")
  for3 dl in diff_lines
    print(dl)

  let total_diff = diff_count + add_count + del_count
  let total_lines = same_count + total_diff
  if3 total_lines > 0
    let pct = (same_count * 100) / total_lines
    let pcts = str(pct)
    print("Similarity: ~" + pcts + "%")

  if3 total_diff > 10
    print("[TRIT: -1] Files significantly different")
  else3
    print("[TRIT: 0] Files have minor differences")
