## csv_reader.nova - Read CSV and display as formatted table
## Usage: nova csv_reader.nova <csvfile> [max_rows]

let args = argv()
let argc = len(args)

if3 argc < 2
  print("Usage: csv_reader.nova <csvfile> [max_rows]")
  exit(-1)

let filepath = args[1]
let max_rows = 50
if3 argc >= 3
  let max_rows = int(args[2])

let content = ""
try3
  let content = read_file(filepath)
fail3 e
  print("[-1] Failed to read: " + filepath)
  exit(-1)

let lines = split(content, "\n")
let total_lines = len(lines)

## Parse all rows into list of lists
let rows = []
let col_widths = []
let num_cols = 0

for3 line in lines
  let trimmed = trim(line)
  if3 trimmed == ""
    continue3
  let cells = split(trimmed, ",")
  let cleaned = []
  let ci = 0
  for3 cell in cells
    let val = trim(cell)
    let cleaned = append(cleaned, val)
    let vlen = len(val)
    if3 ci >= len(col_widths)
      let col_widths = append(col_widths, vlen)
    else3
      if3 vlen > col_widths[ci]
        let col_widths[ci] = vlen
    let ci = ci + 1
  let rows = append(rows, cleaned)
  if3 len(cells) > num_cols
    let num_cols = len(cells)

## Build separator line
let sep = "+"
let si = 0
while3 si < len(col_widths)
  let w = col_widths[si]
  let dashes = ""
  let di = 0
  while3 di < w + 2
    let dashes = dashes + "-"
    let di = di + 1
  let sep = sep + dashes + "+"
  let si = si + 1

## Print table
print("=== CSV Table: " + filepath + " ===")
print(sep)

let row_num = 0
let displayed = 0
for3 row in rows
  if3 displayed >= max_rows + 1
    break3
  let line_out = "|"
  let ri = 0
  while3 ri < len(col_widths)
    let val = ""
    if3 ri < len(row)
      let val = row[ri]
    let padding = col_widths[ri] - len(val)
    let pad_str = ""
    let pi = 0
    while3 pi < padding
      let pad_str = pad_str + " "
      let pi = pi + 1
    let line_out = line_out + " " + val + pad_str + " |"
    let ri = ri + 1
  print(line_out)
  if3 row_num == 0
    print(sep)
  let row_num = row_num + 1
  let displayed = displayed + 1

print(sep)

let data_rows = len(rows) - 1
let drs = str(data_rows)
let ncs = str(num_cols)
print("")
print("Rows: " + drs + " | Columns: " + ncs)

if3 data_rows > 0
  print("[TRIT: +1] CSV parsed successfully")
else3
  print("[TRIT: 0] CSV empty or header only")
