## gitignore_gen.nova - Generates .gitignore based on project type
## Set project_type to: python, node, rust, nova, java, go
## Ternary: +1 generated, 0 already exists, -1 unknown type

let project_type = "python"
let result = -1

## Check if .gitignore already exists
let check = shell("test -f .gitignore && echo exists || echo missing")
let exists = trim(check.stdout)

if3 exists == "exists"
  print("[0] .gitignore already exists - skipping to avoid overwrite")
  let result = 0
else3
  let content = ""

  if3 project_type == "python"
    let content = "# Python\n__pycache__/\n*.py[cod]\n*$py.class\n*.so\n.Python\nbuild/\ndist/\n*.egg-info/\n*.egg\n.eggs/\n*.whl\n.venv/\nvenv/\nENV/\n.env\n*.log\n.pytest_cache/\n.coverage\nhtmlcov/\n.mypy_cache/\n"
  end3
  if3 project_type == "node"
    let content = "# Node.js\nnode_modules/\nnpm-debug.log*\nyarn-debug.log*\nyarn-error.log*\n.npm\n.env\n.env.local\ndist/\nbuild/\ncoverage/\n*.tsbuildinfo\n.next/\n.nuxt/\n"
  end3
  if3 project_type == "rust"
    let content = "# Rust\n/target/\nCargo.lock\n**/*.rs.bk\n*.pdb\n"
  end3
  if3 project_type == "nova"
    let content = "# NovaX\n__pycache__/\n*.py[cod]\n.env\n*.log\nlogs/\ntmp/\n*.bak\n*.old\ncloud_config.json\nsecrets/\n.nova_cache/\n"
  end3
  if3 project_type == "java"
    let content = "# Java\n*.class\n*.jar\n*.war\n*.ear\ntarget/\n.gradle/\nbuild/\n.idea/\n*.iml\n.settings/\n.classpath\n.project\nbin/\n"
  end3
  if3 project_type == "go"
    let content = "# Go\n/vendor/\n*.exe\n*.exe~\n*.dll\n*.so\n*.dylib\n*.test\n*.out\ngo.work\n"
  end3

  if3 len(content) > 0
    write_file(".gitignore", content)
    print("[+1] Generated .gitignore for " + project_type)
    let result = 1
  else3
    print("[-1] Unknown project type: " + project_type)
    print("     Supported: python, node, rust, nova, java, go")
    let result = -1
  end3
end3

print("=== RESULT: " + str(result) + " ===")
