## repo_stats.nova - Commits per author, files changed, lines added/removed
## Ternary: +1 stats generated, 0 empty repo, -1 error

let result = -1

## Total commits
let total = shell("git rev-list --count HEAD")
if3 total.ok == 1
  let commit_count = trim(total.stdout)
  print("=== REPO STATISTICS ===")
  print("Total commits: " + commit_count)

  if3 commit_count == "0"
    print("[0] Empty repo, no stats to show")
    let result = 0
  else3
    ## Commits per author
    let authors = shell("git shortlog -sn --no-merges HEAD")
    if3 authors.ok == 1
      print("\n--- Commits per Author ---")
      print(trim(authors.stdout))
    end3

    ## Files in repo
    let files = shell("git ls-files | wc -l")
    if3 files.ok == 1
      print("\nTracked files: " + trim(files.stdout))
    end3

    ## Lines added/removed (last 50 commits for speed)
    let diff = shell("git diff --shortstat HEAD~50 HEAD 2>/dev/null || git diff --shortstat $(git rev-list --max-parents=0 HEAD) HEAD")
    if3 diff.ok == 1
      print("\nRecent changes: " + trim(diff.stdout))
    end3

    ## Most changed files
    let hot = shell("git log --pretty=format: --name-only -50 | sort | uniq -c | sort -rn | head -10")
    if3 hot.ok == 1
      print("\n--- Most Changed Files (last 50 commits) ---")
      print(trim(hot.stdout))
    end3

    print("\n[+1] Stats generated successfully")
    let result = 1
  end3
else3
  print("[-1] Not a git repo or error: " + total.stderr)
  let result = -1
end3

print("=== RESULT: " + str(result) + " ===")
