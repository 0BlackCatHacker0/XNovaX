## changelog_gen.nova - Generates changelog from git log grouped by type
## Conventions: feat:, fix:, docs:, refactor:, test:, chore:
## Ternary: +1 generated, 0 no commits, -1 error

let result = -1
let output_file = "CHANGELOG_NOVA.md"

let log = shell("git log --oneline --no-merges -100")
if3 log.ok == 1
  let lines = split(trim(log.stdout), "\n")
  if3 len(lines) == 0
    print("[0] No commits found")
    let result = 0
  else3
    let feats = []
    let fixes = []
    let docs = []
    let refactors = []
    let tests = []
    let chores = []
    let other = []

    let i = 0
    while3 i < len(lines)
      let line = trim(lines[i])
      if3 len(line) > 0
        if3 contains(line, "feat:")
          let feats = append(feats, line)
        else3
          if3 contains(line, "fix:")
            let fixes = append(fixes, line)
          else3
            if3 contains(line, "docs:")
              let docs = append(docs, line)
            else3
              if3 contains(line, "refactor:")
                let refactors = append(refactors, line)
              else3
                if3 contains(line, "test:")
                  let tests = append(tests, line)
                else3
                  if3 contains(line, "chore:")
                    let chores = append(chores, line)
                  else3
                    let other = append(other, line)
                  end3
                end3
              end3
            end3
          end3
        end3
      end3
      let i = i + 1
    end3

    let md = "# Changelog (NovaX Generated)\n\n"

    if3 len(feats) > 0
      let md = md + "## Features\n"
      let j = 0
      while3 j < len(feats)
        let md = md + "- " + feats[j] + "\n"
        let j = j + 1
      end3
      let md = md + "\n"
    end3

    if3 len(fixes) > 0
      let md = md + "## Bug Fixes\n"
      let j = 0
      while3 j < len(fixes)
        let md = md + "- " + fixes[j] + "\n"
        let j = j + 1
      end3
      let md = md + "\n"
    end3

    if3 len(docs) > 0
      let md = md + "## Documentation\n"
      let j = 0
      while3 j < len(docs)
        let md = md + "- " + docs[j] + "\n"
        let j = j + 1
      end3
      let md = md + "\n"
    end3

    if3 len(refactors) > 0
      let md = md + "## Refactoring\n"
      let j = 0
      while3 j < len(refactors)
        let md = md + "- " + refactors[j] + "\n"
        let j = j + 1
      end3
      let md = md + "\n"
    end3

    if3 len(tests) > 0
      let md = md + "## Tests\n"
      let j = 0
      while3 j < len(tests)
        let md = md + "- " + tests[j] + "\n"
        let j = j + 1
      end3
      let md = md + "\n"
    end3

    if3 len(chores) > 0
      let md = md + "## Chores\n"
      let j = 0
      while3 j < len(chores)
        let md = md + "- " + chores[j] + "\n"
        let j = j + 1
      end3
      let md = md + "\n"
    end3

    if3 len(other) > 0
      let md = md + "## Other\n"
      let j = 0
      while3 j < len(other)
        let md = md + "- " + other[j] + "\n"
        let j = j + 1
      end3
      let md = md + "\n"
    end3

    write_file(output_file, md)
    let total = len(feats) + len(fixes) + len(docs) + len(refactors) + len(tests) + len(chores) + len(other)
    print("[+1] Changelog generated: " + output_file + " (" + str(total) + " entries)")
    let result = 1
  end3
else3
  print("[-1] Git log failed: " + log.stderr)
  let result = -1
end3

print("=== RESULT: " + str(result) + " ===")
