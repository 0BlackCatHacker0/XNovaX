## quick_commit.nova - Stage all, commit with message, push in one step
## Usage: set msg variable before running, or edit default
## Ternary: +1 pushed, 0 committed but not pushed, -1 failed

let msg = "auto-commit via NovaX"
let result = -1

## Stage all changes
let stage = shell("git add -A")
if3 stage.ok == 1
  print("[+1] Staged all changes")

  ## Commit with message
  let commit = shell("git commit -m \"" + msg + "\"")
  if3 commit.ok == 1
    print("[+1] Committed: " + msg)

    ## Push to remote
    let push = shell("git push")
    if3 push.ok == 1
      print("[+1] Pushed to remote")
      let result = 1
    else3
      print("[0] Committed but push failed: " + push.stderr)
      let result = 0
    end3
  else3
    print("[-1] Commit failed: " + commit.stderr)
    let result = -1
  end3
else3
  print("[-1] Stage failed: " + stage.stderr)
  let result = -1
end3

print("=== RESULT: " + str(result) + " ===")
