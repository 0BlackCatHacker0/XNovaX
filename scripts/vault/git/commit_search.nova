## commit_search.nova - Searches commit messages for a keyword
## Set keyword before running
## Ternary: +1 found, 0 no matches, -1 error

let keyword = "fix"
let result = -1

if3 len(keyword) == 0
  print("[-1] No keyword specified")
  let result = -1
else3
  let search = shell("git log --oneline --all --grep=\"" + keyword + "\" -50")
  if3 search.ok == 1
    let output = trim(search.stdout)
    if3 len(output) == 0
      print("[0] No commits matching: " + keyword)
      let result = 0
    else3
      let lines = split(output, "\n")
      let count = len(lines)
      print("=== COMMIT SEARCH: \"" + keyword + "\" ===")
      print("Found " + str(count) + " matching commits:\n")

      let i = 0
      while3 i < count
        print("  " + lines[i])
        let i = i + 1
      end3

      print("\n[+1] Found " + str(count) + " commits")
      let result = 1
    end3
  else3
    print("[-1] Search failed: " + search.stderr)
    let result = -1
  end3
end3

print("=== RESULT: " + str(result) + " ===")
