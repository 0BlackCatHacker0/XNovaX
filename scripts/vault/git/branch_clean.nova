## branch_clean.nova - Deletes local branches already merged to main
## Ternary: +1 cleaned, 0 nothing to clean, -1 error

let result = -1
let cleaned = 0

## Get merged branches
let merged = shell("git branch --merged main")
if3 merged.ok != 1
  ## Try master instead
  let merged = shell("git branch --merged master")
end3

if3 merged.ok == 1
  let lines = split(trim(merged.stdout), "\n")
  let i = 0
  while3 i < len(lines)
    let branch = trim(lines[i])
    ## Skip main, master, and current branch (marked with *)
    if3 starts_with(branch, "*") == 0
      if3 branch != "main"
        if3 branch != "master"
          if3 len(branch) > 0
            let del = shell("git branch -d \"" + branch + "\"")
            if3 del.ok == 1
              print("[+1] Deleted: " + branch)
              let cleaned = cleaned + 1
            else3
              print("[-1] Failed to delete: " + branch)
            end3
          end3
        end3
      end3
    end3
    let i = i + 1
  end3

  if3 cleaned > 0
    print("[+1] Cleaned " + str(cleaned) + " merged branches")
    let result = 1
  else3
    print("[0] No merged branches to clean")
    let result = 0
  end3
else3
  print("[-1] Could not list merged branches: " + merged.stderr)
  let result = -1
end3

print("=== RESULT: " + str(result) + " ===")
