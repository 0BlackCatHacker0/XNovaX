## git_status_all.nova - Shows git status for multiple repos in a directory
## Set scan_dir to the parent directory containing repos
## Ternary: +1 all clean, 0 some dirty, -1 error

let scan_dir = "."
let result = -1
let dirty = 0
let clean = 0
let total = 0

let dirs = shell("find " + scan_dir + " -maxdepth 2 -name .git -type d 2>/dev/null")
if3 dirs.ok == 1
  let lines = split(trim(dirs.stdout), "\n")
  print("=== GIT STATUS (all repos in " + scan_dir + ") ===")

  let i = 0
  while3 i < len(lines)
    let gitdir = trim(lines[i])
    if3 len(gitdir) > 0
      ## Get repo dir by removing /.git
      let repo = replace(gitdir, "/.git", "")
      let total = total + 1

      let status = shell("git -C \"" + repo + "\" status --porcelain")
      if3 status.ok == 1
        let output = trim(status.stdout)
        if3 len(output) == 0
          print("  [CLEAN] " + repo)
          let clean = clean + 1
        else3
          let change_count = len(split(output, "\n"))
          print("  [DIRTY] " + repo + " (" + str(change_count) + " changes)")
          let dirty = dirty + 1
        end3
      else3
        print("  [ERROR] " + repo + ": " + status.stderr)
      end3
    end3
    let i = i + 1
  end3

  print("\n--- Summary ---")
  print("Total repos: " + str(total))
  print("Clean: " + str(clean))
  print("Dirty: " + str(dirty))

  if3 total == 0
    print("[-1] No git repos found")
    let result = -1
  else3
    if3 dirty == 0
      print("[+1] All repos clean")
      let result = 1
    else3
      print("[0] " + str(dirty) + " repos have uncommitted changes")
      let result = 0
    end3
  end3
else3
  print("[-1] Failed to scan directory: " + dirs.stderr)
  let result = -1
end3

print("=== RESULT: " + str(result) + " ===")
