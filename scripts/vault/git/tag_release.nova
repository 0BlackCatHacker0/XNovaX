## tag_release.nova - Creates a semver tag and pushes it
## Set version and tag_msg before running
## Ternary: +1 tagged and pushed, 0 tagged but not pushed, -1 error

let version = "v1.0.0"
let tag_msg = "Release " + version
let result = -1

## Validate semver format (basic check)
if3 starts_with(version, "v") == 0
  let version = "v" + version
end3

## Check if tag already exists
let check = shell("git tag -l \"" + version + "\"")
if3 check.ok == 1
  let existing = trim(check.stdout)
  if3 len(existing) > 0
    print("[-1] Tag " + version + " already exists")
    let result = -1
  else3
    ## Create annotated tag
    let tag = shell("git tag -a \"" + version + "\" -m \"" + tag_msg + "\"")
    if3 tag.ok == 1
      print("[+1] Created tag: " + version)

      ## Push tag to remote
      let push = shell("git push origin \"" + version + "\"")
      if3 push.ok == 1
        print("[+1] Pushed tag to remote")
        let result = 1
      else3
        print("[0] Tag created locally but push failed: " + push.stderr)
        let result = 0
      end3
    else3
      print("[-1] Failed to create tag: " + tag.stderr)
      let result = -1
    end3
  end3
else3
  print("[-1] Not a git repo: " + check.stderr)
  let result = -1
end3

print("=== RESULT: " + str(result) + " ===")
