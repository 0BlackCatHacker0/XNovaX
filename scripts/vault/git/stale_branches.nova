## stale_branches.nova - Lists branches with no commits in N days
## Ternary: +1 found stale, 0 none stale, -1 error

let max_days = 30
let result = -1
let stale_count = 0

let branches = shell("git for-each-ref --sort=-committerdate --format='%(refname:short)|%(committerdate:unix)|%(committerdate:relative)|%(authorname)' refs/heads/")
if3 branches.ok == 1
  let now = time()
  let threshold = max_days * 86400
  let lines = split(trim(branches.stdout), "\n")

  print("=== STALE BRANCHES (>" + str(max_days) + " days) ===")

  let i = 0
  while3 i < len(lines)
    let line = trim(lines[i])
    if3 len(line) > 0
      let parts = split(line, "|")
      if3 len(parts) >= 4
        let branch = parts[0]
        let ts = int(parts[1])
        let relative = parts[2]
        let author = parts[3]
        let age = now - ts

        if3 age > threshold
          let stale_count = stale_count + 1
          print("  [STALE] " + branch + " - last commit " + relative + " by " + author)
        end3
      end3
    end3
    let i = i + 1
  end3

  if3 stale_count > 0
    print("\n[+1] Found " + str(stale_count) + " stale branches")
    let result = 1
  else3
    print("\n[0] No stale branches found")
    let result = 0
  end3
else3
  print("[-1] Failed to list branches: " + branches.stderr)
  let result = -1
end3

print("=== RESULT: " + str(result) + " ===")
