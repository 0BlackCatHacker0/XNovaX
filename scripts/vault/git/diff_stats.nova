## diff_stats.nova - Shows file change statistics for last N commits
## Set num_commits to control range
## Ternary: +1 stats shown, 0 no changes, -1 error

let num_commits = 10
let result = -1

let log = shell("git log --stat --oneline -" + str(num_commits))
if3 log.ok == 1
  let output = trim(log.stdout)
  if3 len(output) == 0
    print("[0] No commits found")
    let result = 0
  else3
    print("=== DIFF STATS (last " + str(num_commits) + " commits) ===\n")
    print(output)

    ## Get summary totals
    let summary = shell("git diff --stat HEAD~" + str(num_commits) + " HEAD 2>/dev/null")
    if3 summary.ok == 1
      print("\n--- Aggregate Summary ---")
      let sum_lines = split(trim(summary.stdout), "\n")
      ## Last line has the summary
      if3 len(sum_lines) > 0
        print(sum_lines[len(sum_lines) - 1])
      end3
    end3

    ## Top changed files
    let top = shell("git diff --stat HEAD~" + str(num_commits) + " HEAD 2>/dev/null | head -10")
    if3 top.ok == 1
      print("\n--- Top Changed Files ---")
      print(trim(top.stdout))
    end3

    print("\n[+1] Stats generated for last " + str(num_commits) + " commits")
    let result = 1
  end3
else3
  print("[-1] Git log failed: " + log.stderr)
  let result = -1
end3

print("=== RESULT: " + str(result) + " ===")
