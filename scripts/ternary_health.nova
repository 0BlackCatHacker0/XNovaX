// ternary_health.nova — System-wide ternary health monitor
// Uses: if3, match3, try3, health3, cmp3, bt, bool3
// Every construct here is ternary-native. No binary fallbacks.

print("=== NovaX Ternary Health Monitor ===")
print("Checking 13 services with balanced ternary...")
print("")

// Get system health as 13-trit balanced ternary number
ha = health3_all()
bt_health = ha["bt"]
healthy = ha["healthy"]
degraded = ha["degraded"]
down = ha["down"]
overall = ha["overall_trit"]

print(f"System BT: {bt_health}")
print(f"Healthy: {healthy} | Degraded: {degraded} | Down: {down}")
print("")

// Three-way branch on overall system health
if3 overall {
  print("SYSTEM: ALL HEALTHY (+1)")
} maybe {
  print("SYSTEM: DEGRADED — some services slow (0)")
} else {
  print("SYSTEM: CRITICAL — services down (-1)")
}

print("")

// Show service trits (avoid nested blocks)
services = ha["services"]
for3 svc in services {
  name = svc["name"]
  ch = svc["char"]
  port = svc["port"]
  print(f"  [{ch}] {name} :{port}")
}

print("")

// Balanced ternary operations on health string
neg_health = bt_neg(bt_health)
tc = trit_count(bt_health)
print(f"Health trits: {tc}")
print(f"Negated: {neg_health}")

// Compare healthy vs down using ternary comparison
health_cmp = cmp3(healthy, down)

if3 health_cmp {
  print("More UP than DOWN — operational")
} maybe {
  print("Equal UP and DOWN — threshold")
} else {
  print("More DOWN than UP — needs attention")
}

print("")
print("=== Ternary Health Complete ===")
