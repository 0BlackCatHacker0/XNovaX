// tmatmul_demo.nova — Ternary Matrix Multiplication Demo
// Tests all algorithms and prints FLOP comparison tables

print("=== NovaX Ternary MatMul Demo ===")
print("")

// FLOP comparison for 3^5 = 243 (TZip unit)
print("--- FLOP Table: N=243 (3^5 TZip) ---")
let table243 = tmatmul_flops(243)
print(table243)
print("")

// FLOP comparison for 3^7 = 2187 (BLOCK_SIZE)
print("--- FLOP Table: N=2187 (3^7 BLOCK) ---")
let table2187 = tmatmul_flops(2187)
print(table2187)
print("")

// Benchmark 27x27 (3^3) matmul — all algorithms
print("--- Benchmark: 27x27x27 ---")
let bench27 = tmatmul_bench(27, 27, 27)
for3 result in bench27
    print(result)
end
print("")

// Benchmark 81x81 (3^4) matmul
print("--- Benchmark: 81x81x81 ---")
let bench81 = tmatmul_bench(81, 81, 81)
for3 result in bench81
    print(result)
end
print("")

// Small manual matmul: 2x3 * 3x2
print("--- Manual: 2x3 * 3x2 ---")
let a = [1, 2, 3, 4, 5, 6]
let b = [1, -1, 0, 1, -1, 0]
let result = tmatmul(a, b, 2, 3, 2)
print(result)

print("")
print("=== Ternary MatMul: 3-10x faster than FP16 ===")
print("No multiplies. Only add/sub/skip. Pure ternary power.")
