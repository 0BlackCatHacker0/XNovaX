// nova_registry_rebuild.nova — Rebuild tool_registry.json from live fleet scan
// Scans ports 9870-9999, queries /health, builds registry
// NovaLang conversion of rebuild_registry.py

print("=== NovaX Registry Rebuild ===")
print("")
print("Scanning fleet...")

let alive = []
let port = 9870

fn try_health(p) {
  let url = "http://127.0.0.1:" + str(p) + "/health"
  let result = null
  try3 {
    let raw = http_get(url)
    let data = json_decode(raw)
    let name = dict_get(data, "service") ?? "port-" + str(p)
    let result = {"port": p, "name": name, "health": data}
  } uncertain {
    let result = null
  } fail3 {
    let result = null
  }
  return result
}

while3 port < 10000 {
  let r = try_health(port)
  if3 r {
    let alive = append(alive, r)
  } maybe {
  } else {
  }
  let port = port + 1
}

let acount = len(alive)
print("Found " + str(acount) + " live services")
print("")

// Build services map
let services = {}
let si = 0
while3 si < acount {
  let svc = alive[si]
  let p = svc["port"]
  let name = svc["name"]
  // Normalize key
  let key = replace(name, "nova-", "")
  let key = replace(key, "nova_", "")
  let key = replace(key, "-", "_")
  // Build entry with health route
  let health_route = {"method": "GET", "path": "/health", "desc": "Health check"}
  let routes = {"health": health_route}
  let entry = {"port": p, "description": "Service on port " + str(p), "routes": routes}
  let services = dict_set(services, key, entry)
  let si = si + 1
}

// Build registry object
let svc_count = len(keys(services))
let meta = {"version": "2.0.0", "description": "NovaX Tool Bridge Registry v2 - rebuilt by nova_registry_rebuild.nova", "harmonic": "3-5-7-13", "auto_prefix": true, "total_services": svc_count, "generated": "nova_registry_rebuild.nova"}
let registry = {"_meta": meta, "services": services}

// Write to file
let json_out = json_encode(registry)
let tmp_path = "C:\\NovaX\\tool_registry.json.tmp"
let final_path = "C:\\NovaX\\tool_registry.json"
write_file(tmp_path, json_out)

// Verify
let verify_raw = read_file(tmp_path)
let verify = json_decode(verify_raw)
let verify_svcs = dict_get(verify, "services") ?? {}
let verify_count = len(keys(verify_svcs))
print("Verified: " + str(verify_count) + " services in temp file")

// Atomic replace via shell
let mv_cmd = "powershell -NoProfile -Command \"Move-Item -Force '" + tmp_path + "' '" + final_path + "'\""
shell(mv_cmd)

print("")
print("Registry rebuilt: " + str(svc_count) + " services")
print("File: " + final_path)

// List services
let all_keys = keys(services)
let ki = 0
let kcount = len(all_keys)
while3 ki < kcount {
  let k = all_keys[ki]
  let s = dict_get(services, k) ?? {}
  let sp = dict_get(s, "port") ?? 0
  let sr = dict_get(s, "routes") ?? {}
  let rc = len(keys(sr))
  print("  " + k + " :" + str(sp) + " (" + str(rc) + " routes)")
  let ki = ki + 1
}

print("")
print("=== Registry Rebuild Complete ===")
