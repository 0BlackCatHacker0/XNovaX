// NovaLang Purification Swarm
// Sends purification tasks to 20+ cloud AI models.
// Each model generates pure NovaLang replacements for Python bridges.
// Usage: novalang run scripts/novalang_purify_swarm.nova [--phase 1|2|3] [--dry-run]

let ROOT = "C:/NovaX"
let CLOUD_CFG = ROOT + "/cloud_config.json"
let RESULTS_DIR = ROOT + "/swarm_results/purify"
let TIMEOUT = 120

