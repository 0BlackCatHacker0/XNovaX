// TRIPPLE PREMIUM RUN — 13 Premium Models x 7 Domain Prompts = 91 Queries
// Tests the most powerful paid models available through OpenRouter
// N-S Flow: 3-5-7-13 harmonic | All queries via Cloud Router :9878

let CLOUD = "http://127.0.0.1:9878/api/v1/query"
let TRIPPLE = "http://127.0.0.1:9881/hive/tripple/ripple"
let ARCHIVE = "C:/NovaX/data/super_archive"
let total = 0
let success = 0
let failed = 0
let total_chars = 0

print("###########################################################################")
print("  TRIPPLE PREMIUM RUN — 13 Premium Models x 7 Domains = 91 Queries")
print("  All models via OpenRouter | 30s timeout | Results archived")
print("###########################################################################")
print("")

// === 13 PREMIUM MODELS ===
let models = [
    "x-ai/grok-4.20-beta",
    "x-ai/grok-4.20-multi-agent-beta",
    "x-ai/grok-4.1-fast",
    "openai/gpt-5.4",
    "openai/gpt-4.1",
    "anthropic/claude-opus-4.6",
    "anthropic/claude-sonnet-4.6",
    "google/gemini-2.5-pro",
    "google/gemini-3-pro-preview",
    "meta-llama/llama-4-maverick",
    "qwen/qwen3.5-flash-02-23",
    "amazon/nova-premier-v1",
    "xiaomi/mimo-v2-pro"
]

let model_shorts = [
    "grok-4.20-beta",
    "grok-4.20-multi-agent",
    "grok-4.1-fast",
    "gpt-5.4",
    "gpt-4.1",
    "claude-opus-4.6",
    "claude-sonnet-4.6",
    "gemini-2.5-pro",
    "gemini-3-pro",
    "llama-4-maverick",
    "qwen3.5-flash",
    "nova-premier",
    "mimo-v2-pro"
]

// === 7 DOMAIN PROMPTS ===
let domains = ["MATH", "CODE", "LONG", "FACT", "REASON", "AGENT", "LANGUAGE"]

let prompts = [
    "Prove the Riemann Hypothesis is equivalent to a statement about the distribution of prime numbers. Show your reasoning step by step.",
    "Write a complete ternary virtual machine in Rust that supports arithmetic, logic, branching, and memory operations. Include the full implementation.",
    "Write a three-act play about an artificial intelligence that discovers the universe runs on ternary logic, not binary. Include dialogue, stage directions, and philosophical monologues.",
    "What are the top 10 breakthroughs in AI research in 2025-2026? Provide specific papers, models, and their impact.",
    "If consciousness requires subjective experience, and AI processes information without subjective experience, does this prove AI cannot be conscious? Argue both sides with philosophical rigor.",
    "Design a complete autonomous AI agent architecture that can plan, execute, learn, and self-improve. Include all components, data flows, and decision mechanisms.",
    "Translate the following concept into 10 languages and explain how each language's structure affects the meaning: The map is not the territory."
]

// === MAIN LOOP: 7 domains x 13 models ===
let d = 0
while3 d < len(domains) {
    let domain = domains[d]
    let prompt = prompts[d]
    print("")
    print("===========================================================================")
    print("  DOMAIN: " + domain + " (" + str(d + 1) + "/7)")
    print("===========================================================================")

    let m = 0
    while3 m < len(models) {
        let model = models[m]
        let model_short = model_shorts[m]
        total = total + 1

        let body = json_encode({"prompt": prompt, "provider": "openrouter", "model": model})

        let resp = try3 { http_post(CLOUD, body, 30000) } fail { null }

        if3 resp != null {
            let b = dict_get(resp, "body") ?? ""
            let rlen = len(b)

            if3 rlen > 0 {
                // Save to archive
                let save_data = json_encode({
                    "model": model,
                    "model_short": model_short,
                    "domain": domain,
                    "prompt": prompt,
                    "response": b,
                    "response_length": rlen,
                    "timestamp": time_ms()
                })
                let save_path = ARCHIVE + "/PREMIUM_" + domain + "_" + model_short + ".json"
                try3 { write_file(save_path, save_data) } fail { 0 }

                // Report ripple
                let ripple_body = json_encode({"provider": "openrouter/" + model, "trit": 1, "latency": 2000, "domain": domain, "source": "premium_run"})
                try3 { http_post(TRIPPLE, ripple_body, 5000) } fail { 0 }

                success = success + 1
                total_chars = total_chars + rlen
                print("  [+] " + str(total) + "/91 " + model_short + " | " + domain + " | " + str(rlen) + " chars")
            } else3 {
                // Empty response
                let ripple_body = json_encode({"provider": "openrouter/" + model, "trit": 0, "latency": 2000, "domain": domain, "source": "premium_run"})
                try3 { http_post(TRIPPLE, ripple_body, 5000) } fail { 0 }
                print("  [~] " + str(total) + "/91 " + model_short + " | " + domain + " | EMPTY")
            }
        } else3 {
            // Request failed
            failed = failed + 1
            let ripple_body = json_encode({"provider": "openrouter/" + model, "trit": -1, "latency": 30000, "domain": domain, "source": "premium_run"})
            try3 { http_post(TRIPPLE, ripple_body, 5000) } fail { 0 }
            print("  [X] " + str(total) + "/91 " + model_short + " | " + domain + " | FAILED")
        }

        sleep(2)
        let m = m + 1
    }

    let d = d + 1
}

// === SUMMARY ===
print("")
print("###########################################################################")
print("  TRIPPLE PREMIUM RUN — COMPLETE")
print("###########################################################################")
print("  Total queries:  " + str(total) + "/91")
print("  Success:        " + str(success))
print("  Failed:         " + str(failed))
print("  Total chars:    " + str(total_chars))
print("  Models tested:  " + str(len(models)))
print("  Domains tested: " + str(len(domains)))
print("  Archive:        " + ARCHIVE)
print("###########################################################################")

// Save summary report
let summary = json_encode({
    "test": "TripplePremiumRun",
    "total_queries": total,
    "success": success,
    "failed": failed,
    "total_chars": total_chars,
    "models": models,
    "domains": domains,
    "timestamp": time_ms()
})
try3 { write_file(ARCHIVE + "/PREMIUM_SUMMARY.json", summary) } fail { 0 }
print("  Summary saved: " + ARCHIVE + "/PREMIUM_SUMMARY.json")
