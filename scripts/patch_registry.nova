// Patch tool_registry.json: replace generic 'Service on port XXXX' descriptions with real names.

let reg_raw = read_file("C:/NovaX/tool_registry.json")
let reg = parse_json(reg_raw)

let PORT_MAP = {
    "9961": ["tlog", "TLog v1.0 - Centralized Ternary Logging. All 34+ NovaX services push logs here. Searchable, filterable, in-memory deque with background flush"],
    "9888": ["closed_loop", "Closed-Loop Autonomous Engine - 6 daemon threads for continuous model communication, deliberation, task trading, self-healing, optimization, live monitoring"],
    "9893": ["deepstorage", "DeepStorage v3.0 - Infinite Drive Engine. TZip v3, FastCDC content-defined dedup, vorticity scanner, N-S flow-routed tiering"],
    "9877": ["exec_server", "Exec Server v2.0 - All subprocess calls use CREATE_NO_WINDOW. Ternary execution states: +1=success, 0=partial, -1=failed"],
    "9881": ["hivemind", "Hive Mind v2.0 - Unified AI mesh with 3-5-7-13 harmonic ternary layer. Queries multiple Ollama models in parallel, merges into superintelligent answer"],
    "9945": ["tbus", "TBus - Ternary Message Bus. Pub/sub event system for inter-service communication with priority routing: +1 high, 0 normal, -1 low"],
    "9956": ["tcache", "TCache - Distributed Ternary Cache. Universal caching layer for all NovaX services. LRU eviction, TTL expiration, ternary cache states"],
    "9971": ["tcluster", "TCluster - Ternary Cluster Manager. Service cluster orchestration with tier-based startup ordering, rolling restarts"],
    "9972": ["tcompress", "TCompress - Ternary Compression. Compress/decompress via zlib, gzip, ternary TZip, auto"],
    "9973": ["tdiff", "TDiff - Ternary Diff/Comparison. Compares text, files, JSON, service snapshots. +1=added, 0=unchanged, -1=removed"],
    "9983": ["tdigest", "TDigest - Ternary Data Digest. Brain stem of NovaX. Compresses raw information into digestible summaries with ternary confidence"],
    "9960": ["tembed", "TEmbed - Ternary Vector Embedding. Character trigram hashing to 128-dimensional unit vectors. Cosine similarity powers search"],
    "9922": ["tffmpeg", "TFFmpeg - Media transcoding and processing. Video/audio format conversion with ternary state tracking"],
    "9982": ["tflow", "TFlow - Navier-Stokes Flow Visualization. Real-time N-S fluid dynamics for service mesh: flow fields, pressure maps, velocity vectors"],
    "9979": ["tgateway", "TGateway - Ternary External API Gateway. Manages outbound API calls. Rate limiting, response caching, retry with exponential backoff, cost tracking"],
    "9958": ["tgraph", "TGraph - Ternary Knowledge Graph. Nodes are concepts/entities/services. Edges: +1 supports, 0 unknown, -1 contradicts"],
    "9969": ["thealth", "THealth - Deep Health Checker. API smoke tests, response format verification, latency benchmarking, dependency chain validation"],
    "9924": ["tintelligence", "TIntelligence - Intelligence Foundation: TEmbed (13-dim vectors, cosine similarity, clustering) + TClassify (intent/topic/sentiment)"],
    "9901": ["tkill_novalang", "TKill NovaLang Integration - Process termination commands with Navier-Stokes harmonics"],
    "9981": ["tlock", "TLock - Ternary Distributed Locking. Prevents race conditions across services. Named locks with TTL, owner verification, deadlock detection"],
    "9942": ["tconfig", "TConfig - Ternary Configuration Management. Centralized config store for all services"],
    "9967": ["tmatrix", "TMatrix - Ternary Model Performance Matrix. Every query to every model is a data point. Reynolds flow tracking reveals best model per task"],
    "9978": ["tmemory", "TMemory - Persistent Conversation Memory. Hippocampus of NovaX. Stores conversation summaries, learned facts, user preferences"],
    "9951": ["tmesh", "TMesh - Ternary Service Mesh. Master wiring layer connecting ALL services into unified nervous system"],
    "9953": ["tmetrics", "TMetrics - Ternary Metrics. Real-time service-level telemetry. Every 13 seconds polls all services. Reynolds calculation per service"],
    "9975": ["tnotify", "TNotify - Ternary Notification Hub. Central notification system. Webhooks, polling, priority levels, channels, rate limiting"],
    "9966": ["tpipeline", "TPipeline - Ternary Workflow Pipeline Engine. Chain service calls into sequential workflows. Ternary short-circuit on FALSE_"],
    "9980": ["tprofile", "TProfile v1.0 - Ternary Query/Request Profiler. Distributed tracing, flame chart data, bottleneck detection"],
    "9977": ["tprompt", "TPrompt - Ternary Prompt Engineering. Optimize and manage prompts. Template library, variable substitution, prompt scoring, A/B testing"],
    "9957": ["tqueue", "TQueue - Ternary Job Queue. Priority queues, retry with exponential backoff, dead letter queue, job timeout"],
    "9985": ["trelay", "TRelay v1.0 - Output Relay. Accepts output via HTTP POST, forwards to CLAUDE CODE STREAM panel"],
    "9970": ["treplay", "TReplay - Query replay and temporal analysis. Replays past queries with current models to detect regressions"],
    "9948": ["tresilience", "TResilience - TCircuit (circuit breaker: +1 CLOSED, 0 HALF-OPEN, -1 OPEN) + TRate (rate limiter: +1 ALLOW, 0 THROTTLE, -1 DENY)"],
    "9963": ["trouter", "TRouter - Ternary API Gateway/Router. Smart routing based on intent classification. Intent-based routing + explicit proxy mode"],
    "9959": ["tscheduler", "TScheduler v1.0 - Lightweight Ternary Task Scheduler. Interval-based recurring commands, directory watchers, command chaining"],
    "9965": ["tsnapshot", "TSnapshot - Ternary State Snapshot/Backup. Git for system state. Captures service health, config, metrics. Enables rollback comparison"],
    "9955": ["tstream_admin", "TStream Admin - HTTP health/admin for WebSocket event streaming. Services push events, TStream broadcasts to subscribers"],
    "9976": ["tsync", "TSync - Ternary State Synchronization. Keeps distributed service state in sync. Conflict resolution via ternary consensus"],
    "9923": ["ttext", "TText - Text processing and NLP micro-tool. Natural language processing, text analysis, sentiment detection"],
    "9964": ["tvalidator", "TValidator - Ternary Input Validation. Prevents injection, XSS, path traversal, shell injection, SQL injection"],
    "9950": ["twatch", "TWatch - Ternary Watchdog. Auto-monitors all services. Resurrects dead ones. States: +1 ALIVE, 0 DEGRADED, -1 DEAD"],
    "9902": ["uia_bridge", "UIA Bridge - Session-1 UIA Bridge for Cortex. Captures UIA element trees from Claude/GPT Desktop, relays commands"],
    "9892": ["vault", "Vault v2.0 - Drive Quantizer + Encryption. TZip ternary encoding + AES-256-GCM encryption"]
}

let patched = 0
let services = dict_get(reg, "services", {})
for3 svc_key in dict_keys(services) {
    let svc_data = dict_get(services, svc_key, {})
    let port = to_string(dict_get(svc_data, "port", 0))
    let desc = dict_get(svc_data, "description", "")

    if3 dict_has(PORT_MAP, port) && starts_with(desc, "Service on port") {
        let mapping = dict_get(PORT_MAP, port, [])
        let new_name = dict_get(mapping, 0, "")
        let new_desc = dict_get(mapping, 1, "")
        let svc_data = dict_set(svc_data, "description", new_desc)
        let services = dict_set(services, svc_key, svc_data)
        let patched = patched + 1
        println("  PATCHED :" + port + " -> " + new_name + ": " + substr(new_desc, 0, 60) + "...")
    }
}

let reg = dict_set(reg, "services", services)

// Check remaining generic descriptions
let remaining = 0
for3 k in dict_keys(services) {
    let v = dict_get(services, k, {})
    if3 starts_with(dict_get(v, "description", ""), "Service on port") {
        let remaining = remaining + 1
    }
}

println("\nPatched: " + to_string(patched) + " services")
if3 remaining > 0 {
    println("Still generic: " + to_string(remaining))
} else3 {
    println("All descriptions now have proper names!")
}

write_file("C:/NovaX/tool_registry.json", to_json(reg))
println("Registry saved.")
