// quantize_scan.nova — NovaLang Quantization & Dedup Scanner
// Scans C:\NovaX for .nova files, computes SHA-256 hashes, finds dedup opportunities
// Also scans Ollama models for model dedup potential
// 3-5-7-13 harmonics | Micro-tool pattern

import3("lib/nova_ns_core.nova")

let _version = "1.0.0"

// ── Recursive directory walker ──
// Returns list of full file paths
fn walk_dir(base_path, ext_filter) {
  let results = []
  let entries = try3 { dir_list(base_path) } fail { [] }
  let i = 0
  while3 (i < len(entries)) {
    let name = entries[i]
    let full = base_path + "/" + name
    if3 (is_dir(full) == 1) {
      // Skip known heavy dirs
      let skip = false
      if3 (name == "node_modules") { skip = true } else { }
      if3 (name == ".git") { skip = true } else { }
      if3 (name == "target") { skip = true } else { }
      if3 (name == "__pycache__") { skip = true } else { }
      if3 (skip == false) {
        let sub = walk_dir(full, ext_filter)
        let si = 0
        while3 (si < len(sub)) {
          results = append(results, sub[si])
          si = si + 1
        }
      } else { }
    } else {
      if3 (ext_filter == "") {
        results = append(results, full)
      } else {
        if3 (ends_with(lower(name), ext_filter) == true) {
          results = append(results, full)
        } else { }
      }
    }
    i = i + 1
  }
  return results
}

// ── Get file extension ──
fn get_ext(path) {
  let parts = split(path, ".")
  if3 (len(parts) < 2) { return "" } else { }
  return "." + lower(parts[len(parts) - 1])
}

// ══════════════════════════════════════════════
// PHASE 1: Scan all .nova files in C:\NovaX
// ══════════════════════════════════════════════
print("═══════════════════════════════════════════════════════════════")
print("  NovaX Quantize Scanner v" + _version + " | 3-5-7-13 Harmonics")
print("═══════════════════════════════════════════════════════════════")
print("")
print("Phase 1: Scanning C:/NovaX for .nova files...")

let nova_files = walk_dir("C:/NovaX", ".nova")
let total_nova = len(nova_files)
print("  Found " + str(total_nova) + " .nova files")

// Compute SHA-256 for each file and track hashes
let hash_map = {}      // hash -> list of file paths
let file_sizes = {}    // path -> size
let total_bytes = 0
let hash_errors = 0

let fi = 0
while3 (fi < total_nova) {
  let path = nova_files[fi]
  let content = try3 { read_file(path) } fail { "" }
  let sz = try3 { file_size(path) } fail { 0 }
  if3 (sz < 0) { sz = 0 } else { }

  if3 (content != "") {
    let hash = sha256(content)
    total_bytes = total_bytes + sz
    file_sizes = dict_set(file_sizes, path, sz)

    let existing = dict_get(hash_map, hash) ?? []
    existing = append(existing, path)
    hash_map = dict_set(hash_map, hash, existing)
  } else {
    hash_errors = hash_errors + 1
  }
  fi = fi + 1
}

let unique_hashes = len(keys(hash_map))
print("  Total bytes: " + str(total_bytes))
print("  Unique hashes: " + str(unique_hashes))
print("  Hash errors: " + str(hash_errors))

// Find duplicates (hashes with more than 1 file)
let dup_groups = 0
let dup_files = 0
let dup_bytes_saved = 0
let hk = keys(hash_map)
let hi = 0
while3 (hi < len(hk)) {
  let hash = hk[hi]
  let paths = dict_get(hash_map, hash) ?? []
  if3 (len(paths) > 1) {
    dup_groups = dup_groups + 1
    let first_path = paths[0]
    let first_size = dict_get(file_sizes, first_path) ?? 0
    // All copies after the first are savings
    dup_files = dup_files + len(paths) - 1
    dup_bytes_saved = dup_bytes_saved + (first_size * (len(paths) - 1))
  } else { }
  hi = hi + 1
}

print("")
print("─── .nova File Dedup Report ───")
print("  Total files:       " + str(total_nova))
print("  Total bytes:       " + str(total_bytes) + " (" + str(floor(total_bytes / 1048576)) + " MB)")
print("  Unique content:    " + str(unique_hashes))
print("  Duplicate groups:  " + str(dup_groups))
print("  Duplicate files:   " + str(dup_files))
print("  Dedup savings:     " + str(dup_bytes_saved) + " bytes (" + str(floor(dup_bytes_saved / 1024)) + " KB)")

// Show duplicate groups (up to 13 groups)
if3 (dup_groups > 0) {
  print("")
  print("  Duplicate groups (showing up to 13):")
  let shown = 0
  let di = 0
  while3 (di < len(hk)) {
    if3 (shown >= 13) {
      // break equivalent
      di = len(hk)
    } else {
      let hash = hk[di]
      let paths = dict_get(hash_map, hash) ?? []
      if3 (len(paths) > 1) {
        let first_size = dict_get(file_sizes, paths[0]) ?? 0
        print("    [" + str(len(paths)) + " copies, " + str(first_size) + "b] " + str(slice(hash, 0, 12)) + "...")
        let pi = 0
        while3 (pi < len(paths)) {
          if3 (pi < 5) {
            print("      - " + paths[pi])
          } else { }
          pi = pi + 1
        }
        if3 (len(paths) > 5) {
          print("      ... and " + str(len(paths) - 5) + " more")
        } else { }
        shown = shown + 1
      } else { }
    }
    di = di + 1
  }
} else { }

// ══════════════════════════════════════════════
// PHASE 2: Scan Ollama models
// ══════════════════════════════════════════════
print("")
print("═══════════════════════════════════════════════════════════════")
print("Phase 2: Scanning Ollama models...")

let ollama_base = "C:/Users/Jupit/.ollama/models"
let ollama_exists = is_dir(ollama_base)

if3 (ollama_exists == 1) {
  // Scan blobs directory (where actual model weights live)
  let blobs_path = ollama_base + "/blobs"
  let blobs_exists = is_dir(blobs_path)

  if3 (blobs_exists == 1) {
    let blob_files = try3 { dir_list(blobs_path) } fail { [] }
    let model_total_bytes = 0
    let model_count = 0
    let model_sizes = []
    let bi = 0
    while3 (bi < len(blob_files)) {
      let bname = blob_files[bi]
      let bpath = blobs_path + "/" + bname
      if3 (is_file(bpath) == 1) {
        let bsz = try3 { file_size(bpath) } fail { 0 }
        if3 (bsz < 0) { bsz = 0 } else { }
        model_total_bytes = model_total_bytes + bsz
        model_count = model_count + 1
        model_sizes = append(model_sizes, {"name": bname, "bytes": bsz})
      } else { }
      bi = bi + 1
    }

    print("  Blobs found: " + str(model_count))
    print("  Total model bytes: " + str(model_total_bytes) + " (" + str(floor(model_total_bytes / 1073741824 * 100) / 100) + " GB)")

    // Check for identical blobs (CAS dedup)
    // Ollama already uses CAS (sha256 naming), so blobs are inherently deduplicated
    // But we check for hash prefix grouping (same model family)
    let families = {}
    let mi = 0
    while3 (mi < len(model_sizes)) {
      let m = model_sizes[mi]
      let mname = dict_get(m, "name") ?? ""
      let mbytes = dict_get(m, "bytes") ?? 0
      // Extract hash prefix (family indicator) — first part before '-'
      let parts = split(mname, "-")
      let prefix = ""
      if3 (len(parts) > 1) { prefix = parts[0] } else { prefix = "other" }

      let fam = dict_get(families, prefix) ?? {"count": 0, "bytes": 0}
      let fc = (dict_get(fam, "count") ?? 0) + 1
      let fb = (dict_get(fam, "bytes") ?? 0) + mbytes
      families = dict_set(families, prefix, {"count": fc, "bytes": fb})
      mi = mi + 1
    }

    let fk = keys(families)
    print("  Blob families: " + str(len(fk)))
    print("")
    print("─── Ollama Model Report ───")
    print("  Total blobs:       " + str(model_count))
    print("  Total size:        " + str(floor(model_total_bytes / 1073741824 * 100) / 100) + " GB")
    print("  CAS status:        Ollama uses SHA-256 CAS natively — blobs are already deduplicated")
    print("  Family groups:     " + str(len(fk)))

    // Show top 7 families by size
    let fi2 = 0
    let shown2 = 0
    while3 (fi2 < len(fk)) {
      if3 (shown2 < 7) {
        let fam_name = fk[fi2]
        let fam_data = dict_get(families, fam_name) ?? {}
        let fc2 = dict_get(fam_data, "count") ?? 0
        let fb2 = dict_get(fam_data, "bytes") ?? 0
        print("    " + fam_name + ": " + str(fc2) + " blobs, " + str(floor(fb2 / 1048576)) + " MB")
        shown2 = shown2 + 1
      } else { }
      fi2 = fi2 + 1
    }

    // Ternary quantization potential
    // Standard models are FP16 (16-bit), ternary is 1.58-bit = ~10x compression potential
    let ternary_potential = floor(model_total_bytes / 10)
    let ternary_savings = model_total_bytes - ternary_potential
    print("")
    print("─── Ternary Quantization Potential ───")
    print("  Current size:      " + str(floor(model_total_bytes / 1073741824 * 100) / 100) + " GB")
    print("  After BitNet 1.58: " + str(floor(ternary_potential / 1073741824 * 100) / 100) + " GB (est.)")
    print("  Potential savings: " + str(floor(ternary_savings / 1073741824 * 100) / 100) + " GB")
    print("  Compression ratio: ~10:1 (FP16 to ternary)")

  } else {
    print("  No blobs directory found at " + blobs_path)
  }

  // Also check manifests
  let manifests_path = ollama_base + "/manifests"
  if3 (is_dir(manifests_path) == 1) {
    let manifest_entries = try3 { dir_list(manifests_path) } fail { [] }
    print("")
    print("  Manifest registries: " + str(len(manifest_entries)))
    let mei = 0
    while3 (mei < len(manifest_entries)) {
      print("    - " + manifest_entries[mei])
      mei = mei + 1
    }
  } else { }

} else {
  print("  Ollama models directory not found at " + ollama_base)
}

// ══════════════════════════════════════════════
// PHASE 3: Combined Summary
// ══════════════════════════════════════════════
print("")
print("═══════════════════════════════════════════════════════════════")
print("  QUANTIZE SCAN COMPLETE")
print("═══════════════════════════════════════════════════════════════")
print("  .nova files scanned:  " + str(total_nova))
print("  .nova dedup savings:  " + str(floor(dup_bytes_saved / 1024)) + " KB")
print("  Unique .nova content: " + str(unique_hashes) + " / " + str(total_nova))
print("═══════════════════════════════════════════════════════════════")
