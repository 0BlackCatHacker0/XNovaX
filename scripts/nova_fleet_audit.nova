// nova_fleet_audit.nova — Quick fleet timeout audit
// Scans ports 9870-9999 for live services, reports fast/slow
// NovaLang conversion of fleet_audit.py

print("=== NovaX Fleet Audit ===")
print("")

let alive = []
let port = 9870

fn check_health(p) {
  let url = "http://127.0.0.1:" + str(p) + "/health"
  let t0 = time()
  let resp = http_get(url)
  let t1 = time()
  let elapsed = round(t1 - t0, 3)
  let data = json_decode(resp)
  let svc = dict_get(data, "service") ?? "?"
  let result = {"port": p, "service": svc, "time": elapsed}
  return result
}

fn try_check(p) {
  let result = null
  try3 {
    let result = check_health(p)
  } uncertain {
    let result = null
  } fail3 {
    let result = null
  }
  return result
}

while3 port < 10000 {
  let r = try_check(port)
  if3 r {
    let alive = append(alive, r)
  } maybe {
  } else {
  }
  let port = port + 1
}

let count = len(alive)
print("Fleet: " + str(count) + " services alive")

// Separate fast vs slow
let slow = []
let fast = []
let i = 0
while3 i < count {
  let svc = alive[i]
  let t = svc["time"]
  if3 cmp3(t, 0.5) {
    let slow = append(slow, svc)
  } maybe {
    let fast = append(fast, svc)
  } else {
    let fast = append(fast, svc)
  }
  let i = i + 1
}

print("Fast (<0.5s): " + str(len(fast)))
print("Slow (>0.5s): " + str(len(slow)))

// Show slow services
let si = 0
let slow_count = len(slow)
if3 cmp3(slow_count, 0) {
  print("")
  print("Slow services:")
  while3 si < slow_count {
    let s = slow[si]
    let name = s["service"]
    let p = s["port"]
    let t = s["time"]
    print("  " + name + ":" + str(p) + " = " + str(t) + "s")
    let si = si + 1
  }
} maybe {
} else {
}

// Stats
if3 cmp3(count, 0) {
  let sum_t = 0.0
  let fastest_t = 999999.0
  let fastest_name = ""
  let fastest_port = 0
  let slowest_t = 0.0
  let slowest_name = ""
  let slowest_port = 0
  let j = 0
  while3 j < count {
    let svc = alive[j]
    let t = svc["time"]
    let sum_t = sum_t + t
    if3 cmp3(fastest_t, t) {
      let fastest_t = t
      let fastest_name = svc["service"]
      let fastest_port = svc["port"]
    } maybe {
    } else {
    }
    if3 cmp3(t, slowest_t) {
      let slowest_t = t
      let slowest_name = svc["service"]
      let slowest_port = svc["port"]
    } maybe {
    } else {
    }
    let j = j + 1
  }
  let avg = round(sum_t / count, 3)
  print("")
  print("Fastest: " + fastest_name + ":" + str(fastest_port) + " = " + str(fastest_t) + "s")
  print("Slowest: " + slowest_name + ":" + str(slowest_port) + " = " + str(slowest_t) + "s")
  print("Average: " + str(avg) + "s")
} maybe {
} else {
}

print("")
print("=== Fleet Audit Complete ===")
