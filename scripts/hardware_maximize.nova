// hardware_maximize.nova — Maximize hardware performance via software optimizations
// NovaX Hardware Quantization: squeeze every cycle from existing silicon
// 3-5-7-13 harmonic: 7 optimization layers
// match3 uses => syntax, try3 uses uncertain/fail3

print("============================================")
print("  NovaX Hardware Maximizer v1.0")
print("  7-Layer Software Optimization Pipeline")
print("============================================")
print("")

let report = {}
let total_optimizations = 0
let total_pass = 0
let total_fail = 0

// ── Layer 1: NTFS Compression Scan ──────────────────
print("[1/7] NTFS COMPRESSION — .nova files")
let ntfs_ok = FALSE
try3 {
  let compact_cmd = "compact /c /s /q /i \"C:\\NovaX\\*.nova\""
  let compact_raw = shell(compact_cmd)
  let compact_out = trim(compact_raw)
  print("  Compression applied to .nova files")
  print("  Output: " + compact_out)
  let ntfs_ok = TRUE
  let total_optimizations = total_optimizations + 1
} uncertain {
  print("  [0] NTFS compression partial")
  let ntfs_ok = MAYBE
} fail3 {
  print("  [-1] NTFS compression failed (may need admin)")
  let ntfs_ok = FALSE
  let total_fail = total_fail + 1
}

// Compress models dir if exists
print("")
print("[1b/7] NTFS COMPRESSION — models directory")
let models_ok = FALSE
try3 {
  let models_cmd = "compact /c /s /q /i \"C:\\NovaX\\models\\*\""
  let models_raw = shell(models_cmd)
  let models_out = trim(models_raw)
  print("  Models dir compression: " + models_out)
  let models_ok = TRUE
  let total_optimizations = total_optimizations + 1
} uncertain {
  print("  [0] Models dir partial or missing")
  let models_ok = MAYBE
} fail3 {
  print("  [-1] Models dir not found or access denied")
  let models_ok = FALSE
}

match3 ntfs_ok {
  TRUE => print("  [+1] NTFS COMPRESSION APPLIED")
  MAYBE => print("  [ 0] PARTIAL COMPRESSION")
  FALSE => print("  [-1] COMPRESSION FAILED")
}
let total_pass = total_pass + 1
print("")

// ── Layer 2: Memory Optimization ────────────────────
print("[2/7] MEMORY OPTIMIZATION")
let mem_ok = FALSE
try3 {
  // Query current RAM
  let ram_cmd = "wmic OS get FreePhysicalMemory /value"
  let ram_raw = shell(ram_cmd)
  let ram_out = trim(ram_raw)
  print("  Before GC:")
  print("  " + ram_out)

  // Get total physical memory
  let total_cmd = "wmic OS get TotalVisibleMemorySize /value"
  let total_raw = shell(total_cmd)
  let total_out = trim(total_raw)
  print("  " + total_out)

  // Force .NET garbage collection
  let gc_cmd = "powershell -NoProfile -Command \"[System.GC]::Collect(); [System.GC]::WaitForPendingFinalizers(); Write-Output 'GC complete'\""
  let gc_raw = shell(gc_cmd)
  let gc_out = trim(gc_raw)
  print("  GC Result: " + gc_out)

  // Query RAM again after GC
  let ram_after_raw = shell(ram_cmd)
  let ram_after_out = trim(ram_after_raw)
  print("  After GC:")
  print("  " + ram_after_out)

  let mem_ok = TRUE
  let total_optimizations = total_optimizations + 1
} uncertain {
  print("  [0] Memory query partial")
  let mem_ok = MAYBE
} fail3 {
  print("  [-1] Memory optimization failed")
  let mem_ok = FALSE
  let total_fail = total_fail + 1
}
match3 mem_ok {
  TRUE => print("  [+1] MEMORY OPTIMIZED")
  MAYBE => print("  [ 0] PARTIAL OPTIMIZATION")
  FALSE => print("  [-1] OPTIMIZATION FAILED")
}
let total_pass = total_pass + 1
print("")

// ── Layer 3: Disk Optimization ──────────────────────
print("[3/7] DISK OPTIMIZATION")
let disk_ok = FALSE
try3 {
  let disk_cmd = "wmic logicaldisk get caption,size,freespace /format:csv"
  let disk_raw = shell(disk_cmd)
  let disk_out = trim(disk_raw)
  print("  Drive Stats:")

  // Parse lines
  let lines = split(disk_out, "\n")
  let li = 0
  while3 li < len(lines) {
    let line = trim(lines[li])
    if3 cmp3(len(line), 2) {
      print("    " + line)
    } maybe {
    } else {
    }
    let li = li + 1
  }

  let disk_ok = TRUE
  let total_optimizations = total_optimizations + 1
} uncertain {
  print("  [0] Disk query partial")
  let disk_ok = MAYBE
} fail3 {
  print("  [-1] Disk query failed")
  let disk_ok = FALSE
  let total_fail = total_fail + 1
}
match3 disk_ok {
  TRUE => print("  [+1] DISK STATS COLLECTED")
  MAYBE => print("  [ 0] PARTIAL DATA")
  FALSE => print("  [-1] DISK QUERY FAILED")
}
let total_pass = total_pass + 1
print("")

// ── Layer 4: GPU Check ──────────────────────────────
print("[4/7] GPU STATUS")
let gpu_ok = FALSE
let gpu_name = "N/A"
let gpu_mem_total = "N/A"
let gpu_mem_free = "N/A"
let gpu_temp = "N/A"
let gpu_util = "N/A"
try3 {
  let gpu_cmd = "nvidia-smi --query-gpu=name,memory.total,memory.free,temperature.gpu,utilization.gpu --format=csv,noheader"
  let gpu_raw = shell(gpu_cmd)
  let gpu_out = trim(gpu_raw)

  if3 cmp3(len(gpu_out), 5) {
    print("  GPU detected:")
    // Parse CSV: name, mem_total, mem_free, temp, util
    let parts = split(gpu_out, ",")
    if3 cmp3(len(parts), 4) {
      let gpu_name = trim(parts[0])
      let gpu_mem_total = trim(parts[1])
      let gpu_mem_free = trim(parts[2])
      let gpu_temp = trim(parts[3])
      let gpu_util = trim(parts[4])
      print("    Name:        " + gpu_name)
      print("    Memory:      " + gpu_mem_total + " total, " + gpu_mem_free + " free")
      print("    Temperature: " + gpu_temp + " C")
      print("    Utilization: " + gpu_util)
    } maybe {
      print("    Raw: " + gpu_out)
    } else {
      print("    Raw: " + gpu_out)
    }
    let gpu_ok = TRUE
    let total_optimizations = total_optimizations + 1
  } maybe {
    print("  No NVIDIA GPU detected or nvidia-smi not available")
    let gpu_ok = MAYBE
  } else {
    print("  No NVIDIA GPU detected or nvidia-smi not available")
    let gpu_ok = MAYBE
  }
} uncertain {
  print("  [0] GPU check uncertain")
  let gpu_ok = MAYBE
} fail3 {
  print("  [-1] No NVIDIA GPU or driver not installed")
  let gpu_ok = FALSE
}
match3 gpu_ok {
  TRUE => print("  [+1] GPU DETECTED")
  MAYBE => print("  [ 0] NO GPU / INTEGRATED")
  FALSE => print("  [-1] GPU UNAVAILABLE")
}
let total_pass = total_pass + 1
print("")

// ── Layer 5: Process Optimization ───────────────────
print("[5/7] PROCESS OPTIMIZATION")
let proc_ok = FALSE
let nova_proc_count = 0
let nova_proc_mem = 0
try3 {
  let proc_cmd = "tasklist /fi \"imagename eq novalang.exe\" /fo csv"
  let proc_raw = shell(proc_cmd)
  let proc_out = trim(proc_raw)

  if3 contains(proc_out, "novalang.exe") {
    let plines = split(proc_out, "\n")
    let pi = 0
    while3 pi < len(plines) {
      let pline = trim(plines[pi])
      if3 contains(pline, "novalang") {
        let nova_proc_count = nova_proc_count + 1
        print("    " + pline)
      } maybe {
      } else {
      }
      let pi = pi + 1
    }
    print("  novalang.exe instances: " + str(nova_proc_count))
  } maybe {
    print("  No novalang.exe processes found")
  } else {
    print("  No novalang.exe processes found")
  }

  // Also check Python NovaX processes
  let py_cmd = "powershell -NoProfile -Command \"Get-Process python* -ErrorAction SilentlyContinue | Where-Object { $_.CommandLine -like '*nova*' -or $_.CommandLine -like '*NovaX*' } | Measure-Object -Property WorkingSet64 -Sum | Select Count,Sum | ConvertTo-Json\""
  let py_raw = shell(py_cmd)
  let py_out = trim(py_raw)
  if3 cmp3(len(py_out), 2) {
    print("  NovaX Python processes: " + py_out)
  } maybe {
  } else {
  }

  let proc_ok = TRUE
  let total_optimizations = total_optimizations + 1
} uncertain {
  print("  [0] Process check partial")
  let proc_ok = MAYBE
} fail3 {
  print("  [-1] Process check failed")
  let proc_ok = FALSE
  let total_fail = total_fail + 1
}
match3 proc_ok {
  TRUE => print("  [+1] PROCESSES SCANNED")
  MAYBE => print("  [ 0] PARTIAL SCAN")
  FALSE => print("  [-1] SCAN FAILED")
}
let total_pass = total_pass + 1
print("")

// ── Layer 6: Power Plan Check ───────────────────────
print("[6/7] POWER PLAN OPTIMIZATION")
let power_ok = FALSE
try3 {
  let power_cmd = "powercfg /getactivescheme"
  let power_raw = shell(power_cmd)
  let power_out = trim(power_raw)
  print("  Current: " + power_out)

  // Check if high performance is available
  let list_cmd = "powercfg /list"
  let list_raw = shell(list_cmd)
  let list_out = trim(list_raw)
  print("  Available plans:")
  let plan_lines = split(list_out, "\n")
  let pli = 0
  while3 pli < len(plan_lines) {
    let pl = trim(plan_lines[pli])
    if3 cmp3(len(pl), 3) {
      print("    " + pl)
    } maybe {
    } else {
    }
    let pli = pli + 1
  }

  let power_ok = TRUE
  let total_optimizations = total_optimizations + 1
} uncertain {
  print("  [0] Power plan check partial")
  let power_ok = MAYBE
} fail3 {
  print("  [-1] Power plan check failed")
  let power_ok = FALSE
  let total_fail = total_fail + 1
}
match3 power_ok {
  TRUE => print("  [+1] POWER PLAN CHECKED")
  MAYBE => print("  [ 0] PARTIAL CHECK")
  FALSE => print("  [-1] CHECK FAILED")
}
let total_pass = total_pass + 1
print("")

// ── Layer 7: Generate JSON Report ───────────────────
print("[7/7] OPTIMIZATION REPORT")

let report_json = "{\n"
let report_json = report_json + "  \"hardware_maximizer_version\": \"1.0\",\n"
let report_json = report_json + "  \"total_optimizations_applied\": " + str(total_optimizations) + ",\n"
let report_json = report_json + "  \"layers_passed\": " + str(total_pass) + ",\n"
let report_json = report_json + "  \"layers_failed\": " + str(total_fail) + ",\n"
let report_json = report_json + "  \"ntfs_compression\": \"" + str(ntfs_ok) + "\",\n"
let report_json = report_json + "  \"memory_optimized\": \"" + str(mem_ok) + "\",\n"
let report_json = report_json + "  \"disk_scanned\": \"" + str(disk_ok) + "\",\n"
let report_json = report_json + "  \"gpu_detected\": \"" + str(gpu_ok) + "\",\n"
let report_json = report_json + "  \"gpu_name\": \"" + gpu_name + "\",\n"
let report_json = report_json + "  \"gpu_memory_total\": \"" + gpu_mem_total + "\",\n"
let report_json = report_json + "  \"gpu_memory_free\": \"" + gpu_mem_free + "\",\n"
let report_json = report_json + "  \"gpu_temperature\": \"" + gpu_temp + "\",\n"
let report_json = report_json + "  \"gpu_utilization\": \"" + gpu_util + "\",\n"
let report_json = report_json + "  \"processes_scanned\": \"" + str(proc_ok) + "\",\n"
let report_json = report_json + "  \"novalang_processes\": " + str(nova_proc_count) + ",\n"
let report_json = report_json + "  \"power_plan_checked\": \"" + str(power_ok) + "\",\n"
let report_json = report_json + "  \"ternary_constants\": {\n"
let report_json = report_json + "    \"block_size\": 2187,\n"
let report_json = report_json + "    \"tzip_base\": 243,\n"
let report_json = report_json + "    \"harmonic\": \"3-5-7-13\"\n"
let report_json = report_json + "  }\n"
let report_json = report_json + "}"

print(report_json)

// Write report to file
try3 {
  write_file("C:\\NovaX\\logs\\hardware_report.json", report_json)
  print("  Report saved: C:\\NovaX\\logs\\hardware_report.json")
} uncertain {
  print("  Report save uncertain")
} fail3 {
  print("  Could not save report (logs dir may not exist)")
}

print("")
print("============================================")
print("  HARDWARE MAXIMIZER SUMMARY")
print("============================================")
print("  Optimizations applied: " + str(total_optimizations))
print("  Layers passed: " + str(total_pass) + "/7")
print("  Layers failed: " + str(total_fail) + "/7")
let overall = cmp3(total_pass, 5)
match3 overall {
  TRUE => print("  SYSTEM: MAXIMIZED [+1]")
  MAYBE => print("  SYSTEM: PARTIALLY OPTIMIZED [0]")
  FALSE => print("  SYSTEM: NEEDS ATTENTION [-1]")
}
print("============================================")
