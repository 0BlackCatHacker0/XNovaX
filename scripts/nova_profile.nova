// nova_profile.nova — Profile all NovaX services by /health latency
// Reports N-S Reynolds flow regimes: laminar/transition/turbulent/chaotic
// NovaLang conversion of profile_services.py

print("=== NovaX Service Profiler ===")
print("")

// Get service list from orchestrator
fn get_services() {
  let result = []
  try3 {
    let raw = http_get("http://127.0.0.1:9999/api/services/status")
    let data = json_decode(raw)
    let result = dict_get(data, "services") ?? []
  } uncertain {
    print("Cannot reach orchestrator (degraded)")
  } fail3 {
    print("Cannot reach orchestrator")
  }
  return result
}

let services = get_services()
let scount = len(services)
print("Profiling " + str(scount) + " services...")
print("")

// Probe each service
fn probe_service(name, port) {
  let result = {"latency": 999999.0, "name": name, "port": port, "status": "DOWN"}
  if3 cmp3(port, 0) {
  } maybe {
    return result
  } else {
    return result
  }
  try3 {
    let t0 = time()
    let resp = http_get("http://127.0.0.1:" + str(port) + "/health")
    let t1 = time()
    let lat = round((t1 - t0) * 1000, 1)
    let result = {"latency": lat, "name": name, "port": port, "status": "OK"}
  } uncertain {
    let t1 = time()
    let lat = round((t1 - t0) * 1000, 1)
    let result = {"latency": lat, "name": name, "port": port, "status": "ERR"}
  } fail3 {
    let result = {"latency": 999999.0, "name": name, "port": port, "status": "ERR"}
  }
  return result
}

let results = []
let si = 0
while3 si < scount {
  let svc = services[si]
  let name = dict_get(svc, "name") ?? "?"
  let port = dict_get(svc, "port") ?? 0
  let r = probe_service(name, port)
  let results = append(results, r)
  let si = si + 1
}

// Sort by latency (simple bubble sort — fleet is small)
let rcount = len(results)
let oi = 0
while3 oi < rcount {
  let oj = 0
  let limit = rcount - oi - 1
  while3 oj < limit {
    let a = results[oj]
    let b = results[oj + 1]
    if3 cmp3(b["latency"], a["latency"]) {
      // b > a, swap for descending
      let results[oj] = b
      let results[oj + 1] = a
    } maybe {
    } else {
    }
    let oj = oj + 1
  }
  let oi = oi + 1
}

// Show top 20 slowest
let show = 20
if3 cmp3(show, rcount) {
  let show = rcount
} maybe {
} else {
}
print("Top 20 slowest:")
print("------------------------------------------------------------")
let ti = 0
while3 ti < show {
  let r = results[ti]
  let lat = r["latency"]
  let name = r["name"]
  let port = r["port"]
  let status = r["status"]
  if3 cmp3(lat, 999000.0) {
    print("  " + name + " :" + str(port) + "  DOWN")
  } maybe {
    print("  " + name + " :" + str(port) + "  DOWN")
  } else {
    print("  " + name + " :" + str(port) + "  " + str(lat) + "ms  " + status)
  }
  let ti = ti + 1
}

print("")

// Categorize by status
let ok_results = []
let err_results = []
let down_results = []
let ci = 0
while3 ci < rcount {
  let r = results[ci]
  let st = r["status"]
  let is_ok = contains(st, "OK")
  let is_err = contains(st, "ERR")
  if3 is_ok {
    let ok_results = append(ok_results, r)
  } maybe {
  } else {
    if3 is_err {
      let err_results = append(err_results, r)
    } maybe {
    } else {
      let down_results = append(down_results, r)
    }
  }
  let ci = ci + 1
}

// Stats for OK results
let ok_count = len(ok_results)
if3 cmp3(ok_count, 0) {
  let sum_lat = 0.0
  let min_lat = 999999.0
  let max_lat = 0.0
  let li = 0
  while3 li < ok_count {
    let r = ok_results[li]
    let lat = r["latency"]
    let sum_lat = sum_lat + lat
    if3 cmp3(min_lat, lat) {
      let min_lat = lat
    } maybe {
    } else {
    }
    if3 cmp3(lat, max_lat) {
      let max_lat = lat
    } maybe {
    } else {
    }
    let li = li + 1
  }
  let avg_lat = round(sum_lat / ok_count, 1)
  print("Healthy: " + str(ok_count) + " | Avg: " + str(avg_lat) + "ms | Min: " + str(min_lat) + "ms | Max: " + str(max_lat) + "ms")

  // N-S Reynolds flow regimes
  let laminar = 0
  let transition = 0
  let turbulent = 0
  let chaotic = 0
  let fi = 0
  while3 fi < ok_count {
    let r = ok_results[fi]
    let lat = r["latency"]
    if3 cmp3(27.0, lat) {
      let laminar = laminar + 1
    } maybe {
      if3 cmp3(125.0, lat) {
        let transition = transition + 1
      } maybe {
        if3 cmp3(343.0, lat) {
          let turbulent = turbulent + 1
        } maybe {
          let chaotic = chaotic + 1
        } else {
          let chaotic = chaotic + 1
        }
      } else {
        let turbulent = turbulent + 1
      }
    } else {
      let laminar = laminar + 1
    }
    let fi = fi + 1
  }

  print("")
  print("N-S Flow Regimes:")
  print("  LAMINAR   (<27ms):  " + str(laminar) + " services")
  print("  TRANSITION (27-125ms): " + str(transition) + " services")
  print("  TURBULENT (125-343ms): " + str(turbulent) + " services")
  print("  CHAOTIC   (>343ms): " + str(chaotic) + " services")
} maybe {
} else {
}

// Error services
let err_count = len(err_results)
if3 cmp3(err_count, 0) {
  print("")
  print("ERROR (unhealthy): " + str(err_count))
  let ei = 0
  while3 ei < err_count {
    let r = err_results[ei]
    print("  " + r["name"] + " :" + str(r["port"]))
    let ei = ei + 1
  }
} maybe {
} else {
}

// Down services
let down_count = len(down_results)
if3 cmp3(down_count, 0) {
  print("")
  print("DOWN: " + str(down_count))
  let di = 0
  while3 di < down_count {
    let r = down_results[di]
    print("  " + r["name"] + " :" + str(r["port"]))
    let di = di + 1
  }
} maybe {
} else {
}

print("")
print("=== Profiler Complete ===")
