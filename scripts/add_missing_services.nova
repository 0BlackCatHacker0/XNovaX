// Add missing services to tool_registry.json: TTimeout, TMapper, TDebug, TPacman, TSpin, TReplay.

fn3 main() {
  let raw = read_file("C:/NovaX/tool_registry.json")
  let reg = parse_json(raw)
  let services = dict_get(reg, "services") ?? {}

  // Fix 9970: was labeled treplay, should be tspin (VCC confirms tspin owns 9970)
  let keys = dict_keys(services)
  for3 i in range(0, len(keys)) {
    let key = keys[i]
    let val = dict_get(services, key) ?? {}
    if3 dict_get(val, "port") ?? 0 == 9970 {
      let val = dict_set(val, "description", "TSpin v2.0 - Ternary Process Spinner. Manages all Python processes. MAX_PYTHON=243 (3^5). Protected list prevents killing NovaLang hosts. Triad integration.")
      let services = dict_set(services, key, val)
      print("  FIXED :" + key + " (port 9970) -> tspin description")
    }
  }

  // Add TTimeout (:9995)
  let ttimeout = {}
  let ttimeout = dict_set(ttimeout, "port", 9995)
  let ttimeout = dict_set(ttimeout, "description", "TTimeout v1.0 - Fleet Timeout Hardening Engine. Audit all services for timeout vulnerabilities. Stress-test individual services.")
  let ttimeout_routes = {}
  let ttimeout_routes = dict_set(ttimeout_routes, "health", {"method": "GET", "path": "/health", "desc": "Health check with audit/test counts"})
  let ttimeout_routes = dict_set(ttimeout_routes, "audit", {"method": "GET", "path": "/timeout/audit", "desc": "Scan all services for timeout vulnerabilities"})
  let ttimeout_routes = dict_set(ttimeout_routes, "status", {"method": "GET", "path": "/timeout/status", "desc": "Last audit results summary"})
  let ttimeout_routes = dict_set(ttimeout_routes, "test", {"method": "POST", "path": "/timeout/test", "desc": "Stress-test a specific service (body: {port, duration})"})
  let ttimeout = dict_set(ttimeout, "routes", ttimeout_routes)
  let services = dict_set(services, "ttimeout", ttimeout)
  print("  ADDED ttimeout (:9995)")

  // Add TMapper (:9994)
  let tmapper = {}
  let tmapper = dict_set(tmapper, "port", 9994)
  let tmapper = dict_set(tmapper, "description", "TMapper v1.0 - Mapping Debugger. Parallel port scanner + VCC/registry differ + auto-patcher. Never manually debug port mismatches again.")
  let tmapper_routes = {}
  let tmapper_routes = dict_set(tmapper_routes, "health", {"method": "GET", "path": "/health", "desc": "Health check with scan/patch counts"})
  let tmapper_routes = dict_set(tmapper_routes, "scan", {"method": "GET", "path": "/mapper/scan", "desc": "Full parallel port scan (9877-9999)"})
  let tmapper_routes = dict_set(tmapper_routes, "diff", {"method": "GET", "path": "/mapper/diff", "desc": "Compare live fleet vs VCC+registry"})
  let tmapper_routes = dict_set(tmapper_routes, "status", {"method": "GET", "path": "/mapper/status", "desc": "Last scan/diff results summary"})
  let tmapper_routes = dict_set(tmapper_routes, "patch", {"method": "POST", "path": "/mapper/patch", "desc": "Auto-patch VCC and tool_registry from live scan"})
  let tmapper = dict_set(tmapper, "routes", tmapper_routes)
  let services = dict_set(services, "tmapper", tmapper)
  print("  ADDED tmapper (:9994)")

  // Add TDebug (:9992)
  let tdebug = {}
  let tdebug = dict_set(tdebug, "port", 9992)
  let tdebug = dict_set(tdebug, "description", "TDebug v1.0 - Universal Debugger. 27+ gotcha patterns, side-by-side comparison, fleet diagnostics.")
  let tdebug_routes = {}
  let tdebug_routes = dict_set(tdebug_routes, "health", {"method": "GET", "path": "/health", "desc": "Health check"})
  let tdebug_routes = dict_set(tdebug_routes, "stats", {"method": "GET", "path": "/stats", "desc": "Debug session statistics"})
  let tdebug_routes = dict_set(tdebug_routes, "diagnostics", {"method": "GET", "path": "/diagnostics", "desc": "Fleet-wide diagnostics scan"})
  let tdebug_routes = dict_set(tdebug_routes, "validate", {"method": "POST", "path": "/validate", "desc": "Validate NovaLang syntax (body: {code} or {file})"})
  let tdebug_routes = dict_set(tdebug_routes, "compare", {"method": "POST", "path": "/compare", "desc": "Side-by-side Python vs NovaLang comparison"})
  let tdebug_routes = dict_set(tdebug_routes, "probe", {"method": "POST", "path": "/probe", "desc": "Deep probe a running service"})
  let tdebug_routes = dict_set(tdebug_routes, "diagnose", {"method": "POST", "path": "/diagnose", "desc": "Full service diagnosis (syntax + health + routes)"})
  let tdebug = dict_set(tdebug, "routes", tdebug_routes)
  let services = dict_set(services, "tdebug", tdebug)
  print("  ADDED tdebug (:9992)")

  // Add TPacman (:9991)
  let tpacman = {}
  let tpacman = dict_set(tpacman, "port", 9991)
  let tpacman = dict_set(tpacman, "description", "TPacman v1.0 - Python-to-Nova Converter. Eats Python services, outputs NovaLang. Batch scan for unconverted files.")
  let tpacman_routes = {}
  let tpacman_routes = dict_set(tpacman_routes, "health", {"method": "GET", "path": "/health", "desc": "Health check"})
  let tpacman_routes = dict_set(tpacman_routes, "stats", {"method": "GET", "path": "/stats", "desc": "Conversion statistics"})
  let tpacman_routes = dict_set(tpacman_routes, "analyze", {"method": "POST", "path": "/analyze", "desc": "Dry-run: analyze Python file, show what Nova output would look like"})
  let tpacman_routes = dict_set(tpacman_routes, "convert", {"method": "POST", "path": "/convert", "desc": "Convert Python file to .nova and write to disk"})
  let tpacman_routes = dict_set(tpacman_routes, "batch", {"method": "POST", "path": "/batch", "desc": "Batch scan all nova_*.py files for conversion readiness"})
  let tpacman = dict_set(tpacman, "routes", tpacman_routes)
  let services = dict_set(services, "tpacman", tpacman)
  print("  ADDED tpacman (:9991)")

  // Add TReplay (:9996 - reassigned from 9970 to avoid TSpin conflict)
  let treplay = {}
  let treplay = dict_set(treplay, "port", 9996)
  let treplay = dict_set(treplay, "description", "TReplay v1.0 - Query Replay and Temporal Analysis. Replays past queries with current models to detect regressions or improvements.")
  let treplay_routes = {}
  let treplay_routes = dict_set(treplay_routes, "health", {"method": "GET", "path": "/health", "desc": "Health check"})
  let treplay_routes = dict_set(treplay_routes, "replay_status", {"method": "GET", "path": "/replay/status", "desc": "Replay engine status"})
  let treplay_routes = dict_set(treplay_routes, "replay", {"method": "POST", "path": "/replay", "desc": "Replay a query against current models"})
  let treplay_routes = dict_set(treplay_routes, "compare", {"method": "POST", "path": "/replay/compare", "desc": "Compare historical vs current model responses"})
  let treplay = dict_set(treplay, "routes", treplay_routes)
  let services = dict_set(services, "treplay", treplay)
  print("  ADDED treplay (:9996 - reassigned from 9970)")

  // Update meta
  let reg = dict_set(reg, "services", services)
  let meta = dict_get(reg, "_meta") ?? {}
  let meta = dict_set(meta, "total_services", len(dict_keys(services)))
  let meta = dict_set(meta, "generated", "Session 62 - patched descriptions + added TTimeout/TMapper/TDebug/TPacman/TReplay")
  let reg = dict_set(reg, "_meta", meta)

  write_file("C:/NovaX/tool_registry.json", to_json(reg))

  print("")
  print("Total services in registry: " + str(len(dict_keys(services))))
  print("Registry saved.")
}

main()
