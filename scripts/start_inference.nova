// start_inference.nova - NovaX LLM Inference Launcher
// NovaX Script | Checks model exists, starts inference on :9800
// Ternary: +1=running, 0=no model, -1=error

print("=== NovaX LLM Inference Launcher ===")
print("")

let checkpoint_path = "C:/NovaX/nova_llm/checkpoints/best.pt"
let server_script = "C:/NovaX/nova_llm/inference_server.py"
let port = 9800

// Check if checkpoint exists
let check = shell("powershell -Command \"Test-Path '" + checkpoint_path + "'\"")
let stdout = trim(dict_get(check, "stdout") ?? "")

if3 stdout == "True" {
    // Checkpoint exists - get size
    let size_result = shell("powershell -Command \"(Get-Item '" + checkpoint_path + "').Length\"")
    let fsize = trim(dict_get(size_result, "stdout") ?? "0")
    print("[OK] Checkpoint found: " + checkpoint_path)
    print("[OK] Checkpoint size: " + fsize + " bytes")
    print("")

    // Check if port is already in use
    let port_check = shell("powershell -Command \"Get-NetTCPConnection -LocalPort " + str(port) + " -ErrorAction SilentlyContinue | Measure-Object | Select-Object -ExpandProperty Count\"")
    let port_count = trim(dict_get(port_check, "stdout") ?? "0")

    if3 port_count != "0" {
        print("[WARN] Port " + str(port) + " already in use")
        print("[WARN] Inference service may already be running")
        print("[INFO] Check with: curl http://127.0.0.1:" + str(port) + "/health")
        return 0
    }

    // Start Python inference server
    print("[START] Launching inference server on port " + str(port) + "...")
    let cmd = "cd C:/NovaX/nova_llm && python inference_server.py"
    print("[START] Command: " + cmd)
    let result = shell(cmd)
    let code = dict_get(result, "code") ?? -1
    let out = dict_get(result, "stdout") ?? ""

    if3 code == 0 {
        print("[+1] Inference server started on http://127.0.0.1:" + str(port))
        if3 len(out) > 0 {
            print("[INFO] " + out)
        }
        print("")
        print("Usage:")
        print("  curl -X POST http://127.0.0.1:" + str(port) + "/llm/generate -H 'Content-Type: application/json' -d '{\"prompt\": \"Hello\"}'")
        return 1
    } {
        let err = dict_get(result, "stderr") ?? ""
        print("[-1] Failed to start inference server (exit " + str(code) + ")")
        if3 len(err) > 0 {
            print("[ERROR] " + err)
        }
        return -1
    }
} {
    print("[-1] Model not yet trained")
    print("")
    print("  Checkpoint path: " + checkpoint_path)
    print("  Run training first:")
    print("    cd C:\\NovaX\\nova_llm && python train.py")
    print("  Or export manually:")
    print("    cd C:\\NovaX\\nova_llm && python train.py --export checkpoints/best.pt")
    return -1
}
