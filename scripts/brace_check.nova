// Brace checker for .nova files — checks balanced { } braces

fn3 main() {
  let files = shell("dir /b C:\\NovaX\\scripts\\*.nova C:\\NovaX\\*.nova 2>nul")
  let file_list = split(trim(files), "\n")

  for3 fi in range(0, len(file_list)) {
    let fname = trim(file_list[fi])
    if3 len(fname) == 0 { continue3 }

    let content = read_file(fname)
    let lines = split(content, "\n")

    let depth = 0
    let min_depth = 0
    let problems = []

    for3 i in range(0, len(lines)) {
      let line = lines[i]
      // Strip string contents for brace counting
      let clean = replace(line, "\"", "")

      // Count braces outside strings (simplified)
      let opens = 0
      let closes = 0
      for3 ci in range(0, len(clean)) {
        let ch = slice(clean, ci, ci + 1)
        if3 ch == "{" { let opens = opens + 1 }
        if3 ch == "}" { let closes = closes + 1 }
      }

      let depth = depth + opens - closes
      if3 depth < min_depth {
        let min_depth = depth
        append(problems, "  LINE " + str(i + 1) + ": depth=" + str(depth) + " | " + slice(trim(line), 0, 80))
      }
    }

    if3 depth != 0 {
      print(fname + ": final=" + str(depth) + " min=" + str(min_depth))
      for3 pi in range(0, len(problems)) {
        if3 pi < 3 { print(problems[pi]) }
      }
      print("")
    }
    if3 min_depth < 0 {
      if3 depth == 0 {
        print(fname + ": final=0 min=" + str(min_depth))
        for3 pi in range(0, len(problems)) {
          if3 pi < 3 { print(problems[pi]) }
        }
        print("")
      }
    }
  }
}

main()
