// Check Ollama resource usage.

fn3 main() {
  let r = shell("powershell -NoProfile -Command \"Get-Process -Name ollama*,ollama_runners* -EA SilentlyContinue | Select Id,Name,WorkingSet64,CPU | ConvertTo-Json\"")

  if3 len(trim(r)) > 0 {
    let data = parse_json(r)
    if3 type_of(data) != "array" {
      let data = [data]
    }
    let total_ram = 0
    for3 i in range(0, len(data)) {
      let p = data[i]
      let ram = int((dict_get(p, "WorkingSet64") ?? 0) / 1024 / 1024)
      let cpu = dict_get(p, "CPU") ?? 0
      let total_ram = total_ram + ram
      print("PID=" + str(dict_get(p, "Id") ?? "?") + " " + str(dict_get(p, "Name") ?? "?") + " RAM=" + str(ram) + "MB CPU=" + str(int(cpu)) + "s")
    }
    print("--- Total Ollama RAM: " + str(total_ram) + "MB")
  } else3 {
    print("No Ollama processes found")
  }

  // Check GPU usage
  let r2 = shell("powershell -NoProfile -Command \"nvidia-smi --query-gpu=utilization.gpu,utilization.memory,memory.used,memory.total --format=csv,noheader,nounits 2>$null\"")
  if3 len(trim(r2)) > 0 {
    let parts = split(trim(r2), ", ")
    if3 len(parts) >= 4 {
      print("GPU: " + parts[0] + "% util, VRAM: " + parts[2] + "MB/" + parts[3] + "MB (" + parts[1] + "% util)")
    }
  }

  // Check loaded models
  try3 {
    let resp = http_get("http://127.0.0.1:11434/api/ps")
    let data = parse_json(resp)
    let models = dict_get(data, "models") ?? []
    print("Models in VRAM: " + str(len(models)))
    for3 i in range(0, len(models)) {
      let m = models[i]
      let name = dict_get(m, "name") ?? "?"
      let vram = int((dict_get(m, "size_vram") ?? 0) / 1024 / 1024)
      let size = int((dict_get(m, "size") ?? 0) / 1024 / 1024)
      print("  " + name + ": " + str(vram) + "MB VRAM, " + str(size) + "MB total")
    }
  } catch3 e {
    print("Ollama API not responding")
  }
}

main()
