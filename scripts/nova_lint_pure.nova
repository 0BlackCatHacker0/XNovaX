// nova_lint_pure.nova — NovaLang linter written in pure NovaLang
// Checks .nova files for Python artifacts and syntax issues
// NovaLang conversion of nova_lint.py

print("=== NovaLang Pure Linter ===")
print("")

// Python artifact patterns to check (substring-based since no regex in NovaLang)
let py_markers = ["def ", "self.", "None", "except ", "elif ", "import ", "from ", "class ", "while ", "try:"]
let py_labels = ["Python def (use fn)", "Python self.", "Python None (use null)", "Python except (use fail/catch3)", "Python elif (use else3)", "Python import (use import3)", "Python from-import", "Python class (use class3)", "Python while (use while3)", "Python try: (use try3)"]

// Get all .nova files
fn get_nova_files() {
  let cmd = "powershell -NoProfile -Command \"Get-ChildItem 'C:\\NovaX\\*.nova' -Name | Sort-Object\""
  let raw = shell(cmd)
  let files = split(trim(raw), "\n")
  return files
}

// Check if a line is a comment
fn is_comment(line) {
  let stripped = trim(line)
  let starts_slash = contains(stripped, "//")
  let starts_hash = contains(stripped, "#")
  if3 cmp3(len(stripped), 0) {
    return true
  } maybe {
    return true
  } else {
  }
  // Check first two chars
  let first = ""
  if3 cmp3(len(stripped), 1) {
    let first = stripped[0]
  } maybe {
  } else {
  }
  if3 contains(first, "#") {
    return true
  } maybe {
  } else {
  }
  return false
}

// Count char occurrences in string
fn count_char(s, ch) {
  let count = 0
  let parts = split(s, ch)
  let count = len(parts) - 1
  return count
}

// Lint a single file
fn lint_one(filepath) {
  let errors = 0
  let warns = 0
  let error_msgs = []

  let content = read_file(filepath)
  let lines = split(content, "\n")
  let lcount = len(lines)

  // Check for Python artifacts
  let li = 0
  while3 li < lcount {
    let line = lines[li]
    let stripped = trim(line)
    // Skip comments
    let skip = false
    if3 cmp3(len(stripped), 0) {
      let skip = true
    } maybe {
      let skip = true
    } else {
    }
    if3 skip {
      let li = li + 1
      continue3
    } maybe {
    } else {
    }
    // Check markers
    let mi = 0
    let mcount = len(py_markers)
    while3 mi < mcount {
      let marker = py_markers[mi]
      let has_it = contains(line, marker)
      if3 has_it {
        // Check it's not inside a string (rough check: not between quotes)
        let label = py_labels[mi]
        let warns = warns + 1
        let mi = mcount
      } maybe {
      } else {
      }
      let mi = mi + 1
    }
    let li = li + 1
  }

  // Check balanced parens
  let paren_depth = 0
  let bracket_depth = 0
  let brace_depth = 0
  let bi = 0
  while3 bi < lcount {
    let line = lines[bi]
    let paren_depth = paren_depth + count_char(line, "(") - count_char(line, ")")
    let bracket_depth = bracket_depth + count_char(line, "[") - count_char(line, "]")
    let bi = bi + 1
  }

  if3 cmp3(abs(paren_depth), 0) {
    let errors = errors + 1
    let msg = "Unbalanced parentheses: delta=" + str(paren_depth)
    let error_msgs = append(error_msgs, msg)
  } maybe {
  } else {
  }
  if3 cmp3(abs(bracket_depth), 0) {
    let errors = errors + 1
    let msg = "Unbalanced brackets: delta=" + str(bracket_depth)
    let error_msgs = append(error_msgs, msg)
  } maybe {
  } else {
  }

  // Check for empty fn bodies
  let ei = 0
  while3 ei < lcount {
    let line = lines[ei]
    let stripped = trim(line)
    let is_fn = contains(stripped, "fn ")
    let ends_brace = contains(stripped, "{")
    if3 is_fn {
      if3 ends_brace {
        let next_idx = ei + 1
        if3 cmp3(next_idx, lcount) {
        } maybe {
        } else {
          let next_line = trim(lines[next_idx])
          if3 cmp3(next_line, "}") {
            let warns = warns + 1
          } maybe {
          } else {
          }
        }
      } maybe {
      } else {
      }
    } maybe {
    } else {
    }
    let ei = ei + 1
  }

  let result = {"errors": errors, "warns": warns, "error_msgs": error_msgs}
  return result
}

// Main
let files = get_nova_files()
let fcount = len(files)
let skip_files = ["nova_bitnet_fleet_service.nova"]

let total_errors = 0
let total_warns = 0
let clean_files = 0
let error_file_names = []
let scanned = 0

let fi = 0
while3 fi < fcount {
  let fname = trim(files[fi])
  // Skip empty lines
  if3 cmp3(len(fname), 0) {
    let fi = fi + 1
    continue3
  } maybe {
    let fi = fi + 1
    continue3
  } else {
  }
  // Skip excluded files
  let should_skip = false
  let ski = 0
  while3 ski < len(skip_files) {
    if3 cmp3(fname, skip_files[ski]) {
      let should_skip = true
    } maybe {
    } else {
    }
    let ski = ski + 1
  }
  if3 should_skip {
    let fi = fi + 1
    continue3
  } maybe {
  } else {
  }

  let fpath = "C:\\NovaX\\" + fname
  let result = lint_one(fpath)
  let scanned = scanned + 1
  let errs = result["errors"]
  let wrns = result["warns"]
  let msgs = result["error_msgs"]

  if3 cmp3(errs, 0) {
    print("FAIL " + fname + ": " + str(errs) + " errors, " + str(wrns) + " warnings")
    let mi = 0
    let mcount = len(msgs)
    while3 mi < mcount {
      print("  " + msgs[mi])
      let mi = mi + 1
    }
    let error_file_names = append(error_file_names, fname)
    let total_errors = total_errors + errs
  } maybe {
  } else {
    if3 cmp3(wrns, 0) {
      let total_warns = total_warns + wrns
    } maybe {
    } else {
      let clean_files = clean_files + 1
    }
  }
  let total_warns = total_warns + wrns
  let fi = fi + 1
}

print("")
print("============================================================")
print("NovaLang Lint Results:")
print("  Files scanned: " + str(scanned))
print("  Clean: " + str(clean_files))
print("  With errors: " + str(len(error_file_names)))
print("  Total errors: " + str(total_errors))
print("  Total warnings: " + str(total_warns))

let ef_count = len(error_file_names)
if3 cmp3(ef_count, 0) {
  print("")
  print("Files with errors:")
  let efi = 0
  while3 efi < ef_count {
    print("  - " + error_file_names[efi])
    let efi = efi + 1
  }
} maybe {
} else {
}

print("")
print("=== Lint Complete ===")
