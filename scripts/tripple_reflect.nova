let TRIPPLE = "http://127.0.0.1:9881/hive/tripple/ripple"
let OUT_DIR = "C:\\NovaX\\data\\classified_reflections"

let _mk = try3 { shell("mkdir " + OUT_DIR) } fail { 0 }

