    "CROSS_LANGUAGE|What architectures enable real-time translation of streaming multilingual content?",
    "CROSS_LANGUAGE|How do systems handle code-switching in multilingual data?",
    "CROSS_LANGUAGE|Describe techniques for cross-language document clustering and topic modeling",
    "CROSS_LANGUAGE|What models work best for low-resource language processing?",
    "CROSS_LANGUAGE|How do AI systems detect semantic drift across translated texts?",
    "CROSS_LANGUAGE|Describe cross-lingual sentiment and intent detection approaches",
    "CROSS_LANGUAGE|What techniques identify the source language of machine-translated text?",
    "CROSS_LANGUAGE|How do multilingual AI systems handle dialectal and regional variation?",
    "CROSS_LANGUAGE|Describe approaches to automated subtitling of multilingual video",
    "CROSS_LANGUAGE|What techniques extract structured information from non-English sources?",
    "CROSS_LANGUAGE|How do AI systems maintain contextual coherence across translated chains?"
]

let total_saved = 0
let total_failed = 0
let current_domain = ""
let domain_idx = 0

for3 entry in ALL_PROMPTS {
    let parts = split(entry, "|")
    let domain = parts[0]
    let prompt = parts[1]

    if3 domain != current_domain {
        current_domain = domain
        domain_idx = 0
        print("=== " + domain + " ===")
    }
    domain_idx = domain_idx + 1

    print("  [" + str(domain_idx) + "] " + slice(prompt, 0, 50) + "...")

    let resp = try3 { http_post(CLOUD, json_encode({"prompt": prompt}), 30000) } fail { null }

    let response_text = ""
    let provider = "unknown"
    let model = "unknown"

    if3 resp != null {
        // http_post returns dict with body, status, etc.
        let body = dict_get(resp, "body") ?? ""
        if3 len(body) > 5 {
            let clean_body = replace(replace(replace(body, "\n", " "), "\r", ""), "\t", " ")
            let parsed = try3 { json_decode(clean_body) } fail { null }
            if3 parsed != null {
                response_text = dict_get(parsed, "response") ?? ""
                provider = dict_get(parsed, "provider") ?? "unknown"
                model = dict_get(parsed, "model") ?? "unknown"
            }
        }
        // If body was empty, try direct fields
        if3 response_text == "" {
            response_text = dict_get(resp, "response") ?? ""
            provider = dict_get(resp, "provider") ?? provider
            model = dict_get(resp, "model") ?? model
        }
    }

    let result = {}
    result = dict_set(result, "capability", domain)
    result = dict_set(result, "prompt", prompt)
    result = dict_set(result, "response", response_text)
    result = dict_set(result, "provider", provider)
    result = dict_set(result, "model", model)
    result = dict_set(result, "trit", 1)
    result = dict_set(result, "timestamp", time())

    let fname = OUT_DIR + "\\" + domain + "_" + str(domain_idx) + ".json"
    let _w = try3 { write_file(fname, json_encode(result)) } fail { 0 }

    if3 len(response_text) > 0 {
        let _rip = try3 { http_post(TRIPPLE, json_encode({"provider": provider, "trit": 1, "latency": 1000, "domain": domain})) } fail { 0 }
        total_saved = total_saved + 1
        print("    OK: " + provider + " (" + str(len(response_text)) + " chars)")
    } else3 {
        total_failed = total_failed + 1
        print("    EMPTY")
    }

    sleep(3)
}

print("")
print("=== REFLECTION COMPLETE ===")
print("With content: " + str(total_saved))
print("Empty: " + str(total_failed))
print("Total: " + str(total_saved + total_failed))
