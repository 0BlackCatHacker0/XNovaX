// TRIPPLE MAX PROVIDERS — Hit EVERY provider we have access to
// Fires same 7 prompts to ALL 21 cloud providers + free OpenRouter models
// Maximum diversity for Tripple resonance

let CLOUD = "http://127.0.0.1:9878/api/v1/query"
let TRIPPLE = "http://127.0.0.1:9881/hive/tripple/ripple"
let total = 0

print("TRIPPLE MAX PROVIDERS — ALL 21 CLOUD + ALL FREE MODELS")
print("")

// 7 domain prompts (one per domain)
let PROMPTS = [
    {"text": "Prove that there are infinitely many prime numbers", "domain": "MATH"},
    {"text": "Write a ternary ALU implementation in Verilog", "domain": "CODE"},
    {"text": "Write a short story about an AI that dreams in three states", "domain": "LONG"},
    {"text": "What is the current state of quantum computing in 2026", "domain": "FACT"},
    {"text": "Translate the concept of artificial consciousness into Japanese Chinese Arabic and Hindi", "domain": "LANGUAGE"},
    {"text": "Design a self-healing distributed system using ternary consensus", "domain": "AGENT"},
    {"text": "Compare the philosophical frameworks of Kant Hegel and Wittgenstein on the nature of logic", "domain": "REASON"}
]

// All 21 direct providers
let PROVIDERS = [
    "cerebras_direct",
    "sambanova_direct",
    "google_ai_studio",
    "openai",
    "anthropic",
    "google",
    "openrouter",
    "github_models",
    "mistral_direct",
    "nvidia_nim",
    "kluster_ai",
    "deepinfra",
    "together_direct",
    "cloudflare_ai",
    "cohere_direct",
    "apifreellm",
    "mistral",
    "groq",
    "deepseek",
    "cohere",
    "together"
]

// Fire all 21 providers x 7 prompts = 147 queries
print("== PHASE 1: All 21 providers x 7 prompts = 147 ==")
for3 p in PROMPTS {
    let prompt = dict_get(p, "text") ?? ""
    let domain = dict_get(p, "domain") ?? "REASON"
    print("  Domain: " + domain)

    for3 provider in PROVIDERS {
        let body = json_encode({"prompt": prompt, "provider": provider})
        let resp = try3 { http_post(CLOUD, body, 30000) } fail { null }
        let b = dict_get(resp, "body") ?? ""
        let rlen = len(b)

        let trit = 1
        if3 rlen < 10 {
            trit = -1
        }

        let _rip = try3 { http_post(TRIPPLE, json_encode({"provider": provider, "trit": trit, "latency": 2000, "domain": domain}), 5000) } fail { 0 }
        total = total + 1
    }
    print("    " + str(total) + " fired so far")
}

// Fire all 27 free OpenRouter models x 3 prompts = 81
print("")
print("== PHASE 2: All 27 free OpenRouter models x 3 prompts = 81 ==")
let FREE_MODELS = [
    "openai/gpt-oss-120b:free",
    "openai/gpt-oss-20b:free",
    "nvidia/nemotron-3-super-120b-a12b:free",
    "nvidia/nemotron-3-nano-30b-a3b:free",
    "nvidia/nemotron-nano-12b-v2-vl:free",
    "nvidia/nemotron-nano-9b-v2:free",
    "qwen/qwen3-coder:free",
    "qwen/qwen3-next-80b-a3b-instruct:free",
    "qwen/qwen3-4b:free",
    "nousresearch/hermes-3-llama-3.1-405b:free",
    "meta-llama/llama-3.3-70b-instruct:free",
    "meta-llama/llama-3.2-3b-instruct:free",
    "google/gemma-3-27b-it:free",
    "google/gemma-3-12b-it:free",
    "google/gemma-3-4b-it:free",
    "z-ai/glm-4.5-air:free",
    "minimax/minimax-m2.5:free",
    "mistralai/mistral-small-3.1-24b-instruct:free",
    "arcee-ai/trinity-large-preview:free",
    "arcee-ai/trinity-mini:free",
    "stepfun/step-3.5-flash:free",
    "liquid/lfm-2.5-1.2b-instruct:free",
    "liquid/lfm-2.5-1.2b-thinking:free",
    "cognitivecomputations/dolphin-mistral-24b-venice-edition:free",
    "google/gemma-3n-e4b-it:free",
    "google/gemma-3n-e2b-it:free",
    "openrouter/free"
]

let FREE_PROMPTS = [
    {"text": "What makes ternary computing superior to binary", "domain": "REASON"},
    {"text": "Write a function that converts decimal to balanced ternary", "domain": "CODE"},
    {"text": "Explain the Navier-Stokes millennium prize problem", "domain": "MATH"}
]

for3 p in FREE_PROMPTS {
    let prompt = dict_get(p, "text") ?? ""
    let domain = dict_get(p, "domain") ?? "REASON"
    print("  Domain: " + domain)

    for3 model in FREE_MODELS {
        let body = json_encode({"prompt": prompt, "provider": "openrouter", "model": model})
        let resp = try3 { http_post(CLOUD, body, 30000) } fail { null }
        let b = dict_get(resp, "body") ?? ""
        let rlen = len(b)

        let trit = 1
        if3 rlen < 10 {
            trit = -1
        }

        let _rip = try3 { http_post(TRIPPLE, json_encode({"provider": model, "trit": trit, "latency": 3000, "domain": domain}), 5000) } fail { 0 }
        total = total + 1
    }
    print("    " + str(total) + " fired so far")
}

// Fire top 13 paid models with cheapest pricing x 1 prompt each
print("")
print("== PHASE 3: Top cheap paid models x 1 prompt = 13 ==")
let PAID_MODELS = [
    "meta-llama/llama-4-maverick",
    "google/gemini-2.5-flash",
    "google/gemini-2.0-flash-001",
    "openai/gpt-4.1-nano",
    "qwen/qwen3.5-flash-02-23",
    "google/gemini-2.5-flash-lite",
    "google/gemini-3-flash-preview",
    "xiaomi/mimo-v2-pro",
    "minimax/minimax-01",
    "amazon/nova-2-lite-v1",
    "writer/palmyra-x5",
    "x-ai/grok-4.1-fast",
    "x-ai/grok-4-fast"
]

let paid_prompt = "In three sentences describe how fluid dynamics equations can model information flow through neural networks"
for3 model in PAID_MODELS {
    let body = json_encode({"prompt": paid_prompt, "provider": "openrouter", "model": model})
    let resp = try3 { http_post(CLOUD, body, 30000) } fail { null }
    let b = dict_get(resp, "body") ?? ""
    let rlen = len(b)

    let trit = 1
    if3 rlen < 10 {
        trit = -1
    }

    let _rip = try3 { http_post(TRIPPLE, json_encode({"provider": model, "trit": trit, "latency": 2000, "domain": "REASON"}), 5000) } fail { 0 }
    total = total + 1
    print("  [" + str(total) + "] " + slice(model, 0, 35) + " (" + str(rlen) + ")")
}

print("")
print("TRIPPLE MAX PROVIDERS COMPLETE")
print("Total queries: " + str(total))
print("Expected: 147 + 81 + 13 = 241")
