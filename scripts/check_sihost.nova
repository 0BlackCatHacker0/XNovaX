// Check what sihost.exe is spawning.

fn3 main() {
  let r = shell("powershell -NoProfile -Command \"Get-CimInstance Win32_Process -Filter 'ParentProcessId=15768' | Select ProcessId,Name,CommandLine | ConvertTo-Json\"")

  if3 len(trim(r)) > 0 {
    let data = parse_json(r)
    if3 type_of(data) != "array" {
      let data = [data]
    }
    for3 i in range(0, len(data)) {
      let p = data[i]
      print("PID=" + str(dict_get(p, "ProcessId") ?? "?") + " Name=" + str(dict_get(p, "Name") ?? "?"))
      let cmd = dict_get(p, "CommandLine") ?? ""
      if3 len(cmd) > 200 { let cmd = slice(cmd, 0, 200) }
      if3 len(cmd) > 0 {
        print("  CMD: " + cmd)
      }
    }
  } else3 {
    print("No child processes of sihost (PID 15768)")
  }
}

main()
