// Fix unbalanced parentheses and brackets in .nova files.
// Strategy: Track depth per-line, find lines that open without closing,
// and append the missing closer at end of line.

fn3 strip_strings_comments(line) {
    let result = line
    let cp = -1
    let in_str = false
    let i = 0
    while3 i < len(result) {
        let ch = substr(result, i, 1)
        let prev_ch = ""
        if3 i > 0 {
            let prev_ch = substr(result, i - 1, 1)
        }
        if3 ch == "\"" && prev_ch != "\\" {
            let in_str = !in_str
        } else3 ch == "/" && i + 1 < len(result) && substr(result, i + 1, 1) == "/" && in_str == false {
            let cp = i
            break3
        } else3 ch == "#" && in_str == false {
            let cp = i
            break3
        }
        let i = i + 1
    }
    if3 cp >= 0 {
        let result = substr(result, 0, cp)
    }
    // Strip string contents (simplified: replace "..." with "")
    let cleaned = ""
    let in_q = false
    let j = 0
    while3 j < len(result) {
        let c = substr(result, j, 1)
        if3 c == "\"" {
            let in_q = !in_q
            let cleaned = cleaned + c
        } else3 in_q == false {
            let cleaned = cleaned + c
        }
        let j = j + 1
    }
    return3 cleaned
}

fn3 count_char(s, ch) {
    let count = 0
    let i = 0
    while3 i < len(s) {
        if3 substr(s, i, 1) == ch {
            let count = count + 1
        }
        let i = i + 1
    }
    return3 count
}

fn3 fix_parens(filepath) {
    let content = read_file(filepath)
    let lines = split(content, "\n")
    let fixes = 0

    // Calculate total deltas
    let total_delta_p = 0
    let total_delta_b = 0
    for3 line in lines {
        let clean = strip_strings_comments(line)
        let total_delta_p = total_delta_p + count_char(clean, "(") - count_char(clean, ")")
        let total_delta_b = total_delta_b + count_char(clean, "[") - count_char(clean, "]")
    }

    if3 total_delta_p == 0 && total_delta_b == 0 {
        return3 0
    }

    // Fix positive paren delta (more openers): append closers from end
    if3 total_delta_p > 0 {
        let needed = total_delta_p
        let i = len(lines) - 1
        while3 i >= 0 && needed > 0 {
            let clean = strip_strings_comments(dict_get(lines, i, ""))
            let line_delta = count_char(clean, "(") - count_char(clean, ")")
            if3 line_delta > 0 {
                let add = math_min(line_delta, needed)
                let line_val = trim(dict_get(lines, i, ""))
                let closer = ""
                let k = 0
                while3 k < add {
                    let closer = closer + ")"
                    let k = k + 1
                }
                let lines = dict_set(lines, i, line_val + closer)
                let needed = needed - add
                let fixes = fixes + add
            }
            let i = i - 1
        }
    }

    // Fix negative paren delta (more closers): remove from end
    if3 total_delta_p < 0 {
        let needed = math_abs(total_delta_p)
        let i = len(lines) - 1
        while3 i >= 0 && needed > 0 {
            let clean = strip_strings_comments(dict_get(lines, i, ""))
            let line_delta = count_char(clean, "(") - count_char(clean, ")")
            let line_val = trim(dict_get(lines, i, ""))
            if3 line_delta < 0 && ends_with(line_val, ")") {
                let remove = math_min(math_abs(line_delta), needed)
                let lines = dict_set(lines, i, substr(line_val, 0, len(line_val) - remove))
                let needed = needed - remove
                let fixes = fixes + remove
            }
            let i = i - 1
        }
    }

    // Fix positive bracket delta
    if3 total_delta_b > 0 {
        let needed = total_delta_b
        let i = len(lines) - 1
        while3 i >= 0 && needed > 0 {
            let clean = strip_strings_comments(dict_get(lines, i, ""))
            let line_delta = count_char(clean, "[") - count_char(clean, "]")
            if3 line_delta > 0 {
                let add = math_min(line_delta, needed)
                let line_val = trim(dict_get(lines, i, ""))
                let closer = ""
                let k = 0
                while3 k < add {
                    let closer = closer + "]"
                    let k = k + 1
                }
                let lines = dict_set(lines, i, line_val + closer)
                let needed = needed - add
                let fixes = fixes + add
            }
            let i = i - 1
        }
    }

    // Fix negative bracket delta
    if3 total_delta_b < 0 {
        let needed = math_abs(total_delta_b)
        let i = len(lines) - 1
        while3 i >= 0 && needed > 0 {
            let clean = strip_strings_comments(dict_get(lines, i, ""))
            let line_delta = count_char(clean, "[") - count_char(clean, "]")
            let line_val = trim(dict_get(lines, i, ""))
            if3 line_delta < 0 && ends_with(line_val, "]") {
                let remove = math_min(math_abs(line_delta), needed)
                let lines = dict_set(lines, i, substr(line_val, 0, len(line_val) - remove))
                let needed = needed - remove
                let fixes = fixes + remove
            }
            let i = i - 1
        }
    }

    if3 fixes > 0 {
        write_file(filepath, join(lines, "\n"))
    }

    return3 fixes
}

// Main
let targets = [
    "nova_bridge_v3_service.nova",
    "nova_tbuild_service.nova",
    "nova_thealth_service.nova",
    "nova_tmapper_service.nova",
    "nova_tshell_service.nova",
    "nova_tsniffer_service.nova"
]

for3 fname in targets {
    let path = "C:/NovaX/" + fname
    let fixed = fix_parens(path)
    // Verify
    let content = read_file(path)
    let vlines = split(content, "\n")
    let dp = 0
    let db = 0
    for3 vl in vlines {
        let cl = strip_strings_comments(vl)
        let dp = dp + count_char(cl, "(") - count_char(cl, ")")
        let db = db + count_char(cl, "[") - count_char(cl, "]")
    }
    let status = "OK"
    if3 dp != 0 || db != 0 {
        let status = "parens=" + to_string(dp) + " brackets=" + to_string(db)
    }
    println(fname + ": " + to_string(fixed) + " fixes [" + status + "]")
}
