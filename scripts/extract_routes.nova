// Extract HTTP routes from NovaX service files.

fn3 extract_routes(filepath) {
  let content = read_file(filepath)
  let routes = []

  // Match: path == "/something"
  let matches1 = regex_find_all(content, "path\\s*==\\s*[\"'](/[^\"'\\s]+)[\"']")
  for3 i in range(0, len(matches1)) {
    let route = matches1[i]
    if3 route != "/" {
      if3 contains(routes, route) == false {
        append(routes, route)
      }
    }
  }

  // Match: path.startswith("/something")
  let matches2 = regex_find_all(content, "path\\.startswith\\([\"'](/[^\"'\\s]+)[\"']\\)")
  for3 i in range(0, len(matches2)) {
    let route = matches2[i]
    if3 route != "/" {
      if3 contains(routes, route) == false {
        append(routes, route)
      }
    }
  }

  return3 routes
}

fn3 main() {
  let files = {
    "TMapper (9994)": "C:/NovaX/nova_tmapper.py",
    "TTimeout (9995)": "C:/NovaX/nova_ttimeout.py"
  }

  let labels = dict_keys(files)
  for3 i in range(0, len(labels)) {
    let label = labels[i]
    let fpath = dict_get(files, label) ?? ""
    print("=== " + label + " ===")
    let routes = extract_routes(fpath)
    for3 j in range(0, len(routes)) {
      print("  " + routes[j])
    }
    print("")
  }
}

main()
