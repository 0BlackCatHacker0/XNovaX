let PORT = 9999
let server = tserve(PORT, "Nova Agent_Runner")

// ── Constants ──
let BRIDGE_URL = "http://127.0.0.1:9887"
let HIVEMIND_URL = "http://127.0.0.1:9881"
let ORCHESTRATOR_URL = "http://127.0.0.1:9999"
let MAX_ACTIONS_PER_TASK = H13 * H3  # 39 max actions before giving up

fn handle_health(req) {
    let uptime = now() - _start_time
    return {
        "ok": 1,
        "trit": 1,
        "service": "Nova Agent_Runner",
        "port": 9999,
        "uptime": uptime
    }
}

// ── Routes ──
troute(server, "GET", "/health", "handle_health")

print("[Nova Agent_Runner] Starting on port " + str(PORT))
tstart(server)