let PORT = 9999
let server = tserve(PORT, "Nova Compiler")

fn handle_health(req) {
    let uptime = now() - _start_time
    return {
        "ok": 1,
        "trit": 1,
        "service": "Nova Compiler",
        "port": 9999,
        "uptime": uptime
    }
}

// ── Routes ──
troute(server, "GET", "/health", "handle_health")

print("[Nova Compiler] Starting on port " + str(PORT))
tstart(server)