troute(server, "POST", "/tspeak/deliberate",  "tspeak_deliberate")
troute(server, "POST", "/tspeak/classify",    "tspeak_classify")
troute(server, "POST", "/tspeak/merge",       "tspeak_merge")
troute(server, "POST", "/tspeak/carry",       "tspeak_carry")
troute(server, "POST", "/tspeak/math",        "tspeak_math")

