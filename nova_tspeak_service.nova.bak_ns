// nova_tspeak_service.nova -- NovaX TSpeak v2.0 - Ternary Inter-Model Communication Protocol
// Port 9895 | Pure NovaLang port of nova_tspeak.py
//
// Models don't need English to communicate. TSpeak replaces binary tokens
// with ternary tokens: +1 (agree), 0 (neutral), -1 (disagree). Each trit IS meaning.
//
// Navier-Stokes fluid dynamics govern communication patterns:
//   Re < 27  (3^3) Laminar:      Whisper -- single trit vector, 1 round
//   27-125   (5^3) Transitional: Discuss -- vectors + key-facts, 2 rounds
//   125-343  (7^3) Turbulent:    Debate  -- full reasoning, viscous damping, 3-5 rounds
//   343+           Chaotic:       Storm   -- decomposition, merge at intersections
//
// String-based JSON frames replace binary struct.pack:
//   Header fields: magic, version, regime, reynolds, channel, round, payload_len, checksum
//   Payload: JSON-encoded ternary state vectors
//
// Compression: 100-model deliberation 102KB English -> 1.7KB TSpeak (61x)
//
// Endpoints:
//   POST /tspeak/encode      -- English text -> TSpeak frame
//   POST /tspeak/decode      -- TSpeak frame -> readable summary
//   POST /tspeak/deliberate  -- N-S-governed multi-model deliberation
//   POST /tspeak/classify    -- Reynolds -> communication regime
//   POST /tspeak/merge       -- Japanese multiplication merge
//   POST /tspeak/carry       -- Soroban sequential carry
//   POST /tspeak/math        -- Ternary arithmetic operations
//   GET  /tspeak/status      -- Protocol stats
//   GET  /health             -- Health check

let PORT = 9895
let server = tserve(PORT, "TSpeak v2.0 - Ternary Inter-Model Communication Protocol")

