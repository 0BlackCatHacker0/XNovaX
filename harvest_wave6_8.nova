// Waves 6-8: 39 prompts x 3 providers = up to 117 new samples

let _config = try3 { json_decode(read_file("C:/NovaX/cloud_config.json")) } fail { {} }
let _ck = dict_get(dict_get(_config, "cerebras_direct") ?? {}, "key") ?? ""
let _sk = dict_get(dict_get(_config, "sambanova_direct") ?? {}, "key") ?? ""
let _ok = dict_get(dict_get(_config, "openrouter") ?? {}, "key") ?? ""

let or_free = [
  "openai/gpt-oss-120b:free", "openai/gpt-oss-20b:free",
  "qwen/qwen3-coder:free", "qwen/qwen3-next-80b-a3b-instruct:free",
  "nvidia/nemotron-3-super-120b-a12b:free", "arcee-ai/trinity-large-preview:free",
  "minimax/minimax-m2.5:free", "stepfun/step-3.5-flash:free",
  "z-ai/glm-4.5-air:free", "google/gemma-3n-e2b-it:free",
  "nvidia/nemotron-nano-12b-v2-vl:free", "liquid/lfm-2.5-1.2b-thinking:free",
  "nvidia/nemotron-nano-9b-v2:free"
]
let sb = ["Meta-Llama-3.3-70B-Instruct", "DeepSeek-V3-0324", "Qwen3-235B-A22B"]
let cb = ["qwen-3-235b-a22b-instruct-2507", "llama3.1-8b"]

let prompts = [
  "What is a Turing machine", "Define lambda calculus", "What is type inference",
  "Explain garbage collection", "What is a mutex lock", "Define actor model concurrency",
  "What is lazy evaluation", "Explain monadic composition", "What is tail call optimization",
  "Define abstract syntax tree", "What is semantic analysis", "Explain register allocation",
  "What is instruction pipelining",
  "Define information entropy", "What is Kolmogorov complexity", "Explain lossy vs lossless compression",
  "What is arithmetic coding", "Define Huffman encoding", "What is delta encoding",
  "Explain run length encoding", "What is dictionary compression", "Define entropy coding",
  "What is predictive coding", "Explain transform coding", "What is vector quantization",
  "Define rate distortion theory",
  "What is backpropagation", "Define loss function", "What is batch normalization",
  "Explain dropout regularization", "What is learning rate scheduling", "Define weight initialization",
  "What is skip connection", "Explain positional encoding", "What is multi head attention",
  "Define layer normalization", "What is beam search decoding", "Explain nucleus sampling",
  "What is temperature in language models"
]

fn call_api(url, body, headers) {
  let result = try3 { http_request(url, body, headers, 15000) } fail { {} }
  let raw = dict_get(result, "body") ?? ""
  if3 len(raw) < 10 { return "" }
  let parsed = try3 { json_decode(raw) } fail { {} }
  let choices = dict_get(parsed, "choices") ?? []
  if3 len(choices) == 0 { return "" }
  let msg = dict_get(choices[0], "message") ?? {}
  return dict_get(msg, "content") ?? ""
}

let success = 0
let id = 200
let i = 0

print("=== WAVES 6-8: " + str(len(prompts)) + " prompts x 3 providers ===")

while3 i < len(prompts) {
  let p = prompts[i] + ". Plain text only. No markdown or emojis. Brief answer."
  let esc = replace(replace(p, "\\", "\\\\"), "\"", "\\\"")

  // Cerebras
  let cm = cb[i % len(cb)]
  let t1 = call_api("https://api.cerebras.ai/v1/chat/completions", "{\"model\":\"" + cm + "\",\"messages\":[{\"role\":\"user\",\"content\":\"" + esc + "\"}],\"max_tokens\":512}", {"Authorization": "Bearer " + _ck, "Content-Type": "application/json"})
  if3 len(t1) > 3 {
    write_file("C:/NovaX/data/super_archive/w6_" + str(id) + ".json", json_encode({"prompt": prompts[i], "response": t1, "provider": "cerebras", "model": cm}))
    success = success + 1
    id = id + 1
  }
  sleep(2000)

  // SambaNova
  let sm = sb[i % len(sb)]
  let t2 = call_api("https://api.sambanova.ai/v1/chat/completions", "{\"model\":\"" + sm + "\",\"messages\":[{\"role\":\"user\",\"content\":\"" + esc + "\"}],\"max_tokens\":512}", {"Authorization": "Bearer " + _sk, "Content-Type": "application/json"})
  if3 len(t2) > 3 {
    write_file("C:/NovaX/data/super_archive/w6_" + str(id) + ".json", json_encode({"prompt": prompts[i], "response": t2, "provider": "sambanova", "model": sm}))
    success = success + 1
    id = id + 1
  }
  sleep(2000)

  // OpenRouter free
  let om = or_free[i % len(or_free)]
  let t3 = call_api("https://openrouter.ai/api/v1/chat/completions", "{\"model\":\"" + om + "\",\"messages\":[{\"role\":\"user\",\"content\":\"" + esc + "\"}],\"max_tokens\":512}", {"Authorization": "Bearer " + _ok, "Content-Type": "application/json"})
  if3 len(t3) > 3 {
    write_file("C:/NovaX/data/super_archive/w6_" + str(id) + ".json", json_encode({"prompt": prompts[i], "response": t3, "provider": "openrouter", "model": om}))
    success = success + 1
    id = id + 1
  }
  sleep(3000)

  if3 i % 13 == 12 { print("  Wave checkpoint: " + str(success) + " samples at prompt " + str(i + 1)) }
  i = i + 1
}

print("")
print("WAVES 6-8: " + str(success) + " new samples")
print("Total archive: check C:/NovaX/data/super_archive/")
