// NovaX Swarm DIRECT FIRE — Bypass cloud router, hit APIs directly
// Sequential provider firing with deep context upgrade tasks

let OUT_DIR = "C:/NovaX/swarm_upgrades"
try3 { shell("mkdir -p " + OUT_DIR) } catch3 { }

let NOVA_CTX = "You are upgrading NovaX, an AI Operating System with 111 services, 29 providers, 510K+ models.\nLanguage: NovaLang (.nova files, ternary-native Rust VM). Key syntax:\n- if3/match3/try3/while3 (3-way branching: +1/0/-1)\n- dict_set() returns NEW dict (MUST reassign: d = dict_set(d, k, v))\n- append() returns NEW list (MUST reassign: l = append(l, item))\n- dict_get() only on dicts, bracket syntax for lists: list[i]\n- try3 { expr } { fallback } (NO fail keyword)\n- http_post(url, json_encode(body)) (must encode)\n- shell() returns {ok, stdout, stderr, code} dict\n- No || or && operators (use nested if3)\n- tserve(PORT, NAME) with troute() for HTTP endpoints\nArchitecture: Orchestrator(:9999) -> CloudRouter(:9878) -> Fractal(:9874) -> Hivemind(:9881)\nN-S Flow: Reynolds Re=rho*u*L/mu, harmonics 3-5-7-13, Chladni routing, Kolmogorov cascade\nWrite production-ready code. Follow ALL gotchas above."

// Load cloud config for API keys
let cloud_config = {}
try3 {
    let raw = read_file("C:/NovaX/cloud_config.json")
    let cloud_config = json_decode(raw)
} catch3 {
    print("Warning: could not load cloud_config.json")
}

let openai_key = dict_get(dict_get(cloud_config, "openai") ?? {}, "key") ?? ""
let openrouter_key = dict_get(dict_get(cloud_config, "openrouter") ?? {}, "key") ?? ""
let cerebras_key = dict_get(dict_get(cloud_config, "cerebras_direct") ?? {}, "key") ?? ""
let google_key = dict_get(dict_get(cloud_config, "google_ai_studio") ?? {}, "key") ?? ""
let sambanova_key = dict_get(dict_get(cloud_config, "sambanova_direct") ?? {}, "key") ?? ""

// Provider configs: [name, url, key, model, type]
let PROVIDERS = []
if3 len(openai_key) > 0 {
    PROVIDERS = append(PROVIDERS, ["openai", "https://api.openai.com/v1/chat/completions", openai_key, "gpt-4.1-nano", "openai"])
}
if3 len(openrouter_key) > 0 {
    PROVIDERS = append(PROVIDERS, ["openrouter-free1", "https://openrouter.ai/api/v1/chat/completions", openrouter_key, "meta-llama/llama-3.3-70b-instruct:free", "openai"])
    PROVIDERS = append(PROVIDERS, ["openrouter-free2", "https://openrouter.ai/api/v1/chat/completions", openrouter_key, "qwen/qwen3-coder:free", "openai"])
    PROVIDERS = append(PROVIDERS, ["openrouter-free3", "https://openrouter.ai/api/v1/chat/completions", openrouter_key, "deepseek/deepseek-chat-v3.1", "openai"])
    PROVIDERS = append(PROVIDERS, ["openrouter-free4", "https://openrouter.ai/api/v1/chat/completions", openrouter_key, "google/gemma-3-27b-it:free", "openai"])
    PROVIDERS = append(PROVIDERS, ["openrouter-free5", "https://openrouter.ai/api/v1/chat/completions", openrouter_key, "nousresearch/hermes-3-llama-3.1-405b:free", "openai"])
    PROVIDERS = append(PROVIDERS, ["openrouter-free6", "https://openrouter.ai/api/v1/chat/completions", openrouter_key, "arcee-ai/trinity-large-preview:free", "openai"])
    PROVIDERS = append(PROVIDERS, ["openrouter-free7", "https://openrouter.ai/api/v1/chat/completions", openrouter_key, "nvidia/nemotron-3-nano-30b-a3b:free", "openai"])
    PROVIDERS = append(PROVIDERS, ["openrouter-deepseek-r1", "https://openrouter.ai/api/v1/chat/completions", openrouter_key, "deepseek/deepseek-r1-0528", "openai"])
}
if3 len(cerebras_key) > 0 {
    PROVIDERS = append(PROVIDERS, ["cerebras", "https://api.cerebras.ai/v1/chat/completions", cerebras_key, "qwen-3-235b-a22b-instruct-2507", "openai"])
}
if3 len(google_key) > 0 {
    PROVIDERS = append(PROVIDERS, ["google-ai-studio", "", google_key, "gemini-2.0-flash", "google"])
}
if3 len(sambanova_key) > 0 {
    PROVIDERS = append(PROVIDERS, ["sambanova", "https://api.sambanova.ai/v1/chat/completions", sambanova_key, "Meta-Llama-3.3-70B-Instruct", "openai"])
}

let TASKS = [
    ["router-enhance", "Improve Cloud Router: smart Chladni-based provider selection, Reynolds quality scoring, ternary exponential backoff failover. Write NovaLang code with function signatures."],
    ["hive-token-max", "Token maximizer: Kolmogorov cascade decomposition of tasks, parallel multi-provider dispatch, N-S synthesis. Write NovaLang micro-tool for millions tok/hr."],
    ["fractal-depth", "Fractal Engine enhancement: adaptive depth via Reynolds number, recursive 3-13 child splitting, Chladni frequency modulation for routing. Write NovaLang code."],
    ["swarm-consensus", "Swarm consensus algorithm: N-S Reynolds scoring of responses, ternary fingerprint grouping, best-parts synthesis, balanced ternary voting. Write NovaLang."],
    ["self-heal", "Self-healing service mesh: health3() monitoring 111 services, auto-restart via shell(), degraded detection, Reynolds flow regime classification. Write NovaLang."],
    ["vm-optimize", "NovaLang VM optimization: HAMT persistent data structures replacing clone-on-write, auto JSON parsing in tserve, async request handling. Write Rust code."],
    ["tripple-enhance", "Tripple search engine: Chladni 9 eigenmodes for domain classification, multi-provider parallel search, Reynolds dedup+ranking, model discovery. Write NovaLang."],
    ["event-system", "Event-driven architecture: central event bus service, publish/subscribe pattern, ternary event classification (+1/0/-1), fleet coordination. Write NovaLang."],
    ["security-harden", "Security: ternary rate-limiting with trit states, JSON schema validation, balanced ternary request signing (bt_pack), cross-service audit log. Write NovaLang."],
    ["perf-benchmark", "Benchmark suite: identical prompts to all providers, Reynolds number scoring, ternary leaderboard, auto-tune cascade order from results. Write NovaLang."],
    ["knowledge-graph", "Knowledge graph: nodes=services+providers+models, ternary edge weights, bt() encoded relationships, optimal routing path-finder. Write NovaLang."],
    ["swarm-codegen", "Swarm code generator: description->multi-provider fire->collect code->ternary voting->best impl->novalang.exe syntax check. Write NovaLang."],
    ["stdlib-enhance", "Enhance NovaLang stdlib: add graph3 module (graph operations), crypto3 (ternary hashing), stream3 (data streaming), cluster3 (service clustering). Write NovaLang."]
]

fn3 call_openai_api(url, key, model, prompt) {
    let body = json_encode({
        "model": model,
        "messages": [{"role": "user", "content": prompt}],
        "max_tokens": 2048,
        "temperature": 0.7
    })
    let headers = "Authorization: Bearer " + key
    // Use http_post with encoded body
    try3 {
        let raw = http_post(url, body)
        let data = json_decode(raw)
        let choices = dict_get(data, "choices") ?? []
        if3 len(choices) > 0 {
            let msg = dict_get(choices[0], "message") ?? {}
            return3 dict_get(msg, "content") ?? ""
        }
        return3 ""
    } catch3 {
        return3 ""
    }
}

fn3 call_google_api(key, model, prompt) {
    let url = "https://generativelanguage.googleapis.com/v1beta/models/" + model + ":generateContent?key=" + key
    let body = json_encode({
        "contents": [{"parts": [{"text": prompt}]}],
        "generationConfig": {"maxOutputTokens": 2048}
    })
    try3 {
        let raw = http_post(url, body)
        let data = json_decode(raw)
        let candidates = dict_get(data, "candidates") ?? []
        if3 len(candidates) > 0 {
            let content = dict_get(candidates[0], "content") ?? {}
            let parts = dict_get(content, "parts") ?? []
            if3 len(parts) > 0 {
                return3 dict_get(parts[0], "text") ?? ""
            }
        }
        return3 ""
    } catch3 {
        return3 ""
    }
}

let total_tokens = 0
let total_hits = 0
let results = []

print("=================================================================")
print("NOVA SWARM DIRECT FIRE — BYPASSING CLOUD ROUTER")
print("Tasks: " + str(len(TASKS)) + " | Providers: " + str(len(PROVIDERS)))
print("=================================================================")

let t0 = time_ms()

for3 ti in range(len(TASKS)) {
    let task_id = TASKS[ti][0]
    let task_desc = TASKS[ti][1]
    print("")
    print("--- Task " + str(ti + 1) + "/" + str(len(TASKS)) + ": " + task_id + " ---")

    let prompt = NOVA_CTX + "\n\nTASK: " + task_desc

    for3 pi in range(len(PROVIDERS)) {
        let prov = PROVIDERS[pi]
        let prov_name = prov[0]
        let prov_url = prov[1]
        let prov_key = prov[2]
        let prov_model = prov[3]
        let prov_type = prov[4]

        let text = ""
        try3 {
            if3 prov_type == "google" {
                let text = call_google_api(prov_key, prov_model, prompt)
            } else3 {
                let text = call_openai_api(prov_url, prov_key, prov_model, prompt)
            }
        } catch3 {
            print("  FAIL " + task_id + " | " + prov_name + ": error")
            continue
        }

        let words = split(text, " ")
        let tokens = len(words)
        if3 tokens > 10 {
            let total_tokens = total_tokens + tokens
            let total_hits = total_hits + 1
            results = append(results, {"task": task_id, "provider": prov_name, "model": prov_model, "tokens": tokens})
            let fname = OUT_DIR + "/" + task_id + "_" + prov_name + ".json"
            write_file(fname, json_encode({"task": task_id, "provider": prov_name, "model": prov_model, "tokens": tokens, "text": text}))
            print("  HIT  " + task_id + " | " + prov_name + " (" + prov_model + "): " + str(tokens) + " tok | Running total: " + str(total_tokens))
        } else3 {
            print("  MISS " + task_id + " | " + prov_name + ": too short (" + str(tokens) + "w)")
        }
        sleep_ms(500)
    }
}

let elapsed = (time_ms() - t0) / 1000

print("")
print("=================================================================")
print("SWARM DIRECT FIRE COMPLETE")
print("Hits:    " + str(total_hits))
print("Tokens:  " + str(total_tokens))
print("Time:    " + str(elapsed) + "s")
let max_elapsed = elapsed
if3 max_elapsed < 1 { let max_elapsed = 1 }
print("Rate:    " + str(int(total_tokens / max_elapsed)) + " tok/s")
print("Files:   " + OUT_DIR + "/")
print("=================================================================")

// Provider breakdown
print("")
print("Provider breakdown:")
let prov_stats = {}
for3 r in results {
    let p = dict_get(r, "provider")
    if3 dict_get(prov_stats, p) == null {
        prov_stats = dict_set(prov_stats, p, {"hits": 0, "tokens": 0})
    }
    let ps = dict_get(prov_stats, p)
    ps = dict_set(ps, "hits", dict_get(ps, "hits") + 1)
    ps = dict_set(ps, "tokens", dict_get(ps, "tokens") + dict_get(r, "tokens"))
    prov_stats = dict_set(prov_stats, p, ps)
}
for3 p in dict_keys(prov_stats) {
    let s = dict_get(prov_stats, p)
    print("  " + p + ": " + str(dict_get(s, "hits")) + " hits, " + str(dict_get(s, "tokens")) + " tokens")
}

// Save summary
write_file(OUT_DIR + "/swarm_summary.json", json_encode({
    "tasks": len(TASKS),
    "providers": len(PROVIDERS),
    "hits": total_hits,
    "tokens": total_tokens,
    "elapsed": elapsed,
    "rate": int(total_tokens / max_elapsed),
    "results": results
}))
