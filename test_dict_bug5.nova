// Test multi-line arrays at top level
let arr = [
    "alpha",
    "beta",
    "gamma"
]
print("array:")
print(arr)
print(len(arr))

// Test multi-line function call at top level
let result = json_encode({
    "key": "value",
    "nested": {"a": 1}
})
print("json_encode multi-line:")
print(result)

// Test deeply nested multi-line
let deep = {
    "level1": {
        "level2": {
            "level3": "deep"
        }
    }
}
print("deep nested:")
print(json_encode(deep))
