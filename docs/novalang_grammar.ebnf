(* NovaLang Formal Grammar — EBNF Specification *)
(* Version 1.2 — Derived from parser.rs + lexer.rs *)
(* Ternary-first language: -1/0/+1 native, 3-5-7-13 harmonic *)

(* ════════════════════════════════════════════════════════ *)
(* §1 PROGRAM STRUCTURE                                     *)
(* ════════════════════════════════════════════════════════ *)

program        = { newline }, { statement, { newline } }, EOF ;

statement      = let_stmt
               | fn_def
               | return_stmt
               | print_stmt
               | if3_stmt
               | for3_stmt
               | while3_stmt
               | try3_stmt
               | match3_stmt
               | class3_stmt
               | import3_stmt
               | break3_stmt
               | continue3_stmt
               | assign_stmt
               | compound_assign_stmt
               | dot_assign_stmt
               | index_assign_stmt
               | expr_stmt ;

(* ════════════════════════════════════════════════════════ *)
(* §2 DECLARATIONS                                          *)
(* ════════════════════════════════════════════════════════ *)

let_stmt       = ( "let" | "const" ), IDENT, "=", ( try3_assign | expression ) ;
try3_assign    = "try3", block, [ ( "fail" | "catch3" ), [ "(", IDENT, ")" ] ], block ;

fn_def         = "fn", IDENT, "(", [ param_list ], ")", block ;
param_list     = IDENT, { ",", IDENT } ;

class3_stmt    = "class3", IDENT, [ "extends3", IDENT ], "{", { statement }, "}" ;
import3_stmt   = "import3", [ "(" ], ( STRING | IDENT ), [ ")" ] ;

(* ════════════════════════════════════════════════════════ *)
(* §3 CONTROL FLOW — THREE-WAY BRANCHING                    *)
(* ════════════════════════════════════════════════════════ *)

(* if3: ternary branching — condition evaluated, then/maybe/else *)
if3_stmt       = ( "if3" | "if" ), expr_until_brace, block,
                 { elif_clause },
                 [ maybe_clause ],
                 [ else_clause ] ;

elif_clause    = ( "else3" | "else" ), expr_until_brace, block ;
maybe_clause   = "maybe", block ;
else_clause    = ( "else3" | "else" ), ( block | if3_stmt ) ;

(* for3: ternary iteration *)
for3_stmt      = ( "for3" | "for" ), IDENT, "in", expr_until_brace, block ;

(* while3: ternary loop *)
while3_stmt    = ( "while3" | "while" ), expr_until_brace, block ;

(* try3: ternary error handling — body/uncertain/fail *)
try3_stmt      = "try3", block,
                 [ ( "fail" | "catch3" ), [ "(", IDENT, ")" ], block ] ;

(* match3: ternary pattern matching on trit values *)
match3_stmt    = "match3", expr_until_brace, "{",
                 { match_arm },
                 "}" ;

match_arm      = trit_pattern, "=>", ( block | expression ) ;
trit_pattern   = "TRUE" | "MAYBE" | "FALSE_"
               | "true" | "maybe" | "false"
               | "T_TRUE" | "T_MAYBE" | "T_FALSE"
               | [ "+" | "-" ], INTEGER ;

(* Simple statements *)
return_stmt    = "return", [ expression ] ;
print_stmt     = "print", "(", [ expression, { ",", expression } ], ")" ;
break3_stmt    = "break3" ;
continue3_stmt = "continue3" ;

(* ════════════════════════════════════════════════════════ *)
(* §4 ASSIGNMENT                                            *)
(* ════════════════════════════════════════════════════════ *)

assign_stmt          = IDENT, "=", expression ;
compound_assign_stmt = IDENT, ( "+=" | "-=" | "*=" | "/=" ), expression ;
dot_assign_stmt      = IDENT, ".", IDENT, "=", expression ;
index_assign_stmt    = IDENT, "[", expression, "]", "=", expression ;
expr_stmt            = expression ;

(* ════════════════════════════════════════════════════════ *)
(* §5 EXPRESSIONS — PRECEDENCE (low to high)                *)
(* ════════════════════════════════════════════════════════ *)

expression     = or_expr ;

or_expr        = and_expr, { ( "or" | "OR" | "||" ), and_expr } ;
and_expr       = cmp_expr,  { ( "and" | "AND" | "&&" ), cmp_expr } ;
cmp_expr       = add_expr,  { ( "==" | "!=" | "<" | ">" | "<=" | ">=" ), add_expr } ;
add_expr       = mul_expr,  { ( "+" | "-" ), mul_expr } ;
mul_expr       = unary_expr, { ( "*" | "/" | "%" ), unary_expr } ;

unary_expr     = ( "not" | "NOT" | "!" ), unary_expr
               | "-", postfix_expr
               | postfix_expr ;

postfix_expr   = primary, { postfix_op } ;
postfix_op     = "(", [ arg_list ], ")"           (* function call *)
               | "[", expression, "]"              (* index access *)
               | ".", IDENT, [ "(", [ arg_list ], ")" ] ; (* dot / method call *)

arg_list       = expression, { ",", expression } ;

(* ════════════════════════════════════════════════════════ *)
(* §6 PRIMARY EXPRESSIONS                                   *)
(* ════════════════════════════════════════════════════════ *)

primary        = INTEGER
               | FLOAT
               | STRING
               | ternary_const
               | "null"
               | IDENT
               | "(", expression, ")"
               | list_literal
               | dict_literal
               | new3_expr ;

ternary_const  = "TRUE" | "true" | "T_TRUE"        (* trit +1 *)
               | "MAYBE" | "maybe" | "T_MAYBE"     (* trit  0 *)
               | "FALSE_" | "false" | "T_FALSE" ;   (* trit -1 *)

list_literal   = "[", [ expression, { ",", expression }, [ "," ] ], "]" ;
dict_literal   = "{", [ dict_entry, { ",", dict_entry }, [ "," ] ], "}" ;
dict_entry     = ( IDENT | STRING ), ":", expression ;
new3_expr      = "new3", IDENT, "(", [ arg_list ], ")" ;

(* ════════════════════════════════════════════════════════ *)
(* §7 BLOCKS                                                *)
(* ════════════════════════════════════════════════════════ *)

block          = "{", { newline }, { statement, { newline } }, "}" ;

(* expr_until_brace: expression consumed until next '{' at depth 0 *)
(* This is a parser convenience — no parens needed around conditions *)
expr_until_brace = expression ;  (* impl: stops at unmatched '{' *)

(* ════════════════════════════════════════════════════════ *)
(* §8 LEXICAL GRAMMAR                                       *)
(* ════════════════════════════════════════════════════════ *)

IDENT          = letter, { letter | digit | "_" } ;
letter         = "a".."z" | "A".."Z" | "_" ;
digit          = "0".."9" ;

INTEGER        = [ "-" ], digit, { digit | "_" } ;
FLOAT          = [ "-" ], digit, { digit | "_" }, ".", digit, { digit | "_" } ;

STRING         = '"', { string_char | escape_seq }, '"'
               | "'", { string_char_sq | escape_seq }, "'" ;
string_char    = ? any character except '"' and '\' ? ;
string_char_sq = ? any character except "'" and '\' ? ;
escape_seq     = "\", ( "n" | "t" | "r" | "0" | "\" | '"' | "'" ) ;

newline        = "\n" ;

(* Comments — discarded by lexer *)
comment        = "//", { ? any except newline ? }
               | "#", { ? any except newline ? } ;

(* ════════════════════════════════════════════════════════ *)
(* §9 KEYWORDS (reserved)                                    *)
(* ════════════════════════════════════════════════════════ *)
(* let, const, fn, return, print,                            *)
(* if, if3, else, else3, maybe,                              *)
(* for, for3, while, while3,                                 *)
(* try3, fail, catch3,                                       *)
(* match3, break3, continue3,                                *)
(* class3, extends3, new3, import3,                          *)
(* in, and, or, not, AND, OR, NOT,                           *)
(* true, TRUE, T_TRUE, false, FALSE_, T_FALSE,               *)
(* maybe, MAYBE, T_MAYBE, null                               *)

(* ════════════════════════════════════════════════════════ *)
(* §10 OPERATOR PRECEDENCE TABLE                             *)
(* ════════════════════════════════════════════════════════ *)
(*                                                           *)
(*  Prec  Operators           Assoc   Description            *)
(*  ────  ──────────────────  ─────   ───────────────────    *)
(*   0    =  +=  -=  *=  /=   right   assignment             *)
(*   1    or  OR  ||           left    logical or             *)
(*   2    and  AND  &&         left    logical and            *)
(*   3    ==  !=               left    equality               *)
(*   4    <  >  <=  >=         left    comparison             *)
(*   5    +  -                 left    additive               *)
(*   6    *  /  %              left    multiplicative         *)
(*   7    not  NOT  !  -       right   unary                  *)
(*   8    ()  []  .            left    postfix/call/index     *)
(*                                                           *)

(* ════════════════════════════════════════════════════════ *)
(* §11 TERNARY TYPE SYSTEM                                   *)
(* ════════════════════════════════════════════════════════ *)
(* NovaLang values are dynamically typed with native trits:  *)
(*   - Int(i64)        — 64-bit integer                      *)
(*   - Float(f64)      — 64-bit float                        *)
(*   - Str(String)     — UTF-8 string                        *)
(*   - Bool(bool)      — binary boolean (legacy compat)      *)
(*   - Trit(i8)        — ternary value: -1, 0, +1            *)
(*   - Null            — absence of value                    *)
(*   - List(Vec)       — ordered collection                  *)
(*   - Dict(Map)       — key-value map                       *)
(*   - Function        — first-class callable                *)
(*   - Class instance  — object with fields and methods      *)
(*                                                           *)
(* Trit is the NATIVE type. Bool exists for interop only.    *)
(* cmp3(a,b) returns Trit, not Bool.                         *)
(* if3 evaluates: +1=then, 0=maybe, -1=else.                 *)
