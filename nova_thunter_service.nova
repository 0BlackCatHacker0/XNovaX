// ============================================================================
// THunter -- The Process Hunter
// NovaX Navier-Stokes Pulse Process Guardian
// Port 9988 | Ternary Micro-Tool | 3-5-7-13 Harmonics
// ============================================================================
// Like sonar pulses tracking submarines in the ocean.
// THunter sends N-S frequency-controlled pulses that scan ALL running
// processes, matches them against the NovaX allowlist, and terminates
// anything unknown.
//
// Only NovaX-authorized processes survive. Everything else gets hunted.
//
// N-S Mapping:
//   - Pulse frequency = dv/dt (local acceleration) -- scales with Reynolds
//   - Allowlist = boundary conditions -- defines what is permitted
//   - Unknown processes = foreign bodies in the fluid -- expelled by -grad_p
//   - Kill force = body force (f) -- applied to remove foreign objects
//
// Ternary States:
//   +1 = HUNTING  (all clear, only NovaX processes running)
//    0 = TRACKING (unknown processes detected, monitoring)
//   -1 = KILLING  (actively terminating unauthorized processes)
//
// Triad Integration: TSpin + TScale + TShield + THunter = quad-guardian.
// ============================================================================

// -- Shared Libraries (N-S Flow) --
import3("C:/NovaX/lib/nova_ns_core.nova")
import3("C:/NovaX/lib/nova_stdlib.nova")

let VERSION = "1.0"
let PORT = 9988
let SERVICE = "nova-thunter"

// -- 3-5-7-13 Harmonic Constants --
let BLOCK_SIZE = 2187

// -- Ternary States --
let T_TRUE = 1
let T_FALSE = -1
let T_MAYBE = 0

// -- Hunter States --
let HUNTING = 1
let TRACKING = 0
let KILLING = -1

// -- N-S Reynolds-based pulse intervals (seconds) --
let PULSE_LAMINAR = H13       // 13s -- few unknowns, slow scan
let PULSE_TRANSITIONAL = H7   // 7s  -- some unknowns, moderate scan
let PULSE_TURBULENT = H3      // 3s  -- many unknowns, rapid scan
let PULSE_CHAOTIC = 1         // 1s  -- critical threat, maximum frequency

// -- Reynolds thresholds for pulse regime --
let RE_CALM = 0               // No unknowns
let RE_LOW = H3               // 1-3 unknowns
let RE_MID = H7               // 4-7 unknowns
let RE_HIGH = H13             // 8-13 unknowns (triggers chaotic)

// -- Kill settings --
let GRACE_PERIOD = H5         // 5 pulses before killing
let MAX_KILLS_PER_PULSE = H7  // Kill at most 7 processes per pulse

