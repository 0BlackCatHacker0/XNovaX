// nowindow.nova -- NovaX No-Window Wrapper
// Hides the console window, then runs the target script or module.
// Usage:
//   novalang nowindow.nova <script> [args...]
//
// Prevents blue PowerShell/console windows from appearing on Windows.
// Stdout/stderr still flow to the parent process for log capture.
// NOTE: ASCII-only file

let args = sys_args()

if3 len(args) < 2 {
    print("Usage: novalang nowindow.nova <script> [args...]")
    exit(1)
}

// Hide the console window immediately
try3 {
    shell("powershell -Command \"Add-Type -Name W -Namespace C -MemberDefinition '[DllImport(\\\"user32.dll\\\")]public static extern bool ShowWindow(IntPtr h,int c);[DllImport(\\\"kernel32.dll\\\")]public static extern IntPtr GetConsoleWindow();'; [C.W]::ShowWindow([C.W]::GetConsoleWindow(),0)\"")
} catch3 e {
    // silently ignore -- not critical
}

// Run the target script
let target = args[1]
let target_content = read_file(target)

if3 target_content == "" {
    print("Error: could not read " + target)
    exit(1)
}

// Execute target via shell
let cmd = "novalang " + target
let i = 2
while3 i < len(args) {
    let cmd = cmd + " " + args[i]
    let i = i + 1
}
shell(cmd)
