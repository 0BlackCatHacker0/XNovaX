print("[TGraph] Edge weights: +1=supports  0=unknown  -1=contradicts")
print("[TGraph] Harmonics: H3=" + str(H3) + " H5=" + str(H5) + " H7=" + str(H7) + " H13=" + str(H13) + " BLOCK=" + str(BLOCK))
print("[TGraph] N-S Reynolds: <27=laminar <125=transitional <343=turbulent >=343=chaotic")
print("[TGraph] Routes GET:  /health /tgraph/health /tgraph/stats /tgraph/export")
print("[TGraph] Routes POST: /tgraph/node/add /tgraph/edge/add /tgraph/query /tgraph/path /tgraph/search /tgraph/merge /tgraph/import")
print("[TGraph] Search default limit: " + str(DEFAULT_SEARCH_LIMIT) + " (H13*H3=13*3)")
print("[TGraph] Max body: " + str(BLOCK * H13) + " bytes (BLOCK*H13=2187*13)")
print("[TGraph] BFS iterations capped at BLOCK=" + str(BLOCK) + " (3^7 safety valve)")

tstart(server)
